<!--
  ProGlassAutomation.LicenseGenerator — developer-only WPF tool.

  A small standalone WPF application that generates RSA-2048
  key pairs and signs license files (.lic). It is NEVER
  shipped to customers — it lives in the developer's source
  tree and the produced .lic files are what the customer
  receives out-of-band (email, WhatsApp, etc.).

  Why a separate project?
    • Different output type (WinExe, not the main app's
      WinExe — the main app has its own App.xaml and
      bootstrapping).
    • Self-contained — does NOT reference the main
      ProGlassAutomation.csproj. A reference would drag
      in EF Core / ClosedXML / NAudio / Whisper / Velopack
      / every XAML resource, and the tool would be
      unbuildable without a Windows desktop session.
    • Marked IsPackable=false so the .csproj is never
      included in a customer-facing installer.

  Why share source files with the app instead of a
  ProjectReference?
    A ProjectReference on the full app would drag the
    WPF / EF Core / ClosedXML / NAudio / Whisper
    dependency graph into a tool that only needs the
    licensing primitives. Sharing source files keeps
    the tool's restore + build time in seconds rather
    than minutes. The licensing code is small (5
    files, < 1000 lines) and the test suite on the app
    side guarantees behavioural parity.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProGlassAutomation.Tools.LicenseGenerator</RootNamespace>
    <AssemblyName>ProGlassAutomation.LicenseGenerator</AssemblyName>
    <IsPackable>false</IsPackable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8618;CS8625;CA1305;CA1307;CA1416</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The licensing primitives — shared verbatim with
      the app. The contract is "this list of files lives
      in both places". The test suite on the app side
      guards the contract.
    -->
    <Compile Include="..\..\Services\Licensing\LicensePayload.cs"
             Link="Shared\LicensePayload.cs" />
    <Compile Include="..\..\Services\Licensing\LicenseSigner.cs"
             Link="Shared\LicenseSigner.cs" />
    <Compile Include="..\..\Services\Licensing\LicensePublicKey.cs"
             Link="Shared\LicensePublicKey.cs" />
    <Compile Include="..\..\Services\Licensing\MachineFingerprint.cs"
             Link="Shared\MachineFingerprint.cs" />
  </ItemGroup>

</Project>
