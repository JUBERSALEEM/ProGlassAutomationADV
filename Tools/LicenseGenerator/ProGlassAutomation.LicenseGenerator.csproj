<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ProGlassAutomation.LicenseGenerator — the standalone production tool.

    It signs licenses against the permanent ProGlass.Licensing contract. It
    does NOT:
      • reference ProGlassAutomation (the customer app),
      • share / re-compile the app's Services/Licensing files,
      • need AppLogServiceStub / AuditStub / any fake app service,
      • need System.Management (it never fingerprints a machine itself),
      • need a database, EF Core, or a WPF app build.

    Dependency graph:
        ProGlass.Licensing (sign + verify + format + validate)
        LicenseGenerator (PRIVATE KEY, signs)
        ProGlassAutomation (PUBLIC KEY, verifies)  — a different project, not here.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProGlassAutomation.Tools.LicenseGenerator</RootNamespace>
    <AssemblyName>ProGlassAutomation.LicenseGenerator</AssemblyName>
    <IsPackable>false</IsPackable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8618;CS8625;CA1305;CA1307;CA1416</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Licensing\ProGlass.Licensing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows DPAPI, used only to protect the generator's private key at rest. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

</Project>
