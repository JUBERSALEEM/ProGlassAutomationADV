<Window x:Class="ProGlassAutomation.Tools.LicenseGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProGlass — Offline Activation Generator"
        Width="1160" Height="940"
        MinWidth="980" MinHeight="760"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource AppFont}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="0,0,0,1" Padding="28,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="10"
                            Background="{StaticResource AccentBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="◆" FontSize="{StaticResource TextTitle}" Foreground="{StaticResource AccentTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ProGlass Offline Activation Generator"
                                   Style="{StaticResource HeaderText}"/>
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,2,0,0"
                                   Text="Vendor tool — generates signed license keys (simple flow) and signs offline activation responses (advanced PC-ID flow). No embedded production private key."/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="2" Background="{StaticResource CardAltBrush}"
                        CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
                    <TextBlock x:Name="KeyStatusText" Text="No issuer key loaded."
                               FontSize="{StaticResource TextBody}" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}"/>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="28,20">
            <StackPanel>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="ISSUER KEY FILE" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Load an external .pgkey file that is kept outside Git. The app will trust the response only if the public half matches one of its embedded public verification keys."/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Loaded key file" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="KeyFilePathBox" IsReadOnly="True"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Key ID for new key file" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="KeyIdBox" Text="production-key-2026"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="LoadKeyButton"
                                    Style="{StaticResource OutlinedButton}"
                                    Content="LOAD .PGKEY"
                                    Click="LoadKeyButton_Click"/>
                            <Button x:Name="CreateKeyButton"
                                    Style="{StaticResource GhostButton}"
                                    Content="CREATE NEW .PGKEY"
                                    Click="CreateKeyButton_Click"
                                    Margin="10,0,0,0"/>
                            <Button x:Name="CopyPublicKeyButton"
                                    Style="{StaticResource GhostButton}"
                                    Content="COPY LOADED PUBLIC KEY"
                                    Click="CopyPublicKeyButton_Click"
                                    Margin="10,0,0,0"/>
                            <Button x:Name="SelfTestButton"
                                    Style="{StaticResource GhostButton}"
                                    Content="RUN SIGNING SELF TEST"
                                    Click="SelfTestButton_Click"
                                    Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="LICENSE KEY — SIMPLE FLOW (GENERATE &amp; SEND)" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Generate a signed license key the customer pastes into the app (a single text block starting with PGKEY1). No request needed. Leave PC ID empty for a portable key, or paste the customer's PC ID to bind the key to that machine."/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Edition" Style="{StaticResource LabelText}"/>
                                <ComboBox x:Name="KeyEditionCombo"
                                          SelectedIndex="1"
                                          SelectionChanged="KeyEditionCombo_SelectionChanged">
                                    <ComboBoxItem Content="Basic"/>
                                    <ComboBoxItem Content="Business"/>
                                    <ComboBoxItem Content="Factory"/>
                                    <ComboBoxItem Content="Enterprise"/>
                                    <ComboBoxItem Content="Trial"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Validity (days · 0 = never expires)" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="KeyDaysBox" Text="365"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Customer code (optional)" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="KeyCustomerIdBox"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Company name (optional)" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="KeyCompanyBox"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,4">
                                <TextBlock Text="PC ID / machine fingerprint (optional — leave empty for a portable key)" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="KeyFingerprintBox"
                                         FontFamily="Consolas" FontSize="{StaticResource TextBody}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="GenerateLicenseKeyButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="GENERATE LICENSE KEY"
                                    Click="GenerateLicenseKeyButton_Click"/>
                            <Button x:Name="CopyLicenseKeyButton"
                                    Style="{StaticResource GhostButton}"
                                    Content="COPY KEY"
                                    Click="CopyLicenseKeyButton_Click"
                                    Margin="10,0,0,0"/>
                            <Button x:Name="SaveLicenseKeyButton"
                                    Style="{StaticResource GhostButton}"
                                    Content="SAVE KEY FILE…"
                                    Click="SaveLicenseKeyButton_Click"
                                    Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBox x:Name="LicenseKeyOutputBox"
                                 Style="{StaticResource CodeTextBox}"
                                 MinHeight="140" MaxHeight="320"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>

                <Button x:Name="AdvancedFlowToggleButton"
                        Style="{StaticResource GhostButton}"
                        Content="ADVANCED: PC-ID ACTIVATION REQUEST FLOW (LEGACY) ▾"
                        Click="AdvancedFlowToggleButton_Click"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,12"/>

                <StackPanel x:Name="AdvancedRequestPanel" Visibility="Collapsed">

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="CUSTOMER ACTIVATION REQUEST (ADVANCED PC-ID FLOW)" Style="{StaticResource SectionLabel}"/>
                        <TextBlock x:Name="RequestDetailText"
                                   Style="{StaticResource HelpText}"
                                   Text="Only needed for machine-bound licenses. Import the .pgrequest file exported by the customer machine. The signed response will be bound to that installation ID, machine fingerprint and request nonce."/>
                        <TextBox x:Name="ActivationRequestBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="140"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="{StaticResource TextBody}"
                                 Margin="0,12,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="LoadRequestButton"
                                    Style="{StaticResource OutlinedButton}"
                                    Content="LOAD .PGREQUEST"
                                    Click="LoadRequestButton_Click"/>
                            <Button x:Name="ParseRequestButton"
                                    Style="{StaticResource GhostButton}"
                                    Content="PARSE REQUEST TEXT"
                                    Click="ParseRequestButton_Click"
                                    Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="RESPONSE DETAILS" Style="{StaticResource SectionLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Edition" Style="{StaticResource LabelText}"/>
                                <ComboBox x:Name="LicenseTypeCombo" SelectionChanged="LicenseTypeCombo_SelectionChanged">
                                    <ComboBoxItem Content="Trial"/>
                                    <ComboBoxItem Content="Basic"/>
                                    <ComboBoxItem Content="Business"/>
                                    <ComboBoxItem Content="Factory"/>
                                    <ComboBoxItem Content="Enterprise"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Validity (days)" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="DaysBox" Text="365"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Customer code" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="CustomerIdBox" Text="CUST-001"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Company name" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="CustomerNameBox" Text="Acme Glass LLC"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="License type" Style="{StaticResource LabelText}"/>
                                <ComboBox x:Name="LicenseModeCombo">
                                    <ComboBoxItem Content="Subscription"/>
                                    <ComboBoxItem Content="Lifetime"/>
                                    <ComboBoxItem Content="PerpetualVersion"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Grace days" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="GraceDaysBox" Text="7"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,4">
                                <TextBlock Text="Issuer notes (optional)" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="NotesBox"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,22,0,4">
                                <CheckBox x:Name="ReadOnlyOnExpiryCheckBox"
                                          Content="Read-only mode during grace/expiry window"
                                          IsChecked="True"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="FEATURE ENTITLEMENTS" Style="{StaticResource SectionLabel}"/>
                        <TextBlock x:Name="PreviewText" Style="{StaticResource HelpText}"
                                   Text="Pick an edition and the generator fills the recommended feature list. You can refine the entitlements before signing."/>
                        <TextBlock Style="{StaticResource LabelText}" Margin="0,12,0,4"
                                   Text="Features (comma-separated, exact IDs · * = everything)"/>
                        <TextBox x:Name="FeaturesBox"
                                 Text="Inquiry.*, Proforma.*, JobOrder.*, DeliveryNote.*, TaxInvoice.*, Statement.*, Reports.*, AI.*"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="84"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="GENERATE SIGNED ACTIVATION RESPONSE" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="This writes a signed activation response JSON. Send the .lic file back to the customer. The app verifies keyId, signature, product, installation, machine fingerprint and request nonce before activating."/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="GenerateButton" Style="{StaticResource PrimaryButton}"
                                    Content="GENERATE RESPONSE"
                                    Click="GenerateButton_Click"/>
                            <Button x:Name="SaveAsButton" Style="{StaticResource OutlinedButton}"
                                    Content="SAVE AS…"
                                    Click="SaveAsButton_Click"
                                    Margin="10,0,0,0"/>
                            <Button x:Name="InspectButton" Style="{StaticResource GhostButton}"
                                    Content="INSPECT EXISTING RESPONSE"
                                    Click="InspectButton_Click"
                                    Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="OutputCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="RESULT" Style="{StaticResource SectionLabel}"/>
                        <TextBlock x:Name="ResultText" Style="{StaticResource HelpText}" Margin="0,0,0,10"/>
                        <TextBlock Text="SIGNED ACTIVATION RESPONSE JSON" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="KeyOutputBox" Style="{StaticResource CodeTextBox}"
                                 MinHeight="220" MaxHeight="420" IsReadOnly="True" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="COPY RESPONSE JSON"
                                    Click="CopyLicenseButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource StatusBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready." FontSize="{StaticResource TextBody}"
                           Foreground="{StaticResource TextDimBrush}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="StatusTimeText" FontSize="{StaticResource TextBody}"
                           Foreground="{StaticResource TextDimBrush}" Margin="16,0,0,0"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
