<Window x:Class="ProGlassAutomation.Tools.LicenseGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProGlass — License Generator"
        Width="1120" Height="900"
        MinWidth="940" MinHeight="720"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource AppFont}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="0,0,0,1" Padding="28,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="10"
                            Background="{StaticResource AccentBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="◆" FontSize="18" Foreground="{StaticResource AccentTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ProGlass License Generator"
                                   Style="{StaticResource HeaderText}"/>
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,2,0,0"
                                   Text="Vendor tool — generates the exact .lic file and paste key the current ProGlass app activation screen accepts."/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="2" Background="{StaticResource CardAltBrush}"
                        CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
                    <TextBlock x:Name="KeyStatusText" Text="App-compatible key ready."
                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}"/>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="28,20">
            <StackPanel>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="APP-COMPATIBLE SIGNING" Style="{StaticResource SectionLabel}"/>
                            <TextBlock x:Name="KeyDetailText"
                                       Style="{StaticResource HelpText}"
                                       Text="This generator is locked to the app-compatible RSA key trusted by the current ProGlass build. No manual key copy, no rebuild needed to activate generated licenses."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button x:Name="GenerateKeyButton"
                                    Style="{StaticResource OutlinedButton}"
                                    Content="RUN SELF TEST"
                                    Click="GenerateKeyButton_Click"/>
                            <Button x:Name="CopyPublicKeyButton"
                                    Style="{StaticResource GhostButton}"
                                    Content="COPY APP PUBLIC KEY"
                                    Click="CopyPublicKeyButton_Click"
                                    Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="LICENSE DETAILS" Style="{StaticResource SectionLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Edition" Style="{StaticResource LabelText}"/>
                                <ComboBox x:Name="LicenseTypeCombo" SelectionChanged="LicenseTypeCombo_SelectionChanged">
                                    <ComboBoxItem Content="Trial"/>
                                    <ComboBoxItem Content="Basic"/>
                                    <ComboBoxItem Content="Business"/>
                                    <ComboBoxItem Content="Factory"/>
                                    <ComboBoxItem Content="Enterprise"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Valid for (days)" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="DaysBox" Text="365"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Customer code" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="CustomerIdBox" Text="CUST-001"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Company name" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="CustomerNameBox" Text="Acme Glass LLC"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,4">
                                <TextBlock Text="License ID override (optional)" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="EmailBox"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,4">
                                <TextBlock Text="Issuer notes (optional)" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="CompanyBox"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="ACTIVATION MODEL" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton x:Name="UnboundRadio" GroupName="Device" IsChecked="True"
                                         Content="Portable (shared .lic, activation-limited)"
                                         Checked="UnboundRadio_Checked"/>
                            <RadioButton x:Name="SingleRadio" GroupName="Device"
                                         Content="Machine-bound (customer fingerprint required)" Margin="20,0,0,0"
                                         Checked="SingleRadio_Checked"/>
                            <RadioButton x:Name="MultiRadio" GroupName="Device"
                                         Content="High-volume portable preset" Margin="20,0,0,0"
                                         Checked="SingleRadio_Checked"/>
                        </StackPanel>
                        <Grid x:Name="FingerprintRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="FingerprintPanel" Grid.Column="0">
                                <TextBlock x:Name="FingerprintLabel" Style="{StaticResource LabelText}"
                                           Text="Machine fingerprint (from About → License on the customer PC)"/>
                                <TextBox x:Name="FingerprintBox"/>
                            </StackPanel>
                            <StackPanel x:Name="ActivationLimitPanel" Grid.Column="2" VerticalAlignment="Bottom">
                                <TextBlock x:Name="ActivationLimitLabel" Text="Max activations" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="DeviceLimitBox" Text="5" Width="140"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="FEATURE SET" Style="{StaticResource SectionLabel}"/>
                        <TextBlock x:Name="PreviewText" Style="{StaticResource HelpText}"
                                   Text="Pick an edition and the generator fills the recommended feature list. You can edit the list manually before generating."/>
                        <TextBlock Style="{StaticResource LabelText}" Margin="0,12,0,4">
                            <Run Text="Features (comma-separated, exact app feature IDs · * = everything)"/>
                        </TextBlock>
                        <TextBox x:Name="FeaturesBox"
                                 Text="Inquiry.*, Proforma.*, JobOrder.*, DeliveryNote.*, TaxInvoice.*, Statement.*, Reports.*, AI.*"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="72"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="GENERATE" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Generate writes a .lic file and also prepares a base64 paste key. The main app can activate from either the file or the pasted key."/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="GenerateButton" Style="{StaticResource PrimaryButton}"
                                    Content="GENERATE .LIC"
                                    Click="GenerateButton_Click"/>
                            <Button x:Name="SaveAsButton" Style="{StaticResource OutlinedButton}"
                                    Content="SAVE AS…"
                                    Click="SaveAsButton_Click"
                                    Margin="10,0,0,0"/>
                            <Button x:Name="InspectButton" Style="{StaticResource GhostButton}"
                                    Content="INSPECT EXISTING .LIC"
                                    Click="InspectButton_Click"
                                    Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="OutputCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="RESULT" Style="{StaticResource SectionLabel}"/>
                        <TextBlock x:Name="ResultText" Style="{StaticResource HelpText}" Margin="0,0,0,10"/>
                        <TextBlock Text="PASTE KEY (base64 accepted by the app activation screen)" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="PasteKeyOutputBox" Style="{StaticResource CodeTextBox}"
                                 MinHeight="84" MaxHeight="140" IsReadOnly="True" TextWrapping="Wrap"/>
                        <TextBlock Text=".LIC JSON ENVELOPE" Style="{StaticResource LabelText}" Margin="0,12,0,4"/>
                        <TextBox x:Name="KeyOutputBox" Style="{StaticResource CodeTextBox}"
                                 MinHeight="140" MaxHeight="280" IsReadOnly="True" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="COPY PASTE KEY"
                                    Click="CopyLicenseButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource StatusBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready." FontSize="12"
                           Foreground="{StaticResource TextDimBrush}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="StatusTimeText" FontSize="12"
                           Foreground="{StaticResource TextDimBrush}" Margin="16,0,0,0"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
