<Window x:Class="ProGlassAutomation.Tools.LicenseGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProGlass — License Generator"
        Width="1080" Height="860"
        MinWidth="900" MinHeight="680"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource AppFont}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Top bar ─────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="0,0,0,1" Padding="28,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="10"
                            Background="{StaticResource AccentBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="◆" FontSize="18" Foreground="{StaticResource AccentTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ProGlass License Generator"
                                   Style="{StaticResource HeaderText}"/>
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,2,0,0"
                                   Text="Create a signed license the customer imports into ProGlass Automation. It activates instantly."/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="2" Background="{StaticResource CardAltBrush}"
                        CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
                    <TextBlock x:Name="KeyStatusText" Text="No signing key."
                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- ── Body ────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="28,20">
            <StackPanel>

                <!-- 1. SIGNING KEY ─────────────────────────────── -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SIGNING KEY" Style="{StaticResource SectionLabel}"/>
                            <TextBlock x:Name="KeyDetailText"
                                       Style="{StaticResource HelpText}"
                                       Text="Generate a key once. The private key is stored DPAPI-protected on this machine and never leaves it. Rebuild not required — only the public key must be embedded in the app."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button x:Name="GenerateKeyButton"
                                    Style="{StaticResource OutlinedButton}"
                                    Content="GENERATE KEY"
                                    Click="GenerateKeyButton_Click"/>
                            <Button x:Name="CopyPublicKeyButton"
                                    Style="{StaticResource GhostButton}"
                                    Content="COPY PUBLIC KEY (for app)"
                                    Click="CopyPublicKeyButton_Click"
                                    Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. LICENSE DETAILS ─────────────────────────── -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="LICENSE DETAILS" Style="{StaticResource SectionLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="License type" Style="{StaticResource LabelText}"/>
                                <ComboBox x:Name="LicenseTypeCombo" SelectedIndex="1">
                                    <ComboBoxItem Content="Trial"/>
                                    <ComboBoxItem Content="Subscription"/>
                                    <ComboBoxItem Content="Lifetime"/>
                                    <ComboBoxItem Content="Perpetual Version"/>
                                    <ComboBoxItem Content="Enterprise"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Valid for (days)" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="DaysBox" Text="365"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Customer ID" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="CustomerIdBox" Text="CUST-001"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Customer name" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="CustomerNameBox" Text="Acme Glass LLC"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Company (optional)" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="CompanyBox"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Email (optional)" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="EmailBox"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,0,0,4">
                                <TextBlock Style="{StaticResource LabelText}">
                                    <Run Text="Features"/><Run Text="  (comma-separated · the stable IDs the app checks · * = all)"
                                         FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                                </TextBlock>
                                <TextBox x:Name="FeaturesBox"
                                         Text="PROFORMA_INVOICE, JOB_ORDER, DELIVERY_NOTE, TAX_INVOICE, REPORTS"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="52"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. DEVICE POLICY ───────────────────────────── -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="DEVICE POLICY" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton x:Name="UnboundRadio" GroupName="Device" IsChecked="True"
                                         Content="Unbound (any machine)"
                                         Checked="UnboundRadio_Checked"/>
                            <RadioButton x:Name="SingleRadio" GroupName="Device"
                                         Content="Single machine" Margin="20,0,0,0"
                                         Checked="SingleRadio_Checked"/>
                            <RadioButton x:Name="MultiRadio" GroupName="Device"
                                         Content="Multiple (N) machines" Margin="20,0,0,0"
                                         Checked="SingleRadio_Checked"/>
                        </StackPanel>
                        <Grid x:Name="FingerprintRow" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelText}">
                                    <Run Text="Machine fingerprint (from the customer's About page)"/>
                                </TextBlock>
                                <TextBox x:Name="FingerprintBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="10,0,0,0">
                                <TextBlock Text="Device limit" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="DeviceLimitBox" Text="1" Width="80"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. VERSION POLICY ──────────────────────────── -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="VERSION POLICY (app compatibility)" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,12"
                                   Text="Default: minimum 1.0.0, no maximum — the license stays valid for every future release (1.0, 1.1, 2.0, 3.0 …). Only restrict for a deliberate version-locked license."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Minimum app version" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="MinVersionBox" Text="1.0.0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Maximum app version (blank = unlimited future)" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="MaxVersionBox" Text=""/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 5. PREVIEW + GENERATE ──────────────────────── -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="PREVIEW" Style="{StaticResource SectionLabel}"/>
                        <TextBlock x:Name="PreviewText" Style="{StaticResource HelpText}"
                                   Text="Fill the form, then click GENERATE. The license is signed, written to a .proglasslicense file, and re-verified before it is reported as success."/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="GenerateButton" Style="{StaticResource PrimaryButton}"
                                    Content="GENERATE LICENSE"
                                    Click="GenerateButton_Click"/>
                            <Button x:Name="SaveAsButton" Style="{StaticResource OutlinedButton}"
                                    Content="SAVE AS…"
                                    Click="SaveAsButton_Click"
                                    Margin="10,0,0,0"/>
                            <Button x:Name="InspectButton" Style="{StaticResource GhostButton}"
                                    Content="INSPECT AN EXISTING LICENSE"
                                    Click="InspectButton_Click"
                                    Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 6. OUTPUT ──────────────────────────────────── -->
                <Border x:Name="OutputCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="RESULT" Style="{StaticResource SectionLabel}"/>
                        <TextBlock x:Name="ResultText" Style="{StaticResource HelpText}" Margin="0,0,0,10"/>
                        <TextBox x:Name="KeyOutputBox" Style="{StaticResource CodeTextBox}"
                                 MinHeight="120" MaxHeight="220" IsReadOnly="True" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="COPY LICENSE (to send)"
                                    Click="CopyLicenseButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Status bar ─────────────────────────────────────── -->
        <Border Grid.Row="2" Style="{StaticResource StatusBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready." FontSize="12"
                           Foreground="{StaticResource TextDimBrush}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="StatusTimeText" FontSize="12"
                           Foreground="{StaticResource TextDimBrush}" Margin="16,0,0,0"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
