<Window x:Class="ProGlassAutomation.Tools.LicenseGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProGlass — License Key Generator"
        Width="920" Height="760"
        MinWidth="760" MinHeight="620"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource AppFont}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="0,0,0,1"
                Padding="32,22">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38"
                            CornerRadius="10"
                            Background="{StaticResource AccentBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="◆" FontSize="18"
                                   Foreground="{StaticResource AccentTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ProGlass License Key Generator"
                                   Style="{StaticResource HeaderText}"/>
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,3,0,0"
                                   Text="Create a signed key, send it to the customer, they paste it and it activates instantly."/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Body ───────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="32,24">
            <StackPanel>

                <!-- 1. KEY PAIR ───────────────────────────────── -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SIGNING KEY" Style="{StaticResource SectionLabel}"/>
                                <TextBlock x:Name="KeyStatusText"
                                           Text="No key pair found."
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock x:Name="KeyStatusDetail"
                                           Style="{StaticResource HelpText}"
                                           Margin="0,4,0,0"
                                           Text="Generate a key once. The private key stays on this machine; the public half is stamped into the app so every key you make verifies."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                <Button x:Name="GenerateKeyButton"
                                        Style="{StaticResource OutlinedButton}"
                                        Content="GENERATE KEY PAIR"
                                        Click="GenerateKeyPairButton_Click"/>
                                <Button x:Name="InstallKeyButton"
                                        Style="{StaticResource GhostButton}"
                                        Content="INSTALL PUBLIC KEY INTO APP"
                                        Click="InstallPublicKeyButton_Click"
                                        Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="KeyPairInfo" Orientation="Horizontal"
                                    Margin="0,14,0,0"
                                    Visibility="Collapsed">
                            <Border Background="{StaticResource PanelAltBrush}"
                                    CornerRadius="6" Padding="12,8"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="KeyFingerprintText"
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="{StaticResource TextDimBrush}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. GENERATE LICENSE KEY ───────────────────── -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="GENERATE LICENSE KEY" Style="{StaticResource SectionLabel}"/>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Edition -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Edition" Style="{StaticResource LabelText}"/>
                                <ComboBox x:Name="EditionCombo" SelectedIndex="2">
                                    <ComboBoxItem Content="Trial"      Tag="Trial"/>
                                    <ComboBoxItem Content="Basic"      Tag="Basic"/>
                                    <ComboBoxItem Content="Business"   Tag="Business"/>
                                    <ComboBoxItem Content="Factory"    Tag="Factory"/>
                                    <ComboBoxItem Content="Enterprise" Tag="Enterprise"/>
                                </ComboBox>
                            </StackPanel>
                            <!-- Days -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Valid for (days)" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="DaysBox" Text="365"/>
                            </StackPanel>

                            <!-- Customer ID -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Customer ID" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="CustomerIdBox" Text=""/>
                            </StackPanel>
                            <!-- Company -->
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Company name" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="CompanyNameBox" Text=""/>
                            </StackPanel>

                            <!-- Features (full width) -->
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource LabelText}">
                                    <Run Text="Features"/>
                                    <Run Text="  (comma-separated · * = all · Module.* = module)"
                                         FontSize="10"
                                         Foreground="{StaticResource TextDimBrush}"/>
                                </TextBlock>
                                <TextBox x:Name="FeaturesBox"
                                         Text="*"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="52"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Grid>

                        <!-- Optional hardware binding -->
                        <CheckBox x:Name="BindToHardware"
                                  Content="Bind to a specific computer (hardware ID)"
                                  FontSize="12"
                                  Foreground="{StaticResource TextBrush}"
                                  Margin="0,4,0,0"
                                  Checked="BindToHardware_Changed"
                                  Unchecked="BindToHardware_Changed"/>
                        <Grid x:Name="HardwareRow"
                              Margin="0,10,0,0"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelText}">
                                    <Run Text="Machine fingerprint (hardware ID)"/>
                                    <Run Text="  copy from customer's About page, or use this PC"
                                         FontSize="10"
                                         Foreground="{StaticResource TextDimBrush}"/>
                                </TextBlock>
                                <TextBox x:Name="FingerprintBox"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource GhostButton}"
                                    Content="USE THIS PC"
                                    Click="UseThisPcButton_Click"
                                    VerticalAlignment="Bottom" Margin="10,0,0,0"/>
                        </Grid>

                        <!-- Generate action -->
                        <Button x:Name="GenerateKeyActionButton"
                                Style="{StaticResource PrimaryButton}"
                                Content="GENERATE LICENSE KEY"
                                Click="GenerateLicenseKeyButton_Click"
                                Margin="0,18,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 3. OUTPUT KEY ─────────────────────────────── -->
                <Border x:Name="OutputCard" Style="{StaticResource Card}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="YOUR LICENSE KEY" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,2,0,10"
                                   Text="Send this entire string to the customer. In the app: Settings → License → paste the key → Apply. No file needed."/>
                        <TextBox x:Name="KeyOutputBox"
                                 Style="{StaticResource CodeTextBox}"
                                 FontSize="11"
                                 MinHeight="120" MaxHeight="220"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="COPY KEY"
                                    Click="CopyKeyButton_Click"/>
                            <Button Style="{StaticResource GhostButton}"
                                    Content="SAVE AS .LIC FILE (optional)"
                                    Click="SaveKeyFileButton_Click"
                                    Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Setup hint -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ONE-TIME SETUP" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Style="{StaticResource HelpText}">
                            <Run Text="1. "/>
                            <Run FontWeight="SemiBold" Text="GENERATE KEY PAIR"/><Run Text=", then "/>
                            <Run FontWeight="SemiBold" Text="INSTALL PUBLIC KEY INTO APP"/><Run Text=" and rebuild the app. Once done, the app and this tool share the same key — every key you generate verifies."/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,6,0,0">
                            <Run Text="2. "/>
                            <Run FontWeight="SemiBold" Text="For each customer"/><Run Text=": pick an edition, set days, optionally check “bind to hardware” and paste their computer ID. Click GENERATE LICENSE KEY, copy the key, send it."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Status bar ─────────────────────────────────────── -->
        <Border Grid.Row="2" Style="{StaticResource StatusBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Text="Ready."
                           FontSize="11"
                           Foreground="{StaticResource TextDimBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="StatusTimeText"
                           Text="" FontSize="11"
                           Foreground="{StaticResource TextDimBrush}"
                           Margin="16,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
