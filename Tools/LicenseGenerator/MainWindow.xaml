<Window x:Class="ProGlassAutomation.Tools.LicenseGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProGlass — License Key Generator"
        Width="860" Height="760"
        MinWidth="760" MinHeight="620"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource AppFont}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="{DynamicResource Border.BottomHairlineThickness}" Padding="28,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="{DynamicResource Radius.Medium}"
                            Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="◆" FontSize="{StaticResource TextTitle}"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ProGlass License Key Generator"
                                   Style="{StaticResource HeaderText}"/>
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,2,0,0"
                                   Text="Pick a plan and press one button. The customer pastes the PGKEY1 key in the app — instant activation."/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="2" Background="{DynamicResource CardAltBrush}"
                        CornerRadius="{DynamicResource Radius.Small}" Padding="12,8" VerticalAlignment="Center">
                    <TextBlock x:Name="KeyStatusText"
                               Text="Production signing key embedded — ready."
                               FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextDimBrush}"/>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="28,20">
            <StackPanel>

                <!-- ═══ SINGLE CARD · PLAN + GENERATE ═══ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="LICENSE KEY — PLAN &amp; GENERATE"
                                   Style="{StaticResource SectionLabel}"/>
                        <TextBlock Style="{StaticResource HelpText}"
                                   Text="Choose how long the customer's key stays valid, then press GENERATE. The key comes out as one text block (PGKEY1…) — copy it and send it by email or chat."/>

                        <TextBlock Text="PLAN" Style="{StaticResource LabelText}" Margin="0,16,0,6"/>
                        <WrapPanel>
                            <RadioButton x:Name="Plan7DaysRadio" GroupName="LicensePlan"
                                         Style="{StaticResource PlanCardRadio}"
                                         Checked="PlanRadio_Checked">
                                <StackPanel>
                                    <TextBlock Text="7 DAYS" FontSize="{StaticResource TextBody}"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Short evaluation" FontSize="{StaticResource TextCaption}"
                                               Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="Plan30DaysRadio" GroupName="LicensePlan"
                                         Style="{StaticResource PlanCardRadio}"
                                         Checked="PlanRadio_Checked">
                                <StackPanel>
                                    <TextBlock Text="30 DAYS" FontSize="{StaticResource TextBody}"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Monthly key" FontSize="{StaticResource TextCaption}"
                                               Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="Plan6MonthsRadio" GroupName="LicensePlan"
                                         Style="{StaticResource PlanCardRadio}"
                                         Checked="PlanRadio_Checked">
                                <StackPanel>
                                    <TextBlock Text="6 MONTHS" FontSize="{StaticResource TextBody}"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Half-year key" FontSize="{StaticResource TextCaption}"
                                               Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="Plan1YearRadio" GroupName="LicensePlan"
                                         Style="{StaticResource PlanCardRadio}"
                                         Checked="PlanRadio_Checked">
                                <StackPanel>
                                    <TextBlock Text="1 YEAR" FontSize="{StaticResource TextBody}"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Annual key" FontSize="{StaticResource TextCaption}"
                                               Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="Plan2YearsRadio" GroupName="LicensePlan"
                                         Style="{StaticResource PlanCardRadio}"
                                         Checked="PlanRadio_Checked">
                                <StackPanel>
                                    <TextBlock Text="2 YEARS" FontSize="{StaticResource TextBody}"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Two-year key" FontSize="{StaticResource TextCaption}"
                                               Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </WrapPanel>

                        <TextBlock x:Name="KeyPreviewText"
                                   Style="{StaticResource HelpText}" Margin="0,12,0,0"
                                   Text="1 YEAR — the customer's key expires one year from the moment it is generated."/>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="GenerateLicenseKeyButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="GENERATE LICENSE KEY"
                                    Click="GenerateLicenseKeyButton_Click"/>
                            <Button x:Name="CopyLicenseKeyButton"
                                    Style="{StaticResource GhostButton}"
                                    Content="COPY KEY"
                                    Click="CopyLicenseKeyButton_Click"
                                    Margin="10,0,0,0"/>
                            <Button x:Name="SaveLicenseKeyButton"
                                    Style="{StaticResource GhostButton}"
                                    Content="SAVE KEY FILE…"
                                    Click="SaveLicenseKeyButton_Click"
                                    Margin="10,0,0,0"/>
                        </StackPanel>

                        <TextBox x:Name="LicenseKeyOutputBox"
                                 Style="{StaticResource CodeTextBox}"
                                 MinHeight="160" MaxHeight="320"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource StatusBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready."
                           FontSize="{StaticResource TextBody}"
                           Foreground="{DynamicResource TextDimBrush}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="StatusTimeText"
                           FontSize="{StaticResource TextBody}"
                           Foreground="{DynamicResource TextDimBrush}" Margin="16,0,0,0"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
