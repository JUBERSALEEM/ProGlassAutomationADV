<Window x:Class="ProGlassAutomation.Tools.LicenseGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProGlass — License Key Generator"
        Width="1080" Height="840"
        MinWidth="960" MinHeight="700"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource AppFont}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hero -->
        <Border Grid.Row="0" CornerRadius="24" Padding="22,18" Margin="0,0,0,16">
            <Border.Background>
                <StaticResource ResourceKey="HeroBrush"/>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="16" Background="#33FFFFFF"
                        VerticalAlignment="Center">
                    <TextBlock Text="◆" FontSize="22" Foreground="{StaticResource OnHeroBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="License studio" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource OnHeroMutedBrush}"/>
                    <TextBlock Text="ProGlass License Key Generator" Style="{StaticResource HeaderText}" Margin="0,2,0,0"/>
                    <TextBlock Text="License issuance is paused pending secure rotation of the exposed production signing key. Do not use older generator binaries."
                               FontSize="13" Foreground="{StaticResource OnHeroMutedBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Background="#33FFFFFF" CornerRadius="14" Padding="14,10"
                        VerticalAlignment="Center" MaxWidth="280">
                    <TextBlock x:Name="KeyStatusText"
                               Text="ISSUANCE PAUSED — key rotation required."
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource OnHeroBrush}"
                               TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="PLAN" Style="{StaticResource SectionLabel}"/>
                <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,8"
                           Text="Plan cards remain for reference only. New license issuance is disabled until a replacement signer is approved."/>

                <UniformGrid Columns="5" Margin="-6,0,-6,8">
                    <RadioButton x:Name="Plan7DaysRadio" GroupName="LicensePlan"
                                 Style="{StaticResource PlanCardRadio}"
                                 Background="#FFF7ED" BorderBrush="#EA580C" Foreground="#9A3412"
                                 Checked="PlanRadio_Checked">
                        <StackPanel>
                            <TextBlock Text="7 DAYS" FontSize="20" FontWeight="Bold"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="Short evaluation" FontSize="12" Margin="0,6,0,0" Opacity="0.85"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="Plan30DaysRadio" GroupName="LicensePlan"
                                 Style="{StaticResource PlanCardRadio}"
                                 Background="#ECFEFF" BorderBrush="#0891B2" Foreground="#155E75"
                                 Checked="PlanRadio_Checked">
                        <StackPanel>
                            <TextBlock Text="30 DAYS" FontSize="20" FontWeight="Bold"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="Monthly key" FontSize="12" Margin="0,6,0,0" Opacity="0.85"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="Plan6MonthsRadio" GroupName="LicensePlan"
                                 Style="{StaticResource PlanCardRadio}"
                                 Background="#F5F3FF" BorderBrush="#7C3AED" Foreground="#5B21B6"
                                 Checked="PlanRadio_Checked">
                        <StackPanel>
                            <TextBlock Text="6 MONTHS" FontSize="20" FontWeight="Bold"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="Half-year key" FontSize="12" Margin="0,6,0,0" Opacity="0.85"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="Plan1YearRadio" GroupName="LicensePlan"
                                 Style="{StaticResource PlanCardRadio}"
                                 Background="#EEF2FF" BorderBrush="#4F46E5" Foreground="#3730A3"
                                 Checked="PlanRadio_Checked">
                        <StackPanel>
                            <TextBlock Text="1 YEAR" FontSize="20" FontWeight="Bold"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="Annual key" FontSize="12" Margin="0,6,0,0" Opacity="0.85"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="Plan2YearsRadio" GroupName="LicensePlan"
                                 Style="{StaticResource PlanCardRadio}"
                                 Background="#ECFDF5" BorderBrush="#059669" Foreground="#065F46"
                                 Checked="PlanRadio_Checked">
                        <StackPanel>
                            <TextBlock Text="2 YEARS" FontSize="20" FontWeight="Bold"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="Two-year key" FontSize="12" Margin="0,6,0,0" Opacity="0.85"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>

                <Border Background="#FFFFFF" BorderBrush="#E9D5FF" BorderThickness="1"
                        CornerRadius="14" Padding="14,10" Margin="0,4,0,16">
                    <TextBlock x:Name="KeyPreviewText"
                               FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource TextBrush}"
                               Text="1 YEAR — the customer's key expires one year from the moment it is generated."/>
                </Border>

                <UniformGrid Columns="3" Margin="0,0,0,16">
                    <Border Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1"
                            CornerRadius="16" Padding="14,12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="1  ·  PICK" FontSize="11" FontWeight="Bold" Foreground="#C2410C"/>
                            <TextBlock Text="Choose how long the key stays valid." FontSize="12"
                                       Foreground="#9A3412" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#EEF2FF" BorderBrush="#A5B4FC" BorderThickness="1"
                            CornerRadius="16" Padding="14,12" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="2  ·  SIGN" FontSize="11" FontWeight="Bold" Foreground="#4338CA"/>
                            <TextBlock Text="Generate signs and self-checks the key." FontSize="12"
                                       Foreground="#3730A3" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#ECFDF5" BorderBrush="#6EE7B7" BorderThickness="1"
                            CornerRadius="16" Padding="14,12" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="3  ·  SEND" FontSize="11" FontWeight="Bold" Foreground="#047857"/>
                            <TextBlock Text="Copy or save the PGKEY1 block." FontSize="12"
                                       Foreground="#065F46" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border CornerRadius="22,22,0,0" Padding="22,16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#4F46E5" Offset="0"/>
                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <TextBlock Text="CUSTOMER KEY" FontSize="11" FontWeight="Bold" Foreground="#E0E7FF"/>
                                <TextBlock Text="One text block. Email it or paste it into chat."
                                           FontSize="13" Foreground="#FFFFFF" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="22,16,22,0">
                            <Button x:Name="GenerateLicenseKeyButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="ISSUANCE PAUSED"
                                    IsEnabled="False"
                                    Click="GenerateLicenseKeyButton_Click"/>
                            <Button x:Name="CopyLicenseKeyButton"
                                    Style="{StaticResource CopyButton}"
                                    Content="COPY KEY"
                                    Click="CopyLicenseKeyButton_Click"
                                    Margin="10,0,0,0"/>
                            <Button x:Name="SaveLicenseKeyButton"
                                    Style="{StaticResource SaveButton}"
                                    Content="SAVE KEY FILE…"
                                    Click="SaveLicenseKeyButton_Click"
                                    Margin="10,0,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="2" Margin="22,16,22,22" MinHeight="168">
                            <TextBox x:Name="LicenseKeyOutputBox"
                                     Style="{StaticResource CodeTextBox}"
                                     MinHeight="168" MaxHeight="280"
                                     IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>
                            <TextBlock Text="The PGKEY1 block appears here after you generate."
                                       FontSize="13" Foreground="#A5B4FC"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Margin="18,16,18,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=LicenseKeyOutputBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Text, ElementName=LicenseKeyOutputBox}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource StatusBar}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready."
                           FontSize="13"
                           Foreground="{StaticResource TextDimBrush}"
                           TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="StatusTimeText"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" Margin="16,0,0,0"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
