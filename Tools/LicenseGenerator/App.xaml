<Application x:Class="ProGlassAutomation.Tools.LicenseGenerator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                  Self-contained dark theme. The tool does
                  NOT reference the main app's theme files
                  (pack://application:,,,/Themes/... would
                  not resolve in a separate assembly), so
                  the few brushes the tool needs are
                  defined inline. The values match the
                  main app's LightTheme + DarkTheme for
                  visual consistency.
                -->
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
