<Application x:Class="ProGlassAutomation.Tools.LicenseGenerator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- 2026-09-14: Theme.xaml was never merged into the tool's resource chain,
             so every StaticResource on MainWindow (AppFont, cards, buttons...) threw
             at startup. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
