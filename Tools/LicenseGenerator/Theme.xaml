<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ══════════════════════════════════════════════════════════════
         ProGlass License Generator — studio theme.
         Rich color, rounded cards, no live blur (keeps the window fluid).
         Status colors keep the keys MainWindow.SetStatus looks up:
         SuccessBrush, DangerBrush, WarningBrush, TextDimBrush.
         ══════════════════════════════════════════════════════════════ -->

    <sys:Double x:Key="TextXSmall">11</sys:Double>
    <sys:Double x:Key="TextCaption">12</sys:Double>
    <sys:Double x:Key="TextBody">13</sys:Double>
    <sys:Double x:Key="TextBodyLarge">14</sys:Double>
    <sys:Double x:Key="TextSection">15</sys:Double>
    <sys:Double x:Key="TextSubhead">16</sys:Double>
    <sys:Double x:Key="TextTitle">18</sys:Double>
    <sys:Double x:Key="TextTitleLarge">20</sys:Double>
    <sys:Double x:Key="TextHeadline">22</sys:Double>
    <sys:Double x:Key="TextDisplay">24</sys:Double>
    <sys:Double x:Key="TextDisplayLarge">28</sys:Double>

    <CornerRadius x:Key="Radius.Small">10</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">14</CornerRadius>
    <CornerRadius x:Key="Radius.Large">18</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">16</CornerRadius>
    <Thickness x:Key="Border.BottomHairlineThickness">0,0,0,1</Thickness>
    <Thickness x:Key="Border.StrongThickness">2</Thickness>

    <LinearGradientBrush x:Key="BgBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EEF2FF" Offset="0"/>
        <GradientStop Color="#FDF2F8" Offset="0.48"/>
        <GradientStop Color="#ECFEFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4F46E5" Offset="0"/>
        <GradientStop Color="#7C3AED" Offset="0.55"/>
        <GradientStop Color="#DB2777" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GenerateBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#4F46E5" Offset="0"/>
        <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardAltBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#E9D5FF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1E1B4B"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#6D28D9"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5B21B6"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#059669"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E11D48"/>
    <SolidColorBrush x:Key="CodeBgBrush" Color="#1E1B4B"/>
    <SolidColorBrush x:Key="CodeTextBrush" Color="#E0E7FF"/>
    <SolidColorBrush x:Key="OnHeroBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OnHeroMutedBrush" Color="#F5D0FE"/>

    <FontFamily x:Key="AppFont">Segoe UI</FontFamily>

    <Style TargetType="TextBlock" x:Key="LabelText">
        <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style TargetType="TextBlock" x:Key="HeaderText">
        <Setter Property="FontSize" Value="{StaticResource TextHeadline}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource OnHeroBrush}"/>
    </Style>

    <Style TargetType="TextBlock" x:Key="SectionLabel">
        <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style TargetType="TextBlock" x:Key="HelpText">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource CardAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="Button" x:Key="ButtonBase">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Pill}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource GenerateBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
        <Setter Property="Padding" Value="22,12"/>
        <Setter Property="MinHeight" Value="44"/>
    </Style>

    <Style TargetType="Button" x:Key="CopyButton" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="#ECFEFF"/>
        <Setter Property="Foreground" Value="#0E7490"/>
        <Setter Property="BorderBrush" Value="#67E8F9"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="MinHeight" Value="44"/>
    </Style>

    <Style TargetType="Button" x:Key="SaveButton" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="#ECFDF5"/>
        <Setter Property="Foreground" Value="#047857"/>
        <Setter Property="BorderBrush" Value="#6EE7B7"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="MinHeight" Value="44"/>
    </Style>

    <Style TargetType="Button" x:Key="GhostButton" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="#F5F3FF"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="MinHeight" Value="44"/>
    </Style>

    <Style TargetType="Border" x:Key="Card">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="#E9D5FF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="22"/>
        <Setter Property="Padding" Value="22"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style TargetType="TextBox" x:Key="CodeTextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="{StaticResource CodeBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource CodeTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="CaretBrush" Value="{StaticResource CodeTextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="16"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Border" x:Key="StatusBar">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="#E9D5FF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="18,12"/>
    </Style>

    <!-- Plan card. Background = soft tint, BorderBrush = accent, Foreground = ink.
         Checked fills the card with the accent and flips the ink to white. -->
    <Style TargetType="RadioButton" x:Key="PlanCardRadio">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="6"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="PlanCard"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="2"
                            CornerRadius="18"
                            MinHeight="124"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Fill is a real binding, not a trigger setter.
                                 WPF rejects Binding on Trigger.Setter.Value. -->
                            <Border x:Name="Fill"
                                    CornerRadius="16"
                                    Background="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                    Visibility="Collapsed"/>
                            <ContentPresenter Margin="14,16" VerticalAlignment="Center"/>
                            <Border x:Name="SelectedChip"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="8"
                                    Background="#FFFFFF"
                                    CornerRadius="8"
                                    Padding="6,2"
                                    Visibility="Collapsed">
                                <TextBlock Text="✓"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PlanCard" Property="Opacity" Value="0.94"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter TargetName="Fill" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SelectedChip" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
