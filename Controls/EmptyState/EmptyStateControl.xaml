<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Controls/EmptyState/EmptyStateControl.xaml
     PROJECT: ProGlassAutomation
     MODULE: Shared UI — empty / no-data state (§30)

     One consistent, professional empty state used everywhere a list
     can be empty. Styled like the Overview Dashboard cards (round
     shape, tinted icon badge) so every module feels the same.

     Tells the user WHAT belongs in this section and WHAT TO DO —
     never a blank screen.

     Usage:
       <controls:EmptyStateControl Icon="📋"
                                   Title="No job orders yet"
                                   Message="Job orders appear here when
                                            you convert an approved PI."
                                   ActionText="Create"
                                   ActionCommand="{Binding NewCommand}"/>
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Controls.EmptyState.EmptyStateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ProGlassAutomation.Converters"
             x:Name="Root"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <conv:IconFontFamilyConverter x:Key="IconFont"/>
    </UserControl.Resources>

    <Border CornerRadius="20"
            Background="{DynamicResource ModuleBackgroundBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="1.5"
            Padding="34,30"
            MaxWidth="460"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            SnapsToDevicePixels="True">
        <StackPanel HorizontalAlignment="Center">

            <!-- Tinted icon badge (Overview-dashboard style) -->
            <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1.5" Width="64" Height="64"
                    CornerRadius="20"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource TintIndigoBrush}">
                <TextBlock Text="{Binding Icon, ElementName=Root}"
                           FontFamily="{Binding Icon, ElementName=Root, Converter={StaticResource IconFont}}"
                           FontSize="30"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="{Binding Title, ElementName=Root}"
                       FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,16,0,6"
                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>

            <TextBlock Text="{Binding Message, ElementName=Root}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="380"
                       LineHeight="18"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>

            <!-- Optional action button — hidden when no ActionText -->
            <Button Cursor="Hand"
                    HorizontalAlignment="Center"
                    Margin="0,18,0,0"
                    Padding="20,9"
                    BorderThickness="0"
                    Command="{Binding ActionCommand, ElementName=Root}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActionText, ElementName=Root}"
                                         Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource AccentBrush}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="{Binding ActionText, ElementName=Root}"
                           FontSize="12" FontWeight="Bold"
                           Foreground="White"/>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
