<UserControl x:Class="ProGlassAutomation.Controls.Sparkline.SparklineControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="200"
             SizeChanged="OnSizeChanged"
             Background="Transparent">

    <Grid ClipToBounds="True">

        <!-- Filled area under line (optional soft fill for area-chart look) -->
        <Path x:Name="AreaPath"
              Fill="{Binding AreaBrush,
                     RelativeSource={RelativeSource AncestorType=UserControl}}"
              Opacity="0.25"
              IsHitTestVisible="False"/>

        <!-- Line stroke -->
        <Path x:Name="LinePath"
              Stroke="{Binding LineBrush,
                       RelativeSource={RelativeSource AncestorType=UserControl}}"
              StrokeThickness="{Binding LineThickness,
                                RelativeSource={RelativeSource AncestorType=UserControl}}"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              StrokeLineJoin="Round"
              IsHitTestVisible="False"/>

    </Grid>
</UserControl>