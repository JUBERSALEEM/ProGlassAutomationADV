<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Controls/ReportSidebar/ReportSidebarHost.xaml
     PROJECT: ProGlassAutomation
     MODULE: Reports — shared Sheet Store-style right sidebar

     The exact Sheet Store pattern, generalized:
       • Two-column grid: main content (*) + animated detail column.
       • The detail column animates 0 ↔ 376px (360 panel + 16 margin)
         and the panel slides in/out — identical choreography to
         SheetStoreView.
       • The host is a ContentControl: every report puts its own body
         (DataTemplate) into SidebarContent and binds IsOpen to its
         "has selection" property. Close = ClearSelection-style command.

     Usage in a report view:
       <sidebar:ReportSidebarHost IsOpen="{Binding HasSelectedRow}"
                                  CloseCommand="{Binding CloseDetailCommand}"
                                  Title="ROW DETAIL"
                                  Icon="&#xE8B7;">
           <sidebar:ReportSidebarHost.SidebarContent>
               <DataTemplate> ... report-specific body ... </DataTemplate>
           </sidebar:ReportSidebarHost.SidebarContent>
       </sidebar:ReportSidebarHost>
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Controls.ReportSidebar.ReportSidebarHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <!-- Animated panel column: width 0 when closed, expands to
                 376 (360 panel + 16 margin) when open. -->
            <ColumnDefinition x:Name="DetailColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- ══ MAIN CONTENT — the report's list/grid ══ -->
        <ContentPresenter Grid.Column="0"
                          Content="{Binding Content, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

        <!-- ══ RIGHT SLIDE-IN DETAIL PANEL (Sheet Store pattern) ══ -->
        <Grid x:Name="DetailPanel" Grid.Column="1" Margin="14,0,0,0"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="PanelSlide" X="0"/>
            </Grid.RenderTransform>

            <Border Width="360"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="18"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="5"
                                      Direction="270" Opacity="0.18"
                                      Color="#000000"/>
                </Border.Effect>

                <DockPanel>
                    <!-- Panel header — icon + title + close pinned right -->
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38"
                                CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                                Background="{DynamicResource AccentBrush}">
                            <TextBlock x:Name="HeaderIcon"
                                       Text="&#xE8B7;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Margin="12,0,10,0">
                            <TextBlock x:Name="HeaderTitle"
                                       Text="DETAILS"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock x:Name="HeaderSubtitle"
                                       Text=""
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2"
                                Style="{StaticResource RowOutlinedButton}"
                                Tag="&#xE711;" Content=""
                                MinWidth="34" Width="34"
                                VerticalAlignment="Top"
                                ToolTip="Close detail panel"
                                Command="{Binding CloseCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource OutlineBrush}"
                            DockPanel.Dock="Top" Margin="0,14,0,14"/>

                    <!-- Report-specific body -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False"
                                  FocusVisualStyle="{x:Null}">
                        <ContentControl Content="{Binding SidebarContent,
                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ContentTemplate="{Binding SidebarContentTemplate,
                                                       RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
