<UserControl x:Class="ProGlassAutomation.Controls.GradientHeroCard.GradientHeroCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ProGlassAutomation.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="180" d:DesignWidth="360">
    <UserControl.Resources>
        <conv:IconFontFamilyConverter x:Key="IconFont"/>
    </UserControl.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="16"
            Padding="24"
            ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <!-- v2 default: brand blue (was green) — callers can
                     still override via GradientStart/EndColor. -->
                <GradientStop Color="#1E3A8A" Offset="0"/>
                <GradientStop Color="#3B82F6" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <!-- Decorative background circles (like screenshot #3) -->
            <Ellipse Width="240" Height="240"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,-100,-80,0"
                     Fill="White"
                     Opacity="0.08"
                     IsHitTestVisible="False"/>
            <Ellipse Width="160" Height="160"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,0,-40,-60"
                     Fill="White"
                     Opacity="0.06"
                     IsHitTestVisible="False"/>

            <!-- Content: icon badge (top-left) + trend badge (top-right)
                          + value + label -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top row: icon + trend badge -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon badge (translucent white square) -->
                    <Border Grid.Column="0"
                            x:Name="IconBadge"
                            Width="46" Height="46"
                            CornerRadius="12"
                            Background="#33FFFFFF"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                        <TextBlock x:Name="IconText"
                                   Text="{Binding Icon,
                                          RelativeSource={RelativeSource AncestorType=UserControl},
                                          FallbackValue=✨}"
                                   FontSize="22"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Trend badge (top-right, e.g. "↗ 12%") -->
                    <Border Grid.Column="2"
                            x:Name="TrendBadge"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="10,4"
                            Background="#33FFFFFF"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Visibility="{Binding TrendVisibility,
                                         RelativeSource={RelativeSource AncestorType=UserControl},
                                         FallbackValue=Collapsed}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TrendArrow,
                                              RelativeSource={RelativeSource AncestorType=UserControl},
                                              FallbackValue=↗}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TrendText,
                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="4,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Middle: big value -->
                <TextBlock Grid.Row="1"
                           x:Name="ValueText"
                           Text="{Binding Value,
                                  RelativeSource={RelativeSource AncestorType=UserControl},
                                  FallbackValue='—'}"
                           FontSize="36"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Bottom"
                           Margin="0,20,0,0"
                           TextOptions.TextFormattingMode="Display"
                           TextOptions.TextRenderingMode="ClearType"/>

                <!-- Bottom: label -->
                <TextBlock Grid.Row="2"
                           x:Name="LabelText"
                           Text="{Binding Label,
                                  RelativeSource={RelativeSource AncestorType=UserControl},
                                  FallbackValue='Total'}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#DDFFFFFF"
                           Margin="0,4,0,0"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>