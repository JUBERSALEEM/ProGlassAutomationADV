<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Controls/CrystalFluid/CrystalWater.xaml
     PROJECT: ProGlassAutomation
     MODULE: Crystal Fluid — THE water implementation (spec §14–§19)

     ONE reusable component renders every "water inside crystal" surface:
       body (translucent cyan gradient, never a solid slab)
       + broad elliptical surface highlight with subtle drift
       + slow caustic streaks (noticed only up close)
       + 2–4 translucent bubbles rising with drift + fade
     Continuous motion runs on TRANSFORMS only (composition thread —
     no timers, no layout churn; §20/§68). Water-level changes animate
     Height over CrystalWaterLevelDuration with cubic easing (§15).
     §43: CrystalReducedMotion=True → completely static rendering.
     §71: ambient storyboards pause when the control leaves the screen.
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Controls.CrystalFluid.CrystalWater"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Focusable="False"
             IsHitTestVisible="False">

    <UserControl.Resources>
        <!-- ONE ambient storyboard per instance; channels address NAMED
             transforms/elements. SpeedRatio comes from WaterSpeed in
             code-behind. RepeatBehaviour loops the ~16s choreography. -->
        <Storyboard x:Key="AmbientStoryboard" RepeatBehavior="Forever">

            <!-- §17 surface: ±6 px drift + gentle vertical breathing -->
            <DoubleAnimation
                Storyboard.TargetName="SurfaceWaveT"
                Storyboard.TargetProperty="X"
                From="-6" To="6" Duration="0:0:5" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="SurfaceScaleY"
                Storyboard.TargetProperty="ScaleY"
                From="0.85" To="1.1" Duration="0:0:5" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- §18 caustics: two slow streaks crossing the body -->
            <DoubleAnimation
                Storyboard.TargetName="CausticAT"
                Storyboard.TargetProperty="X"
                From="-140" To="420" Duration="0:0:12"/>
            <DoubleAnimation
                Storyboard.TargetName="CausticBT"
                Storyboard.TargetProperty="X"
                From="420" To="-160" Duration="0:0:15" BeginTime="0:0:4"/>

            <!-- §19 bubbles: rise, slight X drift, fade in/out, staggered -->
            <DoubleAnimation
                Storyboard.TargetName="Bubble1T"
                Storyboard.TargetProperty="Y"
                From="0" To="-260" Duration="0:0:7"/>
            <DoubleAnimation
                Storyboard.TargetName="Bubble1XT"
                Storyboard.TargetProperty="X"
                From="0" To="7" Duration="0:0:7"/>
            <DoubleAnimation
                Storyboard.TargetName="BubbleDot1"
                Storyboard.TargetProperty="Opacity"
                To="0.85" Duration="0:0:0.8"/>
            <DoubleAnimation
                Storyboard.TargetName="BubbleDot1"
                Storyboard.TargetProperty="Opacity"
                To="0" Duration="0:0:1.1" BeginTime="0:0:5.9"/>

            <DoubleAnimation
                Storyboard.TargetName="Bubble2T"
                Storyboard.TargetProperty="Y"
                From="0" To="-260" Duration="0:0:9" BeginTime="0:0:2.4"/>
            <DoubleAnimation
                Storyboard.TargetName="Bubble2XT"
                Storyboard.TargetProperty="X"
                From="0" To="-6" Duration="0:0:9" BeginTime="0:0:2.4"/>
            <DoubleAnimation
                Storyboard.TargetName="BubbleDot2"
                Storyboard.TargetProperty="Opacity"
                To="0.75" Duration="0:0:0.9" BeginTime="0:0:2.4"/>
            <DoubleAnimation
                Storyboard.TargetName="BubbleDot2"
                Storyboard.TargetProperty="Opacity"
                To="0" Duration="0:0:1.2" BeginTime="0:0:10.2"/>

            <DoubleAnimation
                Storyboard.TargetName="Bubble3T"
                Storyboard.TargetProperty="Y"
                From="0" To="-260" Duration="0:0:10" BeginTime="0:0:5"/>
            <DoubleAnimation
                Storyboard.TargetName="Bubble3XT"
                Storyboard.TargetProperty="X"
                From="0" To="5" Duration="0:0:10" BeginTime="0:0:5"/>
            <DoubleAnimation
                Storyboard.TargetName="BubbleDot3"
                Storyboard.TargetProperty="Opacity"
                To="0.65" Duration="0:0:1" BeginTime="0:0:5"/>
            <DoubleAnimation
                Storyboard.TargetName="BubbleDot3"
                Storyboard.TargetProperty="Opacity"
                To="0" Duration="0:0:1.4" BeginTime="0:0:13.6"/>
        </Storyboard>
    </UserControl.Resources>

    <!-- Root is clipped to the host card's CornerRadius in code (§62) -->
    <Grid x:Name="RootGrid" Opacity="{Binding WaterOpacity, ElementName=Root}">

        <!-- water area: bottom-anchored; Height = level × host height
             (maintained in code-behind so §15 easing animates it) -->
        <Grid x:Name="WaterArea"
                  VerticalAlignment="Bottom"
                  Height="0"
                  ClipToBounds="True">

            <!-- §16 body — translucent crystal water gradient -->
            <Border Background="{DynamicResource CrystalWaterBrush}"
                    SnapsToDevicePixels="False"/>

            <!-- §18 caustic streaks (clipped inside the body) -->
            <Canvas x:Name="CausticsLayer">
                <Canvas.Style>
                    <Style TargetType="Canvas">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CausticsEnabled, ElementName=Root}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Canvas.Style>
                <Border x:Name="CausticBarA" Width="120" Height="400"
                        Canvas.Left="0" Canvas.Top="-40"
                        Background="{DynamicResource CrystalCausticBrush}"
                        Opacity="{DynamicResource CrystalCausticOpacity}">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <RotateTransform Angle="16"/>
                            <TranslateTransform x:Name="CausticAT" X="-140"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                </Border>
                <Border x:Name="CausticBarB" Width="150" Height="400"
                        Canvas.Left="0" Canvas.Top="-30"
                        Background="{DynamicResource CrystalCausticBrush}"
                        Opacity="{DynamicResource CrystalCausticOpacity}">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <RotateTransform Angle="-12"/>
                            <TranslateTransform x:Name="CausticBT" X="420"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                </Border>
            </Canvas>

            <!-- §19 bubbles (sparse; clipped inside the body; X positions
                 are laid out in code-behind against the live width) -->
            <Canvas x:Name="BubbleLayer">
                <Canvas.Style>
                    <Style TargetType="Canvas">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BubbleEnabled, ElementName=Root}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Canvas.Style>
                <Ellipse x:Name="BubbleDot1" Width="9" Height="9" Opacity="0"
                         Canvas.Left="0" Canvas.Bottom="6"
                         Fill="{DynamicResource CrystalBubbleBrush}">
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="Bubble1T" Y="0"/>
                            <TranslateTransform x:Name="Bubble1XT" X="0"/>
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="BubbleDot2" Width="6" Height="6" Opacity="0"
                         Canvas.Left="0" Canvas.Bottom="4"
                         Fill="{DynamicResource CrystalBubbleBrush}">
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="Bubble2T" Y="0"/>
                            <TranslateTransform x:Name="Bubble2XT" X="0"/>
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="BubbleDot3" Width="12" Height="12" Opacity="0"
                         Canvas.Left="0" Canvas.Bottom="8"
                         Fill="{DynamicResource CrystalBubbleBrush}">
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="Bubble3T" Y="0"/>
                            <TranslateTransform x:Name="Bubble3XT" X="0"/>
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>

            <!-- §17 surface — broad elliptical highlight on the waterline;
                 Height follows WaveAmplitude. -->
            <Grid VerticalAlignment="Top" Height="22" Margin="0,-11,0,0">
                <Ellipse x:Name="SurfaceWave"
                         Fill="{DynamicResource CrystalWaterSurfaceBrush}"
                         Height="{Binding WaveAmplitude, ElementName=Root}"
                         Margin="-60,0,-60,0">
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="SurfaceWaveT" X="-6"/>
                            <ScaleTransform x:Name="SurfaceScaleY" ScaleY="1" CenterY="11"/>
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
