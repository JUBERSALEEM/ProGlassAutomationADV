<UserControl x:Class="ProGlassAutomation.Controls.GlobalSearch.GlobalSearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             mc:Ignorable="d"
             d:DesignWidth="460"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- Compact top-bar module filter with rounded outline -->
        <Style x:Key="GsModuleComboStyle" TargetType="ComboBox">
            <Setter Property="Template" Value="{StaticResource Themed.ComboBoxTemplate}"/>
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="Foreground"               Value="#211D31"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="FontSize"                 Value="11"/>
            <Setter Property="FontWeight"               Value="SemiBold"/>
            <Setter Property="Height"                   Value="24"/>
            <Setter Property="MinWidth"                 Value="100"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ToolTip"                  Value="{DynamicResource ToolTip.SearchModuleFilter}"/>
        </Style>

        <!-- Borderless query box -->
        <Style x:Key="GsInputStyle" TargetType="TextBox">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="Foreground"               Value="#211D31"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="FontSize"                 Value="11.5"/>
            <Setter Property="Height"                   Value="26"/>
            <Setter Property="MinWidth"                 Value="150"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush"               Value="#443A86"/>
        </Style>

        <Style x:Key="GsResultTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#211D31"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="GsResultSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="#6B6580"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin"     Value="0,2,0,0"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <!-- ══════════════════════════════════════════════════════════════
             SEARCH ISLAND (Concept 30 PORCELAIN FLOW)
             Rounded white inset with fine purple (#8E82D8) focus rim
             and outline dropdown labeled "All Modules".
        ══════════════════════════════════════════════════════════════ -->
        <Border x:Name="SearchPill"
                CornerRadius="18"
                Height="36"
                Padding="4,0,8,0"
                VerticalAlignment="Center"
                Background="#FFFFFF"
                BorderBrush="#8E82D8"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Rounded outline dropdown labeled exactly "All Modules" -->
                <Border BorderBrush="#D9D5E6"
                        BorderThickness="1"
                        CornerRadius="12"
                        Background="#FCFCFE"
                        Padding="6,1"
                        Margin="2,0,6,0"
                        VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding ModuleOptions}"
                              SelectedItem="{Binding SelectedModule}"
                              Style="{StaticResource GsModuleComboStyle}"/>
                </Border>

                <!-- Search glyph -->
                <TextBlock Text="&#xE721;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="2,0,6,0"
                           Foreground="#8E82D8"/>

                <!-- Divider -->
                <Border Width="1"
                        Height="18"
                        Margin="2,0,6,0"
                        Background="#D9D5E6"/>

                <!-- Query box with placeholder watermark "Search anything…" -->
                <Grid>
                    <TextBlock Text="{DynamicResource Shell.SearchWatermark}"
                               FontSize="11.5"
                               VerticalAlignment="Center"
                               Margin="2,0,0,0"
                               IsHitTestVisible="False"
                               Foreground="#6B6580">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=QueryBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=QueryBox}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="QueryBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                             Style="{StaticResource GsInputStyle}"
                             ToolTip="{DynamicResource ToolTip.SearchQuery}"/>
                </Grid>

                <Button Command="{Binding ClearCommand}"
                        Content="&#xE711;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Width="20" Height="20"
                        Padding="0"
                        Cursor="Hand"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="#6B6580"
                        VerticalAlignment="Center"
                        ToolTip="{DynamicResource ToolTip.ClearSearch}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             RESULTS POPUP
        ══════════════════════════════════════════════════════════════ -->
        <Popup IsOpen="{Binding IsOpen, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=SearchPill}"
               Placement="Bottom"
               VerticalOffset="6"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               MaxHeight="460">

            <Border Background="#FFFFFF"
                    BorderBrush="#D9D5E6"
                    BorderThickness="1"
                    CornerRadius="10"
                    MinWidth="440"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Result rows -->
                    <ListBox Grid.Row="0"
                             ItemsSource="{Binding Results}"
                             SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             MaxHeight="400"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="12,9"
                                        Background="Transparent"
                                        BorderBrush="#D9D5E6"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="26" Height="26"
                                                CornerRadius="6"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"
                                                Background="#E6E1F4">
                                            <TextBlock Text="{Binding Glyph}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="#443A86"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       Style="{StaticResource GsResultTitleStyle}"/>
                                            <TextBlock Text="{Binding Subtitle}"
                                                       Style="{StaticResource GsResultSubtitleStyle}"/>
                                        </StackPanel>

                                        <Border BorderBrush="#D9D5E6" BorderThickness="1" Grid.Column="2"
                                                CornerRadius="6"
                                                Padding="8,3"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Background="#E6E1F4">
                                            <TextBlock Text="{Binding ModuleLabel}"
                                                       FontSize="9.5"
                                                       FontWeight="Bold"
                                                       Foreground="#443A86"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state -->
                    <Border Grid.Row="0"
                            Padding="20,26"
                            Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="20"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"
                                       Foreground="#8E82D8"/>
                            <TextBlock Text="{DynamicResource Shell.SearchNoMatches}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="#211D31"/>
                            <TextBlock Text="{DynamicResource Shell.SearchNoMatchesHint}"
                                       FontSize="10.5"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"
                                       Foreground="#6B6580"/>
                        </StackPanel>
                    </Border>

                    <!-- Status footer -->
                    <Border BorderBrush="#D9D5E6" BorderThickness="0,1,0,0" Grid.Row="1"
                            Padding="12,7"
                            Background="#F5F5F8"
                            CornerRadius="0,0,10,10">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="10"
                                   Foreground="#6B6580"/>
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
