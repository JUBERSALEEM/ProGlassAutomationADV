<UserControl x:Class="ProGlassAutomation.Controls.GlobalSearch.GlobalSearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             mc:Ignorable="d"
             d:DesignWidth="420"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- Compact top-bar module filter -->
        <Style x:Key="GsModuleComboStyle" TargetType="ComboBox">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="Foreground"               Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="FontWeight"               Value="SemiBold"/>
            <Setter Property="Height"                   Value="26"/>
            <Setter Property="Width"                    Value="120"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ToolTip"                  Value="{DynamicResource ToolTip.SearchModuleFilter}"/>
        </Style>

        <!-- Borderless query box -->
        <Style x:Key="GsInputStyle" TargetType="TextBox">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="Foreground"               Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="Height"                   Value="26"/>
            <Setter Property="MinWidth"                 Value="150"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush"               Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style x:Key="GsResultTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="GsResultSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin"     Value="0,2,0,0"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <!-- ══════════════════════════════════════════════════════════════
             SEARCH PILL — module filter · query · clear
        ══════════════════════════════════════════════════════════════ -->
        <Border x:Name="SearchPill"
                CornerRadius="{StaticResource TopPillCornerRadius}"
                Height="36"
                Padding="14,0,8,0"
                VerticalAlignment="Center"
                Background="{DynamicResource ElevatedSurfaceBrush}"
                BorderThickness="{DynamicResource CardBorderThickness}"
                SnapsToDevicePixels="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Search glyph -->
                <TextBlock Text="&#xE721;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="{StaticResource TextBodyLarge}"
                           VerticalAlignment="Center"
                           Margin="2,0,10,0"
                           Foreground="{DynamicResource AccentBrush}"/>

                <ComboBox ItemsSource="{Binding ModuleOptions}"
                          SelectedItem="{Binding SelectedModule}"
                          Style="{StaticResource GsModuleComboStyle}"/>

                <Border Width="1"
                        Margin="8,8"
                        Background="{DynamicResource DividerBrush}"/>

                <!-- Query box with a placeholder watermark so the field never
                     reads as an empty shape - it shows "Search anything..." only
                     while the query is blank. -->
                <Grid>
                    <TextBlock Text="{DynamicResource Shell.SearchWatermark}"
                               FontSize="{StaticResource TextBody}"
                               VerticalAlignment="Center"
                               Margin="2,0,0,0"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource MutedForegroundBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=QueryBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=QueryBox}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="QueryBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                             Style="{StaticResource GsInputStyle}"
                             ToolTip="{DynamicResource ToolTip.SearchQuery}"/>
                </Grid>

                <Button Command="{Binding ClearCommand}"
                        Content="&#xE711;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="{StaticResource TextCaption}"
                        Width="20" Height="20"
                        Padding="0"
                        Cursor="Hand"
                        BorderThickness="{DynamicResource Border.NoneThickness}"
                        Background="Transparent"
                        Foreground="{DynamicResource MutedForegroundBrush}"
                        VerticalAlignment="Center"
                        ToolTip="{DynamicResource ToolTip.ClearSearch}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             RESULTS POPUP
        ══════════════════════════════════════════════════════════════ -->
        <Popup IsOpen="{Binding IsOpen, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=SearchPill}"
               Placement="Bottom"
               VerticalOffset="6"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               MaxHeight="460">

            <Border Background="{DynamicResource PopupSurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    MinWidth="440"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Result rows -->
                    <ListBox Grid.Row="0"
                             ItemsSource="{Binding Results}"
                             SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="{DynamicResource Border.NoneThickness}"
                             MaxHeight="400"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="{DynamicResource CardCornerRadius}" Padding="12,9"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource OutlineBrush}"
                                        BorderThickness="{DynamicResource Border.BottomHairlineThickness}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="26" Height="26"
                                                CornerRadius="{DynamicResource CardCornerRadius}"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource TintIndigoBrush}">
                                            <TextBlock Text="{Binding Glyph}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="{StaticResource TextBody}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       Style="{StaticResource GsResultTitleStyle}"/>
                                            <TextBlock Text="{Binding Subtitle}"
                                                       Style="{StaticResource GsResultSubtitleStyle}"/>
                                        </StackPanel>

                                        <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Grid.Column="2"
                                                CornerRadius="{DynamicResource CardCornerRadius}"
                                                Padding="8,3"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource TintIndigoBrush}">
                                            <TextBlock Text="{Binding ModuleLabel}"
                                                       FontSize="{StaticResource TextXSmall}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state -->
                    <Border Grid.Row="0"
                            Padding="20,26"
                            Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource TextHeadline}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <TextBlock Text="{DynamicResource Shell.SearchNoMatches}"
                                       FontSize="{StaticResource TextBody}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="{DynamicResource Shell.SearchNoMatchesHint}"
                                       FontSize="{StaticResource TextCaption}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Status footer -->
                    <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Grid.Row="1"
                            Padding="12,7"
                            Background="{DynamicResource PopupSurfaceBrush}"
                            CornerRadius="{DynamicResource Radius.Bottom.Medium}">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="{StaticResource TextCaption}"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
