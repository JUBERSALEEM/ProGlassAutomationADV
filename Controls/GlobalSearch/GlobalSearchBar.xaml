<UserControl x:Class="ProGlassAutomation.Controls.GlobalSearch.GlobalSearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             mc:Ignorable="d"
             d:DesignWidth="420"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- Compact top-bar module filter -->
        <Style x:Key="GsModuleComboStyle" TargetType="ComboBox">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="Foreground"               Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="FontSize"                 Value="10.5"/>
            <Setter Property="FontWeight"               Value="SemiBold"/>
            <Setter Property="Height"                   Value="26"/>
            <Setter Property="Width"                    Value="120"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ToolTip"                  Value="Limit the search to one module"/>
        </Style>

        <!-- Borderless query box -->
        <Style x:Key="GsInputStyle" TargetType="TextBox">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="Foreground"               Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="Height"                   Value="26"/>
            <Setter Property="MinWidth"                 Value="150"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush"               Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style x:Key="GsResultTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="GsResultSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin"     Value="0,2,0,0"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <!-- ══════════════════════════════════════════════════════════════
             SEARCH PILL — module filter · query · clear
        ══════════════════════════════════════════════════════════════ -->
        <Border x:Name="SearchPill"
                CornerRadius="999"
                Padding="10,3"
                Background="{DynamicResource MenuHoverBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <TextBlock Text="&#xE721;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="2,0,8,0"
                           Foreground="{DynamicResource AccentBrush}"/>

                <ComboBox ItemsSource="{Binding ModuleOptions}"
                          SelectedItem="{Binding SelectedModule}"
                          Style="{StaticResource GsModuleComboStyle}"/>

                <Border Width="1"
                        Margin="8,4"
                        Background="{DynamicResource DividerBrush}"/>

                <TextBox x:Name="QueryBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                         Style="{StaticResource GsInputStyle}"
                         ToolTip="Search documents, companies and clients across every module"/>

                <Button Command="{Binding ClearCommand}"
                        Content="&#xE711;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Width="20" Height="20"
                        Padding="0"
                        Cursor="Hand"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="{DynamicResource MutedForegroundBrush}"
                        VerticalAlignment="Center"
                        ToolTip="Clear search">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             RESULTS POPUP
        ══════════════════════════════════════════════════════════════ -->
        <Popup IsOpen="{Binding IsOpen, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=SearchPill}"
               Placement="Bottom"
               VerticalOffset="6"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               MaxHeight="460">

            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    MinWidth="440"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Result rows -->
                    <ListBox Grid.Row="0"
                             ItemsSource="{Binding Results}"
                             SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             MaxHeight="400"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,9"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="26" Height="26"
                                                CornerRadius="7"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource TintIndigoBrush}">
                                            <TextBlock Text="{Binding Glyph}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       Style="{StaticResource GsResultTitleStyle}"/>
                                            <TextBlock Text="{Binding Subtitle}"
                                                       Style="{StaticResource GsResultSubtitleStyle}"/>
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                CornerRadius="999"
                                                Padding="8,3"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource TintIndigoBrush}">
                                            <TextBlock Text="{Binding ModuleLabel}"
                                                       FontSize="9.5"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state -->
                    <Border Grid.Row="0"
                            Padding="20,26"
                            Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="22"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <TextBlock Text="No matches"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="Try a document number, customer or project name."
                                       FontSize="10.5"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Status footer -->
                    <Border Grid.Row="1"
                            Padding="12,7"
                            Background="{DynamicResource MenuHoverBrush}"
                            CornerRadius="0,0,12,12">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="10"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
