<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ═══════════════════════════════════════════════════════════════════
         IOS-17PM — NAVIGATION (P2 2026-09-05)
         Integrated port of the authored CrystalFluidNavigation.xaml
         (incoming file 15). Changes:
           +   No-op TextTransform="" setter removed from the label style.
           Note: GroupName="CrystalNav" stays authored — one sidebar
           selection group per namescope; per-instance override remains
           possible (style setter, not local value).
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- =====================================================
         CRYSTAL NAVIGATION BUTTON
         ===================================================== -->

    <Style x:Key="CrystalNavButtonStyle"
           TargetType="RadioButton">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{StaticResource CrystalNavTextBrush}" />
        <Setter Property="Padding"
                Value="{StaticResource CrystalNavItemPadding}" />
        <Setter Property="FontSize"
                Value="{StaticResource CrystalFontSizeBody}" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="GroupName"
                Value="CrystalNav" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="NavBorder"
                            CornerRadius="{StaticResource
                                CrystalRadiusMedium}"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            Margin="0,2">

                        <ContentPresenter
                            VerticalAlignment="Center" />

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="NavBorder"
                                    Property="Background"
                                    Value="{StaticResource
                                        CrystalNavHoverBgBrush}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource
                                        CrystalAccentDeepBrush}" />
                        </Trigger>

                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="NavBorder"
                                    Property="Background"
                                    Value="{StaticResource
                                        CrystalNavActiveBgBrush}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource
                                        CrystalNavActiveTextBrush}" />
                            <Setter TargetName="NavBorder"
                                    Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect
                                        Color="{StaticResource
                                            CrystalShadowColor}"
                                        BlurRadius="20"
                                        ShadowDepth="8"
                                        Direction="270"
                                        Opacity="0.12" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- =====================================================
         NAVIGATION SECTION LABEL
         ===================================================== -->

    <Style x:Key="CrystalNavLabelStyle"
           TargetType="TextBlock">
        <Setter Property="FontSize"
                Value="{StaticResource CrystalFontSizeLabel}" />
        <Setter Property="Foreground"
                Value="{StaticResource CrystalMutedLightBrush}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Margin"
                Value="10,15,10,5" />
    </Style>

</ResourceDictionary>
