<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ═══════════════════════════════════════════════════════════════════
         IOS-17PM — GLOBAL STYLES (P2 2026-09-05)
         Integrated port of the authored CrystalFluidStyles.xaml
         (incoming file 12) with the fix register applied:
           D24 Primary button carries its OWN template — the authored
               BasedOn shared the glass template, whose hover trigger
               repaints Background with CrystalButtonHoverBrush, so the
               accent button turned to glass on hover. The dedicated
               template consumes the authored CrystalPrimaryButtonHoverBrush.
           D25 ComboBox ToggleButton `Template="{x:Null}"` removed — a
               local null would shadow the inline style's transparent
               template (local values outrank style setters).
           D26 CrystalComboBoxStyle now sets ItemContainerStyle — the
               authored item style shipped but was never wired, so popup
               items rendered with the platform chrome.
           D33 Disabled opacity reads the CrystalOpacityDisabled token;
               unused xmlns removed; font follows the app AppFontFamily
               (FontService/localization live) instead of a hardcode;
               popup chrome uses CrystalPopupBackgroundBrush.
           D34 The authored ItemsPresenter split the attached-property
               name across lines (KeyboardNavigation\n.DirectionalNavigation)
               — malformed XML that cannot parse; single-line here.
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- =====================================================
         CRYSTAL BUTTON
         ===================================================== -->

    <Style x:Key="CrystalButtonStyle"
           TargetType="Button">
        <Setter Property="Background"
                Value="{StaticResource CrystalButtonBackgroundBrush}" />
        <Setter Property="Foreground"
                Value="{StaticResource CrystalInkBrush}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource CrystalGlassBorderBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Padding"
                Value="{StaticResource CrystalButtonPadding}" />
        <Setter Property="FontSize"
                Value="{StaticResource CrystalFontSizeBody}" />
        <Setter Property="FontFamily"
                Value="{DynamicResource AppFontFamily}" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Shadow -->
                        <Border x:Name="ShadowBorder"
                                CornerRadius="{StaticResource
                                    CrystalRadiusSmall}"
                                Margin="2,1,2,4">
                            <Border.Effect>
                                <DropShadowEffect
                                    Color="{StaticResource
                                        CrystalShadowColor}"
                                    BlurRadius="18"
                                    ShadowDepth="7"
                                    Direction="270"
                                    Opacity="0.18" />
                            </Border.Effect>
                        </Border>

                        <Border x:Name="MainBorder"
                                CornerRadius="{StaticResource
                                    CrystalRadiusSmall}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding
                                    BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">

                            <Grid>
                                <!-- Inner top highlight -->
                                <Border CornerRadius="{StaticResource
                                            CrystalRadiusSmall}"
                                        BorderThickness="{DynamicResource Border.TopHairlineThickness}"
                                        BorderBrush="{StaticResource
                                            CrystalHighlightBrush}"
                                        Background="Transparent"
                                        IsHitTestVisible="False" />

                                <ContentPresenter
                                    HorizontalAlignment=
                                        "{TemplateBinding
                                            HorizontalContentAlignment}"
                                    VerticalAlignment=
                                        "{TemplateBinding
                                            VerticalContentAlignment}"
                                    RecognizesAccessKey="True" />
                            </Grid>

                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="MainBorder"
                                    Property="Background"
                                    Value="{StaticResource
                                        CrystalButtonHoverBrush}" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="-1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="MainBorder"
                                    Property="Background"
                                    Value="{StaticResource
                                        CrystalButtonPressedBrush}" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Opacity"
                                    Value="{StaticResource
                                        CrystalOpacityDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- =====================================================
         CRYSTAL PRIMARY BUTTON (D24: dedicated template — hover keeps
         the accent, consumes the authored primary-hover brush)
         ===================================================== -->

    <Style x:Key="CrystalPrimaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource CrystalButtonStyle}">
        <Setter Property="Background"
                Value="{StaticResource CrystalPrimaryButtonBrush}" />
        <Setter Property="Foreground"
                Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="ShadowBorder"
                                CornerRadius="{StaticResource
                                    CrystalRadiusSmall}"
                                Margin="2,1,2,4">
                            <Border.Effect>
                                <DropShadowEffect
                                    Color="{StaticResource
                                        CrystalShadowColor}"
                                    BlurRadius="18"
                                    ShadowDepth="7"
                                    Direction="270"
                                    Opacity="0.18" />
                            </Border.Effect>
                        </Border>

                        <Border x:Name="MainBorder"
                                CornerRadius="{StaticResource
                                    CrystalRadiusSmall}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding
                                    BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">

                            <Grid>
                                <Border CornerRadius="{StaticResource
                                            CrystalRadiusSmall}"
                                        BorderThickness="{DynamicResource Border.TopHairlineThickness}"
                                        BorderBrush="{StaticResource
                                            CrystalHighlightBrush}"
                                        Background="Transparent"
                                        IsHitTestVisible="False" />

                                <ContentPresenter
                                    HorizontalAlignment=
                                        "{TemplateBinding
                                            HorizontalContentAlignment}"
                                    VerticalAlignment=
                                        "{TemplateBinding
                                            VerticalContentAlignment}"
                                    RecognizesAccessKey="True" />
                            </Grid>

                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="MainBorder"
                                    Property="Background"
                                    Value="{StaticResource
                                        CrystalPrimaryButtonHoverBrush}" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="-1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="MainBorder"
                                    Property="Background"
                                    Value="{StaticResource
                                        CrystalAccentDarkBrush}" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Opacity"
                                    Value="{StaticResource
                                        CrystalOpacityDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- =====================================================
         CRYSTAL TEXTBOX
         ===================================================== -->

    <Style x:Key="CrystalTextBoxStyle"
           TargetType="TextBox">
        <Setter Property="Background"
                Value="{StaticResource CrystalButtonBackgroundBrush}" />
        <Setter Property="Foreground"
                Value="{StaticResource CrystalInkBrush}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource CrystalGlassBorderBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Padding"
                Value="{StaticResource CrystalInputPadding}" />
        <Setter Property="FontSize"
                Value="{StaticResource CrystalFontSizeBody}" />
        <Setter Property="CaretBrush"
                Value="{StaticResource CrystalAccentBrush}" />
        <Setter Property="SelectionBrush"
                Value="{StaticResource CrystalAccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            CornerRadius="{StaticResource
                                CrystalRadiusSmall}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding
                                BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            Focusable="False" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused"
                                 Value="True">
                            <Setter TargetName="border"
                                    Property="BorderBrush"
                                    Value="{StaticResource
                                        CrystalInputFocusBorderBrush}" />
                            <Setter TargetName="border"
                                    Property="Background"
                                    Value="{StaticResource
                                        CrystalButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Opacity"
                                    Value="{StaticResource
                                        CrystalOpacityDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- =====================================================
         CRYSTAL COMBOBOX
         ===================================================== -->

    <Style x:Key="CrystalComboBoxStyle"
           TargetType="ComboBox">
        <Setter Property="Background"
                Value="{StaticResource CrystalButtonBackgroundBrush}" />
        <Setter Property="Foreground"
                Value="{StaticResource CrystalInkBrush}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource CrystalGlassBorderBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Padding"
                Value="{StaticResource CrystalInputPadding}" />
        <Setter Property="FontSize"
                Value="{StaticResource CrystalFontSizeBody}" />
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
        <!-- D26: wire the authored item chrome (was shipped unwired —
             popup items rendered with platform chrome) -->
        <Setter Property="ItemContainerStyle"
                Value="{DynamicResource CrystalComboBoxItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="border"
                                CornerRadius="{StaticResource
                                    CrystalRadiusSmall}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding
                                    BorderThickness}"
                                Padding="{TemplateBinding Padding}">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter
                                    Content="{TemplateBinding
                                        SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding
                                        SelectionBoxItemTemplate}"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False" />

                                <Path Grid.Column="1"
                                      Data="M0,0 L4,4 L8,0"
                                      Stroke="{StaticResource
                                          CrystalMutedBrush}"
                                      StrokeThickness="1.5"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Margin="0,2,0,0" />
                            </Grid>

                        </Border>

                        <!-- Toggle button for opening dropdown (D25: the
                             authored `Template="{x:Null}"` local value
                             would shadow this inline style's transparent
                             template — removed) -->
                        <ToggleButton
                            x:Name="ToggleButton"
                            IsChecked="{Binding IsDropDownOpen,
                                Mode=TwoWay,
                                RelativeSource={RelativeSource
                                    TemplatedParent}}"
                            Focusable="False"
                            ClickMode="Press"
                            Background="Transparent"
                            BorderThickness="{DynamicResource Border.NoneThickness}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate
                                                TargetType="ToggleButton">
                                                <Border
                                                    Background="Transparent" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>

                        <!-- Dropdown popup -->
                        <Popup x:Name="Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">

                            <Border MinWidth="{TemplateBinding
                                        ActualWidth}"
                                    MaxHeight="{TemplateBinding
                                        MaxDropDownHeight}"
                                    Margin="8,4,8,12"
                                    CornerRadius="{StaticResource
                                        CrystalRadiusMedium}"
                                    Background="{StaticResource
                                        CrystalPopupBackgroundBrush}"
                                    BorderBrush="{StaticResource
                                        CrystalGlassBorderBrush}"
                                    BorderThickness="{DynamicResource Border.HairlineThickness}">
                                <Border.Effect>
                                    <DropShadowEffect
                                        Color="{StaticResource
                                            CrystalShadowColor}"
                                        BlurRadius="24"
                                        ShadowDepth="8"
                                        Direction="270"
                                        Opacity="0.25" />
                                </Border.Effect>

                                <ScrollViewer
                                    VerticalScrollBarVisibility="Auto"
                                    Margin="4">
                                    <ItemsPresenter
                                        SnapsToDevicePixels="True"
                                        KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>

                        </Popup>

                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="border"
                                    Property="Background"
                                    Value="{StaticResource
                                        CrystalButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen"
                                 Value="True">
                            <Setter TargetName="border"
                                    Property="BorderBrush"
                                    Value="{StaticResource
                                        CrystalInputFocusBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- COMBOBOX ITEM -->
    <Style x:Key="CrystalComboBoxItemStyle"
           TargetType="ComboBoxItem">
        <Setter Property="Padding"
                Value="12,8" />
        <Setter Property="Foreground"
                Value="{StaticResource CrystalInkBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            CornerRadius="{DynamicResource Radius.Medium}"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            Margin="2">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted"
                                 Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource
                                        CrystalNavHoverBgBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource
                                        CrystalNavActiveBgBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- =====================================================
         CRYSTAL TOOLTIP
         ===================================================== -->

    <Style x:Key="CrystalToolTipStyle"
           TargetType="ToolTip">
        <Setter Property="Background"
                Value="{StaticResource CrystalTooltipBackgroundBrush}" />
        <Setter Property="Foreground"
                Value="{StaticResource CrystalInkBrush}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource CrystalTooltipBorderBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Padding"
                Value="12,8" />
        <Setter Property="FontSize"
                Value="{StaticResource CrystalFontSizeSmall}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border CornerRadius="{StaticResource
                                CrystalRadiusXSmall}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding
                                BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect
                                Color="{StaticResource
                                    CrystalShadowColor}"
                                BlurRadius="20"
                                ShadowDepth="6"
                                Direction="270"
                                Opacity="0.20" />
                        </Border.Effect>
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
