<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <!-- ═══════════════════════════════════════════════════════════════════
         CRYSTAL FLUID — PIPELINE EXTENSION TOKENS (Ios-17pm, P1 2026-09-05)

         The token PLANE now lives in three byte-verbatim reference
         dictionaries (the "Ios-17pm" authored source of truth):
           CrystalFluidColors.xaml   — 47 color nouns
           CrystalFluidBrushes.xaml  — 60 brush nouns
           CrystalFluidMetrics.xaml  — radii/padding/type/motion/opacity
         This file carries ONLY what those three deliberately do NOT:

           (A) PIPELINE KEYS (5) — app-lifecycle material parameters the
               VisualThemeEngine overrides at runtime and the Theme Studio
               binds live (engine key list: VisualThemeEngine.Part1.cs
               CrystalFluidTokenKeys + the family gate). They belong to the
               app integration layer, not the authored design system.
           (B) TRANSITIONAL BRUSHES (3) — consumed ONLY by the interim
               Controls/CrystalFluid/CrystalWater.xaml. P2 landed the
               authored CrystalWaterControl (paints from
               CrystalWaterBodyBrush / CrystalWaterHighlightBrush /
               CrystalWaterDepthBrush / CrystalBubbleFillBrush …);
               P4 migrates the hosts (StatCard, previews) onto it, and
               then these three keys, the interim control, and this
               section are DELETED.

         Nothing else may be added here: new visual nouns go into the
         three authored dictionaries; new app switches need the same
         lifecycle wiring the pipeline keys below already have.
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- ── (A) PIPELINE KEYS ──────────────────────────────────────────── -->

    <!-- Studio WaterFlow slider + engine override: ambient speed scale
         (authored system has no speed axis). Consumed by CrystalWater
         (style setter) | VisualThemeEngine | ThemeStudioService. -->
    <sys:Double x:Key="CrystalWaterSpeed">1.0</sys:Double>

    <!-- Studio WaterFlow slider + engine override: bubble-layer opacity.
         (Authored metrics expose CrystalBubbleMaxOpacity=0.70 as the
         design ceiling; this is the LIVE multiplier.) Consumed by
         CrystalWater | VisualThemeEngine | ThemeStudioService. -->
    <sys:Double x:Key="CrystalBubbleOpacity">1.0</sys:Double>

    <!-- §43 reduced motion — global switch; CrystalWater renders a
         STATIC water body when True. Engine-managed; authored
         components read it as their default ReducedMotion value. -->
    <sys:Boolean x:Key="CrystalReducedMotion">False</sys:Boolean>

    <!-- Family-aware water gate: Crystal Fluid's painter publishes True
         at app level; the switch-away path removes it (see
         VisualThemeEngine next to ClearOverrides). Every other family
         sees this static False — water is a Crystal Fluid material,
         not a global effect (industrial families keep their
         no-theatre law). Consumed by StatCardControl | StatCard XAML. -->
    <sys:Boolean x:Key="CrystalWaterDefaultEnabled">False</sys:Boolean>

    <!-- §42 card-lift duration (0.32 s). The authored metrics carry
         hover/transition/water durations but no card-lift axis; P2's
         card tilt/lift consumes this. -->
    <Duration x:Key="CrystalCardDuration">0:0:0.32</Duration>

    <!-- ── (B) TRANSITIONAL BRUSHES — P2 TOMBSTONE ──────────────────────
         Kept verbatim from Milestone 1 so the interim CrystalWater
         control renders unchanged until the authored CrystalWaterControl
         replaces it. Do NOT add new consumers; P2 deletes this region. -->

    <!-- §16 water body — interim translucent cyan gradient -->
    <LinearGradientBrush x:Key="CrystalWaterBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#59BFEFFB" Offset="0"/>
        <GradientStop Color="#808EDCF4" Offset="0.45"/>
        <GradientStop Color="#995FC8EC" Offset="1"/>
    </LinearGradientBrush>
    <!-- §17 surface highlight band (interim elliptical waterline sheen) -->
    <LinearGradientBrush x:Key="CrystalWaterSurfaceBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#CCFFFFFF" Offset="0"/>
        <GradientStop Color="#59FFFFFF" Offset="0.5"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <!-- §19 bubble: translucent white shell, cyan core (interim) -->
    <RadialGradientBrush x:Key="CrystalBubbleBrush" po:Freeze="True">
        <GradientStop Color="#66FFFFFF" Offset="0"/>
        <GradientStop Color="#3DD6F4FF" Offset="0.55"/>
        <GradientStop Color="#12A8E4F4" Offset="1"/>
    </RadialGradientBrush>
</ResourceDictionary>
