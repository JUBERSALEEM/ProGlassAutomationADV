<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================
         CRYSTAL FLUID DESIGN SYSTEM — BRUSH TOKENS
         ===================================================== -->

    <!-- ─── TEXT ─── -->

    <SolidColorBrush x:Key="CrystalInkBrush"
                     Color="{StaticResource CrystalInkColor}" />

    <SolidColorBrush x:Key="CrystalInkLightBrush"
                     Color="{StaticResource CrystalInkLightColor}" />

    <SolidColorBrush x:Key="CrystalMutedBrush"
                     Color="{StaticResource CrystalMutedColor}" />

    <SolidColorBrush x:Key="CrystalMutedLightBrush"
                     Color="{StaticResource CrystalMutedLightColor}" />


    <!-- ─── ACCENT ─── -->

    <SolidColorBrush x:Key="CrystalAccentBrush"
                     Color="{StaticResource CrystalAccentColor}" />

    <SolidColorBrush x:Key="CrystalAccentDarkBrush"
                     Color="{StaticResource CrystalAccentDarkColor}" />

    <SolidColorBrush x:Key="CrystalAccentDeepBrush"
                     Color="{StaticResource CrystalAccentDeepColor}" />


    <!-- ─── ENVIRONMENT ─── -->

    <LinearGradientBrush x:Key="CrystalEnvironmentBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="{StaticResource CrystalEnvBaseColor}"
                      Offset="0" />
        <GradientStop Color="{StaticResource CrystalEnvMidColor}"
                      Offset="0.48" />
        <GradientStop Color="{StaticResource CrystalEnvLightColor}"
                      Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="CrystalEnvironmentHighlightTopLeftBrush"
                         Center="0.12,0.08"
                         GradientOrigin="0.12,0.08"
                         RadiusX="0.30"
                         RadiusY="0.30">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="CrystalEnvironmentCyanTopRightBrush"
                         Center="0.90,0.12"
                         GradientOrigin="0.90,0.12"
                         RadiusX="0.27"
                         RadiusY="0.27">
        <GradientStop Color="#8C89E0F9" Offset="0" />
        <GradientStop Color="#0089E0F9" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="CrystalEnvironmentCyanBottomRightBrush"
                         Center="0.70,0.88"
                         GradientOrigin="0.70,0.88"
                         RadiusX="0.33"
                         RadiusY="0.33">
        <GradientStop Color="#4D6BCCEF" Offset="0" />
        <GradientStop Color="#006BCCEF" Offset="1" />
    </RadialGradientBrush>


    <!-- ─── GLASS SURFACE ─── -->

    <LinearGradientBrush x:Key="CrystalGlassSurfaceBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="{StaticResource CrystalGlassMidColor}"
                      Offset="0" />
        <GradientStop Color="{StaticResource CrystalGlassVeryLowColor}"
                      Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CrystalGlassSurfaceStrongBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="{StaticResource CrystalGlassHighColor}"
                      Offset="0" />
        <GradientStop Color="{StaticResource CrystalGlassMidColor}"
                      Offset="1" />
    </LinearGradientBrush>


    <!-- ─── GLASS BORDER ─── -->

    <SolidColorBrush x:Key="CrystalGlassBorderBrush"
                     Color="{StaticResource CrystalBorderColor}" />

    <SolidColorBrush x:Key="CrystalGlassBorderLightBrush"
                     Color="{StaticResource CrystalBorderLightColor}" />

    <SolidColorBrush x:Key="CrystalGlassBorderSubtleBrush"
                     Color="{StaticResource CrystalBorderSubtleColor}" />


    <!-- ─── SPECULAR REFLECTION ─── -->

    <LinearGradientBrush x:Key="CrystalReflectionBrush"
                         StartPoint="0,0"
                         EndPoint="0.85,0.75">
        <GradientStop Color="#A6FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.24" />
        <GradientStop Color="#00FFFFFF" Offset="0.70" />
        <GradientStop Color="#3DFFFFFF" Offset="1" />
    </LinearGradientBrush>


    <!-- ─── WATER ─── -->

    <LinearGradientBrush x:Key="CrystalWaterBodyBrush"
                         StartPoint="0.5,0"
                         EndPoint="0.5,1">
        <GradientStop Color="{StaticResource CrystalWaterSurfaceColor}"
                      Offset="0" />
        <GradientStop Color="{StaticResource CrystalWaterBodyColor}"
                      Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="CrystalWaterHighlightBrush"
                         Center="0.16,0.16"
                         GradientOrigin="0.16,0.16"
                         RadiusX="0.42"
                         RadiusY="0.42">
        <GradientStop Color="#BFFFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="CrystalWaterDepthBrush"
                         Center="0.78,0.80"
                         GradientOrigin="0.78,0.80"
                         RadiusX="0.35"
                         RadiusY="0.35">
        <GradientStop Color="{StaticResource CrystalWaterCyanTintColor}"
                      Offset="0" />
        <GradientStop Color="#00245BD0" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="CrystalWaterSurfaceLineBrush"
                         StartPoint="0,0"
                         EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#B8FFFFFF" Offset="0.3" />
        <GradientStop Color="#B8FFFFFF" Offset="0.7" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>


    <!-- ─── CAUSTIC ─── -->

    <LinearGradientBrush x:Key="CrystalCausticBrush"
                         StartPoint="0,0"
                         EndPoint="1,0.3"
                         SpreadMethod="Reflect">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#17FFFFFF" Offset="0.38" />
        <GradientStop Color="#00FFFFFF" Offset="0.52" />
        <GradientStop Color="#10FFFFFF" Offset="0.75" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>


    <!-- ─── BUBBLES ─── -->

    <SolidColorBrush x:Key="CrystalBubbleFillBrush"
                     Color="{StaticResource CrystalBubbleFillColor}" />

    <SolidColorBrush x:Key="CrystalBubbleBorderBrush"
                     Color="{StaticResource CrystalBubbleBorderColor}" />


    <!-- ─── SHADOW ─── -->

    <SolidColorBrush x:Key="CrystalShadowBrush"
                     Color="{StaticResource CrystalShadowColor}" />


    <!-- ─── BUTTONS ─── -->

    <SolidColorBrush x:Key="CrystalButtonBackgroundBrush"
                     Color="{StaticResource CrystalGlassMidColor}" />

    <SolidColorBrush x:Key="CrystalButtonHoverBrush"
                     Color="{StaticResource CrystalHoverColor}" />

    <SolidColorBrush x:Key="CrystalButtonPressedBrush"
                     Color="{StaticResource CrystalPressedColor}" />

    <SolidColorBrush x:Key="CrystalPrimaryButtonBrush"
                     Color="{StaticResource CrystalPrimaryButtonColor}" />

    <SolidColorBrush x:Key="CrystalPrimaryButtonHoverBrush"
                     Color="{StaticResource CrystalPrimaryButtonHoverColor}" />


    <!-- ─── NAVIGATION ─── -->

    <SolidColorBrush x:Key="CrystalNavTextBrush"
                     Color="{StaticResource CrystalNavTextColor}" />

    <SolidColorBrush x:Key="CrystalNavActiveTextBrush"
                     Color="{StaticResource CrystalNavActiveTextColor}" />

    <SolidColorBrush x:Key="CrystalNavActiveBgBrush"
                     Color="{StaticResource CrystalNavActiveBgColor}" />

    <SolidColorBrush x:Key="CrystalNavHoverBgBrush"
                     Color="{StaticResource CrystalNavHoverBgColor}" />


    <!-- ─── STATUS ─── -->

    <SolidColorBrush x:Key="CrystalPositiveBrush"
                     Color="{StaticResource CrystalPositiveColor}" />

    <SolidColorBrush x:Key="CrystalWarningBrush"
                     Color="{StaticResource CrystalWarningColor}" />

    <SolidColorBrush x:Key="CrystalDangerBrush"
                     Color="{StaticResource CrystalDangerColor}" />


    <!-- ─── PROGRESS BAR ─── -->

    <LinearGradientBrush x:Key="CrystalProgressFillBrush"
                         StartPoint="0,0.5"
                         EndPoint="1,0.5">
        <GradientStop Color="#735BCDEF" Offset="0" />
        <GradientStop Color="#C734A5D2" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="CrystalProgressTrackBrush"
                     Color="#59FFFFFF" />


    <!-- ─── ICON CONTAINER ─── -->

    <LinearGradientBrush x:Key="CrystalIconContainerBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="#B8FFFFFF" Offset="0" />
        <GradientStop Color="#4D8BE0F6" Offset="1" />
    </LinearGradientBrush>


    <!-- ─── DATA GRID ─── -->

    <SolidColorBrush x:Key="CrystalGridHeaderBorderBrush"
                     Color="#94FFFFFF" />

    <SolidColorBrush x:Key="CrystalGridRowBorderBrush"
                     Color="#4DFFFFFF" />

    <SolidColorBrush x:Key="CrystalGridRowHoverBrush"
                     Color="#29FFFFFF" />

    <SolidColorBrush x:Key="CrystalGridRowSelectedBrush"
                     Color="#47FFFFFF" />


    <!-- ─── TOOLTIP ─── -->

    <SolidColorBrush x:Key="CrystalTooltipBackgroundBrush"
                     Color="#E8F0F8FF" />

    <SolidColorBrush x:Key="CrystalTooltipBorderBrush"
                     Color="{StaticResource CrystalBorderColor}" />


    <!-- ─── INPUT FOCUS ─── -->

    <SolidColorBrush x:Key="CrystalInputFocusBorderBrush"
                     Color="#9955C9EE" />

    <!-- ─── SCROLLBAR ─── -->

    <SolidColorBrush x:Key="CrystalScrollThumbBrush"
                     Color="#40A0D0E8" />

    <SolidColorBrush x:Key="CrystalScrollThumbHoverBrush"
                     Color="#6090C8E0" />

    <SolidColorBrush x:Key="CrystalScrollTrackBrush"
                     Color="#10FFFFFF" />

    <!-- ═════════════════════════════════════════════════════════════════
         INTEGRATION ADDITIONS (Ios-17pm P2) — brush nouns the shipped
         templates need, sourced from authored colors where one exists.
         ═════════════════════════════════════════════════════════════════ -->
    <!-- Authored color CrystalHighlightColor surfaces as a brush for
         BorderBrush usage (inner top hairlines; replaces the authored
         #D9FFFFFF literal) -->
    <SolidColorBrush x:Key="CrystalHighlightBrush"
                     Color="{StaticResource CrystalHighlightColor}" />
    <!-- 94%-opaque popup chrome (combo dropdowns; §38 near-opaque rule) -->
    <SolidColorBrush x:Key="CrystalPopupBackgroundBrush"
                     Color="#F0F5FAFF" />

    <!-- ═════════════════════════════════════════════════════════════════
         INTEGRATION ADDITIONS (Ios-17pm P4a — TOKENIZED SHELL SCENE)

         The authored §22 environment lives HERE, exactly once: the
         engine's crystal stage (VisualThemeEngine Part3) and the
         wallpaper scene (BuiltinWallpaperScenes.CrystalFluidScene)
         READ these tokens with byte-exact literal fallbacks, so a
         recalibration of the environment is one XAML edit — never a
         code redeploy. Values are the authored palettes, pinned by
         Tests/Agent/CrystalFluidShellAdoptionTests.
         ═════════════════════════════════════════════════════════════════ -->
    <!-- ENGINE STAGE — the calm backdrop beneath everything
         (blue-white highlight upper-left → soft blue lower-right;
         2026-09-06 richness pass — deeper blue than the pale
         #F8FDFF/#EDFAFF/#DFF5FF, for the "glass ERP" read) -->
    <SolidColorBrush x:Key="CrystalStageTopBrush"
                     Color="#EEF6FF" />
    <SolidColorBrush x:Key="CrystalStageLightBrush"
                     Color="#DBEDFF" />
    <SolidColorBrush x:Key="CrystalStageBaseBrush"
                     Color="#C6E4FF" />

    <!-- WALLPAPER SCENE — the 5-stop light choreography painted on top
         when the crystal scene is active (white light → soft cyan
         atmosphere → pale blue base/floor) -->
    <SolidColorBrush x:Key="CrystalSceneTopBrush"
                     Color="#FDFEFF" />
    <SolidColorBrush x:Key="CrystalSceneLitBrush"
                     Color="#F2FAFE" />
    <SolidColorBrush x:Key="CrystalSceneAtmosphereBrush"
                     Color="#E6F6FD" />
    <SolidColorBrush x:Key="CrystalSceneBaseBrush"
                     Color="#D5F0FB" />
    <SolidColorBrush x:Key="CrystalSceneFloorBrush"
                     Color="#DFF5FF" />

</ResourceDictionary>
