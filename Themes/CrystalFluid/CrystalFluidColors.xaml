<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- =====================================================
         CRYSTAL FLUID DESIGN SYSTEM — COLOR TOKENS
         ===================================================== -->

    <!-- PRIMARY INK -->
    <Color x:Key="CrystalInkColor">#FF102938</Color>
    <Color x:Key="CrystalInkLightColor">#FF1A3A4D</Color>

    <!-- MUTED TEXT -->
    <Color x:Key="CrystalMutedColor">#FF68808F</Color>
    <Color x:Key="CrystalMutedLightColor">#FF849AA7</Color>

    <!-- ACCENT -->
    <Color x:Key="CrystalAccentColor">#FF55C9EE</Color>
    <Color x:Key="CrystalAccentDarkColor">#FF34A5D2</Color>
    <Color x:Key="CrystalAccentDeepColor">#FF167DA4</Color>
    <Color x:Key="CrystalAccentLightColor">#FF89E0F9</Color>
    <Color x:Key="CrystalAccentPaleColor">#FFB8ECF8</Color>

    <!-- ENVIRONMENT BACKGROUNDS -->
    <Color x:Key="CrystalEnvLightColor">#FFF8FDFF</Color>
    <Color x:Key="CrystalEnvMidColor">#FFDFF5FF</Color>
    <Color x:Key="CrystalEnvBaseColor">#FFEDFAFF</Color>
    <Color x:Key="CrystalEnvWarmColor">#FFFFFFFF</Color>

    <!-- GLASS SURFACE -->
    <Color x:Key="CrystalGlassHighColor">#6EFFFFFF</Color>
    <Color x:Key="CrystalGlassMidColor">#3DFFFFFF</Color>
    <Color x:Key="CrystalGlassLowColor">#24FFFFFF</Color>
    <Color x:Key="CrystalGlassVeryLowColor">#14FFFFFF</Color>

    <!-- GLASS BORDER -->
    <Color x:Key="CrystalBorderColor">#B8FFFFFF</Color>
    <Color x:Key="CrystalBorderLightColor">#A0FFFFFF</Color>
    <Color x:Key="CrystalBorderSubtleColor">#66FFFFFF</Color>

    <!-- GLASS HIGHLIGHT -->
    <Color x:Key="CrystalHighlightColor">#D9FFFFFF</Color>
    <Color x:Key="CrystalHighlightMidColor">#7AFFFFFF</Color>
    <Color x:Key="CrystalHighlightLowColor">#29FFFFFF</Color>

    <!-- WATER -->
    <Color x:Key="CrystalWaterSurfaceColor">#268AEAF8</Color>
    <Color x:Key="CrystalWaterBodyColor">#2E4FC5EB</Color>
    <Color x:Key="CrystalWaterDeepColor">#333FB8E0</Color>
    <Color x:Key="CrystalWaterHighlightColor">#B8FFFFFF</Color>
    <Color x:Key="CrystalWaterCausticColor">#17FFFFFF</Color>
    <Color x:Key="CrystalWaterCyanTintColor">#2A63C8EE</Color>

    <!-- BUBBLE -->
    <Color x:Key="CrystalBubbleFillColor">#47FFFFFF</Color>
    <Color x:Key="CrystalBubbleBorderColor">#CCFFFFFF</Color>
    <Color x:Key="CrystalBubbleGlowColor">#80FFFFFF</Color>

    <!-- SHADOW -->
    <Color x:Key="CrystalShadowColor">#2131809E</Color>
    <Color x:Key="CrystalShadowLightColor">#1137969B</Color>

    <!-- STATUS: POSITIVE -->
    <Color x:Key="CrystalPositiveColor">#FF49C991</Color>
    <Color x:Key="CrystalPositiveGlowColor">#8049C991</Color>

    <!-- STATUS: WARNING -->
    <Color x:Key="CrystalWarningColor">#FFFFC857</Color>

    <!-- STATUS: DANGER -->
    <Color x:Key="CrystalDangerColor">#FFEF6B6B</Color>

    <!-- PRIMARY BUTTON -->
    <Color x:Key="CrystalPrimaryButtonColor">#B84BC0E7</Color>
    <Color x:Key="CrystalPrimaryButtonHoverColor">#CC5DD0F1</Color>

    <!-- HOVER/SELECTION -->
    <Color x:Key="CrystalHoverColor">#52FFFFFF</Color>
    <Color x:Key="CrystalSelectedColor">#7AFFFFFF</Color>
    <Color x:Key="CrystalPressedColor">#38FFFFFF</Color>

    <!-- NAVIGATION -->
    <Color x:Key="CrystalNavTextColor">#FF607B8B</Color>
    <Color x:Key="CrystalNavActiveTextColor">#FF167DA4</Color>
    <Color x:Key="CrystalNavActiveBgColor">#7AFFFFFF</Color>
    <Color x:Key="CrystalNavHoverBgColor">#52FFFFFF</Color>

    <!-- TRANSPARENT -->
    <Color x:Key="TransparentColor">#00FFFFFF</Color>

</ResourceDictionary>
