<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:crystal="clr-namespace:ProGlassAutomation.Controls.CrystalFluid"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- ═══════════════════════════════════════════════════════════════════
         IOS-17PM — CUSTOM CONTROL TEMPLATES (P2 2026-09-05)
         Integrated port of the authored CrystalFluidControls.xaml
         (incoming file 10) with the fix register applied:
           D7  WavePath Canvas.Top hardcode removed — the control code
               positions the wave AT THE WATERLINE (and animates it with
               water-level changes).
           D8  Card Header/Content no longer overlap: header docks top
               in a DockPanel (authored put both presenters in one Grid
               cell).
           D12 KPI TrendText/TrendPositive consumed (tinted trend text —
               positive/danger brush, collapsed when empty).
           D15 WaveAmplitude is live in control code (±amplitude).
           +   Water canvas binds WaterOpacity (D4); water/card styles
               default WaterOpacity/WaterSpeed/ReducedMotion/BubbleOpacity/
               WaveAmplitude and corner radii FROM TOKENS via
               DynamicResource (engine/studio live; local values always win).
           +   Wave fill uses CrystalWaterSurfaceLineBrush (authored
               surface noun — flat #B8FFFFFF bypass tokenized, ends now
               soften into the glass).
           +   Inner highlights use the integration noun
               CrystalHighlightBrush (authored CrystalHighlightColor).
           +   KPI height setter is MinHeight (authored fixed Height=155
               fought auto-layout of long values).
           +   CrystalProgressBar template has an IsIndeterminate breathing
               state (the app uses indeterminate bars).
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- =====================================================
         CRYSTAL WATER CONTROL
         ===================================================== -->

    <Style TargetType="{x:Type crystal:CrystalWaterControl}">
        <Setter Property="IsHitTestVisible"
                Value="False" />
        <!-- Token-fed defaults (engine/studio live; local values win) -->
        <Setter Property="WaterOpacity"
                Value="{DynamicResource CrystalWaterOpacity}" />
        <Setter Property="WaterSpeed"
                Value="{DynamicResource CrystalWaterSpeed}" />
        <Setter Property="BubbleOpacity"
                Value="{DynamicResource CrystalBubbleOpacity}" />
        <Setter Property="ReducedMotion"
                Value="{DynamicResource CrystalReducedMotion}" />
        <Setter Property="WaveAmplitude"
                Value="{DynamicResource CrystalWaveAmplitude}" />
        <Setter Property="CornerRadius"
                Value="{DynamicResource CrystalRadiusLarge}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate
                    TargetType="{x:Type crystal:CrystalWaterControl}">

                    <Canvas x:Name="PART_WaterCanvas"
                            ClipToBounds="True"
                            Opacity="{TemplateBinding WaterOpacity}">

                        <!-- WATER BODY -->
                        <Border x:Name="PART_WaterBody"
                                Canvas.Bottom="0"
                                Canvas.Left="0"
                                Width="{Binding ActualWidth,
                                    RelativeSource={RelativeSource
                                        TemplatedParent}}"
                                Background="{StaticResource
                                    CrystalWaterBodyBrush}"
                                BorderThickness="0,1,0,0"
                                BorderBrush="{StaticResource
                                    CrystalWaterSurfaceLineBrush}"
                                CornerRadius="0"
                                IsHitTestVisible="False">

                            <Grid>
                                <!-- Water highlight layer -->
                                <Rectangle
                                    Fill="{StaticResource
                                        CrystalWaterHighlightBrush}"
                                    Opacity="0.6"
                                    IsHitTestVisible="False" />

                                <!-- Water depth tint -->
                                <Rectangle
                                    Fill="{StaticResource
                                        CrystalWaterDepthBrush}"
                                    Opacity="0.5"
                                    IsHitTestVisible="False" />

                                <!-- CAUSTIC LAYER (P3: DynamicResource —
                                     the studio/engine write this key live;
                                     StaticResource would freeze at inflate) -->
                                <Rectangle x:Name="PART_CausticLayer"
                                           Fill="{StaticResource
                                               CrystalCausticBrush}"
                                           Opacity="{DynamicResource
                                               CrystalCausticOpacity}"
                                           IsHitTestVisible="False" />
                            </Grid>

                        </Border>

                        <!-- WAVE SURFACE (D7: no Canvas.Top hardcode —
                             the control anchors it to the waterline) -->
                        <Path x:Name="PART_WavePath"
                              IsHitTestVisible="False"
                              Fill="{StaticResource
                                  CrystalWaterSurfaceLineBrush}"
                              Opacity="0.55"
                              Data="M0,15 C80,5 160,25 240,15
                                    C320,5 400,25 480,15
                                    L480,0 L0,0 Z"
                              Stretch="Fill"
                              Width="{Binding ActualWidth,
                                  RelativeSource={RelativeSource
                                      TemplatedParent}}"
                              Height="20" />

                    </Canvas>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- =====================================================
         CRYSTAL CARD
         ===================================================== -->

    <Style TargetType="{x:Type crystal:CrystalCard}">
        <Setter Property="Padding"
                Value="{StaticResource CrystalCardPadding}" />
        <Setter Property="Foreground"
                Value="{StaticResource CrystalInkBrush}" />
        <Setter Property="ReducedMotion"
                Value="{DynamicResource CrystalReducedMotion}" />
        <Setter Property="CornerRadius"
                Value="{DynamicResource CrystalRadiusLarge}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate
                    TargetType="{x:Type crystal:CrystalCard}">

                    <Grid>
                        <!-- SHADOW -->
                        <Border Margin="8,4,8,12"
                                CornerRadius="{TemplateBinding
                                    CornerRadius}"
                                Background="Transparent">
                            <Border.Effect>
                                <DropShadowEffect
                                    Color="{StaticResource
                                        CrystalShadowColor}"
                                    BlurRadius="{StaticResource
                                        CrystalShadowBlurRadius}"
                                    ShadowDepth="{StaticResource
                                        CrystalShadowDepth}"
                                    Direction="270"
                                    Opacity="0.35" />
                            </Border.Effect>
                        </Border>

                        <!-- MAIN GLASS -->
                        <Border x:Name="PART_GlassBorder"
                                CornerRadius="{TemplateBinding
                                    CornerRadius}"
                                Background="{StaticResource
                                    CrystalGlassSurfaceBrush}"
                                BorderBrush="{StaticResource
                                    CrystalGlassBorderBrush}"
                                BorderThickness="{StaticResource
                                    CrystalBorderThickness}"
                                ClipToBounds="True">

                            <Grid>
                                <!-- WATER (behind content) -->
                                <crystal:CrystalWaterControl
                                    x:Name="PART_Water"
                                    WaterLevel="{TemplateBinding
                                        WaterLevel}"
                                    WaterEnabled="{TemplateBinding
                                        WaterEnabled}"
                                    BubbleEnabled="{TemplateBinding
                                        BubbleEnabled}"
                                    BubbleCount="{TemplateBinding
                                        BubbleCount}"
                                    CausticsEnabled="{TemplateBinding
                                        CausticsEnabled}"
                                    ReducedMotion="{TemplateBinding
                                        ReducedMotion}"
                                    CornerRadius="{TemplateBinding
                                        CornerRadius}"
                                    VerticalAlignment="Stretch"
                                    HorizontalAlignment="Stretch"
                                    Panel.ZIndex="1" />

                                <!-- CONTENT (D8: header docks top — the
                                     authored one-cell Grid overlapped
                                     both presenters) -->
                                <DockPanel Panel.ZIndex="5">
                                    <ContentPresenter
                                        DockPanel.Dock="Top"
                                        Content="{TemplateBinding Header}"
                                        ContentTemplate="{TemplateBinding
                                            HeaderTemplate}" />

                                    <ContentPresenter
                                        Margin="{TemplateBinding Padding}"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding
                                            ContentTemplate}" />
                                </DockPanel>

                                <!-- SPECULAR REFLECTION (P3: dynamic —
                                     studio HighlightStrength writes live) -->
                                <Border CornerRadius="{TemplateBinding
                                            CornerRadius}"
                                        Background="{StaticResource
                                            CrystalReflectionBrush}"
                                        Opacity="{DynamicResource
                                            CrystalReflectionOpacity}"
                                        IsHitTestVisible="False"
                                        Panel.ZIndex="10" />

                                <!-- INNER TOP HIGHLIGHT (tokenized) -->
                                <Border CornerRadius="{TemplateBinding
                                            CornerRadius}"
                                        BorderThickness="0,1,0,0"
                                        BorderBrush="{StaticResource
                                            CrystalHighlightBrush}"
                                        Background="Transparent"
                                        IsHitTestVisible="False"
                                        Panel.ZIndex="11" />
                            </Grid>

                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="PART_GlassBorder"
                                    Property="Background"
                                    Value="{StaticResource
                                        CrystalGlassSurfaceStrongBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- =====================================================
         CRYSTAL KPI CARD
         ===================================================== -->

    <Style TargetType="{x:Type crystal:CrystalKpiCard}"
           BasedOn="{StaticResource
               {x:Type crystal:CrystalCard}}">
        <!-- MinHeight, not fixed Height: long values may grow the card
             (authored fixed Height clipped/auto-layout fought). -->
        <Setter Property="MinHeight"
                Value="{StaticResource CrystalKpiHeight}" />
        <Setter Property="WaterEnabled"
                Value="True" />
        <Setter Property="TiltEnabled"
                Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate
                    TargetType="{x:Type crystal:CrystalKpiCard}">

                    <Grid>
                        <!-- SHADOW -->
                        <Border Margin="6,2,6,10"
                                CornerRadius="{TemplateBinding
                                    CornerRadius}"
                                Background="Transparent">
                            <Border.Effect>
                                <DropShadowEffect
                                    Color="{StaticResource
                                        CrystalShadowColor}"
                                    BlurRadius="40"
                                    ShadowDepth="14"
                                    Direction="270"
                                    Opacity="0.30" />
                            </Border.Effect>
                        </Border>

                        <!-- GLASS -->
                        <Border x:Name="GlassBorder"
                                CornerRadius="{TemplateBinding
                                    CornerRadius}"
                                Background="{StaticResource
                                    CrystalGlassSurfaceBrush}"
                                BorderBrush="{StaticResource
                                    CrystalGlassBorderBrush}"
                                BorderThickness="{StaticResource
                                    CrystalBorderThickness}"
                                ClipToBounds="True">

                            <Grid>
                                <!-- WATER -->
                                <crystal:CrystalWaterControl
                                    WaterLevel="{TemplateBinding
                                        WaterLevel}"
                                    WaterEnabled="{TemplateBinding
                                        WaterEnabled}"
                                    BubbleEnabled="{TemplateBinding
                                        BubbleEnabled}"
                                    BubbleCount="{TemplateBinding
                                        BubbleCount}"
                                    CausticsEnabled="{TemplateBinding
                                        CausticsEnabled}"
                                    ReducedMotion="{TemplateBinding
                                        ReducedMotion}"
                                    CornerRadius="{TemplateBinding
                                        CornerRadius}"
                                    Panel.ZIndex="1" />

                                <!-- CONTENT -->
                                <Grid Margin="{StaticResource
                                         CrystalKpiPadding}"
                                      Panel.ZIndex="5">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- TOP: LABEL + ICON -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Text="{TemplateBinding Title}"
                                            Foreground="{StaticResource
                                                CrystalMutedBrush}"
                                            FontSize="{StaticResource
                                                CrystalFontSizeSmall}" />

                                        <Border Grid.Column="1"
                                                Width="{StaticResource
                                                    CrystalIconSize}"
                                                Height="{StaticResource
                                                    CrystalIconSize}"
                                                CornerRadius="{StaticResource
                                                    CrystalRadiusXSmall}"
                                                Background="{StaticResource
                                                    CrystalButtonBackgroundBrush}"
                                                BorderBrush="{StaticResource
                                                    CrystalGlassBorderSubtleBrush}"
                                                BorderThickness="1">
                                            <ContentPresenter
                                                Content="{TemplateBinding Icon}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- VALUE -->
                                    <TextBlock Grid.Row="1"
                                               Text="{TemplateBinding Value}"
                                               Foreground="{StaticResource
                                                   CrystalInkBrush}"
                                               FontSize="{StaticResource
                                                   CrystalFontSizeValue}"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Margin="0,8,0,0" />

                                    <!-- SUBTITLE / TREND (D12: trend is
                                         live API — tinted chip, hidden
                                         when empty) -->
                                    <StackPanel Grid.Row="2"
                                                Orientation="Horizontal"
                                                Margin="0,0,0,2">

                                        <ContentPresenter
                                            Content="{TemplateBinding
                                                Content}" />

                                        <TextBlock
                                            Text="{TemplateBinding Subtitle}"
                                            Foreground="{StaticResource
                                                CrystalMutedBrush}"
                                            FontSize="{StaticResource
                                                CrystalFontSizeCaption}"
                                            VerticalAlignment="Center"
                                            Margin="5,0,0,0" />

                                        <TextBlock
                                            Text="{TemplateBinding TrendText}"
                                            FontSize="{StaticResource
                                                CrystalFontSizeCaption}"
                                            FontWeight="DemiBold"
                                            VerticalAlignment="Center"
                                            Margin="5,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource
                                                                CrystalPositiveBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding TrendText,
                                                                RelativeSource={RelativeSource
                                                                    TemplatedParent}}"
                                                            Value="">
                                                            <Setter Property="Visibility"
                                                                    Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger
                                                            Binding="{Binding TrendText,
                                                                RelativeSource={RelativeSource
                                                                    TemplatedParent}}"
                                                            Value="{x:Null}">
                                                            <Setter Property="Visibility"
                                                                    Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger
                                                            Binding="{Binding TrendPositive,
                                                                RelativeSource={RelativeSource
                                                                    TemplatedParent}}"
                                                            Value="False">
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource
                                                                        CrystalDangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                    </StackPanel>

                                </Grid>

                                <!-- REFLECTION (P3: dynamic — studio
                                     HighlightStrength writes live) -->
                                <Border CornerRadius="{TemplateBinding
                                            CornerRadius}"
                                        Background="{StaticResource
                                            CrystalReflectionBrush}"
                                        Opacity="{DynamicResource
                                            CrystalReflectionOpacity}"
                                        IsHitTestVisible="False"
                                        Panel.ZIndex="10" />

                                <!-- INNER HIGHLIGHT (tokenized) -->
                                <Border CornerRadius="{TemplateBinding
                                            CornerRadius}"
                                        BorderThickness="0,1,0,0"
                                        BorderBrush="{StaticResource
                                            CrystalHighlightBrush}"
                                        Background="Transparent"
                                        IsHitTestVisible="False"
                                        Panel.ZIndex="11" />

                            </Grid>
                        </Border>
                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- =====================================================
         CRYSTAL STATUS PILL
         ===================================================== -->

    <Style TargetType="{x:Type crystal:CrystalStatusPill}">
        <!-- D11: authored palette default (was Brushes.LimeGreen in
             the DP); DynamicResource keeps it theme-live, local wins. -->
        <Setter Property="StatusColor"
                Value="{DynamicResource CrystalPositiveBrush}" />
        <Setter Property="Padding"
                Value="{StaticResource CrystalPillPadding}" />
        <Setter Property="Foreground"
                Value="{StaticResource CrystalInkBrush}" />
        <Setter Property="FontSize"
                Value="{StaticResource CrystalFontSizeCaption}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate
                    TargetType="{x:Type crystal:CrystalStatusPill}">

                    <Border CornerRadius="{StaticResource
                                CrystalRadiusPill}"
                            Background="{StaticResource
                                CrystalButtonBackgroundBrush}"
                            BorderBrush="{StaticResource
                                CrystalGlassBorderSubtleBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">

                        <StackPanel Orientation="Horizontal">

                            <Ellipse
                                x:Name="StatusDot"
                                Width="{StaticResource
                                    CrystalStatusDotSize}"
                                Height="{StaticResource
                                    CrystalStatusDotSize}"
                                Fill="{TemplateBinding StatusColor}"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <!-- D11: glow follows StatusColor
                                         (authored hardcoded positive
                                         even for warning/danger pills) -->
                                    <DropShadowEffect
                                        Color="{Binding
                                            StatusColor.(SolidColorBrush.Color),
                                            RelativeSource={RelativeSource
                                                TemplatedParent},
                                            FallbackValue=#FF49C991}"
                                        BlurRadius="8"
                                        ShadowDepth="0"
                                        Opacity="0.5" />
                                </Ellipse.Effect>
                            </Ellipse>

                            <ContentPresenter
                                VerticalAlignment="Center" />

                        </StackPanel>

                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowDot"
                                 Value="False">
                            <Setter TargetName="StatusDot"
                                    Property="Visibility"
                                    Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- =====================================================
         CRYSTAL PROGRESS BAR
         ===================================================== -->

    <Style TargetType="{x:Type crystal:CrystalProgressBar}">
        <Setter Property="Height"
                Value="{StaticResource CrystalProgressHeight}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate
                    TargetType="{x:Type crystal:CrystalProgressBar}">

                    <Border CornerRadius="{TemplateBinding
                                CornerRadius}"
                            Background="{StaticResource
                                CrystalProgressTrackBrush}"
                            BorderBrush="{StaticResource
                                CrystalGlassBorderSubtleBrush}"
                            BorderThickness="1">

                        <Grid>
                            <Border x:Name="PART_Track"
                                    CornerRadius="{TemplateBinding
                                        CornerRadius}"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource
                                        CrystalProgressFillBrush}">
                                <Border.Width>
                                    <MultiBinding
                                        Converter="{x:Static
                                            crystal:ProgressWidthConverter
                                                .Instance}">
                                        <Binding Path="Value"
                                                 RelativeSource="{RelativeSource
                                                     TemplatedParent}" />
                                        <Binding Path="Minimum"
                                                 RelativeSource="{RelativeSource
                                                     TemplatedParent}" />
                                        <Binding Path="Maximum"
                                                 RelativeSource="{RelativeSource
                                                     TemplatedParent}" />
                                        <Binding Path="ActualWidth"
                                                 RelativeSource="{RelativeSource
                                                     TemplatedParent}" />
                                    </MultiBinding>
                                </Border.Width>
                            </Border>

                            <!-- Indeterminate: breathing band (determinate
                                 fill collapses) — opacity-only motion on
                                 the composition thread. -->
                            <Border x:Name="PART_Indeterminate"
                                    Visibility="Collapsed"
                                    CornerRadius="{TemplateBinding
                                        CornerRadius}"
                                    Background="{StaticResource
                                        CrystalProgressFillBrush}"
                                    Opacity="0.5" />
                        </Grid>

                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate"
                                 Value="True">
                            <Setter TargetName="PART_Track"
                                    Property="Visibility"
                                    Value="Collapsed" />
                            <Setter TargetName="PART_Indeterminate"
                                    Property="Visibility"
                                    Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="IndeterminatePulse">
                                    <Storyboard RepeatBehavior="Forever"
                                                AutoReverse="True">
                                        <DoubleAnimation
                                            Storyboard.TargetName="PART_Indeterminate"
                                            Storyboard.TargetProperty="Opacity"
                                            From="0.25" To="0.75"
                                            Duration="0:0:1.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard
                                    BeginStoryboardName="IndeterminatePulse" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
