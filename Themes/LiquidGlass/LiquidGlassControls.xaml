<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Themes/LiquidGlass/LiquidGlassControls.xaml
     PROJECT: ProGlassAutomation
     MODULE: Liquid Glass — control templates

     THE TEMPLATES ARE THE ARGUMENT, AGAIN — BUT DIFFERENTLY.

     For the opaque families the template's job is to NOT build a box.
     Swiss declares a rule and a ground; nothing can be attached that
     should not be there.

     Liquid Glass has to do the opposite. The material IS a box, and
     every template here declares the five parts that let it read as
     glass:

         PART_LiquidFill     the tint the lens is carrying
         PART_LiquidRim      the specular edge. Not optional, not flat.
         PART_LiquidSheen    the inner glow.      Optional part.
         PART_LiquidShadow   the shadow host.     Optional part.
         PART_LiquidFocus    the focus ring

     The Rim is a separate element rather than a BorderBrush on the
     fill for one concrete reason: the recipe assigns it a GRADIENT.
     A uniform border on a translucent fill is the single thing that
     makes glass look like tinted film, and a flat BorderBrush cannot
     express the ramp that sells it.

     PART_LiquidShadow is a host because WPF allows ONE Effect per
     element, so a surface with both a shadow and a rim needs two
     Borders. The field deliberately omits it: a Well is concave and an
     outer shadow on a recess reads as a floating dent.
     ═══════════════════════════════════════════════════════════════════ -->

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:liquid="clr-namespace:ProGlassAutomation.Controls.LiquidGlass"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ═══════════════════════════════════════════════════════════
         PALETTE BRIDGE

         DynamicResource consumers, not literal colours, so these
         follow EightThemePainter when the family changes. LiquidGlassPalette
         overwrites these same keys at runtime, which is what keeps the
         XAML path and the code-behind path agreeing.

         The defaults below are the LIGHT ramp. They are never what the
         user sees once the family is active — they exist so the app
         has something to render during the window between dictionary
         load and the first Paint.
         ═══════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="LiquidFillBrush" Color="#F2F4F8" />
    <SolidColorBrush x:Key="LiquidRimBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LiquidInkBrush" Color="#12141A" />
    <SolidColorBrush x:Key="LiquidMutedBrush" Color="#5A6070" />

    <!-- ═══════════════════════════════════════════════════════════
         GEOMETRY

         Radius 20 rather than the pill or the hard corner. A liquid
         lens reads as a lens because of a broad, continuous curve: a
         radius large enough that the specular ramp has room to travel
         across the edge, small enough that the surface still reads as
         a panel rather than a lozenge.
         ═══════════════════════════════════════════════════════════ -->
    <CornerRadius x:Key="LiquidRadius" TopLeft="20" TopRight="20"
                  BottomLeft="20" BottomRight="20" />
    <CornerRadius x:Key="LiquidRadiusTall" TopLeft="28" TopRight="28"
                  BottomLeft="28" BottomRight="28" />
    <Thickness x:Key="LiquidRimThickness">1</Thickness>
    <Thickness x:Key="LiquidFocusWidth">3</Thickness>
    <Thickness x:Key="LiquidUnit">8</Thickness>
    <Thickness x:Key="LiquidUnitTall">12,12,0,0</Thickness>

    <!-- ═══════════════════════════════════════════════════════════
         TYPE

         Segoe UI Variable first. Liquid Glass is the only family here
         that sits on top of moving content rather than on a flat
         ground, and a type face with a large x-height and open
         counters survives translucency better than a tight one.
         ═══════════════════════════════════════════════════════════ -->
    <FontFamily x:Key="LiquidTypeFamily">Segoe UI Variable Text, Segoe UI, Arial, sans-serif</FontFamily>

    <Style x:Key="LiquidLabelType" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LiquidTypeFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource LiquidMutedBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="LiquidBodyType" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LiquidTypeFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource LiquidInkBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         FOCUS

         The rim colour, NOT the ink. On a lens the ink is low-contrast
         by construction — the whole point is that content shows
         through — so an ink ring would be the one element guaranteed
         to be invisible on the surface that needs it most.
         ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="LiquidFocusRing" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource LiquidRimBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource LiquidFocusWidth}" />
        <Setter Property="Margin" Value="-4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         LIQUID SURFACE

         Shadow host OUTSIDE the fill so the shadow falls on the content
         rather than being clipped by the lens. Rim above the fill so
         the specular edge is never occluded, and the sheen above the
         rim so the glow does not wash out the edge it sits on.
         ═══════════════════════════════════════════════════════════ -->
    <ControlTemplate x:Key="LiquidSurfaceTemplate"
                     TargetType="{x:Type liquid:LiquidSurface}">
        <Grid Background="{TemplateBinding Background}"
              SnapsToDevicePixels="True">
            <Border x:Name="PART_LiquidShadow"
                    Background="Transparent"
                    CornerRadius="{StaticResource LiquidRadius}" />
            <Border x:Name="PART_LiquidFill"
                    Background="{DynamicResource LiquidFillBrush}"
                    CornerRadius="{StaticResource LiquidRadius}" />
            <Border x:Name="PART_LiquidSheen"
                    Background="Transparent"
                    CornerRadius="{StaticResource LiquidRadius}"
                    Visibility="Collapsed" />
            <Border x:Name="PART_LiquidRim"
                    BorderBrush="{DynamicResource LiquidRimBrush}"
                    BorderThickness="{StaticResource LiquidRimThickness}"
                    CornerRadius="{StaticResource LiquidRadius}" />
            <Grid Margin="{StaticResource LiquidUnit}">
                <ContentPresenter
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
            <Border x:Name="PART_LiquidFocus"
                    Style="{StaticResource LiquidFocusRing}"
                    Visibility="Collapsed" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type liquid:LiquidSurface}">
        <Setter Property="Template" Value="{StaticResource LiquidSurfaceTemplate}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         LIQUID BUTTON

         No PART_LiquidShadow. A button is Raised, and the shadow host
         is what carries a raised surface's shadow... so it is present
         here and the comment above is about the FIELD, which omits it.
         Kept explicit rather than shared so the two templates do not
         quietly converge into one style.
         ═══════════════════════════════════════════════════════════ -->
    <ControlTemplate x:Key="LiquidButtonTemplate"
                     TargetType="{x:Type liquid:LiquidButton}">
        <Grid Background="{TemplateBinding Background}"
              SnapsToDevicePixels="True">
            <Border x:Name="PART_LiquidShadow"
                    Background="Transparent"
                    CornerRadius="{StaticResource LiquidRadius}" />
            <Border x:Name="PART_LiquidFill"
                    Background="{DynamicResource LiquidFillBrush}"
                    CornerRadius="{StaticResource LiquidRadius}" />
            <Border x:Name="PART_LiquidSheen"
                    Background="Transparent"
                    CornerRadius="{StaticResource LiquidRadius}"
                    Visibility="Collapsed" />
            <Border x:Name="PART_LiquidRim"
                    BorderBrush="{DynamicResource LiquidRimBrush}"
                    BorderThickness="{StaticResource LiquidRimThickness}"
                    CornerRadius="{StaticResource LiquidRadius}" />
            <Grid Margin="{StaticResource LiquidUnit}">
                <ContentPresenter ContentSource="Content"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
            <Border x:Name="PART_LiquidFocus"
                    Style="{StaticResource LiquidFocusRing}"
                    Visibility="Collapsed" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type liquid:LiquidButton}">
        <Setter Property="Template" Value="{StaticResource LiquidButtonTemplate}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Foreground" Value="{DynamicResource LiquidInkBrush}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         LIQUID FIELD

         NO SHADOW HOST. This template is the family's content-layer
         counterpart to the chrome templates above, and a Well is
         concave: an outer shadow on a recess reads as a dent rather
         than as depth. LiquidField takes the Well tier for the same
         reason and reads the rule from LiquidGlassDepth rather than
         reimplementing it.

         The rim survives, because it is a focus cue and not a fill.
         ═══════════════════════════════════════════════════════════ -->
    <ControlTemplate x:Key="LiquidFieldTemplate"
                     TargetType="{x:Type liquid:LiquidField}">
        <Grid Background="{TemplateBinding Background}"
              SnapsToDevicePixels="True">
            <StackPanel>
                <TextBlock Text="{TemplateBinding LiquidLabel}"
                           Style="{StaticResource LiquidLabelType}"
                           Margin="{StaticResource LiquidUnitTall}" />
                <Grid>
                    <!-- PART_LiquidFill IS declared here even though the
                         well is meant to read as recessed. The parts
                         type requires it: a template that omits it
                         leaves Complete false and the control renders
                         nothing at all. The recess comes from the
                         Well tier giving this fill no outer shadow,
                         not from the part being absent. -->
                    <Border x:Name="PART_LiquidFill"
                            Background="{DynamicResource LiquidFillBrush}"
                            CornerRadius="{StaticResource LiquidRadius}">
                        <Grid>
                            <TextBox x:Name="PART_LiquidEditor"
                                     Margin="12,0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontFamily="{StaticResource LiquidTypeFamily}"
                                     FontSize="13"
                                     Foreground="{DynamicResource LiquidInkBrush}"
                                     CaretBrush="{DynamicResource LiquidInkBrush}"
                                     VerticalContentAlignment="Center" />
                        </Grid>
                    </Border>
                    <!-- The placeholder hides as soon as there is text,
                         and reappears when the field is emptied. A
                         placeholder that stays behind real text reads
                         as duplicated content. -->
                    <TextBlock Text="{TemplateBinding LiquidPlaceholder}"
                               Foreground="{DynamicResource LiquidMutedBrush}"
                               FontFamily="{StaticResource LiquidTypeFamily}"
                               FontSize="13"
                               Margin="13,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=PART_LiquidEditor}"
                                                 Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=PART_LiquidEditor}"
                                                 Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=PART_LiquidEditor}"
                                                 Value="{x:Static sys:String.Empty}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- The rim sits ON the fill as an overlay rather
                         than beside it, so the two always share a
                         corner radius exactly. Two stacked borders with
                         a negative margin drift by a pixel at some
                         DPI settings, and on a lens that pixel is the
                         whole edge. -->
                    <Border x:Name="PART_LiquidRim"
                            BorderBrush="{DynamicResource LiquidRimBrush}"
                            BorderThickness="{StaticResource LiquidRimThickness}"
                            CornerRadius="{StaticResource LiquidRadius}" />
                </Grid>
            </StackPanel>
            <Border x:Name="PART_LiquidFocus"
                    Style="{StaticResource LiquidFocusRing}"
                    Visibility="Collapsed" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type liquid:LiquidField}">
        <Setter Property="Template" Value="{StaticResource LiquidFieldTemplate}" />
        <Setter Property="Background" Value="Transparent" />
        <!-- Focusable=False for the same reason Swiss uses it: the shell
             is a wrapper around a real TextBox, and making the shell a
             focusable stop would put an empty entry in the tab order
             ahead of the control that actually takes the keystroke.
             LiquidField.IsKeyboardFocusWithin still reports focus,
             because that follows the subtree rather than the element. -->
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

</ResourceDictionary>