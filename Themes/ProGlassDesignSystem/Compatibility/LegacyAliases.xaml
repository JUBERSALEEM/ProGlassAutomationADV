<!--
  MIGRATION ONLY. Old Crystal/Liquid/module keys remain published by
  Light/Dark + VisualThemeEngine. This file maps NEW semantic names onto
  those live engine keys so new XAML can consume SurfacePrimaryBrush
  while existing views keep GlassUltraClearBrush until Phase J.

  Do not develop new screens against Glass*/Liquid*/Crystal* keys.

  CONCRETE FALLBACK VALUES ONLY (2026-09-14 crash fix): a
  <DynamicResource x:Key=...> entry stores a ResourceReferenceExpression
  marker as the resource value and crashes the first property assignment
  ("ResourceReferenceExpression is not a valid value for property ...").
  SemanticTokens.xaml defines the same keys later in the merge order
  (so it wins), and ProGlassThemeEngine.Publish() dual-writes live values
  onto Application resources; these entries are the pre-publish safety
  net.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="SurfaceWorkspaceBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceWindowBrush" Color="#FFF5F7FA"/>
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="#F8FFFFFF"/>
    <SolidColorBrush x:Key="SurfacePopupBrush" Color="#FFF8FAFC"/>
    <SolidColorBrush x:Key="SurfaceSidebarBrush" Color="#FFEEF1F5"/>

</ResourceDictionary>
