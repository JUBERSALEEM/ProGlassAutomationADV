<!--
  AUTHORITATIVE semantic color roles.
  Concrete Light defaults; ThemeManager.PublishProGlassDesignSystem
  overwrites these at runtime from the active Light/Dark + family engine.
  Application XAML should bind these keys, never Crystal*/LiquidGlass*.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush.Semantic" Color="#FFF3F0FA"/>

    <SolidColorBrush x:Key="SurfacePrimaryBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#FFEEE8F8"/>
    <SolidColorBrush x:Key="SurfaceTertiaryBrush" Color="#FFF8F6FC"/>
    <SolidColorBrush x:Key="SurfaceInputBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceOverlayBrush" Color="#142C2440"/>

    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF968CA5"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#666B6078"/>
    <SolidColorBrush x:Key="TextPlaceholderBrush" Color="#886B6078"/>

    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#FFE2DBEF"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#FF6546B5"/>

    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFEEE8F8"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#FFEAF4EF"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFFAF2E7"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FFFBECEF"/>
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#FFEEE8F8"/>

    <SolidColorBrush x:Key="SelectionBrush" Color="#336546B5"/>
    <SolidColorBrush x:Key="SelectionForegroundBrush" Color="#FF2C2440"/>

    <SolidColorBrush x:Key="InputBorderBrush" Color="#FFE2DBEF"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#FF6546B5"/>
    <SolidColorBrush x:Key="InputPlaceholderBrush" Color="#886B6078"/>
    <SolidColorBrush x:Key="InputValidationBrush" Color="#FFB83E50"/>

    <SolidColorBrush x:Key="TabActiveBrush" Color="#FF6546B5"/>
    <SolidColorBrush x:Key="TabInactiveBrush" Color="#0047554E"/>
    <SolidColorBrush x:Key="TabHoverBrush" Color="#146546B5"/>
    <SolidColorBrush x:Key="TabPressedBrush" Color="#226546B5"/>
    <SolidColorBrush x:Key="TabFocusBrush" Color="#FF6546B5"/>

    <SolidColorBrush x:Key="ReportPrimaryBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ReportSecondaryBrush" Color="#FFF8F6FC"/>
    <SolidColorBrush x:Key="ReportHeaderBrush" Color="#FF2C2440"/>
    <SolidColorBrush x:Key="ReportTextBrush" Color="#FF2C2440"/>
    <SolidColorBrush x:Key="ReportBorderBrush" Color="#FFE2DBEF"/>
    <SolidColorBrush x:Key="ReportAccentBrush" Color="#FF6546B5"/>

</ResourceDictionary>
