<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:Null x:Key="ElevationNone"/>

    <DropShadowEffect x:Key="ElevationLow"
                      BlurRadius="8" ShadowDepth="0" Opacity="0.08"
                      Color="#FF0F172A"/>
    <DropShadowEffect x:Key="ElevationMedium"
                      BlurRadius="16" ShadowDepth="0" Opacity="0.12"
                      Color="#FF0F172A"/>
    <DropShadowEffect x:Key="ElevationHigh"
                      BlurRadius="28" ShadowDepth="0" Opacity="0.18"
                      Color="#FF0F172A"/>
    <DropShadowEffect x:Key="ElevationOverlay"
                      BlurRadius="36" ShadowDepth="0" Opacity="0.22"
                      Color="#FF0F172A"/>

    <DropShadowEffect x:Key="ElevationCard"
                      BlurRadius="8" ShadowDepth="0" Opacity="0.08"
                      Color="#FF0F172A"/>
    <DropShadowEffect x:Key="ElevationPopup"
                      BlurRadius="16" ShadowDepth="0" Opacity="0.12"
                      Color="#FF0F172A"/>
    <DropShadowEffect x:Key="ElevationDialog"
                      BlurRadius="28" ShadowDepth="0" Opacity="0.18"
                      Color="#FF0F172A"/>

</ResourceDictionary>
