<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:String x:Key="MotionFast">0:0:0.15</sys:String>
    <sys:String x:Key="MotionNormal">0:0:0.2</sys:String>
    <sys:String x:Key="MotionSlow">0:0:0.35</sys:String>
    <sys:Double x:Key="MotionSpeedRatio">1</sys:Double>

</ResourceDictionary>
