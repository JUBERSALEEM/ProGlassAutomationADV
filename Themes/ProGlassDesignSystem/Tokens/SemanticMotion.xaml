<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:String x:Key="MotionFast">0:0:0.15</sys:String>
    <sys:String x:Key="MotionNormal">0:0:0.2</sys:String>
    <sys:String x:Key="MotionSlow">0:0:0.35</sys:String>
    <sys:Double x:Key="MotionSpeedRatio">1</sys:Double>

    <!-- Reduced-motion switch. Defaults to FALSE so animation is on
         until an animated control has read it; the theme painter
         republishes it on every rebuild from the OS Ease of Access
         "Animation effects" preference. Animated controls bind this and
         substitute an opacity cross-fade for their movement animation —
         a zeroed duration alone still reads as a jump cut. -->
    <sys:Boolean x:Key="MotionReduced">False</sys:Boolean>

</ResourceDictionary>
