<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Themes/Swiss/SwissControls.xaml
     PROJECT: ProGlassAutomation
     MODULE: Swiss — control templates

     THE TEMPLATES ARE THE ARGUMENT.

     Every template below declares the same three parts and nothing else:

         PART_SwissFill        flat ground, radius 0
         PART_SwissRule        the horizontal hairline
         PART_SwissFocusRing   focus is a non-decorative requirement

     There is no shadow host in any of them. Not one with no Effect on
     it — not one at all. Compare Themes/Neumorphism/NeuControls.xaml,
     which needs two stacked Borders per shadow because WPF allows one
     Effect per element; this file needs no host whatsoever, because the
     style has no shadow. That absence IS the feature, and leaving the
     part out is what keeps it true — a template author cannot attach
     something the ControlTemplate has nowhere to attach it to.

     PART_SwissRuleEdged is the one structural concession: it lets the
     field move its rule from the top edge to the bottom edge, because
     an input is written on from the left and the line sits under the
     hand rather than above it.
     ═══════════════════════════════════════════════════════════════════ -->

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:swiss="clr-namespace:ProGlassAutomation.Controls.Swiss"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ═══════════════════════════════════════════════════════════
         PALETTE BRIDGE

         Declared as DynamicResource consumers rather than literal
         colours, so these follow EightThemePainter when the active
         family changes. A literal brush captured at dictionary-load time
         would pin every Swiss surface to the light palette the moment
         the app launched, and dark mode would then be a relaunch rather
         than a switch.

         SwissPalette.Publish() writes these same four keys, which is
         what lets the control code path and the XAML path agree.
         ═══════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="SwissPaperBrush" Color="#FAFAF8" />
    <SolidColorBrush x:Key="SwissInkBrush" Color="#111111" />
    <SolidColorBrush x:Key="SwissRuleBrush" Color="#111111" />
    <SolidColorBrush x:Key="SwissMutedBrush" Color="#6B6B6B" />

    <!-- ═══════════════════════════════════════════════════════════
         THE 8PT UNIT

         The baseline every dimension in this style derives from. Gutter
         is 3 units, page margin is 8, body leading is 2.5 — rounded to
         20px at the 13px body size.

         A scalar alongside the Thicknesses because host code reads the
         scalar for margin math while XAML reads the Thickness. One
         number, two shapes, no second place for it to drift.
         ═══════════════════════════════════════════════════════════ -->
    <sys:Double x:Key="SwissUnitScalar">8</sys:Double>
    <!-- Matches SoftUiAccessibility.FocusRingWidth, which is what the
         control code applies at run time. Declared here only as the
         template's resting value — every real state is set in code,
         because the ring's visibility depends on the resolved stack. -->
    <sys:Double x:Key="SwissFocusWidth">3</sys:Double>
    <Thickness x:Key="SwissUnit">8</Thickness>
    <Thickness x:Key="SwissUnitTall">8,8,0,0</Thickness>

    <!-- ═══════════════════════════════════════════════════════════
         TYPE

         Sans-serif only. Hierarchy by size and weight, never by colour
         and never by case decoration.

         LineHeight is set at every level, because flush-left ragged-
         right text is only readable when the leading is fixed. With a
         computed leading the right-hand edge wanders a pixel or two per
         line and the block reads as noise rather than as one shape,
         which defeats the entire reason the style is flush-left.
         ═══════════════════════════════════════════════════════════ -->

    <FontFamily x:Key="SwissTypeFamily">Helvetica Neue, Segoe UI, Arial, sans-serif</FontFamily>

    <Style x:Key="SwissDisplayType" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SwissTypeFamily}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="37" />
        <Setter Property="Foreground" Value="{DynamicResource SwissInkBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="SwissHeadingType" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SwissTypeFamily}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="Foreground" Value="{DynamicResource SwissInkBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="SwissBodyType" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SwissTypeFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource SwissInkBrush}" />
        <!-- Display, not Load. TextFormattingMode has exactly three
             values: Ideal, Display, Disable. There is no Load, and
             the XAML compiler rejects it. Display is also the right
             one for Swiss data type, because it turns off glyph
             caching so digits stay identical frame to frame, which
             is the whole reason a column of figures must not
             jitter. Matches TypographyStyles.xaml and the rest of
             this repo. -->
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <!-- TextOptions.TextRenderingMode, NOT bare
             TextRenderingMode. That property is declared on
             TextElement, and TextBlock derives from
             FrameworkElement rather than from TextElement, so a
             Style with TargetType="TextBlock" cannot resolve it.
             The attached form works on any DependencyObject and
             is what every other dictionary here already uses. -->
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!-- Small caps by weight and case, not by synthesised capitals. A
         faked small-caps run is a font substitution the reader pays for
         in legibility, and hierarchy is the one thing this style is
         always being asked to demonstrate.

         Letterspacing is deliberately absent: WPF TextBlock exposes no
         tracking property, and it would take an attached behaviour or a
         glyph-run transform to fake one. Neither is worth the machinery
         in a style whose entire claim is restraint — and a style that
         shipped a bespoke tracking behaviour would be the one part of it
         nobody could explain. -->
    <Style x:Key="SwissLabelType" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SwissTypeFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource SwissMutedBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!-- Data. Tabular, because Swiss tables are read down a column and
         a proportional digit makes a column of numbers jitter. -->
    <Style x:Key="SwissDataType" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SwissTypeFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource SwissInkBrush}" />
        <!-- Display, not Load. TextFormattingMode has exactly three
             values: Ideal, Display, Disable. There is no Load, and
             the XAML compiler rejects it. Display is also the right
             one for Swiss data type, because it turns off glyph
             caching so digits stay identical frame to frame, which
             is the whole reason a column of figures must not
             jitter. Matches TypographyStyles.xaml and the rest of
             this repo. -->
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <!-- TextOptions.TextRenderingMode, NOT bare
             TextRenderingMode. That property is declared on
             TextElement, and TextBlock derives from
             FrameworkElement rather than from TextElement, so a
             Style with TargetType="TextBlock" cannot resolve it.
             The attached form works on any DependencyObject and
             is what every other dictionary here already uses. -->
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         FOCUS

         A 2px outline sitting OUTSIDE the content, not the recipe's
         1px hairline weight. Two reasons, and both are accessibility:
         SC 2.4.7 wants a visible focus indicator, and a 1px line that
         merely gets heavier competes with the selection weight this
         style already spends on the same axis.
         ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="SwissFocusRing" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource SwissInkBrush}" />
        <Setter Property="BorderThickness"
                Value="{StaticResource SwissFocusWidth}" />
        <Setter Property="Margin" Value="-4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         SWISS SURFACE

         A rule and a ground. No box.
         ═══════════════════════════════════════════════════════════ -->

    <ControlTemplate x:Key="SwissSurfaceTemplate"
                     TargetType="{x:Type swiss:SwissSurface}">
        <Grid Background="{TemplateBinding Background}"
              SnapsToDevicePixels="True">
            <Border x:Name="PART_SwissFill"
                    Background="{DynamicResource SwissPaperBrush}"
                    CornerRadius="0" />
            <Grid Margin="{StaticResource SwissUnit}">
                <Border x:Name="PART_SwissRule"
                        BorderThickness="0,1,0,0"
                        VerticalAlignment="Top"
                        SnapsToDevicePixels="True" />
                <ContentPresenter Margin="{StaticResource SwissUnitTall}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
            <Border x:Name="PART_SwissFocusRing"
                    Style="{StaticResource SwissFocusRing}"
                    Visibility="Collapsed" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type swiss:SwissSurface}">
        <Setter Property="Template" Value="{StaticResource SwissSurfaceTemplate}" />
        <Setter Property="Background" Value="{DynamicResource SwissPaperBrush}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         SWISS BUTTON

         At rest: ink on paper. Hovered or pressed: paper on ink.
         Nothing in between, and nothing moves.

         The ground and the label are swapped TOGETHER by
         SwissButton.UpdateLabel. A state machine that can invert the
         fill but forget the label produces a black-on-black button,
         which is still technically an inversion — and the one failure
         in this family that would make the app unreadable rather than
         merely ugly.
         ═══════════════════════════════════════════════════════════ -->

    <ControlTemplate x:Key="SwissButtonTemplate"
                     TargetType="{x:Type swiss:SwissButton}">
        <Grid Background="{TemplateBinding Background}"
              SnapsToDevicePixels="True">
            <Border x:Name="PART_SwissFill"
                    Background="{DynamicResource SwissPaperBrush}"
                    CornerRadius="0" />
            <Border x:Name="PART_SwissRule"
                    BorderThickness="0,1,0,0"
                    VerticalAlignment="Top"
                    SnapsToDevicePixels="True" />
            <Grid Margin="{StaticResource SwissUnit}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center"
                            Background="Transparent">
                    <ContentPresenter ContentSource="Content"
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                    <!-- The one permitted movement in this family: a
                         directional glyph, because it is typography
                         rather than geometry. Revealed only when the
                         host sets SwissDirectional — a control cannot
                         know whether it navigates anywhere. -->
                    <TextBlock x:Name="PART_SwissArrow"
                               Margin="8,0,0,0"
                               Text="→"
                               FontFamily="{StaticResource SwissTypeFamily}"
                               FontSize="13"
                               Visibility="Collapsed"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <Border x:Name="PART_SwissFocusRing"
                    Style="{StaticResource SwissFocusRing}"
                    Visibility="Collapsed" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type swiss:SwissButton}">
        <Setter Property="Template" Value="{StaticResource SwissButtonTemplate}" />
        <Setter Property="Background" Value="{DynamicResource SwissPaperBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SwissInkBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <!-- No MotionDuration setter, deliberately. The recipe carries a
             150ms ceiling for the family's signature animations, but
             THIS control has nothing to animate: it does not lift, it
             does not scale, it does not translate. A duration bound to
             no animation is decoration of a different kind. -->
    </Style>

    <Style x:Key="SwissDirectionalButtonStyle"
           TargetType="{x:Type swiss:SwissButton}"
           BasedOn="{StaticResource {x:Type swiss:SwissButton}}">
        <Setter Property="SwissDirectional" Value="True" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         SWISS FIELD

         Transparent, underlined. The rule is the only chrome.

         Focus is the rule getting heavier, not a glow: 1px becomes 2px
         and the ink comes to full strength. That is a SHAPE change, so
         it survives a greyscale print and a colour-blind reader — and
         it is why this field is easier to focus than it looks, because
         there is no low-contrast decoration anywhere near it to be
         mistaken for the state.
         ═══════════════════════════════════════════════════════════ -->

    <ControlTemplate x:Key="SwissFieldTemplate"
                     TargetType="{x:Type swiss:SwissField}">
        <Grid Background="{TemplateBinding Background}"
              SnapsToDevicePixels="True">
            <!-- Transparent on purpose. The field is a line you write
                 on, and a tinted box behind it would be exactly the
                 furniture this style exists to remove. -->
            <Border x:Name="PART_SwissFill"
                    Background="Transparent"
                    CornerRadius="0" />
            <Grid Margin="{StaticResource SwissUnit}">
                <StackPanel>
                    <!-- The label sits above the line and stays there.
                         A placeholder that vanishes on the first
                         keystroke takes the field's only label away
                         from the reader halfway through typing. -->
                    <TextBlock x:Name="PART_SwissLabel"
                               Margin="0,0,0,4"
                               Style="{StaticResource SwissLabelType}"
                               Text="{TemplateBinding Label}" />
                    <ContentPresenter Margin="0,0,0,2"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </StackPanel>
                <!-- The rule. BOTTOM, not top — see the header note. -->
                <Border x:Name="PART_SwissRuleEdged"
                        BorderThickness="0,0,0,1"
                        VerticalAlignment="Bottom"
                        SnapsToDevicePixels="True" />
            </Grid>
            <Border x:Name="PART_SwissFocusRing"
                    Style="{StaticResource SwissFocusRing}"
                    Visibility="Collapsed" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type swiss:SwissField}">
        <Setter Property="Template" Value="{StaticResource SwissFieldTemplate}" />
        <Setter Property="Background" Value="Transparent" />
        <!-- Focusable=False is deliberate and NOT an oversight. The
             field is a shell around a host TextBox, and it is the
             host's IsKeyboardFocusWithin that the focus state follows.
             Making the shell focusable would put a second, empty stop
             in the tab order ahead of the control that actually takes
             a keystroke. -->
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

</ResourceDictionary>