<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Themes/Claymorphism/ClayControls.xaml
     PROJECT: ProGlassAutomation
     MODULE: Claymorphism — control templates

     FOUR BORDERS PER SURFACE, AND THE ORDER IS THE RECIPE.

       PART_ClayDropHost   fill + corner radius + the outer shadow.
                           Carries the FILL because a DropShadowEffect
                           renders from its element's silhouette — a
                           transparent host casts nothing.
       PART_ClayHighlight  inner roll toward the light.
       PART_ClayShade      inner roll away from it. Declared AFTER the
                           highlight so it paints on top: the two rolls
                           overlap on the diagonal and the crossover is
                           what forms the rounded corner. Reversing them
                           flattens every corner on the page.
       PART_ClayEdge       the 1px accessible boundary.

     The brushes on the highlight and shade are written from code,
     because they are recipe output rather than markup — the press state
     crosses the two layers over by swapping their gradient direction,
     and no Trigger can express that.

     The overlays are IsHitTestVisible=False so they never swallow a
     click meant for the content beneath them.
     ═══════════════════════════════════════════════════════════════════ -->

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:clay="clr-namespace:ProGlassAutomation.Controls.Claymorphism">

    <!-- ═══════════════════════════════════════════════════════════
         SHARED PIECES
         ═══════════════════════════════════════════════════════════ -->

    <!-- The focus ring. A ring, and a real one.
         An inset highlight looks so much like a focus state that
         designers routinely delete outlines because they break the
         soft look — which is exactly the affordance this style most
         needs to replace. 3px clears WCAG 2.2 SC 1.4.11's 3:1
         non-text boundary and stays visible at small sizes. -->
    <Style x:Key="ClayFocusRing"
           TargetType="Border">
        <Setter Property="BorderBrush"
                Value="{DynamicResource FocusRingBrush}" />
        <Setter Property="BorderThickness" Value="3" />
        <!-- The ring must NOT touch the fill, or it stops reading as a
             ring and starts reading as a border. -->
        <Setter Property="Margin" Value="-6" />
        <Setter Property="CornerRadius" Value="34" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         CLAY SURFACE — cards, panels, hero blocks, stat tiles
         ═══════════════════════════════════════════════════════════ -->

    <ControlTemplate x:Key="ClaySurfaceTemplate"
                     TargetType="{x:Type clay:ClaySurface}">
        <Grid>
            <Border x:Name="FocusRingHost"
                    Style="{StaticResource ClayFocusRing}"
                    Visibility="Collapsed"
                    CornerRadius="{TemplateBinding ClayCornerRadius}" />

            <Border x:Name="PART_ClayDropHost"
                    CornerRadius="{TemplateBinding ClayCornerRadius}"
                    Background="Transparent">
                <Grid>
                    <Border x:Name="PART_ClayHighlight"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False" />

                    <Border x:Name="PART_ClayShade"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False" />

                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RecognizesAccessKey="True" />

                    <Border x:Name="PART_ClayEdge"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False"
                            BorderThickness="1" />
                </Grid>
            </Border>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRingHost"
                        Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <!-- The fill opacity drops ALONGSIDE the recipe's own
                     loss of drop and highlight. A disabled control
                     signalled by shadow alone fails 1.4.1 — and in
                     this style the shadow is most of the surface. -->
                <Setter TargetName="PART_ClayDropHost"
                        Property="Opacity" Value="0.55" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type clay:ClaySurface}">
        <Setter Property="Template"
                Value="{StaticResource ClaySurfaceTemplate}" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Focusable" Value="False" />
        <!-- Clay exaggerates roundness. 32px is the card default; the
             control radius is never allowed below 16, or the soft
             shadow reads as a flat drop-shadow instead of clay. -->
        <Setter Property="ClayCornerRadius" Value="32" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         CLAY BUTTON — the pressed object
         ═══════════════════════════════════════════════════════════ -->

    <ControlTemplate x:Key="ClayButtonTemplate"
                     TargetType="{x:Type clay:ClayButton}">
        <ControlTemplate.Resources>
            <!-- Declared here, mutated from code. A frozen brush cannot
                 be recoloured, so this one is deliberately left
                 unfrozen — it is a single instance per button, and a
                 recolour on press is cheaper than rebuilding the
                 template. -->
            <SolidColorBrush x:Key="ClayLabelBrush"
                             Color="White" />
        </ControlTemplate.Resources>

        <!-- The press transform sits on the OUTER grid, not on the drop
             host, so the shadow travels with the button instead of the
             surface shrinking out from under a stationary shadow.
             This is a TRANSFORM, not a shadow swap: a translate/scale is
             movement, which is a non-colour cue, so WCAG 1.4.1 is
             satisfied by the geometry and the fill no longer has to
             carry the signal as well. -->
        <Grid RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ClayPressScale"
                                    ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="ClayPressTranslate" Y="0" />
                </TransformGroup>
            </Grid.RenderTransform>
            <Border x:Name="FocusRingHost"
                    Style="{StaticResource ClayFocusRing}"
                    Visibility="Collapsed"
                    CornerRadius="{TemplateBinding ClayCornerRadius}" />

            <Border x:Name="PART_ClayDropHost"
                    CornerRadius="{TemplateBinding ClayCornerRadius}"
                    Background="Transparent">
                <Grid>
                    <Border x:Name="PART_ClayHighlight"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False" />

                    <Border x:Name="PART_ClayShade"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False" />

                    <ContentPresenter x:Name="PART_ClayLabel"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"
                                      TextElement.Foreground="{StaticResource ClayLabelBrush}" />

                    <Border x:Name="PART_ClayEdge"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False"
                            BorderThickness="1" />
                </Grid>
            </Border>
        </Grid>

        <ControlTemplate.Triggers>
            <!-- No IsPressed trigger here ON PURPOSE. The press is a
                 SPRING, not a step: it is driven from code by
                 ClayMotion so the family's declared ease-out curve is
                 what actually runs. A Trigger would set the value
                 instantly on press AND reassert it the moment the
                 animation's FillBehavior released it, which is a
                 visible snap at the end of every press. -->
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRingHost"
                        Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type clay:ClayButton}">
        <Setter Property="Template"
                Value="{StaticResource ClayButtonTemplate}" />
        <Setter Property="ClayCornerRadius" Value="18" />
        <Setter Property="Padding" Value="24,14" />
        <Setter Property="MinHeight" Value="54" />
        <!-- The research's hard floor is 54px tall with 0 24px padding.
             Below ~48px the inset has no room to resolve and the
             button stops looking moulded. -->
        <Setter Property="FontSize"
                Value="{DynamicResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource AccentForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         CLAY WELL — the recessed input
         ═══════════════════════════════════════════════════════════ -->

    <ControlTemplate x:Key="ClayWellTemplate"
                     TargetType="{x:Type clay:ClayWell}">
        <Grid>
            <Border x:Name="FocusRingHost"
                    Style="{StaticResource ClayFocusRing}"
                    BorderThickness="{TemplateBinding ClayFocusRingWidth}"
                    Visibility="Collapsed"
                    CornerRadius="{TemplateBinding ClayCornerRadius}" />

            <Border x:Name="PART_ClayDropHost"
                    CornerRadius="{TemplateBinding ClayCornerRadius}"
                    Background="Transparent">
                <Grid>
                    <!-- A WELL HAS NO OUTER DROP. Depth here comes from
                         recving: the insets do all the work. The
                         DropHost still exists because it is the element
                         that carries the fill and the corner radius, and
                         because a Future tier change must not require a
                         second template. -->
                    <Border x:Name="PART_ClayHighlight"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False" />

                    <Border x:Name="PART_ClayShade"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False" />

                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RecognizesAccessKey="True" />

                    <Border x:Name="PART_ClayEdge"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False"
                            BorderThickness="1" />
                </Grid>
            </Border>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="FocusRingHost"
                        Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PART_ClayDropHost"
                        Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type clay:ClayWell}">
        <Setter Property="Template"
                Value="{StaticResource ClayWellTemplate}" />
        <Setter Property="ClayCornerRadius" Value="16" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinHeight" Value="44" />
        <!-- 44px is the touch-target floor, and it is also the height at
             which a 16px radius can still resolve its inset roll. -->
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         CLAY STATUS PILL — the chip
         ═══════════════════════════════════════════════════════════ -->

    <ControlTemplate x:Key="ClayStatusPillTemplate"
                     TargetType="{x:Type clay:ClayStatusPill}">
        <ControlTemplate.Resources>
            <SolidColorBrush x:Key="ClayLabelBrush"
                             Color="White" />
        </ControlTemplate.Resources>

        <Border x:Name="PART_ClayDropHost"
                Background="Transparent"
                MinHeight="{TemplateBinding ClayMinHeight}">
            <Grid>
                <Border x:Name="PART_ClayHighlight"
                        IsHitTestVisible="False" />

                <Border x:Name="PART_ClayShade"
                        IsHitTestVisible="False" />

                <ContentPresenter x:Name="PART_ClayLabel"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  TextElement.Foreground="{StaticResource ClayLabelBrush}" />

                <Border x:Name="PART_ClayEdge"
                        IsHitTestVisible="False"
                        BorderThickness="1" />
            </Grid>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PART_ClayDropHost"
                        Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type clay:ClayStatusPill}">
        <Setter Property="Template"
                Value="{StaticResource ClayStatusPillTemplate}" />
        <Setter Property="ClayMinHeight" Value="28" />
        <Setter Property="Padding" Value="14,0" />
        <!-- Pills are fully round, not 12px. The radius is tracked to
             half the measured height in code, because a pill is a
             stadium rather than a rounded rectangle. -->
        <Setter Property="FontSize"
                Value="{DynamicResource FontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource AccentForegroundBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>


    <!-- ═══════════════════════════════════════════════════════════
         THE COMPONENT CATALOGUE

         Every template below is the SAME four-border mould plus the
         part that makes the component itself. None of them paints a
         shadow by hand — the recipe owns the light, so a component can
         never disagree with the surface it sits on.

         The four names are load-bearing:
           PART_ClayDropHost  fill + outer drop (shadow follows the
                              silhouette, so THIS is the opaque one)
           PART_ClayHighlight inner roll toward the light
           PART_ClayShade     inner roll away from it — declared AFTER
                              the highlight so it paints on top and the
                              crossover forms the rounded edge
           PART_ClayEdge      the accessible 3:1 boundary
         ═══════════════════════════════════════════════════════════ -->

    <!-- ═══════════════════════════════════════════════════════════
         CLAY FIELD — concave, because text goes IN
         ═══════════════════════════════════════════════════════════ -->

    <ControlTemplate x:Key="ClayFieldTemplate"
                     TargetType="{x:Type clay:ClayField}">
        <Grid>
            <Border x:Name="FocusRingHost"
                    Style="{StaticResource ClayFocusRing}"
                    Visibility="Collapsed"
                    CornerRadius="{TemplateBinding ClayCornerRadius}" />

            <Border x:Name="PART_ClayDropHost"
                    CornerRadius="{TemplateBinding ClayCornerRadius}"
                    Background="Transparent">
                <Grid>
                    <Border x:Name="PART_ClayHighlight"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False" />

                    <Border x:Name="PART_ClayShade"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False" />

                    <!-- Placeholder. Sits UNDER the real text and is
                         revealed only while the field is empty, so it can
                         never overlap a value. -->
                    <TextBlock x:Name="ClayPlaceholderText"
                               Margin="{TemplateBinding Padding}"
                               Text="{TemplateBinding ClayPlaceholder}"
                               Foreground="{TemplateBinding ClayPlaceholderBrush}"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="Collapsed" />

                    <!-- PART_ContentHost is not optional. WPF renders the
                         text and blinks the caret through this part; a
                         template without it is an empty box that still
                         takes focus. -->
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="Center"
                                  Focusable="False"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden" />

                    <Border x:Name="PART_ClayEdge"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False"
                            BorderThickness="1" />
                </Grid>
            </Border>
        </Grid>

        <ControlTemplate.Triggers>
            <!-- Reveal the placeholder only while the field is empty.
                 This uses a bare equality test on purpose. An "is null OR
                 is whitespace" converter would read better, but it means
                 shipping a converter, and the only difference is whether
                 a field containing a single space shows its hint - not
                 worth the extra indirection in a template every field on
                 the page pays to parse. -->
            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}"
                         Value="">
                <Setter TargetName="ClayPlaceholderText" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRingHost" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PART_ClayDropHost" Property="Opacity" Value="0.55" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type clay:ClayField}">
        <Setter Property="Template" Value="{StaticResource ClayFieldTemplate}" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Height" Value="52" />
        <Setter Property="ClayCornerRadius" Value="22" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         CLAY TOGGLE SWITCH — track + thumb, two tiers nested
         ═══════════════════════════════════════════════════════════ -->

    <ControlTemplate x:Key="ClayToggleSwitchTemplate"
                     TargetType="{x:Type clay:ClayToggleSwitch}">
        <Grid>
            <Border x:Name="FocusRingHost"
                    Style="{StaticResource ClayFocusRing}"
                    Visibility="Collapsed"
                    CornerRadius="{TemplateBinding ClayCornerRadius}" />

            <Border x:Name="PART_ClayDropHost"
                    CornerRadius="{TemplateBinding ClayCornerRadius}"
                    Background="Transparent">
                <Grid>
                    <Border x:Name="PART_ClayHighlight"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False" />

                    <Border x:Name="PART_ClayShade"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False" />

                    <Border x:Name="PART_ClayEdge"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False"
                            BorderThickness="1" />
                </Grid>
            </Border>

            <!-- The thumb. It keeps the Raised tier in BOTH positions; a
                 thumb that flattens on the off state stops reading as
                 something you can grab. Position, not colour, is the
                 state signal — so this survives greyscale. -->
            <Border x:Name="ClaySwitchThumb"
                    Width="26" Height="26"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="5,0,0,0"
                    CornerRadius="13"
                    Background="{DynamicResource SurfacePrimaryBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="3"
                                      Direction="315" Opacity="0.34" />
                </Border.Effect>
            </Border>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ClaySwitchThumb"
                        Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="ClaySwitchThumb"
                        Property="Margin" Value="0,0,5,0" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRingHost" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PART_ClayDropHost" Property="Opacity" Value="0.55" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type clay:ClayToggleSwitch}">
        <Setter Property="Template" Value="{StaticResource ClayToggleSwitchTemplate}" />
        <Setter Property="Width" Value="58" />
        <Setter Property="Height" Value="34" />
        <Setter Property="ClayCornerRadius" Value="17" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         CLAY ICON BUTTON — square, press moves it into the page
         ═══════════════════════════════════════════════════════════ -->

    <ControlTemplate x:Key="ClayIconButtonTemplate"
                     TargetType="{x:Type clay:ClayIconButton}">
        <ControlTemplate.Resources>
            <!-- Mutated from code; left unfrozen for that reason. -->
            <SolidColorBrush x:Key="ClayIconBrush" Color="Black" />
        </ControlTemplate.Resources>

        <!-- The press transform lives on the OUTER grid, not on the drop
             host, so the shadow travels with the button instead of the
             surface shrinking out from under a stationary shadow. -->
        <Grid RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ClayIconPressScale"
                                    ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="ClayIconPressTranslate" Y="0" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Border x:Name="FocusRingHost"
                    Style="{StaticResource ClayFocusRing}"
                    Visibility="Collapsed"
                    CornerRadius="{TemplateBinding ClayCornerRadius}" />

            <Border x:Name="PART_ClayDropHost"
                    CornerRadius="{TemplateBinding ClayCornerRadius}"
                    Background="Transparent">
                <Grid>
                    <Border x:Name="PART_ClayHighlight"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False" />
                    <Border x:Name="PART_ClayShade"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False" />
                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True" />
                    <Border x:Name="PART_ClayEdge"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False"
                            BorderThickness="1" />
                </Grid>
            </Border>
        </Grid>

        <ControlTemplate.Triggers>
            <!-- Spring-driven from code, same as ClayButtonTemplate. -->
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRingHost" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PART_ClayDropHost" Property="Opacity" Value="0.55" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type clay:ClayIconButton}">
        <Setter Property="Template" Value="{StaticResource ClayIconButtonTemplate}" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ClayCornerRadius" Value="16" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         CLAY CHIP — the documented exception, ink fill, no card pose
         ═══════════════════════════════════════════════════════════ -->

    <ControlTemplate x:Key="ClayChipTemplate"
                     TargetType="{x:Type clay:ClayChip}">
        <ControlTemplate.Resources>
            <SolidColorBrush x:Key="ClayChipBrush" Color="White" />
        </ControlTemplate.Resources>

        <Border x:Name="PART_ClayDropHost"
                CornerRadius="{TemplateBinding ClayCornerRadius}"
                Background="Transparent">
            <Grid>
                <Border x:Name="PART_ClayHighlight"
                        CornerRadius="{TemplateBinding ClayCornerRadius}"
                        IsHitTestVisible="False" />
                <Border x:Name="PART_ClayShade"
                        CornerRadius="{TemplateBinding ClayCornerRadius}"
                        IsHitTestVisible="False" />
                <ContentPresenter Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                <Border x:Name="PART_ClayEdge"
                        CornerRadius="{TemplateBinding ClayCornerRadius}"
                        IsHitTestVisible="False"
                        BorderThickness="1" />
            </Grid>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PART_ClayDropHost" Property="Opacity" Value="0.55" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type clay:ClayChip}">
        <Setter Property="Template" Value="{StaticResource ClayChipTemplate}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="ClayCornerRadius" Value="14" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         CLAY STAT TILE — label, value, delta
         ═══════════════════════════════════════════════════════════ -->

    <ControlTemplate x:Key="ClayStatTileTemplate"
                     TargetType="{x:Type clay:ClayStatTile}">
        <ControlTemplate.Resources>
            <SolidColorBrush x:Key="ClayTileValueBrush" Color="Black" />
            <SolidColorBrush x:Key="ClayTileLabelBrush" Color="Gray" />
            <SolidColorBrush x:Key="ClayTileDeltaBrush" Color="Gray" />
        </ControlTemplate.Resources>

        <Border x:Name="PART_ClayDropHost"
                CornerRadius="{TemplateBinding ClayCornerRadius}"
                Background="Transparent">
            <Grid>
                <Border x:Name="PART_ClayHighlight"
                        CornerRadius="{TemplateBinding ClayCornerRadius}"
                        IsHitTestVisible="False" />
                <Border x:Name="PART_ClayShade"
                        CornerRadius="{TemplateBinding ClayCornerRadius}"
                        IsHitTestVisible="False" />

                <StackPanel Margin="{TemplateBinding Padding}">
                    <TextBlock Text="{TemplateBinding ClayLabelText}"
                               Foreground="{StaticResource ClayTileLabelBrush}"
                               FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{TemplateBinding ClayValueText}"
                               Foreground="{StaticResource ClayTileValueBrush}"
                               FontSize="30" FontWeight="Bold"
                               Margin="0,4,0,0" TextWrapping="NoWrap" />
                    <!-- The arrow is the cue that makes direction
                         non-colour. It is drawn for BOTH directions; an
                         absent arrow would leave colour as the only
                         difference, which is the thing 1.4.1 forbids. -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,8,0,0">
                        <TextBlock x:Name="ClayDeltaArrow"
                                   Text="•" FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource ClayTileDeltaBrush}" />
                        <TextBlock Text="{TemplateBinding ClayDeltaText}"
                                   Foreground="{StaticResource ClayTileDeltaBrush}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Margin="5,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Caller-supplied content sits UNDER the tile's own
                     parts so a caller cannot repaint the mould. -->
                <ContentPresenter Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom" />

                <Border x:Name="PART_ClayEdge"
                        CornerRadius="{TemplateBinding ClayCornerRadius}"
                        IsHitTestVisible="False"
                        BorderThickness="1" />
            </Grid>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PART_ClayDropHost" Property="Opacity" Value="0.55" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type clay:ClayStatTile}">
        <Setter Property="Template" Value="{StaticResource ClayStatTileTemplate}" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="ClayCornerRadius" Value="28" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         CLAY PROGRESS BAR — concave track, FLAT accent fill
         ═══════════════════════════════════════════════════════════ -->

    <ControlTemplate x:Key="ClayProgressBarTemplate"
                     TargetType="{x:Type clay:ClayProgressBar}">
        <ControlTemplate.Resources>
            <SolidColorBrush x:Key="ClayProgressFillBrush" Color="Gray" />
        </ControlTemplate.Resources>

        <Border x:Name="PART_ClayDropHost"
                CornerRadius="{TemplateBinding ClayCornerRadius}"
                Background="Transparent"
                ClipToBounds="True">
            <Grid>
                <Border x:Name="PART_ClayHighlight"
                        CornerRadius="{TemplateBinding ClayCornerRadius}"
                        IsHitTestVisible="False" />
                <Border x:Name="PART_ClayShade"
                        CornerRadius="{TemplateBinding ClayCornerRadius}"
                        IsHitTestVisible="False" />

                <!-- The fill is FLAT on purpose: at 14px a three-shadow
                     stack cannot resolve and reads as a lit tube. Its
                     radius is inset by 2px so it sits INSIDE the groove
                     rather than filling it edge to edge. -->
                <Border x:Name="ClayProgressFillHost"
                        HorizontalAlignment="Left"
                        Margin="2"
                        CornerRadius="{TemplateBinding ClayCornerRadius}"
                        Background="{StaticResource ClayProgressFillBrush}" />

                <Border x:Name="PART_ClayEdge"
                        CornerRadius="{TemplateBinding ClayCornerRadius}"
                        IsHitTestVisible="False"
                        BorderThickness="1" />
            </Grid>
        </Border>
    </ControlTemplate>

    <Style TargetType="{x:Type clay:ClayProgressBar}">
        <Setter Property="Template" Value="{StaticResource ClayProgressBarTemplate}" />
        <Setter Property="Height" Value="14" />
        <Setter Property="ClayCornerRadius" Value="7" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         CLAY PROGRESS RING — arc driven from the REAL circumference
         ═══════════════════════════════════════════════════════════ -->

    <ControlTemplate x:Key="ClayProgressRingTemplate"
                     TargetType="{x:Type clay:ClayProgressRing}">
        <ControlTemplate.Resources>
            <SolidColorBrush x:Key="ClayRingBrush" Color="Gray" />
        </ControlTemplate.Resources>

        <Grid x:Name="ClayRingGrid">
            <!-- Track: the full circle, sunk.
                 This is a STROKE, not a mould. The other clay surfaces get
                 their Well from the PART_Clay* gradient insets, and a
                 linear gradient cannot follow a circular path in WPF
                 without hand-built Path geometry - which would cost more
                 than the ring is worth. The trade is real, so the track
                 gets an explicit 1px edge instead: every other surface in
                 this family carries a 3:1 boundary, and a ring without one
                 is invisible against a same-value page. -->
            <Ellipse StrokeThickness="{TemplateBinding ClayThickness}">
                <Ellipse.Stroke>
                    <SolidColorBrush Color="{DynamicResource SurfaceSecondaryBrush}" />
                </Ellipse.Stroke>
                <Ellipse.Opacity>0.55</Ellipse.Opacity>
            </Ellipse>

            <!-- The accessible boundary for the track. Sits OUTSIDE the
                 track stroke so it never competes with the arc. -->
            <Ellipse x:Name="ClayRingEdge"
                     StrokeThickness="1"
                     Stroke="{DynamicResource BorderDefaultBrush}"
                     Margin="1" />

            <!-- Arc. The dash array is COMPUTED from the rendered size,
                 never hard-coded: a fixed dash silently mis-draws the
                 moment the ring is resized. -->
            <Ellipse x:Name="ClayRingArc"
                     StrokeThickness="{TemplateBinding ClayThickness}"
                     Stroke="{StaticResource ClayRingBrush}"
                     RenderTransformOrigin="0.5,0.5" />

            <TextBlock x:Name="ClayRingCenter"
                       Text="{TemplateBinding ClayCenterText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type clay:ClayProgressRing}">
        <Setter Property="Template" Value="{StaticResource ClayProgressRingTemplate}" />
        <Setter Property="Width" Value="96" />
        <Setter Property="Height" Value="96" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         CLAY SLIDER — concave track, raised thumb
         ═══════════════════════════════════════════════════════════ -->

    <!-- The thumb is its OWN mould, so it carries its own template. -->
    <ControlTemplate x:Key="ClaySliderThumbTemplate"
                     TargetType="{x:Type Border}">
        <Grid>
            <Border x:Name="PART_ClayDropHost"
                    CornerRadius="14" Background="Transparent">
                <Grid>
                    <Border x:Name="PART_ClayHighlight"
                            CornerRadius="14" IsHitTestVisible="False" />
                    <Border x:Name="PART_ClayShade"
                            CornerRadius="14" IsHitTestVisible="False" />
                    <Border x:Name="PART_ClayEdge"
                            CornerRadius="14" IsHitTestVisible="False"
                            BorderThickness="1" />
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="ClaySliderTemplate"
                     TargetType="{x:Type clay:ClaySlider}">
        <Grid>
            <Border x:Name="FocusRingHost"
                    Style="{StaticResource ClayFocusRing}"
                    Visibility="Collapsed"
                    CornerRadius="{TemplateBinding ClayCornerRadius}" />

            <Border x:Name="PART_ClayDropHost"
                    Height="14"
                    VerticalAlignment="Center"
                    CornerRadius="{TemplateBinding ClayCornerRadius}"
                    Background="Transparent">
                <Grid ClipToBounds="True">
                    <Border x:Name="PART_ClayHighlight"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False" />
                    <Border x:Name="PART_ClayShade"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False" />

                    <!-- The filled portion. Flat, for the same reason the
                         progress bar's fill is flat. -->
                    <Border x:Name="ClaySliderFill"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Height="14"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            Background="{DynamicResource AccentBrush}" />

                    <Border x:Name="PART_ClayEdge"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False"
                            BorderThickness="1" />
                </Grid>
            </Border>

            <!-- Offset is pushed from Value in code. -->
            <Border x:Name="ClaySliderThumb"
                    Width="28" Height="28"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Template="{StaticResource ClaySliderThumbTemplate}" />
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="FocusRingHost" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PART_ClayDropHost" Property="Opacity" Value="0.55" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type clay:ClaySlider}">
        <Setter Property="Template" Value="{StaticResource ClaySliderTemplate}" />
        <Setter Property="Height" Value="34" />
        <Setter Property="ClayCornerRadius" Value="7" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         CLAY MENU ROW — the row that is the same control everywhere
         ═══════════════════════════════════════════════════════════ -->

    <ControlTemplate x:Key="ClayMenuRowTemplate"
                     TargetType="{x:Type clay:ClayMenuRow}">
        <Grid RenderTransformOrigin="0.5,0.5">
            <!-- Spring-driven from code by ClayMotion, like every other
                 pressable clay control. A row in a scrolling list is the
                 one place a heavy press animation would be felt most, so
                 the travel is deliberately smaller than a button's. -->
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ClayMenuRowPressScale"
                                    ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="ClayMenuRowPressTranslate" Y="0" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Border x:Name="FocusRingHost"
                    Style="{StaticResource ClayFocusRing}"
                    Visibility="Collapsed"
                    CornerRadius="{TemplateBinding ClayCornerRadius}" />

            <Border x:Name="PART_ClayDropHost"
                    CornerRadius="{TemplateBinding ClayCornerRadius}"
                    Background="Transparent">
                <Grid>
                    <Border x:Name="PART_ClayHighlight"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False" />
                    <Border x:Name="PART_ClayShade"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False" />

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}">
                        <!-- The selection marker. A selected row is tinted
                             AND marked, so the selection survives
                             greyscale and colour blindness. -->
                        <Border x:Name="ClayRowMarker"
                                Width="4" Height="18"
                                CornerRadius="2"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentBrush}"
                                Visibility="Collapsed" />

                        <TextBlock x:Name="ClayRowGlyph"
                                   Text="{TemplateBinding ClayRowGlyph}"
                                   FontSize="15"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />

                        <ContentPresenter VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>

                    <Border x:Name="PART_ClayEdge"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False"
                            BorderThickness="1" />
                </Grid>
            </Border>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsSelectedRow" Value="True">
                <Setter TargetName="ClayRowMarker" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="ClayRowGlyph" Value="">
                <Setter TargetName="ClayRowGlyph" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRingHost" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PART_ClayDropHost" Property="Opacity" Value="0.55" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type clay:ClayMenuRow}">
        <Setter Property="Template" Value="{StaticResource ClayMenuRowTemplate}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="48" />
        <Setter Property="ClayCornerRadius" Value="18" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         CLAY COMBOBOX — closed is a Surface, open is a menu list
         ═══════════════════════════════════════════════════════════ -->

    <ControlTemplate x:Key="ClayComboBoxTemplate"
                     TargetType="{x:Type clay:ClayComboBox}">
        <Grid>
            <Border x:Name="FocusRingHost"
                    Style="{StaticResource ClayFocusRing}"
                    Visibility="Collapsed"
                    CornerRadius="{TemplateBinding ClayCornerRadius}" />

            <Border x:Name="PART_ClayDropHost"
                    CornerRadius="{TemplateBinding ClayCornerRadius}"
                    Background="Transparent">
                <Grid>
                    <Border x:Name="PART_ClayHighlight"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False" />
                    <Border x:Name="PART_ClayShade"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False" />

                    <Grid Margin="{TemplateBinding Padding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="ClayComboSelection"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="{TemplateBinding SelectionBoxItem}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />

                        <!-- Chevron. The open/closed state is carried by
                             ROTATION as well as by the surface lift, so
                             the state is not signalled by depth alone. -->
                        <Path x:Name="ClayComboChevron"
                              Grid.Column="1"
                              Width="10" Height="6"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right"
                              Data="M 0,0 L 10,0 L 5,6 Z"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="ClayComboChevronRotate"
                                                 Angle="0" />
                            </Path.RenderTransform>
                        </Path>
                    </Grid>

                    <!-- Keyboard support. AccessibleName lets the caller
                         name the control for a screen reader. -->
                    <TextBlock x:Name="ClayComboProxy"
                               Visibility="Collapsed"
                               Text="{TemplateBinding SelectedItem}" />

                    <Border x:Name="PART_ClayEdge"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False"
                            BorderThickness="1" />
                </Grid>
            </Border>

            <!-- The hit target. Covers the surface so the whole card is
                 clickable, and owns the popup. -->
            <ToggleButton x:Name="ClayComboToggle"
                          Focusable="False"
                          Background="Transparent"
                          BorderThickness="0"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          ClickMode="Press">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </ToggleButton.Template>

                <!-- PART_Popup is REQUIRED by name: ComboBox looks the
                     popup up by exactly this key and silently does
                     nothing without it. -->
                <Popup x:Name="PART_Popup"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       Placement="Bottom"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Fade">
                    <Border x:Name="ClayDropdownHost"
                            Margin="0,8,0,0"
                            Padding="6"
                            MinWidth="{TemplateBinding ActualWidth}"
                            CornerRadius="22"
                            Background="{DynamicResource SurfacePrimaryBrush}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="26" ShadowDepth="8"
                                              Direction="315" Opacity="0.32" />
                        </Border.Effect>
                        <ScrollViewer MaxHeight="320"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </Popup>
            </ToggleButton>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="ClayComboChevronRotate"
                        Property="Angle" Value="180" />
                <Setter TargetName="ClayDropdownHost"
                        Property="Background"
                        Value="{DynamicResource SurfacePrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="FocusRingHost" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PART_ClayDropHost" Property="Opacity" Value="0.55" />
            </Trigger>
            <Trigger Property="SelectedItem" Value="{x:Null}">
                <Setter TargetName="ClayComboSelection"
                        Property="Text" Value="Select…" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type clay:ClayComboBox}">
        <Setter Property="Template" Value="{StaticResource ClayComboBoxTemplate}" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Height" Value="52" />
        <Setter Property="ClayCornerRadius" Value="22" />
        <Setter Property="FontSize" Value="14" />
        <!-- The open list is clay menu rows, so a dropdown and a nav
             rail are literally the same object. -->
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type clay:ClayMenuRow}">
                    <Setter Property="Template" Value="{StaticResource ClayMenuRowTemplate}" />
                    <Setter Property="Padding" Value="14,0" />
                    <Setter Property="Height" Value="44" />
                    <Setter Property="ClayCornerRadius" Value="16" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Focusable" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>


    <!-- ═══════════════════════════════════════════════════════════
         CLAY CARD — header / body / footer

         Four content slots, deliberately: ClayHeader, ClayFooter,
         Content (the body) and ContentPresenter's own leftover space.
         A caller who sets Content on a card that already has a header
         gets the BODY, not an overlap.
         ═══════════════════════════════════════════════════════════ -->

    <ControlTemplate x:Key="ClayCardTemplate"
                     TargetType="{x:Type clay:ClayCard}">
        <ControlTemplate.Resources>
            <SolidColorBrush x:Key="ClayCardAccentBrush" Color="Gray" />
        </ControlTemplate.Resources>

        <Grid>
            <Border x:Name="FocusRingHost"
                    Style="{StaticResource ClayFocusRing}"
                    Visibility="Collapsed"
                    CornerRadius="{TemplateBinding ClayCornerRadius}" />

            <Border x:Name="PART_ClayDropHost"
                    CornerRadius="{TemplateBinding ClayCornerRadius}"
                    Background="Transparent">
                <Grid>
                    <Border x:Name="PART_ClayHighlight"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False" />
                    <Border x:Name="PART_ClayShade"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False" />

                    <Grid Margin="{TemplateBinding Padding}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header: accent marker + caller content. The
                             marker is what ties a card to a status colour
                             without tinting the whole card. -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ClayCardAccent"
                                    Grid.Column="0"
                                    Width="4" Height="22"
                                    CornerRadius="2"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"
                                    Background="{StaticResource ClayCardAccentBrush}" />
                            <ContentPresenter Grid.Column="1"
                                              Content="{TemplateBinding ClayHeader}"
                                              VerticalAlignment="Center" />
                        </Grid>

                        <!-- The body is the control's own Content. Row 1
                             stays collapsed-by-default in effect: with no
                             body there is nothing to show, and the row
                             collapses to zero height because its content
                             is empty. -->
                        <ContentPresenter Grid.Row="1"
                                          Margin="0,10,0,0"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Top" />

                        <ContentPresenter Grid.Row="2"
                                          Content="{TemplateBinding ClayFooter}"
                                          Margin="0,14,0,0" />
                    </Grid>

                    <Border x:Name="PART_ClayEdge"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False"
                            BorderThickness="1" />
                </Grid>
            </Border>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRingHost" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PART_ClayDropHost" Property="Opacity" Value="0.55" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type clay:ClayCard}">
        <Setter Property="Template" Value="{StaticResource ClayCardTemplate}" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="ClayCornerRadius" Value="28" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         CLAY NAV — brand / items / account
         ═══════════════════════════════════════════════════════════ -->

    <ControlTemplate x:Key="ClayNavTemplate"
                     TargetType="{x:Type clay:ClayNav}">
        <Grid>
            <Border x:Name="PART_ClayDropHost"
                    CornerRadius="{TemplateBinding ClayCornerRadius}"
                    Background="Transparent">
                <Grid>
                    <Border x:Name="PART_ClayHighlight"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False" />
                    <Border x:Name="PART_ClayShade"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False" />

                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ContentPresenter Grid.Row="0"
                                          Content="{TemplateBinding ClayBrand}"
                                          Margin="6,0,6,20" />

                        <!-- The rows. Each item is expected to be a
                             ClayMenuRow, which is what makes the rail and
                             a dropdown share one selection grammar. -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Focusable="False">
                            <ItemsControl ItemsSource="{TemplateBinding ClayItems}" />
                        </ScrollViewer>

                        <!-- Pinned, so the account block never scrolls
                             away with the links. -->
                        <ContentPresenter Grid.Row="2"
                                          Content="{TemplateBinding ClayAccount}"
                                          Margin="6,16,6,0" />
                    </Grid>

                    <Border x:Name="PART_ClayEdge"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False"
                            BorderThickness="1" />
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type clay:ClayNav}">
        <Setter Property="Template" Value="{StaticResource ClayNavTemplate}" />
        <Setter Property="Width" Value="240" />
        <Setter Property="ClayCornerRadius" Value="24" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />

        <!-- One selection grammar for the whole app: a nav row IS a menu
             row. Without this the rail would invent its own hover and
             selected treatment and the two would drift apart. -->
        <!-- Deliberately NOT set here: ClayItems (a caller supplies it)
             and FocusVisualStyle (the rail carries ClayFocusRing, and
             blanking the system one would remove the only focus cue a
             keyboard user has here). -->
    </Style>

    <Style x:Key="ClayNavRowStyle" TargetType="{x:Type clay:ClayMenuRow}">
        <Setter Property="Template" Value="{StaticResource ClayMenuRowTemplate}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="46" />
        <Setter Property="ClayCornerRadius" Value="16" />
        <Setter Property="Margin" Value="0,2,0,2" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Focusable" Value="True" />
    </Style>

</ResourceDictionary>