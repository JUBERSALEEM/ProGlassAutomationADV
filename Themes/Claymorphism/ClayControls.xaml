<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Themes/Claymorphism/ClayControls.xaml
     PROJECT: ProGlassAutomation
     MODULE: Claymorphism — control templates

     FOUR BORDERS PER SURFACE, AND THE ORDER IS THE RECIPE.

       PART_ClayDropHost   fill + corner radius + the outer shadow.
                           Carries the FILL because a DropShadowEffect
                           renders from its element's silhouette — a
                           transparent host casts nothing.
       PART_ClayHighlight  inner roll toward the light.
       PART_ClayShade      inner roll away from it. Declared AFTER the
                           highlight so it paints on top: the two rolls
                           overlap on the diagonal and the crossover is
                           what forms the rounded corner. Reversing them
                           flattens every corner on the page.
       PART_ClayEdge       the 1px accessible boundary.

     The brushes on the highlight and shade are written from code,
     because they are recipe output rather than markup — the press state
     crosses the two layers over by swapping their gradient direction,
     and no Trigger can express that.

     The overlays are IsHitTestVisible=False so they never swallow a
     click meant for the content beneath them.
     ═══════════════════════════════════════════════════════════════════ -->

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:clay="clr-namespace:ProGlassAutomation.Controls.Claymorphism">

    <!-- ═══════════════════════════════════════════════════════════
         SHARED PIECES
         ═══════════════════════════════════════════════════════════ -->

    <!-- The focus ring. A ring, and a real one.
         An inset highlight looks so much like a focus state that
         designers routinely delete outlines because they break the
         soft look — which is exactly the affordance this style most
         needs to replace. 3px clears WCAG 2.2 SC 1.4.11's 3:1
         non-text boundary and stays visible at small sizes. -->
    <Style x:Key="ClayFocusRing"
           TargetType="Border">
        <Setter Property="BorderBrush"
                Value="{DynamicResource FocusRingBrush}" />
        <Setter Property="BorderThickness" Value="3" />
        <!-- The ring must NOT touch the fill, or it stops reading as a
             ring and starts reading as a border. -->
        <Setter Property="Margin" Value="-6" />
        <Setter Property="CornerRadius" Value="34" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         CLAY SURFACE — cards, panels, hero blocks, stat tiles
         ═══════════════════════════════════════════════════════════ -->

    <ControlTemplate x:Key="ClaySurfaceTemplate"
                     TargetType="{x:Type clay:ClaySurface}">
        <Grid>
            <Border x:Name="FocusRingHost"
                    Style="{StaticResource ClayFocusRing}"
                    Visibility="Collapsed"
                    CornerRadius="{TemplateBinding ClayCornerRadius}" />

            <Border x:Name="PART_ClayDropHost"
                    CornerRadius="{TemplateBinding ClayCornerRadius}"
                    Background="Transparent">
                <Grid>
                    <Border x:Name="PART_ClayHighlight"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False" />

                    <Border x:Name="PART_ClayShade"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False" />

                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RecognizesAccessKey="True" />

                    <Border x:Name="PART_ClayEdge"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False"
                            BorderThickness="1" />
                </Grid>
            </Border>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRingHost"
                        Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <!-- The fill opacity drops ALONGSIDE the recipe's own
                     loss of drop and highlight. A disabled control
                     signalled by shadow alone fails 1.4.1 — and in
                     this style the shadow is most of the surface. -->
                <Setter TargetName="PART_ClayDropHost"
                        Property="Opacity" Value="0.55" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type clay:ClaySurface}">
        <Setter Property="Template"
                Value="{StaticResource ClaySurfaceTemplate}" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Focusable" Value="False" />
        <!-- Clay exaggerates roundness. 32px is the card default; the
             control radius is never allowed below 16, or the soft
             shadow reads as a flat drop-shadow instead of clay. -->
        <Setter Property="ClayCornerRadius" Value="32" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         CLAY BUTTON — the pressed object
         ═══════════════════════════════════════════════════════════ -->

    <ControlTemplate x:Key="ClayButtonTemplate"
                     TargetType="{x:Type clay:ClayButton}">
        <ControlTemplate.Resources>
            <!-- Declared here, mutated from code. A frozen brush cannot
                 be recoloured, so this one is deliberately left
                 unfrozen — it is a single instance per button, and a
                 recolour on press is cheaper than rebuilding the
                 template. -->
            <SolidColorBrush x:Key="ClayLabelBrush"
                             Color="White" />
        </ControlTemplate.Resources>

        <Grid>
            <Border x:Name="FocusRingHost"
                    Style="{StaticResource ClayFocusRing}"
                    Visibility="Collapsed"
                    CornerRadius="{TemplateBinding ClayCornerRadius}" />

            <Border x:Name="PART_ClayDropHost"
                    CornerRadius="{TemplateBinding ClayCornerRadius}"
                    Background="Transparent">
                <Grid>
                    <Border x:Name="PART_ClayHighlight"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False" />

                    <Border x:Name="PART_ClayShade"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False" />

                    <ContentPresenter x:Name="PART_ClayLabel"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"
                                      TextElement.Foreground="{StaticResource ClayLabelBrush}" />

                    <Border x:Name="PART_ClayEdge"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False"
                            BorderThickness="1" />
                </Grid>
            </Border>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRingHost"
                        Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type clay:ClayButton}">
        <Setter Property="Template"
                Value="{StaticResource ClayButtonTemplate}" />
        <Setter Property="ClayCornerRadius" Value="18" />
        <Setter Property="Padding" Value="24,14" />
        <Setter Property="MinHeight" Value="54" />
        <!-- The research's hard floor is 54px tall with 0 24px padding.
             Below ~48px the inset has no room to resolve and the
             button stops looking moulded. -->
        <Setter Property="FontSize"
                Value="{DynamicResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource AccentForegroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         CLAY WELL — the recessed input
         ═══════════════════════════════════════════════════════════ -->

    <ControlTemplate x:Key="ClayWellTemplate"
                     TargetType="{x:Type clay:ClayWell}">
        <Grid>
            <Border x:Name="FocusRingHost"
                    Style="{StaticResource ClayFocusRing}"
                    BorderThickness="{TemplateBinding ClayFocusRingWidth}"
                    Visibility="Collapsed"
                    CornerRadius="{TemplateBinding ClayCornerRadius}" />

            <Border x:Name="PART_ClayDropHost"
                    CornerRadius="{TemplateBinding ClayCornerRadius}"
                    Background="Transparent">
                <Grid>
                    <!-- A WELL HAS NO OUTER DROP. Depth here comes from
                         recving: the insets do all the work. The
                         DropHost still exists because it is the element
                         that carries the fill and the corner radius, and
                         because a Future tier change must not require a
                         second template. -->
                    <Border x:Name="PART_ClayHighlight"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False" />

                    <Border x:Name="PART_ClayShade"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False" />

                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RecognizesAccessKey="True" />

                    <Border x:Name="PART_ClayEdge"
                            CornerRadius="{TemplateBinding ClayCornerRadius}"
                            IsHitTestVisible="False"
                            BorderThickness="1" />
                </Grid>
            </Border>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="FocusRingHost"
                        Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PART_ClayDropHost"
                        Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type clay:ClayWell}">
        <Setter Property="Template"
                Value="{StaticResource ClayWellTemplate}" />
        <Setter Property="ClayCornerRadius" Value="16" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinHeight" Value="44" />
        <!-- 44px is the touch-target floor, and it is also the height at
             which a 16px radius can still resolve its inset roll. -->
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         CLAY STATUS PILL — the chip
         ═══════════════════════════════════════════════════════════ -->

    <ControlTemplate x:Key="ClayStatusPillTemplate"
                     TargetType="{x:Type clay:ClayStatusPill}">
        <ControlTemplate.Resources>
            <SolidColorBrush x:Key="ClayLabelBrush"
                             Color="White" />
        </ControlTemplate.Resources>

        <Border x:Name="PART_ClayDropHost"
                Background="Transparent"
                MinHeight="{TemplateBinding ClayMinHeight}">
            <Grid>
                <Border x:Name="PART_ClayHighlight"
                        IsHitTestVisible="False" />

                <Border x:Name="PART_ClayShade"
                        IsHitTestVisible="False" />

                <ContentPresenter x:Name="PART_ClayLabel"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  TextElement.Foreground="{StaticResource ClayLabelBrush}" />

                <Border x:Name="PART_ClayEdge"
                        IsHitTestVisible="False"
                        BorderThickness="1" />
            </Grid>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PART_ClayDropHost"
                        Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type clay:ClayStatusPill}">
        <Setter Property="Template"
                Value="{StaticResource ClayStatusPillTemplate}" />
        <Setter Property="ClayMinHeight" Value="28" />
        <Setter Property="Padding" Value="14,0" />
        <!-- Pills are fully round, not 12px. The radius is tracked to
             half the measured height in code, because a pill is a
             stadium rather than a rounded rectangle. -->
        <Setter Property="FontSize"
                Value="{DynamicResource FontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{DynamicResource AccentForegroundBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

</ResourceDictionary>