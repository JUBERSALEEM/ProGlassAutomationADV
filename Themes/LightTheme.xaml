<!--
    FILE: Themes/LightTheme.xaml
    PROJECT: ProGlassAutomation
    VERSION: Chat 23 v1.6 — Add Dashboard glass/ambient keys

    CHANGES vs v1.3 (green→blue accents):
      • +DashAmbientBrush              (gradient, glass blue wash)
      • +DashAmbientBlob1Brush          (top-right blue radial)
      • +DashAmbientBlob2Brush          (bottom-left deep blue radial)
      • +DashGlassSurfaceBrush          (white @ 82% opacity)
      • +DashGlassBorderBrush           (white → soft blue border)
      • +DashAccentTextBrush            (rich blue text on glass)
      • +DashCardShadowEffect           (blue-tinted card shadow)
      • +DashInteractiveShadowEffect    (blue glow for buttons)
      • +DashSubtleShadowEffect         (subtle depth for list rows)

    All existing brush keys and values UNCHANGED.

    REGRESSION RISK: ZERO
      Pure additive. No existing key modified.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:conv="clr-namespace:ProGlassAutomation.Converters">

    <!-- ═══════════════════════════════════════════════════════════════
         LIGHT THEME — INDUSTRIAL STEEL / NAVY
    ═══════════════════════════════════════════════════════════════ -->

    <!-- ── Surfaces ─────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="WindowBackgroundBrush"
                     Color="#F1F5F9"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="ModuleBackgroundBrush"
                     Color="#FFFFFF"
                     po:Freeze="True"/>
    <Color x:Key="ModuleBackgroundColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="ElevatedSurfaceBrush"
                     Color="#F8FAFC"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="SideMenuBackgroundBrush"
                     Color="#FFFFFF"
                     po:Freeze="True"/>
    <Color x:Key="SideMenuBackgroundColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="MenuHoverBrush"
                     Color="#E2E8F0"
                     po:Freeze="True"/>
    <!-- Sidebar sub-menu / nested card surface. Brighter than the menu
         hover tint so the expandable groups read as clean white cards. -->
    <SolidColorBrush x:Key="SidebarCardBrush"
                     Color="#FFFFFF"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="OverlayButtonBackgroundBrush"
                     Color="#0369A1"
                     po:Freeze="True"/>

    <!-- ── About page glass palette (light) ───────────────────────────
         2026-08-25: companion to the dark Glass* palette in
         DarkTheme.xaml. Dark-ink text + strong blue accents so the
         About page stays readable on the light module surface; the
         frosted card is near-opaque white so it lifts against the
         white surface and still frosts over a wallpaper. The About
         module consumes these via DynamicResource, so Light/Dark
         swap, visual-family change and wallpaper layering all re-tint
         all three About sections live. -->
    <SolidColorBrush x:Key="GlassIce"
                     Color="#1E293B"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassFrost"
                     Color="#334155"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassCerulean"
                     Color="#1D4ED8"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassSnow"
                     Color="#0F172A"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassAccent"
                     Color="#2563EB"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassAccentDeep"
                     Color="#1D4ED8"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassMuted"
                     Color="#475569"
                     po:Freeze="True"/>
    <!-- Frosted card fill — TRUE white water glass (2026-08-29,
         transparency pass 2): translucent white, densest at the top
         where iOS light materials catch the light, thinning toward the
         bottom edge so the stage / wallpaper / blurred desktop reads
         through (alpha 0.86 → 0.74 → 0.62). Previously opaque
         #FFFFFFFF → #F1F5F9: solid white, no translucency — not glass. -->
    <LinearGradientBrush x:Key="GlassCard"
                         StartPoint="0,0" EndPoint="0,1"
                         po:Freeze="True">
        <GradientStop Color="#DBFFFFFF" Offset="0.0"/>
        <GradientStop Color="#BDFFFFFF" Offset="0.45"/>
        <GradientStop Color="#9EFFFFFF" Offset="1.0"/>
    </LinearGradientBrush>
    <!-- Top-light specular sheen: strong white highlight at the top
         corner fading out — the "water glass" catch-light. Previously
         #33FFFFFF, invisible on a white card. -->
    <LinearGradientBrush x:Key="GlassSheen"
                         StartPoint="0,0" EndPoint="1,1"
                         po:Freeze="True">
        <GradientStop Color="#8CFFFFFF" Offset="0.0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.45"/>
    </LinearGradientBrush>
    <!-- Decorative aurora orbs — boosted for the light stage so the
         blue glow actually reads through the white glass (previously
         ~20% alpha: invisible on the pale ice stage). -->
    <RadialGradientBrush x:Key="GlassOrbA"
                         Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5"
                         po:Freeze="True">
        <GradientStop Color="#6660A5FA" Offset="0.0"/>
        <GradientStop Color="#332563EB" Offset="0.55"/>
        <GradientStop Color="#002563EB" Offset="1.0"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="GlassOrbB"
                         Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5"
                         po:Freeze="True">
        <GradientStop Color="#7A3B82F6" Offset="0.0"/>
        <GradientStop Color="#3D2563EB" Offset="0.55"/>
        <GradientStop Color="#002563EB" Offset="1.0"/>
    </RadialGradientBrush>

    <!-- About interactive chrome tokens. ThemeManager rewrites these at
         runtime from the active accent; these defaults guarantee the
         About page still renders correctly before the dynamic engine runs. -->
    <SolidColorBrush x:Key="AboutInteractiveBrush"
                     Color="#F4F8FF"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="AboutInteractiveHoverBrush"
                     Color="#EAF2FF"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="AboutInteractiveBorderBrush"
                     Color="#93C5FD"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="AboutInteractiveBorderStrongBrush"
                     Color="#60A5FA"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="AboutCardBorderBrush"
                     Color="#D7E7FB"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="AboutDividerBrush"
                     Color="#DCEAFB"
                     po:Freeze="True"/>

    <!-- ── Text ─────────────────────────────────────────────────────── -->
    <Color x:Key="PrimaryForegroundColor">#020617</Color>
    <Color x:Key="SecondaryForegroundColor">#475569</Color>
    <Color x:Key="MutedForegroundColor">#64748B</Color>
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="TintIndigoColor">#EEF2FF</Color>
    <Color x:Key="TintRedColor">#FEF2F2</Color>
    <Color x:Key="TintGreenColor">#EFF6FF</Color>
    <Color x:Key="TintAmberColor">#FFFBEB</Color>
    <Color x:Key="TintPurpleColor">#F5F3FF</Color>
    <Color x:Key="TintGrayColor">#F9FAFB</Color>
    <Color x:Key="BorderColor">#E5E7EB</Color>
    <SolidColorBrush x:Key="PrimaryForegroundBrush"
                     Color="#020617"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush"
                     Color="#475569"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="MutedForegroundBrush"
                     Color="#64748B"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="OnAccentForegroundBrush"
                     Color="#FFFFFF"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="OverlayButtonForegroundBrush"
                     Color="#FFFFFF"
                     po:Freeze="True"/>

    <!-- ── Brand accents — industrial steel cyan ───────────────────── -->
    <SolidColorBrush x:Key="AccentBrush"
                     Color="#0369A1"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentHoverBrush"
                     Color="#0284C7"
                     po:Freeze="True"/>
    <!-- Color-typed counterparts of the accent brushes. These exist so
         Color-only properties (gradient stops, DropShadowEffect.Color)
         can follow the accent instead of hardcoding it. ThemeManager
         re-derives and re-publishes AccentColor on every accent/light-dark
         change so it tracks custom and Monet accents too. -->
    <Color x:Key="AccentColor">#0369A1</Color>
    <Color x:Key="AccentHoverColor">#0284C7</Color>
    <Color x:Key="AccentDarkColor">#0C4A6E</Color>
    <Color x:Key="AccentLightColor">#38BDF8</Color>
    <SolidColorBrush x:Key="AccentDarkBrush"
                     Color="#0C4A6E"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentLightBrush"
                     Color="#38BDF8"
                     po:Freeze="True"/>

    <!-- ── Semantic (unchanged — green success is universal) ──────── -->
    <SolidColorBrush x:Key="SuccessBrush"
                     Color="#059669"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="WarningBrush"
                     Color="#D97706"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerBrush"
                     Color="#DC2626"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="InfoBrush"
                     Color="#0369A1"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="NeutralBrush"
                     Color="#6B7280"
                     po:Freeze="True"/>

    <!-- ── Tinted card backgrounds ─────────────────────────────────── -->
    <SolidColorBrush x:Key="TintIndigoBrush"
                     Color="#EEF2FF"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="TintGreenBrush"
                     Color="#EFF6FF"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="TintAmberBrush"
                     Color="#FFFBEB"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="TintBlueBrush"
                     Color="#EFF6FF"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="TintRedBrush"
                     Color="#FEF2F2"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="TintGrayBrush"
                     Color="#F9FAFB"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="TintPurpleBrush"
                     Color="#F5F3FF"
                     po:Freeze="True"/>

    <!-- ── Borders + dividers ──────────────────────────────────────── -->
    <SolidColorBrush x:Key="BorderBrush"
                     Color="#CBD5E1"
                     po:Freeze="True"/>

    <!-- OUTLINE — the definition edge for rounded pills and cards.
         Deliberately a SEPARATE key from BorderBrush: BorderBrush is also
         used by text inputs, dividers and table gridlines, and darkening
         those globally would make every field look heavy. This one applies
         only to pill buttons and card shapes, which is where an element
         needs to stay visually separate from a tinted (Monet) surface.
         Overridden at runtime by ThemeManager.ApplyOutline. -->
    <SolidColorBrush x:Key="OutlineBrush"
                     Color="#64748B"
                     po:Freeze="True"/>

    <!-- The "defined" variant the Appearance toggle switches to: a near-black
         ink, not pure #000, which reads as a deliberate edge rather than a
         harsh line on white. -->
    <!-- Immutable copy of the subtle default. ApplyOutline overwrites
         OutlineBrush at runtime, so it needs a pristine source to restore
         from when the toggle is switched back off. -->
    <SolidColorBrush x:Key="OutlineDefaultBrush"
                     Color="#94A3B8"
                     po:Freeze="True"/>

    <SolidColorBrush x:Key="OutlineStrongBrush"
                     Color="#111827"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="DividerBrush"
                     Color="#E5E7EB"
                     po:Freeze="True"/>

    <!-- ═══════════════════════════════════════════════════════════════
         DASHBOARD GLASSMORPHISM (NEW in v1.6)
         Prefix "Dash" scopes these to dashboard views.
         Referenced by dashboard XAML via DynamicResource so light↔dark
         theme swap flips the entire glass palette instantly.
    ═══════════════════════════════════════════════════════════════ -->

    <!-- Dashboard ambient background — pale glass blue wash. -->
    <LinearGradientBrush x:Key="DashAmbientBrush"
                         StartPoint="0,0" EndPoint="1,1"
                         po:Freeze="True">
        <GradientStop Color="#F5F9FF" Offset="0.0"/>
        <GradientStop Color="#E0EDFF" Offset="0.5"/>
        <GradientStop Color="#DBEAFE" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Bold blue brand gradient for dashboard hero cards / high-emphasis
         visuals (the "modern app" accent). Light theme: deep -> bright blue. -->
    <LinearGradientBrush x:Key="DashHeroBlueBrush"
                         StartPoint="0,0" EndPoint="1,1"
                         po:Freeze="True">
        <GradientStop Color="#0369A1" Offset="0.0"/>
        <GradientStop Color="#0EA5E9" Offset="0.6"/>
        <GradientStop Color="#38BDF8" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Top-right accent blob — 22% alpha blue glow. -->
    <RadialGradientBrush x:Key="DashAmbientBlob1Brush"
                         Center="0.85,0.15"
                         GradientOrigin="0.85,0.15"
                         RadiusX="0.35" RadiusY="0.35"
                         po:Freeze="True">
        <GradientStop Color="#3B82F638" Offset="0.0"/>
        <GradientStop Color="#3B82F600" Offset="1.0"/>
    </RadialGradientBrush>

    <!-- Bottom-left accent blob — 13% alpha deep blue. -->
    <RadialGradientBrush x:Key="DashAmbientBlob2Brush"
                         Center="0.12,0.88"
                         GradientOrigin="0.12,0.88"
                         RadiusX="0.30" RadiusY="0.30"
                         po:Freeze="True">
        <GradientStop Color="#1D4ED820" Offset="0.0"/>
        <GradientStop Color="#1D4ED800" Offset="1.0"/>
    </RadialGradientBrush>

    <!-- Glass card fill — white at 82% opacity. -->
    <SolidColorBrush x:Key="DashGlassSurfaceBrush"
                     Color="#FFFFFF"
                     Opacity="0.82"
                     po:Freeze="True"/>

    <!-- Glass card border sheen — white → soft blue diagonal. -->
    <LinearGradientBrush x:Key="DashGlassBorderBrush"
                         StartPoint="0,0" EndPoint="1,1"
                         po:Freeze="True">
        <GradientStop Color="#FFFFFF" Offset="0.0"/>
        <GradientStop Color="#DBEAFE" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Accent text on glass surfaces — rich blue. -->
    <SolidColorBrush x:Key="DashAccentTextBrush"
                     Color="#1D4ED8"
                     po:Freeze="True"/>

    <!-- Card shadow — cool blue tint for depth. -->
    <DropShadowEffect x:Key="DashCardShadowEffect"
                      BlurRadius="24"
                      ShadowDepth="6"
                      Opacity="0.11"
                      Color="#1E3A8A"
                      Direction="270"
                      po:Freeze="True"/>

    <!-- Interactive shadow — blue glow for buttons. -->
    <DropShadowEffect x:Key="DashInteractiveShadowEffect"
                      BlurRadius="12"
                      ShadowDepth="3"
                      Opacity="0.16"
                      Color="#3B82F6"
                      Direction="270"
                      po:Freeze="True"/>

    <!-- Subtle shadow — for list rows and minor elevations. -->
    <DropShadowEffect x:Key="DashSubtleShadowEffect"
                      BlurRadius="8"
                      ShadowDepth="2"
                      Opacity="0.08"
                      Color="#1E3A8A"
                      Direction="270"
                      po:Freeze="True"/>

    <!-- ═══════════════════════════════════════════════════════════════
         CARD SHAPE + MOTION TOKENS (additive — Dynamic Theme Engine)
         Card geometry and motion timings live here as single tokens so
         every section reads the same smooth, consistent shapes. The
         PerformanceProfileService overrides MotionDuration* at runtime
         with values scaled to the detected refresh tier
         (60/90/120/144/165 fps).
    ═══════════════════════════════════════════════════════════════ -->

    <!-- Per-module wallpaper layer (set by VisualThemeEngine; stays
         transparent when the active module has no wallpaper). -->
    <SolidColorBrush x:Key="ModuleWallpaperBrush"
                     Color="Transparent"
                     po:Freeze="True"/>

    <!-- Card shapes — one source of truth for corner radii. -->
    <CornerRadius x:Key="ControlCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="CardCornerRadiusLarge">12</CornerRadius>

    <!-- Card border thickness — one source of truth for every card/panel
         edge. Driven by the Appearance > Border Thickness setting; cards
         reference this via {DynamicResource CardBorderThickness}. -->
    <Thickness x:Key="CardBorderThickness">1.5</Thickness>

    <!-- Display density — Compact defaults (laptop). ThemeManager overwrites. -->
    <sys:Double x:Key="DensityInputHeight">30</sys:Double>
    <sys:Double x:Key="DensityButtonHeight">32</sys:Double>
    <sys:Double x:Key="DensityRowHeight">28</sys:Double>
    <sys:Double x:Key="DensityTitleFontSize">18</sys:Double>
    <sys:Double x:Key="DensityKpiValueFontSize">16</sys:Double>
    <Thickness x:Key="DensityCardPadding">10,8</Thickness>
    <Thickness x:Key="DensityStripPadding">12,8</Thickness>
    <Thickness x:Key="DensityPageMargin">12,8</Thickness>

    <!-- Motion defaults (pre-profile values; tuned at startup). -->
    <sys:Double x:Key="MotionSpeedRatio">1.0</sys:Double>
    <Duration x:Key="MotionDurationFast">0:0:0.12</Duration>
    <Duration x:Key="MotionDurationNorm">0:0:0.22</Duration>
    <Duration x:Key="MotionDurationSlow">0:0:0.38</Duration>
    <sys:Boolean x:Key="RichEffectsEnabled">False</sys:Boolean>
    <sys:Boolean x:Key="UltraSmoothEnabled">False</sys:Boolean>
    <sys:Int32 x:Key="TargetFps">60</sys:Int32>

    <!-- ── BrushKeyConverter (unchanged) ──────────────────────────── -->
    <conv:BrushKeyConverter x:Key="BrushKeyConverter"/>

    <!-- ═══════════════════════════════════════════════════════════════
         LIQUID-GLASS SHELL CHROME (top bar · sidebar · dropdowns)
         Frosted white surfaces over the light stage; subtle dark hairline
         + soft shadow carry the depth.
    ═══════════════════════════════════════════════════════════════════ -->
    <LinearGradientBrush x:Key="ShellGlassBrush" StartPoint="0,0" EndPoint="0,1"
                         po:Freeze="True">
        <GradientStop Color="#F2FFFFFF" Offset="0.0"/>
        <GradientStop Color="#E6FFFFFF" Offset="0.5"/>
        <GradientStop Color="#D9FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ShellGlassBorderBrush" Color="#24000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="ShellSheenBrush" Color="#B3FFFFFF" po:Freeze="True"/>
    <RadialGradientBrush x:Key="AuroraA" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5"
                         po:Freeze="True">
        <GradientStop Color="#3338BDF8" Offset="0.0"/>
        <GradientStop Color="#0038BDF8" Offset="1.0"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AuroraB" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5"
                         po:Freeze="True">
        <GradientStop Color="#268183F4" Offset="0.0"/>
        <GradientStop Color="#008183F4" Offset="1.0"/>
    </RadialGradientBrush>

</ResourceDictionary>