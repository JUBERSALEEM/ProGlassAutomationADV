<!--
    FILE: Themes/LightTheme.xaml
    PROJECT: ProGlassAutomation
    VERSION: Phase 1 — Design System Foundation

    ARCHITECTURE:
      Section  1: Raw Colors              (Color tokens — no brushes)
      Section  2: Semantic Colors        (Accent, Status, Tint Color tokens)
      Section  3: Text Brushes           (Primary, Secondary, Muted, OnAccent)
      Section  4: Surface Brushes        (Module, Elevated, Sidebar, Menu surfaces)
      Section  5: Liquid Glass Surfaces  (Ultra-transparent glass fill brushes)
      Section  6: Glass Variants         (UltraClear, Crystal, Water, Frosted)
      Section  7: Glass Edge Borders     (Crystal edge gradient brushes)
      Section  8: Glass Highlights       (Specular, Reflection, Refraction)
      Section  9: Liquid Composition     (LiquidCard, LiquidSheen, LiquidOrb, etc.)
      Section 10: Border & Outline Brushes
      Section 11: Shadow Effects         (Ambient, Contact, Active, Panel)
      Section 12: Gradient Brushes       (Window background, Backdrops, Aurora)
      Section 13: Density Tokens         (Spacing, Sizing)
      Section 14: Motion Tokens          (Duration, Easing, Speed)
      Section 15: Geometry Tokens        (CornerRadius, Thickness)
      Section 16: Switch/Toggle Colors
      Section 17: Dashboard Tokens
      Section 18: About Page Tokens
      Section 19: Shell Tokens
      Section 20: Converters
      Section 21: Feature Flags

    PRESERVED: All 160 existing keys with identical values.
    ADDED:     15 new liquid glass system tokens.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:conv="clr-namespace:ProGlassAutomation.Converters">


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 1 — RAW COLORS
         Base Color values used by semantic brushes below.
    ═══════════════════════════════════════════════════════════════ -->
    <Color x:Key="PrimaryForegroundColor">#020617</Color>
    <Color x:Key="SecondaryForegroundColor">#475569</Color>
    <Color x:Key="MutedForegroundColor">#64748B</Color>
    <Color x:Key="BorderColor">#E5E7EB</Color>
    <Color x:Key="ModuleBackgroundColor">#FFFFFF</Color>
    <Color x:Key="SideMenuBackgroundColor">#FFFFFF</Color>
    <Color x:Key="TextPrimaryColor">#1D1D1F</Color>
    <Color x:Key="TextSecondaryColor">#8C1E2832</Color>
    <Color x:Key="LiquidShadowColor">#4D0B1B2E</Color>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 2 — SEMANTIC COLORS
         Accent, Status, and Tint color tokens.
    ═══════════════════════════════════════════════════════════════ -->
    <Color x:Key="AccentColor">#0369A1</Color>
    <Color x:Key="AccentHoverColor">#0284C7</Color>
    <Color x:Key="AccentDarkColor">#075985</Color>
    <Color x:Key="AccentLightColor">#38BDF8</Color>
    <Color x:Key="AccentBlueColor">#28BEFF</Color>
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DangerColor">#EF4444</Color>

    <!-- Tint palette -->
    <Color x:Key="TintIndigoColor">#EEF2FF</Color>
    <Color x:Key="TintRedColor">#FEF2F2</Color>
    <Color x:Key="TintGreenColor">#EFF6FF</Color>
    <Color x:Key="TintAmberColor">#FFFBEB</Color>
    <Color x:Key="TintPurpleColor">#F5F3FF</Color>
    <Color x:Key="TintGrayColor">#F9FAFB</Color>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 3 — TEXT BRUSHES
    ═══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="{StaticResource PrimaryForegroundColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="{StaticResource SecondaryForegroundColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="{StaticResource MutedForegroundColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="OnAccentForegroundBrush" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="OnAccentSecondaryForegroundBrush" Color="#CCFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" po:Freeze="True"/>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 4 — SURFACE BRUSHES
         Module, Elevated, Sidebar, Menu, Overlay surfaces.
    ═══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="ModuleBackgroundBrush" Color="#00FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ModuleWallpaperBrush" Color="Transparent" po:Freeze="True"/>
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#10FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="SideMenuBackgroundBrush" Color="#08FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="SidebarCardBrush" Color="#10FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#185FCDFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="OverlayButtonBackgroundBrush" Color="#0369A1" po:Freeze="True"/>
    <SolidColorBrush x:Key="OverlayButtonForegroundBrush" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidOverlayBrush" Color="#59061724" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidDialogVeilBrush" Color="#3D1E2832" po:Freeze="True"/>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 5 — LIQUID GLASS SURFACE BRUSHES
         Ultra-transparent glass fill brushes. These are the BASE
         glass surfaces used by all control templates.
    ═══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="GlassSurfaceUltra" Color="#08FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassSurfaceBrush" Color="#0CFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassSurfaceStandard" Color="#0CFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassSurfaceElevated" Color="#14FFFFFF" po:Freeze="True"/>

    <!-- Layered glass fill — watery meniscus ramp -->
    <LinearGradientBrush x:Key="LiquidGlassBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#D9FFFFFF" Offset="0.0"/>
        <GradientStop Color="#C4FFFFFF" Offset="0.07"/>
        <GradientStop Color="#F2FFFFFF" Offset="0.16"/>
        <GradientStop Color="#B3FFFFFF" Offset="0.45"/>
        <GradientStop Color="#87FFFFFF" Offset="0.80"/>
        <GradientStop Color="#80FFFFFF" Offset="0.93"/>
        <GradientStop Color="#8CFFFFFF" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LiquidGlassSubtleBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#59FFFFFF" Offset="0.0"/>
        <GradientStop Color="#4DFFFFFF" Offset="0.10"/>
        <GradientStop Color="#6EFFFFFF" Offset="0.22"/>
        <GradientStop Color="#33FFFFFF" Offset="0.60"/>
        <GradientStop Color="#40FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LiquidGlassStrongBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#F2FFFFFF" Offset="0.0"/>
        <GradientStop Color="#E6FFFFFF" Offset="0.07"/>
        <GradientStop Color="#FAFFFFFF" Offset="0.16"/>
        <GradientStop Color="#D6FFFFFF" Offset="0.50"/>
        <GradientStop Color="#BFFFFFFF" Offset="0.90"/>
        <GradientStop Color="#C9FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 6 — GLASS VARIANT BRUSHES  ★ NEW ★
         Semantic glass variants for different UI contexts.
    ═══════════════════════════════════════════════════════════════ -->

    <!-- UltraClear: Almost invisible glass with crystal edges.
         Use for: decorative panels, secondary containers. -->
    <LinearGradientBrush x:Key="LiquidGlassUltraClearBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#0AFFFFFF" Offset="0.0"/>
        <GradientStop Color="#06FFFFFF" Offset="0.5"/>
        <GradientStop Color="#0DFFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Crystal: Higher reflection, stronger edge definition.
         Use for: primary cards, hero panels, featured content. -->
    <LinearGradientBrush x:Key="LiquidGlassCrystalBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#E0FFFFFF" Offset="0.0"/>
        <GradientStop Color="#C0FFFFFF" Offset="0.08"/>
        <GradientStop Color="#E8FFFFFF" Offset="0.15"/>
        <GradientStop Color="#A0FFFFFF" Offset="0.50"/>
        <GradientStop Color="#80FFFFFF" Offset="0.85"/>
        <GradientStop Color="#90FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- WaterGlass: Subtle liquid blue refraction depth.
         Use for: interactive panels, active sections, data cards. -->
    <LinearGradientBrush x:Key="LiquidGlassWaterBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#1AE8F4FD" Offset="0.0"/>
        <GradientStop Color="#0DFFFFFF" Offset="0.15"/>
        <GradientStop Color="#14D7EEFB" Offset="0.50"/>
        <GradientStop Color="#0AFFFFFF" Offset="0.85"/>
        <GradientStop Color="#1AE0F2FE" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Frosted: Higher opacity for readability over busy backgrounds.
         Use for: dialogs, popovers, forms, DataGrid headers. -->
    <LinearGradientBrush x:Key="LiquidGlassFrostedBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#E8FFFFFF" Offset="0.0"/>
        <GradientStop Color="#D6FFFFFF" Offset="0.10"/>
        <GradientStop Color="#EDFFFFFF" Offset="0.20"/>
        <GradientStop Color="#C8FFFFFF" Offset="0.55"/>
        <GradientStop Color="#BFFFFFFF" Offset="0.90"/>
        <GradientStop Color="#CCFFFFFF" Offset="1.0"/>
    </LinearGradientBrush>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 7 — GLASS EDGE BORDER BRUSHES  ★ NEW + EXISTING ★
         Crystal edge gradients — brighter top-left, darker bottom-right
         to simulate light refraction through glass edges.
    ═══════════════════════════════════════════════════════════════ -->

    <!-- Flat glass borders (existing) -->
    <SolidColorBrush x:Key="GlassBorderPrimary" Color="#33FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassBorderBright" Color="#4DFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassBorderSoft" Color="#1AFFFFFF" po:Freeze="True"/>

    <!-- Crystal edge: bright top fading to soft sides and deeper bottom.
         Use as BorderBrush on glass cards/panels. -->
    <LinearGradientBrush x:Key="LiquidEdgeBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
        <GradientStop Color="#59B9D1EE" Offset="0.5"/>
        <GradientStop Color="#73A9C4DE" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Top crystal edge: very bright horizontal line at the top of glass. -->
    <LinearGradientBrush x:Key="LiquidGlassEdgeTopBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#E0FFFFFF" Offset="0.0"/>
        <GradientStop Color="#FFFFFFFF" Offset="0.3"/>
        <GradientStop Color="#C0FFFFFF" Offset="0.7"/>
        <GradientStop Color="#90FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Bottom refraction edge: subtle color shift at the bottom. -->
    <LinearGradientBrush x:Key="LiquidGlassEdgeBottomBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#40B9D1EE" Offset="0.0"/>
        <GradientStop Color="#30A0BDD4" Offset="0.5"/>
        <GradientStop Color="#2090ADCA" Offset="1.0"/>
    </LinearGradientBrush>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 8 — GLASS HIGHLIGHT & REFLECTION BRUSHES  ★ NEW ★
         Internal specular highlights, reflections, and refractions
         that give glass its depth and realism.
    ═══════════════════════════════════════════════════════════════ -->

    <!-- Specular highlight: bright spot near top-left corner.
         Overlay on glass surface as an inner Border or OpacityMask. -->
    <RadialGradientBrush x:Key="LiquidGlassSpecularBrush"
                         Center="0.15,0.1" RadiusX="0.6" RadiusY="0.4"
                         po:Freeze="True">
        <GradientStop Color="#50FFFFFF" Offset="0.0"/>
        <GradientStop Color="#18FFFFFF" Offset="0.5"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </RadialGradientBrush>

    <!-- Reflection gradient: diagonal light sweep across the surface. -->
    <LinearGradientBrush x:Key="LiquidGlassReflectionBrush" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#40FFFFFF" Offset="0.0"/>
        <GradientStop Color="#10FFFFFF" Offset="0.3"/>
        <GradientStop Color="#00FFFFFF" Offset="0.6"/>
    </LinearGradientBrush>
    <!-- Legacy alias (existing) -->
    <LinearGradientBrush x:Key="LiquidReflectionBrush" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#59FFFFFF" Offset="0.0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.45"/>
    </LinearGradientBrush>

    <!-- Refraction: subtle color-shifted gradient at the bottom edge
         simulating light bending through the glass thickness. -->
    <LinearGradientBrush x:Key="LiquidGlassRefractionBrush" StartPoint="0,1" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#00FFFFFF" Offset="0.0"/>
        <GradientStop Color="#0DD7EEFB" Offset="0.4"/>
        <GradientStop Color="#18BAE6FC" Offset="0.7"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Inner highlight: horizontal light band across the middle. -->
    <LinearGradientBrush x:Key="LiquidInnerHighlightBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#00FFFFFF" Offset="0.0"/>
        <GradientStop Color="#B3FFFFFF" Offset="0.5"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Top reflection (existing — used in switch thumbs). -->
    <LinearGradientBrush x:Key="GlassTopReflection" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#BFFFFFFF" Offset="0.0"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Sheen: diagonal highlight overlay. -->
    <LinearGradientBrush x:Key="LiquidSheen" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#8CFFFFFF" Offset="0.0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.45"/>
    </LinearGradientBrush>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 9 — LIQUID COMPOSITION BRUSHES
         Existing Liquid* brushes for cards, orbs, selection, buttons.
    ═══════════════════════════════════════════════════════════════ -->
    <LinearGradientBrush x:Key="LiquidCard" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#DBFFFFFF" Offset="0.0"/>
        <GradientStop Color="#C6FFFFFF" Offset="0.06"/>
        <GradientStop Color="#F0FFFFFF" Offset="0.16"/>
        <GradientStop Color="#BDFFFFFF" Offset="0.45"/>
        <GradientStop Color="#A8FFFFFF" Offset="0.75"/>
        <GradientStop Color="#9EFFFFFF" Offset="0.93"/>
        <GradientStop Color="#A8FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="LiquidOrbA" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" po:Freeze="True">
        <GradientStop Color="#6660A5FA" Offset="0.0"/>
        <GradientStop Color="#332563EB" Offset="0.55"/>
        <GradientStop Color="#002563EB" Offset="1.0"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="LiquidOrbB" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" po:Freeze="True">
        <GradientStop Color="#7A3B82F6" Offset="0.0"/>
        <GradientStop Color="#3D2563EB" Offset="0.55"/>
        <GradientStop Color="#002563EB" Offset="1.0"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="LiquidControlHoverBrush" Color="#99FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidControlPressedBrush" Color="#B3FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidControlDisabledBrush" Color="#59FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidFocusBrush" Color="#B33B82F6" po:Freeze="True"/>
    <LinearGradientBrush x:Key="LiquidSelectionBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#663B82F6" Offset="0.0"/>
        <GradientStop Color="#403B82F6" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LiquidPrimaryButtonBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#E8368CF5" Offset="0.0"/>
        <GradientStop Color="#A62F7DE6" Offset="1.0"/>
    </LinearGradientBrush>
    <!-- About page liquid palette -->
    <SolidColorBrush x:Key="LiquidIce" Color="#1E293B" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidFrost" Color="#334155" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidCerulean" Color="#1D4ED8" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidSnow" Color="#0F172A" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidAccent" Color="#2563EB" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidAccentDeep" Color="#1D4ED8" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidMuted" Color="#475569" po:Freeze="True"/>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 10 — BORDER & OUTLINE BRUSHES
    ═══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#E5E7EB" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="#CBD5E1" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineDefaultBrush" Color="#CBD5E1" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineStrongBrush" Color="#94A3B8" po:Freeze="True"/>

    <!-- Semantic status brushes -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerLightBrush" Color="#FCA5A5" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#33DC2626" po:Freeze="True"/>
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#22F59E0B" po:Freeze="True"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#0EA5E9" po:Freeze="True"/>
    <SolidColorBrush x:Key="NeutralBrush" Color="#94A3B8" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassDangerBrush" Color="#B91C1C" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassDangerBorderBrush" Color="#E2B91C1C" po:Freeze="True"/>

    <!-- Accent brushes -->
        <SolidColorBrush x:Key="LiquidBlueBrush" Color="#5FCDFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidBlueSurfaceBrush" Color="#145FCDFF" po:Freeze="True"/>
    <Color x:Key="LiquidBlueColor">#5FCDFF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}" po:Freeze="True"/>

    <!-- Tint brushes -->
    <SolidColorBrush x:Key="TintIndigoBrush" Color="{StaticResource TintIndigoColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TintRedBrush" Color="{StaticResource TintRedColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TintGreenBrush" Color="{StaticResource TintGreenColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TintAmberBrush" Color="{StaticResource TintAmberColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TintPurpleBrush" Color="{StaticResource TintPurpleColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TintGrayBrush" Color="#0FFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="TintBlueBrush" Color="#EFF6FF" po:Freeze="True"/>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 11 — SHADOW EFFECTS
         Ambient (soft, large) + Contact (sharp, small) + Active (glow).
    ═══════════════════════════════════════════════════════════════ -->
    <!-- Ambient shadows — soft, large, low opacity -->
    
    <!-- ═══ Phase 1 Consolidated Shadow Tokens ═══ -->
    <DropShadowEffect x:Key="ShadowSoft" Color="#3C78A0" Opacity="0.04" BlurRadius="8" ShadowDepth="2" Direction="270" po:Freeze="True"/>
    <DropShadowEffect x:Key="ShadowElevated" Color="#3C78A0" Opacity="0.08" BlurRadius="16" ShadowDepth="4" Direction="270" po:Freeze="True"/>
    <DropShadowEffect x:Key="ShadowDeep" Color="#1E293B" Opacity="0.12" BlurRadius="24" ShadowDepth="8" Direction="270" po:Freeze="True"/>

    <DropShadowEffect x:Key="GlassShadowSoft" Color="#3C78A0" Opacity="0.04" BlurRadius="8" ShadowDepth="2" Direction="270"/>
    <DropShadowEffect x:Key="GlassShadowSoftBorder" Color="#3C78A0" Opacity="0.04" BlurRadius="8" ShadowDepth="2" Direction="270"/>
    <DropShadowEffect x:Key="GlassShadowSoftButton" Color="#3C78A0" Opacity="0.04" BlurRadius="8" ShadowDepth="2" Direction="270"/>
    <DropShadowEffect x:Key="GlassShadowSoftCheckBox" Color="#3C78A0" Opacity="0.04" BlurRadius="8" ShadowDepth="2" Direction="270"/>
    <DropShadowEffect x:Key="GlassShadowSoftTextBox" Color="#3C78A0" Opacity="0.04" BlurRadius="8" ShadowDepth="2" Direction="270"/>
    <DropShadowEffect x:Key="GlassShadowSoftToggle" Color="#3C78A0" Opacity="0.04" BlurRadius="8" ShadowDepth="2" Direction="270"/>

    <!-- Panel shadows — medium, for large containers -->
    <DropShadowEffect x:Key="GlassShadowPanel" Color="#3C78A0" Opacity="0.06" BlurRadius="12" ShadowDepth="4" Direction="270"/>
    <DropShadowEffect x:Key="GlassShadowPanelBorder" Color="#3C78A0" Opacity="0.06" BlurRadius="12" ShadowDepth="4" Direction="270"/>

    <!-- Active shadows — glow for focused/pressed state -->
    <DropShadowEffect x:Key="GlassShadowActive" Color="#32B4FF" Opacity="0.08" BlurRadius="10" ShadowDepth="3" Direction="270"/>
    <DropShadowEffect x:Key="GlassShadowActiveButton" Color="#32B4FF" Opacity="0.08" BlurRadius="10" ShadowDepth="3" Direction="270"/>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 12 — GRADIENT BRUSHES
         Window background, Backdrops, Aurora orbs, App background.
    ═══════════════════════════════════════════════════════════════ -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="0.8,1">
        <GradientStop Color="#D7F0FF" Offset="0.0"/>
        <GradientStop Color="#E8F6FF" Offset="0.3"/>
        <GradientStop Color="#FFFFFF" Offset="0.55"/>
        <GradientStop Color="#EAF4FF" Offset="0.8"/>
        <GradientStop Color="#DCEEFA" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassBackdropBrush" StartPoint="0,0.2" EndPoint="1,0.8">
        <GradientStop Color="#085FCDFF" Offset="0"/>
        <GradientStop Color="#04FFFFFF" Offset="0.5"/>
        <GradientStop Color="#065FCDFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#D7F0FF" Offset="0.0"/>
        <GradientStop Color="#FFFFFF" Offset="0.5"/>
        <GradientStop Color="#DCEEFA" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassGradientIdle" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#28FFFFFF" Offset="0.0"/>
        <GradientStop Color="#05FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassGradientActive" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#B728BEFF" Offset="0.0"/>
