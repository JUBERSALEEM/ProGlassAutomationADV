<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════
         LIGHT THEME — Green accent (matches splash logo + dashboard hero)
         Full palette: surfaces, text, semantic accents, tinted cards.
    ═══════════════════════════════════════════════════════════════ -->

    <!-- ── Surfaces ─────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="WindowBackgroundBrush"    Color="#F9FAFB"/>
    <SolidColorBrush x:Key="ModuleBackgroundBrush"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ElevatedSurfaceBrush"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SideMenuBackgroundBrush"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MenuHoverBrush"           Color="#F3F4F6"/>
    <SolidColorBrush x:Key="OverlayButtonBackgroundBrush" Color="#0F4C3A"/>

    <!-- ── Text ─────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="PrimaryForegroundBrush"   Color="#0F172A"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="MutedForegroundBrush"     Color="#9CA3AF"/>
    <SolidColorBrush x:Key="OnAccentForegroundBrush"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OverlayButtonForegroundBrush" Color="#FFFFFF"/>

    <!-- ── Accents (green family) ───────────────────────────────────── -->
    <SolidColorBrush x:Key="AccentBrush"      Color="#0F4C3A"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="AccentDarkBrush"  Color="#0F4C3A"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#22C55E"/>

    <!-- ── Semantic ────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="DangerBrush"  Color="#EF4444"/>
    <SolidColorBrush x:Key="InfoBrush"    Color="#3B82F6"/>
    <SolidColorBrush x:Key="NeutralBrush" Color="#6B7280"/>

    <!-- ── Tinted card backgrounds (Tailwind 50-level pastels) ─────── -->
    <SolidColorBrush x:Key="TintIndigoBrush" Color="#EEF2FF"/>
    <SolidColorBrush x:Key="TintGreenBrush"  Color="#F0FDF4"/>
    <SolidColorBrush x:Key="TintAmberBrush"  Color="#FFFBEB"/>
    <SolidColorBrush x:Key="TintBlueBrush"   Color="#EFF6FF"/>
    <SolidColorBrush x:Key="TintRedBrush"    Color="#FEF2F2"/>
    <SolidColorBrush x:Key="TintGrayBrush"   Color="#F9FAFB"/>
    <SolidColorBrush x:Key="TintPurpleBrush" Color="#F5F3FF"/>

    <!-- ── Borders + dividers ──────────────────────────────────────── -->
    <SolidColorBrush x:Key="BorderBrush"  Color="#E5E7EB"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#E5E7EB"/>

</ResourceDictionary>