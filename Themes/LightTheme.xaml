    <!-- ═══ SETTINGS — CRYSTAL LIQUID SURFACE (2026-09-17) ═══════════════
         Owner directive: "Generate the new mockup with crystal liquid ios 26
         theme type", after "design is still same / cards are too close".

         ROOT CAUSE of that report: the first approved sheet set specified a
         FLAT card — #CCFFFFFF, a 1 px #E2E8F0 hairline, a 10 % grey shadow —
         and the module implemented that specification exactly. The module was
         faithful; the specification was flat. These four keys are the
         replacement specification (target sheet:
         docs/mockups/settings-redesign-v2/01-crystal-kit.png).

         Ios26CardBrush / Ios26CardBorderBrush are deliberately NOT touched:
         they are the About reference design and its locks pin them (see
         Tests/Theme/AppStageAuditTests). Settings composes its own four
         layers instead, in the same theme dictionaries, so the module still
         follows Light/Dark with no code-behind.

           face    L2 base tint + L3 specular rim + L4 sheen + L5 refraction
           edge    L1 tri-stop gradient stroke (crystal, not a hairline)
           inner   the panel INSIDE a card — translucent, so it reads as part
                   of the glass instead of a flat white sticker
           shadow  L0 tinted, wider, softer
         ═══════════════════════════════════════════════════════════════ -->

    <!-- L2 + L3 + L4 + L5 in one brush: a DrawingBrush scales with the card,
         so a 60 px action bar and a 900 px hero card get the same rim. -->
    <DrawingBrush x:Key="SettingsCardFaceBrush"
                  Stretch="Fill"
                  Viewbox="0,0,1,1" ViewboxUnits="Absolute"
                  Viewport="0,0,1,1" ViewportUnits="RelativeToBoundingBox"
                  po:Freeze="True">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <!-- L2 · frosted base: 72 % → 38 % white over the live stage. -->
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,1,1"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#B8FFFFFF" Offset="0"/>
                            <GradientStop Color="#61FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <!-- L3 · specular rim: bright top edge, gone by 20 % -->
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,1,0.20"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#E6FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <!-- L4 · reflection sweep: diagonal sheen across the top left -->
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,0.62,0.34"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1FFFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <!-- L5 · refraction lip: the last 10 % picks the light back up -->
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0.90,1,0.10"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Color="#5CFFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

