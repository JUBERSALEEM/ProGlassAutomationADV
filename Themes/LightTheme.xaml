<!--
    FILE: Themes/LightTheme.xaml
    PROJECT: ProGlassAutomation
    VERSION: Phase 1 — Design System Foundation

    ARCHITECTURE:
      Section  1: Raw Colors              (Color tokens — no brushes)
      Section  2: Semantic Colors        (Accent, Status, Tint Color tokens)
      Section  3: Text Brushes           (Primary, Secondary, Muted, OnAccent)
      Section  4: Surface Brushes        (Module, Elevated, Sidebar, Menu surfaces)
      Section  5: Liquid Glass Surfaces  (translucent glass fill brushes)
      Section  6: Glass Variants         (UltraClear, Crystal, Water, Frosted)
      Section  7: Glass Edge Borders     (Crystal edge gradient brushes)
      Section  8: Glass Highlights       (Specular, Reflection, Refraction)
      Section  9: Liquid Composition     (LiquidCard, LiquidSheen, LiquidOrb, etc.)
      Section 10: Border & Outline Brushes
      Section 11: Shadow Effects         (Ambient, Contact, Active, Panel)
      Section 12: Gradient Brushes       (Window background, Backdrops, Aurora)
      Section 13: Density Tokens         (Spacing, Sizing)
      Section 14: Motion Tokens          (Duration, Easing, Speed)
      Section 15: Geometry Tokens        (CornerRadius, Thickness)
      Section 16: Switch/Toggle Colors
      Section 17: Dashboard Tokens
      Section 18: About Page Tokens
      Section 19: Shell Tokens
      Section 20: Converters
      Section 21: Feature Flags

    PRESERVED: All 160 existing keys with identical values.
    ADDED:     15 new liquid glass system tokens.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:conv="clr-namespace:ProGlassAutomation.Converters">


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 1 — RAW COLORS
         Base Color values used by semantic brushes below.
    ═══════════════════════════════════════════════════════════════ -->
    <Color x:Key="PrimaryForegroundColor">#111827</Color>
    <Color x:Key="SecondaryForegroundColor">#475569</Color>
    <Color x:Key="MutedForegroundColor">#64748B</Color>
    <Color x:Key="BorderColor">#CBD5E1</Color>
    <Color x:Key="ModuleBackgroundColor">#F8FAFC</Color>
    <Color x:Key="SideMenuBackgroundColor">#F8FAFC</Color>
    <!-- Warm off-white — the Color counterpart of WindowBackgroundBrush's
         central stop. Consumed by the Splash (PageBg / SplashPlate) and the
         Login surface backdrop gradients, which need a Color (not a Brush).
         Was previously undefined, so those DynamicResource stops silently
         fell back to transparent and flattened both backdrops. -->
    <Color x:Key="WindowBackgroundColor">#FBF8F1</Color>
    <Color x:Key="TextPrimaryColor">#111827</Color>
    <Color x:Key="TextSecondaryColor">#99475569</Color>
    <Color x:Key="LiquidShadowColor">#331E293B</Color>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 2 — SEMANTIC COLORS
         Accent, Status, and Tint color tokens.
    ═══════════════════════════════════════════════════════════════ -->
    <Color x:Key="AccentColor">#0F6FA8</Color>
    <Color x:Key="AccentHoverColor">#1287C8</Color>
    <Color x:Key="AccentDarkColor">#0B5D89</Color>
    <Color x:Key="AccentLightColor">#47B6E8</Color>
    <Color x:Key="AccentBlueColor">#28BEFF</Color>
    <Color x:Key="SuccessColor">#059669</Color>
    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="DangerColor">#DC2626</Color>

    <!-- Tint palette -->
    <Color x:Key="TintIndigoColor">#EEF6FF</Color>
    <Color x:Key="TintRedColor">#FFF1F2</Color>
    <Color x:Key="TintGreenColor">#ECFDF3</Color>
    <Color x:Key="TintAmberColor">#FFF7E6</Color>
    <Color x:Key="TintPurpleColor">#F4F0FF</Color>
    <Color x:Key="TintGrayColor">#F1F5F9</Color>
    <Color x:Key="TintTealColor">#F0FDFA</Color>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 3 — TEXT BRUSHES
    ═══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="{StaticResource PrimaryForegroundColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="{StaticResource SecondaryForegroundColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="{StaticResource MutedForegroundColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="OnAccentForegroundBrush" Color="#F8FAFC" po:Freeze="True"/>
    <SolidColorBrush x:Key="OnAccentSecondaryForegroundBrush" Color="#CCFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" po:Freeze="True"/>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 4 — SURFACE BRUSHES
         Module, Elevated, Sidebar, Menu, Overlay surfaces.
    ═══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="ModuleBackgroundBrush" Color="#00FFFFFF" po:Freeze="True"/>

    <!-- ═══════════════════════════════════════════════════════════════
         POPUP SURFACE — must be OPAQUE.
         A <Popup> is a floating HWND: nothing in the app renders behind
         it, so a glass brush with alpha < FF shows the DESKTOP through
         the menu. ModuleBackgroundBrush is #00FFFFFF (alpha 00) and was
         being used for popup cards, which is why every context menu,
         autocomplete list and action popup rendered see-through.
         This is the frosted-white the glass brushes tint toward, but at
         full alpha so it can stand alone.
    ═══════════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="PopupSurfaceBrush" Color="#FFF8FAFC" po:Freeze="True"/>
    <!-- Opaque dialog card. A Window with AllowsTransparency has no app
         stage behind it, so ModuleBackgroundBrush (often alpha 00) shows
         the desktop through every modal. Always fully opaque. -->
    <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#FFFBF9F3" po:Freeze="True"/>
    <SolidColorBrush x:Key="DialogInsetBrush" Color="#FFF1EDE3" po:Freeze="True"/>
    <!-- 2026-09-05 dropdown contrast tokens: see DarkTheme note. 12% black
         tint over #F7F4EC is the light-theme hover lift; selected row uses
         AccentBrush + OnAccentForegroundBrush in BOTH themes. -->
    <SolidColorBrush x:Key="ComboBoxItemHoverBrush" Color="#140F172A" po:Freeze="True"/>
    <SolidColorBrush x:Key="ModuleWallpaperBrush" Color="Transparent" po:Freeze="True"/>
    <LinearGradientBrush x:Key="ElevatedSurfaceBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#90FFFCF5" Offset="0.00"/>
        <GradientStop Color="#50FFFCF5" Offset="0.01"/>
        <GradientStop Color="#70FFFCF5" Offset="0.04"/>
        <GradientStop Color="#60FFFCF5" Offset="0.08"/>
        <GradientStop Color="#55FFFCF5" Offset="0.20"/>
        <GradientStop Color="#4AFFFCF5" Offset="0.50"/>
        <GradientStop Color="#45FFFCF5" Offset="0.75"/>
        <GradientStop Color="#4AFFFCF5" Offset="0.92"/>
        <GradientStop Color="#58FFFCF5" Offset="1.00"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SideMenuBackgroundBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#80FFFCF5" Offset="0.00"/>
        <GradientStop Color="#48FFFCF5" Offset="0.02"/>
        <GradientStop Color="#60FFFCF5" Offset="0.06"/>
        <GradientStop Color="#50FFFCF5" Offset="0.12"/>
        <GradientStop Color="#48FFFCF5" Offset="0.30"/>
        <GradientStop Color="#40FFFCF5" Offset="0.60"/>
        <GradientStop Color="#3AFFFCF5" Offset="0.85"/>
        <GradientStop Color="#40FFFCF5" Offset="0.95"/>
        <GradientStop Color="#50FFFCF5" Offset="1.00"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SidebarCardBrush" Color="#66FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#155E6B7A" po:Freeze="True"/>
    <SolidColorBrush x:Key="OverlayButtonBackgroundBrush" Color="#0F6FA8" po:Freeze="True"/>
    <SolidColorBrush x:Key="OverlayButtonForegroundBrush" Color="#F8FAFC" po:Freeze="True"/>
    <Color x:Key="LiquidOverlayColor">#400F172A</Color>
    <SolidColorBrush x:Key="LiquidOverlayBrush" Color="{StaticResource LiquidOverlayColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidDialogVeilBrush" Color="#33111827" po:Freeze="True"/>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 5 — LIQUID GLASS SURFACE BRUSHES
         Ultra-transparent glass fill brushes. These are the BASE
         glass surfaces used by all control templates.
    ═══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="GlassSurfaceUltra" Color="#0EFFFFFF" po:Freeze="True"/>
    <LinearGradientBrush x:Key="GlassSurfaceBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#92FFFFFF" Offset="0.00"/>
        <GradientStop Color="#4AFFFFFF" Offset="0.01"/>
        <GradientStop Color="#6CFFFFFF" Offset="0.04"/>
        <GradientStop Color="#5AFFFFFF" Offset="0.08"/>
        <GradientStop Color="#52FFFFFF" Offset="0.20"/>
        <GradientStop Color="#4AFFFFFF" Offset="0.50"/>
        <GradientStop Color="#44FFFFFF" Offset="0.75"/>
        <GradientStop Color="#4AFFFFFF" Offset="0.92"/>
        <GradientStop Color="#5AFFFFFF" Offset="1.00"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassSurfaceStandard" Color="#17FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassSurfaceElevated" Color="#22FFFFFF" po:Freeze="True"/>

    <!-- Layered glass fill — watery meniscus ramp -->
    <LinearGradientBrush x:Key="LiquidGlassBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#E4FFFFFF" Offset="0.0"/>
        <GradientStop Color="#CEFFFFFF" Offset="0.07"/>
        <GradientStop Color="#F6FFFFFF" Offset="0.16"/>
        <GradientStop Color="#BCFFFFFF" Offset="0.45"/>
        <GradientStop Color="#92FFFFFF" Offset="0.80"/>
        <GradientStop Color="#88FFFFFF" Offset="0.93"/>
        <GradientStop Color="#96FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LiquidGlassSubtleBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#6EFFFFFF" Offset="0.00"/>
        <GradientStop Color="#42FFFFFF" Offset="0.01"/>
        <GradientStop Color="#52FFFFFF" Offset="0.04"/>
        <GradientStop Color="#42FFFFFF" Offset="0.10"/>
        <GradientStop Color="#42FFFFFF" Offset="0.30"/>
        <GradientStop Color="#30FFFFFF" Offset="0.70"/>
        <GradientStop Color="#42FFFFFF" Offset="0.95"/>
        <GradientStop Color="#42FFFFFF" Offset="1.00"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LiquidGlassStrongBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#F6FFFFFF" Offset="0.0"/>
        <GradientStop Color="#EEFFFFFF" Offset="0.07"/>
        <GradientStop Color="#FCFFFFFF" Offset="0.16"/>
        <GradientStop Color="#E0FFFFFF" Offset="0.50"/>
        <GradientStop Color="#CCFFFFFF" Offset="0.90"/>
        <GradientStop Color="#D6FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 6 — GLASS VARIANT BRUSHES  ★ NEW ★
         Semantic glass variants for different UI contexts.
    ═══════════════════════════════════════════════════════════════ -->

    <!-- UltraClear: Almost invisible glass with crystal edges.
         Use for: decorative panels, secondary containers. -->
    <LinearGradientBrush x:Key="LiquidGlassUltraClearBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#66FFFFFF" Offset="0.0"/>
        <GradientStop Color="#0AFFFFFF" Offset="0.5"/>
        <GradientStop Color="#12FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Crystal: Higher reflection, stronger edge definition.
         Use for: primary cards, hero panels, featured content. -->
    <LinearGradientBrush x:Key="LiquidGlassCrystalBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#ECFFFFFF" Offset="0.0"/>
        <GradientStop Color="#D0FFFFFF" Offset="0.08"/>
        <GradientStop Color="#F2FFFFFF" Offset="0.15"/>
        <GradientStop Color="#B4FFFFFF" Offset="0.50"/>
        <GradientStop Color="#94FFFFFF" Offset="0.85"/>
        <GradientStop Color="#A4FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- WaterGlass: Subtle liquid blue refraction depth.
         Use for: interactive panels, active sections, data cards. -->
    <LinearGradientBrush x:Key="LiquidGlassWaterBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#22FFFFFF" Offset="0.0"/>
        <GradientStop Color="#12FFFFFF" Offset="0.15"/>
        <GradientStop Color="#1CFFFFFF" Offset="0.50"/>
        <GradientStop Color="#0EFFFFFF" Offset="0.85"/>
        <GradientStop Color="#22FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Frosted: Higher opacity for readability over busy backgrounds.
         Use for: dialogs, popovers, forms, DataGrid headers. -->
    <LinearGradientBrush x:Key="LiquidGlassFrostedBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#F2FFFFFF" Offset="0.0"/>
        <GradientStop Color="#E4FFFFFF" Offset="0.10"/>
        <GradientStop Color="#F6FFFFFF" Offset="0.20"/>
        <GradientStop Color="#D6FFFFFF" Offset="0.55"/>
        <GradientStop Color="#CEFFFFFF" Offset="0.90"/>
        <GradientStop Color="#D8FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 7 — GLASS EDGE BORDER BRUSHES  ★ NEW + EXISTING ★
         Crystal edge gradients — brighter top-left, darker bottom-right
         to simulate light refraction through glass edges.
    ═══════════════════════════════════════════════════════════════ -->

    <!-- Flat glass borders (existing) -->
    <SolidColorBrush x:Key="GlassBorderPrimary" Color="#40FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassBorderBright" Color="#5CFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassBorderSoft" Color="#2EFFFFFF" po:Freeze="True"/>

    <!-- Crystal edge: bright top fading to soft sides and deeper bottom.
         Use as BorderBrush on glass cards/panels. -->
    <LinearGradientBrush x:Key="LiquidEdgeBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#F8FAFCFF" Offset="0.0"/>
        <GradientStop Color="#59B9D1EE" Offset="0.5"/>
        <GradientStop Color="#73A9C4DE" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Top crystal edge: very bright horizontal line at the top of glass. -->
    <LinearGradientBrush x:Key="LiquidGlassEdgeTopBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#E0FFFFFF" Offset="0.0"/>
        <GradientStop Color="#F8FAFCFF" Offset="0.3"/>
        <GradientStop Color="#C0FFFFFF" Offset="0.7"/>
        <GradientStop Color="#90FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Bottom refraction edge: subtle color shift at the bottom. -->
    <LinearGradientBrush x:Key="LiquidGlassEdgeBottomBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#40B9D1EE" Offset="0.0"/>
        <GradientStop Color="#30A0BDD4" Offset="0.5"/>
        <GradientStop Color="#2090ADCA" Offset="1.0"/>
    </LinearGradientBrush>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 8 — GLASS HIGHLIGHT & REFLECTION BRUSHES  ★ NEW ★
         Internal specular highlights, reflections, and refractions
         that give glass its depth and realism.
    ═══════════════════════════════════════════════════════════════ -->

    <!-- Specular highlight: bright spot near top-left corner.
         Overlay on glass surface as an inner Border or OpacityMask. -->
    <RadialGradientBrush x:Key="LiquidGlassSpecularBrush"
                         Center="0.15,0.1" RadiusX="0.6" RadiusY="0.4"
                         po:Freeze="True">
        <GradientStop Color="#50FFFFFF" Offset="0.0"/>
        <GradientStop Color="#18FFFFFF" Offset="0.5"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </RadialGradientBrush>

    <!-- Reflection gradient: diagonal light sweep across the surface. -->
    <LinearGradientBrush x:Key="LiquidGlassReflectionBrush" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#40FFFFFF" Offset="0.0"/>
        <GradientStop Color="#66FFFFFF" Offset="0.3"/>
        <GradientStop Color="#00FFFFFF" Offset="0.6"/>
    </LinearGradientBrush>
    <!-- Legacy alias (existing) -->
    <LinearGradientBrush x:Key="LiquidReflectionBrush" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#59FFFFFF" Offset="0.0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.45"/>
    </LinearGradientBrush>

    <!-- Refraction: subtle color-shifted gradient at the bottom edge
         simulating light bending through the glass thickness. -->
    <LinearGradientBrush x:Key="LiquidGlassRefractionBrush" StartPoint="0,1" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#00FFFFFF" Offset="0.0"/>
        <GradientStop Color="#0DD7EEFB" Offset="0.4"/>
        <GradientStop Color="#18BAE6FC" Offset="0.7"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Inner highlight: horizontal light band across the middle. -->
    <LinearGradientBrush x:Key="LiquidInnerHighlightBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#00FFFFFF" Offset="0.0"/>
        <GradientStop Color="#B3FFFFFF" Offset="0.5"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Top reflection (existing — used in switch thumbs). -->
    <LinearGradientBrush x:Key="GlassTopReflection" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#BFFFFFFF" Offset="0.0"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Sheen: diagonal highlight overlay. -->
    <LinearGradientBrush x:Key="LiquidSheen" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#30FFFFFF" Offset="0.0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.45"/>
    </LinearGradientBrush>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 9 — LIQUID COMPOSITION BRUSHES
         Existing Liquid* brushes for cards, orbs, selection, buttons.
    ═══════════════════════════════════════════════════════════════ -->
    <LinearGradientBrush x:Key="LiquidCard" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#8EFFFFFF" Offset="0.00"/>
        <GradientStop Color="#4AFFFFFF" Offset="0.01"/>
        <GradientStop Color="#6AFFFFFF" Offset="0.04"/>
        <GradientStop Color="#5AFFFFFF" Offset="0.08"/>
        <GradientStop Color="#52FFFFFF" Offset="0.20"/>
        <GradientStop Color="#4AFFFFFF" Offset="0.50"/>
        <GradientStop Color="#44FFFFFF" Offset="0.75"/>
        <GradientStop Color="#4AFFFFFF" Offset="0.92"/>
        <GradientStop Color="#5AFFFFFF" Offset="1.00"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="LiquidOrbA" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" po:Freeze="True">
        <GradientStop Color="#300369A1" Offset="0.0"/>
        <GradientStop Color="#18075985" Offset="0.55"/>
        <GradientStop Color="#00075985" Offset="1.0"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="LiquidOrbB" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" po:Freeze="True">
        <GradientStop Color="#2E38BDF8" Offset="0.0"/>
        <GradientStop Color="#180369A1" Offset="0.55"/>
        <GradientStop Color="#000369A1" Offset="1.0"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="LiquidControlHoverBrush" Color="#A6FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidControlPressedBrush" Color="#C0FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidControlDisabledBrush" Color="#66FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidFocusBrush" Color="#660369A1" po:Freeze="True"/>
    <LinearGradientBrush x:Key="LiquidSelectionBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#663B82F6" Offset="0.0"/>
        <GradientStop Color="#403B82F6" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LiquidPrimaryButtonBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#E8368CF5" Offset="0.0"/>
        <GradientStop Color="#A62F7DE6" Offset="1.0"/>
    </LinearGradientBrush>
    <!-- About page liquid palette -->
    <SolidColorBrush x:Key="LiquidIce" Color="#111827" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidFrost" Color="#475569" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidCerulean" Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="LiquidSnow" Color="#111827" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidAccent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="LiquidAccentDeep" Color="{StaticResource AccentDarkColor}"/>
    <!-- Glossy accent-gradient badge (About icon tiles = splash tile badges). -->
    <LinearGradientBrush x:Key="LiquidAccentGradient" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="{StaticResource AccentLightColor}" Offset="0.0"/>
        <GradientStop Color="{StaticResource AccentDarkColor}"  Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LiquidMuted" Color="#64748B" po:Freeze="True"/>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 10 — BORDER & OUTLINE BRUSHES
    ═══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#E2E8F0" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="#CBD5E1" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineDefaultBrush" Color="#CBD5E1" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineStrongBrush" Color="#94A3B8" po:Freeze="True"/>

    <!-- Semantic status brushes -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerLightBrush" Color="#FDA4AF" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#22E11D48" po:Freeze="True"/>
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#22F59E0B" po:Freeze="True"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#0EA5E9" po:Freeze="True"/>
    <SolidColorBrush x:Key="NeutralBrush" Color="#94A3B8" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassDangerBrush" Color="#BE123C" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassDangerBorderBrush" Color="#CCBE123C" po:Freeze="True"/>

    <!-- Accent brushes -->
        <SolidColorBrush x:Key="LiquidBlueBrush" Color="#38BDF8" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidBlueSurfaceBrush" Color="#1438BDF8" po:Freeze="True"/>
    <Color x:Key="LiquidBlueColor">#38BDF8</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}" po:Freeze="True"/>

    <!-- Tint brushes -->
    <SolidColorBrush x:Key="TintIndigoBrush" Color="{StaticResource TintIndigoColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TintRedBrush" Color="{StaticResource TintRedColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TintGreenBrush" Color="{StaticResource TintGreenColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TintAmberBrush" Color="{StaticResource TintAmberColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TintPurpleBrush" Color="{StaticResource TintPurpleColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TintGrayBrush" Color="#0FFFFFFF" po:Freeze="True"/>
