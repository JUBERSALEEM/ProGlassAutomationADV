<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════
         PagePatterns.xaml — MASTER UI MODERNIZATION Phase 1 (2026-09-18)

         The four standard patterns that had NO shared implementation and
         were therefore re-invented per screen:

           1. PAGE SURFACE   — PageSurfaceStyle / PageContentMargin
           2. PAGE HEADER    — PageHeaderStyle / *TitleTextStyle /
                               *SubtitleTextStyle / *ActionsStyle
           3. TOOLBAR BAND   — ToolbarBandStyle / ToolbarItemMargin
           4. LOADING STATE  — LoadingPanelStyle / LoadingProgressBarStyle /
                               LoadingLabelStyle
           5. ERROR BANNER   — ErrorBannerStyle / ErrorBannerTextStyle

         LAW COMPLIANCE:
           * Every value is a DynamicResource to an existing theme token —
             no hardcoded colours, radii or type sizes live here, so Light/
             Dark, Monet and Crystal Fluid re-tint these patterns live.
           * No BasedOn on app styles (purely additive; zero risk to
             existing BasedOn chains).
           * Style references from views use StaticResource (standard for
             app-level style infrastructure in this codebase); the values
             inside stay Dynamic.
           * Keys are new (`Page*`, `Toolbar*`, `Loading*`, `ErrorBanner*`)
             — verified unused before adding (W3 duplicate-key gate).

         Standard reference for every pattern: DESIGN_SYSTEM_LOCK.md
         (docs/ui-audit). This dictionary is the ONLY sanctioned place to
         add app-wide page-level patterns; screens must not fork them.
    ═══════════════════════════════════════════════════════════════════ -->

    <!-- ── 1. PAGE SURFACE ───────────────────────────────────────────
         Root of every top-level view: one surface colour, one content
         margin. Density-driven variants read {DynamicResource
         DensityPageMargin} (runtime-published by ThemeManager). -->
    <Style x:Key="PageSurfaceStyle" TargetType="Grid">
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
    </Style>
    <Thickness x:Key="PageContentMargin">20,16,20,20</Thickness>

    <!-- ── 2. PAGE HEADER ────────────────────────────────────────────
         Title band for non-list module pages: title (+ optional
         subtitle) on the left, actions on the right.
         Usage:
           <Grid Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
               <Grid.ColumnDefinitions>
                   <ColumnDefinition Width="*"/>
                   <ColumnDefinition Width="Auto"/>
               </Grid.ColumnDefinitions>
               <StackPanel>
                   <TextBlock Text="{DynamicResource X.Title}"
                              Style="{StaticResource PageHeaderTitleTextStyle}"/>
                   <TextBlock Text="{DynamicResource X.Subtitle}"
                              Style="{StaticResource PageHeaderSubtitleTextStyle}"/>
               </StackPanel>
               <StackPanel Grid.Column="1" Style="{StaticResource PageHeaderActionsStyle}">
                   … PrimaryPillButton / OutlinedPillButton …
               </StackPanel>
           </Grid> -->
    <Style x:Key="PageHeaderStyle" TargetType="Grid">
        <Setter Property="Margin" Value="20,16,20,0"/>
    </Style>
    <Style x:Key="PageHeaderTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Title}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
    </Style>
    <Style x:Key="PageHeaderSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.BodySmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
    <Style x:Key="PageHeaderActionsStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ── 3. TOOLBAR BAND ───────────────────────────────────────────
         Secondary-surface band that groups search/filter/action
         controls above a list or form. Actions inside use the standard
         spacing (ToolbarItemMargin) and the shared button/input styles. -->
    <Style x:Key="ToolbarBandStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Border.HairlineThickness}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="20,0,20,12"/>
    </Style>
    <Thickness x:Key="ToolbarItemMargin">0,0,8,0</Thickness>

    <!-- ── 4. LOADING STATE ──────────────────────────────────────────
         Thin indeterminate progress bar + muted label. Industrial, not
         decorative: no spinners, no blur. Show over an empty data area
         (do NOT wrap live content in hit-test overlays).
         Usage:
           <StackPanel Style="{StaticResource LoadingPanelStyle}"
                       Visibility="{Binding IsLoading, Converter={...BoolToVis}}">
               <ProgressBar Style="{StaticResource LoadingProgressBarStyle}"/>
               <TextBlock Text="{DynamicResource Common.Loading}"
                          Style="{StaticResource LoadingLabelStyle}"/>
           </StackPanel> -->
    <Style x:Key="LoadingPanelStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Vertical"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="LoadingProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="IsIndeterminate" Value="True"/>
        <Setter Property="Width" Value="140"/>
        <Setter Property="Height" Value="4"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="LoadingLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.BodySmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
    </Style>

    <!-- ── 5. ERROR BANNER ───────────────────────────────────────────
         Non-modal inline error strip (data failed to load, validation
         summary). Full-page error states use the shared EmptyState
         control with an error glyph instead.
         Usage:
           <Border Style="{StaticResource ErrorBannerStyle}"
                   Visibility="{Binding HasError, Converter={...BoolToVis}}">
               <TextBlock Text="{Binding ErrorText}"
                          Style="{StaticResource ErrorBannerTextStyle}"/>
           </Border> -->
    <Style x:Key="ErrorBannerStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource TintRedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Border.HairlineThickness}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="20,0,20,12"/>
    </Style>
    <Style x:Key="ErrorBannerTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
