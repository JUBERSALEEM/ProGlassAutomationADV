<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Themes/Styles/TypeScaleTokens.xaml
     PROJECT: ProGlassAutomation
     MODULE: Global type scale (professional typography system)

     One coherent font-size scale for the WHOLE application. Before this
     system existed, ~1,700 XAML attributes hard-coded FontSize with 30+
     different values (8, 9, 9.5, 10, 10.5, 11, 11.5, 12, 12.5, 13, 13.5,
     14 …), which produced the "some text too small, sizes mixed, not
     professional" look.

     The scale (DIPs):
       TextXSmall       11   fine print / legend glyphs (was 8–9.5)
       TextCaption      12   column headers, labels, hints, pills
       TextBody         13   body copy, inputs, buttons, table cells
       TextBodyLarge    14   list-row primary text, menu items
       TextSection      15   card titles, section headers
       TextSubhead      16   emphasis sub-headings
       TextTitle        18   page titles
       TextTitleLarge   20   dashboard/hero titles
       TextHeadline     22   big section headlines
       TextDisplay      24   large numbers
       TextDisplayLarge 28   hero KPI numbers

     Everything below 30 DIPs now references these tokens via
     {StaticResource Text…}. Density presets (Compact/Normal/Comfortable)
     continue to drive DensityTitleFontSize / DensityKpiValueFontSize /
     DensityBodyFontSize for the density-bound chrome.
     ═══════════════════════════════════════════════════════════════════ -->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:Double x:Key="TextXSmall">11</sys:Double>
    <sys:Double x:Key="TextCaption">12</sys:Double>
    <sys:Double x:Key="TextBody">13</sys:Double>
    <sys:Double x:Key="TextBodyLarge">14</sys:Double>
    <sys:Double x:Key="TextSection">15</sys:Double>
    <sys:Double x:Key="TextSubhead">16</sys:Double>
    <sys:Double x:Key="TextTitle">18</sys:Double>
    <sys:Double x:Key="TextTitleLarge">20</sys:Double>
    <sys:Double x:Key="TextHeadline">22</sys:Double>
    <sys:Double x:Key="TextDisplay">24</sys:Double>
    <sys:Double x:Key="TextDisplayLarge">28</sys:Double>

</ResourceDictionary>
