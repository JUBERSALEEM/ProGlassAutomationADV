<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Themes/Styles/ComboTemplates.xaml
     PROJECT: ProGlassAutomation

     The themed ComboBox templates, hoisted into ONE dictionary that App.xaml
     merges EARLY (immediately after SemanticTokens) so that every ComboBox
     style in the app can inherit them through {StaticResource}.

     WHY THIS FILE EXISTS (2026-09-16 owner report):
       "we have implemented the custom dynamic dropdown but still we have this
        issue on step 2 step 3 step 4 etc, dropdown still have wpf issue white
        background white text"

     A style that sets ANY ComboBox property suppresses WPF's implicit style,
     so a module style with no Template of its own falls back to the SYSTEM
     ComboBox template. That template paints its popup from SystemColors —
     which this app deliberately never remaps — giving a white dropdown list
     under a dark theme, with the app's own (light) item text on top: white on
     white. Six styles were in exactly that state:

         PiComboBoxStyle            PiEditableComboBoxStyle      (Proforma Invoice)
         Step4ComboStyle            Step4EditableComboStyle      (Step 4 pricing)
         ModuleListFilterComboStyle                              (every module list)
         GsModuleComboStyle                                      (global search bar)

     The themed templates already existed as Input.ComboBox and
     ModernEditableComboBoxStyle, but they live in GlobalDesignSystem.xaml and
     InputStyles.xaml — merged LATER in App.xaml than all six consumers.
     {StaticResource} resolves while the dictionary is parsed, so a BasedOn
     pointing forward throws at startup; that is why the fix was never simply
     "add BasedOn". Hoisting the templates here removes the ordering
     constraint, and the two original styles now reference these same
     resources, so there is exactly ONE copy of each template to maintain.

     Both templates are written entirely against {DynamicResource} tokens, so
     they contain no StaticResource forward references of their own and are
     safe to merge this early.
     ═══════════════════════════════════════════════════════════════════ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Non-editable picker. Deliberately has NO PART_EditableTextBox — use
         Themed.EditableComboBoxTemplate for IsEditable="True" combos. -->
    <ControlTemplate x:Key="Themed.ComboBoxTemplate" TargetType="ComboBox">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                MinHeight="{TemplateBinding MinHeight}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Full-surface open (2026-09-05 owner report):
                                     click ANYWHERE on the box to open — the
                                     transparent toggle spans both columns and
                                     everything above it is hit-test-invisible
                                     (WPF's own Aero pattern, as in
                                     ModernComboBoxStyle). -->
                                <ToggleButton Grid.Column="0" Grid.ColumnSpan="2"
                                              x:Name="PART_Button"
                                              Focusable="False"
                                              ClickMode="Press"
                                              Cursor="Hand"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Background="Transparent">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    SnapsToDevicePixels="True"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <ContentPresenter Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  ContentSource="SelectionBoxItem"
                                                  IsHitTestVisible="False"/>
                                <TextBlock Grid.Column="1"
                                           Text="&#xE70D;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>

                                <!-- Theme-owned popup: the background is a live
                                     theme token (the app never remaps
                                     SystemColors), and the ItemsPresenter is
                                     what actually renders the options — a
                                     template without it opens an empty popup.
                                     Honours per-view MaxDropDownHeight
                                     (default 200, e.g. the Appearance font
                                     picker sets 320). -->
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                       Placement="Bottom"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Fade"
                                       StaysOpen="False">
                                    <Border Background="{DynamicResource PopupSurfaceBrush}"
                                            BorderBrush="{DynamicResource InputBorderBrush}"
                                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                                            CornerRadius="{DynamicResource CardCornerRadius}"
                                            Padding="6"
                                            MinWidth="{TemplateBinding ActualWidth}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ScrollViewer Focusable="False">
                                            <ItemsPresenter SnapsToDevicePixels="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>

    <!-- Editable picker: same themed chrome plus the PART_EditableTextBox the
         ComboBox contract requires when IsEditable="True". -->
    <ControlTemplate x:Key="Themed.EditableComboBoxTemplate" TargetType="ComboBox">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PART_EditableTextBox"
                                         Grid.Column="0"
                                         Style="{x:Null}"
                                         Background="Transparent"
                                         BorderThickness="{DynamicResource Border.NoneThickness}"
                                         Foreground="{TemplateBinding Foreground}"
                                         FontSize="{TemplateBinding FontSize}"
                                         CaretBrush="{DynamicResource AccentBrush}"
                                         Padding="{TemplateBinding Padding}"
                                         VerticalContentAlignment="Center"
                                         Focusable="True"/>
                                <ToggleButton Grid.Column="1"
                                              x:Name="PART_Button"
                                              Focusable="False"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Background="Transparent"
                                              BorderThickness="{DynamicResource Border.NoneThickness}"
                                              Padding="0,0,12,0"
                                              Cursor="Hand">
                                    <TextBlock Text="&#xE70D;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </ToggleButton>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                       Placement="Bottom"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Fade"
                                       StaysOpen="False">
                                    <Border Background="{DynamicResource PopupSurfaceBrush}"
                                            BorderBrush="{DynamicResource InputBorderBrush}"
                                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                                            CornerRadius="{DynamicResource CardCornerRadius}"
                                            Padding="6"
                                            MinWidth="{TemplateBinding ActualWidth}">
                                        <ScrollViewer MaxHeight="300">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
</ResourceDictionary>
