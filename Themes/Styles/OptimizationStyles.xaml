<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors">

    <!-- ═════════════════════════════════════════════════════════════
         STUDIO BENTO FULL LIGHT SYSTEM — OPTIMIZATION MODULE
         Porcelain surfaces, refined 14-DIP Bento cards,
         semantic yield badges, and CAD-grade 2D cutting visualizer styling.
         ═════════════════════════════════════════════════════════════ -->

    <!-- Indigo identity. Card faces and ink stay DynamicResource so light/dark
         theme still paints the surface. Accent chrome stays studio indigo,
         not the sky-blue freeze and not a user accent swap. -->
    <SolidColorBrush x:Key="OptIndigo" Color="#6546B5"/>
    <SolidColorBrush x:Key="OptIndigoDeep" Color="#493080"/>
    <SolidColorBrush x:Key="OptIndigoSoft" Color="#EEE8F8"/>
    <SolidColorBrush x:Key="OptOnIndigo" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OptOnIndigoMuted" Color="#E3DAF7"/>
    <SolidColorBrush x:Key="OptOnIndigoChip" Color="#33FFFFFF"/>

    <SolidColorBrush x:Key="OptBentoHeroBg" Color="#6546B5"/>
    <SolidColorBrush x:Key="OptBentoHeroBorder" Color="#493080"/>
    <SolidColorBrush x:Key="OptBentoSurface" Color="#FFFEFC"/>
    <SolidColorBrush x:Key="OptBentoCardBg" Color="#FFFEFC"/>
    <SolidColorBrush x:Key="OptBentoCardSubtleBg" Color="#F3F0FA"/>
    <SolidColorBrush x:Key="OptBentoBorder" Color="#E2DBEF"/>
    <SolidColorBrush x:Key="OptBentoKeyline" Color="#EEE8F8"/>
    <SolidColorBrush x:Key="OptBentoInk" Color="#2C2440"/>
    <SolidColorBrush x:Key="OptBentoMuted" Color="#6B6078"/>
    <SolidColorBrush x:Key="OptBentoSubtleText" Color="#8A7E9C"/>

    <!-- Semantic Pill Brushes -->
    <SolidColorBrush x:Key="OptSuccessBg" Color="#ECFDF5"/>
    <SolidColorBrush x:Key="OptSuccessBorder" Color="#A7F3D0"/>
    <SolidColorBrush x:Key="OptSuccessInk" Color="#065F46"/>

    <SolidColorBrush x:Key="OptWarningBg" Color="#FFFBEB"/>
    <SolidColorBrush x:Key="OptWarningBorder" Color="#FDE68A"/>
    <SolidColorBrush x:Key="OptWarningInk" Color="#92400E"/>

    <SolidColorBrush x:Key="OptInfoBg" Color="#EEE8F8"/>
    <SolidColorBrush x:Key="OptInfoBorder" Color="#C9B8E8"/>
    <SolidColorBrush x:Key="OptInfoInk" Color="#493080"/>

    <SolidColorBrush x:Key="OptAccentBg" Color="#EEE8F8"/>
    <SolidColorBrush x:Key="OptAccentBorder" Color="#C9B8E8"/>
    <SolidColorBrush x:Key="OptAccentInk" Color="#6546B5"/>

    <SolidColorBrush x:Key="OptOffcutBg" Color="#F3F0FA"/>
    <SolidColorBrush x:Key="OptOffcutBorder" Color="#C9B8E8"/>

    <!-- Corner Radius Tokens -->
    <CornerRadius x:Key="OptCardRadius">14</CornerRadius>
    <CornerRadius x:Key="OptInnerCardRadius">10</CornerRadius>
    <CornerRadius x:Key="OptPillRadius">8</CornerRadius>

    <!-- ══ Panel Card — Bento Porcelain Frost Surface ═══════════════ -->
    <Style x:Key="OptPanelCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource OptIndigo}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="18,16"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ══ Inner Card (Sub-sections, items, nested surfaces) ════════ -->
    <Style x:Key="OptInnerCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource OptIndigo}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Indigo bento hero. Do not point this at a light surface: every consumer
         paints OptOnIndigo / OptOnIndigoMuted text. Summary yield uses OptKpiCard. -->
    <Style x:Key="OptHeroCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OptBentoHeroBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource OptBentoHeroBorder}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="20,18"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Color="#3D2A6B" Opacity="0.18"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ KPI Metric Card ══════════════════════════════════════════ -->
    <Style x:Key="OptKpiCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource OptIndigo}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Tinted square icon badge on each KPI card -->
    <Style x:Key="OptKpiBadge" TargetType="Border">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="CornerRadius" Value="{DynamicResource OptPillRadius}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ══ Typography ═══════════════════════════════════════════════ -->
    <Style x:Key="OptHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
    </Style>
    <Style x:Key="OptPanelTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
    </Style>
    <Style x:Key="OptKpiValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <!-- ══ Bento Navigation Rail Tab ════════════════════════════════ -->
    <Style x:Key="OptRailTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" CornerRadius="12" HorizontalAlignment="Stretch"
                            Background="{DynamicResource SurfacePrimaryBrush}"
                            BorderBrush="{StaticResource OptIndigo}"
                            BorderThickness="1.5" Padding="14,10" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="Icon" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Text="{TemplateBinding Tag}" Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ContentPresenter x:Name="Label" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource OptIndigoSoft}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource OptIndigo}"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource OptIndigo}"/>
                            <Setter Property="Foreground" Value="{StaticResource OptOnIndigo}"/>
                            <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource OptOnIndigo}"/>
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{StaticResource OptOnIndigo}"/>
                            <Setter TargetName="Label" Property="TextElement.FontWeight" Value="Bold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Inputs ═════════════════════════════════════════════════ -->
    <Style x:Key="OptIntInput" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
        <Setter Property="behaviors:TextBoxBehaviors.AcceptIntegersOnly" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource OptPillRadius}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OptComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="2">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ComboBoxItemHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OptComboStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource OptComboItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            CornerRadius="{DynamicResource OptPillRadius}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="{StaticResource TextXSmall}" Foreground="{DynamicResource MutedForegroundBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="12,0,32,0" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                          TextElement.Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border x:Name="DropDownBorder" MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource PopupSurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Margin="0,4,0,0">
                                <ScrollViewer>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="DropDownBorder" Property="MinHeight" Value="95"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ghost action button (remove / clear) -->
    <Style x:Key="OptGhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Transparent list host (job picker) -->
    <Style x:Key="OptListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style x:Key="OptListBoxItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filmstrip thumb: a sheet chip in the 2D view navigator. -->
    <Style x:Key="SheetChipStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chip" CornerRadius="{DynamicResource OptPillRadius}" Padding="10,7"
                            Background="{DynamicResource Surface.Secondary.BackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" SnapsToDevicePixels="True">
                        <StackPanel>
                            <TextBlock x:Name="No" Text="{Binding SheetNo, StringFormat='Sheet {0}'}"
                                       FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock x:Name="Util" Text="{Binding Utilization}"
                                       FontSize="{StaticResource TextXSmall}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessBrush}" Margin="0,1,0,0"/>
                            <TextBlock Text="{Binding StockLabel}" FontSize="{StaticResource TextXSmall}"
                                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}"/>
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Chip" Property="BorderThickness" Value="1.5"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Multi-Sheet Gallery Card Style ═══════════════════════════ -->
    <Style x:Key="OptGalleryCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource OptIndigo}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="{DynamicResource OptCardRadius}"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.04"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══ Studio Bento Buttons ══════════════════════════════════════ -->
    <Style x:Key="OptPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource OptIndigo}"/>
        <Setter Property="Foreground" Value="{StaticResource OptOnIndigo}"/>
        <Setter Property="BorderBrush" Value="{StaticResource OptIndigo}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource OptPillRadius}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OptOutlinedButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource OptPillRadius}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OptSuccessButton" TargetType="Button" BasedOn="{StaticResource OptPrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
    </Style>

    <!-- ═════════════════════════════════════════════════════════════
         HERO CARD CHROME — approved top-card redesign (2026-09-26)
         The hero is three tidy rows:
           ROW 1 · identity (heading + chip) with one live status line,
           ROW 2 · four translucent stat pills,
           ROW 3 · two compact 210px selects + the run actions.
         Everything here is painted ON indigo, so every surface is a
         translucent white wash and every label is OptOnIndigo*.

         PLACEMENT (do not move this block up): OptHeroComboStyle sets
         ItemContainerStyle="{StaticResource OptComboItem}", and a
         StaticResource inside a ResourceDictionary must point BACKWARD.
         Declared ahead of OptComboItem it resolved to the
         MS.Internal.NamedObject sentinel at template-apply time and threw
         "Unable to cast object of type 'MS.Internal.NamedObject' to type
         'System.Windows.Style'" from ItemsControl.OnItemContainerStyleChanged
         (ERR-A537B3). These styles stay at the END of the dictionary.
         ═════════════════════════════════════════════════════════════ -->

    <!-- Uppercase identity chip beside the heading -->
    <Style x:Key="OptHeroChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OptOnIndigoChip}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ROW 2 · one stat pill (icon + label + value) -->
    <Style x:Key="OptHeroStatPill" TargetType="Border">
        <Setter Property="Background" Value="#26FFFFFF"/>
        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="OptHeroStatLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource OptOnIndigoMuted}"/>
    </Style>

    <Style x:Key="OptHeroStatValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource OptOnIndigo}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <!-- ROW 3 · 9px caption sitting above its dropdown -->
    <Style x:Key="OptHeroFieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource OptOnIndigoMuted}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- ROW 3 · 36px dropdown painted on indigo — same height as the action
         buttons it sits beside, so the control cluster shares one baseline.
         The open popup stays on the light PopupSurface so the items keep
         dark ink — only the closed field is translucent white. -->
    <Style x:Key="OptHeroComboStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Background" Value="#26FFFFFF"/>
        <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource OptOnIndigo}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource OptComboItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            CornerRadius="{DynamicResource OptPillRadius}" SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="10" Foreground="{StaticResource OptOnIndigoMuted}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#40FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="12,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                          TextElement.Foreground="{StaticResource OptOnIndigo}"/>
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border x:Name="DropDownBorder" MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource PopupSurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Margin="0,4,0,0">
                                <ScrollViewer>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="DropDownBorder" Property="MinHeight" Value="95"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ROW 3 · the one primary action — solid white pill, indigo text -->
    <Style x:Key="OptHeroPillButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource OptOnIndigo}"/>
        <Setter Property="Foreground" Value="{StaticResource OptIndigo}"/>
        <Setter Property="BorderBrush" Value="{StaticResource OptOnIndigo}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="18" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ROW 3 · outline ghost action on indigo -->
    <Style x:Key="OptHeroGhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource OptOnIndigo}"/>
        <Setter Property="BorderBrush" Value="#66FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="18" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#26FFFFFF"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource OptOnIndigo}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
