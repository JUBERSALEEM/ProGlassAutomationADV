<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="ProGlassAutomation.Themes.Styles.IconBadgeStyles">

    <!-- ═══════════════════════════════════════════════════════════════
         ICON BADGE STYLES — Small rounded colored squares used in
         card corners to indicate category or type. Contains an emoji
         or icon inside. 44x44 default size.

         Usage:
             <Border Style="{StaticResource IconBadgeAccentStyle}">
                 <TextBlock Text="&#128200;" FontSize="{StaticResource TextTitleLarge}"
                            Foreground="{DynamicResource OnAccentForegroundBrush}"/>
             </Border>
    ═══════════════════════════════════════════════════════════════ -->

    <!-- Base badge — inherit + override Background for color variants -->
    <Style x:Key="IconBadgeBaseStyle" TargetType="Border">
        <Setter Property="Width"               Value="44"/>
        <Setter Property="Height"              Value="44"/>
        <Setter Property="CornerRadius"        Value="11"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment"   Value="Center"/>
    </Style>

    <!-- Small variant (36x36) for tighter layouts -->
    <Style x:Key="IconBadgeSmallStyle" TargetType="Border"
           BasedOn="{StaticResource IconBadgeBaseStyle}">
        <Setter Property="Width"        Value="36"/>
        <Setter Property="Height"       Value="36"/>
        <Setter Property="CornerRadius" Value="9"/>
    </Style>

    <!-- Large variant (52x52) for hero cards -->
    <Style x:Key="IconBadgeLargeStyle" TargetType="Border"
           BasedOn="{StaticResource IconBadgeBaseStyle}">
        <Setter Property="Width"        Value="52"/>
        <Setter Property="Height"       Value="52"/>
        <Setter Property="CornerRadius" Value="13"/>
    </Style>

    <!-- Color variants (all inherit base sizing) -->
    <Style x:Key="IconBadgeAccentStyle" TargetType="Border"
           BasedOn="{StaticResource IconBadgeBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style x:Key="IconBadgeSuccessStyle" TargetType="Border"
           BasedOn="{StaticResource IconBadgeBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
    </Style>

    <Style x:Key="IconBadgeWarningStyle" TargetType="Border"
           BasedOn="{StaticResource IconBadgeBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
    </Style>

    <Style x:Key="IconBadgeDangerStyle" TargetType="Border"
           BasedOn="{StaticResource IconBadgeBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
    </Style>

    <Style x:Key="IconBadgeInfoStyle" TargetType="Border"
           BasedOn="{StaticResource IconBadgeBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource InfoBrush}"/>
    </Style>

    <Style x:Key="IconBadgeNeutralStyle" TargetType="Border"
           BasedOn="{StaticResource IconBadgeBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource NeutralBrush}"/>
    </Style>

    <!-- Tinted variant — light bg with accent-colored icon
         (used inside tinted cards for softer look) -->
    <Style x:Key="IconBadgeTintedAccentStyle" TargetType="Border"
           BasedOn="{StaticResource IconBadgeBaseStyle}">
        <Setter Property="Background"      Value="{DynamicResource ModuleBackgroundBrush}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

</ResourceDictionary>