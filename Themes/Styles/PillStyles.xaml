<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="ProGlassAutomation.Themes.Styles.PillStyles">

    <!-- ═══════════════════════════════════════════════════════════════
         PILL STYLES — Rounded colored labels for status, priority,
         category tags, and quick indicators.
    ═══════════════════════════════════════════════════════════════ -->

    <!-- Pill text style (shared across all pill variants) -->
    <Style x:Key="PillTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="PillTextDarkStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <!-- Base solid pill -->
    <Style x:Key="StatusPillBaseStyle" TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}">
        <Setter Property="CornerRadius"        Value="10"/>
        <Setter Property="Padding"             Value="10,4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment"   Value="Center"/>
    </Style>

    <!-- Solid color variants -->
    <Style x:Key="StatusPillAccentStyle" TargetType="Border"
           BasedOn="{StaticResource StatusPillBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style x:Key="StatusPillSuccessStyle" TargetType="Border"
           BasedOn="{StaticResource StatusPillBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
    </Style>

    <Style x:Key="StatusPillWarningStyle" TargetType="Border"
           BasedOn="{StaticResource StatusPillBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
    </Style>

    <Style x:Key="StatusPillDangerStyle" TargetType="Border"
           BasedOn="{StaticResource StatusPillBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
    </Style>

    <Style x:Key="StatusPillInfoStyle" TargetType="Border"
           BasedOn="{StaticResource StatusPillBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource InfoBrush}"/>
    </Style>

    <Style x:Key="StatusPillNeutralStyle" TargetType="Border"
           BasedOn="{StaticResource StatusPillBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource NeutralBrush}"/>
    </Style>

    <!-- Priority pills (map to semantic colors) -->
    <Style x:Key="PriorityPillHighStyle" TargetType="Border"
           BasedOn="{StaticResource StatusPillDangerStyle}"/>

    <Style x:Key="PriorityPillMediumStyle" TargetType="Border"
           BasedOn="{StaticResource StatusPillSuccessStyle}"/>

    <Style x:Key="PriorityPillLowStyle" TargetType="Border"
           BasedOn="{StaticResource StatusPillNeutralStyle}"/>

    <!-- Outline pill — for less emphasis (used inside colored cards) -->
    <Style x:Key="OutlinePillStyle" TargetType="Border"
           BasedOn="{StaticResource StatusPillBaseStyle}">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource OutlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Category tag pill — muted background, dark text -->
    <Style x:Key="TagPillStyle" TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}">
        <Setter Property="CornerRadius"        Value="12"/>
        <Setter Property="Padding"             Value="10,3"/>
        <Setter Property="Background"          Value="{DynamicResource TintGrayBrush}"/>
        <Setter Property="BorderBrush"         Value="{DynamicResource OutlineBrush}"/>
        <Setter Property="BorderThickness"     Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment"   Value="Center"/>
        <Setter Property="Margin"              Value="0,0,6,0"/>
    </Style>

    <Style x:Key="TagPillTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
    </Style>

    <!-- Trending badge (small pill with arrow + percentage) -->
    <Style x:Key="TrendingBadgeUpStyle" TargetType="Border"
           BasedOn="{StaticResource StatusPillBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="Padding"    Value="8,3"/>
    </Style>

    <Style x:Key="TrendingBadgeDownStyle" TargetType="Border"
           BasedOn="{StaticResource StatusPillBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="Padding"    Value="8,3"/>
    </Style>

</ResourceDictionary>