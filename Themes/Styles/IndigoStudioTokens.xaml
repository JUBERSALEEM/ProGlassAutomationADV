<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════
         INDIGO STUDIO BENTO DESIGN SYSTEM TOKENS
         Authoritative palette, typography ladder, card primitives, and button styles.
    ═══════════════════════════════════════════════════════════════════ -->

    <!-- Brushes -->
    <SolidColorBrush x:Key="Ov.Canvas"        Color="#F3F0FA"/>
    <SolidColorBrush x:Key="Ov.Surface"       Color="#FFFEFC"/>
    <SolidColorBrush x:Key="Ov.Soft"          Color="#EEE8F8"/>
    <SolidColorBrush x:Key="Ov.Line"          Color="#E2DBEF"/>
    <SolidColorBrush x:Key="Ov.Ink"           Color="#2C2440"/>
    <SolidColorBrush x:Key="Ov.Muted"         Color="#6B6078"/>
    <SolidColorBrush x:Key="Ov.Accent"        Color="#6546B5"/>
    <SolidColorBrush x:Key="Ov.AccentHover"   Color="#533698"/>
    <SolidColorBrush x:Key="Ov.AreaEnd"       Color="#B4A1E1"/>
    <SolidColorBrush x:Key="Ov.OnAccent"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Ov.OnAccentMuted" Color="#E3DAF7"/>
    <SolidColorBrush x:Key="Ov.Success"       Color="#22714E"/>
    <SolidColorBrush x:Key="Ov.Danger"        Color="#B83E50"/>
    <SolidColorBrush x:Key="Ov.DangerSoft"    Color="#FBECEF"/>
    <SolidColorBrush x:Key="Ov.Warning"       Color="#92601F"/>
    <SolidColorBrush x:Key="Ov.SuccessSoft"   Color="#EAF4EF"/>
    <SolidColorBrush x:Key="Ov.WarningSoft"   Color="#FAF2E7"/>

    <LinearGradientBrush x:Key="Ov.Hero" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6744B9" Offset="0"/>
        <GradientStop Color="#493080" Offset="1"/>
    </LinearGradientBrush>

    <!-- Typography Scale & TextBlock Styles -->
    <Style x:Key="Ov.Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Ov.Ink}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Ov.Title" TargetType="TextBlock" BasedOn="{StaticResource Ov.Text}">
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Ov.CardTitle" TargetType="TextBlock" BasedOn="{StaticResource Ov.Text}">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Ov.Meta" TargetType="TextBlock" BasedOn="{StaticResource Ov.Text}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Ov.Muted}"/>
    </Style>

    <Style x:Key="Ov.Value" TargetType="TextBlock" BasedOn="{StaticResource Ov.Text}">
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <Style x:Key="Ov.Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="{DynamicResource Ov.Accent}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- Card Primitives -->
    <Style x:Key="Ov.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ov.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ov.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="Ov.CardCompact" TargetType="Border" BasedOn="{StaticResource Ov.Card}">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="16,14"/>
    </Style>

    <Style x:Key="Ov.CardMicro" TargetType="Border" BasedOn="{StaticResource Ov.Card}">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="14,12"/>
    </Style>

    <!-- Buttons -->
    <Style x:Key="Ov.Button" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Ov.Ink}"/>
        <Setter Property="Background" Value="{DynamicResource Ov.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ov.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Ov.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Ov.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.78"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ov.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Ov.Button}">
        <Setter Property="Background" Value="{DynamicResource Ov.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ov.OnAccent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ov.Accent}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Ov.AccentHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Skeleton Loading -->
    <Style x:Key="Ov.Skeleton" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ov.Soft}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <!-- Icon Box -->
    <Style x:Key="Ov.IconBox" TargetType="Border">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{DynamicResource Ov.Soft}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Focus Visual -->
    <Style x:Key="Ov.Focus" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border BorderBrush="{DynamicResource Ov.Accent}" BorderThickness="2"
                            CornerRadius="10" Margin="-3"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>