<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Themes/Styles/LayoutTokens.xaml
     PROJECT: ProGlassAutomation
     MODULE: ProGlass Design System — LAYOUT LAYER (Level 5 · density)

     WHY THIS FILE
       The master design-system directive requires an information-dense ERP
       layout axis with Compact / Comfortable / Spacious variants — no
       consumer-app whitespace — while keeping the PI industrial station
       (Rail / WorkDeck / ProductViewport / CommandFooter) as module-level
       compositions.

       The density ENGINE already exists: ThemeManager.ApplyDisplayDensity
       publishes DensityInputHeight / DensityButtonHeight / DensityRowHeight /
       DensityTitleFontSize / DensityKpiValueFontSize / DensityBodyFontSize /
       DensityButtonMinWidth / DensityCardPadding / DensityStripPadding /
       DensityPageMargin live (Compact · Normal · Comfortable), with
       LightTheme/DarkTheme fallbacks so they resolve before the manager
       runs. Views already bind those keys.

       This file only adds the canonical ProGlassLayout.* vocabulary over
       the same runtime keys, so new modules consume ONE name.

     EMERGENCY UI RECOVERY FIX FOR MC1000:
       Previously this file used <DynamicResource> and was changed to <StaticResource>
       to make FontSize aliases safe (Double directly). However StaticResource
       requires compile-time availability in same dictionary or merged dictionary
       at compile time. Density* is defined in LightTheme.xaml which is merged
       in App.xaml BEFORE this file, but XAML compiler for this file alone does
       NOT see LightTheme resources at compile time (only at runtime via App.xaml
       MergedDictionaries), causing MC1000 Index out of range build error at
       Line 40. Fix: For FontSize aliases, use sys:Double directly with fixed
       fallback values matching LightTheme (Body 13, Title 18, Kpi 16) — concrete
       Double, startup-safe, prevents ResourceReferenceExpression crash inside
       templates. For layout Thickness/Double, keep DynamicResource so density
       switching still works at runtime (DynamicResource is valid for non-FontSize
       properties and does not cause FontSize crash). This preserves theme
       infrastructure and fixes MC1000.

     WHAT LAYOUT IS NOT
       Workspace / Station / Rail / Deck / Grid / List / Queue are
       COMPOSITIONS of surfaces + grids + these density tokens, and they stay
       where they already are: ShellStyles (workspace shell), PiIndustrial-
       Styles (PiStationRail / PiWorkDeck / PiProductViewport /
       PiCommandFooter / PiCostTile), ListPageStyles (ModuleListShell / rows),
       DataGridStyles (line-item grids). See the architecture doc for the
       full layout map. They are NOT flattened into tokens here.
     ═══════════════════════════════════════════════════════════════════ -->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ── DENSITY · ProGlassLayout — EMERGENCY: FontSize aliases as sys:Double directly (startup-safe concrete double, not ResourceReferenceExpression). Previously DynamicResource Density* → ResourceReferenceExpression → ArgumentException in FrameworkTemplate.ReceivePropertySet when consumed as FontSize inside template. Now Double directly, safe. -->
    <sys:Double x:Key="ProGlassLayout.TitleFontSize">18</sys:Double>
    <sys:Double x:Key="ProGlassLayout.KpiFontSize">16</sys:Double>
    <sys:Double x:Key="ProGlassLayout.BodyFontSize">13</sys:Double>

    <!-- Layout Thickness/Double — keep DynamicResource so density switching works at runtime (valid for non-FontSize) -->
    <DynamicResource x:Key="ProGlassLayout.RowHeight"       ResourceKey="DensityRowHeight"/>
    <DynamicResource x:Key="ProGlassLayout.InputHeight"     ResourceKey="DensityInputHeight"/>
    <DynamicResource x:Key="ProGlassLayout.ButtonHeight"    ResourceKey="DensityButtonHeight"/>
    <DynamicResource x:Key="ProGlassLayout.ButtonMinWidth"  ResourceKey="DensityButtonMinWidth"/>
    <DynamicResource x:Key="ProGlassLayout.CardPadding"     ResourceKey="DensityCardPadding"/>
    <DynamicResource x:Key="ProGlassLayout.SectionPadding"  ResourceKey="DensityStripPadding"/>
    <DynamicResource x:Key="ProGlassLayout.PageMargin"      ResourceKey="DensityPageMargin"/>

</ResourceDictionary>
