<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Themes/Styles/LayoutTokens.xaml
     PROJECT: ProGlassAutomation
     MODULE: ProGlass Design System — LAYOUT LAYER (Level 5 · density)

     WHY THIS FILE
       The master design-system directive requires an information-dense ERP
       layout axis with Compact / Comfortable / Spacious variants — no
       consumer-app whitespace — while keeping the PI industrial station
       (Rail / WorkDeck / ProductViewport / CommandFooter) as module-level
       compositions.

       The density ENGINE already exists: ThemeManager.ApplyDisplayDensity
       publishes DensityInputHeight / DensityButtonHeight / DensityRowHeight /
       DensityTitleFontSize / DensityKpiValueFontSize / DensityBodyFontSize /
       DensityButtonMinWidth / DensityCardPadding / DensityStripPadding /
       DensityPageMargin live (Compact · Normal · Comfortable), with
       LightTheme/DarkTheme fallbacks so they resolve before the manager
       runs. Views already bind those keys.

       This file only adds the canonical ProGlassLayout.* vocabulary over
       the same runtime keys, so new modules consume ONE name.

     RESOURCE-VALUE RULE (post-splash crash fix, 2026-09-14):
       Every key in this file is a CONCRETE value (sys:Double / Thickness).
       Two historical mistakes to avoid:
       1. <StaticResource x:Key=... ResourceKey="Density*"> — the XAML
          compiler does not see LightTheme.xaml when compiling this file
          alone (merged dictionaries are runtime-only), so the cross-file
          key fails with MC1000 at build time.
       2. <DynamicResource x:Key=... ResourceKey="Density*"> — compiles
          fine, but stores a ResourceReferenceExpression marker object as
          the resource VALUE; the first control assigning it to Height /
          MinWidth / Padding / Margin crashes with
          "ResourceReferenceExpression is not a valid value for property
          '...'". (This was the post-splash launch crash.)
       Live density switching is preserved by ThemeManager.ApplyDisplay
       Density, which dual-writes every ProGlassLayout.* key onto
       Application resources at startup and on every density change.

     WHAT LAYOUT IS NOT
       Workspace / Station / Rail / Deck / Grid / List / Queue are
       COMPOSITIONS of surfaces + grids + these density tokens, and they stay
       where they already are: ShellStyles (workspace shell), PiIndustrial-
       Styles (PiStationRail / PiWorkDeck / PiProductViewport /
       PiCommandFooter / PiCostTile), ListPageStyles (ModuleListShell / rows),
       DataGridStyles (line-item grids). See the architecture doc for the
       full layout map. They are NOT flattened into tokens here.
     ═══════════════════════════════════════════════════════════════════ -->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ── DENSITY · ProGlassLayout — CONCRETE VALUES ONLY.
         NEVER use <DynamicResource x:Key=...> here: that markup form stores
         a ResourceReferenceExpression marker as the resource value and
         crashes the first property assignment after the splash.
         The values below are the Compact-density fallbacks; live density
         switching works because ThemeManager.ApplyDisplayDensity dual-writes
         every ProGlassLayout.* key onto Application resources at startup
         and on every density change. -->
    <sys:Double x:Key="ProGlassLayout.TitleFontSize">18</sys:Double>
    <sys:Double x:Key="ProGlassLayout.KpiFontSize">16</sys:Double>
    <sys:Double x:Key="ProGlassLayout.BodyFontSize">13</sys:Double>

    <!-- Compact-density fallbacks (ThemeManager republishes at runtime) -->
    <sys:Double x:Key="ProGlassLayout.RowHeight">26</sys:Double>
    <sys:Double x:Key="ProGlassLayout.InputHeight">28</sys:Double>
    <sys:Double x:Key="ProGlassLayout.ButtonHeight">30</sys:Double>
    <sys:Double x:Key="ProGlassLayout.ButtonMinWidth">84</sys:Double>
    <Thickness x:Key="ProGlassLayout.CardPadding">8,6,8,6</Thickness>
    <Thickness x:Key="ProGlassLayout.SectionPadding">10,6,10,6</Thickness>
    <Thickness x:Key="ProGlassLayout.PageMargin">10,6,10,6</Thickness>

</ResourceDictionary>
