<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Themes/Styles/DesignTokens.xaml
     PROJECT: ProGlassAutomation
     MODULE: UI Design System (v2)

     THE single source of truth for module-screen building blocks.
     Every module screen should compose from these primitives so the
     whole application looks and behaves consistently.

     RADIUS SCALE (canonical — defined in Light/Dark theme files):
       ControlCornerRadius      = 12   inputs, chips, buttons (same as card)
       CardCornerRadius         = 12   cards, panels, action buttons
                                       (Settings → Appearance slider)
       CardCornerRadiusLarge    = 12   dialogs, heroes (same as card)

     TYPE SCALE (canonical — TypeScaleTokens.xaml, merged in App.xaml):
       TextXSmall       11   fine print / legend glyphs
       TextCaption      12   column headers / labels / hints / pills
       TextBody         13   body / inputs / buttons / table cells
       TextBodyLarge    14   list-row primary text / menu items
       TextSection      15   card titles / section headers
       TextSubhead      16   emphasis sub-headings
       TextTitle        18   page titles
       TextTitleLarge   20   dashboard/hero titles
       TextHeadline     22   big section headlines
       TextDisplay      24   large numbers
       TextDisplayLarge 28   hero KPI numbers

     Every FontSize below 30 DIPs is a {StaticResource Text…} token —
     never a hard-coded number. Density presets keep driving
     DensityTitleFontSize / DensityKpiValueFontSize / DensityBodyFontSize
     for the density-bound chrome.

     RULES FOR MIGRATING A MODULE (see Docs/DESIGN_SYSTEM.md):
       1. Replace hardcoded CornerRadius with the tokens above.
       2. Replace local header/toolbar styles with these primitives.
       3. Keep module-specific data templates (rows, cells) — only the
          chrome standardizes.
═══════════════════════════════════════════════════════════════════════ -->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">


    <!-- ═══════════════════════════════════════════════════════════════
         SEMANTIC ERP SURFACES — the canonical three-level surface system.
         These keys are deliberately resource-driven: ThemeManager publishes
         their brushes/thickness/radius from Appearance settings after every
         Light/Dark/family/accent change. Modules should choose one level by
         information hierarchy, not invent per-page card species.
    ═══════════════════════════════════════════════════════════════ -->

    <StaticResource x:Key="Surface.Primary.BackgroundBrush" ResourceKey="GlassSurfaceBrush"/>
    <StaticResource x:Key="Surface.Secondary.BackgroundBrush" ResourceKey="GlassSurfaceUltra"/>
    <StaticResource x:Key="Surface.Detail.BackgroundBrush" ResourceKey="ModuleBackgroundBrush"/>
    <StaticResource x:Key="Surface.Primary.BorderBrush" ResourceKey="GlassBorderSoft"/>
    <StaticResource x:Key="Surface.Secondary.BorderBrush" ResourceKey="OutlineBrush"/>
    <StaticResource x:Key="Surface.Detail.BorderBrush" ResourceKey="OutlineBrush"/>
    <StaticResource x:Key="Surface.Primary.OverlayBrush" ResourceKey="ModuleBackgroundBrush"/>

    <Thickness x:Key="Surface.Primary.BorderThickness">1.5</Thickness>
    <Thickness x:Key="Surface.Secondary.BorderThickness">1</Thickness>
    <Thickness x:Key="Surface.Detail.BorderThickness">1</Thickness>
    <CornerRadius x:Key="Surface.Primary.CornerRadius">12</CornerRadius>
    <CornerRadius x:Key="Surface.Secondary.CornerRadius">12</CornerRadius>
    <CornerRadius x:Key="Surface.Detail.CornerRadius">10</CornerRadius>
    <Thickness x:Key="Surface.Primary.Padding">12,9</Thickness>
    <Thickness x:Key="Surface.Secondary.Padding">14,9</Thickness>
    <Thickness x:Key="Surface.Detail.Padding">10,6</Thickness>
    <x:Null x:Key="Surface.Primary.Effect"/>


    <!-- Dynamic shape/border primitives for legacy XAML migration. These
         preserve proportional shape while allowing Appearance to update all
         non-print screens from one place. -->
    <CornerRadius x:Key="Radius.None">0</CornerRadius>
    <CornerRadius x:Key="Radius.XSmall">3</CornerRadius>
    <CornerRadius x:Key="Radius.Small">6</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">10</CornerRadius>
    <CornerRadius x:Key="Radius.Large">12</CornerRadius>
    <CornerRadius x:Key="Radius.Hero">18</CornerRadius>
    <CornerRadius x:Key="Radius.Top.Medium">10,10,0,0</CornerRadius>
    <CornerRadius x:Key="Radius.Bottom.Medium">0,0,10,10</CornerRadius>
    <CornerRadius x:Key="Radius.Left.Medium">10,0,0,10</CornerRadius>
    <CornerRadius x:Key="Radius.Right.Medium">0,10,10,0</CornerRadius>
    <CornerRadius x:Key="Radius.Asymmetric.Brand">12,12,12,4</CornerRadius>

    <Thickness x:Key="Border.NoneThickness">0</Thickness>
    <Thickness x:Key="Border.HairlineThickness">1</Thickness>
    <Thickness x:Key="Border.StrongThickness">1.5</Thickness>
    <Thickness x:Key="Border.TopHairlineThickness">0,1,0,0</Thickness>
    <Thickness x:Key="Border.BottomHairlineThickness">0,0,0,1</Thickness>
    <Thickness x:Key="Border.LeftHairlineThickness">1,0,0,0</Thickness>
    <Thickness x:Key="Border.RightHairlineThickness">0,0,1,0</Thickness>
    <Thickness x:Key="Border.VerticalHairlineThickness">1,0,1,0</Thickness>
    <Thickness x:Key="Border.HorizontalHairlineThickness">0,1,0,1</Thickness>
    <Thickness x:Key="Border.BoxNoLeftThickness">0,1,1,1</Thickness>
    <Thickness x:Key="Border.BoxNoTopThickness">1,0,1,1</Thickness>
    <Thickness x:Key="Border.RightBottomHairlineThickness">0,0,1,1</Thickness>

    <Style x:Key="SurfacePrimaryStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.Primary.BackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Surface.Primary.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Surface.Primary.BorderThickness}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Surface.Primary.CornerRadius}"/>
        <Setter Property="Padding" Value="{DynamicResource Surface.Primary.Padding}"/>
        <Setter Property="Effect" Value="{DynamicResource Surface.Primary.Effect}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style x:Key="SurfaceSecondaryStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.Secondary.BackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Surface.Secondary.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Surface.Secondary.BorderThickness}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Surface.Secondary.CornerRadius}"/>
        <Setter Property="Padding" Value="{DynamicResource Surface.Secondary.Padding}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style x:Key="SurfaceDetailStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.Detail.BackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Surface.Detail.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Surface.Detail.BorderThickness}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Surface.Detail.CornerRadius}"/>
        <Setter Property="Padding" Value="{DynamicResource Surface.Detail.Padding}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style x:Key="PrimarySurfaceCardStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}"/>
    <Style x:Key="SecondarySurfaceCardStyle" TargetType="Border" BasedOn="{StaticResource SurfaceSecondaryStyle}"/>
    <Style x:Key="DetailSurfaceCardStyle" TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}"/>

    <Style x:Key="ErpKpiSurfaceStyle" TargetType="Border" BasedOn="{StaticResource SurfaceSecondaryStyle}">
        <Setter Property="MinHeight" Value="86"/>
    </Style>

    <Style x:Key="ErpInlineStatusSurfaceStyle" TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}"/>

    <Style x:Key="ErpEmptyStateSurfaceStyle" TargetType="Border" BasedOn="{StaticResource SurfaceSecondaryStyle}">
        <Setter Property="Padding" Value="24"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- ══ PAGE HEADER ════════════════════════════════════════════════ -->

    <Style x:Key="ModulePageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource DensityTitleFontSize}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground"
                Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="ModulePageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
        <Setter Property="Foreground"
                Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!-- ══ SECTION CARD — the one card shape for module panels ═══════ -->

    <Style x:Key="ModuleSectionCardStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}"/>

    <!-- ══ COLUMN / FIELD LABELS ═════════════════════════════════════ -->

    <Style x:Key="ModuleColumnHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground"
                Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ══ TOOLBAR BUTTONS — one primary + one secondary for all ═════ -->

    <!-- Toolbar action buttons use the canonical 12px card radius,
         matching every other button and card in the app. -->
    <Style x:Key="ModuleToolbarPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground"
                Value="{DynamicResource OnAccentForegroundBrush}"/>
        <Setter Property="Background"
                Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity"
                                    Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity"
                                    Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity"
                                    Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary = the "TODAY" pill from the reference screenshot:
         light surface + accent border + accent text. -->
    <Style x:Key="ModuleToolbarSecondaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ModuleToolbarPrimaryButtonStyle}">
        <Setter Property="Foreground"
                Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background"
                Value="{DynamicResource GlassSurfaceUltra}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <!-- Success (green) pill — "SHARE EXCEL"-style confirmations. -->
    <Style x:Key="ModuleToolbarSuccessButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ModuleToolbarPrimaryButtonStyle}">
        <Setter Property="Background"
                Value="{DynamicResource SuccessBrush}"/>
    </Style>

    <!-- ══ DETAIL / WIZARD HEADERS (Phase 9 remainder) ═══════════════ -->

    <Style x:Key="ModuleDetailTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextTitleLarge}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground"
                Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="ModuleDetailActionBarStyle" TargetType="Border" BasedOn="{StaticResource SurfaceSecondaryStyle}">
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="ModuleWizardStepIconStyle" TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Background"
                Value="{DynamicResource AccentBrush}"/>
        <Setter Property="CornerRadius"
                Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="ModuleErrorBannerStyle" TargetType="Border" BasedOn="{StaticResource SurfaceSecondaryStyle}">
        <Setter Property="Background"
                Value="{DynamicResource TintRedBrush}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource DangerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"
                Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="ModuleSuccessBannerStyle" TargetType="Border" BasedOn="{StaticResource SurfaceSecondaryStyle}">
        <Setter Property="Background"
                Value="{DynamicResource TintGreenBrush}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"
                Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="ModuleFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground"
                Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="ModuleInlineWarningStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="Foreground"
                Value="{DynamicResource WarningBrush}"/>
        <Setter Property="Margin" Value="2,4,0,0"/>
    </Style>

    <!-- ══ TAB PILL (in-page tabs, e.g. list filters) ════════════════ -->

    <Style x:Key="ModuleTabPillStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground"
                Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="Transparent"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background"
                                    Value="{DynamicResource MenuHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
