<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Themes/Styles/DesignTokens.xaml
     PROJECT: ProGlassAutomation
     MODULE: UI Design System (v2)

     THE single source of truth for module-screen building blocks.
     Every module screen should compose from these primitives so the
     whole application looks and behaves consistently.

     RADIUS SCALE (canonical — defined in Light/Dark theme files):
       ControlCornerRadius      = 12   inputs, chips, buttons (same as card)
       CardCornerRadius         = 12   cards, panels, action buttons
                                       (Settings → Appearance slider)
       CardCornerRadiusLarge    = 12   dialogs, heroes (same as card)
       PillCornerRadius         = 999  status chips only — not buttons

     TYPE SCALE:
       20 Bold     page title
       12 Normal   page subtitle
       10 Bold     column headers / labels (uppercase)
       13 Normal   body / inputs
       11 Normal   secondary / meta text

     RULES FOR MIGRATING A MODULE (see Docs/DESIGN_SYSTEM.md):
       1. Replace hardcoded CornerRadius with the tokens above.
       2. Replace local header/toolbar styles with these primitives.
       3. Keep module-specific data templates (rows, cells) — only the
          chrome standardizes.
═══════════════════════════════════════════════════════════════════════ -->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:Double x:Key="DensityInputHeight">28</sys:Double>
    <sys:Double x:Key="DensityButtonHeight">30</sys:Double>
    <sys:Double x:Key="DensityRowHeight">26</sys:Double>
    <sys:Double x:Key="DensityTitleFontSize">17</sys:Double>
    <sys:Double x:Key="DensityKpiValueFontSize">15</sys:Double>
    <sys:Double x:Key="DensityBodyFontSize">12</sys:Double>
    <sys:Double x:Key="DensityButtonMinWidth">84</sys:Double>

    <!-- ══ PAGE HEADER ════════════════════════════════════════════════ -->

    <Style x:Key="ModulePageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource DensityTitleFontSize}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground"
                Value="{DynamicResource PrimaryForegroundBrush}"/>
    </Style>

    <Style x:Key="ModulePageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
        <Setter Property="Foreground"
                Value="{DynamicResource SecondaryForegroundBrush}"/>
    </Style>

    <!-- ══ SECTION CARD — the one card shape for module panels ═══════ -->

    <Style x:Key="ModuleSectionCardStyle" TargetType="Border">
        <Setter Property="Background"
                Value="{DynamicResource ModuleBackgroundBrush}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource OutlineBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius"
                Value="{DynamicResource CardCornerRadius}"/>
        <Setter Property="Padding" Value="{DynamicResource DensityCardPadding}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ══ COLUMN / FIELD LABELS ═════════════════════════════════════ -->

    <Style x:Key="ModuleColumnHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground"
                Value="{DynamicResource MutedForegroundBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ══ TOOLBAR BUTTONS — one primary + one secondary for all ═════ -->

    <!-- Toolbar action buttons use a full pill radius (999) to match
         the Proforma-list Export pills. -->
    <Style x:Key="ModuleToolbarPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground"
                Value="{DynamicResource OnAccentForegroundBrush}"/>
        <Setter Property="Background"
                Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity"
                                    Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity"
                                    Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity"
                                    Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary = the "TODAY" pill from the reference screenshot:
         light surface + accent border + accent text. -->
    <Style x:Key="ModuleToolbarSecondaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ModuleToolbarPrimaryButtonStyle}">
        <Setter Property="Foreground"
                Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background"
                Value="{DynamicResource ModuleBackgroundBrush}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <!-- Success (green) pill — "SHARE EXCEL"-style confirmations. -->
    <Style x:Key="ModuleToolbarSuccessButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ModuleToolbarPrimaryButtonStyle}">
        <Setter Property="Background"
                Value="{DynamicResource SuccessBrush}"/>
    </Style>

    <!-- ══ DETAIL / WIZARD HEADERS (Phase 9 remainder) ═══════════════ -->

    <Style x:Key="ModuleDetailTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground"
                Value="{DynamicResource PrimaryForegroundBrush}"/>
    </Style>

    <Style x:Key="ModuleDetailActionBarStyle" TargetType="Border">
        <Setter Property="Background"
                Value="{DynamicResource ModuleBackgroundBrush}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource OutlineBrush}"/>
        <Setter Property="BorderThickness"
                Value="{DynamicResource CardBorderThickness}"/>
        <Setter Property="CornerRadius"
                Value="{DynamicResource CardCornerRadius}"/>
        <Setter Property="Padding" Value="{DynamicResource DensityCardPadding}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="ModuleWizardStepIconStyle" TargetType="Border">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Background"
                Value="{DynamicResource AccentBrush}"/>
        <Setter Property="CornerRadius"
                Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="ModuleErrorBannerStyle" TargetType="Border">
        <Setter Property="Background"
                Value="{DynamicResource TintRedBrush}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource DangerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"
                Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="ModuleSuccessBannerStyle" TargetType="Border">
        <Setter Property="Background"
                Value="{DynamicResource TintGreenBrush}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"
                Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="ModuleFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground"
                Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="ModuleInlineWarningStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground"
                Value="{DynamicResource WarningBrush}"/>
        <Setter Property="Margin" Value="2,4,0,0"/>
    </Style>

    <!-- ══ TAB PILL (in-page tabs, e.g. list filters) ════════════════ -->

    <Style x:Key="ModuleTabPillStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground"
                Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="Transparent"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background"
                                    Value="{DynamicResource MenuHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
