<!--
    Shared chrome for the four document list pages (PI / JO / DN / TI).
    Views keep their own data templates, commands and code-behind names.
    Radius follows the Appearance slider (CardCornerRadius = 12).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Outer list card -->
    <Style x:Key="ModuleListShellStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}">

        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <!-- Compact KPI strip inside the shell -->
    <Style x:Key="ModuleListKpiStripStyle" TargetType="Border" BasedOn="{StaticResource SurfaceSecondaryStyle}">
        <Setter Property="Padding" Value="{DynamicResource DensityStripPadding}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="ModuleListKpiIconStyle" TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="ModuleListKpiLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
    </Style>

    <Style x:Key="ModuleListKpiValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource DensityKpiValueFontSize}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <Style x:Key="ModuleListKpiHintStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <Style x:Key="ModuleListKpiDividerStyle" TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="Margin" Value="8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Filter / toolbar row -->
    <Style x:Key="ModuleListFilterBarStyle" TargetType="Border" BasedOn="{StaticResource SurfaceSecondaryStyle}">
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="ModuleListFilterInputStyle" TargetType="TextBox">
        <Setter Property="Height" Value="{DynamicResource DensityInputHeight}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="ModuleListFilterComboStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinWidth" Value="128"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- Filter-bar DatePicker — same visual height as the report inputs
         so the toolbar rows align on one baseline (professional rhythm). -->
    <Style x:Key="ModuleListFilterDatePickerStyle" TargetType="DatePicker">
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinWidth" Value="128"/>
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ═══ REPORTS HUB — inventory-grade filter card (2026-09-10) ══════
         Mirrors the SheetStore filter card so every report page reads
         like the inventory module: padded rounded card, labeled 40px
         fields, pill clear button, and a full-width accent search band.
         Scoped keys on purpose — the shared ModuleList* styles stay
         untouched for the other module list pages. -->
    <Style x:Key="ReportFilterCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
        <Setter Property="Padding" Value="20,16"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="ReportSearchBandStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}"/>
        <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="ReportSearchInputStyle" TargetType="TextBox">
        <Setter Property="BorderThickness" Value="{DynamicResource Border.NoneThickness}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Pale table header (one-sided 12 px — cannot bind CornerRadius resource) -->
    <Style x:Key="ModuleListTableHeaderStyle" TargetType="Border" BasedOn="{StaticResource SurfaceSecondaryStyle}">
        <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="16,11"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="ModuleListHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════
         RICH REPORT TABLE CHROME — modern SaaS-style
         Accent table header bar with white bold labels. Used by every
         Reports module table so headers read as rich, branded columns
         instead of dull pale strips.
    ═══════════════════════════════════════════════════════════════════ -->
    <Style x:Key="ReportTableHeaderStyle" TargetType="Border"
           BasedOn="{StaticResource ModuleListTableHeaderStyle}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentDarkBrush}"/>
    </Style>

    <Style x:Key="ReportHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Row hover surface — selection / status accents stay per-view -->
    <Style x:Key="ModuleListRowStyle" TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ModuleListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- High-performance virtualized ListBox for reporting tables (handles 100K+ records lag-free) -->
    <Style x:Key="ModuleReportListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="VirtualizingPanel.CacheLength" Value="400,800"/>
        <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Pixel"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ModuleListBoxItemStyle}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Underline tabs (DN / TI code-behind still swap Active/Inactive keys) -->
    <Style x:Key="ModuleListTabInactiveStyle" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Card"
                            Background="Transparent"
                            Padding="8,0"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0,0,0,6">
                                <TextBlock x:Name="Glyph"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="{StaticResource TextBody}"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <TextBlock x:Name="Label"
                                           Text="{TemplateBinding Content}"
                                           FontSize="{StaticResource TextBody}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="Count"
                                           Text="{TemplateBinding CommandParameter}"
                                           FontSize="{StaticResource TextBody}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border x:Name="Underline"
                                    Height="2"
                                    VerticalAlignment="Bottom"
                                    Background="Transparent"
                                    CornerRadius="{DynamicResource Radius.XSmall}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Underline" Property="Background"
                                    Value="{DynamicResource BorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glyph" Property="Foreground"
                                    Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Label" Property="Foreground"
                                    Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Label" Property="FontWeight" Value="Bold"/>
                            <Setter TargetName="Count" Property="Foreground"
                                    Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Underline" Property="Background"
                                    Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
