         Every card in every module must consume these.
         No module-specific CardStyle.
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="SurfacePrimaryStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Border.Default}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}"/>
        <Setter Property="Padding" Value="{DynamicResource Space.Card}"/>
        <Setter Property="Effect" Value="{StaticResource Shadow.Soft}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style x:Key="SurfaceSecondaryStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}">
        <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/>
        <Setter Property="Padding" Value="{DynamicResource Space.Card}"/>
    </Style>
    <Style x:Key="SurfaceDetailStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}">
        <Setter Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}"/>
        <Setter Property="Padding" Value="{DynamicResource Space.Tile}"/>
        <Setter Property="Effect" Value="{x:Null}"/>
    </Style>
    <Style x:Key="SurfaceElevatedStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}">
        <Setter Property="Background" Value="{DynamicResource PopupSurfaceBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Dialog}"/>
        <Setter Property="Padding" Value="{DynamicResource Space.Dialog}"/>
        <Setter Property="Effect" Value="{StaticResource Shadow.Large}"/>
    </Style>
    <Style x:Key="SurfaceKpiStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}">
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
        <Setter Property="Padding" Value="{DynamicResource Space.Tile}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Density.KpiTileMinHeight}"/>
    </Style>
    <Style x:Key="SurfaceGlassStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}">
        <Setter Property="Background" Value="{DynamicResource GlassSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Surface.Glass.Border}"/>
        <Setter Property="Effect" Value="{x:Null}"/>
    </Style>

    <!-- Aliases — all competing card systems now point to ONE canonical -->
    <Style x:Key="ModuleSectionCardStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}"/>
    <Style x:Key="PrimarySurfaceCardStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}"/>
    <Style x:Key="SecondarySurfaceCardStyle" TargetType="Border" BasedOn="{StaticResource SurfaceSecondaryStyle}"/>
    <Style x:Key="DetailSurfaceCardStyle" TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}"/>
    <Style x:Key="BaseCardStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}"/>
    <Style x:Key="ElevatedCardStyle" TargetType="Border" BasedOn="{StaticResource SurfaceElevatedStyle}"/>
    <Style x:Key="StatCardStyle" TargetType="Border" BasedOn="{StaticResource SurfaceKpiStyle}"/>
    <Style x:Key="TaskCardStyle" TargetType="Border" BasedOn="{StaticResource SurfaceSecondaryStyle}"/>
    <Style x:Key="ListRowCardStyle" TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}"/>
    <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}"/>
    <Style x:Key="SectionCardStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}"/>
    <Style x:Key="SoftCardStyle" TargetType="Border" BasedOn="{StaticResource SurfaceSecondaryStyle}"/>
    <Style x:Key="DashCardStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}"/>
    <Style x:Key="IndustrialDashboardCardStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}"/>
    <Style x:Key="IndustrialDashboardRowCardStyle" TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}"/>
    <Style x:Key="DbCardStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}"/>
    <Style x:Key="DbRowCardStyle" TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}"/>
    <Style x:Key="DbPipelineCardStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}"/>
    <Style x:Key="ErpKpiSurfaceStyle" TargetType="Border" BasedOn="{StaticResource SurfaceKpiStyle}"/>
    <Style x:Key="ErpInlineStatusSurfaceStyle" TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}"/>
    <Style x:Key="ErpEmptyStateSurfaceStyle" TargetType="Border" BasedOn="{StaticResource SurfaceSecondaryStyle}"/>

    <!-- ═══════════════════════════════════════════════════════════════
         10. TYPOGRAPHY STYLES — ONE CANONICAL SCALE (DynamicResource)
         Every view must use these. No hardcoded FontSize/Weight.
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="Typography.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.App}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Display}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.Bold}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>
    <Style x:Key="Typography.H1" TargetType="TextBlock" BasedOn="{StaticResource Typography.Display}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.H1}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.Bold}"/>
    </Style>
    <Style x:Key="Typography.H2" TargetType="TextBlock" BasedOn="{StaticResource Typography.Display}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.H2}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
    </Style>
    <Style x:Key="Typography.H3" TargetType="TextBlock" BasedOn="{StaticResource Typography.Display}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.H3}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
    </Style>
    <Style x:Key="Typography.Title" TargetType="TextBlock" BasedOn="{StaticResource Typography.Display}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Title}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
    </Style>
    <Style x:Key="Typography.Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.App}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Subtitle}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.Regular}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style x:Key="Typography.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.App}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.Regular}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style x:Key="Typography.BodySmall" TargetType="TextBlock" BasedOn="{StaticResource Typography.Body}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.BodySmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style x:Key="Typography.Label" TargetType="TextBlock" BasedOn="{StaticResource Typography.Body}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Label}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style x:Key="Typography.Caption" TargetType="TextBlock" BasedOn="{StaticResource Typography.Body}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
    </Style>
    <Style x:Key="Typography.Kpi" TargetType="TextBlock" BasedOn="{StaticResource Typography.Display}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Kpi}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.Bold}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <Style x:Key="Typography.Button" TargetType="TextBlock" BasedOn="{StaticResource Typography.Body}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Button}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
    </Style>
    <Style x:Key="Typography.Navigation" TargetType="TextBlock" BasedOn="{StaticResource Typography.Body}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Navigation}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.Medium}"/>
    </Style>
    <Style x:Key="Typography.DataGrid" TargetType="TextBlock" BasedOn="{StaticResource Typography.Body}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.DataGrid}"/>
    </Style>
    <Style x:Key="Typography.Money" TargetType="TextBlock" BasedOn="{StaticResource Typography.Kpi}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Money}"/>
    </Style>
    <Style x:Key="Typography.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Icon}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Icon}"/>
    </Style>

    <!-- Backward compat aliases for existing TypographyStyles.xaml -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource Typography.H1}"/>
    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource Typography.Subtitle}"/>
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource Typography.H2}"/>
    <Style x:Key="SectionSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource Typography.BodySmall}"/>
    <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource Typography.Title}"/>
    <Style x:Key="CardSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource Typography.BodySmall}"/>
    <Style x:Key="RowTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource Typography.Title}"/>
    <Style x:Key="RowSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource Typography.BodySmall}"/>
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource Typography.Label}"/>
    <Style x:Key="TableHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource Typography.Label}"/>
    <Style x:Key="HeroNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource Typography.Display}"/>
    <Style x:Key="StatNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource Typography.Kpi}"/>
    <Style x:Key="MediumNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource Typography.H1}"/>
    <Style x:Key="MetaTextStyle" TargetType="TextBlock" BasedOn="{StaticResource Typography.Caption}"/>
    <Style x:Key="TrendingTextStyle" TargetType="TextBlock" BasedOn="{StaticResource Typography.Caption}"/>

    <!-- Module aliases -->
    <Style x:Key="ModulePageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource Typography.H1}"/>
    <Style x:Key="ModulePageSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource Typography.Subtitle}"/>
    <Style x:Key="ModuleColumnHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource Typography.Label}"/>

    <!-- ═══════════════════════════════════════════════════════════════
         11. BUTTONS — ONE CANONICAL SYSTEM
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="Button.Primary" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.App}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Button}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="{DynamicResource Density.ControlHeight}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius.Control}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.9"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.8"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Border.Thin}"/>
    </Style>
    <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- Aliases for existing button styles -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource Button.Primary}"/>
    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource Button.Secondary}"/>
    <Style x:Key="ModuleToolbarPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource Button.Primary}"/>
    <Style x:Key="ModuleToolbarSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource Button.Secondary}"/>
    <Style x:Key="AccentChip" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Padding" Value="10,4"/>
    </Style>
    <Style x:Key="OutlinedPill" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         12. INPUTS — ONE CANONICAL SYSTEM
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="Input.TextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceInputBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Border.Thin}"/>
        <Setter Property="Padding" Value="{DynamicResource Space.Control}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.App}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Input}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.Regular}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Density.ControlHeight}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Input.ComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceInputBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Border.Thin}"/>
        <Setter Property="Padding" Value="{DynamicResource Space.Control}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.App}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Input}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.Regular}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Density.ControlHeight}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Aliases -->
    <Style x:Key="TextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource Input.TextBox}"/>
    <Style x:Key="ComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource Input.ComboBox}"/>
    <Style x:Key="IntInputStyle" TargetType="TextBox" BasedOn="{StaticResource Input.TextBox}"/>
    <Style x:Key="DecimalInputStyle" TargetType="TextBox" BasedOn="{StaticResource Input.TextBox}"/>
    <Style x:Key="ComboStyle" TargetType="ComboBox" BasedOn="{StaticResource Input.ComboBox}"/>

    <!-- ═══════════════════════════════════════════════════════════════
         13. DATAGRID — ONE CANONICAL
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="DataGrid.Canonical" TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Border.Thin}"/>
        <Setter Property="RowHeight" Value="{DynamicResource Density.RowHeight}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.App}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.DataGrid}"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
    </Style>
    <Style x:Key="DataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource DataGrid.Canonical}"/>

    <!-- ═══════════════════════════════════════════════════════════════
         14. TABS — ONE CANONICAL
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="Tab.Active" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource TabActiveBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Tab}"/>
        <Setter Property="Padding" Value="12,6"/>
    </Style>
    <Style x:Key="Tab.Inactive" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource TabInactiveBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Tab}"/>
        <Setter Property="Padding" Value="12,6"/>
    </Style>
    <Style x:Key="TabCardActiveStyle" TargetType="Border" BasedOn="{StaticResource Tab.Active}"/>
    <Style x:Key="TabCardInactiveStyle" TargetType="Border" BasedOn="{StaticResource Tab.Inactive}"/>

    <!-- ═══════════════════════════════════════════════════════════════
         15. CHIPS / BADGES / PILLS — ONE CANONICAL
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="Chip.Primary" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Border.Thin}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Chip}"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <!-- Hairline separator — thin 1px line for dividers -->
    <Style x:Key="HairlineStyle" TargetType="Rectangle">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Fill" Value="{DynamicResource BorderDefaultBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Opacity" Value="0.6"/>
    </Style>
    <Style x:Key="Badge.Primary" TargetType="Border" BasedOn="{StaticResource Chip.Primary}">
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Badge}"/>
    </Style>
    <Style x:Key="Pill.Primary" TargetType="Border" BasedOn="{StaticResource Chip.Primary}"/>

    <!-- Aliases -->
    <Style x:Key="DbChipStyle" TargetType="Border" BasedOn="{StaticResource Chip.Primary}"/>
    <Style x:Key="DbBadgeStyle" TargetType="Border" BasedOn="{StaticResource Badge.Primary}"/>
    <Style x:Key="DbPillStyle" TargetType="Border" BasedOn="{StaticResource Pill.Primary}"/>

    <!-- ═══════════════════════════════════════════════════════════════
         16. NAVIGATION — ONE CANONICAL
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="Navigation.Item" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Tab}"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         17. FOCUS / HOVER / PRESSED / DISABLED — ONE CANONICAL
    ═══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="State.Hover" Color="#140369A1"/>
    <SolidColorBrush x:Key="State.Pressed" Color="#220369A1"/>
    <SolidColorBrush x:Key="State.Focus" Color="#FF0369A1"/>
    <SolidColorBrush x:Key="State.Disabled" Color="#6647554E"/>
    <SolidColorBrush x:Key="State.HoverBrush" Color="#140369A1"/>
    <SolidColorBrush x:Key="State.PressedBrush" Color="#220369A1"/>

    <!-- ═══════════════════════════════════════════════════════════════
         18. DASHBOARD GRAMMAR — ALIASES TO CANONICAL
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="DbTileStyle" TargetType="Border" BasedOn="{StaticResource SurfaceKpiStyle}"/>
    <Style x:Key="DbSectionHeadStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="DbKpiLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource Typography.Label}"/>
    <Style x:Key="DbKpiValueStyle" TargetType="TextBlock" BasedOn="{StaticResource Typography.Kpi}"/>
    <Style x:Key="DbKpiFootStyle" TargetType="TextBlock" BasedOn="{StaticResource Typography.Caption}"/>
    <Style x:Key="DbGlyphStyle" TargetType="TextBlock" BasedOn="{StaticResource Typography.Icon}"/>


    <!-- Auto-generated color tokens for remaining hardcoded hex in Views -->
    <SolidColorBrush x:Key="Splash.DarkTealBrush.Alpha14.80" Color="#14808080"/>
    <SolidColorBrush x:Key="Splash.TealBrush.Alpha28.80" Color="#28808080"/>
    <SolidColorBrush x:Key="White.Alpha33" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="White.Alpha4C" Color="#4CFFFFFF"/>
    <SolidColorBrush x:Key="Black.Alpha0D" Color="#0D000000"/>
    <SolidColorBrush x:Key="About.GlowBrush1.Alpha59" Color="#59FFFFFF"/>
    <SolidColorBrush x:Key="White.Alpha12" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="Splash.TealBrush.Alpha18.80" Color="#18808080"/>
    <SolidColorBrush x:Key="Splash.TealBrush.Alpha22.80" Color="#22808080"/>

</ResourceDictionary>
