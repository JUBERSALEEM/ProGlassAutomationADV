    <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}"/>
    <Style x:Key="SectionCardStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}"/>
    <Style x:Key="SoftCardStyle" TargetType="Border" BasedOn="{StaticResource SurfaceSecondaryStyle}"/>
    <Style x:Key="DashCardStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}"/>
    <Style x:Key="IndustrialDashboardCardStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}"/>
