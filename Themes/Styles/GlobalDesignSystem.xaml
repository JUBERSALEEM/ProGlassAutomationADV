        <Setter Property="FontSize" Value="{DynamicResource FontSize.Icon}"/>
    </Style>

    <!-- Backward compat aliases for existing TypographyStyles.xaml -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource Typography.H1}"/>
