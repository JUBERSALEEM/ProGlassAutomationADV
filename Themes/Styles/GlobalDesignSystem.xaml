        <Setter Property="Padding" Value="{DynamicResource Space.Tile}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Density.KpiTileMinHeight}"/>
    </Style>
    <Style x:Key="SurfaceGlassStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}">
        <Setter Property="Background" Value="{DynamicResource GlassSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Surface.Glass.Border}"/>
        <Setter Property="Effect" Value="{x:Null}"/>
    </Style>

    <!-- Aliases — all competing card systems now point to ONE canonical -->
    <Style x:Key="ModuleSectionCardStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}"/>
    <Style x:Key="PrimarySurfaceCardStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}"/>
    <Style x:Key="SecondarySurfaceCardStyle" TargetType="Border" BasedOn="{StaticResource SurfaceSecondaryStyle}"/>
    <Style x:Key="DetailSurfaceCardStyle" TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}"/>
