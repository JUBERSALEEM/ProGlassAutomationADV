    <Style x:Key="SurfaceSecondaryStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}">
        <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/>
        <Setter Property="Padding" Value="{DynamicResource Space.Card}"/>
    </Style>
    <Style x:Key="SurfaceDetailStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}">
        <Setter Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}"/>
        <Setter Property="Padding" Value="{DynamicResource Space.Tile}"/>
