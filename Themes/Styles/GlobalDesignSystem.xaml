    <DynamicResource x:Key="TypographyHeadingWeight" ResourceKey="Weight.SemiBold"/>
    <DynamicResource x:Key="TypographyTitleWeight" ResourceKey="Weight.Bold"/>
    <DynamicResource x:Key="TypographyDisplayWeight" ResourceKey="Weight.Bold"/>

