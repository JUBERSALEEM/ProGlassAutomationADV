<!--
    FILE: Themes/Styles/GlobalDesignSystem.xaml
    PROJECT: ProGlassAutomationADV — ONE AUTHORITATIVE DESIGN SYSTEM
    VERSION: 2026-09-13 — Global UI Architecture

    PURPOSE: Single source of truth for ALL visual tokens.
    Replaces 7 competing card systems, 4 radius systems, 5 color systems.

    ARCHITECTURE: Theme → Design Tokens → Global Styles → Controls → Cards/Surfaces → Every View
    All tokens are DynamicResource so ThemeManager can publish at runtime.

    LOAD ORDER: Must be merged LAST in App.xaml (after all other dictionaries) so it wins.
    No view should define local visual tokens — all consume from here.

    TOKENS:
      - FontFamily: App (Segoe UI Variable), Icon (Segoe MDL2 Assets)
      - FontWeight: Regular, Medium, SemiBold, Bold
      - FontSize: Display, H1, H2, H3, Title, Subtitle, Body, BodySmall, Label, Caption, Kpi, Button, Navigation, DataGrid, Money, Icon
      - Radius: Small=6, Medium=10, Large=12, XLarge=16, 2XLarge=20, Full=999, Control=8, Card=12, Dialog=16, Chip=999, Tab=8, Input=8, Panel=14, etc.
      - Border: Thin=1, Default=1, Strong=1.5
      - Spacing: Xs=4, Sm=8, Md=12, Lg=16, Xl=24, 2Xl=32, 3Xl=40, Page, Card, Tile, Gutter
      - Density: DbPageMargin, DbCardPadding, DbTilePadding, DbGutter, DbGutterHalfMargin, DbKpiTileMinHeight, DbChartMinHeight (published by ThemeManager.ApplyDisplayDensity)
      - Shadows: Soft, Medium, Large, XLarge, Card, Popup, Dialog
      - Surfaces: Primary, Secondary, Detail, Elevated, Kpi, Glass (with BackgroundBrush, BorderBrush, BorderThickness, CornerRadius, Padding, Effect)
      - Colors: PrimaryForeground, SecondaryForeground, MutedForeground, Accent, Success, Warning, Danger, Tint*, Background, etc.
      - Special: PaperBrush (#FFFFFF for printable), Splash, Chart, AboutGlow, Wizard

    STYLES:
      - SurfacePrimaryStyle, SurfaceSecondaryStyle, SurfaceDetailStyle, SurfaceElevatedStyle, SurfaceKpiStyle, SurfaceGlassStyle
      - Aliases: DbCardStyle, DbRowCardStyle, DbPipelineCardStyle, ModuleSectionCardStyle, CardStyle, SectionCardStyle, StatCardStyle, etc. all BasedOn Surface*
      - Typography: DisplayStyle, H1Style, H2Style, H3Style, TitleStyle, SubtitleStyle, BodyStyle, BodySmallStyle, LabelStyle, CaptionStyle, KpiStyle, ButtonTextStyle, NavigationStyle, DataGridStyle, etc.
      - Buttons: PrimaryButtonStyle, SecondaryButtonStyle, ModuleToolbarPrimaryButtonStyle, ModuleToolbarSecondaryButtonStyle, AccentChip, OutlinedPill, Ghost, etc.
      - Inputs: TextBoxStyle, ComboBoxStyle, IntInputStyle, DecimalInputStyle, etc.
      - DataGrid, Tabs, Lists, Navigation, Chips/Badges
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ═══════════════════════════════════════════════════════════════
         1. FONT FAMILY — ONE CANONICAL
    ═══════════════════════════════════════════════════════════════ -->
    <!-- App font: Segoe UI Variable (WPF native, Inter would require embedding; keep Segoe for now but tokenized) -->
    <FontFamily x:Key="FontFamily.App">Segoe UI Variable, Segoe UI, Inter, sans-serif</FontFamily>
    <FontFamily x:Key="FontFamily.Icon">Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="FontFamily.Code">Consolas, Cascadia Code, monospace</FontFamily>
    <!-- Aliases for backward compat -->
    <FontFamily x:Key="IconFontFamily">Segoe MDL2 Assets</FontFamily>
    <DynamicResource x:Key="AppFontFamily" ResourceKey="FontFamily.App"/>
    <DynamicResource x:Key="AppFontFamilyVariable" ResourceKey="FontFamily.App"/>

