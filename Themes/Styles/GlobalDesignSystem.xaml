    <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource Typography.Label}"/>
    <Style x:Key="TableHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource Typography.Label}"/>
    <Style x:Key="HeroNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource Typography.Display}"/>
    <Style x:Key="StatNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource Typography.Kpi}"/>
