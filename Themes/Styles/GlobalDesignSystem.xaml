    <!-- ═══════════════════════════════════════════════════════════════
         12b. POLYMORPHIC SURFACE STYLES (post-splash crash fix, 2026-09-14)
         The canonical Surface* card styles target Border (and the
         Typography* styles target TextBlock). WPF throws
         "TargetType does not match type of element" when one of them is
         applied to a Button / StackPanel / ListBox / RadioButton — and
         ~150 view sites do exactly that (mostly the Settings pages).
         These companions provide the same surface vocabulary for the
         other element families, so views keep their intended look
         without a TargetType crash.
    ═══════════════════════════════════════════════════════════════ -->
    <!-- Panel-family surfaces. NOTE: WPF's Panel family (StackPanel /
         UniformGrid / Grid) has NO Padding, CornerRadius or Border*
         properties — those live on Border/Control. The ~136 view sites
         that asked for a padded, filled panel are written as
         <Border Surface*PanelTile/Detail/PrimaryStyle><StackPanel/>…</Border>
         instead (see the 12b migration notes at each call site). -->
    <Style x:Key="SurfacePanelTileStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}"/>
        <Setter Property="Padding" Value="{DynamicResource Space.Card}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <!-- Button family — clickable surface rows (Quick Settings panel,
         report export buttons). Same template shape as Button.Primary. -->
    <Style x:Key="SurfacePrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Border.Thin}"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.App}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Button}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.9"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.8"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SurfaceDetailButtonStyle" TargetType="Button" BasedOn="{StaticResource SurfacePrimaryButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.Regular}"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <!-- ListBox family — card-styled list containers. -->
    <Style x:Key="SurfaceSecondaryListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Border.Default}"/>
        <Setter Property="Padding" Value="{DynamicResource Space.Card}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.App}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <!-- ListBoxItem container variants (ItemContainerStyle). A Border-target
         style (Tab.Inactive / Badge.Primary / SurfaceDetailStyle) throws when
         WPF applies it to the generated ListBoxItem containers. -->
    <Style x:Key="Tab.InactiveItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="{DynamicResource TabInactiveBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.App}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Button}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.Tab}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TabHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TabActiveBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ChipListItemStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Border.Thin}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.App}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Chip}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Tab-filter controls (status tabs are Buttons / RadioButtons, not
         Borders). Pill template on the shared ButtonBase so both element
         families can legally inherit it; the RadioButton variant adds the
         checked state (live accent). -->
    <Style x:Key="Tab.InactiveBase" TargetType="ButtonBase">
        <Setter Property="Background" Value="{DynamicResource TabInactiveBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.App}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Button}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.Tab}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TabHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Tab.InactiveControl" TargetType="Button" BasedOn="{StaticResource Tab.InactiveBase}"/>
    <Style x:Key="Tab.InactiveRadio" TargetType="RadioButton" BasedOn="{StaticResource Tab.InactiveBase}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource TabActiveBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

