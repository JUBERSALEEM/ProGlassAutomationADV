<!--
    FILE: Themes/Styles/GlobalDesignSystem.xaml
    PROJECT: ProGlassAutomationADV — ONE AUTHORITATIVE DESIGN SYSTEM
    VERSION: 2026-09-13 — Global UI Architecture
    PURPOSE: Single source of truth for ALL visual tokens.
    Replaces 7 competing card systems, 4 radius systems, 5 color systems.
    ARCHITECTURE: Theme → Design Tokens → Global Styles → Controls → Cards/Surfaces → Every View
    All tokens are DynamicResource so ThemeManager can publish at runtime.
    LOAD ORDER: Must be merged LAST in App.xaml (after all other dictionaries) so it wins.
    No view should define local visual tokens — all consume from here.
    TOKENS:
      - FontFamily: App (Segoe UI Variable), Icon (Segoe MDL2 Assets)
      - FontWeight: Regular, Medium, SemiBold, Bold
      - FontSize: Display, H1, H2, H3, Title, Subtitle, Body, BodySmall, Label, Caption, Kpi, Button, Navigation, DataGrid, Money, Icon
      - Radius: Small=6, Medium=10, Large=12, XLarge=16, 2XLarge=20, Full=999, Control=8, Card=12, Dialog=16, Chip=999, Tab=8, Input=8, Panel=14, etc.
      - Border: Thin=1, Default=1, Strong=1.5
      - Spacing: Xs=4, Sm=8, Md=12, Lg=16, Xl=24, 2Xl=32, 3Xl=40, Page, Card, Tile, Gutter
      - Density: DbPageMargin, DbCardPadding, DbTilePadding, DbGutter, DbGutterHalfMargin, DbKpiTileMinHeight, DbChartMinHeight (published by ThemeManager.ApplyDisplayDensity)
      - Shadows: Soft, Medium, Large, XLarge, Card, Popup, Dialog
      - Surfaces: Primary, Secondary, Detail, Elevated, Kpi, Glass (with BackgroundBrush, BorderBrush, BorderThickness, CornerRadius, Padding, Effect)
      - Colors: PrimaryForeground, SecondaryForeground, MutedForeground, Accent, Success, Warning, Danger, Tint*, Background, etc.
      - Special: PaperBrush (#FFFFFF for printable), Splash, Chart, AboutGlow, Wizard
    STYLES:
      - SurfacePrimaryStyle, SurfaceSecondaryStyle, SurfaceDetailStyle, SurfaceElevatedStyle, SurfaceKpiStyle, SurfaceGlassStyle
      - Aliases: DbCardStyle, DbRowCardStyle, DbPipelineCardStyle, ModuleSectionCardStyle, CardStyle, SectionCardStyle, StatCardStyle, etc. all BasedOn Surface*
      - Typography: DisplayStyle, H1Style, H2Style, H3Style, TitleStyle, SubtitleStyle, BodyStyle, BodySmallStyle, LabelStyle, CaptionStyle, KpiStyle, ButtonTextStyle, NavigationStyle, DataGridStyle, etc.
      - Buttons: PrimaryButtonStyle, SecondaryButtonStyle, ModuleToolbarPrimaryButtonStyle, ModuleToolbarSecondaryButtonStyle, AccentChip, OutlinedPill, Ghost, etc.
      - Inputs: TextBoxStyle, ComboBoxStyle, IntInputStyle, DecimalInputStyle, etc.
      - DataGrid, Tabs, Lists, Navigation, Chips/Badges
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ═══════════════════════════════════════════════════════════════
         1. FONT FAMILY — ONE CANONICAL
    ═══════════════════════════════════════════════════════════════ -->
    <!-- App font: Segoe UI Variable (WPF native, Inter would require embedding; keep Segoe for now but tokenized) -->
    <FontFamily x:Key="FontFamily.App">Segoe UI Variable, Segoe UI, Inter, sans-serif</FontFamily>
    <FontFamily x:Key="FontFamily.Icon">Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="FontFamily.Code">Consolas, Cascadia Code, monospace</FontFamily>
    <!-- Aliases for backward compat.
         CONCRETE VALUES, not markup-extension aliases: a
         <DynamicResource x:Key=...> entry stores a ResourceReferenceExpression
         marker object as the resource VALUE, which crashes property assignment
         ("ResourceReferenceExpression is not a valid value for property 'FontFamily'").
         FontService.ApplySavedFont republishes AppFontFamily on Application
         resources at startup, so live font switching still works. -->
    <FontFamily x:Key="IconFontFamily">Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="AppFontFamilyVariable">Segoe UI Variable, Segoe UI</FontFamily>

    <!-- ═══════════════════════════════════════════════════════════════
         2. FONT WEIGHT — ONE CANONICAL (replaces 99.7% hardcoded)
    ═══════════════════════════════════════════════════════════════ -->
    <FontWeight x:Key="Weight.Regular">Normal</FontWeight>
    <FontWeight x:Key="Weight.Medium">Medium</FontWeight>
    <FontWeight x:Key="Weight.SemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="Weight.Bold">Bold</FontWeight>
    <FontWeight x:Key="FontWeight.Regular">Normal</FontWeight>
    <FontWeight x:Key="FontWeight.Medium">Medium</FontWeight>
    <FontWeight x:Key="FontWeight.SemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeight.Bold">Bold</FontWeight>
    <!-- Aliases for SemanticTypography — concrete weights (markup-extension
         alias entries store ResourceReferenceExpression markers as the value
         and crash when assigned to FontWeight). Weights are design constants;
         they never change at runtime, so no live tracking is needed. -->
    <FontWeight x:Key="TypographyBodyWeight">Normal</FontWeight>
    <FontWeight x:Key="TypographyLabelWeight">SemiBold</FontWeight>
    <FontWeight x:Key="TypographyHeadingWeight">SemiBold</FontWeight>
    <FontWeight x:Key="TypographyTitleWeight">Bold</FontWeight>
    <FontWeight x:Key="TypographyDisplayWeight">Bold</FontWeight>

    <!-- ═══════════════════════════════════════════════════════════════
         3. FONT SIZE — ONE CANONICAL TYPOGRAPHY SCALE
         Replaces 97.9% static + hardcoded. All DynamicResource.
         Display 32, H1 24, H2 20, H3 16, Title 14, Subtitle 13, Body 13, BodySmall 12, Label 11, Caption 10, KPI 24, Button 13, Navigation 13, DataGrid 12
    ═══════════════════════════════════════════════════════════════ -->
    <!-- Base sizes -->
    <sys:Double x:Key="FontSize.Display">32</sys:Double>
    <sys:Double x:Key="FontSize.H1">24</sys:Double>
    <sys:Double x:Key="FontSize.H2">20</sys:Double>
    <sys:Double x:Key="FontSize.H3">16</sys:Double>
    <sys:Double x:Key="FontSize.Title">14</sys:Double>
    <sys:Double x:Key="FontSize.Subtitle">13</sys:Double>
    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.BodySmall">12</sys:Double>
    <sys:Double x:Key="FontSize.Label">11</sys:Double>
    <sys:Double x:Key="FontSize.Caption">10</sys:Double>
    <sys:Double x:Key="FontSize.Kpi">24</sys:Double>
    <sys:Double x:Key="FontSize.Button">13</sys:Double>
    <sys:Double x:Key="FontSize.Navigation">13</sys:Double>
    <sys:Double x:Key="FontSize.DataGrid">12</sys:Double>
    <sys:Double x:Key="FontSize.Money">24</sys:Double>
    <sys:Double x:Key="FontSize.Icon">16</sys:Double>
    <sys:Double x:Key="FontSize.Input">13</sys:Double>
    <sys:Double x:Key="FontSize.Tab">13</sys:Double>
    <sys:Double x:Key="FontSize.Chip">11</sys:Double>
    <sys:Double x:Key="FontSize.Badge">10</sys:Double>

    <!-- Aliases for existing TypeScaleTokens.
         These MUST stay StaticResource (same-file target): they resolve to a
         concrete Double at dictionary load. A <DynamicResource x:Key=...>
         entry would instead store a ResourceReferenceExpression marker as the
         value and crash any template assigning it to FontSize. -->
    <StaticResource x:Key="TextXSmall" ResourceKey="FontSize.Caption"/>
    <StaticResource x:Key="TextCaption" ResourceKey="FontSize.BodySmall"/>
    <StaticResource x:Key="TextBody" ResourceKey="FontSize.Body"/>
    <StaticResource x:Key="TextBodyLarge" ResourceKey="FontSize.Title"/>
    <StaticResource x:Key="TextSection" ResourceKey="FontSize.H3"/>
    <StaticResource x:Key="TextSubhead" ResourceKey="FontSize.H3"/>
    <StaticResource x:Key="TextTitle" ResourceKey="FontSize.H2"/>
    <StaticResource x:Key="TextTitleLarge" ResourceKey="FontSize.H1"/>
    <StaticResource x:Key="TextHeadline" ResourceKey="FontSize.H1"/>
    <StaticResource x:Key="TextDisplay" ResourceKey="FontSize.Kpi"/>
    <StaticResource x:Key="TextDisplayLarge" ResourceKey="FontSize.Display"/>

    <!-- SemanticTypography aliases — StaticResource (concrete doubles at load).
         ThemeManager.ApplyDisplayDensity republishes TypographyBodySize /
         TypographyTitleSize / TypographyKpiValueFontSize on Application
         resources at startup, so density-driven sizes still track live. -->
    <StaticResource x:Key="TypographyDisplaySize" ResourceKey="FontSize.Display"/>
    <StaticResource x:Key="TypographyH1Size" ResourceKey="FontSize.H1"/>
    <StaticResource x:Key="TypographyH2Size" ResourceKey="FontSize.H2"/>
    <StaticResource x:Key="TypographyTitleSize" ResourceKey="FontSize.H2"/>
    <StaticResource x:Key="TypographySubtitleSize" ResourceKey="FontSize.Title"/>
    <StaticResource x:Key="TypographyBodySize" ResourceKey="FontSize.Body"/>
    <StaticResource x:Key="TypographyBodySmallSize" ResourceKey="FontSize.BodySmall"/>
    <StaticResource x:Key="TypographyCaptionSize" ResourceKey="FontSize.Caption"/>
    <StaticResource x:Key="TypographyLabelSize" ResourceKey="FontSize.Label"/>
    <StaticResource x:Key="TypographyKpiValueSize" ResourceKey="FontSize.Kpi"/>
    <StaticResource x:Key="TypographyMoneySize" ResourceKey="FontSize.Money"/>
    <StaticResource x:Key="TypographyIconSize" ResourceKey="FontSize.Icon"/>

    <!-- Type.* aliases — StaticResource (concrete doubles at load) -->
    <StaticResource x:Key="Type.Caption" ResourceKey="FontSize.Caption"/>
    <StaticResource x:Key="Type.Small" ResourceKey="FontSize.BodySmall"/>
    <StaticResource x:Key="Type.Body" ResourceKey="FontSize.Body"/>
    <StaticResource x:Key="Type.BodyLarge" ResourceKey="FontSize.Title"/>
    <StaticResource x:Key="Type.Section" ResourceKey="FontSize.H3"/>
    <StaticResource x:Key="Type.Title" ResourceKey="FontSize.H2"/>
    <StaticResource x:Key="Type.H2" ResourceKey="FontSize.H2"/>
    <StaticResource x:Key="Type.H1" ResourceKey="FontSize.H1"/>
    <StaticResource x:Key="Type.Display" ResourceKey="FontSize.Display"/>
    <StaticResource x:Key="Type.NumericValue" ResourceKey="FontSize.Kpi"/>
    <StaticResource x:Key="Type.Money" ResourceKey="FontSize.Money"/>

    <!-- Density aliases (for backward compat) — StaticResource (concrete doubles
         at load). ThemeManager.ApplyDisplayDensity republishes these three keys
         on Application resources at startup, so density switching still wins. -->
    <StaticResource x:Key="DensityBodyFontSize" ResourceKey="FontSize.Body"/>
    <StaticResource x:Key="DensityTitleFontSize" ResourceKey="FontSize.H2"/>
    <StaticResource x:Key="DensityKpiValueFontSize" ResourceKey="FontSize.Kpi"/>

    <!-- ═══════════════════════════════════════════════════════════════
         4. GEOMETRY — ONE CANONICAL RADIUS SCALE
         Replaces 70 hardcoded CornerRadius. All DynamicResource.
         Small=6, Medium=10, Large=12, XLarge=16, 2XLarge=20, Full=999
         Control=8, Card=12, Dialog=16, Chip=999, Tab=8, Input=8, Panel=14
    ═══════════════════════════════════════════════════════════════ -->
    <CornerRadius x:Key="Radius.None">0</CornerRadius>
    <CornerRadius x:Key="Radius.XSmall">3</CornerRadius>
    <CornerRadius x:Key="Radius.Small">6</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">10</CornerRadius>
    <CornerRadius x:Key="Radius.Large">12</CornerRadius>
    <CornerRadius x:Key="Radius.XLarge">16</CornerRadius>
    <CornerRadius x:Key="Radius.2XLarge">20</CornerRadius>
    <CornerRadius x:Key="Radius.Full">999</CornerRadius>

    <!-- Semantic aliases -->
    <CornerRadius x:Key="Radius.Control">8</CornerRadius>
    <CornerRadius x:Key="Radius.Card">12</CornerRadius>
    <CornerRadius x:Key="Radius.Dialog">16</CornerRadius>
    <CornerRadius x:Key="Radius.Chip">999</CornerRadius>
    <CornerRadius x:Key="Radius.Tab">8</CornerRadius>
    <CornerRadius x:Key="Radius.Input">8</CornerRadius>
    <CornerRadius x:Key="Radius.Panel">14</CornerRadius>
    <CornerRadius x:Key="Radius.Button">8</CornerRadius>
    <CornerRadius x:Key="Radius.Badge">999</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>
    <CornerRadius x:Key="Radius.Hero">18</CornerRadius>

    <!-- Asymmetric -->
    <CornerRadius x:Key="Radius.Top.Medium">10,10,0,0</CornerRadius>
    <CornerRadius x:Key="Radius.Bottom.Medium">0,0,10,10</CornerRadius>
    <CornerRadius x:Key="Radius.Left.Medium">10,0,0,10</CornerRadius>
    <CornerRadius x:Key="Radius.Right.Medium">0,10,10,0</CornerRadius>

    <!-- Aliases for existing keys.
         CONCRETE VALUES (fallbacks), not markup-extension aliases — a
         <DynamicResource x:Key=...> entry stores a ResourceReferenceExpression
         marker as the value and crashes CornerRadius assignment. Live tracking:
         ThemeManager.ApplyCardCornerRadius republishes CardCornerRadius /
         ControlCornerRadius / CardCornerRadiusLarge on Application resources at
         startup, and ApplySemanticSurfaces republishes Surface.*.CornerRadius
         from the saved appearance. -->
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="CardCornerRadiusLarge">16</CornerRadius>
    <CornerRadius x:Key="Surface.Primary.CornerRadius">12</CornerRadius>
    <CornerRadius x:Key="Surface.Secondary.CornerRadius">12</CornerRadius>
    <CornerRadius x:Key="Surface.Detail.CornerRadius">10</CornerRadius>

    <!-- Legacy aliases -->
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">14</CornerRadius>
    <CornerRadius x:Key="RadiusFull">999</CornerRadius>

    <!-- ═══════════════════════════════════════════════════════════════
         5. BORDER THICKNESS — ONE CANONICAL
    ═══════════════════════════════════════════════════════════════ -->
    <Thickness x:Key="Border.Thin">1</Thickness>
    <Thickness x:Key="Border.Default">1</Thickness>
    <Thickness x:Key="Border.Strong">1.5</Thickness>
    <Thickness x:Key="Border.None">0</Thickness>
    <Thickness x:Key="Border.Hairline">1</Thickness>
    <Thickness x:Key="Border.HairlineThickness">1</Thickness>
    <Thickness x:Key="Border.StrongThickness">1.5</Thickness>
    <Thickness x:Key="Border.TopHairline">0,1,0,0</Thickness>
    <Thickness x:Key="Border.BottomHairline">0,0,0,1</Thickness>
    <Thickness x:Key="Border.LeftHairline">1,0,0,0</Thickness>
    <Thickness x:Key="Border.RightHairline">0,0,1,0</Thickness>
    <Thickness x:Key="Border.VerticalHairline">1,0,1,0</Thickness>
    <Thickness x:Key="Border.HorizontalHairline">0,1,0,1</Thickness>
    <Thickness x:Key="Border.BoxNoLeft">0,1,1,1</Thickness>
    <Thickness x:Key="Border.BoxNoTop">1,0,1,1</Thickness>

    <!-- Aliases — CONCRETE VALUES (fallbacks). ThemeManager republishes
         CardBorderThickness / CardEdgeThickness and the Border.*Hairline*
         family on Application resources at startup, so live card-edge
         changes still win over these merged-dictionary fallbacks. -->
    <Thickness x:Key="CardBorderThickness">1</Thickness>
    <Thickness x:Key="CardEdgeThickness">1.5</Thickness>
    <Thickness x:Key="BorderThin">1</Thickness>
    <Thickness x:Key="BorderDefault">1</Thickness>
    <Thickness x:Key="BorderStrong">1.5</Thickness>
    <Thickness x:Key="Border.TopHairlineThickness">0,1,0,0</Thickness>
    <Thickness x:Key="Border.BottomHairlineThickness">0,0,0,1</Thickness>
    <Thickness x:Key="Border.LeftHairlineThickness">1,0,0,0</Thickness>
    <Thickness x:Key="Border.RightHairlineThickness">0,0,1,0</Thickness>
    <Thickness x:Key="Border.VerticalHairlineThickness">1,0,1,0</Thickness>
    <Thickness x:Key="Border.HorizontalHairlineThickness">0,1,0,1</Thickness>

    <!-- ═══════════════════════════════════════════════════════════════
         6. SPACING — ONE CANONICAL
    ═══════════════════════════════════════════════════════════════ -->
    <sys:Double x:Key="Space.Xs">4</sys:Double>
    <sys:Double x:Key="Space.Sm">8</sys:Double>
    <sys:Double x:Key="Space.Md">12</sys:Double>
    <sys:Double x:Key="Space.Lg">16</sys:Double>
    <sys:Double x:Key="Space.Xl">24</sys:Double>
    <sys:Double x:Key="Space.2Xl">32</sys:Double>
    <sys:Double x:Key="Space.3Xl">40</sys:Double>

    <Thickness x:Key="Space.Page">12</Thickness>
    <Thickness x:Key="Space.Card">12,9</Thickness>
    <Thickness x:Key="Space.Tile">13,11</Thickness>
    <Thickness x:Key="Space.Gutter">8</Thickness>
    <Thickness x:Key="Space.GutterHalf">4</Thickness>
    <Thickness x:Key="Space.Section">12,0,12,12</Thickness>
    <Thickness x:Key="Space.Control">12,0</Thickness>
    <Thickness x:Key="Space.Dialog">24</Thickness>
    <Thickness x:Key="Space.Toolbar">12,8</Thickness>

    <!-- Aliases for SemanticSpacing — CONCRETE VALUES. ThemeManager.
         ApplyDisplayDensity republishes PagePadding / CardPadding on
         Application resources at startup (density-dependent); the rest are
         design constants. -->
    <sys:Double x:Key="SpacingXS">4</sys:Double>
    <sys:Double x:Key="SpacingSM">8</sys:Double>
    <sys:Double x:Key="SpacingMD">12</sys:Double>
    <sys:Double x:Key="SpacingLG">16</sys:Double>
    <sys:Double x:Key="SpacingXL">24</sys:Double>
    <sys:Double x:Key="SpacingXXL">32</sys:Double>
    <Thickness x:Key="PagePadding">12</Thickness>
    <Thickness x:Key="SectionSpacing">12,0,12,12</Thickness>
    <Thickness x:Key="CardPadding">12,9</Thickness>
    <Thickness x:Key="ControlPadding">12,0</Thickness>
    <Thickness x:Key="DialogPadding">24</Thickness>
    <Thickness x:Key="ToolbarPadding">12,8</Thickness>

    <!-- Density (published by ThemeManager.ApplyDisplayDensity) — fallbacks -->
    <Thickness x:Key="Density.PageMargin">12</Thickness>
    <Thickness x:Key="Density.CardPadding">12,9</Thickness>
    <Thickness x:Key="Density.TilePadding">13,11</Thickness>
    <Thickness x:Key="Density.Gutter">8</Thickness>
    <Thickness x:Key="Density.GutterHalf">4</Thickness>
    <sys:Double x:Key="Density.KpiTileMinHeight">86</sys:Double>
    <sys:Double x:Key="Density.ChartMinHeight">220</sys:Double>

    <!-- Db* aliases (modern dashboard grammar) — CONCRETE Compact-density
         fallbacks. ThemeManager.ApplyDisplayDensity republishes every Db* key
         on Application resources at startup, so the saved density always wins. -->
    <Thickness x:Key="DbPageMargin">10,6,10,6</Thickness>
    <Thickness x:Key="DbCardPadding">14,13,14,13</Thickness>
    <Thickness x:Key="DbTilePadding">10,8,10,8</Thickness>
    <sys:Double x:Key="DbGutter">8</sys:Double>
    <Thickness x:Key="DbGutterHalfMargin">4</Thickness>
    <sys:Double x:Key="DbKpiTileMinHeight">80</sys:Double>
    <sys:Double x:Key="DbChartMinHeight">180</sys:Double>

    <!-- ═══════════════════════════════════════════════════════════════
         7. SHADOWS — ONE CANONICAL
    ═══════════════════════════════════════════════════════════════ -->
    <DropShadowEffect x:Key="Shadow.None" BlurRadius="0" ShadowDepth="0" Opacity="0" Color="#00000000"/>
    <DropShadowEffect x:Key="Shadow.Soft" BlurRadius="8" ShadowDepth="0" Opacity="0.08" Color="#FF0F172A"/>
    <DropShadowEffect x:Key="Shadow.Medium" BlurRadius="16" ShadowDepth="0" Opacity="0.12" Color="#FF0F172A"/>
    <DropShadowEffect x:Key="Shadow.Large" BlurRadius="28" ShadowDepth="0" Opacity="0.18" Color="#FF0F172A"/>
    <DropShadowEffect x:Key="Shadow.XLarge" BlurRadius="36" ShadowDepth="0" Opacity="0.22" Color="#FF0F172A"/>

    <DropShadowEffect x:Key="Shadow.Card" BlurRadius="8" ShadowDepth="0" Opacity="0.08" Color="#FF0F172A"/>
    <DropShadowEffect x:Key="Shadow.Popup" BlurRadius="16" ShadowDepth="0" Opacity="0.12" Color="#FF0F172A"/>
    <DropShadowEffect x:Key="Shadow.Dialog" BlurRadius="28" ShadowDepth="0" Opacity="0.18" Color="#FF0F172A"/>
    <DropShadowEffect x:Key="Shadow.Elevated" BlurRadius="16" ShadowDepth="0" Opacity="0.12" Color="#FF0F172A"/>

    <!-- Aliases for SemanticElevation — StaticResource (same-file targets) so
         each alias resolves to the concrete DropShadowEffect instance at load.
         Effects are design constants; no runtime republish exists for them. -->
    <StaticResource x:Key="ElevationNone" ResourceKey="Shadow.None"/>
    <StaticResource x:Key="ElevationLow" ResourceKey="Shadow.Soft"/>
    <StaticResource x:Key="ElevationMedium" ResourceKey="Shadow.Medium"/>
    <StaticResource x:Key="ElevationHigh" ResourceKey="Shadow.Large"/>
    <StaticResource x:Key="ElevationOverlay" ResourceKey="Shadow.XLarge"/>
    <StaticResource x:Key="ElevationCard" ResourceKey="Shadow.Card"/>
    <StaticResource x:Key="ElevationPopup" ResourceKey="Shadow.Popup"/>
    <StaticResource x:Key="ElevationDialog" ResourceKey="Shadow.Dialog"/>

    <!-- ═══════════════════════════════════════════════════════════════
         8. COLORS & SURFACES — ONE CANONICAL
         All brushes already exist in LightTheme/DarkTheme + SemanticColors.
         Here we define canonical aliases and special-case brushes.
    ═══════════════════════════════════════════════════════════════ -->
    <!-- Paper for printable/document views — intentional #FFFFFF, tokenized -->
    <SolidColorBrush x:Key="PaperBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface.Paper" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ReportPrimaryBrush" Color="#FFFFFF"/>

    <!-- Splash special — tokenized from hardcoded #228080 etc. -->
    <SolidColorBrush x:Key="Splash.TealBrush" Color="#FF228080"/>
    <SolidColorBrush x:Key="Splash.CyanBrush" Color="#FF33FFFF"/>
    <SolidColorBrush x:Key="Splash.DarkTealBrush" Color="#FF148080"/>
    <SolidColorBrush x:Key="Splash.DarkBrush" Color="#FF0D0000"/>
    <SolidColorBrush x:Key="Splash.TealBrush.Semi" Color="#33228080"/>

    <!-- About glow — tokenized from #59FFFF/#00FFFF -->
    <SolidColorBrush x:Key="About.GlowBrush1" Color="#FF59FFFF"/>
    <SolidColorBrush x:Key="About.GlowBrush2" Color="#FF00FFFF"/>
    <SolidColorBrush x:Key="About.GlowBrush1.Soft" Color="#3359FFFF"/>
    <SolidColorBrush x:Key="About.GlowBrush2.Soft" Color="#3300FFFF"/>

    <!-- Auth surface — tokenized from #2EFFFF -->
    <SolidColorBrush x:Key="Auth.SurfaceBrush" Color="#FF2EFFFF"/>
    <SolidColorBrush x:Key="Auth.SurfaceBrush.Soft" Color="#332EFFFF"/>

    <!-- Chart colors — tokenized from #1000FF/#10FF00/#1A22C5 etc. -->
    <SolidColorBrush x:Key="Chart.BlueBrush" Color="#FF1000FF"/>
    <SolidColorBrush x:Key="Chart.GreenBrush" Color="#FF10FF00"/>
    <SolidColorBrush x:Key="Chart.IndigoBrush" Color="#FF1A22C5"/>
    <SolidColorBrush x:Key="Chart.LimeBrush" Color="#FF1AFF3B"/>
    <SolidColorBrush x:Key="Chart.MintBrush" Color="#FF1AFFA5"/>
    <SolidColorBrush x:Key="Chart.NavyBrush" Color="#FF1A3B82"/>
    <SolidColorBrush x:Key="Chart.BlueBrush.Soft" Color="#221000FF"/>
    <SolidColorBrush x:Key="Chart.GreenBrush.Soft" Color="#2210FF00"/>

    <!-- Wizard — tokenized from #00FFFF/#000000/#FFF8FA/#FF1118 -->
    <SolidColorBrush x:Key="Wizard.CyanBrush" Color="#FF00FFFF"/>
    <SolidColorBrush x:Key="Wizard.BlackBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="Wizard.PaperBrush" Color="#FFFFF8FA"/>
    <SolidColorBrush x:Key="Wizard.RedBrush" Color="#FFFF1118"/>
    <SolidColorBrush x:Key="Wizard.CyanBrush.Soft" Color="#3300FFFF"/>

    <!-- Surface hierarchy — canonical 6 levels -->
    <!-- Primary: default card, 12 radius, 12,9 padding, soft shadow -->
    <SolidColorBrush x:Key="Surface.Primary.Background" Color="#F8FFFFFF"/>
    <SolidColorBrush x:Key="Surface.Primary.Border" Color="#2EFFFFFF"/>
    <Thickness x:Key="Surface.Primary.BorderThickness">1.5</Thickness>
    <CornerRadius x:Key="Surface.Primary.Radius">12</CornerRadius>
    <Thickness x:Key="Surface.Primary.Padding">12,9</Thickness>
    <!-- Secondary: muted card -->
    <SolidColorBrush x:Key="Surface.Secondary.Background" Color="#EFFFFFFF"/>
    <SolidColorBrush x:Key="Surface.Secondary.Border" Color="#FFCBD5E1"/>
    <Thickness x:Key="Surface.Secondary.BorderThickness">1</Thickness>
    <CornerRadius x:Key="Surface.Secondary.Radius">12</CornerRadius>
    <Thickness x:Key="Surface.Secondary.Padding">14,9</Thickness>
    <!-- Detail: small inline -->
    <SolidColorBrush x:Key="Surface.Detail.Background" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="Surface.Detail.Border" Color="#FFCBD5E1"/>
    <Thickness x:Key="Surface.Detail.BorderThickness">1</Thickness>
    <CornerRadius x:Key="Surface.Detail.Radius">10</CornerRadius>
    <Thickness x:Key="Surface.Detail.Padding">10,6</Thickness>
    <!-- Elevated: popup/dialog, stronger shadow -->
    <SolidColorBrush x:Key="Surface.Elevated.Background" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Surface.Elevated.Border" Color="#FFCBD5E1"/>
    <Thickness x:Key="Surface.Elevated.BorderThickness">1</Thickness>
    <CornerRadius x:Key="Surface.Elevated.Radius">16</CornerRadius>
    <Thickness x:Key="Surface.Elevated.Padding">16</Thickness>
    <!-- Kpi: stat tiles -->
    <SolidColorBrush x:Key="Surface.Kpi.Background" Color="#F8FFFFFF"/>
    <SolidColorBrush x:Key="Surface.Kpi.Border" Color="#FFCBD5E1"/>
    <Thickness x:Key="Surface.Kpi.BorderThickness">1</Thickness>
    <CornerRadius x:Key="Surface.Kpi.Radius">12</CornerRadius>
    <Thickness x:Key="Surface.Kpi.Padding">13,11</Thickness>
    <!-- Glass: translucent -->
    <SolidColorBrush x:Key="Surface.Glass.Background" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="Surface.Glass.Border" Color="#4DFFFFFF"/>
    <Thickness x:Key="Surface.Glass.BorderThickness">1</Thickness>
    <CornerRadius x:Key="Surface.Glass.Radius">12</CornerRadius>
    <Thickness x:Key="Surface.Glass.Padding">12,9</Thickness>

    <!-- Semantic surface brushes.
         CONCRETE fallback brushes (matching the static Surface.*.Background /
         Surface.*.Border values above), NOT DynamicResource alias entries —
         those store ResourceReferenceExpression markers as the value and crash
         the first Background/BorderBrush assignment after the splash
         (shell sidebar cards, dashboards, DataGrid chrome).
         LIVE TRACKING: ThemeManager.ApplySemanticSurfaces (called at startup
         after ApplyCardCornerRadius, and on every Settings appearance change)
         republishes these six keys on Application resources from the active
         family/mode palette, so light/dark and family switches still re-tint
         every consumer. -->
    <SolidColorBrush x:Key="Surface.Primary.BackgroundBrush" Color="#F8FFFFFF"/>
    <SolidColorBrush x:Key="Surface.Secondary.BackgroundBrush" Color="#EFFFFFFF"/>
    <SolidColorBrush x:Key="Surface.Detail.BackgroundBrush" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="Surface.Primary.BorderBrush" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="Surface.Secondary.BorderBrush" Color="#FFCBD5E1"/>
    <SolidColorBrush x:Key="Surface.Detail.BorderBrush" Color="#FFCBD5E1"/>

    <!-- ═══════════════════════════════════════════════════════════════
         9. SURFACE STYLES — ONE CANONICAL CARD SYSTEM (6 levels)
         Every card in every module must consume these.
         No module-specific CardStyle.
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="SurfacePrimaryStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Border.Default}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}"/>
        <Setter Property="Padding" Value="{DynamicResource Space.Card}"/>
