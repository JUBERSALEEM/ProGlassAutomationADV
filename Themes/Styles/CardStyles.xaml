<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="ProGlassAutomation.Themes.Styles.CardStyles">

    <!-- ═══════════════════════════════════════════════════════════════
         CARD STYLES — The primary building block of the UI.

         BrushKeyConverter is registered in LightTheme.xaml +
         DarkTheme.xaml (loaded BEFORE this dictionary in App.xaml
         MergedDictionaries). Referenced here via StaticResource.

         Do NOT register BrushKeyConverter locally in this file —
         causes "incompatible type" resource conflict.
         Do NOT use DynamicResource on Converter — WPF Binding
         requires StaticResource for converters.
    ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="BaseCardStyle" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource ModuleBackgroundBrush}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="16"/>
        <Setter Property="Padding"         Value="24"/>
        <Setter Property="Margin"          Value="8"/>
    </Style>

    <Style x:Key="ElevatedCardStyle" TargetType="Border"
           BasedOn="{StaticResource BaseCardStyle}">
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0"
                                  Opacity="0.08" Color="#0F4C3A"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TintedCardStyle" TargetType="Border">
        <Setter Property="Background"
                Value="{Binding TintColor,
                        Converter={StaticResource BrushKeyConverter}}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius"    Value="16"/>
        <Setter Property="Padding"         Value="22"/>
        <Setter Property="Margin"          Value="8"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsAlert}" Value="True">
                <Setter Property="BorderBrush"     Value="{DynamicResource DangerBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatCardStyle" TargetType="Border"
           BasedOn="{StaticResource BaseCardStyle}">
        <Setter Property="Padding" Value="18,16"/>
        <Setter Property="Margin"  Value="6"/>
    </Style>

    <Style x:Key="TaskCardStyle" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource ModuleBackgroundBrush}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="14"/>
        <Setter Property="Padding"         Value="18,14"/>
        <Setter Property="Margin"          Value="0,0,0,10"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="0"
                                          Opacity="0.10" Color="#0F4C3A"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PriorityCardStyle" TargetType="Border"
           BasedOn="{StaticResource TaskCardStyle}">
        <Setter Property="BorderThickness" Value="4,1,1,1"/>
        <Setter Property="BorderBrush"
                Value="{Binding PriorityColor,
                        Converter={StaticResource BrushKeyConverter}}"/>
    </Style>

    <Style x:Key="ListRowCardStyle" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource ModuleBackgroundBrush}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="12"/>
        <Setter Property="Padding"         Value="16,12"/>
        <Setter Property="Margin"          Value="0,0,0,6"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HeroCardAccentStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding"      Value="24"/>
        <Setter Property="Margin"       Value="8"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{Binding Source={StaticResource AccentDarkBrush},
                                          Path=Color}" Offset="0"/>
                    <GradientStop Color="{Binding Source={StaticResource AccentLightBrush},
                                          Path=Color}" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HeroCardInfoStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding"      Value="24"/>
        <Setter Property="Margin"       Value="8"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1E40AF" Offset="0"/>
                    <GradientStop Color="#3B82F6" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HeroCardWarningStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding"      Value="24"/>
        <Setter Property="Margin"       Value="8"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#D97706" Offset="0"/>
                    <GradientStop Color="#F59E0B" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HeroCardDangerStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding"      Value="24"/>
        <Setter Property="Margin"       Value="8"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#B91C1C" Offset="0"/>
                    <GradientStop Color="#EF4444" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HeroCardPurpleStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding"      Value="24"/>
        <Setter Property="Margin"       Value="8"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#6D28D9" Offset="0"/>
                    <GradientStop Color="#8B5CF6" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>