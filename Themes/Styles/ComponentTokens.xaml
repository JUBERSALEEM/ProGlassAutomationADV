<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Themes/Styles/ComponentTokens.xaml
     PROJECT: ProGlassAutomation
     MODULE: ProGlass Design System — COMPONENT TOKEN LAYER (Level 4)

     Canonical names as thin BasedOn aliases. Legacy keys stay published.
     Merged AFTER ButtonStyles, PillStyles, ModuleTabStyles, InputStyles,
     DialogStyles, LiquidGlassStyles, PiIndustrialStyles, ListPageStyles,
     DashboardKit so every BasedOn target exists.
     ═══════════════════════════════════════════════════════════════════ -->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── BUTTONS · ProGlassButton ───────────────────────────────────── -->
    <Style x:Key="ProGlassButton.Base"      TargetType="Button" BasedOn="{StaticResource PillButtonBase}"/>
    <Style x:Key="ProGlassButton.Primary"   TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}"/>
    <Style x:Key="ProGlassButton.Secondary" TargetType="Button" BasedOn="{StaticResource OutlinedPillButton}"/>
    <Style x:Key="ProGlassButton.Success"   TargetType="Button" BasedOn="{StaticResource SuccessPillButton}"/>
    <Style x:Key="ProGlassButton.Danger"    TargetType="Button" BasedOn="{StaticResource DangerButton}"/>
    <Style x:Key="ProGlassButton.Tab"       TargetType="Button" BasedOn="{StaticResource TabPillButton}"/>
    <Style x:Key="ProGlassButton.Ghost"     TargetType="Button" BasedOn="{StaticResource LiquidGlassGhostButtonStyle}"/>
    <Style x:Key="ProGlassButton.Link"      TargetType="Button" BasedOn="{StaticResource LiquidGlassLinkButton}"/>
    <Style x:Key="ProGlassButton.Icon"      TargetType="Button" BasedOn="{StaticResource LiquidGlassIconButtonStyle}"/>
    <Style x:Key="ProGlassButton.Action"    TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}"/>
    <Style x:Key="ProGlassButton.Export"    TargetType="Button" BasedOn="{StaticResource ReportExportPrimaryButton}"/>
    <Style x:Key="ProGlassButton.Chip"      TargetType="Button" BasedOn="{StaticResource PiGhostChipButton}"/>

    <Style x:Key="ProGlassButton.RowPrimary"   TargetType="Button" BasedOn="{StaticResource RowPrimaryButton}"/>
    <Style x:Key="ProGlassButton.RowSecondary" TargetType="Button" BasedOn="{StaticResource RowOutlinedButton}"/>
    <Style x:Key="ProGlassButton.RowSuccess"   TargetType="Button" BasedOn="{StaticResource RowSuccessButton}"/>
    <Style x:Key="ProGlassButton.RowDanger"    TargetType="Button" BasedOn="{StaticResource RowDangerButton}"/>

    <Style x:Key="ProGlassButton.ReportPrimary"   TargetType="Button" BasedOn="{StaticResource ReportToolbarPrimaryButton}"/>
    <Style x:Key="ProGlassButton.ReportSecondary" TargetType="Button" BasedOn="{StaticResource ReportToolbarOutlinedButton}"/>
    <Style x:Key="ProGlassButton.ExportPrimary"   TargetType="Button" BasedOn="{StaticResource ReportExportPrimaryButton}"/>
    <Style x:Key="ProGlassButton.ExportSecondary" TargetType="Button" BasedOn="{StaticResource ReportExportOutlinedButton}"/>

    <!-- ── TOGGLE · one primitive, three legacy names ─────────────────── -->
    <Style x:Key="ProGlassToggle" TargetType="ToggleButton" BasedOn="{StaticResource LiquidGlassToggleSwitch}"/>
    <Style x:Key="ProGlassToggle.Pi" TargetType="ToggleButton" BasedOn="{StaticResource PiToggleSwitch}"/>

    <!-- ── PILLS · ProGlassPill ───────────────────────────────────────── -->
    <Style x:Key="ProGlassPill.Status.Accent"   TargetType="Border" BasedOn="{StaticResource StatusPillAccentStyle}"/>
    <Style x:Key="ProGlassPill.Status.Success"  TargetType="Border" BasedOn="{StaticResource StatusPillSuccessStyle}"/>
    <Style x:Key="ProGlassPill.Status.Warning"  TargetType="Border" BasedOn="{StaticResource StatusPillWarningStyle}"/>
    <Style x:Key="ProGlassPill.Status.Danger"   TargetType="Border" BasedOn="{StaticResource StatusPillDangerStyle}"/>
    <Style x:Key="ProGlassPill.Status.Info"     TargetType="Border" BasedOn="{StaticResource StatusPillInfoStyle}"/>
    <Style x:Key="ProGlassPill.Status.Neutral"  TargetType="Border" BasedOn="{StaticResource StatusPillNeutralStyle}"/>
    <Style x:Key="ProGlassPill.Priority.High"   TargetType="Border" BasedOn="{StaticResource PriorityPillHighStyle}"/>
    <Style x:Key="ProGlassPill.Priority.Medium" TargetType="Border" BasedOn="{StaticResource PriorityPillMediumStyle}"/>
    <Style x:Key="ProGlassPill.Priority.Low"    TargetType="Border" BasedOn="{StaticResource PriorityPillLowStyle}"/>
    <Style x:Key="ProGlassPill.Tag"     TargetType="Border" BasedOn="{StaticResource TagPillStyle}"/>
    <Style x:Key="ProGlassPill.Outline" TargetType="Border" BasedOn="{StaticResource OutlinePillStyle}"/>

    <!-- ── TABS · ProGlassTabs ────────────────────────────────────────── -->
    <Style x:Key="ProGlassTabs.Strip"  TargetType="Border"  BasedOn="{StaticResource ModuleTabStripStyle}"/>
    <Style x:Key="ProGlassTabs.Button" TargetType="Button"  BasedOn="{StaticResource ModuleTabButtonStyle}"/>
    <Style x:Key="ProGlassTabs.Pill"   TargetType="TabItem" BasedOn="{StaticResource PillTabItemStyle}"/>

    <!-- ── INPUTS · ProGlassInput ─────────────────────────────────────── -->
    <Style x:Key="ProGlassInput.TextBox"          TargetType="TextBox"     BasedOn="{StaticResource ModernTextBoxStyle}"/>
    <Style x:Key="ProGlassInput.PasswordBox"      TargetType="PasswordBox" BasedOn="{StaticResource ModernPasswordBoxStyle}"/>
    <Style x:Key="ProGlassInput.ComboBox"         TargetType="ComboBox"    BasedOn="{StaticResource ModernComboBoxStyle}"/>
    <Style x:Key="ProGlassInput.EditableComboBox" TargetType="ComboBox"    BasedOn="{StaticResource ModernEditableComboBoxStyle}"/>
    <Style x:Key="ProGlassInput.Int"              TargetType="TextBox"     BasedOn="{StaticResource IntInputStyle}"/>
    <Style x:Key="ProGlassInput.Decimal"          TargetType="TextBox"     BasedOn="{StaticResource DecimalInputStyle}"/>
    <Style x:Key="ProGlassInput.DatePicker"       TargetType="DatePicker"  BasedOn="{StaticResource LiquidGlassDatePickerStyle}"/>

    <!-- ── KPI · ProGlassKpi ──────────────────────────────────────────── -->
    <Style x:Key="ProGlassKpi.Standard" TargetType="Border" BasedOn="{StaticResource ErpKpiSurfaceStyle}"/>
    <Style x:Key="ProGlassKpi.Compact"  TargetType="Border" BasedOn="{StaticResource PiKpiCellStyle}"/>
    <Style x:Key="ProGlassKpi.Hero"     TargetType="Border" BasedOn="{StaticResource KpiTileHoverStyle}"/>
    <Style x:Key="ProGlassKpi.Strip"    TargetType="Border" BasedOn="{StaticResource ModuleListKpiStripStyle}"/>
    <Style x:Key="ProGlassKpi.Inline"   TargetType="Border" BasedOn="{StaticResource ErpInlineStatusSurfaceStyle}"/>

    <!-- ── DIALOG · ProGlassDialog ────────────────────────────────────── -->
    <Style x:Key="ProGlassDialog.Title"    TargetType="TextBlock" BasedOn="{StaticResource DialogTitleStyle}"/>
    <Style x:Key="ProGlassDialog.Subtitle" TargetType="TextBlock" BasedOn="{StaticResource DialogSubtitleStyle}"/>
    <Style x:Key="ProGlassDialog.Body"     TargetType="TextBlock" BasedOn="{StaticResource DialogBodyTextStyle}"/>
    <Style x:Key="ProGlassDialog.Card"     TargetType="Border"    BasedOn="{StaticResource DialogSectionCardStyle}"/>
    <Style x:Key="ProGlassDialog.Footer"   TargetType="Border"    BasedOn="{StaticResource DialogFooterStyle}"/>
    <Style x:Key="ProGlassDialog.Close"    TargetType="Button"    BasedOn="{StaticResource DialogCloseButtonStyle}"/>

    <!-- ── TOOLTIP ───────────────────────────────────────────────────── -->
    <Style x:Key="ProGlassTooltip" TargetType="ToolTip" BasedOn="{StaticResource AppToolTipStyle}"/>

</ResourceDictionary>
