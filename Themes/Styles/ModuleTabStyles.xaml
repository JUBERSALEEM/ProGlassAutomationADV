<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Themes/Styles/ModuleTabStyles.xaml
     PROJECT: ProGlassAutomation
     MODULE: Shared — module tab strip + God View styles

     Styles powering the tab-switch pattern added to the Delivery Note,
     Job Order and Tax Invoice modules:

        [ Workspace ]   [ God View ]   [ Activity ]

     • ModuleTabStripStyle   — the rounded container behind the tabs
     • ModuleTabButtonStyle  — pill tab button (activate-state styling
                               is added per-button via DataTriggers in
                               each module view, bound to the shell VM's
                               IsGodView / IsActivityView flags)
     • GodKpiCardTemplate    — KPI stat tile used in every God View
     • GodViewGridStyle      — themed DataGrid for the overview tables

     Registered globally from App.xaml — reference via StaticResource.
═══════════════════════════════════════════════════════════════════════ -->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- ══ TAB STRIP CONTAINER ════════════════════════════════════════ -->
    <Style x:Key="ModuleTabStripStyle" TargetType="Border">
        <Setter Property="Background"
                Value="{DynamicResource MenuHoverBrush}"/>
        <Setter Property="CornerRadius"
                Value="{DynamicResource PillCornerRadius}"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ══ TAB BUTTON (base chrome; state triggers added per usage) ═══ -->
    <Style x:Key="ModuleTabButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground"
                Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="Transparent"
                            CornerRadius="{DynamicResource PillCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background"
                                    Value="{DynamicResource BorderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ GOD VIEW — KPI CARD TEMPLATE ═══════════════════════════════
         Binds to GodViewKpiViewModel:
           Icon, Value, Label, TintBrushKey, ValueBrushKey
         Brush keys resolve through the shared BrushKeyConverter so
         cards follow the active theme automatically.
    ═══════════════════════════════════════════════════════════════════ -->
    <DataTemplate x:Key="GodKpiCardTemplate">
        <Border Width="190"
                CornerRadius="{DynamicResource CardCornerRadius}"
                Padding="16,14"
                Margin="0,0,12,12"
                BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}"
                Background="{Binding TintBrushKey,
                             Converter={StaticResource BrushKeyConverter}}"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="40" Height="40"
                        CornerRadius="12"
                        Background="{DynamicResource ModuleBackgroundBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Icon}"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Value}"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{Binding ValueBrushKey,
                                            Converter={StaticResource BrushKeyConverter}}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Label}"
                               FontSize="11"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ══ GOD VIEW — THEMED DATAGRID ═════════════════════════════════ -->
    <Style x:Key="GodViewGridStyle" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush"
                Value="{DynamicResource DividerBrush}"/>
        <Setter Property="Background"
                Value="{DynamicResource ModuleBackgroundBrush}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground"
                Value="{DynamicResource ModuleBackgroundBrush}"/>
        <Setter Property="AlternatingRowBackground"
                Value="{DynamicResource MenuHoverBrush}"/>
        <Setter Property="Foreground"
                Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="RowHeight" Value="36"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
    </Style>

    <!-- Column header look for the God View grids -->
    <Style x:Key="GodViewHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background"
                Value="{DynamicResource ElevatedSurfaceBrush}"/>
        <Setter Property="Foreground"
                Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

</ResourceDictionary>
