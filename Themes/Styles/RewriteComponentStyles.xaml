<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared presentation primitives for the nine-theme rewrite.
         All colors, radii, and elevation resolve through runtime semantic tokens. -->

    <Style x:Key="ProGlassRewriteWorkspaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceWorkspaceBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <!-- Fallbacks keep legacy/migration themes safe; the active nine-family
         painter replaces these application-level resources at runtime. -->
    <SolidColorBrush x:Key="ThemeCardFaceBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ThemeCardEdgeBrush" Color="#FFD8DEE8"/>
    <SolidColorBrush x:Key="ThemeControlFaceBrush" Color="#FFF4F6FA"/>
    <SolidColorBrush x:Key="ThemeControlEdgeBrush" Color="#FFD8DEE8"/>
    <SolidColorBrush x:Key="ThemeCardHighlightBrush" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="ThemeTableSurfaceBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ThemeTableHeaderBrush" Color="#FFF2F4F8"/>
    <SolidColorBrush x:Key="ThemeTableRowHoverBrush" Color="#182D6CDF"/>
    <SolidColorBrush x:Key="ThemeTableSelectionBrush" Color="#663D6DCC"/>
    <SolidColorBrush x:Key="ThemeTableBorderBrush" Color="#FFD8DEE8"/>

    <Style x:Key="ProGlassRewriteCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ThemeCardFaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource CardEdgeThickness}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Effect" Value="{DynamicResource ShadowSoft}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>


    <Style x:Key="ProGlassRewriteControlSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ThemeControlFaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="ProGlassRewriteCardHighlightStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ThemeCardHighlightBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="ProGlassRewriteRaisedCardStyle" TargetType="Border"
           BasedOn="{StaticResource ProGlassRewriteCardStyle}">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
        <Setter Property="Effect" Value="{DynamicResource ShadowElevated}"/>
    </Style>

    <Style x:Key="ProGlassRewriteInsetStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceWorkspaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="ProGlassRewriteToolbarStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="ProGlassRewritePageHeaderStyle" TargetType="Border"
           BasedOn="{StaticResource ProGlassRewriteCardStyle}">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}"/>
        <Setter Property="Padding" Value="20,16"/>
    </Style>

    <Style x:Key="ProGlassRewriteSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="ProGlassRewriteBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="ProGlassRewriteCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

</ResourceDictionary>
