<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared presentation primitives for the nine-theme rewrite.
         All colors, radii, and elevation resolve through runtime semantic tokens. -->

    <Style x:Key="ProGlassRewriteWorkspaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceWorkspaceBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style x:Key="ProGlassRewriteCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource CardEdgeThickness}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Effect" Value="{DynamicResource ShadowSoft}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style x:Key="ProGlassRewriteRaisedCardStyle" TargetType="Border"
           BasedOn="{StaticResource ProGlassRewriteCardStyle}">
        <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/>
        <Setter Property="Effect" Value="{DynamicResource ShadowElevated}"/>
    </Style>

    <Style x:Key="ProGlassRewriteInsetStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceInputBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="ProGlassRewriteToolbarStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="ProGlassRewritePageHeaderStyle" TargetType="Border"
           BasedOn="{StaticResource ProGlassRewriteCardStyle}">
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadiusLarge}"/>
        <Setter Property="Padding" Value="20,16"/>
    </Style>

    <Style x:Key="ProGlassRewriteSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="ProGlassRewriteBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="ProGlassRewriteCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

</ResourceDictionary>
