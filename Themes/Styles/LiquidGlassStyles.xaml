<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:controls="clr-namespace:ProGlassAutomation.Controls">

    <!-- ═══════════════════════════════════════════════════════════════════
         LIQUID GLASS DESIGN SYSTEM (2026-08-29 — global rewrite)

         Clear liquid glass / water glass, Apple-inspired. NOT dark
         glassmorphism, NOT opaque white cards. The effect comes from
         LAYERS, not from a single translucent fill:

           • crystal edge       — LiquidEdgeBrush (bright top, soft
                                  sides, slightly darker lower edge)
           • inner top reflection — LiquidInnerHighlightBrush line
           • diagonal sweep     — LiquidReflectionBrush
           • nearly transparent center — LiquidLiquid* surfaces
           • soft shadow        — LiquidShadowColor (low opacity)

         Every colour resolves through DynamicResource, so runtime
         Light/Dark switching AND the iOS Liquid Glass family
         (VisualThemeEngine overrides the tokens at Application level)
         re-tint every surface live. No StaticResource on theme
         colours anywhere in this dictionary.

         PERFORMANCE: shadows live only on the card/dialog templates,
         animations only on hover/press/focus/check interactions —
         never continuous, never per-row. All brushes are frozen.
    ═══════════════════════════════════════════════════════════════════ -->

    <!-- ══════════════════════════════════════════════════════════════
         CARDS — the layered crystal surface
         <controls:LiquidGlassCard> is the full layered version
         (edge + inner reflection + sweep + shadow in ONE template).
         The Border styles are the lightweight adoption path for
         existing markup.
    ══════════════════════════════════════════════════════════════════ -->

    <Style TargetType="{x:Type controls:LiquidGlassCard}">
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:LiquidGlassCard}">
                    <Border x:Name="Edge"
                            Background="{DynamicResource LiquidGlassBrush}"
                            BorderBrush="{DynamicResource LiquidEdgeBrush}"
                            BorderThickness="1.2"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18"
                                              ShadowDepth="4"
                                              Opacity="0.22"
                                              Color="{DynamicResource LiquidShadowColor}"/>
                        </Border.Effect>
                        <Grid>
                            <!-- top reflection line -->
                            <Border x:Name="Highlight"
                                    Height="1"
                                    VerticalAlignment="Top"
                                    Margin="10,1,10,0"
                                    Background="{DynamicResource LiquidInnerHighlightBrush}"/>
                            <!-- meniscus line: the surface-tension band
                                 where the top of the water catches the
                                 light, hugging the rounded corners -->
                            <Border x:Name="Meniscus"
                                    Height="2"
                                    VerticalAlignment="Top"
                                    Margin="8,2,8,0"
                                    CornerRadius="8"
                                    Background="{DynamicResource LiquidEdgeBrush}"
                                    Opacity="0.45"
                                    IsHitTestVisible="False"/>
                            <!-- diagonal specular sweep -->
                            <Border x:Name="Sweep"
                                    Background="{DynamicResource LiquidReflectionBrush}"
                                    Opacity="0.35"
                                    IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=LiquidIntensity}"
                                     Value="Subtle">
                            <Setter TargetName="Edge"
                                    Property="Background"
                                    Value="{DynamicResource LiquidGlassSubtleBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=LiquidIntensity}"
                                     Value="Strong">
                            <Setter TargetName="Edge"
                                    Property="Background"
                                    Value="{DynamicResource LiquidGlassStrongBrush}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LiquidGlassPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LiquidGlassBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LiquidEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1.2"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="LiquidGlassSubtleCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LiquidGlassSubtleBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LiquidEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="LiquidGlassStrongCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LiquidGlassStrongBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LiquidEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1.2"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="5"
                                  Opacity="0.25"
                                  Color="{DynamicResource LiquidShadowColor}"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════
         BUTTONS — one crystal language, five roles
         Hover lift + press compression on every role (CubicEase,
         short durations — premium, cheap, no continuous animation).
    ══════════════════════════════════════════════════════════════════ -->

    <Style x:Key="LiquidGlassPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform x:Name="Lift"/>
                                <ScaleTransform x:Name="Squash"/>
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Border x:Name="Edge"
                                Background="{DynamicResource LiquidPrimaryButtonBrush}"
                                BorderBrush="{DynamicResource LiquidEdgeBrush}"
                                BorderThickness="1.2"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border Height="1"
                                        VerticalAlignment="Top"
                                        Margin="6,1,6,0"
                                        Background="{DynamicResource LiquidInnerHighlightBrush}"/>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift"
                                                         Storyboard.TargetProperty="Y"
                                                         To="-1.5"
                                                         Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift"
                                                         Storyboard.TargetProperty="Y"
                                                         To="0"
                                                         Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Squash"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.97"
                                                         Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="Squash"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.97"
                                                         Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Squash"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1"
                                                         Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="Squash"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1"
                                                         Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Edge" Property="BorderBrush" Value="{DynamicResource LiquidFocusBrush}"/>
                            <Setter TargetName="Edge" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            <Setter TargetName="Edge" Property="Background" Value="{DynamicResource LiquidControlDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

