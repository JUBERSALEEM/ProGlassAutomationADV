<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors">

    <!-- ═══════════════════════════════════════════════════════════════════
         SHARED INPUT STYLES (Phase 8 — design-system consolidation)

         One theme-adaptive look for text inputs and combo boxes, composed
         from the design tokens (ControlCornerRadius) and the global
         CardBorderThickness. Views should adopt these via {StaticResource}
         instead of re-declaring local input chrome, so focus/hover/disabled
         states are consistent and follow Light/Dark + accent changes.

         Adoption is incremental (see Docs/DESIGN_SYSTEM.md) — this
         dictionary just makes the shared definition available.
    ═══════════════════════════════════════════════════════════════════ -->

    <!-- ── TextBox ──────────────────────────────────────────────────── -->
    <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{DynamicResource GlassSurfaceBrush}"
                                BorderBrush="{DynamicResource GlassBorderGradientSoft}"
                                BorderThickness="{DynamicResource CardBorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Specular highlight -->
                                <Border Height="1" VerticalAlignment="Top"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Background="{DynamicResource GlassSpecularHighlight}"
                                        Margin="1,0,1,0" Opacity="0.3"
                                        IsHitTestVisible="False"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalAlignment="Center"
                                              Margin="12,8"
                                              Focusable="False"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GlassBorderGradientCrystal}"/>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GlassSurfaceElevated}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GlassSurfaceElevated}"/>
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── PasswordBox ───────────────────────────────────────────────── -->
    <Style x:Key="ModernPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Chrome"
                            Background="{DynamicResource GlassSurfaceBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="{DynamicResource CardBorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="12,8"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      Margin="0"
                                      Focusable="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GlassBorderBright}"/>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GlassSurfaceElevated}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GlassBorderBright}"/>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GlassSurfaceElevated}"/>
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Editable ComboBox (IsEditable=True) ──────────────────────
         ModernComboBoxStyle is non-editable (its template uses a
         ContentPresenter for SelectionBoxItem only). For dropdowns where
         the user must be able to type a NEW value that isn't in the list
         (Customer name, Salesman, Location, …), use this style. It adds
         the standard PART_EditableTextBox so typing actually works.

         The toggle button on the right opens the popup; the popup lists
         the ItemsSource; the textbox is bound to the ComboBox.Text property
         so any binding that targets the text (e.g. a two-way binding on
         a VM string property) sees what the user types.
    ──────────────────────────────────────────────────────────────── -->
    <Style x:Key="ModernEditableComboBoxStyle" TargetType="ComboBox">
        <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GlassSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderSoft}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="IsEditable" Value="True"/>
        <Setter Property="IsTextSearchEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Grid.Column="0"
                                     Style="{x:Null}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{TemplateBinding Foreground}"
                                     FontSize="{TemplateBinding FontSize}"
                                     CaretBrush="{DynamicResource AccentBrush}"
                                     Padding="{TemplateBinding Padding}"
                                     VerticalContentAlignment="Center"
                                     Focusable="True"/>
                            <ToggleButton Grid.Column="1"
                                          x:Name="PART_Button"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="0,0,12,0"
                                          Cursor="Hand">
                                <TextBlock Text="&#xE70D;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="{StaticResource TextCaption}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   StaysOpen="False">
                                <Border Background="{DynamicResource PopupSurfaceBrush}"
                                        BorderBrush="{DynamicResource OutlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource CardCornerRadius}"
                                        Padding="6"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="300">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GlassBorderBright}"/>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GlassSurfaceElevated}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GlassBorderBright}"/>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GlassSurfaceElevated}"/>
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GlassBorderBright}"/>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GlassSurfaceElevated}"/>
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── ComboBox ──────────────────────────────────────────────────── -->
    <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
        <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="Background" Value="{DynamicResource GlassSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderSoft}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- FULL-SURFACE OPEN (2026-09-05 owner report):
                                 a professional dropdown opens from a click
                                 ANYWHERE on the box, not only on the arrow.
                                 The old template put the toggle ONLY in the
                                 arrow column, so clicking the text body did
                                 nothing. The toggle now spans both columns
                                 with a transparent template (Background is
                                 set explicitly on the border INSIDE its
                                 template — the ToggleButton.Background
                                 property alone does not paint), and every
                                 visual above it is IsHitTestVisible=False.
                                 This is exactly WPF's own Aero pattern. -->
                            <ToggleButton Grid.Column="0" Grid.ColumnSpan="2"
                                          x:Name="PART_Button"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Cursor="Hand"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="Transparent">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HitSurface"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                SnapsToDevicePixels="True"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HitSurface" Property="Cursor" Value="Hand"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Grid.Column="0"
                                              Margin="12,0"
                                              VerticalAlignment="Center"
                                              ContentSource="SelectionBoxItem"
                                              IsHitTestVisible="False"/>
                            <TextBlock Grid.Column="1"
                                       Text="&#xE70D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource TextCaption}"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   StaysOpen="False">
                                <Border Background="{DynamicResource PopupSurfaceBrush}"
                                        BorderBrush="{DynamicResource OutlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource CardCornerRadius}"
                                        Padding="6"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="300">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GlassBorderBright}"/>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GlassSurfaceElevated}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GlassBorderBright}"/>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GlassSurfaceElevated}"/>
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource GlassBorderBright}"/>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GlassSurfaceElevated}"/>
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════
         IMPLICIT DROPDOWN STYLES — global dark-mode contrast fix
         (2026-08-25)

         BUG: ~142 ComboBox instances in the app; many carried NO
         explicit Style, so WPF's DEFAULT system chrome rendered them.
         On the dark theme their foreground followed the app's light
         text while the default box/popup background stayed system
         light — white text on white background, invisible.

         FIX: implicit styles route EVERY ComboBox into the themed
         Modern chrome, and every ComboBoxItem into a template whose
         foreground, background, hover and selection colours are all
         DynamicResources that follow the active theme and accent —
         text auto-adapts to whatever it sits on, in light AND dark,
         and on every theme/accent switch. No view edits needed;
         explicitly-styled controls still override these.
    ═══════════════════════════════════════════════════════════════ -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBoxStyle}"/>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Margin="0,1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 2026-09-05 contrast fix: hover/highlight used the
                             GLASS wash (~40% white) — on the dark popup that
                             turned the row near-white while the text STAYED
                             white (invisible text, the "white on white" bug).
                             Dedicated per-theme tint tokens instead. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBd" Property="Background"
                                    Value="{DynamicResource ComboBoxItemHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBd" Property="Background"
                                    Value="{DynamicResource ComboBoxItemHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBd" Property="Background"
                                    Value="{DynamicResource AccentBrush}"/>
                            <!-- Foreground MUST flip too: the old style kept
                                 PrimaryForegroundBrush, which is dark on dark
                                 accent in the light theme. -->
                            <Setter Property="Foreground"
                                    Value="{DynamicResource OnAccentForegroundBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
