<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="ProGlassAutomation.Themes.Styles.TypographyStyles">

    <!-- ═══════════════════════════════════════════════════════════════
         TYPOGRAPHY STYLES — Consistent text hierarchy across the app
         Every module should use these instead of hardcoded FontSize.
    ═══════════════════════════════════════════════════════════════ -->

    <!-- Hero number (big dashboard hero card values, e.g. "AED 12,500") -->
    <Style x:Key="HeroNumberStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="38"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode"  Value="ClearType"/>
    </Style>

    <!-- Big stat number (KPI cards, e.g. "4,500") -->
    <Style x:Key="StatNumberStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextDisplayLarge}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode"  Value="ClearType"/>
    </Style>

    <!-- Medium stat number (smaller stat cards, activity feed values) -->
    <Style x:Key="MediumNumberStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextTitleLarge}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <!-- Page title (e.g. "Dashboard", "Sheet Store") -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="30"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode"  Value="ClearType"/>
    </Style>

    <!-- Page subtitle (under page title, e.g. "Plan, prioritize, and...") -->
    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Margin"     Value="0,4,0,0"/>
    </Style>

    <!-- Section title (above card groups, e.g. "Business Overview") -->
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Margin"     Value="0,0,0,4"/>
    </Style>

    <!-- Section subtitle (small helper text under section title) -->
    <Style x:Key="SectionSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Margin"     Value="0,0,0,10"/>
    </Style>

    <!-- Card title (title inside a card, e.g. "Total Sales") -->
    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!-- Card subtitle (small text under card value, e.g. "VAT inclusive") -->
    <Style x:Key="CardSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight"   Value="Normal"/>
        <Setter Property="Foreground"   Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin"       Value="0,6,0,0"/>
    </Style>

    <!-- Meta text (dates, tags, small footnotes) -->
    <Style x:Key="MetaTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!-- Row title in list cards (e.g. task name, invoice number) -->
    <Style x:Key="RowTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextSection}"/>
        <Setter Property="FontWeight"   Value="SemiBold"/>
        <Setter Property="Foreground"   Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Row subtitle in list cards (metadata under title) -->
    <Style x:Key="RowSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight"   Value="Normal"/>
        <Setter Property="Foreground"   Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin"       Value="0,3,0,0"/>
    </Style>

    <!-- Percentage / trending indicator (small badge text) -->
    <Style x:Key="TrendingTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
    </Style>

    <!-- Table header text -->
    <Style x:Key="TableHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Padding"    Value="8,6"/>
    </Style>

</ResourceDictionary>