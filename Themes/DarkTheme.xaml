    <SolidColorBrush x:Key="LiquidDialogVeilBrush" Color="#59000000" po:Freeze="True"/>

    <!-- Glass shadows — subtler for dark mode -->
    <DropShadowEffect x:Key="GlassShadowSoft" Color="#000000" Opacity="0.30" BlurRadius="18" ShadowDepth="6" Direction="270"/>
    <DropShadowEffect x:Key="GlassShadowPanel" Color="#000000" Opacity="0.40" BlurRadius="80" ShadowDepth="30" Direction="270"/>
    <DropShadowEffect x:Key="GlassShadowActive" Color="#28BEFF" Opacity="0.25" BlurRadius="22" ShadowDepth="7" Direction="270"/>
    <DropShadowEffect x:Key="GlassShadowSoftBorder"   Color="#000000" Opacity="0.30" BlurRadius="18" ShadowDepth="6" Direction="270"/>
    <DropShadowEffect x:Key="GlassShadowSoftButton"   Color="#000000" Opacity="0.30" BlurRadius="18" ShadowDepth="6" Direction="270"/>
    <DropShadowEffect x:Key="GlassShadowSoftCheckBox" Color="#000000" Opacity="0.30" BlurRadius="18" ShadowDepth="6" Direction="270"/>
    <DropShadowEffect x:Key="GlassShadowSoftTextBox"  Color="#000000" Opacity="0.30" BlurRadius="18" ShadowDepth="6" Direction="270"/>
    <DropShadowEffect x:Key="GlassShadowSoftToggle"   Color="#000000" Opacity="0.30" BlurRadius="18" ShadowDepth="6" Direction="270"/>
    <DropShadowEffect x:Key="GlassShadowPanelBorder"  Color="#000000" Opacity="0.40" BlurRadius="80" ShadowDepth="30" Direction="270"/>
    <DropShadowEffect x:Key="GlassShadowActiveButton" Color="#28BEFF" Opacity="0.25" BlurRadius="22" ShadowDepth="7" Direction="270"/>

    <!-- Switch / toggle internal colors — dark mode -->
    <SolidColorBrush x:Key="GlassSwitchInnerHighlightBrush" Color="#66FFFFFF" po:Freeze="True"/>
