<!--
    FILE: Themes/DarkTheme.xaml
    PROJECT: ProGlassAutomation
    VERSION: Phase 1 — Design System Foundation (Dark)

    ARCHITECTURE: Mirror of LightTheme.xaml structure.
    See LightTheme.xaml for section documentation.

    PRESERVED: All 160 existing keys with identical values.
    ADDED:     13 new liquid glass system tokens (dark variants).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:conv="clr-namespace:ProGlassAutomation.Converters">


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 1 — RAW COLORS
    ═══════════════════════════════════════════════════════════════ -->
    <Color x:Key="PrimaryForegroundColor">#E5E7EB</Color>
    <Color x:Key="SecondaryForegroundColor">#A9B8CC</Color>
    <Color x:Key="MutedForegroundColor">#7C8CA3</Color>
    <Color x:Key="BorderColor">#3B4A63</Color>
    <Color x:Key="ModuleBackgroundColor">#0B1220</Color>
    <Color x:Key="SideMenuBackgroundColor">#0B1220</Color>
    <!-- Mid dusk-navy — the Color counterpart of WindowBackgroundBrush's
         central stop. Consumed by the Splash (PageBg / SplashPlate) and the
         Login surface backdrop gradients, which need a Color (not a Brush).
         Was previously undefined, so those DynamicResource stops silently
         fell back to transparent and flattened both backdrops. -->
    <Color x:Key="WindowBackgroundColor">#102244</Color>
    <Color x:Key="TextPrimaryColor">#F5F5F7</Color>
    <Color x:Key="TextSecondaryColor">#8CF5F5F7</Color>
    <Color x:Key="LiquidShadowColor">#FF000410</Color>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 2 — SEMANTIC COLORS
    ═══════════════════════════════════════════════════════════════ -->
    <Color x:Key="AccentColor">#38BDF8</Color>
    <Color x:Key="AccentHoverColor">#7DD3FC</Color>
    <Color x:Key="AccentDarkColor">#0EA5E9</Color>
    <Color x:Key="AccentLightColor">#7DD3FC</Color>
    <Color x:Key="AccentBlueColor">#28BEFF</Color>
    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DangerColor">#FB7185</Color>

    <!-- Tint palette (dark) -->
    <Color x:Key="TintIndigoColor">#1E293B</Color>
    <Color x:Key="TintRedColor">#3F1D2B</Color>
    <Color x:Key="TintGreenColor">#123524</Color>
    <Color x:Key="TintAmberColor">#3A2A12</Color>
    <Color x:Key="TintPurpleColor">#2B2144</Color>
    <Color x:Key="TintGrayColor">#1E293B</Color>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 3 — TEXT BRUSHES
    ═══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="{StaticResource PrimaryForegroundColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="{StaticResource SecondaryForegroundColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="{StaticResource MutedForegroundColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="OnAccentForegroundBrush" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="OnAccentSecondaryForegroundBrush" Color="#CCFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" po:Freeze="True"/>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 4 — SURFACE BRUSHES
    ═══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="ModuleBackgroundBrush" Color="#00000000" po:Freeze="True"/>

    <!-- Opaque popup surface. See the note in LightTheme.xaml: a Popup
         is a floating window, so an alpha-00 glass brush shows the
         desktop through it. -->
    <SolidColorBrush x:Key="PopupSurfaceBrush" Color="#FF111827" po:Freeze="True"/>
    <!-- Opaque dialog card. See LightTheme note: a transparent modal
         falls through to the desktop. -->
    <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#FF161A22" po:Freeze="True"/>
    <SolidColorBrush x:Key="DialogInsetBrush" Color="#FF1C222C" po:Freeze="True"/>
    <!-- 2026-09-05 dropdown contrast tokens (ERR white-on-white rows):
         ComboBoxItem hover/highlight must NEVER use the glass wash —
         ~40% white glass + white text is invisible on the dark popup.
         17% white tint over #1C1F26 reads as a subtle lift instead, and
         the selected row uses AccentBrush + OnAccentForegroundBrush. -->
    <SolidColorBrush x:Key="ComboBoxItemHoverBrush" Color="#1FFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ModuleWallpaperBrush" Color="Transparent" po:Freeze="True"/>
    <LinearGradientBrush x:Key="ElevatedSurfaceBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#74FFFFFF" Offset="0.00"/>
        <GradientStop Color="#3AFFFFFF" Offset="0.01"/>
        <GradientStop Color="#54FFFFFF" Offset="0.04"/>
        <GradientStop Color="#46FFFFFF" Offset="0.08"/>
        <GradientStop Color="#3CFFFFFF" Offset="0.20"/>
        <GradientStop Color="#1FFFFFFF" Offset="0.50"/>
        <GradientStop Color="#2EFFFFFF" Offset="0.75"/>
        <GradientStop Color="#34FFFFFF" Offset="0.92"/>
        <GradientStop Color="#40FFFFFF" Offset="1.00"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SideMenuBackgroundBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#33FFFFFF" Offset="0.00"/>
        <GradientStop Color="#1FFFFFFF" Offset="0.02"/>
        <GradientStop Color="#29FFFFFF" Offset="0.06"/>
        <GradientStop Color="#14FFFFFF" Offset="0.12"/>
        <GradientStop Color="#1AFFFFFF" Offset="0.30"/>
        <GradientStop Color="#17FFFFFF" Offset="0.60"/>
        <GradientStop Color="#14FFFFFF" Offset="0.85"/>
        <GradientStop Color="#18FFFFFF" Offset="0.95"/>
        <GradientStop Color="#1FFFFFFF" Offset="1.00"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SidebarCardBrush" Color="#141E293B" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#2033485F" po:Freeze="True"/>
    <SolidColorBrush x:Key="OverlayButtonBackgroundBrush" Color="#38BDF8" po:Freeze="True"/>
    <SolidColorBrush x:Key="OverlayButtonForegroundBrush" Color="#FFFFFF" po:Freeze="True"/>
    <Color x:Key="LiquidOverlayColor">#A60B1220</Color>
    <SolidColorBrush x:Key="LiquidOverlayBrush" Color="{StaticResource LiquidOverlayColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidDialogVeilBrush" Color="#66000000" po:Freeze="True"/>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 5 — LIQUID GLASS SURFACE BRUSHES
    ═══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="GlassSurfaceUltra" Color="#0EFFFFFF" po:Freeze="True"/>
    <LinearGradientBrush x:Key="GlassSurfaceBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#66FFFFFF" Offset="0.00"/>
        <GradientStop Color="#1FFFFFFF" Offset="0.01"/>
        <GradientStop Color="#4AFFFFFF" Offset="0.04"/>
        <GradientStop Color="#3EFFFFFF" Offset="0.08"/>
        <GradientStop Color="#34FFFFFF" Offset="0.20"/>
        <GradientStop Color="#2AFFFFFF" Offset="0.50"/>
        <GradientStop Color="#17FFFFFF" Offset="0.75"/>
        <GradientStop Color="#2DFFFFFF" Offset="0.92"/>
        <GradientStop Color="#38FFFFFF" Offset="1.00"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassSurfaceStandard" Color="#12FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassSurfaceElevated" Color="#1EFFFFFF" po:Freeze="True"/>

    <!-- Layered glass fill — dark watery meniscus -->
    <LinearGradientBrush x:Key="LiquidGlassBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#34FFFFFF" Offset="0.0"/>
        <GradientStop Color="#1AFFFFFF" Offset="0.07"/>
        <GradientStop Color="#40FFFFFF" Offset="0.16"/>
        <GradientStop Color="#18FFFFFF" Offset="0.45"/>
        <GradientStop Color="#1CFFFFFF" Offset="0.80"/>
        <GradientStop Color="#16FFFFFF" Offset="0.93"/>
        <GradientStop Color="#1CFFFFFF" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LiquidGlassSubtleBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#4CFFFFFF" Offset="0.00"/>
        <GradientStop Color="#24FFFFFF" Offset="0.01"/>
        <GradientStop Color="#34FFFFFF" Offset="0.04"/>
        <GradientStop Color="#2AFFFFFF" Offset="0.10"/>
        <GradientStop Color="#14FFFFFF" Offset="0.30"/>
        <GradientStop Color="#1AFFFFFF" Offset="0.70"/>
        <GradientStop Color="#14FFFFFF" Offset="0.95"/>
        <GradientStop Color="#14FFFFFF" Offset="1.00"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LiquidGlassStrongBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#4CFFFFFF" Offset="0.0"/>
        <GradientStop Color="#46FFFFFF" Offset="0.07"/>
        <GradientStop Color="#56FFFFFF" Offset="0.16"/>
        <GradientStop Color="#2AFFFFFF" Offset="0.55"/>
        <GradientStop Color="#14FFFFFF" Offset="0.92"/>
        <GradientStop Color="#17FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 6 — GLASS VARIANT BRUSHES  ★ NEW (DARK) ★
    ═══════════════════════════════════════════════════════════════ -->

    <!-- UltraClear: Almost invisible glass (dark) -->
    <LinearGradientBrush x:Key="LiquidGlassUltraClearBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#0E1E293B" Offset="0.0"/>
        <GradientStop Color="#0C1E293B" Offset="0.5"/>
        <GradientStop Color="#121E293B" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Crystal: Higher reflection, stronger edge (dark) -->
    <LinearGradientBrush x:Key="LiquidGlassCrystalBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#3EFFFFFF" Offset="0.0"/>
        <GradientStop Color="#1AFFFFFF" Offset="0.08"/>
        <GradientStop Color="#46FFFFFF" Offset="0.15"/>
        <GradientStop Color="#14FFFFFF" Offset="0.50"/>
        <GradientStop Color="#16FFFFFF" Offset="0.85"/>
        <GradientStop Color="#1CFFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- WaterGlass: Subtle liquid blue refraction (dark) -->
    <LinearGradientBrush x:Key="LiquidGlassWaterBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#14FFFFFF" Offset="0.0"/>
        <GradientStop Color="#12FFFFFF" Offset="0.15"/>
        <GradientStop Color="#1AFFFFFF" Offset="0.50"/>
        <GradientStop Color="#0EFFFFFF" Offset="0.85"/>
        <GradientStop Color="#14FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Frosted: Higher opacity for readability (dark) -->
    <LinearGradientBrush x:Key="LiquidGlassFrostedBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#4EFFFFFF" Offset="0.0"/>
        <GradientStop Color="#3EFFFFFF" Offset="0.10"/>
        <GradientStop Color="#50FFFFFF" Offset="0.20"/>
        <GradientStop Color="#1FFFFFFF" Offset="0.55"/>
        <GradientStop Color="#24FFFFFF" Offset="0.90"/>
        <GradientStop Color="#2AFFFFFF" Offset="1.0"/>
    </LinearGradientBrush>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 7 — GLASS EDGE BORDER BRUSHES
    ═══════════════════════════════════════════════════════════════ -->

    <!-- Flat glass borders (existing) -->
    <SolidColorBrush x:Key="GlassBorderPrimary" Color="#2EFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassBorderBright" Color="#3CFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassBorderSoft" Color="#14FFFFFF" po:Freeze="True"/>

    <!-- Crystal edge (dark: subtle white highlights) -->
    <LinearGradientBrush x:Key="LiquidEdgeBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#A0FFFFFF" Offset="0.0"/>
        <GradientStop Color="#30FFFFFF" Offset="0.5"/>
        <GradientStop Color="#3EFFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Top crystal edge (dark: softer than light) -->
    <LinearGradientBrush x:Key="LiquidGlassEdgeTopBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#60FFFFFF" Offset="0.0"/>
        <GradientStop Color="#80FFFFFF" Offset="0.3"/>
        <GradientStop Color="#50FFFFFF" Offset="0.7"/>
        <GradientStop Color="#30FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Bottom refraction edge (dark: deep blue shift) -->
    <LinearGradientBrush x:Key="LiquidGlassEdgeBottomBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#301E3A5F" Offset="0.0"/>
        <GradientStop Color="#201E3A5F" Offset="0.5"/>
        <GradientStop Color="#141E3A5F" Offset="1.0"/>
    </LinearGradientBrush>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 8 — GLASS HIGHLIGHT & REFLECTION BRUSHES  ★ NEW (DARK) ★
    ═══════════════════════════════════════════════════════════════ -->

    <!-- Specular highlight (dark: subtler) -->
    <RadialGradientBrush x:Key="LiquidGlassSpecularBrush"
                         Center="0.15,0.1" RadiusX="0.6" RadiusY="0.4"
                         po:Freeze="True">
        <GradientStop Color="#17FFFFFF" Offset="0.0"/>
        <GradientStop Color="#0DFFFFFF" Offset="0.5"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </RadialGradientBrush>

    <!-- Reflection gradient (dark) -->
    <LinearGradientBrush x:Key="LiquidGlassReflectionBrush" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#20FFFFFF" Offset="0.0"/>
        <GradientStop Color="#0AFFFFFF" Offset="0.3"/>
        <GradientStop Color="#00FFFFFF" Offset="0.6"/>
    </LinearGradientBrush>
    <!-- Legacy alias -->
    <LinearGradientBrush x:Key="LiquidReflectionBrush" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#17FFFFFF" Offset="0.0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.45"/>
    </LinearGradientBrush>

    <!-- Refraction (dark: deep teal/blue shift) -->
    <LinearGradientBrush x:Key="LiquidGlassRefractionBrush" StartPoint="0,1" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#00FFFFFF" Offset="0.0"/>
        <GradientStop Color="#0D164E63" Offset="0.4"/>
        <GradientStop Color="#18164E63" Offset="0.7"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Inner highlight (dark) -->
    <LinearGradientBrush x:Key="LiquidInnerHighlightBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#00FFFFFF" Offset="0.0"/>
        <GradientStop Color="#66FFFFFF" Offset="0.5"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Top reflection (dark: reduced opacity) -->
    <LinearGradientBrush x:Key="GlassTopReflection" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#66FFFFFF" Offset="0.0"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Sheen (dark) -->
    <LinearGradientBrush x:Key="LiquidSheen" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#17FFFFFF" Offset="0.0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
    </LinearGradientBrush>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 9 — LIQUID COMPOSITION BRUSHES
    ═══════════════════════════════════════════════════════════════ -->
    <LinearGradientBrush x:Key="LiquidCard" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#66FFFFFF" Offset="0.00"/>
        <GradientStop Color="#1FFFFFFF" Offset="0.01"/>
        <GradientStop Color="#4AFFFFFF" Offset="0.04"/>
        <GradientStop Color="#3EFFFFFF" Offset="0.08"/>
        <GradientStop Color="#34FFFFFF" Offset="0.20"/>
        <GradientStop Color="#2AFFFFFF" Offset="0.50"/>
        <GradientStop Color="#17FFFFFF" Offset="0.75"/>
        <GradientStop Color="#2DFFFFFF" Offset="0.92"/>
        <GradientStop Color="#38FFFFFF" Offset="1.00"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="LiquidOrbA" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" po:Freeze="True">
        <GradientStop Color="#3038BDF8" Offset="0.0"/>
        <GradientStop Color="#180369A1" Offset="0.55"/>
        <GradientStop Color="#000369A1" Offset="1.0"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="LiquidOrbB" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" po:Freeze="True">
        <GradientStop Color="#307DD3FC" Offset="0.0"/>
        <GradientStop Color="#1838BDF8" Offset="0.55"/>
        <GradientStop Color="#0038BDF8" Offset="1.0"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="LiquidControlHoverBrush" Color="#40FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidControlPressedBrush" Color="#17FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidControlDisabledBrush" Color="#1EFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidFocusBrush" Color="#6638BDF8" po:Freeze="True"/>
    <LinearGradientBrush x:Key="LiquidSelectionBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#4D3B82F6" Offset="0.0"/>
        <GradientStop Color="#333B82F6" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LiquidPrimaryButtonBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#A63B82F6" Offset="0.0"/>
        <GradientStop Color="#733B82F6" Offset="1.0"/>
    </LinearGradientBrush>
    <!-- About page liquid palette (dark) -->
    <SolidColorBrush x:Key="LiquidIce" Color="#DBEAFE" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidFrost" Color="#BFDBFE" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidCerulean" Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="LiquidSnow" Color="#F8FAFC" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidAccent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="LiquidAccentDeep" Color="{StaticResource AccentDarkColor}"/>
    <!-- Glossy accent-gradient badge (About icon tiles = splash tile badges). -->
    <LinearGradientBrush x:Key="LiquidAccentGradient" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="{StaticResource AccentLightColor}" Offset="0.0"/>
        <GradientStop Color="{StaticResource AccentDarkColor}"  Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LiquidMuted" Color="#8FB3E6" po:Freeze="True"/>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 10 — BORDER & OUTLINE BRUSHES
    ═══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#243244" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="#334155" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineDefaultBrush" Color="#334155" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineStrongBrush" Color="#94A3B8" po:Freeze="True"/>

    <!-- Semantic status brushes (dark-lifted) -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerLightBrush" Color="#FDA4AF" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#33FB7185" po:Freeze="True"/>
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#22F59E0B" po:Freeze="True"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#38BDF8" po:Freeze="True"/>
    <SolidColorBrush x:Key="NeutralBrush" Color="#94A3B8" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassDangerBrush" Color="#FB7185" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassDangerBorderBrush" Color="#99FB7185" po:Freeze="True"/>

    <!-- Accent brushes (dark) -->
        <SolidColorBrush x:Key="LiquidBlueBrush" Color="#38BDF8" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidBlueSurfaceBrush" Color="#1438BDF8" po:Freeze="True"/>
    <Color x:Key="LiquidBlueColor">#38BDF8</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}" po:Freeze="True"/>

    <!-- Tint brushes (dark) -->
    <SolidColorBrush x:Key="TintIndigoBrush" Color="{StaticResource TintIndigoColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TintRedBrush" Color="{StaticResource TintRedColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TintGreenBrush" Color="{StaticResource TintGreenColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TintAmberBrush" Color="{StaticResource TintAmberColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TintPurpleBrush" Color="{StaticResource TintPurpleColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TintGrayBrush" Color="{StaticResource TintGrayColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TintBlueBrush" Color="#12324A" po:Freeze="True"/>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 11 — SHADOW EFFECTS (dark: deeper, more opaque)
    ═══════════════════════════════════════════════════════════════ -->
    
    <!-- ═══ Phase 1 Consolidated Shadow Tokens ═══ -->
    <DropShadowEffect x:Key="ShadowSoft" Color="#000000" Opacity="0.28" BlurRadius="22" ShadowDepth="6" Direction="270" po:Freeze="True"/>
    <DropShadowEffect x:Key="ShadowElevated" Color="#000000" Opacity="0.34" BlurRadius="24" ShadowDepth="8" Direction="270" po:Freeze="True"/>
    <DropShadowEffect x:Key="ShadowDeep" Color="#000000" Opacity="0.36" BlurRadius="24" ShadowDepth="8" Direction="270" po:Freeze="True"/>

    <DropShadowEffect x:Key="GlassShadowSoft" Color="#000000" Opacity="0.18" BlurRadius="10" ShadowDepth="3" Direction="270" po:Freeze="True"/>
    <DropShadowEffect x:Key="GlassShadowSoftBorder" Color="#000000" Opacity="0.18" BlurRadius="10" ShadowDepth="3" Direction="270" po:Freeze="True"/>
    <DropShadowEffect x:Key="GlassShadowSoftButton" Color="#000000" Opacity="0.18" BlurRadius="10" ShadowDepth="3" Direction="270" po:Freeze="True"/>
    <DropShadowEffect x:Key="GlassShadowSoftCheckBox" Color="#000000" Opacity="0.18" BlurRadius="10" ShadowDepth="3" Direction="270" po:Freeze="True"/>
    <DropShadowEffect x:Key="GlassShadowSoftTextBox" Color="#000000" Opacity="0.18" BlurRadius="10" ShadowDepth="3" Direction="270" po:Freeze="True"/>
    <DropShadowEffect x:Key="GlassShadowSoftToggle" Color="#000000" Opacity="0.18" BlurRadius="10" ShadowDepth="3" Direction="270" po:Freeze="True"/>
    <DropShadowEffect x:Key="GlassShadowPanel" Color="#000000" Opacity="0.22" BlurRadius="18" ShadowDepth="5" Direction="270" po:Freeze="True"/>
    <DropShadowEffect x:Key="GlassShadowPanelBorder" Color="#000000" Opacity="0.22" BlurRadius="18" ShadowDepth="5" Direction="270" po:Freeze="True"/>
    <DropShadowEffect x:Key="GlassShadowActive" Color="#28BEFF" Opacity="0.18" BlurRadius="12" ShadowDepth="3" Direction="270" po:Freeze="True"/>
    <DropShadowEffect x:Key="GlassShadowActiveButton" Color="#28BEFF" Opacity="0.18" BlurRadius="12" ShadowDepth="3" Direction="270" po:Freeze="True"/>


