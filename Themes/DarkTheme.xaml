<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:ProGlassAutomation.Converters">

    <!-- ═══════════════════════════════════════════════════════════════
         DARK THEME — Green accent (same brand, dark surfaces)
         All brush keys mirror LightTheme.xaml for seamless swap.
         Colors optimized for readability + visual hierarchy on dark bg.
    ═══════════════════════════════════════════════════════════════ -->

    <!-- ── Surfaces ─────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="WindowBackgroundBrush"    Color="#0B1220"/>
    <SolidColorBrush x:Key="ModuleBackgroundBrush"    Color="#1E293B"/>
    <SolidColorBrush x:Key="ElevatedSurfaceBrush"     Color="#273449"/>
    <SolidColorBrush x:Key="SideMenuBackgroundBrush"  Color="#1E293B"/>
    <SolidColorBrush x:Key="MenuHoverBrush"           Color="#334155"/>
    <SolidColorBrush x:Key="OverlayButtonBackgroundBrush" Color="#22C55E"/>

    <!-- ── Text ─────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="PrimaryForegroundBrush"   Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="MutedForegroundBrush"     Color="#64748B"/>
    <SolidColorBrush x:Key="OnAccentForegroundBrush"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OverlayButtonForegroundBrush" Color="#FFFFFF"/>

    <!-- ── Accents (green family, brighter on dark) ─────────────────── -->
    <SolidColorBrush x:Key="AccentBrush"      Color="#22C55E"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="AccentDarkBrush"  Color="#0F4C3A"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#4ADE80"/>

    <!-- ── Semantic (slightly desaturated for dark bg readability) ─── -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="DangerBrush"  Color="#F87171"/>
    <SolidColorBrush x:Key="InfoBrush"    Color="#60A5FA"/>
    <SolidColorBrush x:Key="NeutralBrush" Color="#94A3B8"/>

    <!-- ── Tinted card backgrounds (dark-mode tinted surfaces) ─────── -->
    <SolidColorBrush x:Key="TintIndigoBrush" Color="#252B48"/>
    <SolidColorBrush x:Key="TintGreenBrush"  Color="#1E3A2F"/>
    <SolidColorBrush x:Key="TintAmberBrush"  Color="#3B2F1E"/>
    <SolidColorBrush x:Key="TintBlueBrush"   Color="#1E2B44"/>
    <SolidColorBrush x:Key="TintRedBrush"    Color="#3B1F22"/>
    <SolidColorBrush x:Key="TintGrayBrush"   Color="#242B3A"/>
    <SolidColorBrush x:Key="TintPurpleBrush" Color="#2A2540"/>

    <!-- ── Borders + dividers ──────────────────────────────────────── -->
    <SolidColorBrush x:Key="BorderBrush"  Color="#334155"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#334155"/>

    <!-- ── BrushKeyConverter (registered here so merged style dictionaries
         can reference it via StaticResource during their load phase.
         Must be in BOTH themes for seamless swap.) ─────────────────── -->
    <conv:BrushKeyConverter x:Key="BrushKeyConverter"/>

</ResourceDictionary>