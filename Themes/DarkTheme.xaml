<!--
    FILE: Themes/DarkTheme.xaml
    PROJECT: ProGlassAutomation
    VERSION: Phase 1 — Design System Foundation (Dark)

    ARCHITECTURE: Mirror of LightTheme.xaml structure.
    See LightTheme.xaml for section documentation.

    PRESERVED: All 160 existing keys with identical values.
    ADDED:     13 new liquid glass system tokens (dark variants).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:conv="clr-namespace:ProGlassAutomation.Converters">


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 1 — RAW COLORS
    ═══════════════════════════════════════════════════════════════ -->
    <Color x:Key="PrimaryForegroundColor">#F1F5F9</Color>
    <Color x:Key="SecondaryForegroundColor">#94A3B8</Color>
    <Color x:Key="MutedForegroundColor">#64748B</Color>
    <Color x:Key="BorderColor">#334155</Color>
    <Color x:Key="ModuleBackgroundColor">#0F172A</Color>
    <Color x:Key="SideMenuBackgroundColor">#0F172A</Color>
    <Color x:Key="TextPrimaryColor">#F5F5F7</Color>
    <Color x:Key="TextSecondaryColor">#8CF5F5F7</Color>
    <Color x:Key="LiquidShadowColor">#FF000410</Color>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 2 — SEMANTIC COLORS
    ═══════════════════════════════════════════════════════════════ -->
    <Color x:Key="AccentColor">#38BDF8</Color>
    <Color x:Key="AccentHoverColor">#7DD3FC</Color>
    <Color x:Key="AccentDarkColor">#0369A1</Color>
    <Color x:Key="AccentLightColor">#7DD3FC</Color>
    <Color x:Key="AccentBlueColor">#28BEFF</Color>
    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="WarningColor">#FBBF24</Color>
    <Color x:Key="DangerColor">#F87171</Color>

    <!-- Tint palette (dark) -->
    <Color x:Key="TintIndigoColor">#252B48</Color>
    <Color x:Key="TintRedColor">#3B1F22</Color>
    <Color x:Key="TintGreenColor">#1E2B44</Color>
    <Color x:Key="TintAmberColor">#3B2F1E</Color>
    <Color x:Key="TintPurpleColor">#2A2540</Color>
    <Color x:Key="TintGrayColor">#242B3A</Color>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 3 — TEXT BRUSHES
    ═══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="{StaticResource PrimaryForegroundColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="{StaticResource SecondaryForegroundColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="{StaticResource MutedForegroundColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="OnAccentForegroundBrush" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="OnAccentSecondaryForegroundBrush" Color="#CCFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" po:Freeze="True"/>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 4 — SURFACE BRUSHES
    ═══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="ModuleBackgroundBrush" Color="#00000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="ModuleWallpaperBrush" Color="Transparent" po:Freeze="True"/>
    <LinearGradientBrush x:Key="ElevatedSurfaceBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#40FFFFFF" Offset="0.00"/>
        <GradientStop Color="#0CFFFFFF" Offset="0.03"/>
        <GradientStop Color="#1AFFFFFF" Offset="0.09"/>
        <GradientStop Color="#0CFFFFFF" Offset="0.25"/>
        <GradientStop Color="#08FFFFFF" Offset="0.75"/>
        <GradientStop Color="#0CFFFFFF" Offset="0.95"/>
        <GradientStop Color="#14FFFFFF" Offset="1.00"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SideMenuBackgroundBrush" Color="#0D1E293B" po:Freeze="True"/>
    <SolidColorBrush x:Key="SidebarCardBrush" Color="#141E3A5F" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#183B82F6" po:Freeze="True"/>
    <SolidColorBrush x:Key="OverlayButtonBackgroundBrush" Color="#38BDF8" po:Freeze="True"/>
    <SolidColorBrush x:Key="OverlayButtonForegroundBrush" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidOverlayBrush" Color="#99031026" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidDialogVeilBrush" Color="#59000000" po:Freeze="True"/>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 5 — LIQUID GLASS SURFACE BRUSHES
    ═══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="GlassSurfaceUltra" Color="#081E293B" po:Freeze="True"/>
    <LinearGradientBrush x:Key="GlassSurfaceBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#38FFFFFF" Offset="0.00"/>
        <GradientStop Color="#0AFFFFFF" Offset="0.03"/>
        <GradientStop Color="#16FFFFFF" Offset="0.09"/>
        <GradientStop Color="#0AFFFFFF" Offset="0.25"/>
        <GradientStop Color="#06FFFFFF" Offset="0.75"/>
        <GradientStop Color="#0AFFFFFF" Offset="0.95"/>
        <GradientStop Color="#10FFFFFF" Offset="1.00"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassSurfaceStandard" Color="#0C1E293B" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassSurfaceElevated" Color="#142D3B4F" po:Freeze="True"/>

    <!-- Layered glass fill — dark watery meniscus -->
    <LinearGradientBrush x:Key="LiquidGlassBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#26FFFFFF" Offset="0.0"/>
        <GradientStop Color="#20FFFFFF" Offset="0.07"/>
        <GradientStop Color="#30FFFFFF" Offset="0.16"/>
        <GradientStop Color="#1CFFFFFF" Offset="0.45"/>
        <GradientStop Color="#12FFFFFF" Offset="0.80"/>
        <GradientStop Color="#0DFFFFFF" Offset="0.93"/>
        <GradientStop Color="#11FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LiquidGlassSubtleBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#30FFFFFF" Offset="0.00"/>
        <GradientStop Color="#06FFFFFF" Offset="0.03"/>
        <GradientStop Color="#12FFFFFF" Offset="0.10"/>
        <GradientStop Color="#05FFFFFF" Offset="0.30"/>
        <GradientStop Color="#03FFFFFF" Offset="0.70"/>
        <GradientStop Color="#06FFFFFF" Offset="0.95"/>
        <GradientStop Color="#0AFFFFFF" Offset="1.00"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LiquidGlassStrongBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#3DFFFFFF" Offset="0.0"/>
        <GradientStop Color="#38FFFFFF" Offset="0.07"/>
        <GradientStop Color="#47FFFFFF" Offset="0.16"/>
        <GradientStop Color="#1FFFFFFF" Offset="0.55"/>
        <GradientStop Color="#18FFFFFF" Offset="0.92"/>
        <GradientStop Color="#1BFFFFFF" Offset="1.0"/>
    </LinearGradientBrush>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 6 — GLASS VARIANT BRUSHES  ★ NEW (DARK) ★
    ═══════════════════════════════════════════════════════════════ -->

    <!-- UltraClear: Almost invisible glass (dark) -->
    <LinearGradientBrush x:Key="LiquidGlassUltraClearBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#0A1E293B" Offset="0.0"/>
        <GradientStop Color="#081E293B" Offset="0.5"/>
        <GradientStop Color="#0D1E293B" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Crystal: Higher reflection, stronger edge (dark) -->
    <LinearGradientBrush x:Key="LiquidGlassCrystalBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#30FFFFFF" Offset="0.0"/>
        <GradientStop Color="#22FFFFFF" Offset="0.08"/>
        <GradientStop Color="#38FFFFFF" Offset="0.15"/>
        <GradientStop Color="#18FFFFFF" Offset="0.50"/>
        <GradientStop Color="#0DFFFFFF" Offset="0.85"/>
        <GradientStop Color="#11FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- WaterGlass: Subtle liquid blue refraction (dark) -->
    <LinearGradientBrush x:Key="LiquidGlassWaterBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#1A1E3A5F" Offset="0.0"/>
        <GradientStop Color="#0D1E293B" Offset="0.15"/>
        <GradientStop Color="#141E3A5F" Offset="0.50"/>
        <GradientStop Color="#0A1E293B" Offset="0.85"/>
        <GradientStop Color="#1A164E63" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Frosted: Higher opacity for readability (dark) -->
    <LinearGradientBrush x:Key="LiquidGlassFrostedBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#3DFFFFFF" Offset="0.0"/>
        <GradientStop Color="#30FFFFFF" Offset="0.10"/>
        <GradientStop Color="#40FFFFFF" Offset="0.20"/>
        <GradientStop Color="#26FFFFFF" Offset="0.55"/>
        <GradientStop Color="#1AFFFFFF" Offset="0.90"/>
        <GradientStop Color="#1FFFFFFF" Offset="1.0"/>
    </LinearGradientBrush>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 7 — GLASS EDGE BORDER BRUSHES
    ═══════════════════════════════════════════════════════════════ -->

    <!-- Flat glass borders (existing) -->
    <SolidColorBrush x:Key="GlassBorderPrimary" Color="#1FFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassBorderBright" Color="#2BFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassBorderSoft" Color="#14FFFFFF" po:Freeze="True"/>

    <!-- Crystal edge (dark: subtle white highlights) -->
    <LinearGradientBrush x:Key="LiquidEdgeBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#8CFFFFFF" Offset="0.0"/>
        <GradientStop Color="#26FFFFFF" Offset="0.5"/>
        <GradientStop Color="#33FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Top crystal edge (dark: softer than light) -->
    <LinearGradientBrush x:Key="LiquidGlassEdgeTopBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#60FFFFFF" Offset="0.0"/>
        <GradientStop Color="#80FFFFFF" Offset="0.3"/>
        <GradientStop Color="#50FFFFFF" Offset="0.7"/>
        <GradientStop Color="#30FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Bottom refraction edge (dark: deep blue shift) -->
    <LinearGradientBrush x:Key="LiquidGlassEdgeBottomBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#301E3A5F" Offset="0.0"/>
        <GradientStop Color="#201E3A5F" Offset="0.5"/>
        <GradientStop Color="#141E3A5F" Offset="1.0"/>
    </LinearGradientBrush>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 8 — GLASS HIGHLIGHT & REFLECTION BRUSHES  ★ NEW (DARK) ★
    ═══════════════════════════════════════════════════════════════ -->

    <!-- Specular highlight (dark: subtler) -->
    <RadialGradientBrush x:Key="LiquidGlassSpecularBrush"
                         Center="0.15,0.1" RadiusX="0.6" RadiusY="0.4"
                         po:Freeze="True">
        <GradientStop Color="#26FFFFFF" Offset="0.0"/>
        <GradientStop Color="#0DFFFFFF" Offset="0.5"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </RadialGradientBrush>

    <!-- Reflection gradient (dark) -->
    <LinearGradientBrush x:Key="LiquidGlassReflectionBrush" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#20FFFFFF" Offset="0.0"/>
        <GradientStop Color="#0AFFFFFF" Offset="0.3"/>
        <GradientStop Color="#00FFFFFF" Offset="0.6"/>
    </LinearGradientBrush>
    <!-- Legacy alias -->
    <LinearGradientBrush x:Key="LiquidReflectionBrush" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#26FFFFFF" Offset="0.0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.45"/>
    </LinearGradientBrush>

    <!-- Refraction (dark: deep teal/blue shift) -->
    <LinearGradientBrush x:Key="LiquidGlassRefractionBrush" StartPoint="0,1" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#00FFFFFF" Offset="0.0"/>
        <GradientStop Color="#0D164E63" Offset="0.4"/>
        <GradientStop Color="#18164E63" Offset="0.7"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Inner highlight (dark) -->
    <LinearGradientBrush x:Key="LiquidInnerHighlightBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#00FFFFFF" Offset="0.0"/>
        <GradientStop Color="#59FFFFFF" Offset="0.5"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Top reflection (dark: reduced opacity) -->
    <LinearGradientBrush x:Key="GlassTopReflection" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#4DFFFFFF" Offset="0.0"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Sheen (dark) -->
    <LinearGradientBrush x:Key="LiquidSheen" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#26FFFFFF" Offset="0.0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
    </LinearGradientBrush>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 9 — LIQUID COMPOSITION BRUSHES
    ═══════════════════════════════════════════════════════════════ -->
    <LinearGradientBrush x:Key="LiquidCard" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#40FFFFFF" Offset="0.00"/>
        <GradientStop Color="#08FFFFFF" Offset="0.02"/>
        <GradientStop Color="#16FFFFFF" Offset="0.08"/>
        <GradientStop Color="#08FFFFFF" Offset="0.22"/>
        <GradientStop Color="#05FFFFFF" Offset="0.60"/>
        <GradientStop Color="#06FFFFFF" Offset="0.85"/>
        <GradientStop Color="#0AFFFFFF" Offset="0.95"/>
        <GradientStop Color="#10FFFFFF" Offset="1.00"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="LiquidOrbA" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" po:Freeze="True">
        <GradientStop Color="#3038BDF8" Offset="0.0"/>
        <GradientStop Color="#180369A1" Offset="0.55"/>
        <GradientStop Color="#000369A1" Offset="1.0"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="LiquidOrbB" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" po:Freeze="True">
        <GradientStop Color="#307DD3FC" Offset="0.0"/>
        <GradientStop Color="#1838BDF8" Offset="0.55"/>
        <GradientStop Color="#0038BDF8" Offset="1.0"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="LiquidControlHoverBrush" Color="#33FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidControlPressedBrush" Color="#1CFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidControlDisabledBrush" Color="#14FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidFocusBrush" Color="#6638BDF8" po:Freeze="True"/>
    <LinearGradientBrush x:Key="LiquidSelectionBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#4D3B82F6" Offset="0.0"/>
        <GradientStop Color="#333B82F6" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LiquidPrimaryButtonBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#A63B82F6" Offset="0.0"/>
        <GradientStop Color="#733B82F6" Offset="1.0"/>
    </LinearGradientBrush>
    <!-- About page liquid palette (dark) -->
    <SolidColorBrush x:Key="LiquidIce" Color="#DBEAFE" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidFrost" Color="#BFDBFE" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidCerulean" Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="LiquidSnow" Color="#F8FAFC" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidAccent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="LiquidAccentDeep" Color="{StaticResource AccentDarkColor}"/>
    <SolidColorBrush x:Key="LiquidMuted" Color="#8FB3E6" po:Freeze="True"/>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 10 — BORDER & OUTLINE BRUSHES
    ═══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#334155" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="#475569" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineDefaultBrush" Color="#475569" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineStrongBrush" Color="#64748B" po:Freeze="True"/>

    <!-- Semantic status brushes (dark-lifted) -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerLightBrush" Color="#FCA5A5" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#33DC2626" po:Freeze="True"/>
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#22F59E0B" po:Freeze="True"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#38BDF8" po:Freeze="True"/>
    <SolidColorBrush x:Key="NeutralBrush" Color="#64748B" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassDangerBrush" Color="#EF4444" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassDangerBorderBrush" Color="#99EF4444" po:Freeze="True"/>

    <!-- Accent brushes (dark) -->
        <SolidColorBrush x:Key="LiquidBlueBrush" Color="#3B9FE0" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidBlueSurfaceBrush" Color="#143B9FE0" po:Freeze="True"/>
    <Color x:Key="LiquidBlueColor">#3B9FE0</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}" po:Freeze="True"/>

    <!-- Tint brushes (dark) -->
    <SolidColorBrush x:Key="TintIndigoBrush" Color="{StaticResource TintIndigoColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TintRedBrush" Color="{StaticResource TintRedColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TintGreenBrush" Color="{StaticResource TintGreenColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TintAmberBrush" Color="{StaticResource TintAmberColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TintPurpleBrush" Color="{StaticResource TintPurpleColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TintGrayBrush" Color="{StaticResource TintGrayColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TintBlueBrush" Color="#1E2B44" po:Freeze="True"/>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 11 — SHADOW EFFECTS (dark: deeper, more opaque)
    ═══════════════════════════════════════════════════════════════ -->
    
    <!-- ═══ Phase 1 Consolidated Shadow Tokens ═══ -->
    <DropShadowEffect x:Key="ShadowSoft" Color="#000000" Opacity="0.30" BlurRadius="18" ShadowDepth="6" Direction="270" po:Freeze="True"/>
    <DropShadowEffect x:Key="ShadowElevated" Color="#000000" Opacity="0.40" BlurRadius="24" ShadowDepth="8" Direction="270" po:Freeze="True"/>
    <DropShadowEffect x:Key="ShadowDeep" Color="#000000" Opacity="0.50" BlurRadius="32" ShadowDepth="12" Direction="270" po:Freeze="True"/>

    <DropShadowEffect x:Key="GlassShadowSoft" Color="#000000" Opacity="0.30" BlurRadius="18" ShadowDepth="6" Direction="270"/>
    <DropShadowEffect x:Key="GlassShadowSoftBorder" Color="#000000" Opacity="0.30" BlurRadius="18" ShadowDepth="6" Direction="270"/>
    <DropShadowEffect x:Key="GlassShadowSoftButton" Color="#000000" Opacity="0.30" BlurRadius="18" ShadowDepth="6" Direction="270"/>
    <DropShadowEffect x:Key="GlassShadowSoftCheckBox" Color="#000000" Opacity="0.30" BlurRadius="18" ShadowDepth="6" Direction="270"/>
    <DropShadowEffect x:Key="GlassShadowSoftTextBox" Color="#000000" Opacity="0.30" BlurRadius="18" ShadowDepth="6" Direction="270"/>
    <DropShadowEffect x:Key="GlassShadowSoftToggle" Color="#000000" Opacity="0.30" BlurRadius="18" ShadowDepth="6" Direction="270"/>
    <DropShadowEffect x:Key="GlassShadowPanel" Color="#000000" Opacity="0.40" BlurRadius="80" ShadowDepth="30" Direction="270"/>
    <DropShadowEffect x:Key="GlassShadowPanelBorder" Color="#000000" Opacity="0.40" BlurRadius="80" ShadowDepth="30" Direction="270"/>
    <DropShadowEffect x:Key="GlassShadowActive" Color="#28BEFF" Opacity="0.25" BlurRadius="22" ShadowDepth="7" Direction="270"/>
    <DropShadowEffect x:Key="GlassShadowActiveButton" Color="#28BEFF" Opacity="0.25" BlurRadius="22" ShadowDepth="7" Direction="270"/>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 12 — GRADIENT BRUSHES
    ═══════════════════════════════════════════════════════════════ -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="0.8,1">
        <GradientStop Color="#0A1628" Offset="0.0"/>
        <GradientStop Color="#0F2847" Offset="0.3"/>
        <GradientStop Color="#0D2040" Offset="0.55"/>
        <GradientStop Color="#0B1A35" Offset="0.8"/>
        <GradientStop Color="#0A1628" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassBackdropBrush" StartPoint="0.2,0" EndPoint="0.8,1">
        <GradientStop Color="#1E1B4B" Offset="0.0"/>
        <GradientStop Color="#172554" Offset="0.35"/>
        <GradientStop Color="#164E63" Offset="0.65"/>
        <GradientStop Color="#1E1B4B" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#0A1628" Offset="0.0"/>
        <GradientStop Color="#0F2847" Offset="0.5"/>
        <GradientStop Color="#0A1628" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassGradientIdle" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#1E2D3B4F" Offset="0.0"/>
        <GradientStop Color="#0A1E293B" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassGradientActive" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#9928BEFF" Offset="0.0"/>
        <GradientStop Color="#4D82E1FF" Offset="0.5"/>
        <GradientStop Color="#8032AFF5" Offset="1.0"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="AuroraA" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" po:Freeze="True">
        <GradientStop Color="#4D38BDF8" Offset="0.0"/>
        <GradientStop Color="#1D38BDF800" Offset="1.0"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AuroraB" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" po:Freeze="True">
        <GradientStop Color="#408183F4" Offset="0.0"/>
        <GradientStop Color="#1D6366F100" Offset="1.0"/>
    </RadialGradientBrush>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 13 — DENSITY TOKENS
    ═══════════════════════════════════════════════════════════════ -->
    <sys:Double x:Key="DensityInputHeight">30</sys:Double>
    <sys:Double x:Key="DensityButtonHeight">32</sys:Double>
