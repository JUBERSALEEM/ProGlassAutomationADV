<!--
    FILE: Themes/DarkTheme.xaml
    PROJECT: ProGlassAutomation
    VERSION: Chat 23 v1.6 — Add Dashboard glass/ambient keys (dark)

    CHANGES vs v1.3:
      • +Dash* keys (mirror LightTheme v1.6, dark values)

    Dark values chosen to lift against slate-800 (#1E293B) surfaces.

    REGRESSION RISK: ZERO
      Pure additive. Dark-mode counterparts for LightTheme v1.6 keys.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:conv="clr-namespace:ProGlassAutomation.Converters">

    <!-- ═══════════════════════════════════════════════════════════════
         DARK THEME — INDUSTRIAL MILL FLOOR
    ═══════════════════════════════════════════════════════════════ -->

    <!-- ── Surfaces ─────────────────────────────────────────────────── -->
    <!-- iOS dark glass backdrop -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0A0F1E" Offset="0.0"/>
        <GradientStop Color="#0C1225" Offset="0.3"/>
        <GradientStop Color="#0E1530" Offset="0.6"/>
        <GradientStop Color="#0A1020" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassBackdropBrush" StartPoint="0.2,0" EndPoint="0.8,1">
        <GradientStop Color="#1E1B4B" Offset="0.0"/>
        <GradientStop Color="#172554" Offset="0.35"/>
        <GradientStop Color="#164E63" Offset="0.65"/>
        <GradientStop Color="#1E1B4B" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ModuleBackgroundBrush"
                     Color="#0F172A"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="ElevatedSurfaceBrush"
                     Color="#1E293B"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="SideMenuBackgroundBrush"
                     Color="#0F172A"
                     po:Freeze="True"/>
    <!-- Opaque Color twins for the drawer gradient (MainWindow uses
         SideMenuBackgroundColor / ModuleBackgroundColor as DynamicResource
         Color). LightTheme defined these; DarkTheme did not, so in dark
         mode the drawer gradient fell back to transparent and the side
         menu bar became invisible. Added for parity. -->
    <Color x:Key="ModuleBackgroundColor">#0F172A</Color>
    <Color x:Key="SideMenuBackgroundColor">#0F172A</Color>
    <SolidColorBrush x:Key="MenuHoverBrush"
                     Color="#1E293B"
                     po:Freeze="True"/>
    <!-- Sidebar sub-menu / nested card surface — elevated above the menu. -->
    <SolidColorBrush x:Key="SidebarCardBrush"
                     Color="#273449"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="OverlayButtonBackgroundBrush"
                     Color="#38BDF8"
                     po:Freeze="True"/>

    <!-- ── About page liquid palette (dark) ───────────────────────────
         2026-08-25: moved from Views/About/AboutStyles.xaml into the
         theme so the About page (all three sections) re-tints LIVE on
         Light/Dark swap, visual-family change (Monet/Professional/
         iOS Liquid Glass/Ocean) and wallpaper layering. The About view now rides
         on the same dynamic module surface as every other module
         (ModuleBackgroundBrush + ModuleWallpaperBrush from the content
         card) instead of painting a fixed navy stage, and every
         Liquid* reference in the About module is a DynamicResource
         that re-resolves against whichever theme dictionary is
         active. Light values live in LightTheme.xaml. -->
    <SolidColorBrush x:Key="LiquidIce"
                     Color="#DBEAFE"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidFrost"
                     Color="#BFDBFE"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidCerulean"
                     Color="#93C5FD"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidSnow"
                     Color="#F8FAFC"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidAccent"
                     Color="#60A5FA"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidAccentDeep"
                     Color="#3B82F6"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidMuted"
                     Color="#8FB3E6"
                     po:Freeze="True"/>
    <!-- Frosted card fill + top sheen (translucent white over the
         dark module surface). -->
    <LinearGradientBrush x:Key="LiquidCard"
                         StartPoint="0,0" EndPoint="0,1"
                         po:Freeze="True">
        <GradientStop Color="#2EFFFFFF" Offset="0.0"/>
        <GradientStop Color="#27FFFFFF" Offset="0.06"/>
        <GradientStop Color="#3AFFFFFF" Offset="0.16"/>
        <GradientStop Color="#1AFFFFFF" Offset="0.50"/>
        <GradientStop Color="#0DFFFFFF" Offset="0.93"/>
        <GradientStop Color="#11FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LiquidSheen"
                         StartPoint="0,0" EndPoint="1,1"
                         po:Freeze="True">
        <GradientStop Color="#26FFFFFF" Offset="0.0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
    </LinearGradientBrush>
    <!-- Decorative aurora orbs (subtle glows, see AboutView). -->
    <RadialGradientBrush x:Key="LiquidOrbA"
                         Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5"
                         po:Freeze="True">
        <GradientStop Color="#4D82F6FF" Offset="0.0"/>
        <GradientStop Color="#1D4ED84D" Offset="0.55"/>
        <GradientStop Color="#1D4ED800" Offset="1.0"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="LiquidOrbB"
                         Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5"
                         po:Freeze="True">
        <GradientStop Color="#60A5FA66" Offset="0.0"/>
        <GradientStop Color="#3B82F633" Offset="0.55"/>
        <GradientStop Color="#3B82F600" Offset="1.0"/>
    </RadialGradientBrush>

    <!-- About interactive chrome tokens. ThemeManager rewrites these at
         runtime from the active accent; these defaults guarantee the
         About page still renders correctly before the dynamic engine runs. -->
    <SolidColorBrush x:Key="AboutInteractiveBrush"
                     Color="#14FFFFFF"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="AboutInteractiveHoverBrush"
                     Color="#20FFFFFF"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="AboutInteractiveBorderBrush"
                     Color="#4093C5FD"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="AboutInteractiveBorderStrongBrush"
                     Color="#6693C5FD"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="AboutCardBorderBrush"
                     Color="#6693C5FD"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="AboutDividerBrush"
                     Color="#2293C5FD"
                     po:Freeze="True"/>

    <!-- ── Text ─────────────────────────────────────────────────────── -->
    <Color x:Key="PrimaryForegroundColor">#F1F5F9</Color>
    <Color x:Key="SecondaryForegroundColor">#94A3B8</Color>
    <Color x:Key="MutedForegroundColor">#64748B</Color>
    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="WarningColor">#FBBF24</Color>
    <Color x:Key="DangerColor">#F87171</Color>
    <Color x:Key="TintIndigoColor">#252B48</Color>
    <Color x:Key="TintRedColor">#3B1F22</Color>
    <Color x:Key="TintGreenColor">#1E2B44</Color>
    <Color x:Key="TintAmberColor">#3B2F1E</Color>
    <Color x:Key="TintPurpleColor">#2A2540</Color>
    <Color x:Key="TintGrayColor">#242B3A</Color>
    <Color x:Key="BorderColor">#334155</Color>
    <SolidColorBrush x:Key="PrimaryForegroundBrush"
                     Color="#F1F5F9"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush"
                     Color="#94A3B8"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="MutedForegroundBrush"
                     Color="#64748B"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="OnAccentForegroundBrush"
                     Color="#FFFFFF"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="OnAccentSecondaryForegroundBrush"
                     Color="#CCFFFFFF"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="OverlayButtonForegroundBrush"
                     Color="#FFFFFF"
                     po:Freeze="True"/>

    <!-- ── Brand accents — industrial steel cyan (dark-lifted) ─────── -->
    <SolidColorBrush x:Key="AccentBrush"
                     Color="#38BDF8"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentHoverBrush"
                     Color="#7DD3FC"
                     po:Freeze="True"/>
    <!-- Color-typed counterparts of the accent brushes (see LightTheme). -->
    <Color x:Key="AccentColor">#38BDF8</Color>
    <Color x:Key="AccentHoverColor">#7DD3FC</Color>
    <Color x:Key="AccentDarkColor">#0369A1</Color>
    <Color x:Key="AccentLightColor">#7DD3FC</Color>
    <SolidColorBrush x:Key="AccentDarkBrush"
                     Color="#0369A1"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentLightBrush"
                     Color="#7DD3FC"
                     po:Freeze="True"/>

    <!-- ── Semantic ────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="SuccessBrush"
                     Color="#34D399"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="WarningBrush"
                     Color="#FBBF24"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerBrush"
                     Color="#F87171"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="InfoBrush"
                     Color="#38BDF8"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="NeutralBrush"
                     Color="#94A3B8"
                     po:Freeze="True"/>

    <!-- ── Tinted card backgrounds ─────────────────────────────────── -->
    <SolidColorBrush x:Key="TintIndigoBrush"
                     Color="#252B48"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="TintGreenBrush"
                     Color="#1E2B44"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="TintAmberBrush"
                     Color="#3B2F1E"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="TintBlueBrush"
                     Color="#1E2B44"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="TintRedBrush"
                     Color="#3B1F22"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="TintGrayBrush"
                     Color="#242B3A"
                     po:Freeze="True"/>
    <SolidColorBrush x:Key="TintPurpleBrush"
                     Color="#2A2540"
                     po:Freeze="True"/>

    <!-- ── Borders + dividers ──────────────────────────────────────── -->
    <SolidColorBrush x:Key="BorderBrush"
                     Color="#334155"
                     po:Freeze="True"/>
    <!-- OUTLINE — see LightTheme for why this is separate from BorderBrush.
         NOTE: pure black is NOT usable here. On a dark surface (#0F172A and
         friends) a #000 edge disappears and reads as a hole, so the dark
         theme uses a LIFTED slate that still separates the shape. -->
    <SolidColorBrush x:Key="OutlineBrush"
                     Color="#64748B"
                     po:Freeze="True"/>

    <!-- Immutable copy of the subtle default. ApplyOutline overwrites
         OutlineBrush at runtime, so it needs a pristine source to restore
         from when the toggle is switched back off. -->
    <SolidColorBrush x:Key="OutlineDefaultBrush"
                     Color="#64748B"
                     po:Freeze="True"/>

    <SolidColorBrush x:Key="OutlineStrongBrush"
                     Color="#7C8CA6"
                     po:Freeze="True"/>

    <SolidColorBrush x:Key="DividerBrush"
                     Color="#334155"
                     po:Freeze="True"/>

    <!-- ═══════════════════════════════════════════════════════════════
         DASHBOARD GLASSMORPHISM — DARK MODE (NEW in v1.6)
    ═══════════════════════════════════════════════════════════════ -->

    <!-- Ambient background — deep slate → dark blue gradient. -->
    <LinearGradientBrush x:Key="DashAmbientBrush"
                         StartPoint="0,0" EndPoint="1,1"
                         po:Freeze="True">
        <GradientStop Color="#0F172A" Offset="0.0"/>
        <GradientStop Color="#1E293B" Offset="0.5"/>
        <GradientStop Color="#1E3A5F" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Bold blue brand gradient for dashboard hero cards / high-emphasis
         visuals. Dark theme: rich navy -> electric blue. -->
    <LinearGradientBrush x:Key="DashHeroBlueBrush"
                         StartPoint="0,0" EndPoint="1,1"
                         po:Freeze="True">
        <GradientStop Color="#075985" Offset="0.0"/>
        <GradientStop Color="#0284C7" Offset="0.6"/>
        <GradientStop Color="#38BDF8" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Top-right accent blob — 27% alpha (brighter for dark bg). -->
    <RadialGradientBrush x:Key="DashAmbientBlob1Brush"
                         Center="0.85,0.15"
                         GradientOrigin="0.85,0.15"
                         RadiusX="0.35" RadiusY="0.35"
                         po:Freeze="True">
        <GradientStop Color="#3B82F645" Offset="0.0"/>
        <GradientStop Color="#3B82F600" Offset="1.0"/>
    </RadialGradientBrush>

    <!-- Bottom-left accent blob — 18% alpha deep blue. -->
    <RadialGradientBrush x:Key="DashAmbientBlob2Brush"
                         Center="0.12,0.88"
                         GradientOrigin="0.12,0.88"
                         RadiusX="0.30" RadiusY="0.30"
                         po:Freeze="True">
        <GradientStop Color="#1D4ED830" Offset="0.0"/>
        <GradientStop Color="#1D4ED800" Offset="1.0"/>
    </RadialGradientBrush>

    <!-- Glass card fill — elevated slate at 82% opacity. -->
    <SolidColorBrush x:Key="DashLiquidSurfaceBrush"
                     Color="#273449"
                     Opacity="0.82"
                     po:Freeze="True"/>

    <!-- Glass card border — slate-hover → deep blue. -->
    <LinearGradientBrush x:Key="DashLiquidBorderBrush"
                         StartPoint="0,0" EndPoint="1,1"
                         po:Freeze="True">
        <GradientStop Color="#334155" Offset="0.0"/>
        <GradientStop Color="#1E3A8A" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Accent text on dark glass — brighter for contrast. -->
    <SolidColorBrush x:Key="DashAccentTextBrush"
                     Color="#60A5FA"
                     po:Freeze="True"/>

    <!-- Card shadow — pure black for dark theme depth. -->
    <DropShadowEffect x:Key="DashCardShadowEffect"
                      BlurRadius="24"
                      ShadowDepth="6"
                      Opacity="0.55"
                      Color="#000000"
                      Direction="270"
                      po:Freeze="True"/>

    <!-- Interactive shadow — bright blue glow. -->
    <DropShadowEffect x:Key="DashInteractiveShadowEffect"
                      BlurRadius="12"
                      ShadowDepth="3"
                      Opacity="0.35"
                      Color="#3B82F6"
                      Direction="270"
                      po:Freeze="True"/>

    <!-- Subtle shadow — for list rows. -->
    <DropShadowEffect x:Key="DashSubtleShadowEffect"
                      BlurRadius="8"
                      ShadowDepth="2"
                      Opacity="0.30"
                      Color="#000000"
                      Direction="270"
                      po:Freeze="True"/>

    <!-- ═══════════════════════════════════════════════════════════════
         CARD SHAPE + MOTION TOKENS (additive — Dynamic Theme Engine)
         Mirrors LightTheme tokens. PerformanceProfileService replaces
         MotionDuration* at runtime scaled to the display refresh tier.
    ═══════════════════════════════════════════════════════════════ -->

    <!-- Per-module wallpaper layer (set by VisualThemeEngine; stays
         transparent when the active module has no wallpaper). -->
    <SolidColorBrush x:Key="ModuleWallpaperBrush"
                     Color="Transparent"
                     po:Freeze="True"/>

    <!-- Card shapes — one source of truth for corner radii. -->
    <CornerRadius x:Key="ControlCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="CardCornerRadiusLarge">12</CornerRadius>

    <!-- Card border thickness — one source of truth for every card/panel
         edge. Driven by the Appearance > Border Thickness setting; cards
         reference this via {DynamicResource CardBorderThickness}. -->
    <Thickness x:Key="CardBorderThickness">1.5</Thickness>

    <sys:Double x:Key="DensityInputHeight">30</sys:Double>
    <sys:Double x:Key="DensityButtonHeight">32</sys:Double>
    <sys:Double x:Key="DensityRowHeight">28</sys:Double>
    <sys:Double x:Key="DensityTitleFontSize">18</sys:Double>
    <sys:Double x:Key="DensityKpiValueFontSize">16</sys:Double>
    <Thickness x:Key="DensityCardPadding">10,8</Thickness>
    <Thickness x:Key="DensityStripPadding">12,8</Thickness>
    <Thickness x:Key="DensityPageMargin">12,8</Thickness>

    <!-- Motion defaults (pre-profile values; tuned at startup). -->
    <sys:Double x:Key="MotionSpeedRatio">1.0</sys:Double>
    <Duration x:Key="MotionDurationFast">0:0:0.12</Duration>
    <Duration x:Key="MotionDurationNorm">0:0:0.22</Duration>
    <Duration x:Key="MotionDurationSlow">0:0:0.38</Duration>
    <sys:Boolean x:Key="RichEffectsEnabled">False</sys:Boolean>
    <sys:Boolean x:Key="UltraSmoothEnabled">False</sys:Boolean>
    <sys:Int32 x:Key="TargetFps">60</sys:Int32>

    <!-- ── BrushKeyConverter ────────────────────────────────────── -->
    <conv:BrushKeyConverter x:Key="BrushKeyConverter"/>

    <!-- ═══════════════════════════════════════════════════════════════
         LIQUID-GLASS SHELL CHROME (top bar · sidebar · dropdowns)
         Frosted translucent surfaces over the dark aurora stage.
    ═══════════════════════════════════════════════════════════════ -->
    <LinearGradientBrush x:Key="ShellLiquidBrush" StartPoint="0,0" EndPoint="0,1"
                         po:Freeze="True">
        <GradientStop Color="#3DFFFFFF" Offset="0.0"/>
        <GradientStop Color="#1CFFFFFF" Offset="0.55"/>
        <GradientStop Color="#14FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ShellLiquidBorderBrush" Color="#3DFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="ShellSheenBrush" Color="#40FFFFFF" po:Freeze="True"/>
    <RadialGradientBrush x:Key="AuroraA" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5"
                         po:Freeze="True">
        <GradientStop Color="#4D38BDF8" Offset="0.0"/>
        <GradientStop Color="#1D38BDF800" Offset="1.0"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AuroraB" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5"
                         po:Freeze="True">
        <GradientStop Color="#408183F4" Offset="0.0"/>
        <GradientStop Color="#1D6366F100" Offset="1.0"/>
    </RadialGradientBrush>


    <!-- ═══════════════════════════════════════════════════════════════
         LIQUID GLASS DESIGN SYSTEM — DARK MODE TOKENS (2026-08-29)
         Deep crystal: low-alpha frost centers, controlled crystal
         highlights. NOT an inversion of light — dark has its own
         intentional alpha ramp.
    ═══════════════════════════════════════════════════════════════════ -->
    <LinearGradientBrush x:Key="LiquidGlassBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#26FFFFFF" Offset="0.0"/>
        <GradientStop Color="#20FFFFFF" Offset="0.07"/>
        <GradientStop Color="#30FFFFFF" Offset="0.16"/>
        <GradientStop Color="#1CFFFFFF" Offset="0.45"/>
        <GradientStop Color="#12FFFFFF" Offset="0.80"/>
        <GradientStop Color="#0DFFFFFF" Offset="0.93"/>
        <GradientStop Color="#11FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LiquidGlassSubtleBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#14FFFFFF" Offset="0.0"/>
        <GradientStop Color="#0FFFFFFF" Offset="0.12"/>
        <GradientStop Color="#1CFFFFFF" Offset="0.24"/>
        <GradientStop Color="#0AFFFFFF" Offset="0.65"/>
        <GradientStop Color="#0DFFFFFF" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LiquidGlassStrongBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#3DFFFFFF" Offset="0.0"/>
        <GradientStop Color="#38FFFFFF" Offset="0.07"/>
        <GradientStop Color="#47FFFFFF" Offset="0.16"/>
        <GradientStop Color="#1FFFFFFF" Offset="0.55"/>
        <GradientStop Color="#18FFFFFF" Offset="0.92"/>
        <GradientStop Color="#1BFFFFFF" Offset="1.0"/>
    </LinearGradientBrush>
    <!-- Crystal edge: bright top highlight, soft mid, subtle lower edge. -->
    <LinearGradientBrush x:Key="LiquidEdgeBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#8CFFFFFF" Offset="0.0"/>
        <GradientStop Color="#26FFFFFF" Offset="0.5"/>
        <GradientStop Color="#33FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LiquidInnerHighlightBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#00FFFFFF" Offset="0.0"/>
        <GradientStop Color="#59FFFFFF" Offset="0.5"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LiquidReflectionBrush" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#26FFFFFF" Offset="0.0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.45"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LiquidControlHoverBrush" Color="#33FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidControlPressedBrush" Color="#1CFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidControlDisabledBrush" Color="#14FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="LiquidFocusBrush" Color="#9960A5FA" po:Freeze="True"/>
    <LinearGradientBrush x:Key="LiquidSelectionBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#4D3B82F6" Offset="0.0"/>
        <GradientStop Color="#333B82F6" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LiquidPrimaryButtonBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#A63B82F6" Offset="0.0"/>
        <GradientStop Color="#733B82F6" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LiquidOverlayBrush" Color="#99031026" po:Freeze="True"/>
    <Color x:Key="LiquidShadowColor">#FF000410</Color>

    <!-- ═══════════════════════════════════════════════════════════════
         LIQUID GLASS DESIGN SYSTEM — CANONICAL TOKENS (DARK MODE)
         2026-08-29: Dark variants of the glass tokens. Light mode
         uses white-based tints; dark mode uses subtle dark tints
         with light crystal edges. The control templates in
         LiquidGlassDesign.xaml reference these via {DynamicResource}
         so the entire glass system re-tints on theme swap.
    ═══════════════════════════════════════════════════════════════════ -->

    <!-- Glass text — light on dark -->
    <Color x:Key="TextPrimaryColor">#F5F5F7</Color>
    <Color x:Key="TextSecondaryColor">#8CF5F5F7</Color>
    <Color x:Key="AccentBlueColor">#28BEFF</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" po:Freeze="True"/>

    <!-- Glass surfaces — subtle dark tints on dark stage -->
    <SolidColorBrush x:Key="GlassSurfaceUltra" Color="#1A1E293B" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassSurfaceStandard" Color="#2A2D3B4F" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassSurfaceElevated" Color="#3A374A5E" po:Freeze="True"/>

    <!-- Glass borders — subtle light edges on dark stage -->
    <SolidColorBrush x:Key="GlassBorderPrimary" Color="#4DFFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassBorderBright" Color="#66FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="GlassBorderSoft" Color="#33FFFFFF" po:Freeze="True"/>

    <!-- Glass gradients — dark-based -->
    <LinearGradientBrush x:Key="GlassGradientIdle" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#1E2D3B4F" Offset="0.0"/>
        <GradientStop Color="#0A1E293B" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassGradientActive" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#9928BEFF" Offset="0.0"/>
        <GradientStop Color="#4D82E1FF" Offset="0.5"/>
        <GradientStop Color="#8032AFF5" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassTopReflection" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#4DFFFFFF" Offset="0.0"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- App background — deep dark blue for dark mode -->
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#0A1628" Offset="0.0"/>
