<!-- ═══════════════════════════════════════════════════════════════════════
     FILE: Themes/Professional/ProfessionalShell.xaml
     PROJECT: ProGlassAutomation
     SYSTEM: Concept 30 PORCELAIN FLOW (Study 07 Editorial Wordmark)

     SHELL — continuous porcelain-white (#FCFCFE) L-shaped header and drawer,
     nested thin keylines (#D9D5E6), black-violet ink (#211D31),
     soft lavender utility ribbon (#E6E1F4), fine purple focus rim (#8E82D8),
     and dark-violet selected row (#443A86). Flat opaque surfaces only.
═══════════════════════════════════════════════════════════════════════ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ═══ GEOMETRY & SIZING TOKENS ═══ -->
    <sys:Double x:Key="PgTopBarHeight">56</sys:Double>
    <sys:Double x:Key="PgTopRowHeight">56</sys:Double>
    <sys:Double x:Key="PgTopCtrlHeight">32</sys:Double>
    <sys:Double x:Key="PgSidebarWidth">260</sys:Double>
    <sys:Double x:Key="PgSidebarItemHeight">38</sys:Double>
    <sys:Double x:Key="PgSidebarSubItemHeight">34</sys:Double>
    <sys:Double x:Key="PgTopFont">11.5</sys:Double>
    <sys:Double x:Key="PgTopFontCap">9.5</sys:Double>
    <sys:Double x:Key="PgTopFontBtn">13</sys:Double>

    <!-- ═══ FULL LIGHT STUDIO BENTO PALETTE BRUSHES (BENTO INDIGO SYSTEM) ═══ -->
    <SolidColorBrush x:Key="PgPorcelainSurfaceBrush" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="PgModuleBgBrush"          Color="#F3F0FA" po:Freeze="True"/>
    <SolidColorBrush x:Key="PgLavenderRibbonBrush"    Color="#EEE8F8" po:Freeze="True"/>
    <SolidColorBrush x:Key="PgLavenderHoverBrush"     Color="#E4DCF5" po:Freeze="True"/>
    <SolidColorBrush x:Key="PgLavenderPressedBrush"   Color="#D8CEEE" po:Freeze="True"/>
    <SolidColorBrush x:Key="PgKeylineBrush"           Color="#E2DBEF" po:Freeze="True"/>
    <SolidColorBrush x:Key="PgVioletInkBrush"         Color="#2C2440" po:Freeze="True"/>
    <SolidColorBrush x:Key="PgSelectedRowBrush"       Color="#6546B5" po:Freeze="True"/>
    <SolidColorBrush x:Key="PgFocusRimBrush"          Color="#6546B5" po:Freeze="True"/>
    <SolidColorBrush x:Key="PgTextMutedBrush"         Color="#6B6078" po:Freeze="True"/>
    <SolidColorBrush x:Key="PgWhiteBrush"             Color="#FFFFFF" po:Freeze="True"/>

    <!-- ═══════════════════════════════════════════════════════════════
         1 · TOP BAR & HEADER
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="PgTopBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PgPorcelainSurfaceBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Square icon button: thin hamburger, crescent moon, X close -->
    <Style x:Key="PgTopIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource PgTopCtrlHeight}"/>
        <Setter Property="Height" Value="{StaticResource PgTopCtrlHeight}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource PgVioletInkBrush}"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="{StaticResource PgTopFontBtn}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource PgLavenderRibbonBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource PgVioletInkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource PgLavenderHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Info pill (date/time, connectivity) -->
    <Style x:Key="PgTopPillStyle" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource PgTopCtrlHeight}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="PgTopPillIconStyle" TargetType="Border">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="{StaticResource PgLavenderRibbonBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PgPillCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource PgTopFontCap}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource PgTextMutedBrush}"/>
        <Setter Property="LineHeight" Value="12"/>
    </Style>

    <Style x:Key="PgPillTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource PgTopFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource PgVioletInkBrush}"/>
        <Setter Property="LineHeight" Value="14"/>
    </Style>

    <!-- AI Agent Pill (soft-accent capsule) -->
    <Style x:Key="PgAiPillStyle" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource PgTopCtrlHeight}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Height="{StaticResource PgTopCtrlHeight}"
                            Padding="10,0"
                            Background="Transparent"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE946;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Foreground="{StaticResource PgVioletInkBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource PgLavenderHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource PgLavenderPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- User card: initials circle + name + role -->
    <Style x:Key="PgUserCardStyle" TargetType="Button">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="4,2,8,2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="18"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource PgLavenderRibbonBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource PgLavenderHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 28×28 round avatar with initials "U" -->
    <Style x:Key="PgAvatarStyle" TargetType="Border">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Background" Value="{StaticResource PgLavenderRibbonBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PgFocusRimBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Brand mark / wordmark styles: Study 07 Editorial Wordmark -->
    <Style x:Key="PgBrandLogoStyle" TargetType="Border">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="{StaticResource PgLavenderRibbonBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="PgBrandLogoTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{StaticResource PgVioletInkBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Modern clean display wordmark "ProGlass" -->
    <Style x:Key="PgBrandTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource PgVioletInkBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Tiny letter-spaced caps "AUTOMATION SUITE" aligned to baseline -->
    <Style x:Key="PgBrandSubStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
        <Setter Property="FontSize" Value="8.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource PgTextMutedBrush}"/>
        <Setter Property="Margin" Value="8,0,0,3"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>

    <!-- Search frame -->
    <Style x:Key="PgSearchFrameStyle" TargetType="Border">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="{StaticResource PgWhiteBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PgFocusRimBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="PgSearchPlaceholderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource PgTopFont}"/>
        <Setter Property="Foreground" Value="{StaticResource PgTextMutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
    </Style>

    <Style x:Key="PgSearchKbdStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PgPorcelainSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PgKeylineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="5,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PgTopBadgeDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="7"/>
        <Setter Property="Height" Value="7"/>
        <Setter Property="Fill" Value="{StaticResource PgFocusRimBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,4,4,0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         2 · SECONDARY UTILITY RIBBON (soft lavender inlay)
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="PgRibbonActionStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="7,0"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PgLavenderHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PgLavenderPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PgRibbonIconStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource PgVioletInkBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,5,0"/>
    </Style>

    <Style x:Key="PgRibbonLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource PgVioletInkBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Row inside the professional More menu. Left-aligned, no min-width. -->
    <Style x:Key="PgShellMenuRowStyle" TargetType="Button">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="4,1"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PgLavenderRibbonBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PgLavenderHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         3 · SIDEBAR (drawer)
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="PgDrawerStyle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource PgSidebarWidth}"/>
        <Setter Property="Background" Value="{StaticResource PgPorcelainSurfaceBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Sidebar Group Category Label -->
    <Style x:Key="PgSidebarGroupLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource PgTextMutedBrush}"/>
        <Setter Property="Margin" Value="12,12,10,4"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <!-- NAV ITEM — 38px editorial scale, thin icon -->
    <Style x:Key="PgSidebarItemStyle" TargetType="Button">
        <Setter Property="behaviors:BounceHover.IsEnabled"  Value="True"/>
        <Setter Property="behaviors:BounceHover.HoverScale" Value="1.02"/>
        <Setter Property="behaviors:BounceHover.PressScale" Value="0.98"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="8,2,8,2"/>
        <Setter Property="Height" Value="{StaticResource PgSidebarItemHeight}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="Transparent"
                            CornerRadius="8"
                            Padding="10,0"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="Icon"
                                       Text="{TemplateBinding Tag}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="{StaticResource PgTextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <TextBlock x:Name="Label"
                                       Text="{TemplateBinding Content}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource PgVioletInkBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource PgLavenderRibbonBrush}"/>
                            <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource PgVioletInkBrush}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource PgVioletInkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource PgLavenderHoverBrush}"/>
                        </Trigger>
                        <!-- Active module: dark-violet (#443A86) filled rounded row, white text -->
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource StringEqualsMultiConverter}">
                                    <Binding Path="CommandParameter" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="DataContext.CurrentModuleKey" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource PgSelectedRowBrush}"/>
                            <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource PgWhiteBrush}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource PgWhiteBrush}"/>
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- GROUP TOGGLE — chevron rotates 0→90° -->
    <Style x:Key="PgSidebarGroupToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="8,2,8,2"/>
        <Setter Property="Height" Value="{StaticResource PgSidebarItemHeight}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg"
                            Background="Transparent"
                            CornerRadius="8"
                            Padding="10,0"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="Icon"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="{StaticResource PgTextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <TextBlock x:Name="Label"
                                           Text="{TemplateBinding Content}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PgVioletInkBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock x:Name="Chevron"
                                       Text="&#xE76C;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       Foreground="{StaticResource PgTextMutedBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="ChevronRotate" Angle="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource PgLavenderRibbonBrush}"/>
                            <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource PgVioletInkBrush}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource PgVioletInkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="Foreground" Value="{StaticResource PgSelectedRowBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ChevronRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="90" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ChevronRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="90" To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sub-menu container -->
    <Style x:Key="PgSidebarSubListStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource PgKeylineBrush}"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
        <Setter Property="Padding" Value="4,2,2,2"/>
        <Setter Property="Margin" Value="24,0,10,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- SUB-ITEM — 34px, Active: dark-violet (#443A86) filled rounded row, white text -->
    <Style x:Key="PgSidebarSubItemStyle" TargetType="Button">
        <Setter Property="behaviors:BounceHover.IsEnabled"  Value="True"/>
        <Setter Property="behaviors:BounceHover.HoverScale" Value="1.02"/>
        <Setter Property="behaviors:BounceHover.PressScale" Value="0.98"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="4,1,6,1"/>
        <Setter Property="Height" Value="{StaticResource PgSidebarSubItemHeight}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="Transparent"
                            CornerRadius="7"
                            Padding="10,0"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Dot"
                                    Width="4" Height="4"
                                    CornerRadius="2"
                                    Background="{StaticResource PgFocusRimBrush}"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True"/>
                            <TextBlock x:Name="Label"
                                       Text="{TemplateBinding Content}"
                                       FontSize="11.5"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource PgVioletInkBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource PgLavenderRibbonBrush}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource PgVioletInkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource PgLavenderHoverBrush}"/>
                        </Trigger>
                        <!-- Active module: dark-violet (#443A86) filled rounded row, white text! -->
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource StringEqualsMultiConverter}">
                                    <Binding Path="CommandParameter" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="DataContext.CurrentModuleKey" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource PgSelectedRowBrush}"/>
                            <Setter TargetName="Dot" Property="Background" Value="{StaticResource PgWhiteBrush}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource PgWhiteBrush}"/>
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Storage card style -->
    <Style x:Key="PgStorageCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PgLavenderRibbonBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PgKeylineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         4 · MODULE BAR & COMMON PRESERVED STYLES
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="PgModBarStyle" TargetType="Border">
        <Setter Property="Height" Value="52"/>
        <Setter Property="Background" Value="{StaticResource PgPorcelainSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PgKeylineBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="PgSegGroupStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PgLavenderRibbonBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="PgSegItemStyle" TargetType="ToggleButton">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource PgVioletInkBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="Glyph"
                                       Text="{TemplateBinding Tag}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Margin="0,0,7,0"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource PgLavenderHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource PgSelectedRowBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource PgWhiteBrush}"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource PgWhiteBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PgRefreshChipStyle" TargetType="Border" BasedOn="{StaticResource PgChipStyle}">
        <Setter Property="Height" Value="{StaticResource PgTopCtrlHeight}"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>

    <Style x:Key="PgUserChipStyle" TargetType="Border" BasedOn="{StaticResource PgChipStyle}">
        <Setter Property="Height" Value="{StaticResource PgTopCtrlHeight}"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>

</ResourceDictionary>
