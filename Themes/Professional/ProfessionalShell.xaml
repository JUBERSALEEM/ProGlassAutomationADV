<!-- ═══════════════════════════════════════════════════════════════════════
     FILE: Themes/Professional/ProfessionalShell.xaml
     PROJECT: ProGlassAutomation
     SYSTEM: MERIDIAN — the full 0→100 UI rewrite design system

     SHELL — top bar + sidebar (drawer). Every colour resolves through
     {DynamicResource Pg*} tokens defined in BOTH theme dictionaries, so
     the runtime Light/Dark swap re-tints the shell live.

     PRESERVED MECHANICS (from Themes/Styles/ShellStyles.xaml — do not
     break; the rewritten MainWindow.xaml depends on them):
       • Active-module detection = DataTrigger + MultiBinding
         StringEqualsMultiConverter on (CommandParameter,
         DataContext.CurrentModuleKey) — the open module is always lit.
       • BounceHover behavior on nav items (1.03/0.975) and sub-items
         (1.02/0.98).
       • Chevron RotateTransform 0→90° animation on group IsChecked.
       • Icon arrives on Button.Tag (MDL2 glyph), label on Content.
═══════════════════════════════════════════════════════════════════════ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ═══ geometry ═══ -->
    <sys:Double x:Key="PgTopBarHeight">52</sys:Double>
    <sys:Double x:Key="PgTopCtrlHeight">34</sys:Double>
    <sys:Double x:Key="PgSidebarWidth">258</sys:Double>
    <sys:Double x:Key="PgSidebarItemHeight">40</sys:Double>
    <sys:Double x:Key="PgSidebarSubItemHeight">34</sys:Double>
    <sys:Double x:Key="PgTopFont">11.5</sys:Double>
    <sys:Double x:Key="PgTopFontCap">9.5</sys:Double>
    <sys:Double x:Key="PgTopFontBtn">14</sys:Double>

    <!-- ═══════════════════════════════════════════════════════════════
         1 · TOP BAR
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="PgTopBarStyle" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource PgTopBarHeight}"/>
        <Setter Property="Background" Value="{DynamicResource PgSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PgHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 34×34 square icon button. Content = MDL2 glyph string. -->
    <Style x:Key="PgTopIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource PgTopCtrlHeight}"/>
        <Setter Property="Height" Value="{StaticResource PgTopCtrlHeight}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PgText2Brush}"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="{StaticResource PgTopFontBtn}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource PgCtrlRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PgSurface3Brush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PgText1Brush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PgHairlineBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Info pill (date/time, connectivity): sf2, hairline, 34px. -->
    <Style x:Key="PgTopPillStyle" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource PgTopCtrlHeight}"/>
        <Setter Property="Background" Value="{DynamicResource PgSurface2Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PgHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource PgCtrlRadius}"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 22×22 accent icon square inside a pill. Tag carries the MDL2 glyph. -->
    <Style x:Key="PgTopPillIconStyle" TargetType="Border">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource PgAccentBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PgPillCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource PgTopFontCap}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource PgText3Brush}"/>
        <Setter Property="LineHeight" Value="12"/>
    </Style>

    <Style x:Key="PgPillTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource PgTopFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource PgText1Brush}"/>
        <Setter Property="LineHeight" Value="14"/>
    </Style>

    <!-- AI AGENT pill — real Button, 999 radius, soft-accent, pulsing ok dot. -->
    <Style x:Key="PgAiPillStyle" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource PgTopCtrlHeight}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Height="{StaticResource PgTopCtrlHeight}"
                            Padding="12,0"
                            Background="{DynamicResource PgAccentSoftBrush}"
                            BorderBrush="{DynamicResource PgAccentBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource PgChipRadius}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="14" Height="14" Margin="0,0,8,0">
                                <Ellipse Fill="{DynamicResource PgOkBrush}" Opacity="0.4">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="AiPulseScale"
                                                        ScaleX="1" ScaleY="1"
                                                        CenterX="7" CenterY="7"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetName="AiPulseScale"
                                                        Storyboard.TargetProperty="ScaleX"
                                                        From="1" To="2.2" Duration="0:0:2"/>
                                                    <DoubleAnimation
                                                        Storyboard.TargetName="AiPulseScale"
                                                        Storyboard.TargetProperty="ScaleY"
                                                        From="1" To="2.2" Duration="0:0:2"/>
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="Opacity"
                                                        From="0.5" To="0" Duration="0:0:2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <Ellipse Width="8" Height="8"
                                         Fill="{DynamicResource PgOkBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.72"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- User card: avatar + name + role, 34px, hairline. -->
    <Style x:Key="PgUserCardStyle" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource PgTopCtrlHeight}"/>
        <Setter Property="Padding" Value="10,3,10,3"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PgHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource PgCtrlRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PgSurface3Brush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PgHairlineBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 26×26 gradient avatar with initials. -->
    <Style x:Key="PgAvatarStyle" TargetType="Border">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Background" Value="{DynamicResource PgBrandGradient}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Brand block: 30×30 logo tile + wordmark. -->
    <Style x:Key="PgBrandLogoStyle" TargetType="Border">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{DynamicResource PgBrandGradient}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="PgBrandLogoTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{DynamicResource PgAccentInkBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PgBrandTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource PgText1Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PgBrandSubStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource PgTopFontCap}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource PgText3Brush}"/>
        <Setter Property="Margin" Value="0,1,0,0"/>
    </Style>

    <!-- Search frame: sf2, hairline, 34px; hosts glyph + query + kbd. -->
    <Style x:Key="PgSearchFrameStyle" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource PgTopCtrlHeight}"/>
        <Setter Property="Background" Value="{DynamicResource PgSurface2Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PgHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource PgCtrlRadius}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="PgSearchPlaceholderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource PgTopFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource PgText3Brush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>

    <Style x:Key="PgSearchKbdStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PgSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PgHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="5,3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Notification badge dot for top-bar icon buttons. -->
    <Style x:Key="PgTopBadgeDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Fill" Value="{DynamicResource PgDangerBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,6,7,0"/>
        <Setter Property="Stroke" Value="{DynamicResource PgSurfaceBrush}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         2 · SIDEBAR (drawer)
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="PgDrawerStyle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource PgSidebarWidth}"/>
        <Setter Property="Background" Value="{DynamicResource PgSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PgHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- MAIN / SALES / … group labels. -->
    <Style x:Key="PgSidebarGroupLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PgText3Brush}"/>
        <Setter Property="Margin" Value="10,16,10,7"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <!-- NAV ITEM — 28×28 icon chip + label, 40px.
         Active: soft-accent fill + 600 weight + 3px inset accent bar +
         filled accent chip. Detection mechanism preserved from
         ShellStyles (StringEqualsMultiConverter MultiBinding). -->
    <Style x:Key="PgSidebarItemStyle" TargetType="Button">
        <Setter Property="behaviors:BounceHover.IsEnabled"  Value="True"/>
        <Setter Property="behaviors:BounceHover.HoverScale" Value="1.03"/>
        <Setter Property="behaviors:BounceHover.PressScale" Value="0.975"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="10,2,10,2"/>
        <Setter Property="Height" Value="{StaticResource PgSidebarItemHeight}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="Transparent"
                            CornerRadius="9"
                            Padding="9,0"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- 3px inset active bar (left edge) -->
                            <Border x:Name="Accent"
                                    Width="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Margin="0,8"
                                    CornerRadius="1.5"
                                    Background="{DynamicResource PgAccentBrush}"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="Chip"
                                        Width="28" Height="28"
                                        CornerRadius="{StaticResource PgIconSmRadius}"
                                        Background="{DynamicResource PgSurface3Brush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0"
                                        SnapsToDevicePixels="True">
                                    <TextBlock x:Name="Icon"
                                               Text="{TemplateBinding Tag}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="{StaticResource PgTopFontBtn}"
                                               Foreground="{DynamicResource PgText2Brush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="Label"
                                           Text="{TemplateBinding Content}"
                                           FontSize="{StaticResource PgFontBody}"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource PgText2Brush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PgSurface3Brush}"/>
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource PgText1Brush}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource PgText1Brush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PgHairlineBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PgSurface3Brush}"/>
                        </Trigger>
                        <!-- Active module (mechanism preserved) -->
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource StringEqualsMultiConverter}">
                                    <Binding Path="CommandParameter" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="DataContext.CurrentModuleKey" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PgAccentSoftBrush}"/>
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource PgAccentBrush}"/>
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource PgAccentInkBrush}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource PgAccentBrush}"/>
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="Accent" Property="Opacity" Value="1"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- GROUP TOGGLE — chip + label + animated chevron (0→90°). -->
    <Style x:Key="PgSidebarGroupToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="10,2,10,2"/>
        <Setter Property="Height" Value="{StaticResource PgSidebarItemHeight}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg"
                            Background="Transparent"
                            CornerRadius="9"
                            Padding="9,0"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="Chip"
                                        Width="28" Height="28"
                                        CornerRadius="{StaticResource PgIconSmRadius}"
                                        Background="{DynamicResource PgSurface3Brush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0"
                                        SnapsToDevicePixels="True">
                                    <TextBlock x:Name="Icon"
                                               Text="{TemplateBinding Tag}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="{StaticResource PgTopFontBtn}"
                                               Foreground="{DynamicResource PgText2Brush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="Label"
                                           Text="{TemplateBinding Content}"
                                           FontSize="{StaticResource PgFontBody}"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource PgText2Brush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock x:Name="Chevron"
                                       Text="&#xE76C;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource PgTopFont}"
                                       Foreground="{DynamicResource PgText3Brush}"
                                       Opacity="0.6"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="ChevronRotate" Angle="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PgSurface3Brush}"/>
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource PgText1Brush}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource PgText1Brush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PgSurface3Brush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource PgAccentBrush}"/>
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource PgAccentSoftBrush}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource PgText1Brush}"/>
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource PgAccentBrush}"/>
                            <Setter TargetName="Chevron" Property="Opacity" Value="1"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ChevronRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="90" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ChevronRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="90" To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sub-menu container: 1px left hairline + 6px pad, 24px indent. -->
    <Style x:Key="PgSidebarSubListStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource PgHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
        <Setter Property="Padding" Value="6,2,2,2"/>
        <Setter Property="Margin" Value="24,0,14,6"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- SUB-ITEM — 5px dot + label, 34px. Active = soft-accent pill +
         accent dot + 3px inset bar. Mechanism preserved. -->
    <Style x:Key="PgSidebarSubItemStyle" TargetType="Button">
        <Setter Property="behaviors:BounceHover.IsEnabled"  Value="True"/>
        <Setter Property="behaviors:BounceHover.HoverScale" Value="1.02"/>
        <Setter Property="behaviors:BounceHover.PressScale" Value="0.98"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="2,2,2,2"/>
        <Setter Property="Height" Value="{StaticResource PgSidebarSubItemHeight}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="Transparent"
                            CornerRadius="8"
                            Padding="10,0"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Accent"
                                    Width="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Margin="0,7"
                                    CornerRadius="1.5"
                                    Background="{DynamicResource PgAccentBrush}"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="Dot"
                                        Width="5" Height="5"
                                        CornerRadius="2.5"
                                        Background="{DynamicResource PgText3Brush}"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        SnapsToDevicePixels="True"/>
                                <TextBlock x:Name="Label"
                                           Text="{TemplateBinding Content}"
                                           FontSize="{StaticResource PgFontCardSub}"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource PgText2Brush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PgSurface3Brush}"/>
                            <Setter TargetName="Dot" Property="Background" Value="{DynamicResource PgAccentBrush}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource PgText1Brush}"/>
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PgHairlineBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PgSurface3Brush}"/>
                        </Trigger>
                        <!-- Active module (mechanism preserved) -->
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource StringEqualsMultiConverter}">
                                    <Binding Path="CommandParameter" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="DataContext.CurrentModuleKey" RelativeSource="{RelativeSource TemplatedParent}"/>
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PgAccentSoftBrush}"/>
                            <Setter TargetName="Dot" Property="Background" Value="{DynamicResource PgAccentBrush}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource PgAccentBrush}"/>
                            <Setter TargetName="Label" Property="FontWeight" Value="Bold"/>
                            <Setter TargetName="Accent" Property="Opacity" Value="1"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Storage footer card. -->
    <Style x:Key="PgStorageCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PgSurface2Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PgHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Margin" Value="10,10,10,10"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         3 · MODULE BAR (DashboardView command bar)
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="PgModBarStyle" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource PgTopBarHeight}"/>
        <Setter Property="Background" Value="{DynamicResource PgSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PgHairlineBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Segmented module picker: sf2 track, 2px pad. -->
    <Style x:Key="PgSegGroupStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PgSurface2Brush}"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- One segment. Tag carries the MDL2 glyph. Selection is driven by
         the page (IsChecked on a ToggleButton). -->
    <Style x:Key="PgSegItemStyle" TargetType="ToggleButton">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PgText2Brush}"/>
        <Setter Property="FontSize" Value="{StaticResource PgFontCardSub}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="Glyph"
                                       Text="{TemplateBinding Tag}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource PgFontGlyphSm}"
                                       Margin="0,0,7,0"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PgSurface3Brush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PgText1Brush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PgSurfaceBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PgText1Brush}"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource PgAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Refreshed stamp chip (module bar). -->
    <Style x:Key="PgRefreshChipStyle" TargetType="Border" BasedOn="{StaticResource PgChipStyle}">
        <Setter Property="Height" Value="{StaticResource PgTopCtrlHeight}"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>

    <!-- User chip (module bar): initials disc + display name. -->
    <Style x:Key="PgUserChipStyle" TargetType="Border" BasedOn="{StaticResource PgChipStyle}">
        <Setter Property="Height" Value="{StaticResource PgTopCtrlHeight}"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>

</ResourceDictionary>
