root = true

[*.{cs,csx,vb,vbx}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
tab_width = 4

# ── .NET code style ──────────────────────────────────────────────────
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# ── C# style ─────────────────────────────────────────────────────────
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

csharp_style_expression_bodied_methods = false:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_operators = false:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_indexers = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion

csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_inlined_variable_declaration = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:suggestion

csharp_prefer_braces = true:silent
csharp_style_namespace_declarations = file_scoped:suggestion

# ── Formatting ───────────────────────────────────────────────────────
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_call_paren_list = false

# ── Analyzer severities ──────────────────────────────────────────────
# Analyzer rules (CA####, IDE####, …) are informational by default so
# they can NEVER break the build. TreatWarningsAsErrors still applies to
# real COMPILER warnings (CS####).
# Fix: "category-CodeQuality" previously looked like it covered all CA
# rules, but it only maps to 4 IDE rules (IDE0051/52/64/76) — every other
# CA rule fell through to its default severity and, combined with
# AnalysisMode=AllEnabledByDefault + TreatWarningsAsErrors, surfaced as
# 1336 build errors. The global default below fixes that for good.
dotnet_analyzer_diagnostic.severity = suggestion

# Style rules (IDE####) are cosmetic — stay silent.
dotnet_analyzer_diagnostic.category-Style.severity = silent

# Security analyzer rules (CA53xx/CA21xx/…) are advisory for now, so a
# heuristic hit (e.g. interpolated PRAGMA/DDL SQL or demo-mode Random) can
# never block a release build. The application's real security is enforced
# by its explicit guard layer (OperationGuard, ProcessStartGuard,
# SecretVault, AttachmentValidationService, PBKDF2, …), not by these
# analyzers. Re-promote to 'warning' once a dedicated security-rule pass
# has cleared every remaining hit.

# CA2007: Consider calling ConfigureAwait on the awaited task
dotnet_diagnostic.CA2007.severity = suggestion

# CA1063: Implement IDisposable correctly
# (re-promote to 'warning' after a dedicated cleanup pass)
dotnet_diagnostic.CA1063.severity = suggestion

# CA2000: Dispose objects before losing scope
# (re-promote to 'warning' after a dedicated cleanup pass)
dotnet_diagnostic.CA2000.severity = suggestion

# CA1031: Do not catch general exception types (allow but log)
dotnet_diagnostic.CA1031.severity = silent

# VSTHRD100: Avoid async void methods
dotnet_diagnostic.VSTHRD100.severity = suggestion

# IDE0044: Add readonly modifier
dotnet_diagnostic.IDE0044.severity = suggestion

# ── WPF/XAML ─────────────────────────────────────────────────────────
[*.{xaml,axaml}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
