<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:liquid="clr-namespace:ProGlassAutomation.ThemeLiquidGlass">
 <Style x:Key="KeyboardFocus" TargetType="Control">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
   <Border Margin="{DynamicResource MarginFocus}" BorderBrush="{DynamicResource FocusIndicator}" BorderThickness="{DynamicResource FocusThickness}" CornerRadius="{DynamicResource ControlCornerRadius}" />
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="ThemedWindow" TargetType="Window">
  <Setter Property="Background" Value="{DynamicResource LiquidCanvasBrush}" />
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  <Setter Property="FontWeight" Value="{DynamicResource FontWeightBody}" />
  <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBody}" />
  <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
  <Setter Property="FontStyle" Value="{DynamicResource FontStyleBody}" />
  <Setter Property="UseLayoutRounding" Value="True" />
  <Setter Property="SnapsToDevicePixels" Value="True" />
 </Style>
 <Style TargetType="TextBlock">
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  <Setter Property="FontWeight" Value="{DynamicResource FontWeightBody}" />
  <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBody}" />
  <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
  <Setter Property="FontStyle" Value="{DynamicResource FontStyleBody}" />
  <Setter Property="TextDecorations" Value="{DynamicResource TextDecorationsBody}" />
  <Setter Property="TextWrapping" Value="Wrap" />
 </Style>
 <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
  <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
  <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
 </Style>
 <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
  <Setter Property="FontSize" Value="{DynamicResource FontSizeSection}" />
  <Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
  <Setter Property="FontStyle" Value="Normal" />
  <Setter Property="TextDecorations" Value="{x:Null}" />
  <Setter Property="Margin" Value="{DynamicResource MarginItem}" />
 </Style>
 <Style x:Key="PageHeading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
  <Setter Property="FontSize" Value="{DynamicResource FontSizeDisplay}" />
 </Style>
 <Style TargetType="liquid:LiquidGlassSurface">
  <Setter Property="Focusable" Value="False" />
  <Setter Property="SnapsToDevicePixels" Value="True" />
  <Setter Property="ClipToBounds" Value="False" />
  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  <Setter Property="VerticalContentAlignment" Value="Stretch" />
  <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
  <Setter Property="FaceBrush" Value="{DynamicResource LiquidCardFaceBrush}" />
  <Setter Property="SpecularBrush" Value="{DynamicResource LiquidSpecularBrush}" />
  <Setter Property="RimBrush" Value="{DynamicResource LiquidRimBrush}" />
  <Setter Property="StrokeBrush" Value="{DynamicResource LiquidStrokeBrush}" />
  <Setter Property="ReduceTransparency" Value="{DynamicResource LiquidReduceTransparency}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="liquid:LiquidGlassSurface">
   <Grid ClipToBounds="False">
    <Border x:Name="Caster" Visibility="Collapsed" Background="{DynamicResource LiquidShadowCasterBrush}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False">
     <Border.Effect>
      <DropShadowEffect Color="{DynamicResource LiquidShadowColor}" BlurRadius="{DynamicResource LiquidLiftBlur}" ShadowDepth="{DynamicResource LiquidLiftDepth}" Direction="270" Opacity="{DynamicResource LiquidLiftOpacity}" RenderingBias="Quality" />
     </Border.Effect>
    </Border>
    <Border x:Name="Face" Background="{TemplateBinding FaceBrush}" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
     <Grid>
      <Border x:Name="Lens" Background="{DynamicResource LiquidLensBrush}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
      <Border x:Name="Sheen" Height="{DynamicResource LiquidSheenHeight}" VerticalAlignment="Top" Background="{DynamicResource LiquidSpecularSheenBrush}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
      <Border x:Name="Inset" BorderBrush="{DynamicResource LiquidSpecularBrush}" BorderThickness="{DynamicResource LiquidSpecularThickness}" CornerRadius="{TemplateBinding CornerRadius}" Background="{DynamicResource TransparentBrush}" IsHitTestVisible="False" />
      <Border x:Name="Rim" BorderBrush="{TemplateBinding RimBrush}" BorderThickness="{DynamicResource LiquidRimThickness}" CornerRadius="{TemplateBinding CornerRadius}" Background="{DynamicResource TransparentBrush}">
       <Border x:Name="Stroke" BorderBrush="{TemplateBinding StrokeBrush}" BorderThickness="{DynamicResource BorderThicknessControl}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
       </Border>
      </Border>
     </Grid>
    </Border>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="ShowFace" Value="False">
     <Setter TargetName="Face" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" />
     <Setter TargetName="Lens" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="Inset" Property="Visibility" Value="Collapsed" />
    </Trigger>
    <Trigger Property="ReduceTransparency" Value="True">
     <Setter TargetName="Face" Property="Background" Value="{DynamicResource LiquidOpaqueBrush}" />
     <Setter TargetName="Lens" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="Sheen" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="Inset" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="Caster" Property="Visibility" Value="Collapsed" />
    </Trigger>
    <Trigger Property="Concave" Value="True">
     <Setter TargetName="Sheen" Property="VerticalAlignment" Value="Bottom" />
     <Setter TargetName="Inset" Property="BorderThickness" Value="0,0,2,2" />
     <Setter TargetName="Caster" Property="Visibility" Value="Collapsed" />
    </Trigger>
    <Trigger Property="Rank" Value="Control">
     <Setter Property="FaceBrush" Value="{DynamicResource LiquidControlFaceBrush}" />
     <Setter TargetName="Caster" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="Sheen" Property="Height" Value="{DynamicResource SpacingLarge}" />
    </Trigger>
    <Trigger Property="Rank" Value="Chip">
     <Setter Property="FaceBrush" Value="{DynamicResource LiquidChipFaceBrush}" />
     <Setter TargetName="Caster" Property="Visibility" Value="Collapsed" />
     <Setter TargetName="Sheen" Property="Visibility" Value="Collapsed" />
    </Trigger>
    <Trigger Property="Lifted" Value="True">
     <Setter TargetName="Caster" Property="Visibility" Value="Visible" />
    </Trigger>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter TargetName="Sheen" Property="Background" Value="{DynamicResource LiquidSpecularHoverBrush}" />
     <Setter TargetName="Stroke" Property="BorderBrush" Value="{DynamicResource LiquidSpecularHoverBrush}" />
    </Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Card" TargetType="ContentControl">
  <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
  <Setter Property="Padding" Value="{DynamicResource PaddingCard}" />
  <Setter Property="HorizontalAlignment" Value="Stretch" />
  <Setter Property="VerticalAlignment" Value="Stretch" />
  <Setter Property="Focusable" Value="False" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <liquid:LiquidGlassSurface Background="{DynamicResource TransparentBrush}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource CardCornerRadius}" Rank="Card">
    <ContentPresenter />
   </liquid:LiquidGlassSurface>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="BentoTile" TargetType="ContentControl" BasedOn="{StaticResource Card}">
  <Setter Property="Margin" Value="0" />
 </Style>
 <Style x:Key="Plate" TargetType="ContentControl" BasedOn="{StaticResource Card}">
  <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
  <Setter Property="Padding" Value="{DynamicResource PaddingPlate}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <liquid:LiquidGlassSurface Rank="Control" Background="{DynamicResource TransparentBrush}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ControlCornerRadius}">
    <ContentPresenter />
   </liquid:LiquidGlassSurface>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="AccentPlate" TargetType="ContentControl" BasedOn="{StaticResource Plate}">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <liquid:LiquidGlassSurface Rank="Control" Background="{DynamicResource TransparentBrush}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ControlCornerRadius}" FaceBrush="{DynamicResource LiquidTintAccent}" StrokeBrush="{DynamicResource LiquidStrokeAccent}">
    <ContentPresenter />
   </liquid:LiquidGlassSurface>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="ElevatedPlate" TargetType="ContentControl" BasedOn="{StaticResource Plate}">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <liquid:LiquidGlassSurface Rank="Control" Lifted="True" Background="{DynamicResource TransparentBrush}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ControlCornerRadius}">
    <ContentPresenter />
   </liquid:LiquidGlassSurface>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="TokenValue" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
  <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
 </Style>
 <Style TargetType="Separator">
  <Setter Property="Margin" Value="{DynamicResource MarginItem}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
   <Border Height="1" Background="{DynamicResource LiquidStrokeBrush}" />
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ProgressBar">
  <Setter Property="Height" Value="{DynamicResource SpacingMedium}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
   <liquid:LiquidGlassSurface Rank="Chip" Concave="True" ShowFace="False" Background="{DynamicResource LiquidWellBrush}" CornerRadius="{DynamicResource ChipCornerRadius}">
    <Border x:Name="PART_Track">
     <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{DynamicResource AccentPrimary}" CornerRadius="{DynamicResource ChipCornerRadius}" BorderBrush="{DynamicResource LiquidSpecularBrush}" BorderThickness="1,1,0,0" />
    </Border>
   </liquid:LiquidGlassSurface>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
