<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="HeroCard" TargetType="ContentControl">
  <Setter Property="Background" Value="{DynamicResource HeroBackground}" />
  <Setter Property="Padding" Value="{DynamicResource PaddingCard}" />
  <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="VerticalAlignment" Value="Stretch" />
  <Setter Property="Focusable" Value="False" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <Grid>
    <Border Background="{DynamicResource HoloCardFillBrush}" CornerRadius="{DynamicResource CardCornerRadius}" />
    <Border Background="{DynamicResource HoloFaceBrush}" CornerRadius="{DynamicResource CardCornerRadius}" IsHitTestVisible="False" />
    <Border Background="{DynamicResource HoloSheenTopBrush}" CornerRadius="{DynamicResource CardCornerRadius}" IsHitTestVisible="False" />
    <Border Background="{DynamicResource HoloSheenBottomBrush}" CornerRadius="{DynamicResource CardCornerRadius}" IsHitTestVisible="False" />
    <Border Background="{DynamicResource HoloSheenLeftBrush}" CornerRadius="{DynamicResource CardCornerRadius}" IsHitTestVisible="False" />
    <Border Background="{DynamicResource HoloSheenRightBrush}" CornerRadius="{DynamicResource CardCornerRadius}" IsHitTestVisible="False" />
    <Border BorderBrush="{DynamicResource HoloRimBrush}" BorderThickness="{DynamicResource HoloHeroRimThickness}" CornerRadius="{DynamicResource CardCornerRadius}" Padding="{TemplateBinding Padding}">
     <ContentPresenter />
    </Border>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="MetricCard" TargetType="ContentControl">
  <Setter Property="Background" Value="{DynamicResource SurfaceElevated}" />
  <Setter Property="Padding" Value="{DynamicResource PaddingPlate}" />
  <Setter Property="Focusable" Value="False" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <Grid>
    <Border Background="{DynamicResource HoloPlateFillBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" />
    <Border BorderBrush="{DynamicResource HoloQuietRimBrush}" BorderThickness="{DynamicResource BorderThicknessControl}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{TemplateBinding Padding}">
     <ContentPresenter />
    </Border>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="StatusBadge" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource SurfaceSecondary}" /><Setter Property="CornerRadius" Value="{DynamicResource ChipCornerRadius}" /><Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
  <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" /><Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessControl}" />
  <Style.Triggers>
   <Trigger Property="Tag" Value="Success"><Setter Property="Background" Value="{DynamicResource StatusSuccessSurface}" /></Trigger>
   <Trigger Property="Tag" Value="Warning"><Setter Property="Background" Value="{DynamicResource StatusWarningSurface}" /></Trigger>
   <Trigger Property="Tag" Value="Information"><Setter Property="Background" Value="{DynamicResource StatusInformationSurface}" /></Trigger>
   <Trigger Property="Tag" Value="Error"><Setter Property="Background" Value="{DynamicResource StatusErrorSurface}" /></Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="StatusText" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" /><Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" /><Setter Property="TextWrapping" Value="Wrap" />
  <Style.Triggers>
   <Trigger Property="Tag" Value="Success"><Setter Property="Foreground" Value="{DynamicResource StatusSuccess}" /></Trigger>
   <Trigger Property="Tag" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource StatusWarning}" /></Trigger>
   <Trigger Property="Tag" Value="Information"><Setter Property="Foreground" Value="{DynamicResource StatusInformation}" /></Trigger>
   <Trigger Property="Tag" Value="Error"><Setter Property="Foreground" Value="{DynamicResource StatusError}" /></Trigger>
  </Style.Triggers>
 </Style>
 <Style TargetType="TabControl">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
    <Border Background="{DynamicResource SurfaceSecondary}" Padding="{DynamicResource PaddingCompact}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="{DynamicResource BorderThicknessControl}"><TabPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Once" /></Border>
    <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" />
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="TabItem">
  <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" /><Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
   <Border x:Name="Frame" Background="{DynamicResource TransparentBrush}" BorderBrush="{DynamicResource TransparentBrush}" BorderThickness="{DynamicResource BorderThicknessControl}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{DynamicResource PaddingControl}"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True" /></Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource StateHover}" /></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource AccentSoft}" /><Setter Property="Foreground" Value="{DynamicResource HeroAccent}" /><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource HoloQuietRimBrush}" /></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource FocusIndicator}" /></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledText}" /><Setter TargetName="Frame" Property="Background" Value="{DynamicResource DisabledSurface}" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
