<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fluent="clr-namespace:ProGlassAutomation.ThemeFluent">
 <Style x:Key="KeyboardFocus" TargetType="Control">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
   <Border Margin="{DynamicResource MarginFocus}" BorderBrush="{DynamicResource FocusIndicator}" BorderThickness="{DynamicResource FocusThickness}" CornerRadius="{DynamicResource ControlCornerRadius}" />
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="ThemedWindow" TargetType="Window">
  <Setter Property="Background" Value="{DynamicResource ApplicationBackground}" />
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  <Setter Property="FontWeight" Value="{DynamicResource FontWeightBody}" />
  <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBody}" />
  <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
  <Setter Property="FontStyle" Value="{DynamicResource FontStyleBody}" />
  <Setter Property="UseLayoutRounding" Value="True" />
  <Setter Property="SnapsToDevicePixels" Value="True" />
 </Style>
 <Style TargetType="TextBlock">
  <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  <Setter Property="FontWeight" Value="{DynamicResource FontWeightBody}" />
  <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBody}" />
  <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
  <Setter Property="FontStyle" Value="{DynamicResource FontStyleBody}" />
  <Setter Property="TextDecorations" Value="{DynamicResource TextDecorationsBody}" />
  <Setter Property="TextWrapping" Value="Wrap" />
 </Style>
 <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
  <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
  <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
 </Style>
 <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
  <Setter Property="FontSize" Value="{DynamicResource FontSizeSection}" />
  <Setter Property="FontWeight" Value="{DynamicResource FontWeightHeading}" />
  <Setter Property="FontStyle" Value="Normal" />
  <Setter Property="TextDecorations" Value="{x:Null}" />
  <Setter Property="Margin" Value="{DynamicResource MarginItem}" />
 </Style>
 <Style x:Key="PageHeading" TargetType="TextBlock" BasedOn="{StaticResource SectionHeading}">
  <Setter Property="FontSize" Value="{DynamicResource FontSizeDisplay}" />
 </Style>
 <Style TargetType="fluent:FluentSurface">
  <Setter Property="Focusable" Value="False" />
  <Setter Property="SnapsToDevicePixels" Value="True" />
  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  <Setter Property="VerticalContentAlignment" Value="Stretch" />
  <Setter Property="TintBrush" Value="{DynamicResource FluentTintBrush}" />
  <Setter Property="StrokeBrush" Value="{DynamicResource FluentStrokeBrush}" />
  <Setter Property="LuminosityBrush" Value="{DynamicResource FluentLuminosityBrush}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="fluent:FluentSurface">
   <Grid>
    <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
     <Border x:Name="Tint" Background="{TemplateBinding TintBrush}" CornerRadius="{TemplateBinding CornerRadius}">
      <Border x:Name="Luminosity" BorderBrush="{TemplateBinding LuminosityBrush}" BorderThickness="1,1,0,0" CornerRadius="{TemplateBinding CornerRadius}">
       <Border x:Name="Stroke" BorderBrush="{TemplateBinding StrokeBrush}" BorderThickness="{DynamicResource BorderThicknessControl}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
       </Border>
      </Border>
     </Border>
    </Border>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="ShowTint" Value="False">
     <Setter TargetName="Tint" Property="Background" Value="{DynamicResource TransparentBrush}" />
    </Trigger>
    <Trigger Property="Concave" Value="True">
     <Setter TargetName="Luminosity" Property="BorderThickness" Value="0,0,1,1" />
    </Trigger>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter TargetName="Luminosity" Property="BorderBrush" Value="{DynamicResource FluentRevealBrush}" />
     <Setter TargetName="Stroke" Property="BorderBrush" Value="{DynamicResource FluentRevealStroke}" />
    </Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Card" TargetType="ContentControl">
  <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
  <Setter Property="Padding" Value="{DynamicResource PaddingCard}" />
  <Setter Property="HorizontalAlignment" Value="Stretch" />
  <Setter Property="VerticalAlignment" Value="Stretch" />
  <Setter Property="Focusable" Value="False" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <fluent:FluentSurface ShowTint="False" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource CardCornerRadius}" TintBrush="{DynamicResource FluentTintBrush}" StrokeBrush="{DynamicResource FluentStrokeBrush}" LuminosityBrush="{DynamicResource FluentLuminosityBrush}">
    <ContentPresenter />
   </fluent:FluentSurface>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="BentoTile" TargetType="ContentControl" BasedOn="{StaticResource Card}">
  <Setter Property="Margin" Value="0" />
 </Style>
 <Style x:Key="Plate" TargetType="ContentControl" BasedOn="{StaticResource Card}">
  <Setter Property="Background" Value="{DynamicResource SurfaceSecondary}" />
  <Setter Property="Padding" Value="{DynamicResource PaddingPlate}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <fluent:FluentSurface Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ControlCornerRadius}" TintBrush="{DynamicResource FluentTintBrush}" StrokeBrush="{DynamicResource FluentStrokeBrush}" LuminosityBrush="{DynamicResource FluentLuminosityBrush}">
    <ContentPresenter />
   </fluent:FluentSurface>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="AccentPlate" TargetType="ContentControl" BasedOn="{StaticResource Plate}">
  <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <fluent:FluentSurface Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ControlCornerRadius}" TintBrush="{DynamicResource FluentTintAccent}" StrokeBrush="{DynamicResource FluentStrokeAccent}" LuminosityBrush="{DynamicResource FluentLuminosityBrush}">
    <ContentPresenter />
   </fluent:FluentSurface>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="ElevatedPlate" TargetType="ContentControl" BasedOn="{StaticResource Plate}">
  <Setter Property="Background" Value="{DynamicResource SurfaceElevated}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <fluent:FluentSurface ShowTint="False" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource ControlCornerRadius}" TintBrush="{DynamicResource FluentTintBrush}" StrokeBrush="{DynamicResource FluentStrokeBrush}" LuminosityBrush="{DynamicResource FluentLuminosityBrush}">
    <ContentPresenter />
   </fluent:FluentSurface>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="TokenValue" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
  <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}" />
 </Style>
 <Style TargetType="Separator">
  <Setter Property="Margin" Value="{DynamicResource MarginItem}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
   <Border Height="1" Background="{DynamicResource FluentStrokeBrush}" />
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ProgressBar">
  <Setter Property="Height" Value="{DynamicResource SpacingMedium}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
   <Border Background="{DynamicResource SurfaceSecondary}" CornerRadius="{DynamicResource ChipCornerRadius}" BorderBrush="{DynamicResource FluentStrokeBrush}" BorderThickness="{DynamicResource BorderThicknessControl}">
    <Border x:Name="PART_Track">
     <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{DynamicResource AccentPrimary}" CornerRadius="{DynamicResource ChipCornerRadius}" BorderBrush="{DynamicResource FluentLuminosityBrush}" BorderThickness="1,1,0,0" />
    </Border>
   </Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
