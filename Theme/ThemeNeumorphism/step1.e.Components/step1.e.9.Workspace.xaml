<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:neu="clr-namespace:ProGlassAutomation.ThemeNeumorphism">
 <Style x:Key="HeroCard" TargetType="ContentControl">
  <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
  <Setter Property="Padding" Value="{DynamicResource PaddingCard}" />
  <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="VerticalAlignment" Value="Stretch" />
  <Setter Property="Focusable" Value="False" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <neu:NeumorphSurface Rank="Card" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource CardCornerRadius}">
    <ContentPresenter />
   </neu:NeumorphSurface>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="MetricCard" TargetType="ContentControl">
  <Setter Property="Background" Value="{DynamicResource SurfacePrimary}" />
  <Setter Property="Padding" Value="{DynamicResource PaddingPlate}" />
  <Setter Property="Focusable" Value="False" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <neu:NeumorphSurface Rank="Card" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource CardCornerRadius}">
    <ContentPresenter />
   </neu:NeumorphSurface>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="StatusBadge" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource NeumorphSheenBrush}" />
  <Setter Property="CornerRadius" Value="20" />
  <Setter Property="Padding" Value="{DynamicResource PaddingCompact}" />
  <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
  <Setter Property="BorderThickness" Value="0" />
  <Setter Property="SnapsToDevicePixels" Value="True" />
  <Setter Property="neu:NeumorphBadgeGlow.LightGlow" Value="True" />
  <Setter Property="Effect">
   <Setter.Value>
    <DropShadowEffect Color="{DynamicResource NeumorphDarkColor}" BlurRadius="12" ShadowDepth="6" Direction="305" Opacity="{DynamicResource NeumorphDarkOpacity}" RenderingBias="Quality" />
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="StatusText" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" /><Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" /><Setter Property="TextWrapping" Value="Wrap" />
  <Style.Triggers>
   <Trigger Property="Tag" Value="Success"><Setter Property="Foreground" Value="{DynamicResource StatusSuccess}" /></Trigger>
   <Trigger Property="Tag" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource StatusWarning}" /></Trigger>
   <Trigger Property="Tag" Value="Information"><Setter Property="Foreground" Value="{DynamicResource StatusInformation}" /></Trigger>
   <Trigger Property="Tag" Value="Error"><Setter Property="Foreground" Value="{DynamicResource StatusError}" /></Trigger>
  </Style.Triggers>
 </Style>
 <Style TargetType="TabControl">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
    <neu:NeumorphSurface Concave="True" Rank="Control" Background="{DynamicResource SurfacePrimary}" Padding="{DynamicResource PaddingCompact}" CornerRadius="{DynamicResource ControlCornerRadius}">
     <TabPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Once" />
    </neu:NeumorphSurface>
    <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" />
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="TabItem">
  <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" /><Setter Property="FocusVisualStyle" Value="{DynamicResource KeyboardFocus}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
   <neu:NeumorphSurface x:Name="Pod" Concave="True" Rank="Chip" Background="{DynamicResource TransparentBrush}" Padding="{DynamicResource PaddingControl}" CornerRadius="{DynamicResource ChipCornerRadius}">
    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
   </neu:NeumorphSurface>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pod" Property="Lifted" Value="True" /></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Pod" Property="Background" Value="{DynamicResource SurfacePrimary}" /><Setter TargetName="Pod" Property="Concave" Value="False" /><Setter TargetName="Pod" Property="Lifted" Value="False" /><Setter TargetName="Pod" Property="Rank" Value="Control" /><Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" /></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledText}" /><Setter TargetName="Pod" Property="Background" Value="{DynamicResource DisabledSurface}" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
