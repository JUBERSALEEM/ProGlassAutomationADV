<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <SolidColorBrush x:Key="NeumorphLightBrush" Color="#FBFCFD" />
  <SolidColorBrush x:Key="NeumorphDarkBrush" Color="#BDC1C4" />
  <SolidColorBrush x:Key="NeumorphRimLightBrush" Color="#F5F7FA" />
  <SolidColorBrush x:Key="NeumorphRimShadeBrush" Color="#D0D5DB" />
