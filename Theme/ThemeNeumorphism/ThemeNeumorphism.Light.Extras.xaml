    <GradientStop Color="#E6EBEF" Offset="0.5" />
    <GradientStop Color="#CED4DC" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="NeumorphWellSheenBrush" StartPoint="0.21,0.09" EndPoint="0.79,0.91">
    <GradientStop Color="#CED4DC" Offset="0" />
    <GradientStop Color="#E6EBEF" Offset="0.5" />
    <GradientStop Color="#F5F7FA" Offset="1" />
  </LinearGradientBrush>
  <Thickness x:Key="NeumorphRimLightThickness">0</Thickness>
  <Thickness x:Key="NeumorphRimShadeThickness">0</Thickness>
  <Thickness x:Key="NeumorphInsetLightThickness">0</Thickness>
  <Thickness x:Key="NeumorphInsetShadeThickness">0</Thickness>
