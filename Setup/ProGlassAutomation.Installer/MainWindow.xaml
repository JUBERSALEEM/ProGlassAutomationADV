<Window x:Class="ProGlassAutomation.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProGlass Automation Setup"
        Height="450" Width="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource GlassBorderBrush}"
            BorderThickness="1.5"
            Background="{DynamicResource AmbientBrush}"
            CornerRadius="16"
            ClipToBounds="True"
            Effect="{DynamicResource CardShadowEffect}">

        <Grid>
            <!-- Ambient Glow Blobs -->
            <Border Background="{DynamicResource AmbientBlob1Brush}" CornerRadius="16" IsHitTestVisible="False"/>
            <Border Background="{DynamicResource AmbientBlob2Brush}" CornerRadius="16" IsHitTestVisible="False"/>

            <!-- Main Structure Grid -->
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title / Window Controls -->
                    <RowDefinition Height="*"/>    <!-- Inner Content Area -->
                    <RowDefinition Height="Auto"/> <!-- Button Actions -->
                </Grid.RowDefinitions>

                <!-- 1) Top Title Area & Drag Handler -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Logo Icon Shape -->
                        <Grid Width="28" Height="28" VerticalAlignment="Center">
                            <Border CornerRadius="6" Background="{DynamicResource AccentBrush}"/>
                            <Path Stroke="White" StrokeThickness="1.5" Fill="#33FFFFFF"
                                  Data="M 14,5 L 21,14 L 14,23 L 7,14 Z" StrokeLineJoin="Round"/>
                        </Grid>
                        <TextBlock Text="ProGlass Automation Setup"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   FontWeight="Bold" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Custom Elegant Exit Button -->
                    <Button Grid.Column="2" Style="{DynamicResource SecondaryButtonStyle}"
                            Content="&#10005;" Width="32" Height="28" Padding="0" FontSize="11"
                            Click="ExitButton_Click" ToolTip="Close installer"/>
                </Grid>

                <!-- 2) Center Multi-stage View -->
                <Grid Grid.Row="1" Margin="0,20,0,16">

                    <!-- Stage 0: Welcome Screen -->
                    <Grid x:Name="StageWelcome" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="10,20,0,0" HorizontalAlignment="Center">
                            <TextBlock Text="ProGlass Automation"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="Bold" FontSize="28" HorizontalAlignment="Center"
                                       Effect="{DynamicResource TextGlowEffect}"/>
                            <TextBlock Text="Glass Industry ERP Solution"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       FontWeight="SemiBold" FontSize="18" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Text="Version 1.0.0"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       FontSize="13" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <Border Grid.Row="1" Background="#0C1524" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                CornerRadius="8" Padding="14" Margin="10,20,10,0">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12.5" LineHeight="18" TextAlignment="Center">
                                This setup wizard will install ProGlass Automation onto your workstation.
                                <LineBreak/>
                                ProGlass Automation is a high-performance, robust, and highly secure glass manufacturing ERP system featuring:
                                <LineBreak/><LineBreak/>
                                ✓ Embedded offline neural Speech-to-Text via local Whisper models
                                <LineBreak/>
                                ✓ Real-time stock, inventory sheet store, and optimization matrices
                                <LineBreak/>
                                ✓ Compliant, unified multi-currency UAE FTA tax invoices
                                <LineBreak/><LineBreak/>
                                Click "Install" to configure and initiate installation.
                            </TextBlock>
                        </Border>
                    </Grid>

                    <!-- Stage 1: Installation Location -->
                    <Grid x:Name="StageLocation" Visibility="Collapsed" Opacity="0">
                        <StackPanel Margin="10,10,10,0" VerticalAlignment="Center">
                            <TextBlock Text="Installation Location"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="Bold" FontSize="20"/>
                            <TextBlock Text="Specify the path where ProGlass Automation will be installed."
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12.5" Margin="0,4,0,24"/>

                            <TextBlock Text="Destination Folder:" Foreground="{DynamicResource PrimaryForegroundBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtPath" Grid.Column="0" Style="{DynamicResource ModernTextBoxStyle}"/>
                                <Button Grid.Column="1" Style="{DynamicResource SecondaryButtonStyle}" Content="Browse..." Margin="8,0,0,0" Click="Browse_Click"/>
                            </Grid>

                            <!-- Disk Space Validation Cards -->
                            <Border Background="#0C1524" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Space Required:" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        <TextBlock Text="180.0 MB" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Space Available:" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        <TextBlock x:Name="TxtDiskAvailable" Text="Validating..." FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Stage 2: Installation Options -->
                    <Grid x:Name="StageOptions" Visibility="Collapsed" Opacity="0">
                        <StackPanel Margin="10,10,10,0" VerticalAlignment="Center">
                            <TextBlock Text="Installation Options"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="Bold" FontSize="20"/>
                            <TextBlock Text="Select the supplementary features and shortcuts you wish to create."
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12.5" Margin="0,4,0,24"/>

                            <StackPanel Margin="10,0,0,0">
                                <CheckBox x:Name="ChkDesktop" Style="{DynamicResource ModernCheckBoxStyle}" IsChecked="True" Content="Create Desktop Shortcut" Margin="0,0,0,14"/>
                                <CheckBox x:Name="ChkStartMenu" Style="{DynamicResource ModernCheckBoxStyle}" IsChecked="True" Content="Create Start Menu Shortcut" Margin="0,0,0,14"/>
                                <CheckBox x:Name="ChkAppData" Style="{DynamicResource ModernCheckBoxStyle}" IsChecked="True" Content="Install Core Application Database Configurations" Margin="0,0,0,14"/>
                                <CheckBox x:Name="ChkTemplates" Style="{DynamicResource ModernCheckBoxStyle}" IsChecked="True" Content="Install Sample Layout and Output Invoicing Templates" Margin="0,0,0,14"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Stage 3: Installation Progress -->
                    <Grid x:Name="StageProgress" Visibility="Collapsed" Opacity="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="10,10,10,16">
                            <TextBlock x:Name="TxtProgressStatus" Text="Extracting software binaries..."
                                       Foreground="{DynamicResource PrimaryForegroundBrush}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Left"/>
                            <ProgressBar x:Name="InstallProgressBar" Style="{DynamicResource ModernProgressBarStyle}" Value="0" Maximum="100" Margin="0,10,0,6"/>
                            <TextBlock x:Name="TxtProgressPercent" Text="0% Completed" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                        </StackPanel>

                        <!-- Operation Logs Console -->
                        <Border Grid.Row="1" Background="#0C1524" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="8" Margin="10,0,10,0">
                            <ListBox x:Name="LstLogs" Background="Transparent" BorderThickness="0" Padding="8"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="11" FontFamily="Consolas"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>

                    <!-- Stage 4: Completion & Finish -->
                    <Grid x:Name="StageSuccess" Visibility="Collapsed" Opacity="0">
                        <StackPanel VerticalAlignment="Center" Margin="20,0" HorizontalAlignment="Center">
                            <!-- Visual Animated Tick -->
                            <Ellipse Width="64" Height="56" Fill="#1E2B44" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2.5" HorizontalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#34D399" BlurRadius="12" Opacity="0.4"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="ProGlass Installed Successfully"
                                       Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" FontSize="22" Margin="0,16,0,6" HorizontalAlignment="Center"/>
                            <TextBlock Text="ProGlass Automation has been successfully configured on your workstation."
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center"/>

                            <CheckBox x:Name="ChkLaunch" Style="{DynamicResource ModernCheckBoxStyle}" IsChecked="True" Content="Launch ProGlass Automation Immediately" Margin="0,28,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                </Grid>

                <!-- 3) Stage Action Controls (Previous / Next / Cancel / Install) -->
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Previous Stage -->
                    <Button x:Name="BtnPrev" Grid.Column="0" Style="{DynamicResource SecondaryButtonStyle}"
                            Content="Back" Visibility="Collapsed" Click="BtnPrev_Click"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <!-- Exit/Cancel -->
                        <Button x:Name="BtnCancel" Style="{DynamicResource SecondaryButtonStyle}"
                                Content="Cancel" Margin="0,0,12,0" Click="BtnCancel_Click"/>
                        <!-- Next/Action -->
                        <Button x:Name="BtnNext" Style="{DynamicResource ModernButtonStyle}"
                                Content="Next" Width="100" Click="BtnNext_Click"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
