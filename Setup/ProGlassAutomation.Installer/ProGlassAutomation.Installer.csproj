<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>
    <AssemblyName>ProGlassAutomation-Setup</AssemblyName>
    <RootNamespace>ProGlassAutomation.Installer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="app_icon.ico" />
    <Resource Include="app_icon.ico" />
    <None Remove="payload.zip" />
    <EmbeddedResource Include="payload.zip" />
  </ItemGroup>

</Project>
