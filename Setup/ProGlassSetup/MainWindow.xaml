<Window x:Class="ProGlassSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProGlass Automation Setup"
        Height="420" Width="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Fade in/out transition storyboards -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource GlassBorderBrush}"
            BorderThickness="1.5"
            Background="{DynamicResource AmbientBrush}"
            CornerRadius="16"
            ClipToBounds="True"
            Effect="{DynamicResource CardShadowEffect}">

        <Grid>
            <!-- Ambient Glow Blobs -->
            <Border Background="{DynamicResource AmbientBlob1Brush}" CornerRadius="16" IsHitTestVisible="False"/>
            <Border Background="{DynamicResource AmbientBlob2Brush}" CornerRadius="16" IsHitTestVisible="False"/>

            <!-- Main Structure Grid -->
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title / Window Controls -->
                    <RowDefinition Height="*"/>    <!-- Inner Content Area -->
                    <RowDefinition Height="Auto"/> <!-- Button Actions -->
                </Grid.RowDefinitions>

                <!-- 1) Top Title Area & Drag Handler -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Logo Icon Shape -->
                        <Grid Width="28" Height="28" VerticalAlignment="Center">
                            <Border CornerRadius="6" Background="{DynamicResource AccentBrush}"/>
                            <Path Stroke="White" StrokeThickness="1.5" Fill="#33FFFFFF"
                                  Data="M 14,5 L 21,14 L 14,23 L 7,14 Z" StrokeLineJoin="Round"/>
                        </Grid>
                        <TextBlock Text="ProGlass Automation Setup"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   FontWeight="Bold" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Custom Elegant Exit Button -->
                    <Button Grid.Column="2" Style="{DynamicResource SecondaryButtonStyle}"
                            Content="&#10005;" Width="32" Height="28" Padding="0" FontSize="11"
                            Click="ExitButton_Click" ToolTip="Close installer"/>
                </Grid>

                <!-- 2) Center Multi-stage Frame View -->
                <Grid Grid.Row="1" Margin="0,20,0,16">

                    <!-- Stage 1: Welcome -->
                    <Grid x:Name="StageWelcome" Visibility="Visible" Opacity="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="10,0,0,0">
                            <TextBlock Text="Welcome to ProGlass Automation Setup"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="Bold" FontSize="20" Effect="{DynamicResource TextGlowEffect}"/>
                            <TextBlock Text="This professional setup will install the ProGlass production management ERP."
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="13" Margin="0,6,0,0"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" Margin="10,14,10,0" VerticalScrollBarVisibility="Auto">
                            <Border Background="#151F32" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="8" Padding="14">
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" LineHeight="18">
                                    This software is fully licensed and protected by intellectual property laws.
                                    By proceeding, you agree to the installation of ProGlass Automation on your workstation.
                                    The software targets the high-performance glass tempering, processing, and sales estimation workflow.
                                    <LineBreak/><LineBreak/>
                                    Requirements &amp; Specs:
                                    • Native 64-bit architecture
                                    • Offline database engine (Embedded SQLite)
                                    • Non-blocking Whisper Speech-to-Text capabilities
                                    • Production line optimization and export utilities
                                    • Multi-currency UAE FTA Tax Invoice calculations
                                </TextBlock>
                            </Border>
                        </ScrollViewer>
                    </Grid>

                    <!-- Stage 2: Selection & Mode -->
                    <Grid x:Name="StageMode" Visibility="Collapsed" Opacity="0">
                        <StackPanel Margin="10,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="Configure Installation Properties"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="Bold" FontSize="18"/>
                            <TextBlock Text="Set destination and shortcut configurations below."
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" Margin="0,4,0,20"/>

                            <TextBlock Text="Destination Installation Directory:" Foreground="{DynamicResource PrimaryForegroundBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtPath" Grid.Column="0" Style="{DynamicResource ModernTextBoxStyle}"/>
                                <Button Grid.Column="1" Style="{DynamicResource SecondaryButtonStyle}" Content="Browse..." Margin="8,0,0,0" Click="Browse_Click"/>
                            </Grid>

                            <CheckBox x:Name="ChkShortcut" Style="{DynamicResource ModernCheckBoxStyle}" IsChecked="True" Content="Create Desktop &amp; Start Menu Shortcuts"/>
                        </StackPanel>
                    </Grid>

                    <!-- Stage 3: Loading Progress -->
                    <Grid x:Name="StageProgress" Visibility="Collapsed" Opacity="0">
                        <StackPanel VerticalAlignment="Center" Margin="20,0">
                            <TextBlock x:Name="TxtProgressStatus" Text="Extracting software binaries..."
                                       Foreground="{DynamicResource PrimaryForegroundBrush}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtProgressDetail" Text="Initializing file stream copy..."
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="11" Margin="0,6,0,16" HorizontalAlignment="Center"/>
                            <ProgressBar x:Name="InstallProgressBar" Style="{DynamicResource ModernProgressBarStyle}" Value="0" Maximum="100"/>
                        </StackPanel>
                    </Grid>

                    <!-- Stage 4: Success Finished -->
                    <Grid x:Name="StageSuccess" Visibility="Collapsed" Opacity="0">
                        <StackPanel VerticalAlignment="Center" Margin="20,0" HorizontalAlignment="Center">
                            <!-- Visual Animated Tick -->
                            <Ellipse Width="56" Height="56" Fill="#1E2B44" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2.5" HorizontalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#34D399" BlurRadius="12" Opacity="0.4"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="ProGlass Installed Successfully"
                                       Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" FontSize="20" Margin="0,16,0,6" HorizontalAlignment="Center"/>
                            <TextBlock Text="ProGlass Automation was successfully configured on your local workstation."
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center"/>

                            <CheckBox x:Name="ChkLaunch" Style="{DynamicResource ModernCheckBoxStyle}" IsChecked="True" Content="Launch ProGlass Automation Immediately" Margin="0,24,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                </Grid>

                <!-- 3) Stage Action Controls (Previous / Next / Cancel / Install) -->
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Previous Stage -->
                    <Button x:Name="BtnPrev" Grid.Column="0" Style="{DynamicResource SecondaryButtonStyle}"
                            Content="Back" Visibility="Collapsed" Click="BtnPrev_Click"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <!-- Exit/Cancel -->
                        <Button x:Name="BtnCancel" Style="{DynamicResource SecondaryButtonStyle}"
                                Content="Cancel" Margin="0,0,12,0" Click="BtnCancel_Click"/>
                        <!-- Next/Action -->
                        <Button x:Name="BtnNext" Style="{DynamicResource ModernButtonStyle}"
                                Content="Next" Click="BtnNext_Click"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
