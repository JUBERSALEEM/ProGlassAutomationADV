# ProGlass Automation — website environment
# Copy to .env.local for local work; set the same keys in
# Vercel → Project → Settings → Environment Variables for deployments.
# NEVER commit a filled copy. (.env*.local and .env are git-ignored.)

# ── Supabase (operator dashboards: records, deliveries, inquiries) ──
# Project afpbdyamedpanwijxghk. The ANON key is the publishable one —
# it ships to browsers by design; RLS decides what it may read.
# NEVER put a service_role key in either variable (the app refuses it).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Deliberately absent: SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SERVICE_KEY.
# The site never builds a privileged client; those names appear in code
# only as a diagnostics boolean (hasServerServiceKey). Do not set them.

# ── Public site identity ────────────────────────────────────────────
# Canonical origin for sitemap/OG/canonicals. Unset = the vercel.app
# fallback in src/lib/site.ts. Set this the day a custom domain lands.
NEXT_PUBLIC_SITE_URL=
# WhatsApp support line for wa.me links (digits, country code first).
# Unset = the owner number fallback in src/lib/site.ts.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Demo-request form transport ─────────────────────────────────────
# Default transport is FormSubmit to DEMO_REQUEST_INBOX (no key needed).
DEMO_REQUEST_INBOX=proglassautomation@gmail.com
# Opt-in: DEMO_REQUEST_PROVIDER=resend + RESEND_API_KEY switches to Resend.
DEMO_REQUEST_PROVIDER=
RESEND_API_KEY=

# ── Billing (Phase 1 — see docs/MONETIZATION_PLAN.md) ───────────────
# Plan prices + hosted payment links live in src/data/plans.ts (public,
# versioned). Only the webhook secret is an env var. While these are
# unset, /api/checkout and /api/webhooks/billing answer 501 and the
# pricing page keeps its quote-per-business behaviour.
BILLING_PROVIDER=
BILLING_WEBHOOK_SECRET=

# ── Cloud multi-tenancy (Phase 2, dormant) ──────────────────────────
# "on" makes src/lib/tenant.ts resolve a company per signed-in user.
# Anything else (including unset) = tenancy off, current behaviour.
# Do NOT turn on before supabase-multitenancy-phase2.sql is applied
# AND backfilled on the live project.
NEXT_PUBLIC_CLOUD_TENANCY=

# ── Local scripts only (not used by the deployed site) ──────────────
# Inquiry bridges run from a workstation against .env.local:
#   INQUIRY_BRIDGE_EMAIL / INQUIRY_BRIDGE_PASSWORD /
#   INQUIRY_BRIDGE_CHECKPOINT / INQUIRY_BRIDGE_MAX_ROWS /
#   INQUIRY_SOURCE_DATASET_ID
#   INQUIRY_INBOX_EMAIL / INQUIRY_INBOX_PASSWORD /
#   INQUIRY_INBOX_ROOT / INQUIRY_INBOX_MAX_ITEMS
