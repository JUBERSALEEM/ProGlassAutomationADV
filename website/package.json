{
  "name": "proglass-automation-website",
  "version": "2.0.11",
  "private": true,
  "description": "Official marketing/product website for ProGlass Automation — the Windows desktop ERP for glass fabrication businesses.",
  "scripts": {
    "predev": "node scripts/check-deps.mjs && node scripts/check-build-freshness.mjs check",
    "prebuild": "node scripts/check-deps.mjs",
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "postbuild": "node scripts/check-build-freshness.mjs record",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit",
    "test:job-orders": "node --experimental-strip-types --experimental-default-type=module --test scripts/job-order-production.test.mjs",
    "test:inquiry-security": "node --experimental-strip-types --test scripts/inquiry-document-security.test.mjs scripts/inquiry-schema-security.test.mjs scripts/inquiry-api-security.test.mjs scripts/inquiry-bridge.test.mjs scripts/inquiry-intake-security.test.mjs scripts/inquiry-inbox-bridge.test.mjs scripts/inquiry-estimator-security.test.mjs scripts/inquiry-estimator-workspace.test.mjs scripts/inquiry-estimator-analytics.test.mjs scripts/inquiry-estimator-communication.test.mjs scripts/inquiry-estimator-handoff.test.mjs scripts/inquiry-global-chat.test.mjs scripts/inquiry-production-room.test.mjs",
    "inquiries:inbox:dry-run": "node scripts/inquiry-inbox-bridge.mjs",
    "inquiries:inbox:apply": "node scripts/inquiry-inbox-bridge.mjs --apply",
    "inquiries:estimators:live-test": "node --env-file=.env.local scripts/inquiry-estimator-live-test.mjs",
    "inquiries:bridge:dry-run": "node --experimental-strip-types scripts/inquiry-bridge.mjs",
    "inquiries:bridge:publish": "node --experimental-strip-types scripts/inquiry-bridge.mjs --publish",
    "pixel:pass": "node scripts/clay-pixel-pass.mjs",
    "doctor": "node scripts/check-deps.mjs --report",
    "check:live": "node scripts/check-live.mjs",
    "supabase:check": "node --experimental-strip-types scripts/supabase-check.mjs",
    "fix": "node scripts/fix.mjs",
    "assets:backdrop": "tsx scripts/render-hero-backdrop.mts",
    "assets:banner": "tsx scripts/render-hero-banner.mts",
    "assets:plates": "npm run assets:backdrop && npm run assets:banner && npm run assets:optimize",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "i18n:keys": "node scripts/i18n-extract.mjs && node scripts/build-coverage-table.mjs && node scripts/build-route-overlays.mjs",
    "i18n:wire-text": "node scripts/i18n-wire-text.mjs",
    "i18n:wire-fields": "node scripts/i18n-wire-fields.mjs",
    "i18n:verify": "node scripts/i18n-verify.mjs",
    "i18n:audit": "node --experimental-strip-types scripts/i18n-audit.mjs",
    "i18n:gaps": "node --experimental-strip-types scripts/i18n-audit.mjs --gaps",
    "i18n:memory": "node scripts/i18n-memory-fill.mjs --all",
    "i18n:fill": "node scripts/i18n-machine-fill.mjs --all",
    "test:navbar": "node --test scripts/nav-pill-clip.test.mjs && vitest run",
    "test:modernization": "node --test scripts/modernization-contract.test.mjs",
    "test:theme-system": "node --experimental-strip-types --test scripts/theme-schema.test.mjs",
    "test:theme-components": "vitest run tests/design-system-components.test.tsx",
    "test:design-system": "node --test scripts/design-system-governance.test.mjs",
    "test:motion-system": "node --test scripts/motion-tokens.test.mjs scripts/crystal-motion.test.mjs && vitest run tests/motion-reveal.test.tsx tests/route-template.test.tsx tests/accordion-motion.test.tsx tests/modal-dialog.test.tsx",
    "test:clay": "node --test scripts/clay-contrast.test.mjs scripts/clay-visibility.test.mjs && node scripts/clay-coverage.mjs --check",
    "test:density": "node --test scripts/card-radius-guard.test.mjs scripts/card-grid-redesign.test.mjs scripts/top-panel-compact.test.mjs && node scripts/card-compaction-census.mjs --check",
    "guard:pointer": "node scripts/pointer-state-guard.mjs",
    "testcrystal": "node scripts/crystal-contrast.test.mjs",
    "crystal:census": "node scripts/crystal-blur-census.mjs --budget"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/supabase-js": "2.117.2",
    "@vercel/speed-insights": "^2.0.0",
    "fflate": "^0.8.3",
    "motion": "^14.2.0",
    "next": "16.3.6",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@next/bundle-analyzer": "^16.4.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.18.0",
    "eslint-config-next": "16.3.6",
    "jsdom": "^24.1.3",
    "postcss": "8.5.1",
    "sharp": "0.33.5",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.15",
    "typescript": "5.7.3",
    "vitest": "^3.2.7"
  }
}
