{
  "name": "proglass-automation-website",
  "version": "2.0.11",
  "private": true,
  "description": "Official marketing/product website for ProGlass Automation \u2014 the Windows desktop ERP for glass fabrication businesses.",
  "scripts": {
    "predev": "node scripts/check-build-freshness.mjs check",
    "prebuild": "node scripts/check-deps.mjs",
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "postbuild": "node scripts/check-build-freshness.mjs record",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit",
    "assets:optimize": "node scripts/optimize-assets.mjs"
  },
  "dependencies": {
    "marked": "^15.0.12",
    "next": "16.3.6",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.18.0",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.1",
    "sharp": "0.33.5",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  }
}
