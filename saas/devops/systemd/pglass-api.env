# ProGlass SaaS API environment (Phase 27) — template for /etc/pglass/api.env
# EVERY value below is a placeholder: replace before first start.

# Runtime connection — the DML-only login (least privilege, RLS path).
# Create the group + login roles exactly once (your DBA, or the compose
# bootstrap script saas/devops/postgres/init/10-roles.sh shows the SQL):
#   CREATE ROLE saas_app_login LOGIN PASSWORD '…' IN ROLE saas_app;
SAAS_DB=Host=127.0.0.1;Port=5432;Database=pglass;Username=saas_app_login;Password=replace-me

# Elevated connection — migrations + tenant provisioning (saas_owner).
#   CREATE ROLE saas_owner_login LOGIN PASSWORD '…' IN ROLE saas_owner;
SAAS_PLATFORM_DB=Host=127.0.0.1;Port=5432;Database=pglass;Username=saas_owner_login;Password=replace-me

# JWT HS256 signing key (>= 32 random bytes): openssl rand -base64 48
SAAS_JWT_SIGNING_KEY=replace-me

# Migrations as a release step (recommended with systemd):
#   sudo systemctl stop pglass-api
#   SAAS_DB="$SAAS_PLATFORM_DB" SAAS_MIGRATE_ON_STARTUP=true SAAS_MIGRATE_AND_EXIT=true \
#     dotnet /opt/pglass/ProGlass.Saas.Api.dll     # applies + exits
#   sudo systemctl start pglass-api
SAAS_MIGRATE_ON_STARTUP=false

# Kestrel on localhost — nginx terminates TLS at the edge
# (saas/devops/nginx; point the upstream at 127.0.0.1:8081 there).
ASPNETCORE_URLS=http://127.0.0.1:8081
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

# Attachment byte storage (Phase 24) — same path as ReadWritePaths above.
SAAS_ATTACHMENT_ROOT=/var/lib/pglass/attachments
