<Application x:Class="ProGlassAutomation.App"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:conv="clr-namespace:ProGlassAutomation.Converters"
                 xmlns:beh="clr-namespace:ProGlassAutomation.Behaviors"
                 xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                 Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <!-- ── Theme (must be first so styles can reference brushes) ── -->
                <ResourceDictionary Source="pack://application:,,,/Themes/LightTheme.xaml"/>

                <!-- ── Shared style dictionaries (order matters for BasedOn chains) ── -->
                <ResourceDictionary Source="pack://application:,,,/Themes/Styles/TypographyStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Themes/Styles/IconBadgeStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Themes/Styles/PillStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Themes/Styles/CardStyles.xaml"/>

                <!-- v2 design system: shared module-screen primitives -->
                <ResourceDictionary Source="pack://application:,,,/Themes/Styles/DesignTokens.xaml"/>
                <!-- Industrial list-page chrome (PI / JO / DN / TI) -->
                <ResourceDictionary Source="pack://application:,,,/Themes/Styles/ListPageStyles.xaml"/>
                <!-- Line-item table chrome (Step 5 + JO/DN/TI details) -->
                <ResourceDictionary Source="pack://application:,,,/Themes/Styles/DataGridStyles.xaml"/>
                <!-- v3 centralized button design system — single source
                     of truth for all button visuals project-wide. -->
                <ResourceDictionary Source="Styles/ButtonStyles.xaml"/>

                <!-- Shared chrome for the four Step 4 parameter panels.
                     Merged app-wide so all four reference one definition
                     instead of each keeping its own drifting copy. -->
                <ResourceDictionary Source="Styles/Step4SectionStyles.xaml"/>

                <!-- Proforma Invoice industrial work-surface / KPI / ACTIONS
                     primitives. DynamicResource only — light, dark, Monet. -->
                <ResourceDictionary Source="pack://application:,,,/Themes/Styles/PiIndustrialStyles.xaml"/>

                <!-- Module tab strip + God View styles (DN/JO/TI tabs) -->
                <ResourceDictionary Source="pack://application:,,,/Themes/Styles/ModuleTabStyles.xaml"/>

                <!-- Phase 8/9: shared theme-adaptive input styles (TextBox /
                     PasswordBox / ComboBox). Adopted incrementally by views
                     instead of each view declaring its own input chrome. -->
                <ResourceDictionary Source="pack://application:,,,/Themes/Styles/InputStyles.xaml"/>
                <!-- Phase 8/9: shared dialog card/footer/title chrome. -->
                <ResourceDictionary Source="pack://application:,,,/Themes/Styles/DialogStyles.xaml"/>

                <!-- Modern rounded context-menu styles for every module's
                     right-click menu (Proforma / Job Order / Delivery Note /
                     Tax Invoice). -->
                <ResourceDictionary Source="Styles/ContextMenuStyles.xaml"/>

                <!-- Shared dashboard chrome for all 7 module dashboards.
                     Previously each dashboard declared its own local
                     SolidColorBrush resources with hardcoded hex (44 in
                     total, including #FFFFFF card surfaces), so those
                     cards stayed light-coloured when the app switched to
                     the dark theme. Everything here resolves through
                     DynamicResource against keys present in BOTH themes. -->
                <ResourceDictionary Source="Styles/DashboardStyles.xaml"/>

                <!-- ═══════════════════════════════════════════════════════════════
                         CHAT 21 v3 — Statement Generator WIZARD shared styles
                         Registered globally so all 4 wizard step UserControls
                         (Filter/Preview/Execute/Review) can reference:
                           StepTitleStyle, StepSubtitleStyle, StepNumberBadgeStyle,
                           StepLabelStyle, StepperConnectorStyle, WizardCardStyle,
                           WizardCardHeaderStyle, NavButton*Style, FieldLabelStyle,
                           SectionSubHeaderStyle, FormComboBoxStyle, OptionCardStyle,
                           MetricCardStyle
                         via {StaticResource ...} without duplication.
                    ═══════════════════════════════════════════════════════════════ -->
                <ResourceDictionary Source="/Views/Reports/StatementGenerator/Styles/WizardStyles.xaml"/>

            </ResourceDictionary.MergedDictionaries>

            <!-- ═══ GLOBAL FONT (FontService) ══════════════════════════
                 Referenced with DynamicResource across the app so
                 FontService.ApplyFont can restyle the whole UI at once.
                 Bold / italic are applied via AppFontWeight / AppFontStyle.
                 Declared AFTER the merged dictionaries (XAML requires
                 property elements before content, not interleaved). -->
            <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
            <FontWeight x:Key="AppFontWeight">Normal</FontWeight>
            <FontStyle x:Key="AppFontStyle">Normal</FontStyle>

            <!-- ══════════════════════════════════════════════════════════
                     BUILT-IN CONVERTERS (preserved)
                ══════════════════════════════════════════════════════════ -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <!-- Short aliases so XAML files can use the more concise
                 "BoolToVis" / "InverseBoolToVis" names that match the
                 app's other XAML conventions. Both names resolve to
                 the same converter instance, so either is fine. -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

            <!-- Density defaults (overwritten at startup by ThemeManager). -->
            <sys:Double x:Key="DensityInputHeight">28</sys:Double>
            <sys:Double x:Key="DensityButtonHeight">30</sys:Double>
            <sys:Double x:Key="DensityRowHeight">26</sys:Double>
            <sys:Double x:Key="DensityTitleFontSize">17</sys:Double>
            <sys:Double x:Key="DensityKpiValueFontSize">15</sys:Double>
            <sys:Double x:Key="DensityBodyFontSize">12</sys:Double>
            <sys:Double x:Key="DensityButtonMinWidth">84</sys:Double>
            <sys:Double x:Key="UiScale">1.0</sys:Double>

            <!-- ══════════════════════════════════════════════════════════
                     CUSTOM CONVERTERS (preserved — all 7 unchanged + 1 NEW)
                ══════════════════════════════════════════════════════════ -->
            <conv:ColorStringConverter              x:Key="ColorStringConverter"/>
            <conv:DecimalIsPositiveConverter        x:Key="DecimalIsPositiveConverter"/>
            <conv:DecimalTypingConverter            x:Key="DecimalTypingConverter"/>
            <conv:ReferenceEqualityConverter        x:Key="ReferenceEqualityConverter"/>
            <conv:ScaleConverter                    x:Key="ScaleConverter"/>
            <conv:InverseBoolToVisibilityConverter  x:Key="InverseBoolToVisibilityConverter"/>
            <conv:BrushKeyConverter                 x:Key="BrushKeyConverter"/>
            <conv:PercentToWidthConverter           x:Key="PercentToWidthConverter"/>
            <conv:SliderValueLabelConverter         x:Key="SliderValueLabelConverter"/>
            <conv:FractionToStarConverter           x:Key="FractionToStarConverter"/>
            <conv:EqualityToVisibilityConverter     x:Key="EqualityToVisibilityConverter"/>
            <conv:StringEqualsMultiConverter        x:Key="StringEqualsMultiConverter"/>
            <conv:WindowInsetConverter              x:Key="WindowInsetConverter"/>
            <conv:NullToVisibilityConverter         x:Key="NullToVisibilityConverter"/>
            <conv:ListToStringConverter             x:Key="ListToStringConverter"/>

            <!-- ══════════════════════════════════════════════════════════
                     GLOBAL TEXTBOX STYLE — Bug 2 + Bug 5
                     ──────────────────────────────────────────────────────────
                     No x:Key = implicit style (applies to every TextBox).

                     SelectAllOnFocus="True" — click or tab selects all text.
                     Multi-line / Notes TextBoxes must opt out explicitly:
                       beh:TextBoxBehaviors.SelectAllOnFocus="False"

                     AcceptDecimals / AcceptIntegersOnly are opt-IN behaviors.
                     Set them per-field in individual views, NOT globally,
                     because not every TextBox is a numeric field.

                     UI/UX mandate:
                       Height=38, CornerRadius=8, Padding=12,0
                       Focus ring: indigo glow 200ms QuinticEase
                       Hover: border shifts to accent indigo tint
                       Disabled: 45% opacity
                       ReadOnly: muted background
                ══════════════════════════════════════════════════════════ -->
            <Style TargetType="{x:Type TextBox}">

                <!-- Layout -->
                    <Setter Property="Height"                   Value="{DynamicResource DensityInputHeight}"/>
                <Setter Property="VerticalAlignment"        Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding"                  Value="12,0"/>

                <!-- Typography — 13px body, theme foreground. Font family is
                     the global AppFontFamily so FontService restyles the
                     whole app; icons keep their own Segoe MDL2 family. -->
                <Setter Property="FontSize"   Value="{DynamicResource DensityBodyFontSize}"/>
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>

                <!-- Surface — theme-aware background + border -->
                <Setter Property="Background"     Value="{DynamicResource ModuleBackgroundBrush}"/>
                <Setter Property="BorderBrush"    Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>

                <!-- Rendering -->
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="UseLayoutRounding"   Value="True"/>

                <!-- Bug 2: SelectAll on focus — global default ON -->
                <!-- Multi-line Notes must set this False explicitly  -->
                <Setter Property="beh:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>

                <!-- CornerRadius + focus ring glow via ControlTemplate -->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Grid>

                                <!--
                                        Focus ring — indigo glow behind the border.
                                        Opacity animates 0→0.20 on focus.
                                        Margin=-2 so it peeks out slightly around MainBorder.
                                    -->
                                <Border x:Name="FocusRing"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Margin="-2"
                                            Opacity="0"
                                            IsHitTestVisible="False">
                                    <Border.Background>
                                        <SolidColorBrush Color="{DynamicResource AccentColor}"/>
                                    </Border.Background>
                                    <Border.Effect>
                                        <BlurEffect Radius="0"/>
                                    </Border.Effect>
                                </Border>

                                <!--
                                        Main input container.
                                        CornerRadius=8 per UI/UX mandate.
                                        BorderBrush animates via triggers below.
                                    -->
                                <Border x:Name="MainBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{DynamicResource ControlCornerRadius}">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                      Focusable="False"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      HorizontalScrollBarVisibility="Hidden"
                                                      VerticalScrollBarVisibility="Hidden"/>
                                </Border>

                            </Grid>

                            <ControlTemplate.Triggers>

                                <!-- Hover: border shifts to theme accent hover -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="MainBorder"
                                                Property="BorderBrush"
                                                Value="{DynamicResource AccentHoverBrush}"/>
                                </Trigger>

                                <!-- Focus: border = theme accent + glow animates in -->
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="MainBorder"
                                                Property="BorderBrush"
                                                Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="MainBorder"
                                                Property="BorderThickness"
                                                Value="2"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- Glow opacity: 0 → 0.20 -->
                                                <DoubleAnimation
                                                        Storyboard.TargetName="FocusRing"
                                                        Storyboard.TargetProperty="Opacity"
                                                        To="0.20"
                                                        Duration="0:0:0.2">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuinticEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <!-- Glow blur: 0 → 8px -->
                                                <DoubleAnimation
                                                        Storyboard.TargetName="FocusRing"
                                                        Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)"
                                                        To="8"
                                                        Duration="0:0:0.2">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuinticEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- Glow fades out on blur -->
                                                <DoubleAnimation
                                                        Storyboard.TargetName="FocusRing"
                                                        Storyboard.TargetProperty="Opacity"
                                                        To="0"
                                                        Duration="0:0:0.15"/>
                                                <DoubleAnimation
                                                        Storyboard.TargetName="FocusRing"
                                                        Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)"
                                                        To="0"
                                                        Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <!-- Disabled: 45% opacity — muted but visible -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="MainBorder"
                                                Property="Opacity"
                                                Value="0.45"/>
                                </Trigger>

                                <!-- ReadOnly: muted background, secondary text -->
                                <Trigger Property="IsReadOnly" Value="True">
                                    <Setter TargetName="MainBorder"
                                                Property="Background"
                                                Value="{DynamicResource MenuHoverBrush}"/>
                                    <Setter Property="Foreground"
                                                Value="{DynamicResource SecondaryForegroundBrush}"/>
                                </Trigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>