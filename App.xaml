<Application x:Class="ProGlassAutomation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ProGlassAutomation.Converters"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/LightTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Global converters -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:ColorStringConverter x:Key="ColorStringConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>