<UserControl x:Class="ProGlassAutomation.ThemeStudio.IconsStudioView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProGlassAutomation.ThemeStudio">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly">
  <Grid Margin="{DynamicResource PaddingPage}">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="2*"/>
    <ColumnDefinition Width="3*"/>
   </Grid.ColumnDefinitions>
   <ContentControl Style="{DynamicResource Card}" Margin="{DynamicResource MarginInline}">
    <StackPanel>
     <DockPanel Margin="{DynamicResource MarginItem}">
      <local:ShellMark DockPanel.Dock="Left" Title="Icons studio" Category="mark" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
      <TextBlock Text="Icons studio" Style="{DynamicResource PageHeading}" VerticalAlignment="Center"/>
     </DockPanel>
     <TextBlock Text="A shared mark overlay. Ten styles, native Path geometry — no PNG, no extra font, not a tenth theme. Sidebar buttons and the module title follow the live choice." Style="{DynamicResource Caption}" TextWrapping="Wrap"/>
     <Label Content="Icon style" Target="{Binding ElementName=IconPicker}" Foreground="{DynamicResource TextSecondary}"/>
     <ListBox x:Name="IconPicker" ItemsSource="{Binding IconStyleCards}" SelectedValue="{Binding SelectedIconStyle}" SelectedValuePath="Style" DisplayMemberPath="Name" AutomationProperties.Name="Icon style" MinHeight="{DynamicResource ReferenceListMaxHeight}" Margin="{DynamicResource MarginSection}"/>
     <WrapPanel Margin="{DynamicResource MarginItem}">
      <Button Content="Reset icons" Command="{Binding ResetIcons}" Margin="{DynamicResource MarginInline}" AutomationProperties.Name="Reset icons to Fluent outline"/>
      <Button Content="Save" Command="{Binding SaveCustomization}" Style="{DynamicResource PrimaryButton}" Margin="{DynamicResource MarginInline}" AutomationProperties.Name="Save icon overlay"/>
      <Button Content="Discard" Command="{Binding DiscardChanges}" Margin="{DynamicResource MarginInline}" AutomationProperties.Name="Discard icon overlay"/>
     </WrapPanel>
     <TextBlock Text="{Binding ThemeError}" Foreground="{DynamicResource StatusError}" AutomationProperties.LiveSetting="Assertive" Margin="{DynamicResource MarginItem}"/>
    </StackPanel>
   </ContentControl>
   <ContentControl Grid.Column="1" Style="{DynamicResource Card}" Margin="{DynamicResource MarginInline}">
    <StackPanel>
     <DockPanel Margin="{DynamicResource MarginItem}">
      <local:ShellMark DockPanel.Dock="Left" Title="Live mark preview" Category="icon" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
      <TextBlock Text="Live mark preview" Style="{DynamicResource SectionHeading}" VerticalAlignment="Center"/>
     </DockPanel>
     <TextBlock Text="Marks inherit the button foreground, so selected gold / on-accent still works." Style="{DynamicResource Caption}" TextWrapping="Wrap" Margin="{DynamicResource MarginItem}"/>
     <WrapPanel Margin="{DynamicResource MarginSection}">
      <StackPanel Margin="{DynamicResource PaddingCompact}" Width="{DynamicResource ControlMinWidth}">
       <local:ShellMark Kind="Home" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
       <TextBlock Text="Home" Style="{DynamicResource Caption}" HorizontalAlignment="Center"/>
      </StackPanel>
      <StackPanel Margin="{DynamicResource PaddingCompact}" Width="{DynamicResource ControlMinWidth}">
       <local:ShellMark Kind="Theme" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
       <TextBlock Text="Theme" Style="{DynamicResource Caption}" HorizontalAlignment="Center"/>
      </StackPanel>
      <StackPanel Margin="{DynamicResource PaddingCompact}" Width="{DynamicResource ControlMinWidth}">
       <local:ShellMark Kind="Texts" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
       <TextBlock Text="Texts" Style="{DynamicResource Caption}" HorizontalAlignment="Center"/>
      </StackPanel>
      <StackPanel Margin="{DynamicResource PaddingCompact}" Width="{DynamicResource ControlMinWidth}">
       <local:ShellMark Kind="Colors" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
       <TextBlock Text="Colors" Style="{DynamicResource Caption}" HorizontalAlignment="Center"/>
      </StackPanel>
      <StackPanel Margin="{DynamicResource PaddingCompact}" Width="{DynamicResource ControlMinWidth}">
       <local:ShellMark Kind="Marks" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
       <TextBlock Text="Icons" Style="{DynamicResource Caption}" HorizontalAlignment="Center"/>
      </StackPanel>
      <StackPanel Margin="{DynamicResource PaddingCompact}" Width="{DynamicResource ControlMinWidth}">
       <local:ShellMark Kind="About" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
       <TextBlock Text="About" Style="{DynamicResource Caption}" HorizontalAlignment="Center"/>
      </StackPanel>
      <StackPanel Margin="{DynamicResource PaddingCompact}" Width="{DynamicResource ControlMinWidth}">
       <local:ShellMark Title="Author" Category="people" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
       <TextBlock Text="Author" Style="{DynamicResource Caption}" HorizontalAlignment="Center"/>
      </StackPanel>
      <StackPanel Margin="{DynamicResource PaddingCompact}" Width="{DynamicResource ControlMinWidth}">
       <local:ShellMark Title="Active work" Category="work" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
       <TextBlock Text="Work" Style="{DynamicResource Caption}" HorizontalAlignment="Center"/>
      </StackPanel>
      <StackPanel Margin="{DynamicResource PaddingCompact}" Width="{DynamicResource ControlMinWidth}">
       <local:ShellMark Title="Order mix" Category="chart" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
       <TextBlock Text="Charts" Style="{DynamicResource Caption}" HorizontalAlignment="Center"/>
      </StackPanel>
      <StackPanel Margin="{DynamicResource PaddingCompact}" Width="{DynamicResource ControlMinWidth}">
       <local:ShellMark Title="Bento layout" Category="layout" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
       <TextBlock Text="Layout" Style="{DynamicResource Caption}" HorizontalAlignment="Center"/>
      </StackPanel>
     </WrapPanel>
     <TextBlock Text="{Binding SelectedIconCaption}" Style="{DynamicResource TokenValue}" TextWrapping="Wrap" Margin="{DynamicResource MarginItem}"/>
    </StackPanel>
   </ContentControl>
  </Grid>
 </ScrollViewer>
</UserControl>
