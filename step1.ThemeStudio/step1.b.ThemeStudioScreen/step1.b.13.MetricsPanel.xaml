<UserControl x:Class="ProGlassAutomation.ThemeStudio.MetricsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProGlassAutomation.ThemeStudio">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
  <ContentControl Style="{DynamicResource MetricCard}" Margin="{DynamicResource MarginInline}"><StackPanel><TextBlock Text="ACTIVE REVIEWS" Style="{DynamicResource Caption}" /><TextBlock Text="{Binding ReferenceItems.Count, StringFormat='0{0}'}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="{DynamicResource FontWeightHeading}" Foreground="{DynamicResource AccentPrimary}" /><TextBlock Text="Illustrative workload" Style="{DynamicResource Caption}" /></StackPanel></ContentControl>
  <ContentControl Grid.Column="1" Style="{DynamicResource MetricCard}" Margin="{DynamicResource MarginInline}"><StackPanel><TextBlock Text="TEAM CAPACITY" Style="{DynamicResource Caption}" /><TextBlock Text="75%" FontSize="{DynamicResource FontSizeTitle}" FontWeight="{DynamicResource FontWeightHeading}" Foreground="{DynamicResource StatusSuccess}" /><TextBlock Text="Sample allocation" Style="{DynamicResource Caption}" /></StackPanel></ContentControl>
  <ContentControl Grid.Column="2" Style="{DynamicResource MetricCard}"><StackPanel><TextBlock Text="NEXT MILESTONE" Style="{DynamicResource Caption}" /><TextBlock Text="24 Oct" FontSize="{DynamicResource FontSizeTitle}" FontWeight="{DynamicResource FontWeightHeading}" Foreground="{DynamicResource StatusInformation}" /><TextBlock Text="Illustrative delivery date" Style="{DynamicResource Caption}" /></StackPanel></ContentControl>
 </Grid>
</UserControl>
