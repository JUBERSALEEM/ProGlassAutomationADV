<UserControl x:Class="ProGlassAutomation.ThemeStudio.SurfacesPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProGlassAutomation.ThemeStudio">
 <ContentControl Style="{DynamicResource Card}">
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
   </Grid.RowDefinitions>
   <StackPanel Margin="{DynamicResource MarginItem}">
    <TextBlock Text="TEAM HANDOFF / SAMPLE" Style="{DynamicResource Caption}" />
    <DockPanel Margin="{DynamicResource MarginItem}">
     <local:ShellMark DockPanel.Dock="Left" Title="Next in the workflow" Category="work" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
     <TextBlock Text="Next in the workflow." Style="{DynamicResource SectionHeading}" VerticalAlignment="Center"/>
    </DockPanel>
   </StackPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
    <StackPanel>
     <WrapPanel Margin="{DynamicResource MarginItem}">
      <ContentControl Style="{DynamicResource Plate}" Margin="{DynamicResource PaddingPlate}"><StackPanel Margin="{DynamicResource PaddingCompact}"><TextBlock Text="Review brief" FontWeight="{DynamicResource FontWeightHeading}" /><TextBlock Text="Scope and priorities" Style="{DynamicResource Caption}" /></StackPanel></ContentControl>
      <ContentControl Style="{DynamicResource Plate}" Margin="{DynamicResource PaddingPlate}"><StackPanel Margin="{DynamicResource PaddingCompact}"><TextBlock Text="Quality check" FontWeight="{DynamicResource FontWeightHeading}" /><TextBlock Text="Details before delivery" Style="{DynamicResource Caption}" /></StackPanel></ContentControl>
      <ContentControl Style="{DynamicResource AccentPlate}" Margin="{DynamicResource PaddingPlate}"><StackPanel Margin="{DynamicResource PaddingCompact}"><TextBlock Text="Handoff" Foreground="{DynamicResource AccentPrimary}" FontWeight="{DynamicResource FontWeightHeading}" /><TextBlock Text="Team alignment" Style="{DynamicResource Caption}" /></StackPanel></ContentControl>
     </WrapPanel>
     <TextBlock Text="Selection / use arrows to move between rows" Style="{DynamicResource Caption}" Margin="{DynamicResource MarginSection}" />
     <ListBox SelectedIndex="0" AutomationProperties.Name="Surface selection examples" Margin="{DynamicResource MarginItem}">
      <ListBoxItem Content="Primary surface — main working area" />
      <ListBoxItem Content="Secondary surface — grouped supporting information" />
      <ListBoxItem Content="Quality check — dialogs and contextual actions" />
     </ListBox>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </ContentControl>
</UserControl>
