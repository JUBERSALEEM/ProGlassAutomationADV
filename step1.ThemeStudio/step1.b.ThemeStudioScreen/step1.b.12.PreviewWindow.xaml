<Window x:Class="ProGlassAutomation.ThemeStudio.PreviewWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ProGlass · Shared-resource preview" Style="{DynamicResource ThemedWindow}" SizeToContent="Height" Width="{DynamicResource WindowMinWidth}"
 MinWidth="{DynamicResource WindowMinWidth}" WindowStartupLocation="CenterOwner">
 <StackPanel Margin="{DynamicResource PaddingPage}">
  <TextBlock Text="An existing window. The same engine." Style="{DynamicResource SectionHeading}" />
  <TextBlock Text="Switch here or in Studio. Both windows must update together." Margin="{DynamicResource MarginItem}" />
  <WrapPanel><RadioButton Content="Light" GroupName="DialogAppearance" IsChecked="{Binding IsLight}" /><RadioButton Content="Dark" GroupName="DialogAppearance" IsChecked="{Binding IsDark}" /></WrapPanel>
  <ContentControl Style="{DynamicResource AccentPlate}" Margin="{DynamicResource MarginSection}"><StackPanel><TextBlock Text="{Binding SelectedTheme}" FontWeight="{DynamicResource FontWeightHeading}" Foreground="{DynamicResource AccentPrimary}" /><TextBlock Text="{Binding AppearanceLabel}" /></StackPanel></ContentControl>
  <TextBox Text="{Binding SampleName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" AutomationProperties.Name="Preview name in shared window" Margin="{DynamicResource MarginItem}" />
  <TextBlock Text="{Binding NameError}" Foreground="{DynamicResource StatusError}" Margin="{DynamicResource MarginItem}" />
  <WrapPanel><Button Content="Apply preview" Command="{Binding ApplyPreview}" Style="{DynamicResource PrimaryButton}" Margin="{DynamicResource MarginInline}" /><Button Content="Close window" Click="Close_Click" /></WrapPanel>
  <TextBlock Text="{Binding Feedback}" Style="{DynamicResource Caption}" />
 </StackPanel>
</Window>
