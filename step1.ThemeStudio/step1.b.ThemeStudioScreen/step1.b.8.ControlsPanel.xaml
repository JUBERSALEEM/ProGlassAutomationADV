<UserControl x:Class="ProGlassAutomation.ThemeStudio.ControlsPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProGlassAutomation.ThemeStudio">
 <ContentControl Style="{DynamicResource Card}">
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
   </Grid.RowDefinitions>
   <StackPanel>
    <TextBlock Text="QUICK REVIEW" Style="{DynamicResource Caption}" />
    <DockPanel Margin="{DynamicResource MarginItem}">
     <local:ShellMark DockPanel.Dock="Left" Title="Edit a local preview" Category="control" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
     <TextBlock Text="Edit a local preview." Style="{DynamicResource SectionHeading}" VerticalAlignment="Center"/>
    </DockPanel>
   </StackPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
    <StackPanel>
     <Label Content="Review label (minimum 3 characters)" Target="{Binding ElementName=PreviewName}" Foreground="{DynamicResource TextSecondary}" />
     <TextBox x:Name="PreviewName" Text="{Binding SampleName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" AutomationProperties.Name="Preview name" Margin="{DynamicResource MarginSection}" />
     <TextBlock Text="{Binding NameError}" Foreground="{DynamicResource StatusError}" Margin="{DynamicResource MarginItem}" />
     <WrapPanel Margin="{DynamicResource MarginItem}">
      <Button Content="_Apply preview" Command="{Binding QuickApplyPreview}" Style="{DynamicResource PrimaryButton}" Margin="{DynamicResource MarginInline}" />
      <Button Content="_Reset" Command="{Binding ResetPreview}" Margin="{DynamicResource MarginInline}" />
      <Button Content="_Clear preview" Style="{DynamicResource DestructiveButton}" Command="{Binding ClearPreview}" ToolTip="Clears only the local preview name, not saved data." Margin="{DynamicResource MarginInline}" />
      <Button Content="_Help" Style="{DynamicResource SubtleButton}" Command="{Binding ShowHelp}" Margin="{DynamicResource MarginInline}" />
      <Button Content="Unavailable" IsEnabled="False" Margin="{DynamicResource MarginInline}" />
     </WrapPanel>
     <CheckBox Content="Show helper labels" IsChecked="{Binding ShowHelpers}" AutomationProperties.Name="Show helper labels" />
     <TextBlock Text="Tab moves focus. Right-click the progress action for more options." Margin="{DynamicResource MarginItem}">
      <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><DataTrigger Binding="{Binding ShowHelpers}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
     <ContentControl Style="{DynamicResource Plate}" Margin="{DynamicResource MarginItem}"><TextBlock Text="{Binding Feedback}" AutomationProperties.LiveSetting="Polite" /></ContentControl>
     <Button Content="Advance progress / restart at 100%" Command="{Binding AdvanceProgress}" HorizontalAlignment="Left" Margin="{DynamicResource MarginItem}">
      <Button.ContextMenu><ContextMenu><MenuItem Header="Reset preview" Command="{Binding ResetPreview}" /><MenuItem Header="Open preview window" Command="{Binding OpenDialog}" /></ContextMenu></Button.ContextMenu>
     </Button>
     <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" AutomationProperties.Name="Demonstration progress" />
     <TextBlock Text="{Binding Progress, StringFormat='Demonstration progress: {0}%'}" Style="{DynamicResource Caption}" />
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </ContentControl>
</UserControl>
