<UserControl x:Class="ProGlassAutomation.ThemeStudio.ColorsStudioView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ProGlassAutomation.ThemeStudio">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly">
  <StackPanel Margin="{DynamicResource PaddingPage}">
   <ContentControl Style="{DynamicResource Card}" Margin="{DynamicResource MarginSection}">
    <StackPanel>
     <DockPanel Margin="{DynamicResource MarginItem}">
      <local:ShellMark DockPanel.Dock="Left" Title="Colors studio" Category="palette" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
      <TextBlock Text="Colors studio" Style="{DynamicResource PageHeading}" VerticalAlignment="Center"/>
     </DockPanel>
     <TextBlock Text="A plate is one hue with named values 50–800. The bar below picks an exact #RRGGBB for the selected role. Overlay writes Accent, Focus and Chart tokens only — the active theme still owns canvas and material." Style="{DynamicResource Caption}"/>
     <DockPanel Margin="{DynamicResource MarginItem}">
      <local:ShellMark DockPanel.Dock="Left" Title="Card plates" Category="color" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
      <TextBlock Text="Card plates" Style="{DynamicResource SectionHeading}" VerticalAlignment="Center"/>
     </DockPanel>
     <TextBlock Text="Ordinary cards only (SurfacePrimary, Secondary, Elevated). 0 restores the theme. 100 is the coded hex as painted. Status plates stay semantic. Gradient uses start and end colours." Style="{DynamicResource Caption}"/>
     <TextBlock Text="Start colour" Style="{DynamicResource Caption}"/>
     <local:ColorPickerBar SelectedHex="{Binding CardTintHex, UpdateSourceTrigger=PropertyChanged}" Margin="{DynamicResource MarginItem}"/>
     <Label Content="Wash 0–100" Foreground="{DynamicResource TextSecondary}"/>
     <DockPanel Margin="{DynamicResource MarginItem}">
      <TextBox DockPanel.Dock="Right" MinWidth="{DynamicResource ControlMinWidth}" Text="{Binding CardSaturation, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Card plate wash percent"/>
      <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding CardSaturation}" VerticalAlignment="Center" Margin="{DynamicResource MarginInline}" AutomationProperties.Name="Card plate wash slider"/>
     </DockPanel>
     <Label Content="Fill" Foreground="{DynamicResource TextSecondary}"/>
     <ComboBox ItemsSource="{Binding CardGradientChoices}" SelectedItem="{Binding SelectedCardGradient}" AutomationProperties.Name="Card plate gradient" Margin="{DynamicResource MarginItem}"/>
     <TextBlock Text="End colour" Style="{DynamicResource Caption}"/>
     <local:ColorPickerBar SelectedHex="{Binding CardTintEndHex, UpdateSourceTrigger=PropertyChanged}" Margin="{DynamicResource MarginItem}"/>
     <Border Height="{DynamicResource ControlMinHeight}" Background="{DynamicResource SurfacePrimary}" CornerRadius="{DynamicResource ControlCornerRadius}" Margin="{DynamicResource MarginItem}"/>
     <TextBlock Text="{Binding CardTintSummary}" Style="{DynamicResource TokenValue}" Margin="{DynamicResource MarginItem}"/>
     <DockPanel Margin="{DynamicResource MarginItem}">
      <local:ShellMark DockPanel.Dock="Left" Title="Color bar" Category="color" Width="{DynamicResource ChoiceMarkSize}" Height="{DynamicResource ChoiceMarkSize}" Margin="{DynamicResource MarginInline}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
      <TextBlock Text="Color bar" Style="{DynamicResource SectionHeading}" VerticalAlignment="Center"/>
     </DockPanel>
     <local:ColorPickerBar SelectedHex="{Binding ColorRoleHex, UpdateSourceTrigger=PropertyChanged}" Margin="{DynamicResource MarginItem}"/>
     <Label Content="Color plate" Target="{Binding ElementName=ColorPlatePicker}" Foreground="{DynamicResource TextSecondary}"/>
     <ComboBox x:Name="ColorPlatePicker" ItemsSource="{Binding ColorPlateChoices}" SelectedItem="{Binding SelectedColorPlate}" AutomationProperties.Name="Color plate" Margin="{DynamicResource MarginItem}"/>
     <ItemsControl ItemsSource="{Binding ColorPlateCards}" Margin="{DynamicResource MarginItem}">
      <ItemsControl.ItemsPanel>
       <ItemsPanelTemplate>
        <WrapPanel/>
       </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Button Command="{Binding DataContext.SelectColorPlate, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Name}" Margin="{DynamicResource MarginInline}" MinWidth="{DynamicResource ControlMinWidth}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
         <StackPanel>
          <ItemsControl ItemsSource="{Binding Swatches}">
           <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
             <UniformGrid Rows="1"/>
            </ItemsPanelTemplate>
           </ItemsControl.ItemsPanel>
           <ItemsControl.ItemTemplate>
            <DataTemplate>
             <Border Height="{DynamicResource ControlMinHeight}" Background="{Binding .}" Margin="{DynamicResource MarginInline}" CornerRadius="{DynamicResource ChipCornerRadius}"/>
            </DataTemplate>
           </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding Name}" FontWeight="{DynamicResource FontWeightHeading}" Margin="{DynamicResource MarginItem}"/>
          <TextBlock Text="{Binding Summary}" Style="{DynamicResource TokenValue}" TextWrapping="Wrap"/>
         </StackPanel>
        </Button>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </ContentControl>
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <ContentControl Style="{DynamicResource Card}" Margin="{DynamicResource MarginSection}">
     <StackPanel>
      <TextBlock Text="Role override" Style="{DynamicResource SectionHeading}"/>
      <TextBlock Text="{Binding ColorStopSummary}" Style="{DynamicResource TokenValue}" Margin="{DynamicResource MarginItem}"/>
      <Label Content="Color role" Foreground="{DynamicResource TextSecondary}"/>
      <ComboBox ItemsSource="{Binding ColorRoleChoices}" SelectedItem="{Binding SelectedColorRole}" AutomationProperties.Name="Color role" Margin="{DynamicResource MarginItem}"/>
      <Label Content="Role hex" Foreground="{DynamicResource TextSecondary}"/>
      <DockPanel Margin="{DynamicResource MarginItem}">
       <Button DockPanel.Dock="Right" Content="Clear override" Command="{Binding ClearColorOverride}" Margin="{DynamicResource MarginInline}" AutomationProperties.Name="Clear color role override"/>
       <TextBox Text="{Binding ColorRoleHex, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Color role hex"/>
      </DockPanel>
      <TextBlock Text="{Binding ColorRoleSummary}" Style="{DynamicResource TokenValue}" Margin="{DynamicResource MarginItem}"/>
      <WrapPanel Margin="{DynamicResource MarginItem}">
       <Button Content="Reset colors" Command="{Binding ResetColors}" Margin="{DynamicResource MarginInline}" AutomationProperties.Name="Reset colors to Ocean"/>
       <Button Content="Save" Command="{Binding SaveCustomization}" Style="{DynamicResource PrimaryButton}" Margin="{DynamicResource MarginInline}" AutomationProperties.Name="Save color overlay"/>
       <Button Content="Discard" Command="{Binding DiscardChanges}" Margin="{DynamicResource MarginInline}" AutomationProperties.Name="Discard color overlay"/>
      </WrapPanel>
      <TextBlock Text="{Binding ThemeError}" Foreground="{DynamicResource StatusError}" AutomationProperties.LiveSetting="Assertive" Margin="{DynamicResource MarginItem}"/>
     </StackPanel>
    </ContentControl>
    <ContentControl Grid.Column="1" Style="{DynamicResource Card}" Margin="{DynamicResource MarginSection}">
     <StackPanel>
      <TextBlock Text="Live accent preview" Style="{DynamicResource SectionHeading}"/>
      <TextBlock Text="These surfaces bind Accent and Chart tokens. Changing a plate updates the whole application, including Theme Studio and Home." Style="{DynamicResource Caption}"/>
      <Border Background="{DynamicResource AccentPrimary}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{DynamicResource PaddingControl}" Margin="{DynamicResource MarginItem}">
       <TextBlock Text="Accent primary" Foreground="{DynamicResource TextOnAccent}"/>
      </Border>
      <Border Background="{DynamicResource AccentSoft}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{DynamicResource PaddingControl}" Margin="{DynamicResource MarginItem}">
       <TextBlock Text="Accent soft"/>
      </Border>
      <WrapPanel Margin="{DynamicResource MarginItem}">
       <Border Width="{DynamicResource ControlMinHeight}" Height="{DynamicResource ControlMinHeight}" Background="{DynamicResource ChartSeries1}" CornerRadius="{DynamicResource ChipCornerRadius}" Margin="{DynamicResource MarginInline}"/>
       <Border Width="{DynamicResource ControlMinHeight}" Height="{DynamicResource ControlMinHeight}" Background="{DynamicResource ChartSeries2}" CornerRadius="{DynamicResource ChipCornerRadius}" Margin="{DynamicResource MarginInline}"/>
       <Border Width="{DynamicResource ControlMinHeight}" Height="{DynamicResource ControlMinHeight}" Background="{DynamicResource ChartSeries3}" CornerRadius="{DynamicResource ChipCornerRadius}" Margin="{DynamicResource MarginInline}"/>
       <Border Width="{DynamicResource ControlMinHeight}" Height="{DynamicResource ControlMinHeight}" Background="{DynamicResource ChartSeries4}" CornerRadius="{DynamicResource ChipCornerRadius}" Margin="{DynamicResource MarginInline}"/>
      </WrapPanel>
     </StackPanel>
    </ContentControl>
   </Grid>
  </StackPanel>
 </ScrollViewer>
</UserControl>
