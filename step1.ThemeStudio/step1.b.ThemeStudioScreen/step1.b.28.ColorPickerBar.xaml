<UserControl x:Class="ProGlassAutomation.ThemeStudio.ColorPickerBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="Auto"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>
  <StackPanel Margin="{DynamicResource MarginInline}">
   <TextBlock Text="Basic colors" Style="{DynamicResource Caption}"/>
   <UniformGrid x:Name="BasicGrid" Rows="6" Columns="8" Margin="{DynamicResource MarginItem}"/>
  </StackPanel>
  <Grid Grid.Column="1" MinHeight="{DynamicResource ChartPlotHeight}" Margin="{DynamicResource MarginInline}">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
   </Grid.RowDefinitions>
   <TextBlock Text="Spectrum" Style="{DynamicResource Caption}"/>
   <Grid Grid.Row="1" x:Name="Spectrum" Cursor="Cross" Background="{DynamicResource SurfaceSecondary}" MouseLeftButtonDown="OnSpectrumDown" MouseMove="OnSpectrumMove" MouseLeftButtonUp="OnSpectrumUp">
    <Border x:Name="HueStrip"/>
    <Border x:Name="WhiteVeil" IsHitTestVisible="False"/>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
