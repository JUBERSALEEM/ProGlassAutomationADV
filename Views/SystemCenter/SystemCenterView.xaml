<!-- System Center — Users + Activity Log. Studio Bento fresh UI, same
     visual contract as the Proforma Invoice list (SavedInvoicesListView):
     Sl.* hero band, tab chips, cards, soft table headers and rows.
     All commands, bindings and the two password handlers retained. -->
<UserControl x:Class="ProGlassAutomation.Views.SystemCenter.SystemCenterView"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="{DynamicResource Ov.Canvas}"
             Foreground="{DynamicResource Ov.Ink}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Shared/Lists/StudioListResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ HERO BAND ═════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource Sl.Hero}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Module.SystemCenter}"
                               Style="{StaticResource Sl.Label}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Ov.OnAccent}"/>
                    <TextBlock Style="{StaticResource Sl.Subtitle}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Ov.OnAccentMuted}">
                        <Run Text="{DynamicResource SystemCenter.UserManagementAuditTrailSigned}"/>
                        <Run Text="{Binding CurrentUserDisplay, Mode=OneWay}" FontWeight="{DynamicResource Weight.Bold}"/>
                    </TextBlock>
                </StackPanel>

                <!-- Tab chips: Users / Activity -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SwitchTabCommand}" CommandParameter="Users"
                            Tag="&#xE716;" Content="{DynamicResource SystemCenter.Users}"
                            ToolTip="{DynamicResource SystemCenter.ManageUsers}" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Sl.Button}">
                                <Setter Property="Background" Value="{DynamicResource Ov.Surface}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUsersTab}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding SwitchTabCommand}" CommandParameter="Users"
                            Tag="&#xE716;" Content="{DynamicResource SystemCenter.Users}"
                            ToolTip="{DynamicResource SystemCenter.ManageUsers}" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Sl.PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUsersTab}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding SwitchTabCommand}" CommandParameter="Activity"
                            Tag="&#xE81C;" Content="{DynamicResource SystemCenter.ActivityLOG}"
                            ToolTip="{DynamicResource SystemCenter.AuditTrailRecordedAction}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Sl.Button}">
                                <Setter Property="Background" Value="{DynamicResource Ov.Surface}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActivityTab}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding SwitchTabCommand}" CommandParameter="Activity"
                            Tag="&#xE81C;" Content="{DynamicResource SystemCenter.ActivityLOG}"
                            ToolTip="{DynamicResource SystemCenter.AuditTrailRecordedAction}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Sl.PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActivityTab}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ USERS TAB ═════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUsersTab}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: create user + switch user + online network -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <StackPanel>
                    <!-- Create user -->
                    <Border Style="{StaticResource Sl.Card}" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="&#xE710;" FontFamily="{DynamicResource FontFamily.Icon}"
                                           FontSize="{DynamicResource FontSize.H3}"
                                           Foreground="{DynamicResource Ov.Accent}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{DynamicResource SystemCenter.CreateUSER}"
                                           Style="{StaticResource Sl.Label}" FontSize="{DynamicResource FontSize.Title}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="{DynamicResource Login.Username}" Style="{StaticResource Sl.Label}" Margin="0,0,0,3"/>
                            <TextBox Style="{StaticResource Sl.Input}"
                                     Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="{DynamicResource Login.DisplayNAME}" Style="{StaticResource Sl.Label}" Margin="0,8,0,3"/>
                            <TextBox Style="{StaticResource Sl.Input}"
                                     Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="{DynamicResource SystemCenter.ROLE}" Style="{StaticResource Sl.Label}" Margin="0,8,0,3"/>
                            <ComboBox ItemsSource="{Binding RoleOptions}"
                                      SelectedItem="{Binding SelectedRole}"
                                      Style="{StaticResource Sl.Combo}"/>

                            <TextBlock Text="{DynamicResource Login.Password}" Style="{StaticResource Sl.Label}" Margin="0,8,0,3"/>
                            <PasswordBox x:Name="NewPasswordBox"
                                         Padding="10,8"
                                         FontSize="{DynamicResource FontSize.Body}"
                                         Background="{DynamicResource Ov.Surface}"
                                         Foreground="{DynamicResource Ov.Ink}"
                                         BorderBrush="{DynamicResource Ov.Line}"
                                         BorderThickness="1"
                                         PasswordChanged="NewPasswordBox_PasswordChanged"/>

                            <Button Style="{StaticResource Sl.PrimaryButton}"
                                    Margin="0,12,0,0" HorizontalAlignment="Stretch"
                                    Tag="&#xE710;" Content="{DynamicResource SystemCenter.CreateUSER}"
                                    ToolTip="{DynamicResource SystemCenter.CreateNewUserAccount}"
                                    Command="{Binding CreateUserCommand}"/>

                            <TextBlock Text="{Binding UserFormMessage}"
                                       FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.SemiBold}"
                                       Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Ov.Accent}"/>
                        </StackPanel>
                    </Border>

                    <!-- Switch active user -->
                    <Border Style="{StaticResource Sl.Card}" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="&#xE895;" FontFamily="{DynamicResource FontFamily.Icon}"
                                           FontSize="{DynamicResource FontSize.H3}"
                                           Foreground="{DynamicResource Ov.Accent}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{DynamicResource SystemCenter.SwitchActiveUser}"
                                           Style="{StaticResource Sl.Label}" FontSize="{DynamicResource FontSize.Title}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource SystemCenter.FutureActionsRecordedActiveUser}"
                                       Style="{StaticResource Sl.Subtitle}" TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="{DynamicResource Login.Username}" Style="{StaticResource Sl.Label}" Margin="0,0,0,3"/>
                            <TextBox Style="{StaticResource Sl.Input}"
                                     Text="{Binding SwitchUsername, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="{DynamicResource Login.Password}" Style="{StaticResource Sl.Label}" Margin="0,8,0,3"/>
                            <PasswordBox x:Name="SwitchPasswordBox"
                                         Padding="10,8"
                                         FontSize="{DynamicResource FontSize.Body}"
                                         Background="{DynamicResource Ov.Surface}"
                                         Foreground="{DynamicResource Ov.Ink}"
                                         BorderBrush="{DynamicResource Ov.Line}"
                                         BorderThickness="1"
                                         PasswordChanged="SwitchPasswordBox_PasswordChanged"/>

                            <Button Style="{StaticResource Sl.PrimaryButton}"
                                    Margin="0,12,0,0" HorizontalAlignment="Stretch"
                                    Tag="&#xE895;" Content="{DynamicResource Login.SwitchUser}"
                                    ToolTip="{DynamicResource SystemCenter.SignUser}"
                                    Command="{Binding SwitchUserCommand}"/>

                            <TextBlock Text="{Binding SwitchMessage}"
                                       FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.SemiBold}"
                                       Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Ov.Accent}"/>
                        </StackPanel>
                    </Border>

                    <!-- Online network -->
                    <Border Style="{StaticResource Sl.Card}" Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="&#xE839;" FontFamily="{DynamicResource FontFamily.Icon}"
                                           FontSize="{DynamicResource FontSize.H3}"
                                           Foreground="{DynamicResource Ov.Accent}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{DynamicResource SystemCenter.OnlineNetwork}"
                                           Style="{StaticResource Sl.Label}" FontSize="{DynamicResource FontSize.Title}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource SystemCenter.ColleaguesRunningProglassLANAppearHere}"
                                       Style="{StaticResource Sl.Subtitle}" TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>

                            <!-- Empty state -->
                            <TextBlock Text="{DynamicResource SystemCenter.NoOtherUsersDetectedRightNow}"
                                       FontSize="{DynamicResource FontSize.BodySmall}" FontStyle="Italic">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Ov.Muted}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPeers}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding OnlinePeers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Ov.Line}" BorderThickness="1" Padding="10,8" Margin="0,0,0,6"
                                                Background="{DynamicResource Ov.Soft}"
                                                CornerRadius="{DynamicResource Radius.Medium}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="8" Height="8"
                                                         Fill="{DynamicResource Ov.Success}"
                                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                               Foreground="{DynamicResource Ov.Ink}"/>
                                                    <TextBlock FontSize="{DynamicResource FontSize.BodySmall}" Margin="0,1,0,0"
                                                               Foreground="{DynamicResource Ov.Muted}">
                                                        <Run Text="{Binding Username, Mode=OneWay}"/>
                                                        <Run Text="  •  "/>
                                                        <Run Text="{Binding MachineName, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT: user table -->
            <Border Grid.Column="2" Style="{StaticResource Sl.Card}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Sl.TableHeader}" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource SystemCenter.USER}" Style="{StaticResource Sl.ColumnLabel}" Margin="12,0,0,0"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource SystemCenter.ROLEPermissions}" Style="{StaticResource Sl.ColumnLabel}" Margin="12,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource Common.Status}" Style="{StaticResource Sl.ColumnLabel}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{DynamicResource Shared.Action}" Style="{StaticResource Sl.ColumnLabel}" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  CanContentScroll="False"
                                  behaviors:SmoothScrollBehavior.IsEnabled="True">
                        <ItemsControl ItemsSource="{Binding Users}" Margin="0,6"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Sl.Row}" Margin="6,2" Padding="12,10"
                                            BorderBrush="{DynamicResource Ov.Line}" BorderThickness="1"
                                            CornerRadius="{DynamicResource Radius.Medium}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="150"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="40" Height="40"
                                                    CornerRadius="{DynamicResource Radius.Medium}"
                                                    Background="{DynamicResource Ov.Soft}">
                                                <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource FontFamily.Icon}"
                                                           FontSize="{DynamicResource FontSize.H3}"
                                                           Foreground="{DynamicResource Ov.Accent}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.Bold}"
                                                               Foreground="{DynamicResource Ov.Ink}"/>
                                                    <Border Background="{DynamicResource Ov.SuccessSoft}"
                                                            CornerRadius="{DynamicResource Radius.Small}"
                                                            Padding="6,2" Margin="8,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{DynamicResource SystemCenter.ActiveNOW}"
                                                                   FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                                                   Foreground="{DynamicResource Ov.Success}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock FontSize="{DynamicResource FontSize.BodySmall}" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource Ov.Muted}">
                                                    <Run Text="{Binding Username, Mode=OneWay}"/>
                                                    <Run Text="  •  "/>
                                                    <Run Text="{Binding RoleBadge, Mode=OneWay}"/>
                                                    <Run Text="  •  "/>
                                                    <Run Text="{Binding PermissionCount, Mode=OneWay}"/>
                                                    <Run Text="{DynamicResource SystemCenter.Since}"/>
                                                    <Run Text="{Binding CreatedDisplay, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                                       HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="ENABLED"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Ov.Success}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Text" Value="DISABLED"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource Ov.Muted}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Button Grid.Column="3"
                                                    Tag="&#xE74D;" Content="{DynamicResource SystemCenter.Deactivate}"
                                                    ToolTip="{DynamicResource SystemCenter.DisableUserAccount}"
                                                    MinWidth="104"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.ToggleActiveCommand,
                                                                RelativeSource={RelativeSource
                                                                    AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource Sl.DangerButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Grid.Column="3"
                                                    Tag="&#xE73E;" Content="{DynamicResource SystemCenter.Activate}"
                                                    ToolTip="{DynamicResource SystemCenter.ReEnableUserAccount}"
                                                    MinWidth="104"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.ToggleActiveCommand,
                                                                RelativeSource={RelativeSource
                                                                    AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource Sl.Button}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ══ ACTIVITY TAB ══════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActivityTab}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Action-focused toolbar: scope chips + important-only +
                 search + refresh. All = full compliance trail. -->
            <Border Grid.Row="0" Style="{StaticResource Sl.FilterBar}" Margin="0,0,0,10">
                <StackPanel>
                    <WrapPanel>
                        <!-- Scope chips: two-button visibility pattern -->
                        <Button Command="{Binding SetScopeCommand}" CommandParameter="All"
                                Tag="&#xE81C;" Content="{DynamicResource Common.All}" Margin="0,0,6,4">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Sl.Button}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScopeAll}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding SetScopeCommand}" CommandParameter="All"
                                Tag="&#xE81C;" Content="{DynamicResource Common.All}" Margin="0,0,6,4">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Sl.PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScopeAll}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding SetScopeCommand}" CommandParameter="System"
                                Tag="&#xE90F;" Content="{DynamicResource SystemCenter.ScopeSystem}" Margin="0,0,6,4">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Sl.Button}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScopeSystem}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding SetScopeCommand}" CommandParameter="System"
                                Tag="&#xE90F;" Content="{DynamicResource SystemCenter.ScopeSystem}" Margin="0,0,6,4">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Sl.PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScopeSystem}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding SetScopeCommand}" CommandParameter="UsersSecurity"
                                Tag="&#xE77B;" Content="{DynamicResource SystemCenter.ScopeUsersSecurity}" Margin="0,0,6,4">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Sl.Button}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScopeUsersSecurity}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding SetScopeCommand}" CommandParameter="UsersSecurity"
                                Tag="&#xE77B;" Content="{DynamicResource SystemCenter.ScopeUsersSecurity}" Margin="0,0,6,4">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Sl.PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScopeUsersSecurity}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding SetScopeCommand}" CommandParameter="Inventory"
                                Tag="&#xE7B8;" Content="{DynamicResource SystemCenter.ScopeInventory}" Margin="0,0,6,4">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Sl.Button}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScopeInventory}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding SetScopeCommand}" CommandParameter="Inventory"
                                Tag="&#xE7B8;" Content="{DynamicResource SystemCenter.ScopeInventory}" Margin="0,0,6,4">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Sl.PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScopeInventory}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding SetScopeCommand}" CommandParameter="Transactions"
                                Tag="&#xE8C7;" Content="{DynamicResource SystemCenter.ScopeTransactions}" Margin="0,0,6,4">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Sl.Button}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScopeTransactions}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding SetScopeCommand}" CommandParameter="Transactions"
                                Tag="&#xE8C7;" Content="{DynamicResource SystemCenter.ScopeTransactions}" Margin="0,0,6,4">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Sl.PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScopeTransactions}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <CheckBox Content="{DynamicResource SystemCenter.ImportantActionsOnly}"
                                  IsChecked="{Binding ImportantOnly}"
                                  VerticalAlignment="Bottom" Margin="8,0,10,12"
                                  ToolTip="{DynamicResource SystemCenter.ImportantActionsOnlyTooltip}"/>

                        <TextBox Margin="0,0,8,4" Width="240"
                                 Text="{Binding ActivitySearch, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Sl.Input}"
                                 VerticalAlignment="Bottom"
                                 AutomationProperties.Name="Search activity"
                                 ToolTip="{DynamicResource SystemCenter.SearchActionsTooltip}"/>

                        <Button Style="{StaticResource Sl.PrimaryButton}" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                Tag="&#xE72C;" Content="{DynamicResource Action.Refresh}"
                                ToolTip="{DynamicResource SystemCenter.ReloadActivityLog}"
                                Command="{Binding RefreshActivityCommand}"/>
                    </WrapPanel>

                    <TextBlock Text="{Binding ActivityCountDisplay}"
                               FontSize="{DynamicResource FontSize.Caption}"
                               Foreground="{DynamicResource Ov.Muted}"
                               Margin="2,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Activity table -->
            <Border Grid.Row="1" Style="{StaticResource Sl.Card}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Sl.TableHeader}" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Diagnostics.TIME}" Style="{StaticResource Sl.ColumnLabel}" Margin="12,0,0,0"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource SystemCenter.Section}" Style="{StaticResource Sl.ColumnLabel}"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource Shared.Action}" Style="{StaticResource Sl.ColumnLabel}" Margin="10,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="{DynamicResource Shared.Details}" Style="{StaticResource Sl.ColumnLabel}" Margin="10,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Empty state -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center"
                                HorizontalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivityEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE81C;" FontFamily="{DynamicResource FontFamily.Icon}"
                                   FontSize="{DynamicResource FontSize.Display}"
                                   Foreground="{DynamicResource Ov.Accent}"
                                   HorizontalAlignment="Center" Opacity="0.6"/>
                        <TextBlock Text="{DynamicResource Shared.NoActivityRecordedYet}"
                                   FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.SemiBold}"
                                   HorizontalAlignment="Center" Margin="0,10,0,3"
                                   Foreground="{DynamicResource Ov.Ink}"/>
                        <TextBlock Text="{DynamicResource SystemCenter.ActionSectionRecordedHereAutomatically}"
                                   FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{DynamicResource Ov.Muted}"/>
                    </StackPanel>

                    <!-- Virtualized activity feed -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  CanContentScroll="False"
                                  behaviors:SmoothScrollBehavior.IsEnabled="True">
                        <ItemsControl ItemsSource="{Binding ActivityRows}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Sl.Row}" Padding="14,10"
                                            ToolTip="{Binding RowTooltip}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding TimeDisplay}"
                                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Ov.Muted}"
                                                       Typography.NumeralAlignment="Tabular"/>

                                            <Border Grid.Column="1"
                                                    Background="{DynamicResource Ov.Soft}"
                                                    CornerRadius="{DynamicResource Radius.Small}"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Section}"
                                                           FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Ov.Accent}"/>
                                            </Border>

                                            <TextBlock Grid.Column="2" Margin="10,0"
                                                       Text="{Binding Action}"
                                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Ov.Ink}"/>

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Details}"
                                                       FontSize="{DynamicResource FontSize.Body}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Details}"
                                                       Foreground="{DynamicResource Ov.Muted}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
