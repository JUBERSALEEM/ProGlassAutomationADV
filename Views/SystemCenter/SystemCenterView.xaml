<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/System/SystemCenterView.xaml
     PROJECT: ProGlassAutomation
     MODULE: System Center — Users + Activity Log

     Shell UI for the audit subsystem:
       [ Users ]   [ Activity Log ]
     Users tab: create users, toggle active, switch session user.
     Activity tab: full audit trail with a live section filter.
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.SystemCenter.SystemCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="{DynamicResource ModuleBackgroundBrush}">

    <UserControl.Resources>

        <Style x:Key="ScFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="ScTextBox" TargetType="TextBox">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background"
                    Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="ScPrimaryButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource AccentBrush}"
                                CornerRadius="{DynamicResource PillCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="24" MaxWidth="1180" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ HEADER ═════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="🛠  System Center"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
            <TextBlock FontSize="12" Margin="0,3,0,0"
                       Foreground="{DynamicResource SecondaryForegroundBrush}">
                <Run Text="User management &amp; audit trail — signed in as "/>
                <Run Text="{Binding CurrentUserDisplay, Mode=OneWay}"
                     FontWeight="Bold"/>
            </TextBlock>
        </StackPanel>

        <!-- ══ TAB STRIP ══════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Style="{StaticResource ModuleTabStripStyle}"
                Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">

                <Button Style="{StaticResource ModuleTabButtonStyle}"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="Users">
                    <TextBlock Text="👥  Users">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource SecondaryForegroundBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUsersTab}" Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <Button Style="{StaticResource ModuleTabButtonStyle}"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="Activity">
                    <TextBlock Text="📜  Activity Log">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource SecondaryForegroundBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActivityTab}" Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </StackPanel>
        </Border>

        <!-- ══ USERS TAB ══════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUsersTab}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: create user + switch user -->
            <StackPanel Grid.Column="0" Margin="0,0,20,0">

                <Border Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="➕  Create user"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="USERNAME" Style="{StaticResource ScFieldLabel}"/>
                        <TextBox Style="{StaticResource ScTextBox}"
                                 Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="DISPLAY NAME" Style="{StaticResource ScFieldLabel}"
                                   Margin="0,10,0,5"/>
                        <TextBox Style="{StaticResource ScTextBox}"
                                 Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="ROLE" Style="{StaticResource ScFieldLabel}"
                                   Margin="0,10,0,5"/>
                        <ComboBox ItemsSource="{Binding RoleOptions}"
                                  SelectedItem="{Binding SelectedRole}"
                                  Padding="10,7"
                                  FontSize="13"/>

                        <TextBlock Text="PASSWORD" Style="{StaticResource ScFieldLabel}"
                                   Margin="0,10,0,5"/>
                        <PasswordBox x:Name="NewPasswordBox"
                                     Padding="10,7"
                                     FontSize="13"
                                     Background="{DynamicResource MenuHoverBrush}"
                                     Foreground="{DynamicResource PrimaryForegroundBrush}"
                                     BorderThickness="0"
                                     PasswordChanged="NewPasswordBox_PasswordChanged"/>

                        <Button Style="{StaticResource ScPrimaryButton}"
                                Margin="0,16,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding CreateUserCommand}">
                            <TextBlock Text="Create User"/>
                        </Button>

                        <TextBlock Text="{Binding UserFormMessage}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="18"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="🔁  Switch active user"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="All future actions are recorded under the active user."
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="USERNAME" Style="{StaticResource ScFieldLabel}"/>
                        <TextBox Style="{StaticResource ScTextBox}"
                                 Text="{Binding SwitchUsername, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="PASSWORD" Style="{StaticResource ScFieldLabel}"
                                   Margin="0,10,0,5"/>
                        <PasswordBox x:Name="SwitchPasswordBox"
                                     Padding="10,7"
                                     FontSize="13"
                                     Background="{DynamicResource MenuHoverBrush}"
                                     Foreground="{DynamicResource PrimaryForegroundBrush}"
                                     BorderThickness="0"
                                     PasswordChanged="SwitchPasswordBox_PasswordChanged"/>

                        <Button Style="{StaticResource ScPrimaryButton}"
                                Margin="0,16,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding SwitchUserCommand}">
                            <TextBlock Text="Switch User"/>
                        </Button>

                        <TextBlock Text="{Binding SwitchMessage}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Same-network presence -->
                <Border Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="18"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="📡  Online on your network"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Colleagues running ProGlass on the same LAN appear here automatically."
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,0,0,10"/>

                        <!-- Empty state -->
                        <TextBlock Text="No other users detected right now."
                                   FontSize="12" FontStyle="Italic">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource MutedForegroundBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPeers}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding OnlinePeers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,7" Margin="0,0,0,6"
                                            Background="{DynamicResource MenuHoverBrush}"
                                            CornerRadius="{DynamicResource ControlCornerRadius}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0"
                                                     Width="8" Height="8"
                                                     Fill="{DynamicResource SuccessBrush}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,9,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                <TextBlock FontSize="10" Margin="0,1,0,0"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}">
                                                    <Run Text="{Binding Username, Mode=OneWay}"/>
                                                    <Run Text="  •  "/>
                                                    <Run Text="{Binding MachineName, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- RIGHT: user table -->
            <Border Grid.Column="1"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    ClipToBounds="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              behaviors:SmoothScrollBehavior.IsEnabled="True">
                    <ItemsControl ItemsSource="{Binding Users}" Margin="6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,10" Margin="0,4"
                                        Background="{DynamicResource ElevatedSurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource ControlCornerRadius}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="38" Height="38"
                                                CornerRadius="19"
                                                Background="{DynamicResource TintIndigoBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="👤"
                                                       FontSize="16"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Margin="12,0"
                                                    VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                <Border Background="{DynamicResource TintGreenBrush}"
                                                        CornerRadius="8"
                                                        Padding="6,1"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="ACTIVE NOW"
                                                               FontSize="9" FontWeight="Bold"
                                                               Foreground="{DynamicResource SuccessBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="11" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}">
                                                <Run Text="{Binding Username, Mode=OneWay}"/>
                                                <Run Text="  •  "/>
                                                <Run Text="{Binding RoleBadge, Mode=OneWay}"/>
                                                <Run Text="  •  "/>
                                                <Run Text="{Binding PermissionCount, Mode=OneWay}"/>
                                                <Run Text="  •  since "/>
                                                <Run Text="{Binding CreatedDisplay, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   FontSize="11" FontWeight="Bold"
                                                   Margin="0,0,10,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="ENABLED"/>
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Text" Value="DISABLED"/>
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource MutedForegroundBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Button Grid.Column="3"
                                                Cursor="Hand"
                                                FontSize="11"
                                                Padding="12,5"
                                                BorderThickness="0"
                                                Background="{DynamicResource MenuHoverBrush}"
                                                Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                Command="{Binding DataContext.ToggleActiveCommand,
                                                            RelativeSource={RelativeSource
                                                                AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Deactivate"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Text" Value="Activate"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ══ ACTIVITY TAB ═══════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActivityTab}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,12">

                <TextBlock Text="Section:"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <ComboBox ItemsSource="{Binding SectionFilters}"
                          SelectedItem="{Binding SelectedSectionFilter}"
                          Margin="8,0,0,0"
                          MinWidth="180"
                          Padding="10,6"
                          FontSize="12"
                          VerticalAlignment="Center"/>

                <Button Style="{StaticResource ScPrimaryButton}"
                        Margin="12,0,0,0"
                        Command="{Binding RefreshActivityCommand}">
                    <TextBlock Text="↻  Refresh"/>
                </Button>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    ClipToBounds="True">
                <Grid>
                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivityEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="🕓" FontSize="36"
                                   HorizontalAlignment="Center"
                                   Opacity="0.6"/>
                        <TextBlock Text="No activity recorded yet"
                                   FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,3"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="Every action in every section is recorded here automatically."
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>

                    <!-- Virtualized activity feed -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  CanContentScroll="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                        <ItemsControl ItemsSource="{Binding ActivityRows}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,10"
                                            BorderBrush="{DynamicResource DividerBrush}"
                                            BorderThickness="0,0,0,1"
                                            ToolTip="{Binding RowTooltip}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding TimeDisplay}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>

                                            <Border Grid.Column="1"
                                                    Background="{DynamicResource TintBlueBrush}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Section}"
                                                           FontSize="10" FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource InfoBrush}"/>
                                            </Border>

                                            <TextBlock Grid.Column="2"
                                                       Margin="10,0"
                                                       Text="{Binding Action}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Details}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Details}"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
