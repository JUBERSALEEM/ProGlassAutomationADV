<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/System/SystemCenterView.xaml
     PROJECT: ProGlassAutomation
     MODULE: System Center — Users + Activity Log

     Shell UI for the audit subsystem:
       [ Users ]   [ Activity Log ]
     Users tab: create users, toggle active, switch session user.
     Activity tab: full audit trail with a live section filter.
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.SystemCenter.SystemCenterView"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="{DynamicResource ModuleBackgroundBrush}">

    <UserControl.Resources>

        <Style x:Key="ScFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="ScTextBox" TargetType="TextBox">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
            <Setter Property="Background"
                    Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

</UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         MIGRATION LOG — Button Standardization (master prompt v1.0)
         Date: 2026-08-15

         Changes:
           • Deleted legacy ScPrimaryButton style (rule 5)
           • 3 CTA/refresh buttons -> PrimaryPillButton (glyph + UPPERCASE
             content + ToolTip)
           • Users/Activity tabs -> STEP D two-button visibility pattern
           • Row toggle -> DangerButton DEACTIVATE / OutlinedPillButton
             ACTIVATE pair with Visibility triggers
           • Card headers: emoji badge boxes -> inline MDL2 icon + title
           • Emojis removed: 🛠 👥 📜 ➕ 🔁  ↻ 👤 🕓
           • ToolTips added to every migrated button

         All commands, bindings, and code-behind wiring preserved.
         No ViewModel changes required.
    ═══════════════════════════════════════════════════════════════ -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ HEADER ═════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets"
                           FontSize="{StaticResource TextTitle}" VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="{DynamicResource Module.SystemCenter}"
                           FontSize="{StaticResource TextTitleLarge}" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
            </StackPanel>
            <TextBlock FontSize="{StaticResource TextBody}" Margin="0,3,0,0"
                       Foreground="{DynamicResource SecondaryForegroundBrush}">
                <Run Text="{DynamicResource SystemCenter.UserManagementAuditTrailSigned}"/>
                <Run Text="{Binding CurrentUserDisplay, Mode=OneWay}"
                     FontWeight="Bold"/>
            </TextBlock>
        </StackPanel>

        <!-- ══ TAB STRIP ══════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Style="{StaticResource ModuleTabStripStyle}"
                Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">

                <!-- TAB Users — STEP D two-button visibility pattern -->
                <Button Command="{Binding SwitchTabCommand}"
                        CommandParameter="Users"
                        Tag="&#xE716;" Content="{DynamicResource SystemCenter.Users}"
                        ToolTip="{DynamicResource SystemCenter.ManageUsers}" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource OutlinedPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUsersTab}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding SwitchTabCommand}"
                        CommandParameter="Users"
                        Tag="&#xE716;" Content="{DynamicResource SystemCenter.Users}"
                        ToolTip="{DynamicResource SystemCenter.ManageUsers}" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUsersTab}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- TAB Activity — STEP D two-button visibility pattern -->
                <Button Command="{Binding SwitchTabCommand}"
                        CommandParameter="Activity"
                        Tag="&#xE81C;" Content="{DynamicResource SystemCenter.ActivityLOG}"
                        ToolTip="{DynamicResource SystemCenter.AuditTrailRecordedAction}"
                        Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource OutlinedPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActivityTab}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding SwitchTabCommand}"
                        CommandParameter="Activity"
                        Tag="&#xE81C;" Content="{DynamicResource SystemCenter.ActivityLOG}"
                        ToolTip="{DynamicResource SystemCenter.AuditTrailRecordedAction}"
                        Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActivityTab}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- ══ USERS TAB ══════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUsersTab}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: create user + switch user -->
            <StackPanel Grid.Column="0" Margin="0,0,20,0">

                <Border Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="18">
                    <StackPanel>
<StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="&#xE710;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource TextTitle}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource SystemCenter.CreateUSER}"
                                       FontSize="{StaticResource TextSubhead}" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="{DynamicResource Login.Username}" Style="{StaticResource ScFieldLabel}"/>
                        <TextBox Style="{StaticResource ScTextBox}"
                                 Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="{DynamicResource Login.DisplayNAME}" Style="{StaticResource ScFieldLabel}"
                                   Margin="0,10,0,5"/>
                        <TextBox Style="{StaticResource ScTextBox}"
                                 Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="{DynamicResource SystemCenter.ROLE}" Style="{StaticResource ScFieldLabel}"
                                   Margin="0,10,0,5"/>
                        <ComboBox ItemsSource="{Binding RoleOptions}"
                                  SelectedItem="{Binding SelectedRole}"
                                  Padding="10,7"
                                  FontSize="{StaticResource TextBodyLarge}"/>

                        <TextBlock Text="{DynamicResource Login.Password}" Style="{StaticResource ScFieldLabel}"
                                   Margin="0,10,0,5"/>
                        <PasswordBox x:Name="NewPasswordBox"
                                     Padding="10,7"
                                     FontSize="{StaticResource TextBodyLarge}"
                                     Background="{DynamicResource MenuHoverBrush}"
                                     Foreground="{DynamicResource PrimaryForegroundBrush}"
                                     BorderThickness="0"
                                     PasswordChanged="NewPasswordBox_PasswordChanged"/>

                        <Button Style="{StaticResource PrimaryPillButton}"
                                Margin="0,16,0,0"
                                HorizontalAlignment="Stretch"
                                Tag="&#xE710;" Content="{DynamicResource SystemCenter.CreateUSER}"
                                ToolTip="{DynamicResource SystemCenter.CreateNewUserAccount}"
                                Command="{Binding CreateUserCommand}"/>

                        <TextBlock Text="{Binding UserFormMessage}"
                                   FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="18"
                        Margin="0,14,0,0">
                    <StackPanel>
<StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="&#xE895;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource TextTitle}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource SystemCenter.SwitchActiveUser}"
                                       FontSize="{StaticResource TextSubhead}" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource SystemCenter.FutureActionsRecordedActiveUser}"
                                   FontSize="{StaticResource TextBody}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="{DynamicResource Login.Username}" Style="{StaticResource ScFieldLabel}"/>
                        <TextBox Style="{StaticResource ScTextBox}"
                                 Text="{Binding SwitchUsername, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="{DynamicResource Login.Password}" Style="{StaticResource ScFieldLabel}"
                                   Margin="0,10,0,5"/>
                        <PasswordBox x:Name="SwitchPasswordBox"
                                     Padding="10,7"
                                     FontSize="{StaticResource TextBodyLarge}"
                                     Background="{DynamicResource MenuHoverBrush}"
                                     Foreground="{DynamicResource PrimaryForegroundBrush}"
                                     BorderThickness="0"
                                     PasswordChanged="SwitchPasswordBox_PasswordChanged"/>

                        <Button Style="{StaticResource PrimaryPillButton}"
                                Margin="0,16,0,0"
                                HorizontalAlignment="Stretch"
                                Tag="&#xE895;" Content="{DynamicResource Login.SwitchUser}"
                                ToolTip="{DynamicResource SystemCenter.SignUser}"
                                Command="{Binding SwitchUserCommand}"/>

                        <TextBlock Text="{Binding SwitchMessage}"
                                   FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Same-network presence -->
                <Border Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="18"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="&#xE839;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource TextSubhead}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource SystemCenter.OnlineNetwork}"
                                       FontSize="{StaticResource TextSection}" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource SystemCenter.ColleaguesRunningProglassLANAppearHere}"
                                   FontSize="{StaticResource TextBody}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,0,0,10"/>

                        <!-- Empty state -->
                        <TextBlock Text="{DynamicResource SystemCenter.NoOtherUsersDetectedRightNow}"
                                   FontSize="{StaticResource TextBody}" FontStyle="Italic">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource MutedForegroundBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPeers}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding OnlinePeers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Padding="10,7" Margin="0,0,0,6"
                                            Background="{DynamicResource MenuHoverBrush}"
                                            CornerRadius="{DynamicResource ControlCornerRadius}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0"
                                                     Width="8" Height="8"
                                                     Fill="{DynamicResource SuccessBrush}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,9,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                <TextBlock FontSize="{StaticResource TextCaption}" Margin="0,1,0,0"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}">
                                                    <Run Text="{Binding Username, Mode=OneWay}"/>
                                                    <Run Text="  •  "/>
                                                    <Run Text="{Binding MachineName, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- RIGHT: user table -->
            <Border Grid.Column="1"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Column heading strip (v2 table reference) -->
                    <Border CornerRadius="{DynamicResource CardCornerRadius}" Grid.Row="0"
                            Background="{DynamicResource AccentBrush}"
                            Padding="16,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource SystemCenter.USER}" Style="{StaticResource ModuleColumnHeaderStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource SystemCenter.ROLEPermissions}"
                                       Margin="12,0,0,0" Style="{StaticResource ModuleColumnHeaderStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource Common.Status}"
                                       HorizontalAlignment="Center" Style="{StaticResource ModuleColumnHeaderStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Grid.Column="3" Text="{DynamicResource Shared.Action}"
                                       HorizontalAlignment="Center" Style="{StaticResource ModuleColumnHeaderStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              CanContentScroll="True"
                              behaviors:SmoothScrollBehavior.IsEnabled="True">
                    <ItemsControl ItemsSource="{Binding Users}" Margin="6"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,10" Margin="0,4"
                                        Background="{DynamicResource ElevatedSurfaceBrush}"
                                        BorderBrush="{DynamicResource OutlineBrush}"
                                        BorderThickness="{DynamicResource CardBorderThickness}"
                                        CornerRadius="{DynamicResource ControlCornerRadius}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="38" Height="38"
                                                CornerRadius="{DynamicResource CardCornerRadius}"
                                                Background="{DynamicResource TintIndigoBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="&#xE77B;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="{StaticResource TextTitle}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Margin="12,0"
                                                    VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="{StaticResource TextBodyLarge}" FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Background="{DynamicResource TintGreenBrush}"
                                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                                        Padding="6,1"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{DynamicResource SystemCenter.ActiveNOW}"
                                                               FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                               Foreground="{DynamicResource SuccessBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="{StaticResource TextBody}" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}">
                                                <Run Text="{Binding Username, Mode=OneWay}"/>
                                                <Run Text="  •  "/>
                                                <Run Text="{Binding RoleBadge, Mode=OneWay}"/>
                                                <Run Text="  •  "/>
                                                <Run Text="{Binding PermissionCount, Mode=OneWay}"/>
                                                <Run Text="{DynamicResource SystemCenter.Since}"/>
                                                <Run Text="{Binding CreatedDisplay, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                                   Margin="0,0,10,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="ENABLED"/>
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Text" Value="DISABLED"/>
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource MutedForegroundBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Button Grid.Column="3"
                                                Tag="&#xE74D;" Content="{DynamicResource SystemCenter.Deactivate}"
                                                ToolTip="{DynamicResource SystemCenter.DisableUserAccount}"
                                                MinWidth="92"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.ToggleActiveCommand,
                                                            RelativeSource={RelativeSource
                                                                AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Grid.Column="3"
                                                Tag="&#xE73E;" Content="{DynamicResource SystemCenter.Activate}"
                                                ToolTip="{DynamicResource SystemCenter.ReEnableUserAccount}"
                                                MinWidth="92"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.ToggleActiveCommand,
                                                            RelativeSource={RelativeSource
                                                                AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource OutlinedPillButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ══ ACTIVITY TAB ═══════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActivityTab}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,12">

                <TextBlock Text="{DynamicResource SystemCenter.Section}"
                           FontSize="{StaticResource TextBody}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <ComboBox ItemsSource="{Binding SectionFilters}"
                          SelectedItem="{Binding SelectedSectionFilter}"
                          Margin="8,0,0,0"
                          MinWidth="180"
                          Padding="10,6"
                          FontSize="{StaticResource TextBody}"
                          VerticalAlignment="Center"/>

                <Button Style="{StaticResource PrimaryPillButton}"
                        Margin="12,0,0,0"
                        Tag="&#xE72C;" Content="{DynamicResource Action.Refresh}"
                        ToolTip="{DynamicResource SystemCenter.ReloadActivityLog}"
                        Command="{Binding RefreshActivityCommand}"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Column heading strip (v2 table reference) -->
                    <Border CornerRadius="{DynamicResource CardCornerRadius}" Grid.Row="0"
                            Background="{DynamicResource AccentBrush}"
                            Padding="16,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Diagnostics.TIME}" Style="{StaticResource ModuleColumnHeaderStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource SystemCenter.Section}" Style="{StaticResource ModuleColumnHeaderStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource Shared.Action}"
                                       Margin="10,0,0,0" Style="{StaticResource ModuleColumnHeaderStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Grid.Column="3" Text="{DynamicResource Shared.Details}"
                                       Margin="10,0,0,0" Style="{StaticResource ModuleColumnHeaderStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        </Grid>
                    </Border>
                    <!-- Empty state -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivityEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="36"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   Opacity="0.6"/>
                        <TextBlock Text="{DynamicResource Shared.NoActivityRecordedYet}"
                                   FontSize="{StaticResource TextSection}" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,3"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="{DynamicResource SystemCenter.ActionSectionRecordedHereAutomatically}"
                                   FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>

                    <!-- Virtualized activity feed -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  CanContentScroll="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                        <ItemsControl ItemsSource="{Binding ActivityRows}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="{DynamicResource CardCornerRadius}" Padding="16,10"
                                            BorderBrush="{DynamicResource OutlineBrush}"
                                            BorderThickness="0,0,0,1"
                                            ToolTip="{Binding RowTooltip}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding TimeDisplay}"
                                                       FontSize="{StaticResource TextBody}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>

                                            <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Grid.Column="1"
                                                    Background="{DynamicResource TintBlueBrush}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Section}"
                                                           FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource InfoBrush}"/>
                                            </Border>

                                            <TextBlock Grid.Column="2"
                                                       Margin="10,0"
                                                       Text="{Binding Action}"
                                                       FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Details}"
                                                       FontSize="{StaticResource TextBody}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Details}"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
