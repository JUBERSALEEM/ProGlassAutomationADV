<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/System/SystemCenterView.xaml
     PROJECT: ProGlassAutomation
     MODULE: System Center — Users + Activity Log

     Shell UI for the audit subsystem:
       [ Users ]   [ Activity Log ]
     Users tab: create users, toggle active, switch session user.
     Activity tab: full audit trail with a live section filter.
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.SystemCenter.SystemCenterView"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="Transparent">

        <UserControl.Resources>
        <!-- Migrated ScFieldLabel to global Typography.Label -->
    </UserControl.Resources>


    <!-- ═══════════════════════════════════════════════════════════════
         MIGRATION LOG — Button Standardization (master prompt v1.0)
         Date: 2026-08-15

         Changes:
           • Deleted legacy ScPrimaryButton style (rule 5)
           • 3 CTA/refresh buttons -> PrimaryPillButton (glyph + UPPERCASE
             content + ToolTip)
           • Users/Activity tabs -> STEP D two-button visibility pattern
           • Row toggle -> DangerButton DEACTIVATE / OutlinedPillButton
             ACTIVATE pair with Visibility triggers
           • Card headers: emoji badge boxes -> inline MDL2 icon + title
           • Emojis removed: 🛠 👥 📜 ➕ 🔁  ↻ 👤 🕓
           • ToolTips added to every migrated button

         All commands, bindings, and code-behind wiring preserved.
         No ViewModel changes required.
    ═══════════════════════════════════════════════════════════════ -->
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ HEADER ═════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets"
                           FontSize="{StaticResource TextTitle}" VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="{DynamicResource Module.SystemCenter}"
                           FontSize="{StaticResource TextTitleLarge}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>
            <TextBlock FontSize="{StaticResource TextBody}" Margin="0,3,0,0"
                       Foreground="{DynamicResource SecondaryForegroundBrush}">
                <Run Text="{DynamicResource SystemCenter.UserManagementAuditTrailSigned}"/>
                <Run Text="{Binding CurrentUserDisplay, Mode=OneWay}"
                     FontWeight="Bold"/>
            </TextBlock>
        </StackPanel>

        <!-- ══ TAB STRIP ══════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Style="{StaticResource ModuleTabStripStyle}"
                Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">

                <!-- TAB Users — STEP D two-button visibility pattern -->
                <Button Command="{Binding SwitchTabCommand}"
                        CommandParameter="Users"
                        Tag="&#xE716;" Content="{DynamicResource SystemCenter.Users}"
                        ToolTip="{DynamicResource SystemCenter.ManageUsers}" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource OutlinedPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUsersTab}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding SwitchTabCommand}"
                        CommandParameter="Users"
                        Tag="&#xE716;" Content="{DynamicResource SystemCenter.Users}"
                        ToolTip="{DynamicResource SystemCenter.ManageUsers}" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUsersTab}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- TAB Activity — STEP D two-button visibility pattern -->
                <Button Command="{Binding SwitchTabCommand}"
                        CommandParameter="Activity"
                        Tag="&#xE81C;" Content="{DynamicResource SystemCenter.ActivityLOG}"
                        ToolTip="{DynamicResource SystemCenter.AuditTrailRecordedAction}"
                        Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource OutlinedPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActivityTab}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding SwitchTabCommand}"
                        CommandParameter="Activity"
                        Tag="&#xE81C;" Content="{DynamicResource SystemCenter.ActivityLOG}"
                        ToolTip="{DynamicResource SystemCenter.AuditTrailRecordedAction}"
                        Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActivityTab}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- ══ USERS TAB ══════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUsersTab}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: create user + switch user + online network.
                 2026-09-10 FIX: this column used to be a bare StackPanel —
                 on laptop heights the ONLINE NETWORK (nearby connected PC
                 users) card fell below the viewport with no way to reach
                 it. Cards are compacted AND the column now scrolls. -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False"
                          Margin="0,0,16,0">
            <StackPanel Margin="0">

                <Border Background="{DynamicResource SurfaceSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="14,12">
                    <StackPanel>
<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="&#xE710;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource TextTitle}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource SystemCenter.CreateUSER}"
                                       FontSize="{StaticResource TextSubhead}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="{DynamicResource Login.Username}" Style="{StaticResource Typography.Label}"/>
                        <TextBox Style="{StaticResource ScTextBox}"
                                 Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="{DynamicResource Login.DisplayNAME}" Style="{StaticResource Typography.Label}"
                                   Margin="0,8,0,4"/>
                        <TextBox Style="{StaticResource ScTextBox}"
                                 Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="{DynamicResource SystemCenter.ROLE}" Style="{StaticResource Typography.Label}"
                                   Margin="0,8,0,4"/>
                        <ComboBox ItemsSource="{Binding RoleOptions}"
                                  SelectedItem="{Binding SelectedRole}"
                                  Padding="10,7"
                                  FontSize="{StaticResource TextBodyLarge}"/>

                        <TextBlock Text="{DynamicResource Login.Password}" Style="{StaticResource Typography.Label}"
                                   Margin="0,8,0,4"/>
                        <PasswordBox x:Name="NewPasswordBox"
                                     Padding="10,6"
                                     FontSize="{StaticResource TextBodyLarge}"
                                     Background="{DynamicResource SurfaceTertiaryBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderThickness="{DynamicResource Border.NoneThickness}"
                                     PasswordChanged="NewPasswordBox_PasswordChanged"/>

                        <Button Style="{StaticResource PrimaryPillButton}"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch"
                                Tag="&#xE710;" Content="{DynamicResource SystemCenter.CreateUSER}"
                                ToolTip="{DynamicResource SystemCenter.CreateNewUserAccount}"
                                Command="{Binding CreateUserCommand}"/>

                        <TextBlock Text="{Binding UserFormMessage}"
                                   FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="14,12"
                        Margin="0,12,0,0">
                    <StackPanel>
<StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="&#xE895;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource TextTitle}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource SystemCenter.SwitchActiveUser}"
                                       FontSize="{StaticResource TextSubhead}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource SystemCenter.FutureActionsRecordedActiveUser}"
                                   FontSize="{StaticResource TextBody}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="{DynamicResource Login.Username}" Style="{StaticResource Typography.Label}"/>
                        <TextBox Style="{StaticResource ScTextBox}"
                                 Text="{Binding SwitchUsername, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="{DynamicResource Login.Password}" Style="{StaticResource Typography.Label}"
                                   Margin="0,8,0,4"/>
                        <PasswordBox x:Name="SwitchPasswordBox"
                                     Padding="10,6"
                                     FontSize="{StaticResource TextBodyLarge}"
                                     Background="{DynamicResource SurfaceTertiaryBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderThickness="{DynamicResource Border.NoneThickness}"
                                     PasswordChanged="SwitchPasswordBox_PasswordChanged"/>

                        <Button Style="{StaticResource PrimaryPillButton}"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch"
                                Tag="&#xE895;" Content="{DynamicResource Login.SwitchUser}"
                                ToolTip="{DynamicResource SystemCenter.SignUser}"
                                Command="{Binding SwitchUserCommand}"/>

                        <TextBlock Text="{Binding SwitchMessage}"
                                   FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Same-network presence -->
                <Border Background="{DynamicResource SurfaceSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="14,12"
                        Margin="0,12,0,4">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="&#xE839;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource TextSubhead}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource SystemCenter.OnlineNetwork}"
                                       FontSize="{StaticResource TextSection}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource SystemCenter.ColleaguesRunningProglassLANAppearHere}"
                                   FontSize="{StaticResource TextBody}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,0,0,10"/>

                        <!-- Empty state -->
                        <TextBlock Text="{DynamicResource SystemCenter.NoOtherUsersDetectedRightNow}"
                                   FontSize="{StaticResource TextBody}" FontStyle="Italic">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextTertiaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPeers}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding OnlinePeers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Padding="8,5" Margin="0,0,0,4"
                                            Background="{DynamicResource SurfaceTertiaryBrush}"
                                            CornerRadius="{DynamicResource ControlCornerRadius}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0"
                                                     Width="8" Height="8"
                                                     Fill="{DynamicResource SuccessBrush}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,9,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock FontSize="{StaticResource TextCaption}" Margin="0,1,0,0"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}">
                                                    <Run Text="{Binding Username, Mode=OneWay}"/>
                                                    <Run Text="  •  "/>
                                                    <Run Text="{Binding MachineName, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>

            <!-- RIGHT: user table -->
            <Border Grid.Column="1"
                    Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Column heading strip (v2 table reference) -->
                    <Border CornerRadius="{DynamicResource CardCornerRadius}" Grid.Row="0"
                            Background="{DynamicResource AccentBrush}"
                            Padding="16,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource SystemCenter.USER}" Style="{StaticResource ModuleColumnHeaderStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource SystemCenter.ROLEPermissions}"
                                       Margin="12,0,0,0" Style="{StaticResource ModuleColumnHeaderStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource Common.Status}"
                                       HorizontalAlignment="Center" Style="{StaticResource ModuleColumnHeaderStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Grid.Column="3" Text="{DynamicResource Shared.Action}"
                                       HorizontalAlignment="Center" Style="{StaticResource ModuleColumnHeaderStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              CanContentScroll="True"
                              behaviors:SmoothScrollBehavior.IsEnabled="True">
                    <ItemsControl ItemsSource="{Binding Users}" Margin="6"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,10" Margin="0,4"
                                        Background="{DynamicResource SurfaceSecondaryBrush}"
                                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                                        BorderThickness="{DynamicResource CardBorderThickness}"
                                        CornerRadius="{DynamicResource ControlCornerRadius}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="38" Height="38"
                                                CornerRadius="{DynamicResource CardCornerRadius}"
                                                Background="{DynamicResource TintIndigoBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="&#xE77B;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="{StaticResource TextTitle}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Margin="12,0"
                                                    VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="{StaticResource TextBodyLarge}" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Background="{DynamicResource TintGreenBrush}"
                                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                                        Padding="6,1"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{DynamicResource SystemCenter.ActiveNOW}"
                                                               FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                               Foreground="{DynamicResource SuccessBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="{StaticResource TextBody}" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}">
                                                <Run Text="{Binding Username, Mode=OneWay}"/>
                                                <Run Text="  •  "/>
                                                <Run Text="{Binding RoleBadge, Mode=OneWay}"/>
                                                <Run Text="  •  "/>
                                                <Run Text="{Binding PermissionCount, Mode=OneWay}"/>
                                                <Run Text="{DynamicResource SystemCenter.Since}"/>
                                                <Run Text="{Binding CreatedDisplay, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                                   Margin="0,0,10,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="ENABLED"/>
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Text" Value="DISABLED"/>
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource TextTertiaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Button Grid.Column="3"
                                                Tag="&#xE74D;" Content="{DynamicResource SystemCenter.Deactivate}"
                                                ToolTip="{DynamicResource SystemCenter.DisableUserAccount}"
                                                MinWidth="92"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.ToggleActiveCommand,
                                                            RelativeSource={RelativeSource
                                                                AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Grid.Column="3"
                                                Tag="&#xE73E;" Content="{DynamicResource SystemCenter.Activate}"
                                                ToolTip="{DynamicResource SystemCenter.ReEnableUserAccount}"
                                                MinWidth="92"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.ToggleActiveCommand,
                                                            RelativeSource={RelativeSource
                                                                AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource OutlinedPillButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ══ ACTIVITY TAB ═══════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActivityTab}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 2026-09-10: ACTION-FOCUSED toolbar — scope chips +
                 important-only + search replace the flat section combo.
                 The DB still records everything; this only narrows the
                 surfaced view (All = full compliance trail). -->
            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">

                    <!-- Scope chips: STEP D two-button pattern -->
                    <Button Command="{Binding SetScopeCommand}" CommandParameter="All"
                            Tag="&#xE81C;" Content="{DynamicResource SystemCenter.ScopeAll}"
                            ToolTip="{DynamicResource SystemCenter.ScopeAllTooltip}" Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlinedPillButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScopeAll}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button IsHitTestVisible="False" Focusable="False"
                            Tag="&#xE81C;" Content="{DynamicResource SystemCenter.ScopeAll}"
                            Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScopeAll}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Command="{Binding SetScopeCommand}" CommandParameter="Transactions"
                            Tag="&#xE8A5;" Content="{DynamicResource SystemCenter.ScopeTransactions}"
                            ToolTip="{DynamicResource SystemCenter.ScopeTransactionsTooltip}" Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlinedPillButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScopeTransactions}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button IsHitTestVisible="False" Focusable="False"
                            Tag="&#xE8A5;" Content="{DynamicResource SystemCenter.ScopeTransactions}"
                            Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScopeTransactions}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Command="{Binding SetScopeCommand}" CommandParameter="Inventory"
                            Tag="&#xE719;" Content="{DynamicResource SystemCenter.ScopeInventory}"
                            ToolTip="{DynamicResource SystemCenter.ScopeInventoryTooltip}" Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlinedPillButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScopeInventory}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button IsHitTestVisible="False" Focusable="False"
                            Tag="&#xE719;" Content="{DynamicResource SystemCenter.ScopeInventory}"
                            Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScopeInventory}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Command="{Binding SetScopeCommand}" CommandParameter="UsersSecurity"
                            Tag="&#xE195;" Content="{DynamicResource SystemCenter.ScopeUsersSecurity}"
                            ToolTip="{DynamicResource SystemCenter.ScopeUsersSecurityTooltip}" Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlinedPillButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScopeUsersSecurity}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button IsHitTestVisible="False" Focusable="False"
                            Tag="&#xE195;" Content="{DynamicResource SystemCenter.ScopeUsersSecurity}"
                            Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScopeUsersSecurity}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Command="{Binding SetScopeCommand}" CommandParameter="System"
                            Tag="&#xE7F8;" Content="{DynamicResource SystemCenter.ScopeSystem}"
                            ToolTip="{DynamicResource SystemCenter.ScopeSystemTooltip}" Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlinedPillButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScopeSystem}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button IsHitTestVisible="False" Focusable="False"
                            Tag="&#xE7F8;" Content="{DynamicResource SystemCenter.ScopeSystem}"
                            Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScopeSystem}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Important-actions-only -->
                    <TextBlock Text="{DynamicResource SystemCenter.ImportantActionsOnly}"
                               FontSize="{StaticResource TextBody}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               VerticalAlignment="Center" Margin="6,0,8,0"/>
                    <ToggleButton Style="{StaticResource PiToggleSwitch}"
                                  IsChecked="{Binding ImportantOnly}"
                                  VerticalAlignment="Center" Margin="0,0,14,0"
                                  AutomationProperties.Name="Important actions only"
                                  ToolTip="{DynamicResource SystemCenter.ImportantActionsOnlyTooltip}"/>

                    <!-- Search -->
                    <TextBox Style="{StaticResource ScTextBox}"
                             Text="{Binding ActivitySearch, UpdateSourceTrigger=PropertyChanged}"
                             Width="220" VerticalAlignment="Center"
                             AutomationProperties.Name="Search activity"
                             ToolTip="{DynamicResource SystemCenter.SearchActionsTooltip}"/>

                    <Button Style="{StaticResource PrimaryPillButton}"
                            Margin="10,0,0,0"
                            Tag="&#xE72C;" Content="{DynamicResource Action.Refresh}"
                            ToolTip="{DynamicResource SystemCenter.ReloadActivityLog}"
                            Command="{Binding RefreshActivityCommand}"/>
                </StackPanel>

                <TextBlock Text="{Binding ActivityCountDisplay}"
                           FontSize="{StaticResource TextCaption}"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="2,6,0,0"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Column heading strip (v2 table reference) -->
                    <Border CornerRadius="{DynamicResource CardCornerRadius}" Grid.Row="0"
                            Background="{DynamicResource AccentBrush}"
                            Padding="16,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Diagnostics.TIME}" Style="{StaticResource ModuleColumnHeaderStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource SystemCenter.Section}" Style="{StaticResource ModuleColumnHeaderStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource Shared.Action}"
                                       Margin="10,0,0,0" Style="{StaticResource ModuleColumnHeaderStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Grid.Column="3" Text="{DynamicResource Shared.Details}"
                                       Margin="10,0,0,0" Style="{StaticResource ModuleColumnHeaderStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        </Grid>
                    </Border>
                    <!-- Empty state -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActivityEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="{StaticResource TextDisplayLarge}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   Opacity="0.6"/>
                        <TextBlock Text="{DynamicResource Shared.NoActivityRecordedYet}"
                                   FontSize="{StaticResource TextSection}" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,3"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource SystemCenter.ActionSectionRecordedHereAutomatically}"
                                   FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>

                    <!-- Virtualized activity feed -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  CanContentScroll="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                        <ItemsControl ItemsSource="{Binding ActivityRows}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="{DynamicResource CardCornerRadius}" Padding="16,10"
                                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                                            BorderThickness="{DynamicResource Border.BottomHairlineThickness}"
                                            ToolTip="{Binding RowTooltip}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding TimeDisplay}"
                                                       FontSize="{StaticResource TextBody}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>

                                            <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Grid.Column="1"
                                                    Background="{DynamicResource TintBlueBrush}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Section}"
                                                           FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource InfoBrush}"/>
                                            </Border>

                                            <TextBlock Grid.Column="2"
                                                       Margin="10,0"
                                                       Text="{Binding Action}"
                                                       FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Details}"
                                                       FontSize="{StaticResource TextBody}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Details}"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
