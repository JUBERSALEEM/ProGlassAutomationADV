<pgp:ProductionStagePageBase x:Class="ProGlassAutomation.Views.Production.PairingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pgp="clr-namespace:ProGlassAutomation.Views.Production"
             xmlns:production="clr-namespace:ProGlassAutomation.Views.Production.Controls"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             Background="{DynamicResource SurfaceWorkspaceBrush}">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource OptHeroCard}" Margin="24,16,24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="12"
                        Background="{DynamicResource ThemeNavigationHoverBrush}" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="{Binding Icon}" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="22"
                               Foreground="{DynamicResource ThemeNavigationSelectedForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ModuleName}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeNavigationSelectedForegroundBrush}"/>
                        <Border CornerRadius="8" Background="{DynamicResource ThemeNavigationHoverBrush}"
                                Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StageOrdinalLabel}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource ThemeNavigationSelectedForegroundBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" FontSize="12"
                               Foreground="{DynamicResource ThemeNavigationSelectedForegroundBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding StationWorkOrderHint}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource ThemeNavigationSelectedForegroundBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
        <production:ProductionPipelineBar Grid.Row="1"/>
        <production:ProductionReleaseBar Grid.Row="2"/>
        <production:ProductionStationBody Grid.Row="3"/>
    </Grid>
</pgp:ProductionStagePageBase>
