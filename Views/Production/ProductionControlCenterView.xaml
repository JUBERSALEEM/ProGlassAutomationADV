<UserControl x:Class="ProGlassAutomation.Views.Production.ProductionControlCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             mc:Ignorable="d"
             FontFamily="{DynamicResource AppFontFamily}"
             Background="{DynamicResource Surface.Primary.BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <!-- P3 redesign: one column of flat crystal cards. The old right-hand
             scroll stack of six fixed-height grids became a tabbed analytics
             card; the shouting titles became plain card names; every binding
             and command is preserved (IsActive column removed — the model
             has no such member). -->
        <Style x:Key="PccFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSize.BodySmall}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <!-- SCROLL FIX (2026-09-17 owner report: "mouse scrolling not working,
         not smoothly, full page is not visible"). Two defects, both
         fixed with the app's own established behaviors:
         1. this page scroller had NO SmoothScrollBehavior, so the wheel
            fell back to WPF's logical (item-based) scrolling of the
            StackPanel — one whole CARD per notch, which reads as a jump
            and makes the bottom of the page feel unreachable. 54 other
            scrollers in this app already set it: 120 px per notch,
            immediate, zero per-frame work.
         2. the DataGrids below swallowed the wheel — see the
            SmartScrollBubblingBehavior on each of them. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly"
                  behaviors:SmoothScrollBehavior.IsEnabled="True">
        <StackPanel Margin="24,20,24,16">

            <!-- Header -->
            <Border Padding="16" CornerRadius="{DynamicResource CardCornerRadius}" Margin="0,0,0,12"
                    Background="{DynamicResource SurfacePrimaryBrush}" Style="{StaticResource SurfacePrimaryStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSize.TitleLarge}"
                                   FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource FontSize.BodySmall}"
                                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding KpiSummary}" FontSize="{DynamicResource FontSize.BodySmall}"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   FontWeight="{DynamicResource Weight.SemiBold}"/>
                        <TextBlock Text="{Binding OverallProgress.Label, FallbackValue=Overall 0%}"
                                   FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource SuccessBrush}"
                                   Margin="0,4,0,0" FontWeight="{DynamicResource Weight.Bold}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="Load / Refresh" Command="{Binding LoadCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="16,6" Margin="0,0,8,0"/>
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Filters: uniform labelled field grid -->
            <Border Padding="12" CornerRadius="{DynamicResource CardCornerRadius}" Margin="0,0,0,12"
                    Background="{DynamicResource SurfaceSecondaryBrush}" Style="{StaticResource SurfaceSecondaryStyle}">
                <UniformGrid Columns="6">
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Job Ref" Style="{StaticResource PccFieldLabel}"/>
                        <TextBox Text="{Binding JobFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SurfaceTextBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Customer" Style="{StaticResource PccFieldLabel}"/>
                        <TextBox Text="{Binding CustomerFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SurfaceTextBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Search" Style="{StaticResource PccFieldLabel}"/>
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SurfaceTextBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Process" Style="{StaticResource PccFieldLabel}"/>
                        <ComboBox ItemsSource="{Binding ProcessOptions}" SelectedItem="{Binding ProcessFilter}" Style="{StaticResource SurfaceComboBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Readiness" Style="{StaticResource PccFieldLabel}"/>
                        <ComboBox ItemsSource="{Binding ReadinessOptions}" SelectedItem="{Binding ReadinessFilter}" Style="{StaticResource SurfaceComboBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Priority" Style="{StaticResource PccFieldLabel}"/>
                        <ComboBox ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding PriorityFilter}" Style="{StaticResource SurfaceComboBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Due Risk" Style="{StaticResource PccFieldLabel}"/>
                        <ComboBox ItemsSource="{Binding DueRiskOptions}" SelectedItem="{Binding DueRiskFilter}" Style="{StaticResource SurfaceComboBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Operator" Style="{StaticResource PccFieldLabel}"/>
                        <TextBox Text="{Binding OperatorInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SurfaceTextBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Workstation" Style="{StaticResource PccFieldLabel}"/>
                        <TextBox Text="{Binding WorkstationInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SurfaceTextBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Hold Reason" Style="{StaticResource PccFieldLabel}"/>
                        <ComboBox ItemsSource="{Binding HoldReasonOptions}" SelectedItem="{Binding HoldReasonInput}" Style="{StaticResource SurfaceComboBox}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Priority Set" Style="{StaticResource PccFieldLabel}"/>
                        <ComboBox ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding PriorityInput}" Style="{StaticResource SurfaceComboBox}"/>
                    </StackPanel>
                </UniformGrid>
            </Border>

            <!-- Action chips -->
            <Border Padding="10" CornerRadius="{DynamicResource CardCornerRadius}" Margin="0,0,0,12"
                    Background="{DynamicResource SurfaceSecondaryBrush}" Style="{StaticResource SurfaceSecondaryStyle}">
                <WrapPanel Orientation="Horizontal">
                    <Button Content="Start" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="12,4" Margin="0,0,6,4"/>
                    <Button Content="Pause" Command="{Binding PauseCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" Margin="0,0,6,4"/>
                    <Button Content="Resume" Command="{Binding ResumeCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" Margin="0,0,6,4"/>
                    <Button Content="Complete" Command="{Binding CompleteCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="12,4" Margin="0,0,6,4"/>
                    <Button Content="Hold" Command="{Binding HoldCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" Margin="0,0,6,4"/>
                    <Button Content="Release Hold" Command="{Binding ReleaseHoldCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" Margin="0,0,6,4"/>
                    <Button Content="Assign WS/Operator" Command="{Binding AssignCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="12,4" Margin="0,0,6,4"/>
                    <Button Content="Unassign" Command="{Binding UnassignCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" Margin="0,0,6,4"/>
                    <Button Content="Set Priority" Command="{Binding SetPriorityCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" Margin="0,0,0,4"/>
                </WrapPanel>
            </Border>

            <!-- Production queue: the one master table -->
            <Border Padding="12" CornerRadius="{DynamicResource CardCornerRadius}" Margin="0,0,0,12"
                    Background="{DynamicResource SurfacePrimaryBrush}" Style="{StaticResource SurfacePrimaryStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="340"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Production Queue" Style="{StaticResource ModulePageTitleStyle}" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Queue}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              CanUserResizeColumns="False" CanUserReorderColumns="False"
                              Style="{StaticResource SurfaceDataGrid}" VerticalScrollBarVisibility="Auto"
                              behaviors:SmartScrollBubblingBehavior.IsEnabled="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Job Ref" Binding="{Binding JobRef}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="Spec" Binding="{Binding SpecName}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="Process" Binding="{Binding StageLabel}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="Readiness" Binding="{Binding Readiness}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            <DataGridTextColumn Header="Due Risk" Binding="{Binding DueRisk}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            <DataGridTextColumn Header="Due" Binding="{Binding DueDate, StringFormat=yyyy-MM-dd}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            <DataGridTextColumn Header="Done" Binding="{Binding QtyDone}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            <DataGridTextColumn Header="Rem" Binding="{Binding Remaining}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            <DataGridTextColumn Header="Operator" Binding="{Binding Operator}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="QC" Binding="{Binding QcResult}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Ready / blocked / QC mini queues, equal thirds -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Padding="12" CornerRadius="{DynamicResource CardCornerRadius}" Margin="0,0,8,0"
                        Background="{DynamicResource SurfacePrimaryBrush}" Style="{StaticResource SurfacePrimaryStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="150"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Ready to run" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,0,6"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding ExecutableQueue}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" IsReadOnly="True"
                                  CanUserResizeColumns="False" CanUserReorderColumns="False" Style="{StaticResource SurfaceDataGrid}"
                              behaviors:SmartScrollBubblingBehavior.IsEnabled="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Job" Binding="{Binding JobRef}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Process" Binding="{Binding StageLabel}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="Due" Binding="{Binding DueDate, StringFormat=MM-dd}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Padding="12" CornerRadius="{DynamicResource CardCornerRadius}" Margin="4,0,4,0"
                        Background="{DynamicResource SurfacePrimaryBrush}" Style="{StaticResource SurfacePrimaryStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="150"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Blocked" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,0,6"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding BlockedQueue}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" IsReadOnly="True"
                                  CanUserResizeColumns="False" CanUserReorderColumns="False" Style="{StaticResource SurfaceDataGrid}"
                              behaviors:SmartScrollBubblingBehavior.IsEnabled="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Job" Binding="{Binding JobRef}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Reason" Binding="{Binding BlockReason}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Padding="12" CornerRadius="{DynamicResource CardCornerRadius}" Margin="8,0,0,0"
                        Background="{DynamicResource SurfacePrimaryBrush}" Style="{StaticResource SurfacePrimaryStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="150"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="QC pending / failed" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,0,6"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding QcQueue}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" IsReadOnly="True"
                                  CanUserResizeColumns="False" CanUserReorderColumns="False" Style="{StaticResource SurfaceDataGrid}"
                              behaviors:SmartScrollBubblingBehavior.IsEnabled="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Job" Binding="{Binding JobRef}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Stage" Binding="{Binding StageLabel}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="QC" Binding="{Binding QcResult}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Selected item detail -->
            <Border Padding="12" CornerRadius="{DynamicResource CardCornerRadius}" Margin="0,0,0,12"
                    Background="{DynamicResource SurfaceSecondaryBrush}" Style="{StaticResource SurfaceSecondaryStyle}">
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,12,6">
                        <TextBlock Text="Selected work item" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding DetailLabel}" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.BodySmall}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,6">
                        <TextBlock Text="Traceability" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TraceabilityLabel}" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Material" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding MaterialLabel}" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource WarningBrush}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="QC" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding QcLabel}" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.BodySmall}"/>
                    </StackPanel>
                </UniformGrid>
            </Border>

            <!-- Analytics: one tabbed card instead of six stacked grids -->
            <Border Padding="12" CornerRadius="{DynamicResource CardCornerRadius}" Margin="0,0,0,12"
                    Background="{DynamicResource SurfacePrimaryBrush}" Style="{StaticResource SurfacePrimaryStyle}">
                <TabControl Background="Transparent" BorderThickness="0" Padding="0">
                    <TabItem Header="Job progress">
                        <DataGrid ItemsSource="{Binding JobProgress}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" CanUserResizeColumns="False" CanUserReorderColumns="False"
                                  Style="{StaticResource SurfaceDataGrid}" Height="220" Margin="0,8,0,0"
                              behaviors:SmartScrollBubblingBehavior.IsEnabled="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Job Ref" Binding="{Binding JobRef}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Req" Binding="{Binding Required}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="Done" Binding="{Binding Completed}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="Rem" Binding="{Binding Remaining}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="Prog %" Binding="{Binding ProgressPct}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="Blocked" Binding="{Binding Blocked}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Process progress">
                        <DataGrid ItemsSource="{Binding ProcessProgress}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" CanUserResizeColumns="False" CanUserReorderColumns="False"
                                  Style="{StaticResource SurfaceDataGrid}" Height="220" Margin="0,8,0,0"
                              behaviors:SmartScrollBubblingBehavior.IsEnabled="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Process" Binding="{Binding SpecName}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Req" Binding="{Binding Required}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="Done" Binding="{Binding Completed}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="Prog %" Binding="{Binding ProgressPct}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Queue pressure">
                        <DataGrid ItemsSource="{Binding QueuePressure}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" CanUserResizeColumns="False" CanUserReorderColumns="False"
                                  Style="{StaticResource SurfaceDataGrid}" Height="220" Margin="0,8,0,0"
                              behaviors:SmartScrollBubblingBehavior.IsEnabled="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Ready" Binding="{Binding ReadyQueue}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="Blocked" Binding="{Binding BlockedQueue}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="Pressure" Binding="{Binding PressureLabel}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Avg wait h" Binding="{Binding AvgWaitHours}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Workstation load">
                        <DataGrid ItemsSource="{Binding WorkstationLoad}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" CanUserResizeColumns="False" CanUserReorderColumns="False"
                                  Style="{StaticResource SurfaceDataGrid}" Height="220" Margin="0,8,0,0"
                              behaviors:SmartScrollBubblingBehavior.IsEnabled="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Assigned" Binding="{Binding AssignedCount}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="Ready" Binding="{Binding ReadyCount}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="In prog" Binding="{Binding InProgressCount}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Workstations">
                        <DataGrid ItemsSource="{Binding Workstations}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" CanUserResizeColumns="False" CanUserReorderColumns="False"
                                  Style="{StaticResource SurfaceDataGrid}" Height="220" Margin="0,8,0,0"
                              behaviors:SmartScrollBubblingBehavior.IsEnabled="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding WorkstationId}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Rework">
                        <DataGrid ItemsSource="{Binding ReworkQueue}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" CanUserResizeColumns="False" CanUserReorderColumns="False"
                                  Style="{StaticResource SurfaceDataGrid}" Height="220" Margin="0,8,0,0"
                              behaviors:SmartScrollBubblingBehavior.IsEnabled="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Job" Binding="{Binding JobRef}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Piece" Binding="{Binding Position}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="Stage" Binding="{Binding StageLabel}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Block" Binding="{Binding BlockReason}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Progress -->
            <Border Padding="10" CornerRadius="{DynamicResource CardCornerRadius}"
                    Background="{DynamicResource SurfaceElevatedBrush}" Style="{StaticResource SurfaceElevatedStyle}"
                    Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding ProgressLabel}" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.BodySmall}"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
