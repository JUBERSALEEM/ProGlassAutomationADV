<UserControl x:Class="ProGlassAutomation.Views.Production.ProductionControlCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="{DynamicResource AppFontFamily}"
             Background="{DynamicResource Surface.Primary.BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource SurfacePrimaryStyle}" Padding="16" CornerRadius="{DynamicResource ControlCornerRadius}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSize.TitleLarge}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding KpiSummary}" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="{DynamicResource Weight.SemiBold}"/>
                    <TextBlock Text="{Binding OverallProgress.Label, FallbackValue=Overall 0%}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0" FontWeight="{DynamicResource Weight.Bold}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Load / Refresh" Command="{Binding LoadCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="16,6" Margin="0,0,8,0"/>
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource SurfaceSecondaryStyle}" Padding="12" CornerRadius="{DynamicResource ControlCornerRadius}" Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,12,8" MinWidth="140">
                    <TextBlock Text="JobRef" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding JobFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SurfaceTextBox}" Width="140" Padding="8,6"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8" MinWidth="140">
                    <TextBlock Text="Customer" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding CustomerFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SurfaceTextBox}" Width="140" Padding="8,6"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8" MinWidth="140">
                    <TextBlock Text="Search" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SurfaceTextBox}" Width="160" Padding="8,6"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8" MinWidth="120">
                    <TextBlock Text="Process" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding ProcessOptions}" SelectedItem="{Binding ProcessFilter}" Style="{StaticResource SurfaceComboBox}" Width="120"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8" MinWidth="120">
                    <TextBlock Text="Readiness" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding ReadinessOptions}" SelectedItem="{Binding ReadinessFilter}" Style="{StaticResource SurfaceComboBox}" Width="120"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8" MinWidth="100">
                    <TextBlock Text="Priority" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding PriorityFilter}" Style="{StaticResource SurfaceComboBox}" Width="100"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8" MinWidth="100">
                    <TextBlock Text="Due Risk" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding DueRiskOptions}" SelectedItem="{Binding DueRiskFilter}" Style="{StaticResource SurfaceComboBox}" Width="100"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8" MinWidth="140">
                    <TextBlock Text="Operator" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding OperatorInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SurfaceTextBox}" Width="140" Padding="8,6"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8" MinWidth="140">
                    <TextBlock Text="Workstation" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding WorkstationInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SurfaceTextBox}" Width="140" Padding="8,6"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8" MinWidth="140">
                    <TextBlock Text="Hold Reason" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding HoldReasonOptions}" SelectedItem="{Binding HoldReasonInput}" Style="{StaticResource SurfaceComboBox}" Width="160"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8" MinWidth="100">
                    <TextBlock Text="Priority Set" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding PriorityInput}" Style="{StaticResource SurfaceComboBox}" Width="100"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Actions -->
        <Border Grid.Row="2" Style="{StaticResource SurfaceSecondaryStyle}" Padding="8" CornerRadius="{DynamicResource ControlCornerRadius}" Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal">
                <Button Content="Start" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="12,4" Margin="0,0,6,4"/>
                <Button Content="Pause" Command="{Binding PauseCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" Margin="0,0,6,4"/>
                <Button Content="Resume" Command="{Binding ResumeCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" Margin="0,0,6,4"/>
                <Button Content="Complete" Command="{Binding CompleteCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="12,4" Margin="0,0,6,4"/>
                <Button Content="Hold" Command="{Binding HoldCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" Margin="0,0,6,4"/>
                <Button Content="Release Hold" Command="{Binding ReleaseHoldCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" Margin="0,0,6,4"/>
                <Button Content="Assign WS/Operator" Command="{Binding AssignCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="12,4" Margin="0,0,6,4"/>
                <Button Content="Unassign" Command="{Binding UnassignCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" Margin="0,0,6,4"/>
                <Button Content="Set Priority" Command="{Binding SetPriorityCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,4" Margin="0,0,6,4"/>
            </WrapPanel>
        </Border>

        <!-- Main Queue + Side panels -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Queue DataGrid -->
            <Border Grid.Column="0" Style="{StaticResource SurfaceSecondaryStyle}" Padding="8" CornerRadius="{DynamicResource ControlCornerRadius}" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Production Queue — Ready state, Urgency, Due date, Priority, Process seq, JobRef, Piece identity deterministic" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Queue}" SelectedItem="{Binding Selected, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Style="{StaticResource SurfaceDataGrid}" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="JobRef" Binding="{Binding JobRef}" Width="80" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="90" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="Spec" Binding="{Binding SpecName}" Width="95" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="Piece" Binding="{Binding Position}" Width="50" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            <DataGridTextColumn Header="Process" Binding="{Binding StageLabel}" Width="85" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="Readiness" Binding="{Binding Readiness}" Width="80" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            <DataGridTextColumn Header="Block Reason" Binding="{Binding BlockReason}" Width="105" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="50" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            <DataGridTextColumn Header="Due Risk" Binding="{Binding DueRisk}" Width="60" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat=yyyy-MM-dd}" Width="70" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="40" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            <DataGridTextColumn Header="Done" Binding="{Binding QtyDone}" Width="40" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            <DataGridTextColumn Header="Rem" Binding="{Binding Remaining}" Width="40" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            <DataGridTextColumn Header="Operator" Binding="{Binding Operator}" Width="70" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="WS" Binding="{Binding WorkstationId}" Width="65" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="QC" Binding="{Binding QcResult}" Width="40" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Executable Queue — Ready" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,0,4"/>
                            <DataGrid ItemsSource="{Binding ExecutableQueue}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Style="{StaticResource SurfaceDataGrid}" Height="120">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Job" Binding="{Binding JobRef}" Width="70" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                    <DataGridTextColumn Header="Process" Binding="{Binding StageLabel}" Width="156" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                    <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="60" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                    <DataGridTextColumn Header="Due" Binding="{Binding DueDate, StringFormat=MM-dd}" Width="60" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Blocked Queue — Reason explainable" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,0,4"/>
                            <DataGrid ItemsSource="{Binding BlockedQueue}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Style="{StaticResource SurfaceDataGrid}" Height="120">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Job" Binding="{Binding JobRef}" Width="70" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                    <DataGridTextColumn Header="Block Reason" Binding="{Binding BlockReason}" Width="276" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                            <TextBlock Text="QC Queue — Pending/Failed" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,0,4"/>
                            <DataGrid ItemsSource="{Binding QcQueue}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Style="{StaticResource SurfaceDataGrid}" Height="120">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Job" Binding="{Binding JobRef}" Width="70" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                    <DataGridTextColumn Header="Stage" Binding="{Binding StageLabel}" Width="226" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                    <DataGridTextColumn Header="QC" Binding="{Binding QcResult}" Width="50" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right: Detail + Progress + Pressure + Workstations -->
            <Border Grid.Column="1" Style="{StaticResource SurfaceSecondaryStyle}" Padding="8" CornerRadius="{DynamicResource ControlCornerRadius}" Margin="6,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Selected WorkItem / Traceability — Detail surface" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding DetailLabel}" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.BodySmall}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding TraceabilityLabel}" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.BodySmall}" Margin="0,0,0,8" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{Binding MaterialLabel}" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.BodySmall}" Margin="0,0,0,8" Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock Text="{Binding QcLabel}" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.BodySmall}" Margin="0,0,0,12"/>

                        <TextBlock Text="Job Progress — Required Completed InProg Blocked Paused Rework QC Pend Fail OnHold Cancelled Progress%" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,8,0,4"/>
                        <DataGrid ItemsSource="{Binding JobProgress}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Style="{StaticResource SurfaceDataGrid}" Height="140">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="JobRef" Binding="{Binding JobRef}" Width="476" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Req" Binding="{Binding Required}" Width="40" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="Done" Binding="{Binding Completed}" Width="40" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="Rem" Binding="{Binding Remaining}" Width="40" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="Prog%" Binding="{Binding ProgressPct}" Width="60" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="Blocked" Binding="{Binding Blocked}" Width="50" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Process Progress — physical pieces, work items, final assemblies appropriate metric" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,12,0,4"/>
                        <DataGrid ItemsSource="{Binding ProcessProgress}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Style="{StaticResource SurfaceDataGrid}" Height="140">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Process" Binding="{Binding SpecName}" Width="566" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Req" Binding="{Binding Required}" Width="40" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="Done" Binding="{Binding Completed}" Width="40" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="Prog%" Binding="{Binding ProgressPct}" Width="60" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Current Queue Pressure — bottleneck deterministic largest ready queue longest waiting overdue QC backlog rework" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,12,0,4"/>
                        <DataGrid ItemsSource="{Binding QueuePressure}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Style="{StaticResource SurfaceDataGrid}" Height="140">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="100" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Ready" Binding="{Binding ReadyQueue}" Width="50" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="Blocked" Binding="{Binding BlockedQueue}" Width="50" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="50" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="Pressure" Binding="{Binding PressureLabel}" Width="396" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="AvgWaitH" Binding="{Binding AvgWaitHours}" Width="60" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Workstation Workload — Process → Workstation → Assigned WorkItems CUT-01 TEMPER-01 POLISH-01 CNC-01 LAM-01 ERP-level" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,12,0,4"/>
                        <DataGrid ItemsSource="{Binding WorkstationLoad}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Style="{StaticResource SurfaceDataGrid}" Height="140">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="80" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="466" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Assigned" Binding="{Binding AssignedCount}" Width="60" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="Ready" Binding="{Binding ReadyCount}" Width="50" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="InProg" Binding="{Binding InProgressCount}" Width="50" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Workstations Master — smallest reusable" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,12,0,4"/>
                        <DataGrid ItemsSource="{Binding Workstations}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Style="{StaticResource SurfaceDataGrid}" Height="120">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding WorkstationId}" Width="80" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="496" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="80" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Active" Binding="{Binding IsActive}" Width="50" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Rework Queue — Job Piece Stage Failure reason Original execution Replacement Rework seq QC state Owner" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,12,0,4"/>
                        <DataGrid ItemsSource="{Binding ReworkQueue}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Style="{StaticResource SurfaceDataGrid}" Height="120">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Job" Binding="{Binding JobRef}" Width="80" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Piece" Binding="{Binding Position}" Width="60" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="Stage" Binding="{Binding StageLabel}" Width="80" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Block" Binding="{Binding BlockReason}" Width="486" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Progress -->
        <Border Grid.Row="4" Style="{StaticResource SurfaceElevatedStyle}" Padding="8" CornerRadius="{DynamicResource ControlCornerRadius}" Margin="0,12,0,0" Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding ProgressLabel}" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.BodySmall}"/>
        </Border>
    </Grid>
</UserControl>
