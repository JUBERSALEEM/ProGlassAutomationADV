<UserControl Style="{StaticResource ErpPageRootStyle}" x:Class="ProGlassAutomation.Views.Production.ProcessWorkCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             mc:Ignorable="d"
             FontFamily="{DynamicResource AppFontFamily}"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Dashboard/Overview/IndigoStudioResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- P3 redesign: flat crystal cards, equal-width columns, no industrial
         chrome. One page flow: header → KPI strip → filters → executions →
         lineage pair (pairings/assemblies) → traceability notes. -->
    <!-- SCROLL FIX (2026-09-17 owner report: "mouse scrolling not working,
         not smoothly, full page is not visible"). Two defects, both
         fixed with the app's own established behaviors:
         1. this page scroller had NO SmoothScrollBehavior, so the wheel
            fell back to WPF's logical (item-based) scrolling of the
            StackPanel — one whole CARD per notch, which reads as a jump
            and makes the bottom of the page feel unreachable. 54 other
            scrollers in this app already set it: 120 px per notch,
            immediate, zero per-frame work.
         2. the DataGrids below swallowed the wheel — see the
            SmartScrollBubblingBehavior on each of them. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly"
                  behaviors:SmoothScrollBehavior.IsEnabled="True">
        <StackPanel Margin="24,20,24,16">

            <!-- Header -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource OptHeroCard}" Margin="0,0,12,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource OptOnIndigo}"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                   Foreground="{StaticResource OptOnIndigoMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Load Pipeline" Command="{Binding LoadCommand}" Style="{StaticResource PrimaryPillButton}" Height="36" Padding="18,0" Margin="0,0,8,0"/>
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource OutlinedPillButton}" Height="36" Padding="14,0"/>
                    </StackPanel>
            </Grid>

            <!-- ══ 3-PILLAR STAGE SWITCH RIBBON (Left: Cutting | Center: Tempering | Right: DGU) ══ -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- TAB 1: CUTTING (LEFT) -->
                <RadioButton Grid.Column="0" GroupName="ProcessStages" Margin="0,0,8,0"
                             IsChecked="{Binding IsCuttingTab, Mode=OneWay}"
                             Command="{Binding SelectCuttingTabCommand}"
                             Style="{StaticResource OptRailTab}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8C6;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="1. CUTTING &amp; NESTING" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <!-- TAB 2: TEMPERING (CENTER) -->
                <RadioButton Grid.Column="1" GroupName="ProcessStages" Margin="4,0,4,0"
                             IsChecked="{Binding IsTemperingTab, Mode=OneWay}"
                             Command="{Binding SelectTemperingTabCommand}"
                             Style="{StaticResource OptRailTab}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE9CA;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="2. TEMPERING &amp; FURNACE" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <!-- TAB 3: DGU / INSULATION (RIGHT) -->
                <RadioButton Grid.Column="2" GroupName="ProcessStages" Margin="8,0,0,0"
                             IsChecked="{Binding IsDguTab, Mode=OneWay}"
                             Command="{Binding SelectDguTabCommand}"
                             Style="{StaticResource OptRailTab}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7B8;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="3. DGU &amp; ASSEMBLY" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </Grid>

            <!-- ══ REAL-TIME AUTO-SUM AGGREGATION METRIC CARDS ══ -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <!-- 1. TOTAL SCHEDULED -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceSecondaryBrush}"
                        BorderBrush="{StaticResource OptIndigo}" BorderThickness="1.5"
                        CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="16,12" Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource OptKpiBadge}" Background="{DynamicResource TintBlueBrush}">
                            <TextBlock Text="&#xE821;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.Icon}"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="TOTAL SCHEDULED" Style="{StaticResource OptHeader}"/>
                            <Viewbox MaxHeight="28" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding TotalScheduledPcs, StringFormat={}{0:N0} Pcs}" FontSize="{DynamicResource TextTitleLarge}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Viewbox>
                            <TextBlock Text="{Binding TotalScheduledSqm, StringFormat={}{0:N1} m²}" FontSize="{DynamicResource FontSize.Label}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. COMPLETED / DONE -->
                <Border Grid.Column="1" Background="{DynamicResource SurfaceSecondaryBrush}"
                        BorderBrush="{StaticResource OptIndigo}" BorderThickness="1.5"
                        CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="16,12" Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource OptKpiBadge}" Background="{DynamicResource TintGreenBrush}">
                            <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.Icon}"
                                       Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="COMPLETED / DONE" Style="{StaticResource OptHeader}"/>
                            <Viewbox MaxHeight="28" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding CompletedDonePcs, StringFormat={}{0:N0} Pcs}" FontSize="{DynamicResource TextTitleLarge}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                            </Viewbox>
                            <TextBlock Text="{Binding CompletedDoneSqm, StringFormat={}{0:N1} m²}" FontSize="{DynamicResource FontSize.Label}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. BALANCE PENDING -->
                <Border Grid.Column="2" Background="{DynamicResource SurfaceSecondaryBrush}"
                        BorderBrush="{StaticResource OptIndigo}" BorderThickness="1.5"
                        CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="16,12" Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource OptKpiBadge}" Background="{DynamicResource TintAmberBrush}">
                            <TextBlock Text="&#xE9D9;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.Icon}"
                                       Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="BALANCE PENDING" Style="{StaticResource OptHeader}"/>
                            <Viewbox MaxHeight="28" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding BalancePendingPcs, StringFormat={}{0:N0} Pcs}" FontSize="{DynamicResource TextTitleLarge}" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                            </Viewbox>
                            <TextBlock Text="{Binding BalancePendingSqm, StringFormat={}{0:N1} m²}" FontSize="{DynamicResource FontSize.Label}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 4. STAGE COMPLETION RATE -->
                <Border Grid.Column="3" Background="{DynamicResource SurfaceSecondaryBrush}"
                        BorderBrush="{StaticResource OptIndigo}" BorderThickness="1.5"
                        CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="STAGE COMPLETION" Style="{StaticResource OptHeader}"/>
                            <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding StageCompletionPct, Mode=OneWay}"
                                         Margin="0,8,0,0" Foreground="{DynamicResource SuccessBrush}"/>
                        </StackPanel>
                        <Viewbox MaxHeight="32" Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="{Binding StageCompletionPct, StringFormat={}{0:F1}%}"
                                       FontSize="{DynamicResource TextHeadline}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                        </Viewbox>
                    </Grid>
                </Border>
            </Grid>

            <!-- KPI strip: six equal chips -->
            <Border Padding="12" CornerRadius="{DynamicResource CardCornerRadius}"
                    Background="{DynamicResource SurfacePrimaryBrush}"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding KpiSummary}" FontSize="{DynamicResource FontSize.BodySmall}"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <UniformGrid Columns="6">
                        <Border Margin="0,0,8,0" Padding="10,6" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource SurfaceSecondaryBrush}" Style="{StaticResource SurfaceSecondaryStyle}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Pending " FontWeight="{DynamicResource Weight.SemiBold}"/><Viewbox MaxHeight="18"><TextBlock Text="{Binding PendingCount}" Foreground="{DynamicResource AccentBrush}" FontWeight="{DynamicResource Weight.Bold}"/></Viewbox></StackPanel>
                        </Border>
                        <Border Margin="0,0,8,0" Padding="10,6" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource SurfaceSecondaryBrush}" Style="{StaticResource SurfaceSecondaryStyle}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="In Progress " FontWeight="{DynamicResource Weight.SemiBold}"/><Viewbox MaxHeight="18"><TextBlock Text="{Binding InProgressCount}" Foreground="{DynamicResource InfoBrush}" FontWeight="{DynamicResource Weight.Bold}"/></Viewbox></StackPanel>
                        </Border>
                        <Border Margin="0,0,8,0" Padding="10,6" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource SurfaceSecondaryBrush}" Style="{StaticResource SurfaceSecondaryStyle}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Completed " FontWeight="{DynamicResource Weight.SemiBold}"/><Viewbox MaxHeight="18"><TextBlock Text="{Binding CompletedCount}" Foreground="{DynamicResource SuccessBrush}" FontWeight="{DynamicResource Weight.Bold}"/></Viewbox></StackPanel>
                        </Border>
                        <Border Margin="0,0,8,0" Padding="10,6" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource SurfaceSecondaryBrush}" Style="{StaticResource SurfaceSecondaryStyle}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Rework " FontWeight="{DynamicResource Weight.SemiBold}"/><Viewbox MaxHeight="18"><TextBlock Text="{Binding ReworkCount}" Foreground="{DynamicResource WarningBrush}" FontWeight="{DynamicResource Weight.Bold}"/></Viewbox></StackPanel>
                        </Border>
                        <Border Margin="0,0,8,0" Padding="10,6" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource SurfaceSecondaryBrush}" Style="{StaticResource SurfaceSecondaryStyle}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="QC Pending " FontWeight="{DynamicResource Weight.SemiBold}"/><Viewbox MaxHeight="18"><TextBlock Text="{Binding QcPendingCount}" Foreground="{DynamicResource WarningBrush}" FontWeight="{DynamicResource Weight.Bold}"/></Viewbox></StackPanel>
                        </Border>
                        <Border Padding="10,6" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource SurfaceSecondaryBrush}" Style="{StaticResource SurfaceSecondaryStyle}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Ready " FontWeight="{DynamicResource Weight.SemiBold}"/><Viewbox MaxHeight="18"><TextBlock Text="{Binding ReadyCount}" Foreground="{DynamicResource SuccessBrush}" FontWeight="{DynamicResource Weight.Bold}"/></Viewbox></StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- ── Streamlined Station Filters & Execution Actions ── -->
            <Border Padding="16,14" CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                    Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{StaticResource OptIndigo}" BorderThickness="1.5"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="JOB FILTER" Style="{StaticResource OptHeader}"/>
                            <TextBox Text="{Binding JobFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SurfaceTextBox}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="SPECIFICATION" Style="{StaticResource OptHeader}"/>
                            <TextBox Text="{Binding SpecFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SurfaceTextBox}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                            <TextBlock Text="MATERIAL" Style="{StaticResource OptHeader}"/>
                            <TextBox Text="{Binding MaterialFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SurfaceTextBox}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="STATUS" Style="{StaticResource OptHeader}"/>
                            <ComboBox SelectedItem="{Binding StatusFilter}" ItemsSource="{Binding StatusOptions}" Style="{StaticResource SurfaceComboBox}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="STAGE EXECUTION WORKBENCH" Style="{StaticResource OptHeader}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Pair DGU A/B" Command="{Binding PairCommand}" Style="{StaticResource OutlinedPillButton}" Padding="14,0" Margin="0,0,8,0"/>
                            <Button Content="Assemble Unit" Command="{Binding AssembleCommand}" Style="{StaticResource PrimaryPillButton}" Padding="16,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Executions: the one work table -->
            <Border Padding="12" CornerRadius="{DynamicResource CardCornerRadius}"
                    Background="{DynamicResource SurfacePrimaryBrush}"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="320"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Process Executions" Style="{StaticResource ModulePageTitleStyle}" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Executions}" SelectedItem="{Binding SelectedExecution}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              CanUserResizeColumns="False" CanUserReorderColumns="False"
                              Style="{StaticResource SurfaceDataGrid}"
                              behaviors:SmartScrollBubblingBehavior.IsEnabled="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Job" Binding="{Binding JobRef}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="Spec" Binding="{Binding SpecName}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="Piece" Binding="{Binding PieceId}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="Process" Binding="{Binding ProcessType}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="Prev" Binding="{Binding PreviousStage}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="Next" Binding="{Binding NextStage}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding QtyDone}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            <DataGridTextColumn Header="Req" Binding="{Binding QtyRequired}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            <DataGridTextColumn Header="QC" Binding="{Binding QcStatus}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            <DataGridCheckBoxColumn Header="FOC" Binding="{Binding IsFoc}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Complete" Command="{Binding CompleteCommand}" CommandParameter="{Binding SelectedExecution}" Style="{StaticResource PrimaryPillButton}" Margin="0,0,8,4"/>
                        <Button Content="Pause" Command="{Binding PauseCommand}" CommandParameter="{Binding SelectedExecution}" Style="{StaticResource OutlinedPillButton}" Margin="0,0,8,4"/>
                        <Button Content="Breakage" Command="{Binding RecordBreakageCommand}" CommandParameter="{Binding SelectedExecution}" Style="{StaticResource OutlinedPillButton}" Margin="0,0,8,4"/>
                        <Button Content="Rework" Command="{Binding RecordReworkCommand}" CommandParameter="{Binding SelectedExecution}" Style="{StaticResource OutlinedPillButton}" Margin="0,0,8,4"/>
                        <Button Content="FOC" Command="{Binding RecordFocCommand}" CommandParameter="{Binding SelectedExecution}" Style="{StaticResource OutlinedPillButton}" Margin="0,0,8,4"/>
                        <Button Content="QC Pass" Command="{Binding QcPassedCommand}" CommandParameter="{Binding SelectedExecution}" Style="{StaticResource OutlinedPillButton}" Margin="0,0,8,4"/>
                        <Button Content="QC Fail" Command="{Binding QcFailedCommand}" CommandParameter="{Binding SelectedExecution}" Style="{StaticResource OutlinedPillButton}" Margin="0,0,0,4"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Lineage pair: pairings + assemblies, equal halves -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Padding="12" CornerRadius="{DynamicResource CardCornerRadius}" Margin="0,0,6,0"
                        Background="{DynamicResource SurfacePrimaryBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="180"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Pairings (DGU A/B)" Style="{StaticResource ModulePageTitleStyle}" Margin="0,0,0,8"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Pairings}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" IsReadOnly="True"
                                  CanUserResizeColumns="False" CanUserReorderColumns="False"
                                  Style="{StaticResource SurfaceDataGrid}"
                              behaviors:SmartScrollBubblingBehavior.IsEnabled="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Pair" Binding="{Binding PairId}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Outer" Binding="{Binding OuterPieceId}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Inner" Binding="{Binding InnerPieceId}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Padding="12" CornerRadius="{DynamicResource CardCornerRadius}" Margin="6,0,0,0"
                        Background="{DynamicResource SurfacePrimaryBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="180"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Assemblies (lineage)" Style="{StaticResource ModulePageTitleStyle}" Margin="0,0,0,8"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Assemblies}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" IsReadOnly="True"
                                  CanUserResizeColumns="False" CanUserReorderColumns="False"
                                  Style="{StaticResource SurfaceDataGrid}"
                              behaviors:SmartScrollBubblingBehavior.IsEnabled="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Assembly" Binding="{Binding AssemblyLabel}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding AssemblyType}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Components" Binding="{Binding ComponentsJson}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Traceability + process detail notes -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Padding="12" CornerRadius="{DynamicResource CardCornerRadius}" Margin="0,0,6,0"
                        Background="{DynamicResource SurfaceSecondaryBrush}" Style="{StaticResource SurfaceSecondaryStyle}">
                    <StackPanel>
                        <TextBlock Text="Traceability" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TraceabilityLabel}" FontSize="{DynamicResource FontSize.BodySmall}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="12" CornerRadius="{DynamicResource CardCornerRadius}" Margin="6,0,0,0"
                        Background="{DynamicResource SurfaceSecondaryBrush}" Style="{StaticResource SurfaceSecondaryStyle}">
                    <StackPanel>
                        <TextBlock Text="Process Detail" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ProcessDetailLabel}" FontSize="{DynamicResource FontSize.BodySmall}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Progress / action message -->
            <Border Margin="0,12,0,0" Padding="10" CornerRadius="{DynamicResource CardCornerRadius}"
                    Background="{DynamicResource SurfaceElevatedBrush}" Style="{StaticResource SurfaceElevatedStyle}"
                    Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding ProgressLabel}" FontSize="{DynamicResource FontSize.BodySmall}"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ActionMessage}" Margin="0,4,0,0" FontSize="{DynamicResource FontSize.BodySmall}"
                               Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                               Visibility="{Binding HasActionMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
