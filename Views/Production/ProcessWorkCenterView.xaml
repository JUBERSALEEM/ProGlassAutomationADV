<UserControl x:Class="ProGlassAutomation.Views.Production.ProcessWorkCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="{DynamicResource AppFontFamily}"
             Background="Transparent"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="24,20,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="56" Height="56" CornerRadius="{DynamicResource CardCornerRadius}"
                    Background="{DynamicResource TintTealBrush}" VerticalAlignment="Center" Margin="0,0,14,0"
                    Style="{StaticResource SurfacePrimaryStyle}">
                <TextBlock Text="&#xE9F5;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.Kpi}"
                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource ModulePageTitleStyle}"/>
                    <Border CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource DashAmbientBrush}"
                            Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource SurfacePrimaryStyle}">
                        <TextBlock Text="Shared Process Framework — 8 Stages" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.SemiBold}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource ModulePageSubtitleStyle}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding RouteLabel}" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Load" Command="{Binding LoadCommand}" Style="{StaticResource OutlinedPillButton}" Margin="0,0,8,0"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource OutlinedPillButton}"/>
            </StackPanel>
        </Grid>

        <!-- KPI -->
        <Border Grid.Row="1" Margin="24,0,24,8" Padding="12" CornerRadius="{DynamicResource CardCornerRadius}"
                Background="{DynamicResource SurfacePrimaryBrush}" Style="{StaticResource SurfacePrimaryStyle}">
            <StackPanel>
                <TextBlock Text="{Binding KpiSummary}" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Border Margin="0,0,8,0" Padding="10,6" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource SurfaceSecondaryBrush}" Style="{StaticResource SurfaceSecondaryStyle}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="Pending" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,6,0"/><TextBlock Text="{Binding PendingCount}" Foreground="{DynamicResource AccentBrush}" FontWeight="{DynamicResource Weight.Bold}"/></StackPanel>
                    </Border>
                    <Border Margin="0,0,8,0" Padding="10,6" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource SurfaceSecondaryBrush}" Style="{StaticResource SurfaceSecondaryStyle}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="In Progress" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,6,0"/><TextBlock Text="{Binding InProgressCount}" Foreground="{DynamicResource InfoBrush}" FontWeight="{DynamicResource Weight.Bold}"/></StackPanel>
                    </Border>
                    <Border Margin="0,0,8,0" Padding="10,6" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource SurfaceSecondaryBrush}" Style="{StaticResource SurfaceSecondaryStyle}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="Completed" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,6,0"/><TextBlock Text="{Binding CompletedCount}" Foreground="{DynamicResource SuccessBrush}" FontWeight="{DynamicResource Weight.Bold}"/></StackPanel>
                    </Border>
                    <Border Margin="0,0,8,0" Padding="10,6" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource SurfaceSecondaryBrush}" Style="{StaticResource SurfaceSecondaryStyle}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="Rework" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,6,0"/><TextBlock Text="{Binding ReworkCount}" Foreground="{DynamicResource WarningBrush}" FontWeight="{DynamicResource Weight.Bold}"/></StackPanel>
                    </Border>
                    <Border Margin="0,0,8,0" Padding="10,6" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource SurfaceSecondaryBrush}" Style="{StaticResource SurfaceSecondaryStyle}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="QC Pending" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,6,0"/><TextBlock Text="{Binding QcPendingCount}" Foreground="{DynamicResource WarningBrush}" FontWeight="{DynamicResource Weight.Bold}"/></StackPanel>
                    </Border>
                    <Border Padding="10,6" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource SurfaceSecondaryBrush}" Style="{StaticResource SurfaceSecondaryStyle}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="Ready" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,6,0"/><TextBlock Text="{Binding ReadyCount}" Foreground="{DynamicResource SuccessBrush}" FontWeight="{DynamicResource Weight.Bold}"/></StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Filters + Workflow Input -->
        <Border Grid.Row="2" Margin="24,0,24,8" Padding="12" CornerRadius="{DynamicResource CardCornerRadius}"
                Background="{DynamicResource SurfaceSecondaryBrush}" Style="{StaticResource SurfaceSecondaryStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ComboBox Width="140" Margin="0,0,8,0" SelectedItem="{Binding ProcessFilter}" ItemsSource="{Binding ProcessOptions}" Style="{StaticResource SurfaceComboBox}"/>
                    <TextBox Width="110" Margin="0,0,8,0" Text="{Binding JobFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SurfaceTextBox}" Tag="Filter Job"/>
                    <TextBox Width="90" Margin="0,0,8,0" Text="{Binding PiFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SurfaceTextBox}" Tag="PI"/>
                    <TextBox Width="90" Margin="0,0,8,0" Text="{Binding SpecFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SurfaceTextBox}" Tag="Spec"/>
                    <TextBox Width="90" Margin="0,0,8,0" Text="{Binding MaterialFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SurfaceTextBox}" Tag="Material"/>
                    <ComboBox Width="110" Margin="0,0,8,0" SelectedItem="{Binding StatusFilter}" ItemsSource="{Binding StatusOptions}" Style="{StaticResource SurfaceComboBox}"/>
                    <TextBox Width="110" Text="{Binding JobRefInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SurfaceTextBox}" Tag="Job Ref Input"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Pair DGU" Command="{Binding PairCommand}" Style="{StaticResource OutlinedPillButton}" Margin="0,0,8,0"/>
                    <Button Content="Assemble" Command="{Binding AssembleCommand}" Style="{StaticResource PrimaryPillButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main work area: executions + pairings + assemblies + traceability -->
        <Grid Grid.Row="3" Margin="24,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Executions -->
            <Border Grid.Column="0" Margin="0,0,8,0" Padding="8" CornerRadius="{DynamicResource CardCornerRadius}"
                    Background="{DynamicResource SurfacePrimaryBrush}" Style="{StaticResource SurfacePrimaryStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Process Executions — Job Spec Piece Process Previous Current Status Qty Progress QC Operator" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,0,8"/>
                    <DataGrid CanUserReorderColumns="False" CanUserResizeColumns="False" Grid.Row="1" ItemsSource="{Binding Executions}" SelectedItem="{Binding SelectedExecution}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Style="{StaticResource SurfaceDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Job" Binding="{Binding JobRef}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="Spec" Binding="{Binding SpecName}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="Piece" Binding="{Binding PieceId}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="Process" Binding="{Binding ProcessType}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="Prev" Binding="{Binding PreviousStage}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="Next" Binding="{Binding NextStage}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding QtyDone}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            <DataGridTextColumn Header="Req" Binding="{Binding QtyRequired}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            <DataGridTextColumn Header="QC" Binding="{Binding QcStatus}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            <DataGridCheckBoxColumn Header="FOC" Binding="{Binding IsFoc}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Complete" Command="{Binding CompleteCommand}" CommandParameter="{Binding SelectedExecution}" Style="{StaticResource PrimaryPillButton}" Margin="0,0,8,0"/>
                        <Button Content="Pause" Command="{Binding PauseCommand}" CommandParameter="{Binding SelectedExecution}" Style="{StaticResource OutlinedPillButton}" Margin="0,0,8,0"/>
                        <Button Content="Breakage" Command="{Binding RecordBreakageCommand}" CommandParameter="{Binding SelectedExecution}" Style="{StaticResource OutlinedPillButton}" Margin="0,0,8,0"/>
                        <Button Content="Rework" Command="{Binding RecordReworkCommand}" CommandParameter="{Binding SelectedExecution}" Style="{StaticResource OutlinedPillButton}" Margin="0,0,8,0"/>
                        <Button Content="FOC" Command="{Binding RecordFocCommand}" CommandParameter="{Binding SelectedExecution}" Style="{StaticResource OutlinedPillButton}" Margin="0,0,8,0"/>
                        <Button Content="QC Pass" Command="{Binding QcPassedCommand}" CommandParameter="{Binding SelectedExecution}" Style="{StaticResource OutlinedPillButton}" Margin="0,0,8,0"/>
                        <Button Content="QC Fail" Command="{Binding QcFailedCommand}" CommandParameter="{Binding SelectedExecution}" Style="{StaticResource OutlinedPillButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: Pairings + Assemblies + Details -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,8" Padding="8" CornerRadius="{DynamicResource CardCornerRadius}"
                        Background="{DynamicResource SurfacePrimaryBrush}" Style="{StaticResource SurfacePrimaryStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Pairings — DGU Component A/B deterministic" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,0,8"/>
                        <DataGrid CanUserReorderColumns="False" CanUserResizeColumns="False" Grid.Row="1" ItemsSource="{Binding Pairings}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Style="{StaticResource SurfaceDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Pair" Binding="{Binding PairId}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Outer" Binding="{Binding OuterPieceId}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Inner" Binding="{Binding InnerPieceId}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Padding="8" CornerRadius="{DynamicResource CardCornerRadius}"
                        Background="{DynamicResource SurfacePrimaryBrush}" Style="{StaticResource SurfacePrimaryStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Assemblies — DGU/Lamination lineage preserved" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,0,8"/>
                        <DataGrid CanUserReorderColumns="False" CanUserResizeColumns="False" Grid.Row="1" ItemsSource="{Binding Assemblies}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Style="{StaticResource SurfaceDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Assembly" Binding="{Binding AssemblyLabel}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding AssemblyType}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Components" Binding="{Binding ComponentsJson}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Margin="0,8,0,0" Padding="8" CornerRadius="{DynamicResource CardCornerRadius}"
                        Background="{DynamicResource SurfaceSecondaryBrush}" Style="{StaticResource SurfaceSecondaryStyle}">
                    <StackPanel>
                        <TextBlock Text="Traceability — Previous → Current → Next, never lose original" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TraceabilityLabel}" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="Process Detail — Holes/Cutouts geometry summary, Polish edges, Mitring angle, Tempering batch, Pairing A/B, Doubling assembly" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding ProcessDetailLabel}" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Progress -->
        <Border Grid.Row="4" Margin="24,8,24,12" Padding="10" CornerRadius="{DynamicResource CardCornerRadius}"
                Background="{DynamicResource SurfaceElevatedBrush}" Style="{StaticResource SurfaceElevatedStyle}"
                Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding ProgressLabel}" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ActionMessage}" Margin="0,4,0,0" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                           Visibility="{Binding HasActionMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
