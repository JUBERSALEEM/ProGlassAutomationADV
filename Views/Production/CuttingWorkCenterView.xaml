<UserControl Style="{StaticResource ErpPageRootStyle}" x:Class="ProGlassAutomation.Views.Production.CuttingWorkCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             mc:Ignorable="d"
             FontFamily="{DynamicResource AppFontFamily}"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Dashboard/Overview/IndigoStudioResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Cutting Work Center -->
        <Grid Grid.Row="0" Margin="24,16,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource OptHeroCard}" Margin="0,0,12,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource OptOnIndigo}"/>
                    <TextBlock Text="Stage 1 — cutting and 2D nesting" FontSize="12"
                               Foreground="{StaticResource OptOnIndigoMuted}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="12"
                               Foreground="{StaticResource OptOnIndigoMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Load" Command="{Binding LoadCommand}" Style="{StaticResource OutlinedPillButton}" Margin="0,0,8,0"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource OutlinedPillButton}"/>
            </StackPanel>
        </Grid>

        <!-- KPI: Pending, In Progress, Completed, Rework, QC Pending, Ready -->
        <Border Grid.Row="1" Margin="24,0,24,8" Padding="12" CornerRadius="18"
                Background="{DynamicResource SurfacePrimaryBrush}"
                BorderBrush="{StaticResource OptIndigo}" BorderThickness="1.5">
            <StackPanel>
                <TextBlock Text="{Binding KpiSummary}" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Border Margin="0,0,8,0" Padding="10,6" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource SurfaceSecondaryBrush}" Style="{StaticResource SurfaceSecondaryStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Pending" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,6,0"/>
                            <Viewbox MaxHeight="18">
                                <TextBlock Text="{Binding PendingCount}" Foreground="{DynamicResource AccentBrush}" FontWeight="{DynamicResource Weight.Bold}"/>
                            </Viewbox>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,8,0" Padding="10,6" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource SurfaceSecondaryBrush}" Style="{StaticResource SurfaceSecondaryStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="In Progress" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,6,0"/>
                            <Viewbox MaxHeight="18">
                                <TextBlock Text="{Binding InProgressCount}" Foreground="{DynamicResource InfoBrush}" FontWeight="{DynamicResource Weight.Bold}"/>
                            </Viewbox>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,8,0" Padding="10,6" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource SurfaceSecondaryBrush}" Style="{StaticResource SurfaceSecondaryStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Completed" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,6,0"/>
                            <Viewbox MaxHeight="18">
                                <TextBlock Text="{Binding CompletedCount}" Foreground="{DynamicResource SuccessBrush}" FontWeight="{DynamicResource Weight.Bold}"/>
                            </Viewbox>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,8,0" Padding="10,6" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource SurfaceSecondaryBrush}" Style="{StaticResource SurfaceSecondaryStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Rework" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,6,0"/>
                            <Viewbox MaxHeight="18">
                                <TextBlock Text="{Binding ReworkCount}" Foreground="{DynamicResource WarningBrush}" FontWeight="{DynamicResource Weight.Bold}"/>
                            </Viewbox>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,8,0" Padding="10,6" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource SurfaceSecondaryBrush}" Style="{StaticResource SurfaceSecondaryStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="QC Pending" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,6,0"/>
                            <Viewbox MaxHeight="18">
                                <TextBlock Text="{Binding QcPendingCount}" Foreground="{DynamicResource WarningBrush}" FontWeight="{DynamicResource Weight.Bold}"/>
                            </Viewbox>
                        </StackPanel>
                    </Border>
                    <Border Padding="10,6" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource SurfaceSecondaryBrush}" Style="{StaticResource SurfaceSecondaryStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ready" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,6,0"/>
                            <Viewbox MaxHeight="18">
                                <TextBlock Text="{Binding ReadyCount}" Foreground="{DynamicResource SuccessBrush}" FontWeight="{DynamicResource Weight.Bold}"/>
                            </Viewbox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Filters + Workflow Input -->
        <Border Grid.Row="2" Margin="24,0,24,8" Padding="12" CornerRadius="{DynamicResource CardCornerRadius}"
                Background="{DynamicResource SurfaceSecondaryBrush}" Style="{StaticResource SurfaceSecondaryStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBox Width="120" Margin="0,0,8,0" Text="{Binding JobRefInput, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SurfaceTextBox}" Tag="Job Ref"/>
                    <TextBox Width="100" Margin="0,0,8,0" Text="{Binding JobFilter, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SurfaceTextBox}" Tag="Filter Job"/>
                    <TextBox Width="100" Margin="0,0,8,0" Text="{Binding PiFilter, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SurfaceTextBox}" Tag="PI"/>
                    <TextBox Width="100" Margin="0,0,8,0" Text="{Binding MaterialFilter, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SurfaceTextBox}" Tag="Material"/>
                    <ComboBox Width="120" Margin="0,0,8,0" SelectedItem="{Binding Rotation}" ItemsSource="{Binding RotationOptions}"
                              Style="{StaticResource SurfaceComboBox}"/>
                    <TextBox Width="60" Text="{Binding Effort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SurfaceTextBox}" Tag="Effort 1-5"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Run Cutting Workflow" Command="{Binding RunCuttingWorkflowCommand}" Style="{StaticResource PrimaryPillButton}" Margin="0,0,8,0"/>
                    <Button Content="Complete Session" Command="{Binding CompleteSessionCommand}" CommandParameter="{Binding SelectedSession}" Style="{StaticResource OutlinedPillButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main work area: sessions + sheets + placed pieces + traceability -->
        <Grid Grid.Row="3" Margin="24,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Cutting Sessions -->
            <Border Grid.Column="0" Margin="0,0,8,0" Padding="8" CornerRadius="{DynamicResource CardCornerRadius}"
                    Background="{DynamicResource SurfacePrimaryBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Cutting Sessions" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,0,8"/>
                    <DataGrid CanUserReorderColumns="False" CanUserResizeColumns="False" Grid.Row="1" ItemsSource="{Binding CuttingSessions}" SelectedItem="{Binding SelectedSession}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Style="{StaticResource SurfaceDataGrid}"
                              behaviors:SmartScrollBubblingBehavior.IsEnabled="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Job" Binding="{Binding JobRef}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                            <DataGridTextColumn Header="Sheets" Binding="{Binding SheetsUsed}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            <DataGridTextColumn Header="Pieces" Binding="{Binding TotalPieces}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            <DataGridTextColumn Header="Util %" Binding="{Binding UtilizationPct}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right: Sheets + Placed Pieces -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="200"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sheets -->
                <Border Grid.Row="0" Margin="0,0,0,8" Padding="8" CornerRadius="{DynamicResource CardCornerRadius}"
                        Background="{DynamicResource SurfacePrimaryBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Sheet Layouts — Stock Sheet + Placed Pieces + Utilization + Wastage + Verification" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,0,8"/>
                        <DataGrid CanUserReorderColumns="False" CanUserResizeColumns="False" Grid.Row="1" ItemsSource="{Binding CuttingSheets}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  Style="{StaticResource SurfaceDataGrid}"
                              behaviors:SmartScrollBubblingBehavior.IsEnabled="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SheetNo" Binding="{Binding SheetNo}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Stock" Binding="{Binding StockSizeLabel}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="W×H" Binding="{Binding StockWidthMm}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Util %" Binding="{Binding UtilizationPct}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="Waste %" Binding="{Binding WastagePct}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="Pieces" Binding="{Binding PlacedPieceCount}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridCheckBoxColumn Header="Verified" Binding="{Binding IsVerified}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Placed Pieces — Job Spec Piece Size Material Sheet Rotation Status Progress -->
                <Border Grid.Row="1" Padding="8" CornerRadius="{DynamicResource CardCornerRadius}"
                        Background="{DynamicResource SurfacePrimaryBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Placed Pieces — Job Spec Piece Size Material Sheet Rotation Status Progress" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,0,8"/>
                        <DataGrid CanUserReorderColumns="False" CanUserResizeColumns="False" Grid.Row="1" ItemsSource="{Binding PlacedPieces}" SelectedItem="{Binding SelectedPlacedPiece}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  Style="{StaticResource SurfaceDataGrid}"
                              behaviors:SmartScrollBubblingBehavior.IsEnabled="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Piece" Binding="{Binding PieceLabel}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Spec" Binding="{Binding SpecName}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding WidthMm}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="Pos" Binding="{Binding Position}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="Sheet" Binding="{Binding CuttingSheetId}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridTextColumn Header="Rot" Binding="{Binding IsRotated}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="X/Y" Binding="{Binding X}" Width="*" HeaderStyle="{StaticResource WorkCenterCenterHeaderStyle}" ElementStyle="{StaticResource WorkCenterCenterCellTextStyle}"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" ElementStyle="{StaticResource WorkCenterLeftCellTextStyle}"/>
                                <DataGridCheckBoxColumn Header="FOC" Binding="{Binding IsFoc}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Traceability + Actions -->
                <Border Grid.Row="2" Margin="0,8,0,0" Padding="8" CornerRadius="{DynamicResource CardCornerRadius}"
                        Background="{DynamicResource SurfaceSecondaryBrush}" Style="{StaticResource SurfaceSecondaryStyle}">
                    <StackPanel>
                        <TextBlock Text="Traceability — PI → JO → Spec → Production Piece → Optimization Session → Sheet → Placed Piece → Cutting Work Item" FontWeight="{DynamicResource Weight.SemiBold}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TraceabilityLabel}" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Complete" Command="{Binding CompletePieceCommand}" CommandParameter="{Binding SelectedPlacedPiece}" Style="{StaticResource PrimaryPillButton}" Margin="0,0,8,0"/>
                            <Button Content="Breakage" Command="{Binding RecordBreakageCommand}" CommandParameter="{Binding SelectedPlacedPiece}" Style="{StaticResource OutlinedPillButton}" Margin="0,0,8,0"/>
                            <Button Content="FOC" Command="{Binding RecordFocCommand}" CommandParameter="{Binding SelectedPlacedPiece}" Style="{StaticResource OutlinedPillButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Progress + Action Message -->
        <Border Grid.Row="4" Margin="24,8,24,12" Padding="10" CornerRadius="{DynamicResource CardCornerRadius}"
                Background="{DynamicResource SurfaceElevatedBrush}" Style="{StaticResource SurfaceElevatedStyle}"
                Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding ProgressLabel}" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ActionMessage}" Margin="0,4,0,0" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                           Visibility="{Binding HasActionMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
