<!-- ═══════════════════════════════════════════════════════════════
     FILE: Views/Production/MitringView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Production — Mitring stage module (screens redesign 2026-09-11)

     Stage identity header (tinted tile, pipeline position, chain
     context) + the shared stage body: pipeline chain bar, release bar,
     KPIs, filters and the Step-5-shaped unit list with unit detail.
     Work arrives ONLY from confirmed Job Orders (released /
     in-production, non-void). See docs/PRODUCTION_SCREENS_DESIGN_2026-09-11.md.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Production.MitringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:production="clr-namespace:ProGlassAutomation.Views.Production"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Stage identity header ═══════════════════════════════ -->
        <Grid Grid.Row="0" Margin="4,4,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Stage icon tile — tint is fixed per stage (theme-aware
                 brush), so no code-behind resolution is needed. -->
            <Border Grid.Column="0"
                    Width="56" Height="56"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Background="{DynamicResource TintIndigoBrush}"
                    VerticalAlignment="Center"
                    Margin="0,0,14,0">
                <TextBlock Text="{Binding Icon}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="26"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ModuleName}"
                               Style="{StaticResource ModulePageTitleStyle}"/>
                    <Border CornerRadius="9"
                            Background="{DynamicResource DashAmbientBrush}"
                            Padding="10,3"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding StageOrdinalLabel}"
                                   FontSize="{StaticResource TextCaption}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Description}"
                           Style="{StaticResource ModulePageSubtitleStyle}"/>
                <!-- Chain context: where this stage sits in the pipeline -->
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="&#xE9D9;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="{StaticResource TextCaption}"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBlock Text="Stage 5 of 8 · after Cutting — mitred edges for matched laminate work"
                               FontSize="{StaticResource TextCaption}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ══ Shared stage body: chain bar, release, KPIs, list + detail ══ -->
        <production:ProductionStageView Grid.Row="1" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
