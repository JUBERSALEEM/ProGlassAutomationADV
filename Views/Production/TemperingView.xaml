<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Production/TemperingView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Production — Tempering (Stage 6 of 8) — SEPARATE page

Own page, not a shared body. Tempering shows the furnace queue — FT / HS / HST panes only — with the stage's piece flow IN · DONE · BALANCE.
     See docs/PRODUCTION_OPTIMIZATION_REDESIGN_2026-09-12.md.
═══════════════════════════════════════════════════════════════════ -->
<pgp:ProductionStagePageBase x:Class="ProGlassAutomation.Views.Production.TemperingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pgp="clr-namespace:ProGlassAutomation.Views.Production"
             xmlns:production="clr-namespace:ProGlassAutomation.Views.Production.Controls"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Stage identity header (this stage's own) ══════════════════ -->
        <Grid Grid.Row="0" Margin="4,4,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="56" Height="56"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Background="{DynamicResource TintAmberBrush}"
                    VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock Text="{Binding Icon}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="26"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ModuleName}" Style="{StaticResource ModulePageTitleStyle}"/>
                    <Border CornerRadius="9" Background="{DynamicResource DashAmbientBrush}"
                            Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StageOrdinalLabel}"
                                   FontSize="{StaticResource TextCaption}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Description}" Style="{StaticResource ModulePageSubtitleStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                               FontSize="{StaticResource TextCaption}"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Stage 6 of 8 · receives pieces that finished cutting + all edge work — feeds Pairing"
                               FontSize="{StaticResource TextCaption}" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ══ Pipeline chain bar (shared chrome) ═════════════════════ -->
        <production:ProductionPipelineBar Grid.Row="1"/>

        <!-- ══ Release bar (shared chrome) ═══════════════════════════ -->
        <production:ProductionReleaseBar Grid.Row="2"/>

        <!-- ══ Shell: KPIs + filters + master–detail ═════════════════ -->
        <Border Grid.Row="3" Style="{StaticResource ModuleListShellStyle}" Margin="4,0,4,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <production:ProductionKpiStrip Grid.Row="0"/>
                <production:ProductionFilterBar Grid.Row="1"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="470" MinWidth="420"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── Tier 1 · stage list ── -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid Grid.Row="0" x:Name="MasterGrid"
                                  ItemsSource="{Binding ListRows}"
                                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                  Style="{StaticResource GodViewGridStyle}"
                                  ColumnHeaderStyle="{StaticResource GodViewHeaderStyle}"
                                  SelectionMode="Single" CanUserAddRows="False" IsReadOnly="True"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.ScrollChanged="MasterGrid_ScrollChanged">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="ST" Width="42">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusGlyph}" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusLabel}" Value="IN PROGRESS">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusLabel}" Value="COMPLETED">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="JOB" Binding="{Binding JobRef}" Width="120"/>
                                <DataGridTextColumn Header="PI NO" Binding="{Binding PiNo}" Width="110"/>
                                <DataGridTextColumn Header="CUSTOMER" Binding="{Binding Customer}" Width="1.3*"/>
                                <DataGridTextColumn Header="SPEC" Binding="{Binding SpecLabel}" Width="1.5*"/>
                                <DataGridTextColumn Header="SR" Binding="{Binding SerialLabel}" Width="50"/>
                                <DataGridTextColumn Header="REF" Binding="{Binding GlassRef}" Width="90"/>
                                <DataGridTextColumn Header="BUILD" Binding="{Binding BuildType}" Width="90"/>
                                <DataGridTextColumn Header="W1" Binding="{Binding W1Label}" Width="60"/>
                                <DataGridTextColumn Header="H1" Binding="{Binding H1Label}" Width="60"/>
                                <DataGridTextColumn Header="W2" Binding="{Binding W2Label}" Width="60"/>
                                <DataGridTextColumn Header="H2" Binding="{Binding H2Label}" Width="60"/>
                                <DataGridTextColumn Header="QTY" Binding="{Binding QtyLabel}" Width="55"/>
                                <DataGridTextColumn Header="IN" Binding="{Binding InflowLabel}" Width="55"/>
                                <DataGridTextColumn Header="DONE" Binding="{Binding DoneLabel}" Width="60"/>
                                <DataGridTextColumn Header="BALANCE" Binding="{Binding BalanceLabel}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="1" Padding="10,5" Background="{DynamicResource ModuleBackgroundBrush}"
                                Visibility="{Binding HasListFooter, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding ListFooterLabel}" FontSize="{StaticResource TextCaption}"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </Border>

                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="44"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" Opacity="0.6"/>
                            <TextBlock Text="No tempering work yet" FontSize="{StaticResource TextSubhead}" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,12,0,4"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="Furnace-eligible panes only (FT / HS / HST). A piece enters when cutting and all its edge work are done; SGU pieces leave dispatch-ready straight from the furnace."
                                       FontSize="{StaticResource TextBody}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="480"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>
                    </Grid>

                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                                  VerticalAlignment="Stretch" Background="Transparent"/>

                    <!-- ── Tier 2 · stage unit detail ───────────────── -->
                    <Border Grid.Column="2" Style="{StaticResource SurfaceSecondaryStyle}" Margin="6,6,6,6" Padding="14">
                        <Grid>
                            <StackPanel VerticalAlignment="Center"
                                        Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" Opacity="0.6"/>
                                <TextBlock Text="Select a unit to open its detail" FontSize="{StaticResource TextSubhead}" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,12,0,4" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                <TextBlock Text="The detail panel shows the job, pane sizes, Step 4 composition and this stage's work items with floor actions — plus buttons to open the source Job Order or Proforma Invoice."
                                           FontSize="{StaticResource TextBody}" TextWrapping="Wrap" TextAlignment="Center"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                            </StackPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <!-- Stage focus hero (this stage's own) -->
                                    <Border CornerRadius="{DynamicResource CardCornerRadius}"
                                            Background="{DynamicResource TintAmberBrush}" Padding="12,10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="FURNACE CYCLES" FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="{Binding IndustryFocus}" FontSize="{StaticResource TextBody}"
                                                       TextWrapping="Wrap" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button Style="{StaticResource PrimaryPillButton}" Command="{Binding OpenJobOrderCommand}"
                                                Tag="&#xE8A5;" Content="Open Job Order" Margin="0,0,8,0"
                                                ToolTip="Open the source Job Order this work was released from"/>
                                        <Button Style="{StaticResource OutlinedPillButton}" Command="{Binding OpenProformaCommand}"
                                                Tag="&#xE8A7;" Content="Open Proforma Invoice"
                                                ToolTip="Open the confirmed PI (check Step 5 sizes / Step 6 charges)"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Job No" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,2"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedJobNo}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="12,2,0,2"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="PI No" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,2"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedPiNo}" FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="12,2,0,2"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Customer" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,2"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedCustomer}" FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap" Margin="12,2,0,2"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Project" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,2"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedProject}" FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap" Margin="12,2,0,2"/>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Salesman" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,2"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedSalesman}" FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="12,2,0,2"/>
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Spec / Ref" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,2"/>
                                        <StackPanel Grid.Row="5" Grid.Column="1" Margin="12,2,0,2">
                                            <TextBlock Text="{Binding SelectedSpecLabel}" FontSize="{StaticResource TextBody}"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding SelectedRef}" FontSize="{StaticResource TextBody}"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Sizes" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,2"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedSizeSummary}" FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap" Margin="12,2,0,2"/>
                                    </Grid>

                                    <TextBlock Text="{Binding SelectedSizeRuleLabel}" FontSize="{StaticResource TextCaption}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Visibility="{Binding HasSizeRule, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Treatments" FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedTreatmentsLabel}" FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Released" FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedArrivalLabel}" FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    </Grid>

                                    <!-- Pane-level stage items — piece flow editor -->
                                    <ItemsControl ItemsSource="{Binding SelectedStageItems}" Margin="0,14,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="{DynamicResource CardCornerRadius}"
                                                        Background="{DynamicResource DashAmbientBrush}" Padding="12,10" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Position}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                                    <TextBlock Text=" · " FontSize="{StaticResource TextBody}" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                                    <TextBlock Text="{Binding SizeLabel}" FontSize="{StaticResource TextBody}" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                                    <TextBlock Text=" · " FontSize="{StaticResource TextBody}" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                                    <TextBlock Text="{Binding QtyLabel, StringFormat='Qty {0}'}" FontSize="{StaticResource TextBody}"
                                                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding DetailLabel}" FontSize="{StaticResource TextBody}" TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" FontSize="{StaticResource TextCaption}"
                                                                       FontWeight="SemiBold" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding StatusLabel}" Value="IN PROGRESS">
                                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding StatusLabel}" Value="COMPLETED">
                                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>

                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                            <Border CornerRadius="8" Background="{DynamicResource ModuleBackgroundBrush}" Padding="10,4" Margin="0,0,6,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="IN " FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                                               Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding InflowLabel}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border CornerRadius="8" Background="{DynamicResource ModuleBackgroundBrush}" Padding="10,4" Margin="0,0,6,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="DONE " FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                                               Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding DoneLabel}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource SuccessBrush}"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border CornerRadius="8" Background="{DynamicResource ModuleBackgroundBrush}" Padding="10,4">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="BALANCE " FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                                               Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding BalanceLabel}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource WarningBrush}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                                    Visibility="{Binding CanWork, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="Done pcs" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <TextBox Text="{Binding DoneInput, UpdateSourceTrigger=PropertyChanged}" Width="70"
                                                                     VerticalContentAlignment="Center" ToolTip="Pieces completed at this stage (cannot exceed IN)"/>
                                                            <Button Content="Save" Style="{StaticResource PrimaryPillButton}"
                                                                    Command="{Binding DataContext.SaveQtyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}" Margin="8,0,0,0" Padding="14,2"
                                                                    ToolTip="Save the done-piece count — only completed pieces move to the next stage"/>
                                                            <Button Content="All" Style="{StaticResource OutlinedPillButton}"
                                                                    Command="{Binding DataContext.CompleteAllCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}" Margin="6,0,0,0" Padding="12,2"
                                                                    ToolTip="Complete every piece that arrived"/>
                                                            <Button Content="Reset" Style="{StaticResource OutlinedPillButton}"
                                                                    Command="{Binding DataContext.ResetQtyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}" Margin="6,0,0,0" Padding="12,2"
                                                                    ToolTip="Set done pieces back to zero"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Stage totals — total / done / balance -->
                                    <Border CornerRadius="{DynamicResource CardCornerRadius}"
                                            Background="{DynamicResource ModuleBackgroundBrush}" Padding="12,10" Margin="0,6,0,8">
                                        <StackPanel>
                                            <TextBlock Text="STAGE TOTALS — THIS UNIT" FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,6"/>
                                            <Button Content="Complete all items" Style="{StaticResource OutlinedPillButton}"
                                                    Command="{Binding CompleteUnitCommand}"
                                                    HorizontalAlignment="Left" Margin="0,0,0,8"
                                                    ToolTip="Complete every arrived piece of this unit in one action — each item is clamped to what arrived upstream"/>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Pieces" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,1"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SelectedPcsSummary}" FontSize="{StaticResource TextBody}"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,1"/>
                                            </Grid>
                                            <Grid Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Area" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,1"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SelectedSqmSummary}" FontSize="{StaticResource TextBody}"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,1"/>
                                            </Grid>
                                            <Grid Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="LM" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,1"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SelectedLmSummary}" FontSize="{StaticResource TextBody}"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,1"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Dispatch — finished pieces flow into delivery notes -->
                                    <Border CornerRadius="{DynamicResource CardCornerRadius}"
                                            Background="{DynamicResource ModuleBackgroundBrush}" Padding="12,10"
                                            Visibility="{Binding HasDispatchPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="DISPATCH" FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Border CornerRadius="8" Background="{DynamicResource DashAmbientBrush}" Padding="10,4" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="READY " FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                                   Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding SelectedDispatchReadyLabel}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SuccessBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border CornerRadius="8" Background="{DynamicResource DashAmbientBrush}" Padding="10,4" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="DELIVERED " FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                                   Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding SelectedDispatchDeliveredLabel}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border CornerRadius="8" Background="{DynamicResource DashAmbientBrush}" Padding="10,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="TO DELIVER " FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                                   Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding SelectedDispatchBalanceLabel}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <Button Content="Create Delivery Note" Style="{StaticResource PrimaryPillButton}"
                                                    Command="{Binding CreateDeliveryNoteCommand}" Margin="0,10,0,0" HorizontalAlignment="Left"
                                                    ToolTip="Creates the Dispatching delivery note for this Job Order with remaining balance only — capped to the pieces production has finished."/>
                                            <TextBlock Text="Finished pieces flow into delivery notes automatically — each note delivers only the completed balance."
                                                       FontSize="{StaticResource TextCaption}" Foreground="{DynamicResource MutedForegroundBrush}"
                                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</pgp:ProductionStagePageBase>
