<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Production/ProductionStageView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Production — shared stage-queue screen (Phase 3, 2026-09-11)

     Hosted by all eight production module views. Binds to
     ProductionStageViewModelBase and renders:
       • stage identity header (tinted icon tile + pipeline position),
       • the release bar — work comes EXCLUSIVELY from confirmed Job
         Orders (Approved PIs that were converted); drafts never reach
         the floor,
       • KPI tiles — queue / pending / in progress / completed / load /
         units ready for dispatch,
       • floor connectivity warning (completing before the predecessor
         stage),
       • job + status filters and the work-item grid with
         Start / Complete / Reopen actions.

     Work arrives from ProductionDistributionEngine — specs read from
     Step 4/5, work-type quantities from Step 6. See
     docs/PRODUCTION_DISTRIBUTION_PLAN_2026-09-11.md.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Production.ProductionStageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="OnViewLoaded">

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Stage identity header + release bar ═══════════════════ -->
        <StackPanel Grid.Row="0" Margin="4,4,4,12">
            <Grid Margin="4,0,4,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Stage icon tile (tinted per stage — resolved from
                     StageTintBrushKey in code-behind, WPF cannot bind a
                     DynamicResource key) -->
                <Border x:Name="StageIconTile"
                        Grid.Column="0"
                        Width="52" Height="52"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Background="{DynamicResource TintBlueBrush}"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0">
                    <TextBlock Text="{Binding Icon}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="24"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ModuleName}"
                                   Style="{StaticResource ModulePageTitleStyle}"/>
                        <Border CornerRadius="9"
                                Background="{DynamicResource DashAmbientBrush}"
                                Padding="10,3"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding StageOrdinalLabel}"
                                       FontSize="{StaticResource TextCaption}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}"
                               Style="{StaticResource ModulePageSubtitleStyle}"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Style="{StaticResource OutlinedPillButton}"
                        Command="{Binding RefreshCommand}"
                        Tag="&#xE72C;"
                        Content="Refresh"
                        MinWidth="140"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- Release bar — Job Orders only (confirmed PIs) -->
            <Border Style="{StaticResource ModuleListShellStyle}" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Release from Job Order"
                               FontSize="{StaticResource TextBody}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Sources}"
                              SelectedItem="{Binding SelectedSource}"
                              DisplayMemberPath="DisplayLabel"
                              Style="{StaticResource ModuleListFilterComboStyle}"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              ToolTip="Released / In-Production Job Orders (confirmed PIs only — drafts never reach the floor)"/>
                    <Button Grid.Column="2"
                            Style="{StaticResource PrimaryPillButton}"
                            Command="{Binding ReleaseCommand}"
                            Tag="&#xE768;"
                            Content="Release to Production"
                            MinWidth="210"/>
                </Grid>
            </Border>

            <TextBlock Text="{Binding ReleaseMessage}"
                       Margin="8,8,8,0"
                       TextWrapping="Wrap"
                       FontSize="{StaticResource TextBody}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ReleaseSucceeded}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Floor connectivity warning -->
            <Border Margin="0,8,0,0"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Background="{DynamicResource TintAmberBrush}"
                    Padding="12,8"
                    Visibility="{Binding HasActionWarning,
                                 Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="{StaticResource TextBody}"
                               Foreground="{DynamicResource WarningBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ActionWarning}"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource TextBody}"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ══ Shell: KPIs + filters + grid ══════════════════════════ -->
        <Border Grid.Row="1" Grid.RowSpan="2"
                Style="{StaticResource ModuleListShellStyle}" Margin="4,0,4,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- KPI strip -->
                <Border Grid.Row="0" Style="{StaticResource ModuleListKpiStripStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintBlueBrush}">
                                <TextBlock Text="&#xE8C6;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSubhead}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="In queue" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding TotalCount}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintAmberBrush}">
                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSubhead}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Pending" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding PendingCount}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="3" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintIndigoBrush}">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSubhead}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="In progress" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding InProgressCount}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="5" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintGreenBrush}">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSubhead}"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Completed" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding CompletedCount}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="7" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintPurpleBrush}">
                                <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSubhead}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Load" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding AreaTotalLabel}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="{Binding MetricTotalLabel}" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="9" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <StackPanel Grid.Column="10" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintGreenBrush}">
                                <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSubhead}"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Ready for dispatch" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding UnitsReadyLabel}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Filter bar -->
                <Border Grid.Row="1" Style="{StaticResource ModuleListFilterBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding JobFilters}"
                                  SelectedItem="{Binding SelectedJobFilter}"
                                  Style="{StaticResource ModuleListFilterComboStyle}"
                                  Margin="0,0,8,0"
                                  ToolTip="Filter by released job"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding StatusFilters}"
                                  SelectedItem="{Binding SelectedStatusFilter}"
                                  Style="{StaticResource ModuleListFilterComboStyle}"/>
                    </Grid>
                </Border>

                <!-- Queue grid -->
                <Grid Grid.Row="2">
                    <DataGrid ItemsSource="{Binding Queue}"
                              Style="{StaticResource GodViewGridStyle}"
                              ColumnHeaderStyle="{StaticResource GodViewHeaderStyle}"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="JOB" Binding="{Binding JobRef}" Width="120"/>
                            <DataGridTextColumn Header="SPECIFICATION" Binding="{Binding SpecLabel}" Width="1.7*"/>
                            <DataGridTextColumn Header="REF" Binding="{Binding GlassRef}" Width="90"/>
                            <DataGridTextColumn Header="POSITION" Binding="{Binding Position}" Width="100"/>
                            <DataGridTextColumn Header="SIZE (MM)" Binding="{Binding SizeLabel}" Width="110"/>
                            <DataGridTextColumn Header="QTY" Binding="{Binding QtyLabel}" Width="60"/>
                            <DataGridTextColumn Header="TREAT" Binding="{Binding Treatment}" Width="110"/>
                            <DataGridTextColumn Header="METRIC" Binding="{Binding MetricLabel}" Width="150"/>
                            <DataGridTextColumn Header="DETAILS" Binding="{Binding DetailLabel}" Width="1.4*"/>
                            <DataGridTextColumn Header="STATUS" Binding="{Binding StatusLabel}" Width="110"/>
                            <DataGridTemplateColumn Header="ACTIONS" Width="230">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Start"
                                                    Style="{StaticResource OutlinedPillButton}"
                                                    Command="{Binding DataContext.StartCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="4,2"
                                                    Padding="10,2"/>
                                            <Button Content="Complete"
                                                    Style="{StaticResource PrimaryPillButton}"
                                                    Command="{Binding DataContext.CompleteCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="4,2"
                                                    Padding="10,2"/>
                                            <Button Content="Reopen"
                                                    Style="{StaticResource OutlinedPillButton}"
                                                    Command="{Binding DataContext.ReopenCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="4,2"
                                                    Padding="10,2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsQueueEmpty,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding Icon}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="44"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Opacity="0.6"/>
                        <TextBlock Text="No work distributed to this stage yet"
                                   FontSize="{StaticResource TextSubhead}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,4"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="Release a Job Order above — production runs exclusively from confirmed (Approved) PIs converted to Job Orders. Drafts never reach the floor. Specs are read from Step 4/5 and work-type quantities from Step 6."
                                   FontSize="{StaticResource TextBody}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="480"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
