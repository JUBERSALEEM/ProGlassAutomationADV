<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Production/ProductionStageView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Production — shared stage-queue screen (Phase 3, 2026-09-11)

     Hosted by all eight production module views. Binds to
     ProductionStageViewModelBase and renders:
       • the release bar — pick a Job Order / Approved PI and distribute
         it into this stage's queue (idempotent),
       • KPI chips — total / pending / in progress / completed / area,
       • job + status filters,
       • the work-item grid with Start / Complete / Reopen floor actions.

     Work arrives here from ProductionDistributionEngine — specs read from
     Step 4/5 and work-type quantities from Step 6. See
     docs/PRODUCTION_DISTRIBUTION_PLAN_2026-09-11.md.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Production.ProductionStageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="OnViewLoaded">

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Header + release bar ══════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="4,4,4,12">
            <Grid Margin="4,0,4,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding ModuleName}"
                               Style="{StaticResource ModulePageTitleStyle}"/>
                    <TextBlock Text="{Binding Description}"
                               Style="{StaticResource ModulePageSubtitleStyle}"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource OutlinedPillButton}"
                        Command="{Binding RefreshCommand}"
                        Tag="&#xE72C;"
                        Content="Refresh"
                        MinWidth="140"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- Release bar -->
            <Border Style="{StaticResource ModuleListShellStyle}" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding Sources}"
                              SelectedItem="{Binding SelectedSource}"
                              DisplayMemberPath="DisplayLabel"
                              Style="{StaticResource ModuleListFilterComboStyle}"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              ToolTip="Released Job Orders and Approved Proforma Invoices"/>
                    <Button Grid.Column="1"
                            Style="{StaticResource PrimaryPillButton}"
                            Command="{Binding ReleaseCommand}"
                            Tag="&#xE768;"
                            Content="Release to Production"
                            MinWidth="210"/>
                </Grid>
            </Border>

            <TextBlock Text="{Binding ReleaseMessage}"
                       Margin="8,8,8,0"
                       TextWrapping="Wrap"
                       FontSize="{StaticResource TextBody}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ReleaseSucceeded}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- ══ Shell: KPIs + filters + grid ══════════════════════════ -->
        <Border Grid.Row="1" Grid.RowSpan="3"
                Style="{StaticResource ModuleListShellStyle}" Margin="4,0,4,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- KPI strip -->
                <Border Grid.Row="0" Style="{StaticResource ModuleListKpiStripStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="In queue" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                            <TextBlock Text="{Binding TotalCount}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource ModuleListKpiDividerStyle}"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Pending" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                            <TextBlock Text="{Binding PendingCount}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                        </StackPanel>
                        <Border Grid.Column="3" Style="{StaticResource ModuleListKpiDividerStyle}"/>
                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <TextBlock Text="In progress" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                            <TextBlock Text="{Binding InProgressCount}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                        </StackPanel>
                        <Border Grid.Column="5" Style="{StaticResource ModuleListKpiDividerStyle}"/>
                        <StackPanel Grid.Column="6" VerticalAlignment="Center">
                            <TextBlock Text="Completed" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                            <TextBlock Text="{Binding CompletedCount}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                        </StackPanel>
                        <Border Grid.Column="7" Style="{StaticResource ModuleListKpiDividerStyle}"/>
                        <StackPanel Grid.Column="8" VerticalAlignment="Center">
                            <TextBlock Text="Load" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                            <TextBlock Text="{Binding AreaTotalLabel}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                            <TextBlock Text="{Binding MetricTotalLabel}" Style="{StaticResource ModuleListKpiHintStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Filter bar -->
                <Border Grid.Row="1" Style="{StaticResource ModuleListFilterBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding JobFilters}"
                                  SelectedItem="{Binding SelectedJobFilter}"
                                  Style="{StaticResource ModuleListFilterComboStyle}"
                                  Margin="0,0,8,0"
                                  ToolTip="Filter by released job"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding StatusFilters}"
                                  SelectedItem="{Binding SelectedStatusFilter}"
                                  Style="{StaticResource ModuleListFilterComboStyle}"/>
                    </Grid>
                </Border>

                <!-- Queue grid -->
                <Grid Grid.Row="2">
                    <DataGrid ItemsSource="{Binding Queue}"
                              Style="{StaticResource GodViewGridStyle}"
                              ColumnHeaderStyle="{StaticResource GodViewHeaderStyle}"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="JOB" Binding="{Binding JobRef}" Width="120"/>
                            <DataGridTextColumn Header="SPECIFICATION" Binding="{Binding SpecLabel}" Width="1.7*"/>
                            <DataGridTextColumn Header="REF" Binding="{Binding GlassRef}" Width="90"/>
                            <DataGridTextColumn Header="POSITION" Binding="{Binding Position}" Width="100"/>
                            <DataGridTextColumn Header="SIZE (MM)" Binding="{Binding SizeLabel}" Width="110"/>
                            <DataGridTextColumn Header="QTY" Binding="{Binding QtyLabel}" Width="60"/>
                            <DataGridTextColumn Header="TREAT" Binding="{Binding Treatment}" Width="110"/>
                            <DataGridTextColumn Header="METRIC" Binding="{Binding MetricLabel}" Width="150"/>
                            <DataGridTextColumn Header="DETAILS" Binding="{Binding DetailLabel}" Width="1.4*"/>
                            <DataGridTextColumn Header="STATUS" Binding="{Binding StatusLabel}" Width="110"/>
                            <DataGridTemplateColumn Header="ACTIONS" Width="230">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Start"
                                                    Style="{StaticResource OutlinedPillButton}"
                                                    Command="{Binding DataContext.StartCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="4,2"
                                                    Padding="10,2"/>
                                            <Button Content="Complete"
                                                    Style="{StaticResource PrimaryPillButton}"
                                                    Command="{Binding DataContext.CompleteCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="4,2"
                                                    Padding="10,2"/>
                                            <Button Content="Reopen"
                                                    Style="{StaticResource OutlinedPillButton}"
                                                    Command="{Binding DataContext.ReopenCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="4,2"
                                                    Padding="10,2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsQueueEmpty,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding Icon}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="44"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Opacity="0.6"/>
                        <TextBlock Text="No work distributed to this stage yet"
                                   FontSize="{StaticResource TextSubhead}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,4"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="Release a Job Order or an Approved Proforma Invoice above — specs are read from Step 4/5 and work-type quantities from Step 6."
                                   FontSize="{StaticResource TextBody}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="460"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
