<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Production/ProductionStageView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Production — shared stage body, screens redesign 2026-09-11

     Hosted by all eight production module views (each module owns its
     own stage-identity header; this control is the shared body).

     Renders, top to bottom:
       • PIPELINE CHAIN BAR — the whole eight-stage chain with live
         factory-wide counts; the current stage is highlighted and any
         chip navigates straight to its module, so work can be followed
         stage by stage like a production chain.
       • release bar — work comes EXCLUSIVELY from confirmed Job Orders.
       • floor-connectivity warning (completing before the predecessor).
       • KPI strip + search/job/status filters.
       • master–detail body:
           Tier 1 — unit list shaped like the Step 5 grid (Job / PI No,
                    Customer, Salesman, Ref, W1/H1 + W2/H2, Qty, SQM,
                    Total SQM, LM, progress; charge work as "(whole
                    spec)" batch rows).
           Tier 2 — unit detail with Open Job Order / Open Proforma
                    Invoice cross-navigation and pane-level items with
                    Start / Complete / Reopen actions.

     See docs/PRODUCTION_SCREENS_DESIGN_2026-09-11.md.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Production.ProductionStageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="OnViewLoaded">

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Pipeline chain bar — the whole production chain ═══════ -->
        <Border Grid.Row="0"
                CornerRadius="{DynamicResource CardCornerRadius}"
                Background="{DynamicResource DashAmbientBrush}"
                Padding="12,10"
                Margin="4,0,4,10">
            <StackPanel>
                <Grid>
                    <TextBlock Text="PRODUCTION PIPELINE"
                               FontSize="{StaticResource TextCaption}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock Text="Click a stage to follow the work"
                               FontSize="{StaticResource TextCaption}"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               HorizontalAlignment="Right"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding ChainStages}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Cursor="Hand"
                                    Margin="0,0,8,6"
                                    Command="{Binding DataContext.OpenStageCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding NavKey}"
                                    ToolTip="{Binding CountLabel}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ChipBorder"
                                                CornerRadius="10"
                                                Padding="10,6"
                                                Background="{DynamicResource ModuleBackgroundBrush}"
                                                BorderBrush="{DynamicResource GlassBorderGradientSoft}"
                                                BorderThickness="1"
                                                SnapsToDevicePixels="True">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Ordinal}"
                                                           FontSize="{StaticResource TextCaption}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Icon}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="15"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="{StaticResource TextCaption}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                    <TextBlock Text="{Binding CountLabel}"
                                                               FontSize="{StaticResource TextXSmall}"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ChipBorder" Property="BorderBrush"
                                                        Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter TargetName="ChipBorder" Property="Background"
                                                        Value="{DynamicResource ElevatedSurfaceBrush}"/>
                                                <Setter TargetName="ChipBorder" Property="BorderBrush"
                                                        Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="ChipBorder" Property="BorderThickness" Value="1.5"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasWork}" Value="False">
                                                <Setter TargetName="ChipBorder" Property="Opacity" Value="0.55"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ══ Release bar + connectivity warning ════════════════════ -->
        <StackPanel Grid.Row="1" Margin="4,0,4,10">
            <Border Style="{StaticResource ModuleListShellStyle}" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Release from Job Order"
                               FontSize="{StaticResource TextBody}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Sources}"
                              SelectedItem="{Binding SelectedSource}"
                              DisplayMemberPath="DisplayLabel"
                              Style="{StaticResource ModuleListFilterComboStyle}"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              ToolTip="Released / In-Production Job Orders (confirmed PIs only — drafts never reach the floor)"/>
                    <Button Grid.Column="2"
                            Style="{StaticResource PrimaryPillButton}"
                            Command="{Binding ReleaseCommand}"
                            Tag="&#xE768;"
                            Content="Release to Production"
                            MinWidth="210"
                            Margin="0,0,8,0"/>
                    <Button Grid.Column="3"
                            Style="{StaticResource OutlinedPillButton}"
                            Command="{Binding RefreshCommand}"
                            Tag="&#xE72C;"
                            Content="Refresh"
                            MinWidth="120"/>
                </Grid>
            </Border>

            <TextBlock Text="{Binding ReleaseMessage}"
                       Margin="8,8,8,0"
                       TextWrapping="Wrap"
                       FontSize="{StaticResource TextBody}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ReleaseSucceeded}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Floor connectivity warning (complete before predecessor) -->
            <Border Margin="0,8,0,0"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Background="{DynamicResource TintAmberBrush}"
                    Padding="12,8"
                    Visibility="{Binding HasActionWarning,
                                 Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="{StaticResource TextBody}"
                               Foreground="{DynamicResource WarningBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ActionWarning}"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource TextBody}"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ══ Shell: KPIs + filters + master–detail body ════════════ -->
        <Border Grid.Row="2"
                Style="{StaticResource ModuleListShellStyle}" Margin="4,0,4,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- KPI strip -->
                <Border Grid.Row="0" Style="{StaticResource ModuleListKpiStripStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintBlueBrush}">
                                <TextBlock Text="&#xE8C6;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSubhead}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="In queue" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding TotalCount}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintAmberBrush}">
                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSubhead}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Pending" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding PendingCount}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="3" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintIndigoBrush}">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSubhead}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="In progress" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding InProgressCount}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="5" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintGreenBrush}">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSubhead}"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Completed" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding CompletedCount}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="7" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintPurpleBrush}">
                                <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSubhead}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Load" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding AreaTotalLabel}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="{Binding MetricTotalLabel}" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="9" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <StackPanel Grid.Column="10" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintGreenBrush}">
                                <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSubhead}"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Ready for dispatch" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding UnitsReadyLabel}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Filter bar: search + job + status -->
                <Border Grid.Row="1" Style="{StaticResource ModuleListFilterBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Search Ref / customer / job / spec / salesman"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding JobFilters}"
                                  SelectedItem="{Binding SelectedJobFilter}"
                                  Style="{StaticResource ModuleListFilterComboStyle}"
                                  Margin="0,0,8,0"
                                  ToolTip="Filter by released job"/>
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding StatusFilters}"
                                  SelectedItem="{Binding SelectedStatusFilter}"
                                  Style="{StaticResource ModuleListFilterComboStyle}"
                                  ToolTip="Filter by stage status"/>
                    </Grid>
                </Border>

                <!-- Waiting-upstream strip (tool-chain backlog) -->
                <Border Grid.Row="2"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Background="{DynamicResource TintIndigoBrush}"
                        Padding="10,6"
                        Margin="12,4,12,0"
                        Visibility="{Binding HasWaitingUpstream,
                                     Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE823;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding WaitingUpstreamLabel}"
                                   TextWrapping="Wrap"
                                   FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </StackPanel>
                </Border>

                <!-- ══ Master–detail body ════════════════════════════ -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="470" MinWidth="420"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── Tier 1 · unit list (Step-5 shaped rows) ── -->
                    <Grid Grid.Column="0">
                        <DataGrid ItemsSource="{Binding ListRows}"
                                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                  Style="{StaticResource GodViewGridStyle}"
                                  ColumnHeaderStyle="{StaticResource GodViewHeaderStyle}"
                                  SelectionMode="Single"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="ST" Width="42">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusGlyph}" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusLabel}" Value="IN PROGRESS">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusLabel}" Value="COMPLETED">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="JOB" Binding="{Binding JobRef}" Width="120"/>
                                <DataGridTextColumn Header="PI NO" Binding="{Binding PiNo}" Width="110"/>
                                <DataGridTextColumn Header="CUSTOMER" Binding="{Binding Customer}" Width="1.3*"/>
                                <DataGridTextColumn Header="SALESMAN" Binding="{Binding Salesman}" Width="120"/>
                                <DataGridTextColumn Header="SPEC" Binding="{Binding SpecLabel}" Width="1.5*"/>
                                <DataGridTextColumn Header="SR" Binding="{Binding SerialLabel}" Width="50"/>
                                <DataGridTextColumn Header="REF" Binding="{Binding GlassRef}" Width="90"/>
                                <DataGridTextColumn Header="BUILD" Binding="{Binding BuildType}" Width="90"/>
                                <DataGridTextColumn Header="W1" Binding="{Binding W1Label}" Width="60"/>
                                <DataGridTextColumn Header="H1" Binding="{Binding H1Label}" Width="60"/>
                                <DataGridTextColumn Header="W2" Binding="{Binding W2Label}" Width="60"/>
                                <DataGridTextColumn Header="H2" Binding="{Binding H2Label}" Width="60"/>
                                <DataGridTextColumn Header="QTY" Binding="{Binding QtyLabel}" Width="55"/>
                                <DataGridTextColumn Header="SQM1" Binding="{Binding Sqm1Label}" Width="70"/>
                                <DataGridTextColumn Header="TOT SQM1" Binding="{Binding TotalSqm1Label}" Width="85"/>
                                <DataGridTextColumn Header="LM1" Binding="{Binding Lm1Label}" Width="70"/>
                                <DataGridTextColumn Header="SQM2" Binding="{Binding Sqm2Label}" Width="70"/>
                                <DataGridTextColumn Header="TOT SQM2" Binding="{Binding TotalSqm2Label}" Width="85"/>
                                <DataGridTextColumn Header="LM2" Binding="{Binding Lm2Label}" Width="70"/>
                                <DataGridTextColumn Header="IN" Binding="{Binding InflowLabel}" Width="55"/>
                                <DataGridTextColumn Header="DONE" Binding="{Binding DoneLabel}" Width="60"/>
                                <DataGridTextColumn Header="BALANCE" Binding="{Binding BalanceLabel}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty state -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsListEmpty,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding Icon}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="44"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Opacity="0.6"/>
                            <TextBlock Text="No work in this stage yet"
                                       FontSize="{StaticResource TextSubhead}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,4"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="Production runs like a tool chain: every unit enters at Cutting and its row moves to the next module only when the previous stage is complete. Release a Job Order above to feed the chain — work arrives exclusively from confirmed (Approved) PIs converted to Job Orders."
                                       FontSize="{StaticResource TextBody}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="480"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>
                    </Grid>

                    <GridSplitter Grid.Column="1" Width="4"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Stretch"
                                  Background="Transparent"/>

                    <!-- ── Tier 2 · unit detail ────────────────────── -->
                    <Border Grid.Column="2"
                            Style="{StaticResource SurfaceSecondaryStyle}"
                            Margin="6,6,6,6"
                            Padding="14">

                        <!-- No-selection hint -->
                        <StackPanel VerticalAlignment="Center"
                                    Visibility="{Binding HasSelection,
                                                 Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="&#xE8F1;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="40"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Opacity="0.6"/>
                            <TextBlock Text="Select a unit to open its detail"
                                       FontSize="{StaticResource TextSubhead}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,4"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="The detail panel shows the job, salesman, pane sizes and this stage's work items with floor actions — plus buttons to open the source Job Order or Proforma Invoice."
                                       FontSize="{StaticResource TextBody}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>

                        <!-- Selected unit / batch -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasSelection,
                                                   Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>

                                <!-- Job header + cross-navigation -->
                                <TextBlock Text="JOB" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Style="{StaticResource PrimaryPillButton}"
                                            Command="{Binding OpenJobOrderCommand}"
                                            Tag="&#xE8A5;"
                                            Content="Open Job Order"
                                            Margin="0,0,8,0"
                                            ToolTip="Open the source Job Order this work was released from"/>
                                    <Button Style="{StaticResource OutlinedPillButton}"
                                            Command="{Binding OpenProformaCommand}"
                                            Tag="&#xE8A7;"
                                            Content="Open Proforma Invoice"
                                            ToolTip="Open the confirmed PI (check Step 5 sizes / Step 6 charges)"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Job No" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedJobNo}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="12,2,0,2"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="PI No" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedPiNo}" FontSize="{StaticResource TextBody}"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="12,2,0,2"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Customer" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedCustomer}" FontSize="{StaticResource TextBody}"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap" Margin="12,2,0,2"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Project" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,2"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedProject}" FontSize="{StaticResource TextBody}"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap" Margin="12,2,0,2"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Salesman" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,2"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedSalesman}" FontSize="{StaticResource TextBody}"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="12,2,0,2"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Spec / Ref" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,2"/>
                                    <StackPanel Grid.Row="5" Grid.Column="1" Margin="12,2,0,2">
                                        <TextBlock Text="{Binding SelectedSpecLabel}" FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SelectedRef}" FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Sizes" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,2"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedSizeSummary}" FontSize="{StaticResource TextBody}"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap" Margin="12,2,0,2"/>

                                </Grid>

                                <!-- Pane-level stage items — piece flow editor -->
                                <ItemsControl ItemsSource="{Binding SelectedStageItems}" Margin="0,14,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="{DynamicResource CardCornerRadius}"
                                                    Background="{DynamicResource DashAmbientBrush}"
                                                    Padding="12,10"
                                                    Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Position}"
                                                                           FontSize="{StaticResource TextBody}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                                <TextBlock Text=" · "
                                                                           FontSize="{StaticResource TextBody}"
                                                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                                <TextBlock Text="{Binding SizeLabel}"
                                                                           FontSize="{StaticResource TextBody}"
                                                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                                <TextBlock Text=" · "
                                                                           FontSize="{StaticResource TextBody}"
                                                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                                <TextBlock Text="{Binding QtyLabel, StringFormat='Qty {0}'}"
                                                                           FontSize="{StaticResource TextBody}"
                                                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding DetailLabel}"
                                                                       FontSize="{StaticResource TextBody}"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                                                       Margin="0,2,0,0"/>
                                                            <TextBlock Text="{Binding ChargeLabel}"
                                                                       FontSize="{StaticResource TextBody}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding StatusLabel}"
                                                                   FontSize="{StaticResource TextCaption}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="IN PROGRESS">
                                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="COMPLETED">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>

                                                    <!-- Pieces: arrived / done / balance -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <Border CornerRadius="8" Background="{DynamicResource ModuleBackgroundBrush}" Padding="10,4" Margin="0,0,6,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="IN " FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                                           Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding InflowLabel}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border CornerRadius="8" Background="{DynamicResource ModuleBackgroundBrush}" Padding="10,4" Margin="0,0,6,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="DONE " FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                                           Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding DoneLabel}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource SuccessBrush}"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border CornerRadius="8" Background="{DynamicResource ModuleBackgroundBrush}" Padding="10,4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="BALANCE " FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                                           Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding BalanceLabel}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource WarningBrush}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Floor input: pieces completed at this stage -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                                Visibility="{Binding CanWork,
                                                                             Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="Done pcs"
                                                                   FontSize="{StaticResource TextBody}"
                                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"/>
                                                        <TextBox Text="{Binding DoneInput, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="70"
                                                                 VerticalContentAlignment="Center"
                                                                 ToolTip="Pieces completed at this stage (cannot exceed IN)"/>
                                                        <Button Content="Save"
                                                                Style="{StaticResource PrimaryPillButton}"
                                                                Command="{Binding DataContext.SaveQtyCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Margin="8,0,0,0" Padding="14,2"
                                                                ToolTip="Save the done-piece count — only completed pieces move to the next stage"/>
                                                        <Button Content="All"
                                                                Style="{StaticResource OutlinedPillButton}"
                                                                Command="{Binding DataContext.CompleteAllCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Margin="6,0,0,0" Padding="12,2"
                                                                ToolTip="Complete every piece that arrived"/>
                                                        <Button Content="Reset"
                                                                Style="{StaticResource OutlinedPillButton}"
                                                                Command="{Binding DataContext.ResetQtyCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Margin="6,0,0,0" Padding="12,2"
                                                                ToolTip="Set done pieces back to zero"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
