<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Production/ProductionStageView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Production — shared stage screen, screens redesign 2026-09-11

     Hosted by all eight production module views. Binds to
     ProductionStageViewModelBase and renders a two-tier master–detail:

       TIER 1 — UNIT LIST (left): one row per unit shaped like the
                Step 5 grid the estimator built — Job / PI No, Salesman,
                Ref, W1·H1 + W2·H2, Qty, Unit SQM, Total SQM, LM and
                this stage's progress. Charge work (fan holes, polish LM,
                mitring LM) appears as "(whole spec)" batch rows.

       TIER 2 — UNIT DETAIL (right): job header with customer / project /
                salesman plus OPEN JOB ORDER and OPEN PROFORMA INVOICE
                cross-navigation (Step 5/6 checking), and the pane-level
                stage items with Start / Complete / Reopen floor actions.

     Source lock: work arrives ONLY from confirmed Job Orders. See
     docs/PRODUCTION_SCREENS_DESIGN_2026-09-11.md.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Production.ProductionStageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="OnViewLoaded">

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Stage identity header + release bar ═══════════════════ -->
        <StackPanel Grid.Row="0" Margin="4,4,4,12">
            <Grid Margin="4,0,4,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Stage icon tile (tinted per stage — resolved from
                     StageTintBrushKey in code-behind, WPF cannot bind a
                     DynamicResource key) -->
                <Border x:Name="StageIconTile"
                        Grid.Column="0"
                        Width="52" Height="52"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Background="{DynamicResource TintBlueBrush}"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0">
                    <TextBlock Text="{Binding Icon}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="24"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ModuleName}"
                                   Style="{StaticResource ModulePageTitleStyle}"/>
                        <Border CornerRadius="9"
                                Background="{DynamicResource DashAmbientBrush}"
                                Padding="10,3"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding StageOrdinalLabel}"
                                       FontSize="{StaticResource TextCaption}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}"
                               Style="{StaticResource ModulePageSubtitleStyle}"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Style="{StaticResource OutlinedPillButton}"
                        Command="{Binding RefreshCommand}"
                        Tag="&#xE72C;"
                        Content="Refresh"
                        MinWidth="140"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- Release bar — Job Orders only (confirmed PIs) -->
            <Border Style="{StaticResource ModuleListShellStyle}" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Release from Job Order"
                               FontSize="{StaticResource TextBody}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Sources}"
                              SelectedItem="{Binding SelectedSource}"
                              DisplayMemberPath="DisplayLabel"
                              Style="{StaticResource ModuleListFilterComboStyle}"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              ToolTip="Released / In-Production Job Orders (confirmed PIs only — drafts never reach the floor)"/>
                    <Button Grid.Column="2"
                            Style="{StaticResource PrimaryPillButton}"
                            Command="{Binding ReleaseCommand}"
                            Tag="&#xE768;"
                            Content="Release to Production"
                            MinWidth="210"/>
                </Grid>
            </Border>

            <TextBlock Text="{Binding ReleaseMessage}"
                       Margin="8,8,8,0"
                       TextWrapping="Wrap"
                       FontSize="{StaticResource TextBody}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ReleaseSucceeded}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Floor connectivity warning (complete before predecessor) -->
            <Border Margin="0,8,0,0"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Background="{DynamicResource TintAmberBrush}"
                    Padding="12,8"
                    Visibility="{Binding HasActionWarning,
                                 Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="{StaticResource TextBody}"
                               Foreground="{DynamicResource WarningBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ActionWarning}"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource TextBody}"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ══ Shell: KPIs + filters + master–detail body ════════════ -->
        <Border Grid.Row="1"
                Style="{StaticResource ModuleListShellStyle}" Margin="4,0,4,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- KPI strip -->
                <Border Grid.Row="0" Style="{StaticResource ModuleListKpiStripStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintBlueBrush}">
                                <TextBlock Text="&#xE8C6;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSubhead}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="In queue" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding TotalCount}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintAmberBrush}">
                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSubhead}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Pending" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding PendingCount}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="3" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintIndigoBrush}">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSubhead}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="In progress" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding InProgressCount}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="5" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintGreenBrush}">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSubhead}"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Completed" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding CompletedCount}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="7" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintPurpleBrush}">
                                <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSubhead}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Load" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding AreaTotalLabel}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="{Binding MetricTotalLabel}" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="9" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <StackPanel Grid.Column="10" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintGreenBrush}">
                                <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSubhead}"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Ready for dispatch" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding UnitsReadyLabel}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Filter bar: search + job + status -->
                <Border Grid.Row="1" Style="{StaticResource ModuleListFilterBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Search Ref / customer / job / spec / salesman"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding JobFilters}"
                                  SelectedItem="{Binding SelectedJobFilter}"
                                  Style="{StaticResource ModuleListFilterComboStyle}"
                                  Margin="0,0,8,0"
                                  ToolTip="Filter by released job"/>
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding StatusFilters}"
                                  SelectedItem="{Binding SelectedStatusFilter}"
                                  Style="{StaticResource ModuleListFilterComboStyle}"
                                  ToolTip="Filter by stage status"/>
                    </Grid>
                </Border>

                <!-- ══ Master–detail body ════════════════════════════ -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="470" MinWidth="420"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── Tier 1 · unit list (Step-5 shaped rows) ── -->
                    <Grid Grid.Column="0">
                        <DataGrid ItemsSource="{Binding ListRows}"
                                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                  Style="{StaticResource GodViewGridStyle}"
                                  ColumnHeaderStyle="{StaticResource GodViewHeaderStyle}"
                                  SelectionMode="Single"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="ST" Width="42">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusGlyph}" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusLabel}" Value="IN PROGRESS">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusLabel}" Value="COMPLETED">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="JOB" Binding="{Binding JobRef}" Width="120"/>
                                <DataGridTextColumn Header="PI NO" Binding="{Binding PiNo}" Width="110"/>
                                <DataGridTextColumn Header="CUSTOMER" Binding="{Binding Customer}" Width="1.3*"/>
                                <DataGridTextColumn Header="SALESMAN" Binding="{Binding Salesman}" Width="120"/>
                                <DataGridTextColumn Header="SPEC" Binding="{Binding SpecLabel}" Width="1.5*"/>
                                <DataGridTextColumn Header="REF" Binding="{Binding GlassRef}" Width="90"/>
                                <DataGridTextColumn Header="BUILD" Binding="{Binding BuildType}" Width="90"/>
                                <DataGridTextColumn Header="W1" Binding="{Binding W1Label}" Width="60"/>
                                <DataGridTextColumn Header="H1" Binding="{Binding H1Label}" Width="60"/>
                                <DataGridTextColumn Header="W2" Binding="{Binding W2Label}" Width="60"/>
                                <DataGridTextColumn Header="H2" Binding="{Binding H2Label}" Width="60"/>
                                <DataGridTextColumn Header="QTY" Binding="{Binding QtyLabel}" Width="55"/>
                                <DataGridTextColumn Header="SQM" Binding="{Binding UnitSqmLabel}" Width="70"/>
                                <DataGridTextColumn Header="TOT SQM" Binding="{Binding TotalSqmLabel}" Width="85"/>
                                <DataGridTextColumn Header="LM" Binding="{Binding LmLabel}" Width="70"/>
                                <DataGridTextColumn Header="STAGE" Binding="{Binding ProgressLabel}" Width="90"/>
                                <DataGridTextColumn Header="CHARGE" Binding="{Binding MetricLabel}" Width="170"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty state -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding IsListEmpty,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding Icon}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="44"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Opacity="0.6"/>
                            <TextBlock Text="No work distributed to this stage yet"
                                       FontSize="{StaticResource TextSubhead}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,4"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="Release a Job Order above — production runs exclusively from confirmed (Approved) PIs converted to Job Orders. Drafts never reach the floor. Specs are read from Step 4/5 and work-type quantities from Step 6."
                                       FontSize="{StaticResource TextBody}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="480"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>
                    </Grid>

                    <GridSplitter Grid.Column="1" Width="4"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Stretch"
                                  Background="Transparent"/>

                    <!-- ── Tier 2 · unit detail ────────────────────── -->
                    <Border Grid.Column="2"
                            Style="{StaticResource SurfaceSecondaryStyle}"
                            Margin="6,6,6,6"
                            Padding="14">

                        <!-- No-selection hint -->
                        <StackPanel VerticalAlignment="Center"
                                    Visibility="{Binding HasSelection,
                                                 Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="&#xE8F1;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="40"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Opacity="0.6"/>
                            <TextBlock Text="Select a unit to open its detail"
                                       FontSize="{StaticResource TextSubhead}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,4"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="The detail panel shows the job, salesman, pane sizes and this stage's work items with floor actions — plus buttons to open the source Job Order or Proforma Invoice."
                                       FontSize="{StaticResource TextBody}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>

                        <!-- Selected unit / batch -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasSelection,
                                                   Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>

                                <!-- Job header + cross-navigation -->
                                <TextBlock Text="JOB" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Style="{StaticResource PrimaryPillButton}"
                                            Command="{Binding OpenJobOrderCommand}"
                                            Tag="&#xE8A5;"
                                            Content="Open Job Order"
                                            Margin="0,0,8,0"
                                            ToolTip="Open the source Job Order this work was released from"/>
                                    <Button Style="{StaticResource OutlinedPillButton}"
                                            Command="{Binding OpenProformaCommand}"
                                            Tag="&#xE8A7;"
                                            Content="Open Proforma Invoice"
                                            ToolTip="Open the confirmed PI (check Step 5 sizes / Step 6 charges)"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Job No" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedJobNo}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="12,2,0,2"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="PI No" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedPiNo}" FontSize="{StaticResource TextBody}"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="12,2,0,2"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Customer" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedCustomer}" FontSize="{StaticResource TextBody}"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap" Margin="12,2,0,2"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Project" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,2"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedProject}" FontSize="{StaticResource TextBody}"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap" Margin="12,2,0,2"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Salesman" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,2"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedSalesman}" FontSize="{StaticResource TextBody}"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="12,2,0,2"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Spec / Ref" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,2"/>
                                    <StackPanel Grid.Row="5" Grid.Column="1" Margin="12,2,0,2">
                                        <TextBlock Text="{Binding SelectedSpecLabel}" FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SelectedRef}" FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Sizes" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,2"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedSizeSummary}" FontSize="{StaticResource TextBody}"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap" Margin="12,2,0,2"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Charge" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,2"
                                               Visibility="{Binding IsBatchSelection,
                                                            Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedBatchMetric}" FontSize="{StaticResource TextBody}"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap" Margin="12,2,0,2"
                                               Visibility="{Binding IsBatchSelection,
                                                            Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>

                                <!-- Pane-level stage items -->
                                <TextBlock Text="STAGE ITEMS" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,14,0,6"/>
                                <DataGrid ItemsSource="{Binding SelectedStageItems}"
                                          Style="{StaticResource GodViewGridStyle}"
                                          ColumnHeaderStyle="{StaticResource GodViewHeaderStyle}"
                                          SelectionMode="Single"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          MaxHeight="340">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="POS" Binding="{Binding Position}" Width="70"/>
                                        <DataGridTextColumn Header="TREATMENT" Binding="{Binding Treatment}" Width="*"/>
                                        <DataGridTextColumn Header="SIZE (MM)" Binding="{Binding SizeLabel}" Width="110"/>
                                        <DataGridTextColumn Header="QTY" Binding="{Binding QtyLabel}" Width="50"/>
                                        <DataGridTextColumn Header="SQM" Binding="{Binding SqmLabel}" Width="70"/>
                                        <DataGridTextColumn Header="LM" Binding="{Binding LmLabel}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Detail (sub-type / notes / predecessor) + status -->
                                <ItemsControl ItemsSource="{Binding SelectedStageItems}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="{DynamicResource CardCornerRadius}"
                                                    Background="{DynamicResource DashAmbientBrush}"
                                                    Padding="10,8"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Position}"
                                                                       FontSize="{StaticResource TextBody}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                            <TextBlock Text=" · "
                                                                       FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                            <TextBlock Text="{Binding DetailLabel}"
                                                                       FontSize="{StaticResource TextBody}"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding StatusLabel}"
                                                                   FontSize="{StaticResource TextCaption}"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,2,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="IN PROGRESS">
                                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="COMPLETED">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="Start"
                                                                Style="{StaticResource OutlinedPillButton}"
                                                                Command="{Binding DataContext.StartCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding CanStart,
                                                                             Converter={StaticResource BoolToVisibilityConverter}}"
                                                                Margin="4,0" Padding="10,2"/>
                                                        <Button Content="Complete"
                                                                Style="{StaticResource PrimaryPillButton}"
                                                                Command="{Binding DataContext.CompleteCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding CanComplete,
                                                                             Converter={StaticResource BoolToVisibilityConverter}}"
                                                                Margin="4,0" Padding="10,2"/>
                                                        <Button Content="Reopen"
                                                                Style="{StaticResource OutlinedPillButton}"
                                                                Command="{Binding DataContext.ReopenCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding CanReopen,
                                                                             Converter={StaticResource BoolToVisibilityConverter}}"
                                                                Margin="4,0" Padding="10,2"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
