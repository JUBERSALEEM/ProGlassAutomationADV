<UserControl x:Class="ProGlassAutomation.Views.Production.Controls.ProductionStationBody"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:production="clr-namespace:ProGlassAutomation.Views.Production.Controls"
             xmlns:util="clr-namespace:ProGlassAutomation.Utilities"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="{DynamicResource Ov.Canvas}">
    <!-- 2026-09-14: STANDARDIZED COLUMN ALIGNMENT for every station grid.
         Rule (app-wide): header content alignment always matches cell
         content alignment — counts center, free text left, both
         vertically centered. The CUSTOMER column is the star filler so
         the table spans the container width exactly (no left-bunching,
         no dead right space). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Dashboard/Overview/IndigoStudioResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="StationCenterHeaderStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource GodViewHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StationCenterTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StationLeftTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
            </ResourceDictionary>
    </UserControl.Resources>
    <Border Margin="24,0,24,20">
        <!-- 2026-09-14: the detail is a FULL PAGE again. It used to render
             as a 360px side panel, so double-clicking a row shrank the
             list ("the sidebar data gets removed") and cramped the
             OUTER/INNER grids. Now: double-click swaps the list for the
             full-width detail page (CLOSE returns); the list keeps its
             columns and width. -->
        <Grid>
            <Grid Visibility="{Binding IsDetailOpen, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <production:ProductionKpiStrip Grid.Row="0"/>
                <production:ProductionFilterBar Grid.Row="1"/>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid CanUserReorderColumns="False" CanUserResizeColumns="False" Grid.Row="0" x:Name="MasterGrid" RowHeight="48"
                              Visibility="{Binding ShowListTotals, Converter={StaticResource BoolToVisibilityConverter}}"
                              ItemsSource="{Binding ListRows}"
                              SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                              Style="{StaticResource GodViewGridStyle}"
                              ColumnHeaderStyle="{StaticResource GodViewHeaderStyle}"
                              SelectionMode="Single" CanUserAddRows="False" IsReadOnly="True"
                              EnableRowVirtualization="True" EnableColumnVirtualization="False"
                              FrozenColumnCount="3"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              ScrollViewer.CanContentScroll="False"
                              ScrollViewer.ScrollChanged="MasterGrid_ScrollChanged">
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick"
                                          Command="{Binding OpenUnitCommand}"
                                          CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                        </DataGrid.InputBindings>

                        <!-- COLUMN BINDING INFRASTRUCTURE (2026-09-18, owner report:
                             "cutting section qty after job no still not visible").
                             A DataGridColumn lives in DataGrid.Columns, which is in
                             NEITHER the visual nor the logical tree, so a binding set
                             directly on a column property has no DataContext to
                             resolve against — wave 5's Header="{Binding …}" was
                             therefore still dead. A Freezable proxy inherits the
                             DataGrid's DataContext through WPF's inheritance context
                             and hands columns an explicit Source= binding, which
                             needs no tree at all. See Utilities/BindingProxy.cs. -->
                        <DataGrid.Resources>
                            <util:BindingProxy x:Key="StationVm" Data="{Binding}"/>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="#" Width="44" HeaderStyle="{StaticResource StationCenterHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding IndexLabel}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="JOB ORDER" Width="220" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" ToolTip="{Binding JobTitle}">
                                            <TextBlock Text="{Binding JobTitle}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding JobCaption}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- QTY sits beside the job, fixed width, literal header.
                                 A star-width column after GLASS/TREATMENT was virtualized
                                 away and its header binding never resolved, so the floor
                                 saw a blank "qty" column. -->
                            <DataGridTemplateColumn Header="QTY" Width="78" MinWidth="72"
                                                    HeaderStyle="{StaticResource StationCenterHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding InflowLabel}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   ToolTip="Pieces arrived at this station"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="CUSTOMER" Binding="{Binding Customer}" Width="*" MinWidth="140"/>
                            <DataGridTextColumn  Header="W×H" Binding="{Binding SizeLabel}" Width="118" ElementStyle="{StaticResource StationLeftTextStyle}"
                                 Visibility="{Binding Data.ShowSizeColumn, Source={StaticResource StationVm}, Converter={StaticResource BoolToVis}}"/>
                            <DataGridTextColumn  Header="GLASS" Binding="{Binding GlassLabel}" Width="150" ElementStyle="{StaticResource StationLeftTextStyle}"
                                 Visibility="{Binding Data.ShowGlassColumn, Source={StaticResource StationVm}, Converter={StaticResource BoolToVis}}"/>
                            <DataGridTextColumn  Header="TREATMENT" Binding="{Binding TreatmentLabel}" Width="130" ElementStyle="{StaticResource StationLeftTextStyle}"
                                 Visibility="{Binding Data.ShowTreatmentColumn, Source={StaticResource StationVm}, Converter={StaticResource BoolToVis}}"/>
                            <DataGridTextColumn  Header="LM" Binding="{Binding LmLabel}" Width="88" HeaderStyle="{StaticResource StationCenterHeaderStyle}" ElementStyle="{StaticResource StationCenterTextStyle}"
                                 Visibility="{Binding Data.ShowLmColumn, Source={StaticResource StationVm}, Converter={StaticResource BoolToVis}}"/>
                            <DataGridTextColumn  Header="LOAD" Binding="{Binding LoadLabel}" Width="88" HeaderStyle="{StaticResource StationCenterHeaderStyle}" ElementStyle="{StaticResource StationCenterTextStyle}"
                                 Visibility="{Binding Data.ShowLoadColumn, Source={StaticResource StationVm}, Converter={StaticResource BoolToVis}}"/>
                            <DataGridTextColumn  Header="MATCH" Binding="{Binding MatchLabel}" Width="110" HeaderStyle="{StaticResource StationCenterHeaderStyle}" ElementStyle="{StaticResource StationCenterTextStyle}"
                                 Visibility="{Binding Data.ShowMatchColumn, Source={StaticResource StationVm}, Converter={StaticResource BoolToVis}}"/>
                            <!-- Hidden duplicate of QTY. The visible column is the
                                 fixed QTY beside JOB NO. This one used a header
                                 binding that resolved empty and a star width that
                                 column-virtualization pushed off screen. Kept collapsed
                                 so the piece count is not shown twice. -->
                            <DataGridTemplateColumn Width="78" HeaderStyle="{StaticResource StationCenterHeaderStyle}" Visibility="Collapsed">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DataContext.InflowColumnHeader,
                                                     RelativeSource={RelativeSource AncestorType=DataGrid},
                                                     FallbackValue=QTY, TargetNullValue=QTY}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding InflowLabel}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="DONE" Width="72" HeaderStyle="{StaticResource StationCenterHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DoneLabel}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="BAL" Width="72" HeaderStyle="{StaticResource StationCenterHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding BalanceLabel}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="STATUS" Width="118">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="{DynamicResource ControlCornerRadius}" Padding="10,3"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}"/>
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="IN PROGRESS">
                                                            <Setter Property="Background" Value="{DynamicResource TintBlueBrush}"/>
                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="COMPLETED">
                                                            <Setter Property="Background" Value="{DynamicResource TintGreenBrush}"/>
                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding StatusGlyph}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                           FontWeight="{DynamicResource Weight.Bold}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                           FontWeight="{DynamicResource Weight.SemiBold}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1">
                        <Border Padding="10,5" Background="{DynamicResource SurfacePrimaryBrush}"
                                Visibility="{Binding HasListFooter, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding ListFooterLabel}" FontSize="{DynamicResource FontSize.BodySmall}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </Border>
                        <Border Style="{StaticResource LineItemsFooterStyle}" Padding="10,6"
                                Visibility="{Binding ShowListTotals, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="TOTALS" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="8,0,16,0"/>
                                <Viewbox MaxHeight="20" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding ListTotalSum}" Style="{StaticResource LineItemsReadonlyStyle}" FontWeight="{DynamicResource Weight.Bold}"/>
                                </Viewbox>
                                <Viewbox MaxHeight="20" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding ListDoneSum}" Style="{StaticResource LineItemsReadonlyStyle}" FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                </Viewbox>
                                <Viewbox MaxHeight="20">
                                    <TextBlock Text="{Binding ListBalanceSum}" Style="{StaticResource LineItemsReadonlyStyle}" FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource WarningBrush}"/>
                                </Viewbox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Loading station queue…" FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.SemiBold}"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Live work items from released Job Orders — not a preview."
                                   FontSize="{DynamicResource FontSize.Body}" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="560" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Could not load this station" FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.SemiBold}"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding LoadError}" FontSize="{DynamicResource FontSize.Body}" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="560" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ShowEmptyQueue, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding Icon}" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.Display}"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Opacity="0.6"/>
                        <TextBlock Text="{Binding EmptyQueueTitle}" FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.SemiBold}"
                                   HorizontalAlignment="Center" Margin="0,12,0,4"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding IndustryFocus}" FontSize="{DynamicResource FontSize.Body}" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="560" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- FULL-PAGE DETAIL — OUTER/INNER grids, SAVE DONE / COMPLETE
                 ALL, COMPLETED section, recent entries and the dispatch
                 panel all live here, at full width. CLOSE returns to the
                 list. -->
            <Border VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                    Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <production:ProductionUnitDetailControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
