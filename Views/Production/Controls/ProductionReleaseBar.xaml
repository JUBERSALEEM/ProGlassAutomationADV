<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Production/Controls/ProductionReleaseBar.xaml
     PROJECT: ProGlassAutomation
     MODULE: Production — shared release bar (chrome only)

     Work arrives EXCLUSIVELY from confirmed Job Orders (Released /
     In-Production, non-void). This bar picks a released JO, distributes
     it to the floor, and surfaces the release message plus any clamped
     floor-write warning. DataContext = ProductionStageViewModelBase.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Production.Controls.ProductionReleaseBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="{DynamicResource Ov.Canvas}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Dashboard/Overview/IndigoStudioResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="24,0,24,10">
        <Border Style="{StaticResource OptPanelCard}" Padding="14,12">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Release from Job Order"
                           FontSize="{DynamicResource FontSize.Body}"
                           FontWeight="{DynamicResource Weight.SemiBold}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,6,12,6"/>
                <ComboBox ItemsSource="{Binding Sources}"
                          SelectedItem="{Binding SelectedSource}"
                          DisplayMemberPath="DisplayLabel"
                          Style="{StaticResource ModuleListFilterComboStyle}"
                          Width="320" MinWidth="180"
                          Margin="0,6,8,6"
                          VerticalAlignment="Center"
                          ToolTip="Released / In-Production Job Orders (confirmed PIs only — drafts never reach the floor)"/>
                <Button Style="{StaticResource PrimaryPillButton}"
                        Command="{Binding ReleaseCommand}"
                        Tag="&#xE768;"
                        Content="Release to Production"
                        MinWidth="210"
                        Margin="0,6,8,6"/>
                <Button Style="{StaticResource OutlinedPillButton}"
                        Command="{Binding RefreshCommand}"
                        Tag="&#xE72C;"
                        Content="Refresh"
                        MinWidth="120"
                        Margin="0,6,0,6"/>
            </WrapPanel>
        </Border>

        <TextBlock Text="{Binding ReleaseMessage}"
                   Margin="8,8,8,0"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FontSize.Body}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ReleaseSucceeded}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Floor connectivity warning (complete before predecessor / clamped write) -->
        <Border Margin="0,8,0,0"
                CornerRadius="{DynamicResource CardCornerRadius}"
                Background="{DynamicResource TintAmberBrush}"
                Padding="12,8"
                Visibility="{Binding HasActionWarning,
                             Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;"
                           FontFamily="{DynamicResource FontFamily.Icon}"
                           FontSize="{DynamicResource FontSize.Body}"
                           Foreground="{DynamicResource WarningBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBlock Text="{Binding ActionWarning}"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSize.Body}"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
