<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Production/Controls/ProductionKpiStrip.xaml
     PROJECT: ProGlassAutomation
     MODULE: Production — shared KPI tiles (chrome only)

     Live stage KPIs as 12/18px indigo bento tiles, not a crushed strip.
     Labels are stage-aware via the VM. DataContext = ProductionStageViewModelBase.
     Every figure is a real queue aggregate — nothing here is sample data.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Production.Controls.ProductionKpiStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="Transparent">

    <UniformGrid Columns="3" Margin="0,4,0,4">
        <Border Style="{StaticResource OptKpiCard}" Margin="0,0,12,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource OptKpiBadge}" Background="{StaticResource OptInfoBg}">
                        <TextBlock Text="&#xE8C6;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="16"
                                   Foreground="{StaticResource OptInfoInk}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="In queue" Style="{StaticResource OptHeader}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="140"/>
                </StackPanel>
                <TextBlock Text="{Binding TotalCount}" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource OptKpiCard}" Margin="0,0,12,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource OptKpiBadge}" Background="{StaticResource OptWarningBg}">
                        <TextBlock Text="&#xE823;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="16"
                                   Foreground="{StaticResource OptWarningInk}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Pending" Style="{StaticResource OptHeader}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="140"/>
                </StackPanel>
                <TextBlock Text="{Binding PendingCount}" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                <TextBlock Text="{Binding PendingPiecesHint}" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource OptKpiCard}" Margin="0,0,12,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource OptKpiBadge}" Background="{StaticResource OptIndigoSoft}">
                        <TextBlock Text="&#xE9D9;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="16"
                                   Foreground="{StaticResource OptIndigo}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="In progress" Style="{StaticResource OptHeader}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="140"/>
                </StackPanel>
                <TextBlock Text="{Binding InProgressCount}" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                <TextBlock Text="{Binding InProgressPiecesHint}" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource OptKpiCard}" Margin="0,0,12,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource OptKpiBadge}" Background="{StaticResource OptSuccessBg}">
                        <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="16"
                                   Foreground="{StaticResource OptSuccessInk}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Completed" Style="{StaticResource OptHeader}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="140"/>
                </StackPanel>
                <TextBlock Text="{Binding CompletedCount}" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                <TextBlock Text="{Binding CompletedPiecesHint}" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource OptKpiCard}" Margin="0,0,12,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource OptKpiBadge}" Background="{StaticResource OptAccentBg}">
                        <TextBlock Text="&#xE9D2;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="16"
                                   Foreground="{StaticResource OptAccentInk}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Load" Style="{StaticResource OptHeader}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="140"/>
                </StackPanel>
                <TextBlock Text="{Binding AreaTotalLabel}" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding MetricTotalLabel}" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource OptKpiCard}" Margin="0,0,12,12"
                Visibility="{Binding ShowDispatchKpi, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource OptKpiBadge}" Background="{StaticResource OptSuccessBg}">
                        <TextBlock Text="&#xE7BF;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="16"
                                   Foreground="{StaticResource OptSuccessInk}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Ready for dispatch" Style="{StaticResource OptHeader}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="140"/>
                </StackPanel>
                <TextBlock Text="{Binding UnitsReadyLabel}" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </UniformGrid>
</UserControl>
