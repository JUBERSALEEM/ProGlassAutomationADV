<!-- ═══════════════════════════════════════════════════════════════
     FILE: Views/Production/Controls/ProductionUnitDetailTemplates.xaml
     MODULE: Production — Step-5 cut-list grid templates for the job
     detail overlay (OUTER left / INNER right). Shared as a merged
     resource dictionary so the detail control stays lean.
═══════════════════════════════════════════════════════════════════ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

        <!-- Shared column layout: # · GLASS REF · W · H · TOTAL · QTY · DONE · BALANCE -->
        <DataTemplate x:Key="OuterGridTemplate">
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="12,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding OuterGridTitle}" FontSize="{StaticResource TextSubhead}"
                                   FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   VerticalAlignment="Center"/>
                        <Border CornerRadius="9" Background="{DynamicResource DashAmbientBrush}"
                                Padding="10,3" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding OuterStageItems.Count, StringFormat={}{0} rows}"
                                       FontSize="{StaticResource TextCaption}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Header strip -->
                    <Border Style="{StaticResource PiTableHeaderStyle}" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="0.62*"/>
                                <ColumnDefinition Width="0.62*"/>
                                <ColumnDefinition Width="0.66*"/>
                                <ColumnDefinition Width="0.62*"/>
                                <ColumnDefinition Width="0.78*"/>
                                <ColumnDefinition Width="0.72*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                            <TextBlock Grid.Column="1" Text="GLASS REF" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left" Margin="6,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding OuterWHeader}" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                            <TextBlock Grid.Column="3" Text="{Binding OuterHHeader}" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                            <TextBlock Grid.Column="4" Text="TOTAL" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                            <TextBlock Grid.Column="5" Text="QTY" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                            <TextBlock Grid.Column="6" Text="DONE" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                            <TextBlock Grid.Column="7" Text="BALANCE" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                        </Grid>
                    </Border>

                    <!-- Rows -->
                    <ItemsControl ItemsSource="{Binding OuterStageItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,0,0,1"
                                        Padding="0,2" SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="0.62*"/>
                                            <ColumnDefinition Width="0.62*"/>
                                            <ColumnDefinition Width="0.66*"/>
                                            <ColumnDefinition Width="0.62*"/>
                                            <ColumnDefinition Width="0.78*"/>
                                            <ColumnDefinition Width="0.72*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding RowIndex}" Style="{StaticResource LineItemsSerialStyle}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SerialLabel}" FontSize="{StaticResource TextCaption}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding GlassRef}" FontSize="{StaticResource TextBody}"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding WLabel}" Style="{StaticResource LineItemsReadonlyStyle}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding HLabel}" Style="{StaticResource LineItemsReadonlyStyle}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding InflowLabel}" Style="{StaticResource LineItemsReadonlyStyle}"/>
                                        <TextBlock Grid.Column="5" Text="{Binding QtyLabel}" Style="{StaticResource LineItemsReadonlyStyle}"/>
                                        <TextBox Grid.Column="6" Text="{Binding DoneInput, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource LineItemsIntCellStyle}" Margin="2,0"
                                                 IsEnabled="{Binding CanWork}"
                                                 ToolTip="Done pieces (cannot exceed TOTAL)"/>
                                        <TextBlock Grid.Column="7" Text="{Binding BalanceLabel}" Style="{StaticResource LineItemsReadonlyStyle}"
                                                   Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- AutoSum footer — column-end totals -->
                    <Border Style="{StaticResource LineItemsFooterStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="0.62*"/>
                                <ColumnDefinition Width="0.62*"/>
                                <ColumnDefinition Width="0.66*"/>
                                <ColumnDefinition Width="0.62*"/>
                                <ColumnDefinition Width="0.78*"/>
                                <ColumnDefinition Width="0.72*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="TOTALS" FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Left"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBlock Grid.Column="4" Text="{Binding OuterTotalSum}" Style="{StaticResource LineItemsReadonlyStyle}"
                                       FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Grid.Column="5" Text="{Binding OuterQtySum}" Style="{StaticResource LineItemsReadonlyStyle}"/>
                            <TextBlock Grid.Column="6" Text="{Binding OuterDoneSum}" Style="{StaticResource LineItemsReadonlyStyle}"
                                       FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                            <TextBlock Grid.Column="7" Text="{Binding OuterBalanceSum}" Style="{StaticResource LineItemsReadonlyStyle}"
                                       FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="InnerGridTemplate">
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="12,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="INNER" FontSize="{StaticResource TextSubhead}" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center"/>
                        <Border CornerRadius="9" Background="{DynamicResource DashAmbientBrush}"
                                Padding="10,3" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding InnerStageItems.Count, StringFormat={}{0} rows}"
                                       FontSize="{StaticResource TextCaption}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </Border>
                    </StackPanel>

                    <Border Style="{StaticResource PiTableHeaderStyle}" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="0.62*"/>
                                <ColumnDefinition Width="0.62*"/>
                                <ColumnDefinition Width="0.66*"/>
                                <ColumnDefinition Width="0.62*"/>
                                <ColumnDefinition Width="0.78*"/>
                                <ColumnDefinition Width="0.72*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                            <TextBlock Grid.Column="1" Text="GLASS REF" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left" Margin="6,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="W2" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                            <TextBlock Grid.Column="3" Text="H2" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                            <TextBlock Grid.Column="4" Text="TOTAL" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                            <TextBlock Grid.Column="5" Text="QTY" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                            <TextBlock Grid.Column="6" Text="DONE" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                            <TextBlock Grid.Column="7" Text="BALANCE" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding InnerStageItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,0,0,1"
                                        Padding="0,2" SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="0.62*"/>
                                            <ColumnDefinition Width="0.62*"/>
                                            <ColumnDefinition Width="0.66*"/>
                                            <ColumnDefinition Width="0.62*"/>
                                            <ColumnDefinition Width="0.78*"/>
                                            <ColumnDefinition Width="0.72*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding RowIndex}" Style="{StaticResource LineItemsSerialStyle}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SerialLabel}" FontSize="{StaticResource TextCaption}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding GlassRef}" FontSize="{StaticResource TextBody}"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding WLabel}" Style="{StaticResource LineItemsReadonlyStyle}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding HLabel}" Style="{StaticResource LineItemsReadonlyStyle}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding InflowLabel}" Style="{StaticResource LineItemsReadonlyStyle}"/>
                                        <TextBlock Grid.Column="5" Text="{Binding QtyLabel}" Style="{StaticResource LineItemsReadonlyStyle}"/>
                                        <TextBox Grid.Column="6" Text="{Binding DoneInput, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource LineItemsIntCellStyle}" Margin="2,0"
                                                 IsEnabled="{Binding CanWork}"
                                                 ToolTip="Done pieces (cannot exceed TOTAL)"/>
                                        <TextBlock Grid.Column="7" Text="{Binding BalanceLabel}" Style="{StaticResource LineItemsReadonlyStyle}"
                                                   Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource LineItemsFooterStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="0.62*"/>
                                <ColumnDefinition Width="0.62*"/>
                                <ColumnDefinition Width="0.66*"/>
                                <ColumnDefinition Width="0.62*"/>
                                <ColumnDefinition Width="0.78*"/>
                                <ColumnDefinition Width="0.72*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="TOTALS" FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Left"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBlock Grid.Column="4" Text="{Binding InnerTotalSum}" Style="{StaticResource LineItemsReadonlyStyle}"
                                       FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Grid.Column="5" Text="{Binding InnerQtySum}" Style="{StaticResource LineItemsReadonlyStyle}"/>
                            <TextBlock Grid.Column="6" Text="{Binding InnerDoneSum}" Style="{StaticResource LineItemsReadonlyStyle}"
                                       FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                            <TextBlock Grid.Column="7" Text="{Binding InnerBalanceSum}" Style="{StaticResource LineItemsReadonlyStyle}"
                                       FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
</ResourceDictionary>
