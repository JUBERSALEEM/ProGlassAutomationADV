<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Production/Controls/ProductionUnitDetailControl.xaml
     PROJECT: ProGlassAutomation
     MODULE: Production — shared full-page unit detail overlay

     Step-5 cut-list style, not cards: the unit's panes are two editable
     grids side by side — OUTER (left, W1/H1) and INNER (right, W2/H2) —
     with columns # · GLASS REF · W · H · TOTAL · QTY · DONE · BALANCE.
     DONE is an editable cell; one SAVE DONE writes the whole grid in a
     batch. Each grid has an AutoSum footer (TOTAL/DONE/BALANCE column
     ends). Fully completed panes move to the COMPLETED section at the
     end. Single-glass units render one grid, centered, titled by the
     spec name. KPI cards on top update on every save; the main list
     live-refreshes.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Production.Controls.ProductionUnitDetailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibilityConverter}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views/Production/Controls/ProductionUnitDetailTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Detail header bar ══════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource ModuleBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                Padding="10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource OutlinedPillButton}"
                        Command="{Binding CloseDetailCommand}"
                        Padding="14,6" Margin="0,0,16,0"
                        ToolTip="Return to the list">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="{StaticResource TextBody}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="BACK TO LIST" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding ModuleName}" Style="{StaticResource ModulePageTitleStyle}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="· UNIT DETAIL" FontSize="{StaticResource TextSubhead}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource ModulePageSubtitleStyle}" Margin="0,2,0,0"/>
                </StackPanel>

                <Border Grid.Column="2" CornerRadius="9" Background="{DynamicResource TintTealBrush}"
                        Padding="14,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SR " FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedSerialLabel}" FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══ Scrollable detail body ═════════════════════════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,16,18,20">
            <StackPanel MaxWidth="1280" HorizontalAlignment="Stretch">

                <!-- ══ Unit identity ═══════════════════════════════════ -->
                <Border Style="{StaticResource SurfaceSecondaryStyle}" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="JOB NO " FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedJobNo}" FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="  ·  CUSTOMER  " FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedCustomer}" FontSize="{StaticResource TextBody}"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="  ·  " FontSize="{StaticResource TextBody}"
                                       Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedSpecLabel}" FontSize="{StaticResource TextBody}"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                            <Button Style="{StaticResource PrimaryPillButton}" Command="{Binding OpenJobOrderCommand}"
                                    Content="Open Job Order" Margin="0,0,8,0" Padding="14,4"
                                    ToolTip="Open the source Job Order this work was released from"/>
                            <Button Style="{StaticResource OutlinedPillButton}" Command="{Binding OpenProformaCommand}"
                                    Content="Open PI" Padding="14,4"
                                    ToolTip="Open the confirmed Proforma Invoice"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══ Completed-KPI strip ═════════════════════════════ -->
                <Border Style="{StaticResource ModuleListKpiStripStyle}" Padding="8" Margin="0,14,0,0">
                    <UniformGrid Columns="4">
                        <Border Background="Transparent" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="TOTAL" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding SelectedUnitTotalLabel}" Style="{StaticResource ModuleListKpiValueStyle}"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                <TextBlock Text="pieces in this unit" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="Transparent" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="DONE" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding SelectedUnitDoneLabel}" Style="{StaticResource ModuleListKpiValueStyle}"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                                <TextBlock Text="marked completed" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="Transparent" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="BALANCE" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding SelectedUnitBalanceLabel}" Style="{StaticResource ModuleListKpiValueStyle}"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="remaining at this stage" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="Transparent" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="COMPLETED" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding SelectedUnitCompletedPctLabel}" Style="{StaticResource ModuleListKpiValueStyle}"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="of unit progress" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Border>

                <!-- ══ Toolbar: save the whole grid ═════════════════════ -->
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="SAVE DONE" Style="{StaticResource PrimaryPillButton}"
                            Command="{Binding SaveAllDoneCommand}" Padding="18,8"
                            ToolTip="Save every DONE cell in the grids — AutoSum, KPI cards and the main list refresh instantly"/>
                    <Button Content="Complete all items" Style="{StaticResource OutlinedPillButton}"
                            Command="{Binding CompleteUnitCommand}" Margin="8,0,0,0" Padding="16,8"
                            ToolTip="Complete every arrived piece of this unit in one action"/>
                </StackPanel>

                <!-- ══ Grids: OUTER (left) · INNER (right), SGU centered ═ -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Single glass: one grid centered -->
                    <Border Grid.Column="0" Grid.ColumnSpan="3" Width="820" HorizontalAlignment="Center"
                            Visibility="{Binding IsSingleGlass, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource OuterGridTemplate}"
                                        HorizontalContentAlignment="Stretch"/>
                    </Border>

                    <!-- Multi-pane: outer left, inner right -->
                    <ContentControl Grid.Column="0" Content="{Binding}" ContentTemplate="{StaticResource OuterGridTemplate}"
                                    HorizontalContentAlignment="Stretch"
                                    Visibility="{Binding HasInnerGrid, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource InnerGridTemplate}"
                                    HorizontalContentAlignment="Stretch"
                                    Visibility="{Binding HasInnerGrid, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>

                <!-- ══ COMPLETED — panes that finished this stage ═══════ -->
                <Border Background="{DynamicResource TintGreenBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="12,10" Margin="0,14,0,0"
                        Visibility="{Binding HasCompletedSection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextBody}"
                                       Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="COMPLETED" FontSize="{StaticResource TextSubhead}" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center"/>
                            <Border CornerRadius="9" Background="{DynamicResource DashAmbientBrush}"
                                    Padding="10,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CompletedStageItems.Count, StringFormat={}{0} rows}"
                                           FontSize="{StaticResource TextCaption}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                            </Border>
                        </StackPanel>

                        <Border Style="{StaticResource PiTableHeaderStyle}" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="0.7*"/>
                                    <ColumnDefinition Width="0.7*"/>
                                    <ColumnDefinition Width="0.7*"/>
                                    <ColumnDefinition Width="0.7*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="#" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                <TextBlock Grid.Column="1" Text="GLASS REF" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left" Margin="6,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="W" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                <TextBlock Grid.Column="3" Text="H" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                <TextBlock Grid.Column="4" Text="QTY" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                <TextBlock Grid.Column="5" Text="DONE" Style="{StaticResource LineItemsHeaderTextStyle}"/>
                                <TextBlock Grid.Column="6" Text="COMPLETED BY" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left" Margin="6,0,0,0"/>
                                <TextBlock Grid.Column="7" Text="COMPLETED AT" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding CompletedStageItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,0,0,1" Padding="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="0.7*"/>
                                                <ColumnDefinition Width="0.7*"/>
                                                <ColumnDefinition Width="0.7*"/>
                                                <ColumnDefinition Width="0.7*"/>
                                                <ColumnDefinition Width="1.4*"/>
                                                <ColumnDefinition Width="1.3*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding RowIndex}" Style="{StaticResource LineItemsSerialStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding GlassRef}" FontSize="{StaticResource TextBody}"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center"
                                                       HorizontalAlignment="Left" Margin="6,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding WLabel}" Style="{StaticResource LineItemsReadonlyStyle}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding HLabel}" Style="{StaticResource LineItemsReadonlyStyle}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding QtyLabel}" Style="{StaticResource LineItemsReadonlyStyle}"/>
                                            <TextBlock Grid.Column="5" Text="{Binding DoneLabel}" Style="{StaticResource LineItemsReadonlyStyle}"
                                                       Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="6" Text="{Binding DoneBy}" FontSize="{StaticResource TextBody}"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center"
                                                       HorizontalAlignment="Left" Margin="6,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="7" Text="{Binding CompletedAtLabel}" FontSize="{StaticResource TextBody}"
                                                       Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"
                                                       HorizontalAlignment="Left" Margin="6,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource LineItemsFooterStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="0.7*"/>
                                    <ColumnDefinition Width="0.7*"/>
                                    <ColumnDefinition Width="0.7*"/>
                                    <ColumnDefinition Width="0.7*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="TOTALS" FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Left"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <TextBlock Grid.Column="4" Text="{Binding CompletedTotalSum}" Style="{StaticResource LineItemsReadonlyStyle}"
                                           FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                <TextBlock Grid.Column="5" Text="{Binding CompletedDoneSum}" Style="{StaticResource LineItemsReadonlyStyle}"
                                           FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ══ Auto-flow caption ═══════════════════════════════ -->
                <StackPanel Orientation="Horizontal" Margin="2,10,0,0">
                    <TextBlock Text="&#xE930;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextBody}"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Completed pieces move to the next stage automatically — the AutoSum and KPI cards update the instant SAVE DONE is pressed."
                               FontSize="{StaticResource TextCaption}" Foreground="{DynamicResource MutedForegroundBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- ══ Recent entries log ══════════════════════════════ -->
                <Border Style="{StaticResource SurfaceSecondaryStyle}" Margin="0,14,0,0" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="RECENT ENTRIES" FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,8"/>
                        <StackPanel Visibility="{Binding HasDetailEntries, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding DetailEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextBody}"
                                                       Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding}" FontSize="{StaticResource TextBody}"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock Text="No entries yet for this unit — save a done quantity to record the operator, date and time."
                                   FontSize="{StaticResource TextBody}" Foreground="{DynamicResource MutedForegroundBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasDetailEntries, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <!-- ══ Dispatch ════════════════════════════════════════ -->
                <Border Style="{StaticResource SurfaceSecondaryStyle}" Margin="0,14,0,0" Padding="16,14"
                        Visibility="{Binding HasDispatchPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="DISPATCH" FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="8" Background="{DynamicResource DashAmbientBrush}" Padding="12,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="FINISHED " FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedDispatchReadyLabel}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="8" Background="{DynamicResource DashAmbientBrush}" Padding="12,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="DELIVERED " FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedDispatchDeliveredLabel}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="8" Background="{DynamicResource DashAmbientBrush}" Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="BALANCE " FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedDispatchBalanceLabel}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Button Content="Create Delivery Note" Style="{StaticResource PrimaryPillButton}"
                                Command="{Binding CreateDeliveryNoteCommand}" Margin="0,12,0,0" HorizontalAlignment="Left"
                                ToolTip="Create the Dispatching delivery note for this Job Order — only finished (DONE) pieces can be delivered."/>
                        <TextBlock Text="DONE ≠ DELIVERED — pieces finished in production ship only on a delivery note."
                                   FontSize="{StaticResource TextCaption}" Foreground="{DynamicResource MutedForegroundBrush}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
