<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Production/Controls/ProductionUnitDetailControl.xaml
     PROJECT: ProGlassAutomation
     MODULE: Production — shared full-page unit detail overlay

     One unit opened by double-clicking a master-list row. Top completed-
     KPI strip, one card per pane (OUTER / INNER — single glass shows the
     spec name directly) with its own size, TOTAL/DONE/BALANCE, a Qty Done
     input + Save, unit totals, and the recent entries log (who marked
     done, when). Completed pieces flow to the next stage automatically;
     the master list live-refreshes on every save.

     Hosted by every ProductionStagePageBase page with
     Visibility bound to IsDetailOpen.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Production.Controls.ProductionUnitDetailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:production="clr-namespace:ProGlassAutomation.Views.Production.Controls"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibilityConverter}}">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Detail header bar — back + stage identity ═══════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource ModuleBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                Padding="10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource OutlinedPillButton}"
                        Command="{Binding CloseDetailCommand}"
                        Padding="14,6" Margin="0,0,16,0"
                        ToolTip="Return to the {Binding ModuleName} list">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="{StaticResource TextBody}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="BACK TO LIST" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding ModuleName}" Style="{StaticResource ModulePageTitleStyle}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="· UNIT DETAIL" FontSize="{StaticResource TextSubhead}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource ModulePageSubtitleStyle}" Margin="0,2,0,0"/>
                </StackPanel>

                <Border Grid.Column="2" CornerRadius="9" Background="{DynamicResource TintTealBrush}"
                        Padding="14,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SR " FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedSerialLabel}" FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══ Scrollable detail body ═════════════════════════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,16,18,20">
            <StackPanel MaxWidth="1120" HorizontalAlignment="Stretch">

                <!-- ══ Completed-KPI strip (top panel) ════════════════ -->
                <Border Style="{StaticResource ModuleListKpiStripStyle}" Padding="8">
                    <UniformGrid Columns="4">
                        <!-- TOTAL -->
                        <Border Background="Transparent" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="TOTAL" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding SelectedUnitTotalLabel}" Style="{StaticResource ModuleListKpiValueStyle}"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                <TextBlock Text="pieces in this unit" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </Border>
                        <!-- DONE -->
                        <Border Background="Transparent" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="DONE" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding SelectedUnitDoneLabel}" Style="{StaticResource ModuleListKpiValueStyle}"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                                <TextBlock Text="marked completed" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </Border>
                        <!-- BALANCE -->
                        <Border Background="Transparent" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="BALANCE" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding SelectedUnitBalanceLabel}" Style="{StaticResource ModuleListKpiValueStyle}"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="remaining at this stage" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </Border>
                        <!-- COMPLETED % -->
                        <Border Background="Transparent" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="COMPLETED" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding SelectedUnitCompletedPctLabel}" Style="{StaticResource ModuleListKpiValueStyle}"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="of unit progress" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Border>

                <!-- ══ Unit identity + cross-navigation ════════════════ -->
                <Border Style="{StaticResource SurfaceSecondaryStyle}" Margin="0,14,0,0" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Job No" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,3"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedJobNo}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="10,3,0,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Customer" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCustomer}" FontSize="{StaticResource TextBody}"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap" Margin="10,3,0,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Spec / Ref" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,3"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,3,0,3">
                                <TextBlock Text="{Binding SelectedSpecLabel}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedRef}" FontSize="{StaticResource TextBody}"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Sizes" Style="{StaticResource ModuleListKpiLabelStyle}" Margin="0,3"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedSizeSummary}" FontSize="{StaticResource TextBody}"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap" Margin="10,3,0,3"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
                            <Button Style="{StaticResource PrimaryPillButton}" Command="{Binding OpenJobOrderCommand}"
                                    Content="Open Job Order" Margin="0,0,0,8"
                                    ToolTip="Open the source Job Order this work was released from"/>
                            <Button Style="{StaticResource OutlinedPillButton}" Command="{Binding OpenProformaCommand}"
                                    Content="Open Proforma Invoice"
                                    ToolTip="Open the confirmed PI (check Step 5 sizes / Step 6 charges)"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══ Pane cards — outer / inner (single glass = spec name) -->
                <ItemsControl ItemsSource="{Binding SelectedStageItems}" Margin="0,14,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="{DynamicResource CardCornerRadius}"
                                    Style="{StaticResource SurfaceSecondaryStyle}"
                                    Padding="16,14" Margin="0,0,0,10">
                                <StackPanel>
                                    <!-- Card header: OUTER / INNER or spec name + status -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding PaneTitle}" FontSize="{StaticResource TextSubhead}"
                                                       FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                            <TextBlock Text="{Binding PaneSubtitle}" FontSize="{StaticResource TextBody}"
                                                       Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Visibility="{Binding PaneSubtitle, Converter={StaticResource StringToVisibilityConverter}}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource DashAmbientBrush}"
                                                Padding="12,4" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="{StaticResource TextCaption}" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusLabel}" Value="IN PROGRESS">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusLabel}" Value="COMPLETED">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>

                                    <!-- Size + flow chips row -->
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="8" Background="{DynamicResource TintBlueBrush}"
                                                Padding="12,6" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="SIZE  " FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                           Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SizeLabel}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Border CornerRadius="8" Background="{DynamicResource ModuleBackgroundBrush}" Padding="12,5" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="TOTAL " FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                               Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding InflowLabel}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border CornerRadius="8" Background="{DynamicResource ModuleBackgroundBrush}" Padding="12,5" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="DONE " FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                               Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DoneLabel}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SuccessBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border CornerRadius="8" Background="{DynamicResource ModuleBackgroundBrush}" Padding="12,5">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="BALANCE " FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                               Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding BalanceLabel}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource WarningBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Qty done editor + floor actions -->
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0"
                                                Visibility="{Binding CanWork, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="QTY DONE" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox Text="{Binding DoneInput, UpdateSourceTrigger=PropertyChanged}" Width="88"
                                                 Style="{StaticResource IntInputStyle}"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="Pieces completed at this stage (cannot exceed TOTAL)"/>
                                        <Button Content="SAVE DONE" Style="{StaticResource PrimaryPillButton}"
                                                Command="{Binding DataContext.SaveQtyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Margin="10,0,0,0" Padding="16,6"
                                                ToolTip="Save the done-piece count — only completed pieces move to the next stage"/>
                                        <Button Content="All" Style="{StaticResource OutlinedPillButton}"
                                                Command="{Binding DataContext.CompleteAllCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Margin="8,0,0,0" Padding="14,6"
                                                ToolTip="Complete every piece that arrived"/>
                                        <Button Content="Reset" Style="{StaticResource OutlinedPillButton}"
                                                Command="{Binding DataContext.ResetQtyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Margin="8,0,0,0" Padding="14,6"
                                                ToolTip="Set done pieces back to zero"/>
                                    </StackPanel>

                                    <!-- Completed-by attribution -->
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                                Visibility="{Binding Done, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Inverted}">
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Completed by " FontSize="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DoneBy}" FontSize="{StaticResource TextCaption}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="  ·  " FontSize="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding CompletedAtLabel}" FontSize="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ══ Unit totals + auto-flow caption ════════════════ -->
                <Border CornerRadius="{DynamicResource CardCornerRadius}" Background="{DynamicResource ModuleBackgroundBrush}"
                        Padding="16,12" Margin="0,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="UNIT TOTALS" FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedPcsSummary}" FontSize="{StaticResource TextBody}"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding SelectedSqmSummary}" FontSize="{StaticResource TextBody}"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding SelectedLmSummary}" FontSize="{StaticResource TextBody}"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Complete all items" Style="{StaticResource OutlinedPillButton}"
                                Command="{Binding CompleteUnitCommand}" VerticalAlignment="Center" Margin="16,0,0,0" Padding="16,6"
                                ToolTip="Complete every arrived piece of this unit in one action — each item is clamped to what arrived upstream"/>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="2,10,0,0">
                    <TextBlock Text="&#xE930;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextBody}"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Completed pieces move to the next stage automatically — the balance above updates the instant a floor entry is saved."
                               FontSize="{StaticResource TextCaption}" Foreground="{DynamicResource MutedForegroundBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- ══ Recent entries log — who marked done, when ═══════ -->
                <Border Style="{StaticResource SurfaceSecondaryStyle}" Margin="0,14,0,0" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="RECENT ENTRIES" FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,8"/>
                        <StackPanel Visibility="{Binding HasDetailEntries, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding DetailEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextBody}"
                                                       Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding}" FontSize="{StaticResource TextBody}"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock Text="No entries yet for this unit — save a done quantity to record the operator, date and time."
                                   FontSize="{StaticResource TextBody}" Foreground="{DynamicResource MutedForegroundBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasDetailEntries, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <!-- ══ Dispatch — finished pieces flow into delivery notes ═══ -->
                <Border Style="{StaticResource SurfaceSecondaryStyle}" Margin="0,14,0,0" Padding="16,14"
                        Visibility="{Binding HasDispatchPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="DISPATCH" FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="8" Background="{DynamicResource DashAmbientBrush}" Padding="12,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="FINISHED " FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedDispatchReadyLabel}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="8" Background="{DynamicResource DashAmbientBrush}" Padding="12,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="DELIVERED " FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedDispatchDeliveredLabel}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="8" Background="{DynamicResource DashAmbientBrush}" Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="BALANCE " FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedDispatchBalanceLabel}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Button Content="Create Delivery Note" Style="{StaticResource PrimaryPillButton}"
                                Command="{Binding CreateDeliveryNoteCommand}" Margin="0,12,0,0" HorizontalAlignment="Left"
                                ToolTip="Create the Dispatching delivery note for this Job Order — only finished (DONE) pieces can be delivered."/>
                        <TextBlock Text="DONE ≠ DELIVERED — pieces finished in production ship only on a delivery note."
                                   FontSize="{StaticResource TextCaption}" Foreground="{DynamicResource MutedForegroundBrush}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
