<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Production/Controls/ProductionPipelineBar.xaml
     PROJECT: ProGlassAutomation
     MODULE: Production — shared pipeline chain bar (chrome only)

     The eight production stages are SEPARATE pages; this is the one
     element they all render identically on purpose — the factory
     pipeline. Every chip carries the factory-wide open/done count for
     that stage and navigates straight to its module, so work can be
     followed stage by stage. DataContext = ProductionStageViewModelBase.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Production.Controls.ProductionPipelineBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Border CornerRadius="{DynamicResource CardCornerRadius}"
            Background="{DynamicResource DashAmbientBrush}"
            Padding="12,10"
            Margin="4,0,4,10">
        <StackPanel>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="PRODUCTION PIPELINE"
                               FontSize="{StaticResource TextCaption}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Text="·"
                               FontSize="{StaticResource TextCaption}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="8,0"/>
                    <TextBlock Text="{Binding ChainProgressLabel}"
                               FontSize="{StaticResource TextCaption}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
                <TextBlock Text="Click a stage to follow the work"
                           FontSize="{StaticResource TextCaption}"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Right"/>
            </Grid>

            <ItemsControl ItemsSource="{Binding ChainStages}" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Cursor="Hand"
                                Margin="0,0,8,6"
                                Command="{Binding DataContext.OpenStageCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding NavKey}"
                                ToolTip="{Binding CountLabel}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ChipBorder"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Padding="10,6"
                                            Background="{DynamicResource SurfacePrimaryBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            SnapsToDevicePixels="True">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Ordinal}"
                                                       FontSize="{StaticResource TextCaption}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Icon}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="{StaticResource TextSection}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="{StaticResource TextCaption}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding CountLabel}"
                                                           FontSize="{StaticResource TextXSmall}"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ChipBorder" Property="BorderBrush"
                                                    Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="ChipBorder" Property="Background"
                                                    Value="{DynamicResource SurfaceSecondaryBrush}"/>
                                            <Setter TargetName="ChipBorder" Property="BorderBrush"
                                                    Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="ChipBorder" Property="BorderThickness" Value="1.5"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasWork}" Value="False">
                                            <Setter TargetName="ChipBorder" Property="Opacity" Value="0.55"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
