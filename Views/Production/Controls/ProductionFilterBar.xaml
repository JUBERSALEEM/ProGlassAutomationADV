<UserControl x:Class="ProGlassAutomation.Views.Production.Controls.ProductionFilterBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <StackPanel>
        <Border Style="{StaticResource ModuleListFilterBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="160"/>
                    <ColumnDefinition Width="*" MinWidth="120"/>
                    <ColumnDefinition Width="*" MinWidth="120"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         Style="{StaticResource ModuleListFilterInputStyle}"
                         Margin="0,0,8,0"
                         ToolTip="Search job, customer, glass, spec"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding JobFilters}"
                          SelectedItem="{Binding SelectedJobFilter}"
                          Style="{StaticResource ModuleListFilterComboStyle}"
                          Margin="0,0,8,0"/>
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding SelectedStatusFilter}"
                          Style="{StaticResource ModuleListFilterComboStyle}"/>
            </Grid>
        </Border>

        <Border CornerRadius="{DynamicResource CardCornerRadius}"
                Background="{DynamicResource TintIndigoBrush}"
                Padding="12,8"
                Margin="12,4,12,0"
                Visibility="{Binding HasWaitingUpstream, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE823;"
                           FontFamily="{DynamicResource FontFamily.Icon}"
                           FontSize="{DynamicResource FontSize.Body}"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBlock Text="{Binding WaitingUpstreamLabel}"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSize.Body}"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
