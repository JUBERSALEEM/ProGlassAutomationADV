<UserControl x:Class="ProGlassAutomation.Views.Production.Controls.ProductionFilterBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <StackPanel>
        <Border Style="{StaticResource ModuleListFilterBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding ScanText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModuleListFilterInputStyle}"
                         Margin="0,0,8,0" MinHeight="40" VerticalContentAlignment="Center"
                         ToolTip="Scan job number or glass ref — Enter opens the work order">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding CommitScanCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModuleListFilterInputStyle}"
                         Margin="0,0,8,0" VerticalContentAlignment="Center"
                         ToolTip="Filter Ref / customer / job / spec"/>
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding JobFilters}"
                          SelectedItem="{Binding SelectedJobFilter}"
                          Style="{StaticResource ModuleListFilterComboStyle}"
                          Margin="0,0,8,0"/>
                <ComboBox Grid.Column="3"
                          ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding SelectedStatusFilter}"
                          Style="{StaticResource ModuleListFilterComboStyle}"/>
            </Grid>
        </Border>

        <Border CornerRadius="{DynamicResource CardCornerRadius}"
                Background="{DynamicResource TintAmberBrush}"
                BorderBrush="{DynamicResource WarningBrush}"
                BorderThickness="{DynamicResource Border.HairlineThickness}"
                Padding="10,8" Margin="12,6,12,0"
                Visibility="{Binding HasAndon, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE814;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSubhead}"
                           Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding AndonLabel}" TextWrapping="Wrap"
                           FontSize="{StaticResource TextBody}" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
