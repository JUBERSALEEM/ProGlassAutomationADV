<UserControl x:Class="ProGlassAutomation.Views.Production.Controls.ProductionFilterBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <StackPanel>
        <Border Style="{StaticResource ModuleListFilterBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="0,0,8,0"
                        Background="{DynamicResource SurfaceTertiaryBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Padding="12,0" MinHeight="40">
                    <DockPanel>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="{StaticResource TextSection}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent"
                                 FontSize="{StaticResource TextBodyLarge}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 MinHeight="40" VerticalContentAlignment="Center"
                                 ToolTip="Search job, customer, glass, spec"/>
                    </DockPanel>
                </Border>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding JobFilters}"
                          SelectedItem="{Binding SelectedJobFilter}"
                          Style="{StaticResource ModuleListFilterComboStyle}"
                          Margin="0,0,8,0"/>
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding SelectedStatusFilter}"
                          Style="{StaticResource ModuleListFilterComboStyle}"/>
            </Grid>
        </Border>

        <Border CornerRadius="{DynamicResource CardCornerRadius}"
                Background="{DynamicResource TintIndigoBrush}"
                Padding="10,6" Margin="12,4,12,0"
                Visibility="{Binding HasWaitingUpstream, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets"
                           FontSize="{StaticResource TextBody}"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding WaitingUpstreamLabel}" TextWrapping="Wrap"
                           FontSize="{StaticResource TextBody}"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
