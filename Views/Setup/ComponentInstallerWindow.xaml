<Window x:Class="ProGlassAutomation.Views.Setup.ComponentInstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Setup.Title}"
        Width="680" Height="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource AppFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/Setup/PrismInstaller.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PrismPrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource Prism.CyanBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource Prism.InkBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="18,10"/>
                <Setter Property="MinWidth" Value="148"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
                <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{DynamicResource Radius.Pill}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrismOutlineButton" TargetType="Button" BasedOn="{StaticResource PrismPrimaryButton}">
                <Setter Property="Background" Value="{StaticResource Prism.CardBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource Prism.LineBrush}"/>
                <Setter Property="MinWidth" Value="112"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource Radius.Pill}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrismQuietButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource Prism.MutedBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrismRowStyle" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Margin" Value="0,3"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource Prism.LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Large}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Prism.CyanBrush}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Prism.CyanBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource Prism.CanvasBrush}">
        <StackPanel Width="560" VerticalAlignment="Center">
            <TextBlock x:Name="Caption"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,14"
                       FontSize="{DynamicResource FontSize.Title}"
                       Foreground="{StaticResource Prism.MutedBrush}"
                       Text="{DynamicResource Setup.Ffmpeg}"/>

            <Grid>
                <Border CornerRadius="{DynamicResource Radius.2XLarge}" Height="520">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="10" Opacity="0.22"
                                          Color="{StaticResource Prism.IndigoColor}"/>
                    </Border.Effect>
                    <Grid>
                        <Border CornerRadius="{DynamicResource Radius.2XLarge}"
                                Background="{StaticResource Prism.PanelBrush}"/>
                        <Ellipse Width="220" Height="180" HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Margin="28,36,0,0" Fill="{StaticResource Prism.BlobViolet}" IsHitTestVisible="False"/>
                        <Ellipse Width="230" Height="190" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,32,28,0" Fill="{StaticResource Prism.BlobCyan}" IsHitTestVisible="False"/>
                        <Ellipse Width="200" Height="150" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Margin="0,0,32,36" Fill="{StaticResource Prism.BlobAmber}" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <Border Width="72" Height="72"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,22,0,0"
                        CornerRadius="{DynamicResource Radius.Large}"
                        Background="{StaticResource Prism.BadgeBrush}"
                        BorderBrush="{StaticResource Prism.CyanBrush}"
                        BorderThickness="1"
                        Panel.ZIndex="2">
                    <Viewbox Width="36" Height="36">
                        <Grid Width="24" Height="24">
                            <Path Stroke="{StaticResource Prism.CyanBrush}"
                                  StrokeThickness="1.6"
                                  Data="M12,2 L21,7.2 L21,16.8 L12,22 L3,16.8 L3,7.2 Z"/>
                            <TextBlock Text="PGA"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="{DynamicResource FontSize.Caption}"
                                       FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{StaticResource Prism.CyanBrush}"/>
                        </Grid>
                    </Viewbox>
                </Border>

                <Border Margin="36,64,36,28"
                        CornerRadius="{DynamicResource Radius.2XLarge}"
                        Background="{StaticResource Prism.CardBrush}"
                        Padding="22,20"
                        Panel.ZIndex="1">
                    <Grid>
                        <StackPanel x:Name="FfmpegPage">
                            <TextBlock Text="{DynamicResource Setup.Ffmpeg}"
                                       FontSize="{DynamicResource FontSize.H2}"
                                       FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{StaticResource Prism.InkBrush}"/>
                            <TextBlock Text="{DynamicResource Setup.FfmpegNeed}"
                                       Margin="0,8,0,0" TextWrapping="Wrap"
                                       FontSize="{DynamicResource FontSize.Title}"
                                       FontWeight="{DynamicResource Weight.SemiBold}"
                                       Foreground="{StaticResource Prism.InkBrush}"/>
                            <TextBlock Text="{DynamicResource Setup.FfmpegBody}"
                                       Margin="0,8,0,0" TextWrapping="Wrap"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{StaticResource Prism.MutedBrush}"/>
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="FfmpegTrack" Height="10" VerticalAlignment="Center" SizeChanged="Track_SizeChanged">
                                    <Border CornerRadius="{DynamicResource Radius.Pill}"
                                            Background="{StaticResource Prism.WashBrush}"/>
                                    <Border x:Name="FfmpegFill" HorizontalAlignment="Left" Width="0"
                                            CornerRadius="{DynamicResource Radius.Pill}"
                                            Background="{StaticResource Prism.BarBrush}"/>
                                </Grid>
                                <Border Grid.Column="1" Margin="10,0,0,0"
                                        Padding="8,2"
                                        CornerRadius="{DynamicResource Radius.Pill}"
                                        Background="{StaticResource Prism.WashBrush}">
                                    <TextBlock x:Name="FfmpegPercent"
                                               FontSize="{DynamicResource FontSize.Caption}"
                                               FontWeight="{DynamicResource Weight.SemiBold}"
                                               Foreground="{StaticResource Prism.InkBrush}"/>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="FfmpegState"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       FontSize="{DynamicResource FontSize.Caption}"
                                       Foreground="{StaticResource Prism.VioletBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                                <Button Content="{DynamicResource Setup.Recheck}"
                                        Style="{StaticResource PrismOutlineButton}"
                                        Margin="0,0,8,0"
                                        Click="Recheck_Click"/>
                                <Button x:Name="FfmpegInstallButton"
                                        Content="{DynamicResource Setup.DownloadInstall}"
                                        Style="{StaticResource PrismPrimaryButton}"
                                        Click="InstallFfmpeg_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <DockPanel x:Name="ModelPage" Visibility="Collapsed">
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{DynamicResource Setup.LocalModel}"
                                       HorizontalAlignment="Center"
                                       FontSize="{DynamicResource FontSize.H2}"
                                       FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{StaticResource Prism.InkBrush}"/>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{DynamicResource Setup.LocalModelBody}"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,12"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{StaticResource Prism.MutedBrush}"/>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button Content="{DynamicResource Setup.License}"
                                        Style="{StaticResource PrismOutlineButton}"
                                        Margin="0,0,8,0"
                                        Click="License_Click"/>
                                <Button x:Name="ModelInstallButton"
                                        Content="{DynamicResource Setup.Install}"
                                        Style="{StaticResource PrismPrimaryButton}"
                                        Click="InstallModel_Click"/>
                            </StackPanel>
                            <ListBox x:Name="ModelList"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ItemContainerStyle="{StaticResource PrismRowStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemsSource="{Binding Models}"
                                     SelectedItem="{Binding SelectedModel, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Width="12" Height="12" Margin="0,2,8,0"
                                                  VerticalAlignment="Top"
                                                  Stroke="{StaticResource Prism.InkBrush}"
                                                  StrokeThickness="1.8"
                                                  Data="M1,6 L4.2,9.2 L11,2"
                                                  Stretch="Uniform">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding ShortTitle}"
                                                           FontSize="{DynamicResource FontSize.Title}"
                                                           FontWeight="{DynamicResource Weight.SemiBold}"
                                                           Foreground="{StaticResource Prism.InkBrush}"/>
                                                <TextBlock Text="{Binding Detail}"
                                                           Margin="0,2,0,0"
                                                           TextWrapping="Wrap"
                                                           FontSize="{DynamicResource FontSize.Caption}"
                                                           Foreground="{StaticResource Prism.InkBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding SizeLine}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="{DynamicResource FontSize.Caption}"
                                                       Foreground="{StaticResource Prism.MutedBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <StackPanel x:Name="ProgressPage" Visibility="Collapsed" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Setup.LocalDownload}"
                                       HorizontalAlignment="Center"
                                       FontSize="{DynamicResource FontSize.Caption}"
                                       Foreground="{StaticResource Prism.MutedBrush}"/>
                            <TextBlock x:Name="ProgressTitle"
                                       Margin="0,8,0,0"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontSize="{DynamicResource FontSize.H2}"
                                       FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{StaticResource Prism.InkBrush}"/>
                            <TextBlock x:Name="ProgressMeta"
                                       Margin="0,8,0,0"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{StaticResource Prism.MutedBrush}"/>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="ModelTrack" Height="10" VerticalAlignment="Center">
                                    <Border CornerRadius="{DynamicResource Radius.Pill}"
                                            Background="{StaticResource Prism.WashBrush}"/>
                                    <Border x:Name="ModelFill" HorizontalAlignment="Left" Width="0"
                                            CornerRadius="{DynamicResource Radius.Pill}"
                                            Background="{StaticResource Prism.BarBrush}"/>
                                </Grid>
                                <TextBlock x:Name="ModelPercent" Grid.Column="1" Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSize.Caption}"
                                           FontWeight="{DynamicResource Weight.SemiBold}"
                                           Foreground="{StaticResource Prism.InkBrush}"/>
                            </Grid>
                            <TextBlock x:Name="ProgressState"
                                       Margin="0,12,0,0"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{StaticResource Prism.InkBrush}"
                                       Text="{DynamicResource Setup.Downloading}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Button x:Name="CancelButton"
                        Content="{DynamicResource Setup.Cancel}"
                        Style="{StaticResource PrismOutlineButton}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,8"
                        Visibility="Collapsed"
                        Panel.ZIndex="3"
                        Click="Cancel_Click"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button x:Name="BackButton"
                        Content="{DynamicResource Setup.Back}"
                        Style="{StaticResource PrismQuietButton}"
                        Visibility="Collapsed"
                        Click="Back_Click"/>
                <Button x:Name="SkipButton"
                        Content="{DynamicResource Setup.Skip}"
                        Style="{StaticResource PrismQuietButton}"
                        Click="Skip_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
