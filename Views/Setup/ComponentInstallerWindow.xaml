<Window x:Class="ProGlassAutomation.Views.Setup.ComponentInstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Setup.Title}"
        Width="760" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Prism.StageBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/Setup/PrismInstaller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Margin="28" CornerRadius="{DynamicResource Radius.2XLarge}"
            Background="{StaticResource Prism.CardBrush}"
            BorderBrush="{StaticResource Prism.LineBrush}"
            BorderThickness="1" Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="{DynamicResource Setup.Title}"
                           FontSize="{DynamicResource FontSize.Caption}"
                           Foreground="{StaticResource Prism.MutedBrush}"/>
                <TextBlock x:Name="Heading"
                           Margin="0,6,0,0"
                           FontSize="{DynamicResource FontSize.H2}"
                           FontWeight="{DynamicResource Weight.Bold}"
                           Foreground="{StaticResource Prism.InkBrush}"
                           Text="{DynamicResource Setup.Ffmpeg}"/>
                <TextBlock x:Name="Body"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSize.Body}"
                           Foreground="{StaticResource Prism.MutedBrush}"
                           Text="{DynamicResource Setup.FfmpegNeed}"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,18,0,12">
                <StackPanel x:Name="FfmpegPage">
                    <TextBlock Text="{DynamicResource Setup.FfmpegBody}"
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource FontSize.Body}"
                               Foreground="{StaticResource Prism.InkBrush}"/>
                    <TextBlock x:Name="FfmpegState"
                               Margin="0,14,0,0"
                               FontSize="{DynamicResource FontSize.Title}"
                               FontWeight="{DynamicResource Weight.SemiBold}"
                               Foreground="{StaticResource Prism.VioletBrush}"/>
                    <Grid Margin="0,16,0,0">
                        <Border Height="10" CornerRadius="{DynamicResource Radius.Pill}"
                                Background="{StaticResource Prism.WashBrush}"/>
                        <ProgressBar x:Name="FfmpegBar" Height="10" Minimum="0" Maximum="100"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{StaticResource Prism.BarBrush}"/>
                    </Grid>
                </StackPanel>

                <DockPanel x:Name="ModelPage" Visibility="Collapsed">
                    <TextBlock DockPanel.Dock="Top"
                               Text="{DynamicResource Setup.LocalModelBody}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               FontSize="{DynamicResource FontSize.Body}"
                               Foreground="{StaticResource Prism.InkBrush}"/>
                    <ListBox x:Name="ModelList"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="{DynamicResource Weight.SemiBold}"
                                               FontSize="{DynamicResource FontSize.Title}"
                                               Foreground="{StaticResource Prism.InkBrush}"/>
                                    <TextBlock Text="{Binding Meta}"
                                               FontSize="{DynamicResource FontSize.Caption}"
                                               Foreground="{StaticResource Prism.MutedBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <StackPanel x:Name="ProgressPage" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock x:Name="ProgressTitle"
                               FontSize="{DynamicResource FontSize.H3}"
                               FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{StaticResource Prism.InkBrush}"/>
                    <TextBlock Text="{DynamicResource Setup.NothingUploaded}"
                               Margin="0,8,0,0"
                               FontSize="{DynamicResource FontSize.Body}"
                               Foreground="{StaticResource Prism.MutedBrush}"/>
                    <Grid Margin="0,18,0,0">
                        <Border Height="10" CornerRadius="{DynamicResource Radius.Pill}"
                                Background="{StaticResource Prism.WashBrush}"/>
                        <ProgressBar x:Name="ModelBar" Height="10" Minimum="0" Maximum="100"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{StaticResource Prism.BarBrush}"/>
                    </Grid>
                    <TextBlock x:Name="ProgressState"
                               Margin="0,10,0,0"
                               FontSize="{DynamicResource FontSize.Body}"
                               Foreground="{StaticResource Prism.InkBrush}"
                               Text="{DynamicResource Setup.Downloading}"/>
                </StackPanel>
            </Grid>

            <DockPanel Grid.Row="2">
                <TextBlock x:Name="StatusLine"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="12,0,12,0"
                           FontSize="{DynamicResource FontSize.Caption}"
                           Foreground="{StaticResource Prism.MutedBrush}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BackButton" Content="{DynamicResource Setup.Back}"
                            Margin="0,0,8,0" Padding="16,8" Cursor="Hand"
                            Click="Back_Click"/>
                    <Button x:Name="SecondaryButton" Content="{DynamicResource Setup.Recheck}"
                            Margin="0,0,8,0" Padding="16,8" Cursor="Hand"
                            Click="Secondary_Click"/>
                    <Button x:Name="PrimaryButton" Content="{DynamicResource Setup.DownloadInstall}"
                            Padding="16,8" Cursor="Hand"
                            Background="{StaticResource Prism.PrimaryBrush}"
                            Foreground="{StaticResource Prism.WhiteBrush}"
                            BorderThickness="0"
                            Click="Primary_Click"/>
                </StackPanel>
                <Button x:Name="SkipButton" Content="{DynamicResource Setup.Skip}"
                        Padding="16,8" Cursor="Hand" HorizontalAlignment="Left"
                        Click="Skip_Click"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
