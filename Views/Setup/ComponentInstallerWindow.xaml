<Window x:Class="ProGlassAutomation.Views.Setup.ComponentInstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Setup.Title}"
        Width="520" Height="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource AppFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/Setup/PrismInstaller.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PrismPrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource Prism.CyanBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource Prism.InkBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="18,10"/>
                <Setter Property="MinWidth" Value="148"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
                <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{DynamicResource Radius.Pill}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrismOutlineButton" TargetType="Button" BasedOn="{StaticResource PrismPrimaryButton}">
                <Setter Property="Background" Value="{StaticResource Prism.CardBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource Prism.LineBrush}"/>
                <Setter Property="MinWidth" Value="112"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource Radius.Pill}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrismQuietButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource Prism.MutedBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrismRowStyle" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Margin" Value="0,3"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Prism.CyanBrush}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Prism.CyanBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource Prism.CanvasBrush}">
        <Border Width="480"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Background="{StaticResource Prism.CardBrush}"
                BorderBrush="{StaticResource Prism.LineBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.2XLarge}"
                Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel LastChildFill="False" Margin="0,0,0,18">
                    <Image Width="36" Height="36" DockPanel.Dock="Left"
                           Source="pack://application:,,,/Resources/proglass_icon_256.png"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="ProGlass"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSize.H2}"
                               FontWeight="{DynamicResource Weight.SemiBold}"
                               Foreground="{StaticResource Prism.InkBrush}"/>
                    <Button DockPanel.Dock="Right"
                            Content="&#xE8BB;"
                            FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource PrismQuietButton}"
                            Click="Skip_Click"
                            AutomationProperties.Name="Close"/>
                </DockPanel>

                <DockPanel Grid.Row="1">
                    <Border Width="44" Height="44" DockPanel.Dock="Left"
                            CornerRadius="{DynamicResource Radius.Large}"
                            Background="{StaticResource Prism.CyanBrush}">
                        <TextBlock x:Name="ColorIcon"
                                   Text="&#xE714;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="{StaticResource Prism.InkBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="Caption"
                                   FontSize="{DynamicResource FontSize.H2}"
                                   FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{StaticResource Prism.InkBrush}"/>
                        <TextBlock x:Name="Subtitle"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{StaticResource Prism.MutedBrush}"/>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <StackPanel x:Name="FfmpegPage">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="FfmpegTrack" Height="8" VerticalAlignment="Center" SizeChanged="Track_SizeChanged">
                                <Border CornerRadius="{DynamicResource Radius.Pill}"
                                        Background="{StaticResource Prism.WashBrush}"/>
                                <Border x:Name="FfmpegFill" HorizontalAlignment="Left" Width="0"
                                        CornerRadius="{DynamicResource Radius.Pill}"
                                        Background="{StaticResource Prism.BarBrush}"/>
                            </Grid>
                            <TextBlock x:Name="FfmpegPercent" Grid.Column="1" Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource FontSize.Caption}"
                                       FontWeight="{DynamicResource Weight.SemiBold}"
                                       Foreground="{StaticResource Prism.InkBrush}"/>
                        </Grid>
                        <TextBlock x:Name="FfmpegState"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource FontSize.Caption}"
                                   Foreground="{StaticResource Prism.MutedBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="{DynamicResource Setup.Recheck}"
                                    Style="{StaticResource PrismOutlineButton}"
                                    Margin="0,0,8,0"
                                    Click="Recheck_Click"/>
                            <Button x:Name="FfmpegInstallButton"
                                    Content="{DynamicResource Setup.DownloadInstall}"
                                    Style="{StaticResource PrismPrimaryButton}"
                                    Click="InstallFfmpeg_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <DockPanel x:Name="ModelPage" Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="{DynamicResource Setup.License}"
                                    Style="{StaticResource PrismOutlineButton}"
                                    Margin="0,0,8,0"
                                    Click="License_Click"/>
                            <Button x:Name="ModelInstallButton"
                                    Content="{DynamicResource Setup.Install}"
                                    Style="{StaticResource PrismPrimaryButton}"
                                    Click="InstallModel_Click"/>
                        </StackPanel>
                        <ListBox x:Name="ModelList"
                                 MaxHeight="180"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ItemContainerStyle="{StaticResource PrismRowStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemsSource="{Binding Models}"
                                 SelectedItem="{Binding SelectedModel, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock Text="{Binding SizeLine}"
                                                   DockPanel.Dock="Right"
                                                   VerticalAlignment="Center"
                                                   FontSize="{DynamicResource FontSize.Caption}"
                                                   Foreground="{StaticResource Prism.MutedBrush}"/>
                                        <TextBlock Text="{Binding ShortTitle}"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   FontWeight="{DynamicResource Weight.SemiBold}"
                                                   Foreground="{StaticResource Prism.InkBrush}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <StackPanel x:Name="ProgressPage" Visibility="Collapsed">
                        <TextBlock x:Name="ProgressTitle"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource FontSize.Body}"
                                   FontWeight="{DynamicResource Weight.SemiBold}"
                                   Foreground="{StaticResource Prism.InkBrush}"/>
                        <TextBlock x:Name="ProgressMeta"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource FontSize.Caption}"
                                   Foreground="{StaticResource Prism.MutedBrush}"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="ModelTrack" Height="8" VerticalAlignment="Center">
                                <Border CornerRadius="{DynamicResource Radius.Pill}"
                                        Background="{StaticResource Prism.WashBrush}"/>
                                <Border x:Name="ModelFill" HorizontalAlignment="Left" Width="0"
                                        CornerRadius="{DynamicResource Radius.Pill}"
                                        Background="{StaticResource Prism.BarBrush}"/>
                            </Grid>
                            <TextBlock x:Name="ModelPercent" Grid.Column="1" Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource FontSize.Caption}"
                                       FontWeight="{DynamicResource Weight.SemiBold}"
                                       Foreground="{StaticResource Prism.InkBrush}"/>
                        </Grid>
                        <TextBlock x:Name="ProgressState"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource FontSize.Caption}"
                                   Foreground="{StaticResource Prism.MutedBrush}"/>
                    </StackPanel>
                </Grid>

                <DockPanel Grid.Row="3" Margin="0,8,0,0" LastChildFill="False">
                    <Button x:Name="BackButton"
                            Content="{DynamicResource Setup.Back}"
                            Style="{StaticResource PrismQuietButton}"
                            Visibility="Collapsed"
                            Click="Back_Click"
                            DockPanel.Dock="Left"/>
                    <Button x:Name="CancelButton"
                            Content="{DynamicResource Setup.Cancel}"
                            Style="{StaticResource PrismQuietButton}"
                            Visibility="Collapsed"
                            Click="Cancel_Click"
                            DockPanel.Dock="Right"/>
                    <Button x:Name="SkipButton"
                            Content="{DynamicResource Setup.Close}"
                            Style="{StaticResource PrismQuietButton}"
                            Click="Skip_Click"
                            DockPanel.Dock="Right"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
