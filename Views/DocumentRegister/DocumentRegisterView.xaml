<UserControl x:Class="ProGlassAutomation.Views.DocumentRegister.DocumentRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1280"
             FontFamily="{DynamicResource AppFontFamily}"
             Background="{DynamicResource Ov.Canvas}"
             Foreground="{DynamicResource Ov.Ink}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Shared/Lists/StudioListResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16,12,16,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Document Register" Style="{StaticResource Sl.Title}" />
            <TextBlock Text="One linked view of Proforma Invoices, Job Orders, and Delivery Notes. Open / Edit uses the source workflow; status and JO priority quick-edits use the same workflow rules."
                       Style="{StaticResource Sl.Subtitle}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Sl.Card}" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="4,0">
                    <TextBlock Text="Proforma Invoices" Style="{StaticResource Sl.Label}" />
                    <TextBlock Text="{Binding VisibleProformaCount, StringFormat='{}{0:N0}'}" Style="{StaticResource Sl.Value}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="4,0">
                    <TextBlock Text="Not converted to JO" Style="{StaticResource Sl.Label}" />
                    <TextBlock Text="{Binding VisibleUnconvertedCount, StringFormat='{}{0:N0}'}" Style="{StaticResource Sl.Value}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="4,0">
                    <TextBlock Text="Job Orders" Style="{StaticResource Sl.Label}" />
                    <TextBlock Text="{Binding VisibleJobOrderCount, StringFormat='{}{0:N0}'}" Style="{StaticResource Sl.Value}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="4,0">
                    <TextBlock Text="Delivery Notes" Style="{StaticResource Sl.Label}" />
                    <TextBlock Text="{Binding VisibleDeliveryNoteCount, StringFormat='{}{0:N0}'}" Style="{StaticResource Sl.Value}" />
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,0,0,10">
            <TextBox Width="340"
                     Margin="0,0,10,0"
                     VerticalAlignment="Center"
                     Style="{StaticResource Sl.Input}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Search document numbers, customers, companies, projects, statuses, and linked document numbers" />
            <CheckBox Content="Show voided"
                      IsChecked="{Binding ShowVoided}"
                      Foreground="{DynamicResource Ov.Ink}"
                      VerticalAlignment="Center"
                      Margin="0,0,14,0"
                      ToolTip="Include soft-voided records in each tab" />
            <Button Style="{StaticResource Sl.Button}"
                    Content="Refresh"
                    Tag="&#xE72C;"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding CanRefresh}"
                    Margin="0,0,10,0" />
            <TextBlock Text="{Binding LastRefreshedText}"
                       Style="{StaticResource Sl.Subtitle}"
                       VerticalAlignment="Center" />
        </DockPanel>

        <TabControl Grid.Row="3" Style="{StaticResource PillTabControlStyle}">
            <TabItem Header="Proforma Invoices" Style="{StaticResource PillTabItemStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                        <TextBlock Text="Core commercial fields and downstream links"
                                   Style="{StaticResource Sl.Subtitle}"
                                   VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource Sl.PrimaryButton}"
                                Content="New PI"
                                Tag="&#xE710;"
                                Command="{Binding NewProformaCommand}"
                                Margin="10,0,0,0" />
                    </DockPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ProformaRows}"
                              Style="{StaticResource Sl.DataGrid}"
                              ColumnHeaderStyle="{StaticResource Sl.DataGridHeader}"
                              IsReadOnly="True"
                              CanUserSortColumns="True"
                              SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PI #" Binding="{Binding ProformaId}" Width="125" ElementStyle="{StaticResource Sl.CellText}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Issue date" Binding="{Binding IssueDate, StringFormat='{}{0:dd MMM yyyy}'}" Width="112" ElementStyle="{StaticResource Sl.CellText}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="175" ElementStyle="{StaticResource Sl.CellText}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="160" ElementStyle="{StaticResource Sl.CellText}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="180" ElementStyle="{StaticResource Sl.CellText}" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Status · edit" Width="150" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding StatusOptions}"
                                                  SelectedItem="{Binding SelectedStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanChangeStatus}"
                                                  Style="{StaticResource Sl.Combo}"
                                                  ToolTip="Select a permitted status. Approval follows the existing evidence workflow." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Value (AED)" Binding="{Binding GrandTotalVatInclusive, StringFormat='{}{0:N2}'}" Width="118" ElementStyle="{StaticResource Sl.CellText}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Job Order(s)" Binding="{Binding JobOrderIds}" Width="155" ElementStyle="{StaticResource Sl.CellText}" IsReadOnly="True" />
                            <DataGridTextColumn Header="DNs" Binding="{Binding DeliveryNoteCount}" Width="55" ElementStyle="{StaticResource Sl.CellText}" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="" Width="105" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Sl.Button}"
                                                Content="Open / Edit"
                                                Tag="&#xE8A7;"
                                                Command="{Binding DataContext.OpenProformaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Job Orders" Style="{StaticResource PillTabItemStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                        <TextBlock Text="Each JO remains linked to its source PI"
                                   Style="{StaticResource Sl.Subtitle}"
                                   VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource Sl.PrimaryButton}"
                                Content="Create Job Order"
                                Tag="&#xE7F4;"
                                Command="{Binding NewJobOrderCommand}"
                                Margin="10,0,0,0" />
                    </DockPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding JobOrderRows}"
                              Style="{StaticResource Sl.DataGrid}"
                              ColumnHeaderStyle="{StaticResource Sl.DataGridHeader}"
                              IsReadOnly="True"
                              CanUserSortColumns="True"
                              SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="JO #" Binding="{Binding JobOrderId}" Width="125" ElementStyle="{StaticResource Sl.CellText}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Source PI" Binding="{Binding SourceProformaId}" Width="125" ElementStyle="{StaticResource Sl.CellText}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="155" ElementStyle="{StaticResource Sl.CellText}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="165" ElementStyle="{StaticResource Sl.CellText}" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Status · edit" Width="150" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding StatusOptions}"
                                                  SelectedItem="{Binding SelectedStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanChangeStatus}"
                                                  Style="{StaticResource Sl.Combo}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Priority · edit" Width="112" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding PriorityOptions}"
                                                  SelectedItem="{Binding SelectedPriority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanChangePriority}"
                                                  Style="{StaticResource Sl.Combo}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Target delivery" Binding="{Binding DeliveryDate, StringFormat='{}{0:dd MMM yyyy}'}" Width="124" ElementStyle="{StaticResource Sl.CellText}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Value (AED)" Binding="{Binding GrandTotalVatInclusive, StringFormat='{}{0:N2}'}" Width="118" ElementStyle="{StaticResource Sl.CellText}" IsReadOnly="True" />
                            <DataGridTextColumn Header="DN(s)" Binding="{Binding DeliveryNoteIds}" Width="155" ElementStyle="{StaticResource Sl.CellText}" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="" Width="105" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Sl.Button}"
                                                Content="Open / Edit"
                                                Tag="&#xE8A7;"
                                                Command="{Binding DataContext.OpenJobOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Delivery Notes" Style="{StaticResource PillTabItemStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                        <TextBlock Text="DN creation and quantities stay under the JO balance workflow"
                                   Style="{StaticResource Sl.Subtitle}"
                                   VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource Sl.PrimaryButton}"
                                Content="Create Delivery Note"
                                Tag="&#xE7F4;"
                                Command="{Binding NewDeliveryNoteCommand}"
                                Margin="10,0,0,0" />
                    </DockPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding DeliveryNoteRows}"
                              Style="{StaticResource Sl.DataGrid}"
                              ColumnHeaderStyle="{StaticResource Sl.DataGridHeader}"
                              IsReadOnly="True"
                              CanUserSortColumns="True"
                              SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DN #" Binding="{Binding DeliveryNoteId}" Width="125" ElementStyle="{StaticResource Sl.CellText}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Job Order" Binding="{Binding JobOrderId}" Width="125" ElementStyle="{StaticResource Sl.CellText}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Proforma" Binding="{Binding ProformaId}" Width="125" ElementStyle="{StaticResource Sl.CellText}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="155" ElementStyle="{StaticResource Sl.CellText}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="160" ElementStyle="{StaticResource Sl.CellText}" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Status · edit" Width="150" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding StatusOptions}"
                                                  SelectedItem="{Binding SelectedStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanChangeStatus}"
                                                  Style="{StaticResource Sl.Combo}"
                                                  ToolTip="Select a permitted status; source workflow validation still applies." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Delivery date" Binding="{Binding DeliveryDate, StringFormat='{}{0:dd MMM yyyy}'}" Width="118" ElementStyle="{StaticResource Sl.CellText}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Delivered pcs" Binding="{Binding TotalDeliveredQty}" Width="92" ElementStyle="{StaticResource Sl.CellText}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Balance pcs" Binding="{Binding TotalBalanceQty}" Width="90" ElementStyle="{StaticResource Sl.CellText}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Tax invoice" Binding="{Binding TaxInvoiceId}" Width="118" ElementStyle="{StaticResource Sl.CellText}" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="" Width="105" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Sl.Button}"
                                                Content="Open / Edit"
                                                Tag="&#xE8A7;"
                                                Command="{Binding DataContext.OpenDeliveryNoteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <TextBlock Text="Loading linked document rows…"
                       Style="{StaticResource Sl.Subtitle}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Border Style="{StaticResource Sl.Error}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource Sl.Subtitle}"
                           TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
