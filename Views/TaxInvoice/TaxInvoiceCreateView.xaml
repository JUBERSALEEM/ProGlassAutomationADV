<UserControl x:Class="ProGlassAutomation.Views.TaxInvoice.TaxInvoiceCreateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12,12,0,0"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="SpecGroupCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="SpecGroupHeaderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12,12,0,0"/>
            <Setter Property="Padding" Value="16,10"/>
        </Style>

        <Style x:Key="GridHeaderCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin" Value="6,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridDataCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="6,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        </Style>

        <Style x:Key="GridNumericCell" TargetType="TextBlock" BasedOn="{StaticResource GridDataCell}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="6,8,10,8"/>
        </Style>

        <Style x:Key="ColumnSeparatorStyle" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Opacity" Value="0.4"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <!-- Stat panel style -->
        <Style x:Key="SummaryLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SummaryValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="24,16,24,16" Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Action bar -->
            <RowDefinition Height="Auto"/>
            <!-- Invoice Details Form -->
            <RowDefinition Height="*"/>
            <!-- Items Grid -->
            <RowDefinition Height="Auto"/>
            <!-- Bottom Summary Bar -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════
             ROW 0 — ACTION BAR
        ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource ModuleBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,12"
                Margin="0,0,0,12"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="← Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="{DynamicResource MenuHoverBrush}"
                        Foreground="{DynamicResource PrimaryForegroundBrush}"
                        Margin="0,0,12,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🧾 " FontSize="20" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding InvoiceNumber}"
                               FontSize="20" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <Border CornerRadius="8" Padding="10,3"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource TintIndigoBrush}">
                        <TextBlock Text="NEW TAX INVOICE"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Border>
                    <Border CornerRadius="8" Padding="10,3"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource TintGreenBrush}">
                        <TextBlock Text="{Binding CurrencyCode}"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="#047857"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="💾  Save Invoice"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#047857"
                            Visibility="{Binding IsEditable, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,0,10,0"/>

                    <Button Content="📄  Export PDF"
                            Command="{Binding ExportPdfCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#FEF2F2"
                            Foreground="#B91C1C"
                            Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,0,6,0"/>

                    <Button Content="📊  Export Excel"
                            Command="{Binding ExportExcelCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#ECFDF5"
                            Foreground="#047857"
                            Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             ROW 1 — INVOICE DETAILS FORM
        ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{DynamicResource ModuleBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18,14"
                Margin="0,0,0,12"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0 -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="CUSTOMER NAME"/>
                    <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="True" FontSize="12" Padding="10,6" Background="{DynamicResource MenuHoverBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="PROJECT NAME"/>
                    <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="True" FontSize="12" Padding="10,6" Background="{DynamicResource MenuHoverBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="4">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="DELIVERY NOTE REF"/>
                    <TextBox Text="{Binding DeliveryNoteId}"
                             IsReadOnly="True" FontSize="12" Padding="10,6" Background="{DynamicResource MenuHoverBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="6">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="INVOICE DATE"/>
                    <DatePicker SelectedDate="{Binding InvoiceDate}"
                                FontSize="12" Height="34" IsEnabled="{Binding IsEditable}"/>
                </StackPanel>

                <!-- Row 2 -->
                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="CUSTOMER TRN"/>
                    <TextBox Text="{Binding CustomerTrn, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding IsReadOnly}" FontSize="12" Padding="10,6"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="COMPANY TRN (UAE)"/>
                    <TextBox Text="{Binding CompanyTrn, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="True" FontSize="12" Padding="10,6" Background="{DynamicResource MenuHoverBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="4">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="JOB ORDER REF"/>
                    <TextBox Text="{Binding JobOrderId}"
                             IsReadOnly="True" FontSize="12" Padding="10,6" Background="{DynamicResource MenuHoverBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="6">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="CURRENCY"/>
                    <ComboBox ItemsSource="{Binding Currencies}"
                              SelectedItem="{Binding SelectedCurrency}"
                              DisplayMemberPath="Code"
                              FontSize="12" Height="34"
                              VerticalContentAlignment="Center"
                              IsEnabled="{Binding IsEditable}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             ROW 2 — ITEMS GRID SCROLL
        ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource ModuleBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Margin="0,0,0,12"
                SnapsToDevicePixels="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          CanContentScroll="False"
                          behaviors:SmoothScrollBehavior.IsEnabled="True">
                <StackPanel Margin="14,12">
                    <TextBlock Text="📦  BILLABLE GLASS ITEMS"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               Margin="4,0,4,10"/>

                    <ItemsControl ItemsSource="{Binding ItemRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*" MinWidth="150"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding SerialNumber}"
                                                   Style="{StaticResource GridDataCell}"
                                                   HorizontalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                                            <TextBlock Text="{Binding GlassRef}"
                                                       FontSize="12" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                            <TextBlock Text="{Binding SpecGroupName}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding DimensionDisplay}"
                                                   Style="{StaticResource GridDataCell}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                                        <TextBlock Grid.Column="3" Text="{Binding Sqm, StringFormat={}{0:0.000}}"
                                                   Style="{StaticResource GridNumericCell}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                                        <TextBlock Grid.Column="4" Text="{Binding DeliveredQty}"
                                                   Style="{StaticResource GridNumericCell}"/>

                                        <TextBlock Grid.Column="5" Text="{Binding PreviousInvoicedQty}"
                                                   Style="{StaticResource GridNumericCell}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                                        <TextBlock Grid.Column="6" Text="{Binding RemainingQty}"
                                                   Style="{StaticResource GridNumericCell}"
                                                   FontWeight="Bold"
                                                   Foreground="#B45309"/>

                                        <Border Grid.Column="7" Style="{StaticResource ColumnSeparatorStyle}"/>

                                        <!-- Editable Invoiced Qty -->
                                        <TextBox Grid.Column="8"
                                                 Text="{Binding InvoicedQty, UpdateSourceTrigger=PropertyChanged}"
                                                 behaviors:TextBoxBehaviors.AcceptIntegersOnly="True"
                                                 FontSize="13" FontWeight="Bold"
                                                 TextAlignment="Right"
                                                 VerticalContentAlignment="Center"
                                                 Padding="8,4,10,4" Margin="6,3"
                                                 Width="75"
                                                 BorderThickness="1.5"
                                                 BorderBrush="#4338CA"
                                                 Background="#EEF2FF"
                                                 Foreground="#3730A3"
                                                 IsReadOnly="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                                        <Border Grid.Column="9" Style="{StaticResource ColumnSeparatorStyle}"/>

                                        <TextBlock Grid.Column="10" Text="{Binding DisplayRate, StringFormat={}{0:N2}}"
                                                   Style="{StaticResource GridNumericCell}"/>

                                        <Border Grid.Column="11" Style="{StaticResource ColumnSeparatorStyle}"/>

                                        <TextBlock Grid.Column="12" Text="{Binding LineAmount, StringFormat={}{0:N2}}"
                                                   Style="{StaticResource GridNumericCell}"
                                                   Foreground="#047857"
                                                   FontWeight="Bold"/>

                                        <Border Grid.Column="13" Style="{StaticResource ColumnSeparatorStyle}"/>

                                        <TextBox Grid.Column="14"
                                                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12" Padding="8,4" Margin="6,3"
                                                 VerticalContentAlignment="Center"
                                                 IsReadOnly="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             ROW 3 — BOTTOM SUMMARY BAR
        ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Bottom Left notes/logistics -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,14"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📝" FontSize="32" VerticalAlignment="Center" Margin="0,0,16,0" Opacity="0.5"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="VAT &amp; Currency Information" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="Tax Invoice complies with UAE FTA rules. Standard VAT of 5% is calculated on the taxable amount (Subtotal after Discount). Amounts will display in the selected currency based on dynamic exchange rates."
                                   FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bottom Right Stats / Financial Summary -->
            <Border Grid.Column="2"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,14"
                    SnapsToDevicePixels="True">
                <StackPanel>
                    <TextBlock Text="INVOICE TOTALS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="Subtotal"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding CurrencySymbol}" Style="{StaticResource SummaryLabelStyle}" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding Subtotal, StringFormat={}{0:N2}}" Style="{StaticResource SummaryValueStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="Discount"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding CurrencySymbol}" Style="{StaticResource SummaryLabelStyle}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding DiscountValue, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                     FontSize="12" FontWeight="Bold"
                                     Width="80" Padding="4,2" TextAlignment="Right"
                                     IsReadOnly="{Binding IsReadOnly}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="Taxable Amount"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding CurrencySymbol}" Style="{StaticResource SummaryLabelStyle}" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding TaxableAmount, StringFormat={}{0:N2}}" Style="{StaticResource SummaryValueStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="VAT (5%)"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding CurrencySymbol}" Style="{StaticResource SummaryLabelStyle}" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding VatAmount, StringFormat={}{0:N2}}" Style="{StaticResource SummaryValueStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,8"/>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="GRAND TOTAL" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding CurrencySymbol}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GrandTotal, StringFormat={}{0:N2}}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SummaryLabelStyle}" Text="Payment:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding PaymentStatusOptions}"
                                  SelectedItem="{Binding PaymentStatus}"
                                  FontSize="11" Height="26" Margin="10,0,0,0"
                                  VerticalContentAlignment="Center"
                                  IsEnabled="{Binding IsEditable}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>