<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/TaxInvoice/TaxInvoiceView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Tax Invoice shell

     TAB STRIP UPGRADE:
       [ Workspace ]   [ God View ]   [ Activity ]
       • Workspace — the original list ↔ detail flow (preserved 1:1)
       • God View  — separate all-records overview (TaxInvoiceGodView)
       • Activity  — live per-section audit feed
═══════════════════════════════════════════════════════════════════════ -->

<!-- MIGRATION LOG — Button Standardization (master prompt v1.0)
     Date: 2026-08-15 — DN/TI/JO batch 4a
     • Shell tabs (Workspace/God View/Activity) -> STEP D two-button
       visibility pattern with MDL2 glyphs (E8B7/E774/E81C)
     • List toolbars: Clear/Refresh/Create -> Row*/Primary pills
     • Row actions (Open/Master Invoice) -> Row* variants
     • Tab-card filter icons: emoji Tags -> MDL2 glyphs + MDL2 font
       on the template icon TextBlocks
     • Hero/Empty-state icon slots -> MDL2 glyphs (controls render
       glyph-or-emoji via IconFontFamilyConverter)
     • Decorative inline meta-text emoji (dates, runs) intentionally
       left for the visual polish pass (not buttons/tabs/badges)
     Commands/bindings/code-behind preserved; no VM changes.
═══════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.TaxInvoice.TaxInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:list="clr-namespace:ProGlassAutomation.Views.TaxInvoice.TaxInvoiceList"
             xmlns:detail="clr-namespace:ProGlassAutomation.Views.TaxInvoice.TaxInvoiceDetail"
             xmlns:detailVm="clr-namespace:ProGlassAutomation.ViewModels.TaxInvoice.TaxInvoiceDetail"
             xmlns:godview="clr-namespace:ProGlassAutomation.Views.TaxInvoice.GodView"
             xmlns:sharedViews="clr-namespace:ProGlassAutomation.Views.Shared"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!--
            DataTemplate: when Content = TaxInvoiceDetailViewModel,
            WPF renders TaxInvoiceDetailView with DataContext set automatically.
            Instantiated LAZILY — only when DetailVM becomes non-null.
            Same pattern as DeliveryNoteView.xaml.
        -->
        <DataTemplate DataType="{x:Type detailVm:TaxInvoiceDetailViewModel}">
            <detail:TaxInvoiceDetailView/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ TAB STRIP ══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Style="{StaticResource ModuleTabStripStyle}"
                Margin="20,14,20,0">
            <StackPanel Orientation="Horizontal">

                <!-- TAB WORKSPACE — STEP D two-button visibility pattern -->
                <Button Command="{Binding SwitchTabCommand}"
                        CommandParameter="Workspace"
                        Tag="&#xE8B7;" Content="WORKSPACE"
                        ToolTip="Open the document workspace" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource OutlinedPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWorkspaceTab}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding SwitchTabCommand}"
                        CommandParameter="Workspace"
                        Tag="&#xE8B7;" Content="WORKSPACE"
                        ToolTip="Open the document workspace" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWorkspaceTab}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- TAB GOD VIEW — STEP D two-button visibility pattern -->
                <Button Command="{Binding SwitchTabCommand}"
                        CommandParameter="GodView"
                        Tag="&#xE774;" Content="GOD VIEW"
                        ToolTip="Cross-document overview" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource OutlinedPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGodViewTab}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding SwitchTabCommand}"
                        CommandParameter="GodView"
                        Tag="&#xE774;" Content="GOD VIEW"
                        ToolTip="Cross-document overview" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGodViewTab}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- TAB ACTIVITY — STEP D two-button visibility pattern -->
                <Button Command="{Binding SwitchTabCommand}"
                        CommandParameter="Activity"
                        Tag="&#xE81C;" Content="ACTIVITY"
                        ToolTip="Activity trail for this module" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource OutlinedPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActivityTab}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding SwitchTabCommand}"
                        CommandParameter="Activity"
                        Tag="&#xE81C;" Content="ACTIVITY"
                        ToolTip="Activity trail for this module" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActivityTab}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- ══ TAB CONTENT ════════════════════════════════════════════ -->
        <Grid Grid.Row="1">

            <!-- ═══ WORKSPACE — original list ↔ detail flow ═══ -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWorkspaceTab}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- ══ LIST VIEW ════════════════════════════════════════
                     Shown when IsListView = True.
                     DataContext explicitly set to ListVM (always non-null).
                     DataTrigger walks to parent UserControl for IsListView.
                ═══════════════════════════════════════════════════════ -->
                <list:TaxInvoiceListView DataContext="{Binding ListVM}">
                    <list:TaxInvoiceListView.Style>
                        <Style TargetType="list:TaxInvoiceListView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding DataContext.IsListView,
                                              RelativeSource={RelativeSource
                                                  AncestorType=UserControl}}"
                                    Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </list:TaxInvoiceListView.Style>
                </list:TaxInvoiceListView>

                <!-- ══ DETAIL VIEW ═══════════════════════════════════════
                     ContentControl pattern — identical to DeliveryNoteView.xaml.

                     HOW IT WORKS:
                       Content="{Binding DetailVM}" watches DetailVM on the shell VM.
                       When DetailVM null  → ContentControl renders nothing.
                       When DetailVM set   → WPF finds DataTemplate above and
                                             instantiates TaxInvoiceDetailView
                                             with DataContext = DetailVM auto.
                ═══════════════════════════════════════════════════════ -->
                <ContentControl Content="{Binding DetailVM}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDetailView}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>

            <!-- ═══ GOD VIEW TAB ═══ -->
            <godview:TaxInvoiceGodView DataContext="{Binding GodViewVM}">
                <godview:TaxInvoiceGodView.Style>
                    <Style TargetType="godview:TaxInvoiceGodView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsGodViewTab,
                                                     RelativeSource={RelativeSource
                                                         AncestorType=UserControl}}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </godview:TaxInvoiceGodView.Style>
            </godview:TaxInvoiceGodView>

            <!-- ═══ ACTIVITY TAB (live per-section audit feed) ═══ -->
            <sharedViews:SectionActivityView DataContext="{Binding ActivityVM}">
                <sharedViews:SectionActivityView.Style>
                    <Style TargetType="sharedViews:SectionActivityView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsActivityTab,
                                                     RelativeSource={RelativeSource
                                                         AncestorType=UserControl}}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </sharedViews:SectionActivityView.Style>
            </sharedViews:SectionActivityView>
        </Grid>
    </Grid>
</UserControl>
