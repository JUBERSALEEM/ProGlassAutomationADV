<!-- Studio Bento list: original collections, workflows and data contexts retained. -->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors" xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState" xmlns:layout="clr-namespace:ProGlassAutomation.Views.Dashboard" xmlns:loading="clr-namespace:ProGlassAutomation.Controls.LoadingState" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ProGlassAutomation.Views.TaxInvoice.TaxInvoiceList.TaxInvoiceListView" FontFamily="{DynamicResource AppFontFamily}" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed" UseLayoutRounding="True" SnapsToDevicePixels="True" Background="{DynamicResource Ov.Canvas}" Foreground="{DynamicResource Ov.Ink}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Shared/Lists/StudioListResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="FamilyRowTemplate">
                <Border Cursor="Hand" MinHeight="56" MouseLeftButtonUp="OnFamilyRowLeftClick" MouseRightButtonUp="OnFamilyRowRightClick">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Sl.Row}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Ov.Soft}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Ov.Soft}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="1.3*" MinWidth="120" />
                            <ColumnDefinition Width="1.5*" MinWidth="130" />
                            <ColumnDefinition Width="1.5*" MinWidth="130" />
                            <ColumnDefinition Width="1.2*" MinWidth="100" />
                            <ColumnDefinition Width="0.8*" MinWidth="85" />
                            <ColumnDefinition Width="0.9*" MinWidth="95" />
                            <ColumnDefinition Width="0.7*" MinWidth="85" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Ov.Accent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFullyPaid}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Ov.Success}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding AnyOverdue}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Ov.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,8,8,8">
                            <TextBlock
                                Text="{Binding ProformaId}"
                                FontSize="{DynamicResource FontSize.Title}"
                                FontWeight="{DynamicResource Weight.Bold}"
                                Foreground="{DynamicResource Ov.Ink}"
                                Typography.NumeralAlignment="Tabular" />
                            <TextBlock FontSize="{DynamicResource FontSize.BodySmall}" Margin="0,4,0,0" Foreground="{DynamicResource Ov.Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LatestInvoiceNumber, Mode=OneWay}">
                                <Run Text="{DynamicResource DeliveryNote.Latest}" />
                                <Run Text="{Binding LatestIssueDateDisplay, Mode=OneWay}" />
                                <Run Text="  ·  " />
                                <Run Text="{Binding LatestInvoiceNumber, Mode=OneWay}" />
                                <Run Text="  " />
                                <Run Text="{Binding LatestInvoiceStatus, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                            <TextBlock
                                Text="{Binding CustomerName}"
                                FontSize="{DynamicResource FontSize.Body}"
                                FontWeight="{DynamicResource Weight.SemiBold}"
                                Foreground="{DynamicResource Ov.Ink}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding CustomerName, Mode=OneWay}"
                                Typography.NumeralAlignment="Tabular" />
                            <TextBlock
                                Text="{Binding ProjectName}"
                                FontSize="{DynamicResource FontSize.Body}"
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource Ov.Muted}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding ProjectName, Mode=OneWay}"
                                Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                        <Border Grid.Column="3" Background="{DynamicResource Ov.Soft}" BorderBrush="{DynamicResource Ov.Line}" BorderThickness="{DynamicResource Border.HairlineThickness}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.Ink}">
                                <Run Text="{Binding InvoiceCount, Mode=OneWay}" />
                                <Run Text="{DynamicResource Reports.Inv}" />
                            </TextBlock>
                        </Border>
                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="8,0">
                            <TextBlock FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.Ink}" Margin="0,0,0,4">
                                <Run Text="{Binding ProgressPercent, Mode=OneWay, StringFormat={}{0:0.#}}" />
                                <Run Text="%" />
                            </TextBlock>
                            <Border x:Name="ProgressTrack" CornerRadius="{DynamicResource Radius.XSmall}" Height="4" Background="{DynamicResource Ov.Line}">
                                <Border CornerRadius="{DynamicResource Radius.XSmall}" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Ov.Accent}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFullyPaid}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Ov.Success}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AnyOverdue}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Ov.Danger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                            <Binding Path="ProgressPercent" />
                                            <Binding Path="ActualWidth" ElementName="ProgressTrack" />
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Grid.Column="5"
                            Text="{Binding InvoicedTotalDisplay}"
                            FontSize="{DynamicResource FontSize.Body}"
                            FontWeight="{DynamicResource Weight.Bold}"
                            Foreground="{DynamicResource Ov.Success}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Margin="0,0,12,0"
                            Typography.NumeralAlignment="Tabular"
                            TextWrapping="Wrap"
                            ToolTip="{Binding InvoicedTotalDisplay}" />
                        <TextBlock
                            Grid.Column="6"
                            Text="{Binding BalanceTotalDisplay}"
                            FontSize="{DynamicResource FontSize.Body}"
                            FontWeight="{DynamicResource Weight.Bold}"
                            Foreground="{DynamicResource Ov.Warning}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Margin="0,0,12,0"
                            Typography.NumeralAlignment="Tabular"
                            TextWrapping="Wrap"
                            ToolTip="{Binding BalanceTotalDisplay}" />
                        <StackPanel Grid.Column="7" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border CornerRadius="{DynamicResource ControlCornerRadius}" Padding="8,4" Background="{Binding FamilyStatusBrushKey,                                              Converter={StaticResource Sl.StatusBrush}, ConverterParameter=soft}">
                                <TextBlock
                                    Text="{Binding FamilyStatus}"
                                    FontSize="{DynamicResource FontSize.BodySmall}"
                                    FontWeight="{DynamicResource Weight.Bold}"
                                    Foreground="{Binding FamilyStatusBrushKey, Converter={StaticResource Sl.StatusBrush}, ConverterParameter=ink}"
                                    HorizontalAlignment="Center"
                                    Typography.NumeralAlignment="Tabular" />
                            </Border>
                            <Border Background="{DynamicResource Ov.DangerSoft}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="8,4" Margin="0,4,0,0" HorizontalAlignment="Center" Visibility="{Binding AnyOverdue,                                     Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock
                                    Text="{DynamicResource Common.Overdue}"
                                    FontSize="{DynamicResource FontSize.BodySmall}"
                                    FontWeight="{DynamicResource Weight.Bold}"
                                    Foreground="{DynamicResource Ov.Danger}" />
                            </Border>
                        </StackPanel>
                        <WrapPanel Grid.Column="8" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,8,0">
                            <Button
                                Style="{StaticResource Sl.PrimaryButton}"
                                Tag="&#xE8B7;"
                                Content="{DynamicResource Action.Open}"
                                ToolTip="{DynamicResource TaxInvoice.OpenInvoiceFamily}"
                                Command="{Binding DataContext.OpenFamilyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                            <Button
                                Style="{StaticResource Sl.DangerButton}"
                                Tag="&#xE74D;"
                                Content="{DynamicResource TaxInvoice.DEL}"
                                Margin="8,0,0,0"
                                ToolTip="{DynamicResource TaxInvoice.DeleteInvoiceFamilyAsksConfirmation}"
                                Command="{Binding DataContext.DeleteFamilyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                            <Button
                                Style="{StaticResource Sl.Button}"
                                Content="⋯"
                                ToolTip="More actions"
                                Click="OnRowMoreClick"
                                Width="34"
                                Padding="2"
                                Margin="4,4,0,4"
                                AutomationProperties.Name="More row actions" />
                        </WrapPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Reclaimed vertical space: module title/subtitle lives in shell header -->
        <Grid Grid.Row="0" Visibility="Collapsed"/>
        <Border Grid.Row="1" Margin="16,0,16,8" Style="{StaticResource Sl.Error}" Visibility="{Binding HasError,                              Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock
