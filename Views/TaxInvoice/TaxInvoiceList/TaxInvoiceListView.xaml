                                        Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                            <layout:IndigoDashboardPanel MaxColumns="2" MinimumColumnWidth="110" Gap="10">
                                <Border Style="{StaticResource Sl.Card}" Padding="14,10">
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0">
                                        <StackPanel Margin="0" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{Binding HeroCard2Label}"
                                                Style="{StaticResource Sl.Label}"
                                                TextWrapping="Wrap"
                                                Typography.NumeralAlignment="Tabular" />
                                            <TextBlock
                                                Text="{Binding HeroCard2Value}"
                                                Style="{StaticResource Sl.Value}"
                                                TextWrapping="Wrap"
                                                Typography.NumeralAlignment="Tabular" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Sl.Card}" Padding="14,10">
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0">
                                        <StackPanel Margin="0" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{Binding HeroCard3Label}"
                                                Style="{StaticResource Sl.Label}"
                                                TextWrapping="Wrap"
                                                Typography.NumeralAlignment="Tabular" />
                                            <TextBlock
                                                Text="{Binding HeroCard3Value}"
                                                Style="{StaticResource Sl.Value}"
                                                TextWrapping="Wrap"
                                                Typography.NumeralAlignment="Tabular" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Sl.Card}" Padding="14,10">
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0">
                                        <StackPanel Margin="0" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{Binding HeroCard4Label}"
                                                Style="{StaticResource Sl.Label}"
                                                TextWrapping="Wrap"
                                                Typography.NumeralAlignment="Tabular" />
                                            <TextBlock
                                                Text="{Binding HeroCard4Value}"
                                                Style="{StaticResource Sl.Value}"
                                                TextWrapping="Wrap"
                                                Typography.NumeralAlignment="Tabular" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Sl.Card}" Padding="14,10">
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0">
                                        <StackPanel Margin="0" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{Binding HeroCard5Label}"
                                                Style="{StaticResource Sl.Label}"
                                                TextWrapping="Wrap"
                                                Typography.NumeralAlignment="Tabular" />
                                            <TextBlock
                                                Text="{Binding HeroCard5Value}"
                                                Style="{StaticResource Sl.Value}"
                                                Foreground="{DynamicResource Ov.Danger}"
                                                TextWrapping="Wrap"
                                                Typography.NumeralAlignment="Tabular" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </layout:IndigoDashboardPanel>
                            <Border Style="{StaticResource Sl.Card}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Common.Actions}" Style="{StaticResource Sl.Label}" />
                                    <Button
                                        Style="{StaticResource Sl.PrimaryButton}"
                                        Tag="&#xE710;"
                                        Content="{DynamicResource Dashboard.NewInvoice}"
                                        Command="{Binding CreateInvoiceCommand}"
                                        VerticalAlignment="Center"
                                        ToolTip="{DynamicResource TaxInvoice.CreateNewTaxInvoice}"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Stretch" />
                                    <Button
                                        Style="{StaticResource Sl.PrimaryButton}"
                                        Tag="&#xE72C;"
                                        Content="{DynamicResource Action.Refresh}"
                                        ToolTip="{DynamicResource JobOrder.RefreshList}"
                                        Command="{Binding RefreshCommand}"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>
                        </layout:IndigoDashboardPanel>
                        <Border Background="{DynamicResource Ov.Soft}" Padding="12,8" Visibility="{Binding HasSelection,                                      Converter={StaticResource BoolToVisibilityConverter}}">
                            <WrapPanel>
                                <TextBlock
                                    FontSize="{DynamicResource FontSize.Body}"
                                    FontWeight="{DynamicResource Weight.Bold}"
                                    VerticalAlignment="Center"
                                    Margin="0,4,12,4"
                                    Foreground="{DynamicResource Ov.Ink}"
                                    Text="{DynamicResource TaxInvoice.Selected}"
                                    TextWrapping="Wrap"
                                    MaxWidth="600" />
                                <TextBlock
                                    Text="{Binding SelectedFamilyMetaLine}"
                                    FontSize="{DynamicResource FontSize.Body}"
                                    FontWeight="{DynamicResource Weight.SemiBold}"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding SelectedFamilyMetaLine}"
                                    Foreground="{DynamicResource Ov.Ink}"
                                    Margin="0,4,12,4"
                                    TextWrapping="Wrap"
                                    MaxWidth="600"
                                    Typography.NumeralAlignment="Tabular" />
                                <Button
