<!-- MIGRATION LOG — Button Standardization (master prompt v1.0)
     Date: 2026-08-15 — DN/TI/JO batch 4a
     • Shell tabs (Workspace/God View/Activity) -> STEP D two-button
       visibility pattern with MDL2 glyphs (E8B7/E774/E81C)
     • List toolbars: Clear/Refresh/Create -> Row*/Primary pills
     • Row actions (Open/Master Invoice) -> Row* variants
     • Tab-card filter icons: emoji Tags -> MDL2 glyphs + MDL2 font
       on the template icon TextBlocks
     • Hero/Empty-state icon slots -> MDL2 glyphs (controls render
       glyph-or-emoji via IconFontFamilyConverter)
     • Decorative inline meta-text emoji (dates, runs) intentionally
       left for the visual polish pass (not buttons/tabs/badges)
     Commands/bindings/code-behind preserved; no VM changes.
═══════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.TaxInvoice.TaxInvoiceList.TaxInvoiceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState"
             xmlns:loading="clr-namespace:ProGlassAutomation.Controls.LoadingState"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:hero="clr-namespace:ProGlassAutomation.Controls.GradientHeroCard"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="OnLoaded">

    <UserControl.Resources>

        <Style x:Key="InvListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvTabInactiveStyle" TargetType="Button">
            <Setter Property="Background"
                    Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" Padding="12,0"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" VerticalAlignment="Center"
                                           Margin="0,0,7,0" Opacity="0.7"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontSize="11" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="7,2"
                                        Margin="7,0,0,0" VerticalAlignment="Center"
                                        Background="{DynamicResource MenuHoverBrush}">
                                    <TextBlock
                                        Text="{TemplateBinding CommandParameter}"
                                        FontSize="10" FontWeight="Bold"
                                        Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background"
                                        Value="{DynamicResource MenuHoverBrush}"/>
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvTabActiveStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" Padding="12,0"
                                SnapsToDevicePixels="True">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#EEF2FF" Offset="0"/>
                                    <GradientStop Color="#E0E7FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" VerticalAlignment="Center"
                                           Margin="0,0,7,0"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontSize="11" FontWeight="Bold"
                                           VerticalAlignment="Center">
                                    <TextBlock.Foreground>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                            <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <Border CornerRadius="{DynamicResource ControlCornerRadius}" Padding="7,2"
                                        Margin="7,0,0,0" VerticalAlignment="Center"
                                        Background="{DynamicResource AccentBrush}">
                                    <TextBlock
                                        Text="{TemplateBinding CommandParameter}"
                                        FontSize="10" FontWeight="Bold"
                                        Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource OnAccentForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource AccentDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════════
             FAMILY ROW TEMPLATE — ONE ROW PER PROFORMA INVOICE
             Shows master invoice info + family-level aggregates.
             All 4 tabs use this template.
        ══════════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="FamilyRowTemplate">
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}"
                    Padding="14,12" Margin="0,0,0,8"
                    Cursor="Hand" SnapsToDevicePixels="True"
                    MouseLeftButtonUp="OnFamilyRowLeftClick"
                    MouseRightButtonUp="OnFamilyRowRightClick">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush"
                                Value="{DynamicResource OutlineBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource MenuHoverBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource TintIndigoBrush}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFullyPaid}" Value="True">
                                <Setter Property="BorderBrush" Value="#047857"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding AnyOverdue}" Value="True">
                                <Setter Property="BorderBrush" Value="#B91C1C"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── LEFT: PI identity + latest invoice ── -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Opacity="0.7"/>
                            <TextBlock Text="{Binding ProformaId}"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       VerticalAlignment="Center"/>

                            <!-- Invoice count badge -->
                            <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" CornerRadius="6" Padding="7,2"
                                    Margin="10,0,0,0" VerticalAlignment="Center"
                                    Background="{DynamicResource TintIndigoBrush}">
                                <TextBlock FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}">
                                    <Run Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets"/><Run Text=" "/>
                                    <Run Text="{Binding InvoiceCount, Mode=OneWay}"/>
                                    <Run Text=" invoice(s)"/>
                                </TextBlock>
                            </Border>

                            <!-- Family status badge -->
                            <Border CornerRadius="6" Padding="7,2"
                                    Margin="6,0,0,0" VerticalAlignment="Center">
                                <Border.Background>
                                    <Binding Path="FamilyStatusBrushKey"
                                             Converter="{StaticResource BrushKeyConverter}"/>
                                </Border.Background>
                                <TextBlock Text="{Binding FamilyStatus}"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            </Border>

                            <!-- Overdue warning -->
                            <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" CornerRadius="6" Padding="7,2"
                                    Margin="6,0,0,0" VerticalAlignment="Center"
                                    Background="{DynamicResource TintRedBrush}"
                                    Visibility="{Binding AnyOverdue,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="&#xE7BA; OVERDUE" FontFamily="Segoe MDL2 Assets"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource DangerBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- Customer · Project -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="{Binding CustomerName}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                            <TextBlock Text=" · " FontSize="12" Margin="4,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <TextBlock Text="{Binding ProjectName}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                        </StackPanel>

                        <!-- Latest invoice info -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock FontSize="10" Opacity="0.7"
                                       Foreground="{DynamicResource MutedForegroundBrush}"><Run Text="&#xE787;" FontFamily="Segoe MDL2 Assets"/><Run Text=" Latest: "/></TextBlock>
                            <TextBlock Text="{Binding LatestIssueDateDisplay}"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock FontSize="10" Margin="6,0,0,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"><Run Text=" · "/><Run Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets"/><Run Text=" "/></TextBlock>
                            <TextBlock Text="{Binding LatestInvoiceNumber}"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="  " FontSize="10"/>
                            <Border CornerRadius="4" Padding="6,1"
                                    VerticalAlignment="Center">
                                <Border.Background>
                                    <Binding Path="LatestStatusBrushKey"
                                             Converter="{StaticResource BrushKeyConverter}"/>
                                </Border.Background>
                                <TextBlock Text="{Binding LatestInvoiceStatus}"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- ── MIDDLE: progress + financial ── -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center" Margin="16,0">

                        <TextBlock HorizontalAlignment="Right"
                                   FontSize="11" FontWeight="Bold"
                                   Margin="0,0,0,4"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}">
                            <Run Text="{Binding ProgressPercent,
                                        Mode=OneWay,
                                        StringFormat={}{0:0.#}}"/>
                            <Run Text="% Invoiced"/>
                        </TextBlock>

                        <Border x:Name="ProgressTrack"
                                CornerRadius="4" Height="8"
                                Background="{DynamicResource BorderBrush}">
                            <Border CornerRadius="4" HorizontalAlignment="Left">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFullyPaid}"
                                                         Value="True">
                                                <Setter Property="Background" Value="#047857"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AnyOverdue}"
                                                         Value="True">
                                                <Setter Property="Background" Value="#B91C1C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                        <Binding Path="ProgressPercent"/>
                                        <Binding Path="ActualWidth"
                                                 ElementName="ProgressTrack"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Border>

                        <TextBlock HorizontalAlignment="Right"
                                   FontSize="10" Margin="0,5,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}">
                            <Run Text="Invoiced: "
                                 Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <Run Text="{Binding InvoicedTotalDisplay, Mode=OneWay}"
                                 FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                        </TextBlock>

                        <TextBlock HorizontalAlignment="Right"
                                   FontSize="10" Margin="0,2,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}">
                            <Run Text="Balance: "
                                 Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <Run Text="{Binding BalanceTotalDisplay, Mode=OneWay}"
                                 FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- ── RIGHT: open button ── -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Button Style="{StaticResource RowPrimaryButton}"
                                Tag="&#xE8B7;" Content="OPEN"
                                ToolTip="Open this invoice family"
                                Command="{Binding DataContext.OpenFamilyCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                        <Button Style="{StaticResource RowDangerButton}"
                                Tag="&#xE74D;" Content="DEL"
                                Margin="6,0,0,0"
                                ToolTip="Delete this invoice family (asks for confirmation)"
                                Command="{Binding DataContext.DeleteFamilyCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ STICKY HEADER ═══ -->
        <StackPanel Grid.Row="0" Margin="24,16,24,0">

            <!-- Title row -->
            <Grid Margin="4,0,4,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Tax Invoices"
                               Style="{StaticResource ModulePageTitleStyle}"/>
                    <TextBlock Text="One row per Proforma Invoice. Click to open · view partial invoices inside detail."
                               Style="{StaticResource ModulePageSubtitleStyle}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="NEW INVOICE"
                        Command="{Binding CreateInvoiceCommand}"
                        Style="{StaticResource InvHeaderButtonStyle}"
                        VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Grid>

            <!-- Loading -->
            <loading:LoadingStateControl
                    Visibility="{Binding IsLoading,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Message="Loading invoice families…"
                    Margin="4,0,4,10"/>

            <!-- Error -->
            <Border Visibility="{Binding HasError,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource ModuleErrorBannerStyle}"
                    Padding="14" Margin="4,0,4,10">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}" FontSize="12"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- KPI HERO CARDS -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <hero:GradientHeroCard Grid.Column="0"
                    Icon="&#xE7BF;" Value="{Binding HeroCard1Value}"
                    Label="{Binding HeroCard1Label}"
                    GradientStartColor="#1E40AF" GradientEndColor="#3B82F6"
                    Margin="4" MinHeight="92"/>

                <hero:GradientHeroCard Grid.Column="1"
                    Icon="&#xE70F;" Value="{Binding HeroCard2Value}"
                    Label="{Binding HeroCard2Label}"
                    GradientStartColor="{DynamicResource AccentColor}" GradientEndColor="{DynamicResource AccentHoverColor}"
                    Margin="4" MinHeight="92"/>

                <hero:GradientHeroCard Grid.Column="2"
                    Icon="&#xE72D;" Value="{Binding HeroCard3Value}"
                    Label="{Binding HeroCard3Label}"
                    GradientStartColor="#B45309" GradientEndColor="#F59E0B"
                    Margin="4" MinHeight="92"/>

                <hero:GradientHeroCard Grid.Column="3"
                    Icon="&#xE73E;" Value="{Binding HeroCard4Value}"
                    Label="{Binding HeroCard4Label}"
                    GradientStartColor="#1D4ED8" GradientEndColor="#60A5FA"
                    Margin="4" MinHeight="92"/>

                <hero:GradientHeroCard Grid.Column="4"
                    Icon="&#xE7BA;" Value="{Binding HeroCard5Value}"
                    Label="{Binding HeroCard5Label}"
                    GradientStartColor="#B91C1C" GradientEndColor="#EF4444"
                    Margin="4" MinHeight="92"/>
            </Grid>

            <!-- Selected family meta bar -->
            <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Margin="4,0,4,10" Padding="12,8" CornerRadius="{DynamicResource ControlCornerRadius}"
                    Background="{DynamicResource TintIndigoBrush}"
                    Visibility="{Binding HasSelection,
                                 Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"><Run Text="&#xE721;" FontFamily="Segoe MDL2 Assets"/><Run Text="  Selected:"/></TextBlock>
                    <TextBlock Grid.Column="1"
                               Text="{Binding SelectedFamilyMetaLine}"
                               FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <Button Grid.Column="2" Style="{StaticResource RowOutlinedButton}"
                            Tag="&#xE711;" Content="CLEAR"
                            ToolTip="Clear selection"
                            Command="{Binding ClearSelectionCommand}"/>
                </Grid>
            </Border>

            <!-- FILTER BAR -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}"
                    Padding="12,10" Margin="0,0,0,12"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText,
                                    UpdateSourceTrigger=PropertyChanged}"
                             FontSize="12" Margin="0,0,8,0"/>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding StatusFilterOptions}"
                              SelectedItem="{Binding SelectedStatusFilter}"
                              FontSize="12" Margin="0,0,8,0"/>

                    <Button Grid.Column="2" Style="{StaticResource RowOutlinedButton}"
                            Tag="&#xE711;" Content="CLEAR"
                            Margin="0,0,8,0"
                            ToolTip="Clear search and filters"
                            Command="{Binding ClearFiltersCommand}"/>

                    <Button Grid.Column="3" Style="{StaticResource RowPrimaryButton}"
                            Tag="&#xE72C;" Content="REFRESH"
                            ToolTip="Refresh list"
                            Command="{Binding RefreshCommand}"/>
                </Grid>
            </Border>

            <!-- TAB BAR — 4 tabs, all family-based -->
            <Grid Margin="4,0,4,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Tag="&#xE8A5;" Content="ALL FAMILIES"
                        CommandParameter="{Binding AllCount}"
                        Margin="0,0,3,0" Click="OnTabClick"
                        x:Name="TabAll"
                        Style="{StaticResource InvTabActiveStyle}"/>

                <Button Grid.Column="1" Tag="&#xE70F;" Content="HAS DRAFT"
                        CommandParameter="{Binding DraftCount}"
                        Margin="3,0,3,0" Click="OnTabClick"
                        x:Name="TabDraft"
                        Style="{StaticResource InvTabInactiveStyle}"/>

                <Button Grid.Column="2" Tag="&#xE72D;" Content="HAS ISSUED"
                        CommandParameter="{Binding IssuedCount}"
                        Margin="3,0,3,0" Click="OnTabClick"
                        x:Name="TabIssued"
                        Style="{StaticResource InvTabInactiveStyle}"/>

                <Button Grid.Column="3" Tag="&#xE73E;" Content="FULLY PAID"
                        CommandParameter="{Binding PaidCount}"
                        Margin="3,0,0,0" Click="OnTabClick"
                        x:Name="TabPaid"
                        Style="{StaticResource InvTabInactiveStyle}"/>
            </Grid>
        </StackPanel>

        <!-- ═══ TAB CONTENT — all use FamilyRowTemplate ═══ -->
        <Grid Grid.Row="1" Margin="30,0,30,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- v2: accent column heading strip (PI-list reference) -->
            <Border Grid.Row="0"
                    Background="{DynamicResource AccentBrush}"
                    CornerRadius="14,14,0,0"
                    Padding="16,9"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="INVOICE FAMILY (PI)"
                               Style="{StaticResource ModuleColumnHeaderStyle}"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                               ToolTip="Proforma reference + its tax invoices"/>
                    <TextBlock Grid.Column="1" Text="INVOICES &amp; STATUS"
                               Style="{StaticResource ModuleColumnHeaderStyle}"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                               HorizontalAlignment="Center"
                               ToolTip="Status chips for every invoice in the family"/>
                    <TextBlock Grid.Column="2" Text="TOTALS · BALANCE"
                               Style="{StaticResource ModuleColumnHeaderStyle}"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                               HorizontalAlignment="Right"
                               ToolTip="Family grand total and open balance"/>
                </Grid>
            </Border>

            <!-- TAB 0: ALL FAMILIES -->
            <Grid Grid.Row="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ListBox ItemsSource="{Binding AllFamilies}"
                         ItemTemplate="{StaticResource FamilyRowTemplate}"
                         ItemContainerStyle="{StaticResource InvListBoxItemStyle}"
                         BorderThickness="0" Background="Transparent"
                         Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.IsDeferredScrollingEnabled="False"
                         ScrollViewer.PanningMode="None"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingStackPanel.ScrollUnit="Pixel"
                         VirtualizingStackPanel.CacheLength="200,400"
                         VirtualizingStackPanel.CacheLengthUnit="Pixel"
                         behaviors:SmoothScrollBehavior.IsEnabled="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding AllFamilies.Count}"
                                                   Value="0"/>
                                        <Condition Binding="{Binding IsLoading}"
                                                   Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <emptyState:EmptyStateControl
                        Icon="&#xE8A5;"
                        Title="No invoice families yet"
                        Message="A family groups every tax invoice belonging to one proforma invoice. Create a tax invoice ('New Invoice' above) and its family appears here with totals, balance and status."/>
                </StackPanel>
            </Grid>

            <!-- TAB 1: HAS DRAFT -->
            <Grid Grid.Row="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ListBox ItemsSource="{Binding DraftFamilies}"
                         ItemTemplate="{StaticResource FamilyRowTemplate}"
                         ItemContainerStyle="{StaticResource InvListBoxItemStyle}"
                         BorderThickness="0" Background="Transparent"
                         Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.IsDeferredScrollingEnabled="False"
                         ScrollViewer.PanningMode="None"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingStackPanel.ScrollUnit="Pixel"
                         VirtualizingStackPanel.CacheLength="200,400"
                         VirtualizingStackPanel.CacheLengthUnit="Pixel"
                         behaviors:SmoothScrollBehavior.IsEnabled="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DraftFamilies.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <emptyState:EmptyStateControl
                        Icon="&#xE70F;"
                        Title="No families with draft invoices"
                        Message="Families appear here while any of their invoices is still a draft — not yet issued to the customer."/>
                </StackPanel>
            </Grid>

            <!-- TAB 2: HAS ISSUED -->
            <Grid Grid.Row="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ListBox ItemsSource="{Binding IssuedFamilies}"
                         ItemTemplate="{StaticResource FamilyRowTemplate}"
                         ItemContainerStyle="{StaticResource InvListBoxItemStyle}"
                         BorderThickness="0" Background="Transparent"
                         Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.IsDeferredScrollingEnabled="False"
                         ScrollViewer.PanningMode="None"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingStackPanel.ScrollUnit="Pixel"
                         VirtualizingStackPanel.CacheLength="200,400"
                         VirtualizingStackPanel.CacheLengthUnit="Pixel"
                         behaviors:SmoothScrollBehavior.IsEnabled="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IssuedFamilies.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <emptyState:EmptyStateControl
                        Icon="&#xE72D;"
                        Title="No families with issued invoices"
                        Message="Once an invoice is issued to the customer, its family moves into this tab."/>
                </StackPanel>
            </Grid>

            <!-- TAB 3: FULLY PAID -->
            <Grid Grid.Row="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ListBox ItemsSource="{Binding PaidFamilies}"
                         ItemTemplate="{StaticResource FamilyRowTemplate}"
                         ItemContainerStyle="{StaticResource InvListBoxItemStyle}"
                         BorderThickness="0" Background="Transparent"
                         Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.IsDeferredScrollingEnabled="False"
                         ScrollViewer.PanningMode="None"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingStackPanel.ScrollUnit="Pixel"
                         VirtualizingStackPanel.CacheLength="200,400"
                         VirtualizingStackPanel.CacheLengthUnit="Pixel"
                         behaviors:SmoothScrollBehavior.IsEnabled="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PaidFamilies.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <emptyState:EmptyStateControl
                        Icon="&#xE73E;"
                        Title="No fully paid families yet"
                        Message="Families appear here when every invoice in the family has been fully paid."/>
                </StackPanel>
            </Grid>

        </Grid>
    </Grid>
</UserControl>