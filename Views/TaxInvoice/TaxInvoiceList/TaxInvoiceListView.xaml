                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Status" Style="{StaticResource Sl.Label}" Margin="0,0,0,5" />
                                    <ComboBox
                                        ItemsSource="{Binding StatusFilterOptions}"
                                        SelectedItem="{Binding SelectedStatusFilter}"
                                        Style="{StaticResource Sl.Combo}"
                                        MinWidth="120"
                                        Margin="0,0,10,8"
