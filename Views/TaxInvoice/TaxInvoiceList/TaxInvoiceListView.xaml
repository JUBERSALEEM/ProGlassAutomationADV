<UserControl x:Class="ProGlassAutomation.Views.TaxInvoice.TaxInvoiceList.TaxInvoiceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:hero="clr-namespace:ProGlassAutomation.Controls.GradientHeroCard"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="OnLoaded">

    <UserControl.Resources>

        <Style x:Key="InvListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvTabInactiveStyle" TargetType="Button">
            <Setter Property="Background"
                    Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="12,0"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontSize="14" VerticalAlignment="Center"
                                           Margin="0,0,7,0" Opacity="0.7"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontSize="11" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <Border CornerRadius="10" Padding="7,2"
                                        Margin="7,0,0,0" VerticalAlignment="Center"
                                        Background="{DynamicResource MenuHoverBrush}">
                                    <TextBlock
                                        Text="{TemplateBinding CommandParameter}"
                                        FontSize="10" FontWeight="Bold"
                                        Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background"
                                        Value="{DynamicResource MenuHoverBrush}"/>
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="#4338CA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvTabActiveStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="12,0"
                                SnapsToDevicePixels="True">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4338CA" Offset="0"/>
                                    <GradientStop Color="#6366F1" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#EEF2FF" Offset="0"/>
                                    <GradientStop Color="#E0E7FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontSize="14" VerticalAlignment="Center"
                                           Margin="0,0,7,0"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontSize="11" FontWeight="Bold"
                                           VerticalAlignment="Center">
                                    <TextBlock.Foreground>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#4338CA" Offset="0"/>
                                            <GradientStop Color="#6366F1" Offset="1"/>
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <Border CornerRadius="10" Padding="7,2"
                                        Margin="7,0,0,0" VerticalAlignment="Center"
                                        Background="#4338CA">
                                    <TextBlock
                                        Text="{TemplateBinding CommandParameter}"
                                        FontSize="10" FontWeight="Bold"
                                        Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource OnAccentForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="#3730A3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════════
             FAMILY ROW TEMPLATE — ONE ROW PER PROFORMA INVOICE
             Shows master invoice info + family-level aggregates.
             All 4 tabs use this template.
        ══════════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="FamilyRowTemplate">
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderThickness="1" CornerRadius="10"
                    Padding="14,12" Margin="0,0,0,8"
                    Cursor="Hand" SnapsToDevicePixels="True"
                    MouseLeftButtonUp="OnFamilyRowLeftClick"
                    MouseRightButtonUp="OnFamilyRowRightClick">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush"
                                Value="{DynamicResource BorderBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource MenuHoverBrush}"/>
                                <Setter Property="BorderBrush" Value="#4338CA"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource TintIndigoBrush}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="BorderBrush" Value="#4338CA"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFullyPaid}" Value="True">
                                <Setter Property="BorderBrush" Value="#047857"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding AnyOverdue}" Value="True">
                                <Setter Property="BorderBrush" Value="#B91C1C"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── LEFT: PI identity + latest invoice ── -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 " FontSize="14"
                                       VerticalAlignment="Center" Opacity="0.7"/>
                            <TextBlock Text="{Binding ProformaId}"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       VerticalAlignment="Center"/>

                            <!-- Invoice count badge -->
                            <Border CornerRadius="6" Padding="7,2"
                                    Margin="10,0,0,0" VerticalAlignment="Center"
                                    Background="{DynamicResource TintIndigoBrush}">
                                <TextBlock FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}">
                                    <Run Text="🧾 "/>
                                    <Run Text="{Binding InvoiceCount, Mode=OneWay}"/>
                                    <Run Text=" invoice(s)"/>
                                </TextBlock>
                            </Border>

                            <!-- Family status badge -->
                            <Border CornerRadius="6" Padding="7,2"
                                    Margin="6,0,0,0" VerticalAlignment="Center">
                                <Border.Background>
                                    <Binding Path="FamilyStatusBrushKey"
                                             Converter="{StaticResource BrushKeyConverter}"/>
                                </Border.Background>
                                <TextBlock Text="{Binding FamilyStatus}"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            </Border>

                            <!-- Overdue warning -->
                            <Border CornerRadius="6" Padding="7,2"
                                    Margin="6,0,0,0" VerticalAlignment="Center"
                                    Background="{DynamicResource TintRedBrush}"
                                    Visibility="{Binding AnyOverdue,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="⚠️ OVERDUE"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="#B91C1C"/>
                            </Border>
                        </StackPanel>

                        <!-- Customer · Project -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="{Binding CustomerName}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                            <TextBlock Text=" · " FontSize="12" Margin="4,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <TextBlock Text="{Binding ProjectName}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                        </StackPanel>

                        <!-- Latest invoice info -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="📅 Latest: " FontSize="10" Opacity="0.7"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <TextBlock Text="{Binding LatestIssueDateDisplay}"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text=" · 🧾 " FontSize="10" Margin="6,0,0,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <TextBlock Text="{Binding LatestInvoiceNumber}"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="  " FontSize="10"/>
                            <Border CornerRadius="4" Padding="6,1"
                                    VerticalAlignment="Center">
                                <Border.Background>
                                    <Binding Path="LatestStatusBrushKey"
                                             Converter="{StaticResource BrushKeyConverter}"/>
                                </Border.Background>
                                <TextBlock Text="{Binding LatestInvoiceStatus}"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- ── MIDDLE: progress + financial ── -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center" Margin="16,0">

                        <TextBlock HorizontalAlignment="Right"
                                   FontSize="11" FontWeight="Bold"
                                   Margin="0,0,0,4"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}">
                            <Run Text="{Binding ProgressPercent,
                                        Mode=OneWay,
                                        StringFormat={}{0:0.#}}"/>
                            <Run Text="% Invoiced"/>
                        </TextBlock>

                        <Border x:Name="ProgressTrack"
                                CornerRadius="4" Height="8"
                                Background="{DynamicResource BorderBrush}">
                            <Border CornerRadius="4" HorizontalAlignment="Left">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#4338CA"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFullyPaid}"
                                                         Value="True">
                                                <Setter Property="Background" Value="#047857"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AnyOverdue}"
                                                         Value="True">
                                                <Setter Property="Background" Value="#B91C1C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                        <Binding Path="ProgressPercent"/>
                                        <Binding Path="ActualWidth"
                                                 ElementName="ProgressTrack"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Border>

                        <TextBlock HorizontalAlignment="Right"
                                   FontSize="10" Margin="0,5,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}">
                            <Run Text="Invoiced: "
                                 Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <Run Text="{Binding InvoicedTotalDisplay, Mode=OneWay}"
                                 FontWeight="Bold" Foreground="#047857"/>
                        </TextBlock>

                        <TextBlock HorizontalAlignment="Right"
                                   FontSize="10" Margin="0,2,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}">
                            <Run Text="Balance: "
                                 Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <Run Text="{Binding BalanceTotalDisplay, Mode=OneWay}"
                                 FontWeight="Bold" Foreground="#B45309"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- ── RIGHT: open button ── -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Button Cursor="Hand"
                                Command="{Binding DataContext.OpenFamilyCommand,
                                          RelativeSource={RelativeSource
                                              AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg"
                                            Background="{DynamicResource AccentBrush}"
                                            CornerRadius="7" Padding="0,10">
                                        <TextBlock Text="📂  Open"
                                                   FontSize="11" FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background"
                                                    Value="#6366F1"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bg" Property="Background"
                                                    Value="#3730A3"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ STICKY HEADER ═══ -->
        <StackPanel Grid.Row="0" Margin="24,16,24,0">

            <!-- Title row -->
            <Grid Margin="4,0,4,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Tax Invoices"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="One row per Proforma Invoice. Click to open · view partial invoices inside detail."
                               FontSize="12" Margin="0,3,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="🧾  New Invoice"
                        Command="{Binding CreateInvoiceCommand}"
                        Style="{StaticResource InvHeaderButtonStyle}"
                        VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Grid>

            <!-- Loading -->
            <Border Visibility="{Binding IsLoading,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Padding="10" Margin="4,0,4,10">
                <TextBlock Text="⏳  Loading invoice families…"
                           FontSize="12" HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </Border>

            <!-- Error -->
            <Border Visibility="{Binding HasError,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#FEF2F2" BorderBrush="#FECACA"
                    BorderThickness="1" CornerRadius="12"
                    Padding="14" Margin="4,0,4,10">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#B91C1C" FontSize="12"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- KPI HERO CARDS -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <hero:GradientHeroCard Grid.Column="0"
                    Icon="💰" Value="{Binding HeroCard1Value}"
                    Label="{Binding HeroCard1Label}"
                    GradientStartColor="#1E40AF" GradientEndColor="#3B82F6"
                    Margin="4" MinHeight="92"/>

                <hero:GradientHeroCard Grid.Column="1"
                    Icon="📝" Value="{Binding HeroCard2Value}"
                    Label="{Binding HeroCard2Label}"
                    GradientStartColor="#4338CA" GradientEndColor="#6366F1"
                    Margin="4" MinHeight="92"/>

                <hero:GradientHeroCard Grid.Column="2"
                    Icon="📤" Value="{Binding HeroCard3Value}"
                    Label="{Binding HeroCard3Label}"
                    GradientStartColor="#B45309" GradientEndColor="#F59E0B"
                    Margin="4" MinHeight="92"/>

                <hero:GradientHeroCard Grid.Column="3"
                    Icon="✅" Value="{Binding HeroCard4Value}"
                    Label="{Binding HeroCard4Label}"
                    GradientStartColor="#1D4ED8" GradientEndColor="#60A5FA"
                    Margin="4" MinHeight="92"/>

                <hero:GradientHeroCard Grid.Column="4"
                    Icon="⚠️" Value="{Binding HeroCard5Value}"
                    Label="{Binding HeroCard5Label}"
                    GradientStartColor="#B91C1C" GradientEndColor="#EF4444"
                    Margin="4" MinHeight="92"/>
            </Grid>

            <!-- Selected family meta bar -->
            <Border Margin="4,0,4,10" Padding="12,8" CornerRadius="10"
                    Background="{DynamicResource TintIndigoBrush}"
                    Visibility="{Binding HasSelection,
                                 Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="🔍  Selected:"
                               FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding SelectedFamilyMetaLine}"
                               FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <Button Grid.Column="2"
                            Content="✕ Clear"
                            Command="{Binding ClearSelectionCommand}"
                            FontSize="10" FontWeight="Bold"
                            Padding="10,4" Cursor="Hand"
                            Background="{DynamicResource ModuleBackgroundBrush}"
                            Foreground="{DynamicResource PrimaryForegroundBrush}"
                            BorderThickness="0"/>
                </Grid>
            </Border>

            <!-- FILTER BAR -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10"
                    Padding="12,10" Margin="0,0,0,12"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText,
                                    UpdateSourceTrigger=PropertyChanged}"
                             FontSize="12" Margin="0,0,8,0"/>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding StatusFilterOptions}"
                              SelectedItem="{Binding SelectedStatusFilter}"
                              FontSize="12" Margin="0,0,8,0"/>

                    <Button Grid.Column="2"
                            Content="Clear"
                            Command="{Binding ClearFiltersCommand}"
                            FontSize="11" FontWeight="SemiBold"
                            Padding="14,7" Margin="0,0,8,0" Cursor="Hand"
                            Background="{DynamicResource MenuHoverBrush}"
                            Foreground="{DynamicResource PrimaryForegroundBrush}"
                            BorderThickness="0"/>

                    <Button Grid.Column="3"
                            Content="🔄"
                            Command="{Binding RefreshCommand}"
                            FontSize="13" Padding="10,5" Cursor="Hand"
                            Background="{DynamicResource MenuHoverBrush}"
                            Foreground="{DynamicResource PrimaryForegroundBrush}"
                            BorderThickness="0" ToolTip="Refresh"/>
                </Grid>
            </Border>

            <!-- TAB BAR — 4 tabs, all family-based -->
            <Grid Margin="4,0,4,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Tag="🧾" Content="ALL FAMILIES"
                        CommandParameter="{Binding AllCount}"
                        Margin="0,0,3,0" Click="OnTabClick"
                        x:Name="TabAll"
                        Style="{StaticResource InvTabActiveStyle}"/>

                <Button Grid.Column="1" Tag="📝" Content="HAS DRAFT"
                        CommandParameter="{Binding DraftCount}"
                        Margin="3,0,3,0" Click="OnTabClick"
                        x:Name="TabDraft"
                        Style="{StaticResource InvTabInactiveStyle}"/>

                <Button Grid.Column="2" Tag="📤" Content="HAS ISSUED"
                        CommandParameter="{Binding IssuedCount}"
                        Margin="3,0,3,0" Click="OnTabClick"
                        x:Name="TabIssued"
                        Style="{StaticResource InvTabInactiveStyle}"/>

                <Button Grid.Column="3" Tag="✅" Content="FULLY PAID"
                        CommandParameter="{Binding PaidCount}"
                        Margin="3,0,0,0" Click="OnTabClick"
                        x:Name="TabPaid"
                        Style="{StaticResource InvTabInactiveStyle}"/>
            </Grid>
        </StackPanel>

        <!-- ═══ TAB CONTENT — all use FamilyRowTemplate ═══ -->
        <Grid Grid.Row="1" Margin="30,0,30,16">

            <!-- TAB 0: ALL FAMILIES -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ListBox ItemsSource="{Binding AllFamilies}"
                         ItemTemplate="{StaticResource FamilyRowTemplate}"
                         ItemContainerStyle="{StaticResource InvListBoxItemStyle}"
                         BorderThickness="0" Background="Transparent"
                         Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False"
                         ScrollViewer.IsDeferredScrollingEnabled="False"
                         ScrollViewer.PanningMode="None"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingStackPanel.ScrollUnit="Pixel"
                         VirtualizingStackPanel.CacheLength="200,400"
                         VirtualizingStackPanel.CacheLengthUnit="Pixel"
                         behaviors:SmoothScrollBehavior.IsEnabled="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding AllFamilies.Count}"
                                                   Value="0"/>
                                        <Condition Binding="{Binding IsLoading}"
                                                   Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <emptyState:EmptyStateControl
                        Icon="🧾"
                        Title="No invoice families yet"
                        Message="A family groups every tax invoice belonging to one proforma invoice. Create a tax invoice ('🧾 New Invoice' above) and its family appears here with totals, balance and status."/>
                </StackPanel>
            </Grid>

            <!-- TAB 1: HAS DRAFT -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ListBox ItemsSource="{Binding DraftFamilies}"
                         ItemTemplate="{StaticResource FamilyRowTemplate}"
                         ItemContainerStyle="{StaticResource InvListBoxItemStyle}"
                         BorderThickness="0" Background="Transparent"
                         Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False"
                         ScrollViewer.IsDeferredScrollingEnabled="False"
                         ScrollViewer.PanningMode="None"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingStackPanel.ScrollUnit="Pixel"
                         VirtualizingStackPanel.CacheLength="200,400"
                         VirtualizingStackPanel.CacheLengthUnit="Pixel"
                         behaviors:SmoothScrollBehavior.IsEnabled="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DraftFamilies.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <emptyState:EmptyStateControl
                        Icon="📝"
                        Title="No families with draft invoices"
                        Message="Families appear here while any of their invoices is still a draft — not yet issued to the customer."/>
                </StackPanel>
            </Grid>

            <!-- TAB 2: HAS ISSUED -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ListBox ItemsSource="{Binding IssuedFamilies}"
                         ItemTemplate="{StaticResource FamilyRowTemplate}"
                         ItemContainerStyle="{StaticResource InvListBoxItemStyle}"
                         BorderThickness="0" Background="Transparent"
                         Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False"
                         ScrollViewer.IsDeferredScrollingEnabled="False"
                         ScrollViewer.PanningMode="None"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingStackPanel.ScrollUnit="Pixel"
                         VirtualizingStackPanel.CacheLength="200,400"
                         VirtualizingStackPanel.CacheLengthUnit="Pixel"
                         behaviors:SmoothScrollBehavior.IsEnabled="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IssuedFamilies.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <emptyState:EmptyStateControl
                        Icon="📤"
                        Title="No families with issued invoices"
                        Message="Once an invoice is issued to the customer, its family moves into this tab."/>
                </StackPanel>
            </Grid>

            <!-- TAB 3: FULLY PAID -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ListBox ItemsSource="{Binding PaidFamilies}"
                         ItemTemplate="{StaticResource FamilyRowTemplate}"
                         ItemContainerStyle="{StaticResource InvListBoxItemStyle}"
                         BorderThickness="0" Background="Transparent"
                         Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False"
                         ScrollViewer.IsDeferredScrollingEnabled="False"
                         ScrollViewer.PanningMode="None"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingStackPanel.ScrollUnit="Pixel"
                         VirtualizingStackPanel.CacheLength="200,400"
                         VirtualizingStackPanel.CacheLengthUnit="Pixel"
                         behaviors:SmoothScrollBehavior.IsEnabled="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PaidFamilies.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <emptyState:EmptyStateControl
                        Icon="✅"
                        Title="No fully paid families yet"
                        Message="Families appear here when every invoice in the family has been fully paid."/>
                </StackPanel>
            </Grid>

        </Grid>
    </Grid>
</UserControl>