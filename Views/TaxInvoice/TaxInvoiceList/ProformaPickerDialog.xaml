<Window x:Class="ProGlassAutomation.Views.TaxInvoice.TaxInvoiceList.ProformaPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Proforma Invoice"
        Width="620" Height="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border CornerRadius="16"
            Background="{DynamicResource ModuleBackgroundBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0"
                              Opacity="0.22" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── HEADER ──────────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{DynamicResource AccentBrush}"
                    CornerRadius="16,16,0,0"
                    Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Select Proforma Invoice"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Choose a PI to create a Tax Invoice from"
                                   FontSize="11" Foreground="White"
                                   Opacity="0.85" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource RowOutlinedButton}"
                            Tag="&#xE711;" MinWidth="40"
                            Click="OnCancelClick"
                            ToolTip="Close (Esc)"/>
                </Grid>
            </Border>

            <!-- ── SEARCH ──────────────────────────────────────────────── -->
            <Border Grid.Row="1" Padding="20,14,20,8">
                <TextBox x:Name="SearchBox"
                         FontSize="13"
                         TextChanged="OnSearchChanged"/>
            </Border>

            <!-- ── PI LIST ─────────────────────────────────────────────── -->
            <ScrollViewer Grid.Row="2"
                          Margin="20,0,20,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PiList"/>
            </ScrollViewer>

            <!-- ── FOOTER ──────────────────────────────────────────────── -->
            <Border CornerRadius="{DynamicResource CardCornerRadius}" Grid.Row="3"
                    Padding="20,12"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               x:Name="SelectedLabel"
                               Text="No proforma invoice selected"
                               FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                    <Button Grid.Column="1" Style="{StaticResource OutlinedPillButton}"
                            Tag="&#xE711;" Content="CANCEL"
                            ToolTip="Close without creating"
                            Click="OnCancelClick"/>

                    <Button Grid.Column="2"
                            x:Name="ConfirmButton"
                            Style="{StaticResource SuccessPillButton}"
                            Tag="&#xE73E;" Content="CREATE TAX INVOICE"
                            ToolTip="Create the tax invoice from this proforma"
                            Click="OnConfirmClick"
                            IsEnabled="False"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>