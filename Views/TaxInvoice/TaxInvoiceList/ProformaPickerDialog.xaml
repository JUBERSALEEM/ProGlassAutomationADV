<Window x:Class="ProGlassAutomation.Views.TaxInvoice.TaxInvoiceList.ProformaPickerDialog"
             TextOptions.TextHintingMode="Fixed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Proforma Invoice"
        Width="720" Height="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
            Background="{DynamicResource ModuleBackgroundBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="{DynamicResource CardBorderThickness}"
            Margin="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0"
                              Opacity="0.22" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── HEADER ──────────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{DynamicResource AccentBrush}"
                    CornerRadius="16,16,0,0"
                    Padding="28,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Select Proforma Invoice"
                                   FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock Text="Choose a PI to create a Tax Invoice from"
                                   FontSize="{StaticResource TextBody}" Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   Opacity="0.85" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource RowOutlinedButton}"
                            Tag="&#xE711;" MinWidth="40"
                            Click="OnCancelClick"
                            ToolTip="Close (Esc)"/>
                </Grid>
            </Border>

            <!-- ── SEARCH ──────────────────────────────────────────────── -->
            <Border Grid.Row="1" Padding="24,16,24,10">
                <TextBox x:Name="SearchBox"
                         FontSize="{StaticResource TextBodyLarge}"
                         TextChanged="OnSearchChanged"/>
            </Border>

            <!-- ── PI LIST ─────────────────────────────────────────────── -->
            <ScrollViewer Grid.Row="2"
                          Margin="24,0,24,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PiList"/>
            </ScrollViewer>

            <!-- ── FOOTER ──────────────────────────────────────────────── -->
            <Border CornerRadius="0,0,16,16" Grid.Row="3"
                    Padding="24,14"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               x:Name="SelectedLabel"
                               Text="No proforma invoice selected"
                               FontSize="{StaticResource TextBody}" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                    <Button Grid.Column="1" Style="{StaticResource OutlinedPillButton}"
                            Tag="&#xE711;" Content="CANCEL"
                            ToolTip="Close without creating"
                            Click="OnCancelClick"/>

                    <Button Grid.Column="2"
                            x:Name="ConfirmButton"
                            Style="{StaticResource SuccessPillButton}"
                            Tag="&#xE73E;" Content="CREATE TAX INVOICE"
                            ToolTip="Create the tax invoice from this proforma"
                            Click="OnConfirmClick"
                            IsEnabled="False"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>