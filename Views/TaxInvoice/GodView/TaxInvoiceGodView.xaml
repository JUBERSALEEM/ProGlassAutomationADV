<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/TaxInvoice/GodView/TaxInvoiceGodView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Tax Invoice — God View tab

     Full-system overview: KPI tiles + searchable table of every tax
     invoice. Read-only; Open hands off to the normal detail view.
═══════════════════════════════════════════════════════════════════════ -->

<!-- MIGRATION LOG — Button Standardization batch 4b (2026-08-15)
     • Grey oval ModuleTabStripStyle container removed from shells —
       pills now sit directly on the page (reference look)
     • JO saved list: CLEAR/REFRESH -> Row pills; row OPEN/HISTORY ->
       RowPrimary/RowOutlined; OpenButtonStyle/HistoryButtonStyle removed
     • God Views: header Refresh -> PrimaryPillButton; row Open ->
       RowPrimaryButton; hero/empty icon slots -> MDL2 glyphs
     Commands/bindings/code-behind preserved; no VM changes.
═══════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.TaxInvoice.GodView.TaxInvoiceGodView"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Margin="20">

        <!-- Fade-in uses the hardware-scaled motion token: snappier on
             120/144/165 Hz panels, calmer on 60 Hz (PerformanceProfileService). -->
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1"
                                         Duration="{DynamicResource MotionDurationNorm}"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ HEADER ═════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource God.TiTitle}"
                           FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                <TextBlock Text="{DynamicResource God.TiSubtitle}"
                           FontSize="{StaticResource TextBody}" Margin="0,2,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </StackPanel>

            <Border Grid.Column="1"
                    MaxWidth="340"
                    Margin="24,0"
                    Background="{DynamicResource MenuHoverBrush}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="14,0"
                    Height="38"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         BorderThickness="{DynamicResource Border.NoneThickness}"
                         Background="Transparent"
                         FontSize="{StaticResource TextBodyLarge}"
                         VerticalAlignment="Center"
                         ToolTip="{DynamicResource God.TiSearch}"/>
            </Border>

            <!-- LAYOUT FIX: Grid.Column="2" was missing, so this button
                 rendered in column 0 stacked on top of the title text. -->
            <Button Grid.Column="2"
                    Style="{StaticResource PrimaryPillButton}"
                    Tag="&#xE72C;" Content="{DynamicResource God.Refresh}"
                    ToolTip="{DynamicResource God.RefreshOverview}"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}"/>
        </Grid>

        <!-- ══ KPI TILES ══════════════════════════════════════════════ -->
        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding Kpis}"
                      ItemTemplate="{StaticResource GodKpiCardTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- ══ FULL TABLE ═════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Margin="0,4,0,0"
                CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="{DynamicResource CardBorderThickness}"
                ClipToBounds="True">
                <Grid>
            <DataGrid Style="{StaticResource GodViewGridStyle}"
                      ColumnHeaderStyle="{StaticResource GodViewHeaderStyle}"
                      ItemsSource="{Binding Rows}"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      VirtualizingPanel.CacheLength="400,800"
                      VirtualizingPanel.CacheLengthUnit="Pixel"
                      ScrollViewer.CanContentScroll="True">
                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick"
                                  Command="{Binding OpenCommand}"
                                  CommandParameter="{Binding SelectedItem,
                                      RelativeSource={RelativeSource
                                          AncestorType=DataGrid}}"/>
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource God.InvoiceNumber}"
                                        Binding="{Binding InvoiceNumber}"
                                        Width="140"/>
                    <DataGridTextColumn Header="{DynamicResource God.Type}"
                                        Binding="{Binding InvoiceType}"
                                        Width="80"/>
                    <DataGridTextColumn Header="{DynamicResource God.Customer}"
                                        Binding="{Binding CustomerName}"
                                        Width="*"/>
                    <DataGridTextColumn Header="{DynamicResource God.Project}"
                                        Binding="{Binding ProjectName}"
                                        Width="*"/>
                    <DataGridTextColumn Header="{DynamicResource God.Status}"
                                        Binding="{Binding Status}"
                                        Width="105"/>
                    <DataGridTextColumn Header="{DynamicResource God.IssueDate}"
                                        Binding="{Binding IssueDate,
                                            StringFormat='dd MMM yyyy'}"
                                        Width="105"/>
                    <DataGridTextColumn Header="{DynamicResource God.DueDate}"
                                        Binding="{Binding DueDate,
                                            StringFormat='dd MMM yyyy'}"
                                        Width="105"/>
                    <DataGridTextColumn Header="{DynamicResource God.TotalAed}"
                                        Binding="{Binding GrandTotal,
                                            StringFormat='N2'}"
                                        Width="110"/>

                    <DataGridTemplateColumn Header="" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{DynamicResource God.Open}"
                                        Cursor="Hand"
                                        FontSize="{StaticResource TextBody}"
                                        Padding="10,3"
                                        BorderThickness="{DynamicResource Border.NoneThickness}"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="{DynamicResource OnAccentForegroundBrush}"
                                        Command="{Binding DataContext.OpenCommand,
                                                    RelativeSource={RelativeSource
                                                        AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

                <!-- v2 empty / no-search-result state -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Rows.Count}" Value="0"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <emptyState:EmptyStateControl
                        Icon="&#xE8A5;"
                        Title="{DynamicResource God.TiEmpty}"
                        Message="Every tax invoice in the system appears in this God View — search by invoice number, customer, project, status or type. Invoices created from deliveries or proformas show up here instantly. If nothing matches, try a different search or press Refresh."/>
                </StackPanel>
                </Grid>
        </Border>
    </Grid>
</UserControl>
