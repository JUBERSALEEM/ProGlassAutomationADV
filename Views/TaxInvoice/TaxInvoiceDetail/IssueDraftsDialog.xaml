<!-- Issue All drafts — select which family invoices to issue. -->
<Window x:Class="ProGlassAutomation.Views.TaxInvoice.TaxInvoiceDetail.IssueDraftsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource TaxInvoice.IssueTaxInvoices}"
        Width="560" SizeToContent="{DynamicResource Common.Height}"
        MinHeight="280" MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource WindowBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="80"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets"
                       FontSize="{StaticResource TextHeadline}"
                       Foreground="{DynamicResource AccentBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
            <StackPanel>
                <TextBlock Text="{DynamicResource TaxInvoice.IssueTaxInvoices}"
                           FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                <TextBlock Text="{DynamicResource TaxInvoice.FlipDraftWantIssueIssuedInvoicesStayList}"
                           FontSize="{StaticResource TextBody}" Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="SelectAllButton"
                    Content="{DynamicResource Inquiry.Select}"
                    Style="{StaticResource PiGhostChipButton}"
                    Height="32" MinWidth="110" Margin="0,0,8,0"/>
            <Button x:Name="SelectNoneButton"
                    Content="{DynamicResource TaxInvoice.SelectNONE}"
                    Style="{StaticResource PiGhostChipButton}"
                    Height="32" MinWidth="110"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      MaxHeight="360"
                      Margin="0,0,0,16">
            <ItemsControl x:Name="DraftList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="4,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Style="{StaticResource PiToggleSwitch}"
                                              IsChecked="{Binding IsOn, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="{Binding InvoiceNumber}"/>
                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding InvoiceNumber}"
                                                   FontSize="{StaticResource TextBodyLarge}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Padding="6,1" Margin="8,0,0,0"
                                                Background="{DynamicResource TintAmberBrush}"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{DynamicResource TaxInvoice.Invoice}"
                                                       FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock FontSize="{StaticResource TextCaption}"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               Margin="0,2,0,0">
                                        <Run Text="{Binding TypeLabel, Mode=OneWay}"/>
                                        <Run Text="  ·  "/>
                                        <Run Text="{Binding AmountDisplay, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CancelButton"
                    Content="{DynamicResource Action.Cancel}"
                    Cursor="Hand" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                    Padding="18,9" Margin="0,0,10,0"
                    IsCancel="True"
                    BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource MenuHoverBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="{DynamicResource CardBorderThickness}"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="IssueButton"
                    Content="{DynamicResource TaxInvoice.IssueSelected}"
                    Cursor="Hand" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                    Padding="18,9"
                    IsDefault="True"
                    BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
