<!-- Issue All drafts — select which family invoices to issue.

     2026-09 dialog audit: rebuilt on the shared ThemedDialogWindow chrome
     (previously an OS-framed window with two locally templated buttons).
     The draft list keeps its own MaxHeight scroll region and the chrome
     clamps the window to the work area. -->

<dialogs:ThemedDialogWindow x:Class="ProGlassAutomation.Views.TaxInvoice.TaxInvoiceDetail.IssueDraftsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:ProGlassAutomation.Views.Shared.Dialogs"
        Title="{DynamicResource TaxInvoice.IssueTaxInvoices}"
        Width="560"
        DialogIcon="&#xE8FB;"
        DialogSubtitle="{DynamicResource TaxInvoice.FlipDraftWantIssueIssuedInvoicesStayList}"
             FontFamily="{DynamicResource AppFontFamily}">

    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="SelectAllButton"
                    Content="{DynamicResource Inquiry.Select}"
                    Style="{StaticResource PiGhostChipButton}"
                    Height="32" MinWidth="110" Margin="0,0,8,0"/>
            <Button x:Name="SelectNoneButton"
                    Content="{DynamicResource TaxInvoice.SelectNONE}"
                    Style="{StaticResource PiGhostChipButton}"
                    Height="32" MinWidth="110"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      MaxHeight="360"
                      Margin="0,0,0,4">
            <ItemsControl x:Name="DraftList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
                                BorderThickness="{DynamicResource Border.BottomHairlineThickness}"
                                Padding="4,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Style="{StaticResource PiToggleSwitch}"
                                              IsChecked="{Binding IsOn, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="{Binding InvoiceNumber}"/>
                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding InvoiceNumber}"
                                                   FontSize="{StaticResource TextBodyLarge}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Padding="6,1" Margin="8,0,0,0"
                                                Background="{DynamicResource TintAmberBrush}"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{DynamicResource TaxInvoice.Invoice}"
                                                       FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock FontSize="{StaticResource TextCaption}"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               Margin="0,2,0,0">
                                        <Run Text="{Binding TypeLabel, Mode=OneWay}"/>
                                        <Run Text="  ·  "/>
                                        <Run Text="{Binding AmountDisplay, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>

    <dialogs:ThemedDialogWindow.FooterContent>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="CancelButton"
                    Style="{StaticResource OutlinedPillButton}"
                    Tag="&#xE711;"
                    Content="{DynamicResource Action.Cancel}"
                    Margin="0,0,10,0"
                    IsCancel="True"/>
            <Button x:Name="IssueButton"
                    Style="{StaticResource PrimaryPillButton}"
                    Tag="&#xE898;"
                    Content="{DynamicResource TaxInvoice.IssueSelected}"
                    IsDefault="True"/>
        </StackPanel>
    </dialogs:ThemedDialogWindow.FooterContent>
</dialogs:ThemedDialogWindow>
