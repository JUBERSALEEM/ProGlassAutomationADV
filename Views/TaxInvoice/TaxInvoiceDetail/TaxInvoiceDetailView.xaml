<UserControl x:Class="ProGlassAutomation.Views.TaxInvoice.TaxInvoiceDetail.TaxInvoiceDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:sections="clr-namespace:ProGlassAutomation.Views.TaxInvoice.TaxInvoiceDetail.Sections"
             xmlns:loading="clr-namespace:ProGlassAutomation.Controls.LoadingState"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding BackCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Sections/TiSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>



        <Style x:Key="TiMenuActionItem" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent"
                                CornerRadius="{DynamicResource ControlCornerRadius}" Padding="12,9"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExportButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>








        <Style x:Key="HeaderUploadButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#22FFFFFF"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ══════════════════════════════════════════════════════════════
             FAMILY MEMBER ROW STYLES (Chat 16 sidebar)
        ══════════════════════════════════════════════════════════════ -->




    
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        ROOT GRID — 4 rows
        Row 0: Action bar        (Auto)
        Row 1: Loading/Error     (Auto)
        Row 2: Stats + Attach    (Auto)
        Row 3: Main content + Family sidebar (* fills)
    -->
    <Grid Margin="{DynamicResource DensityPageMargin}"
          Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ ROW 0 — ACTION BAR ════════════════════════════════════ -->
        <Border Grid.Row="0"
                Style="{StaticResource ModuleDetailActionBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource OutlinedPillButton}"
                        Tag="&#xE72B;" Content="BACK"
                        Command="{Binding BackCommand}"
                        Margin="0,0,12,0"
                        ToolTip="Back to list (Esc)"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageTitle}"
                               Style="{StaticResource ModuleDetailTitleStyle}"/>

                    <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="10,3"
                            Margin="10,0,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource TintIndigoBrush}">
                        <TextBlock Text="{Binding Status}"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Border>

                    <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="10,3"
                            Margin="6,0,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource TintRedBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTrnValid}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="TRN INVALID"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource DangerBrush}"/>
                    </Border>

                    <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="10,3"
                            Margin="6,0,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource TintAmberBrush}"
                            Visibility="{Binding IsSaving,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Saving…"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button x:Name="ActionsMenuButton"
                            Style="{StaticResource OutlinedPillButton}"
                            Tag="&#xE712;" Content="ACTIONS"
                            ToolTip="Save, issue, mark paid, export and more"
                            Click="ActionsMenuButton_Click"/>

                    <Popup x:Name="ActionsMenuPopup"
                           PlacementTarget="{Binding ElementName=ActionsMenuButton}"
                           Placement="Bottom"
                           HorizontalAlignment="Right"
                           VerticalOffset="4"
                           AllowsTransparency="True"
                           StaysOpen="True"
                           PopupAnimation="Fade">
                        <Border Background="{DynamicResource ModuleBackgroundBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                Padding="6"
                                MinWidth="228"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4"
                                                  Direction="270" Opacity="0.25"
                                                  Color="#000000"/>
                            </Border.Effect>
                            <StackPanel>
                                <Button Style="{StaticResource TiMenuActionItem}"
                                        Tag="&#xE74E;" Content="Save  (Ctrl+S)"
                                        Command="{Binding SaveCommand}"
                                        Click="MenuActionClicked"/>
                                <Button Style="{StaticResource TiMenuActionItem}"
                                        Tag="&#xE72D;" Content="Issue invoice"
                                        Command="{Binding IssueCommand}"
                                        Click="MenuActionClicked"/>
                                <Button Style="{StaticResource TiMenuActionItem}"
                                        Tag="&#xE73E;" Content="Mark as paid"
                                        Command="{Binding MarkPaidCommand}"
                                        Click="MenuActionClicked"/>
                                <Button Style="{StaticResource TiMenuActionItem}"
                                        Tag="&#xE81C;" Content="Version history"
                                        Command="{Binding ShowVersionsCommand}"
                                        Click="MenuActionClicked"/>
                                <Border Height="1" Margin="10,4"
                                        Background="{DynamicResource OutlineBrush}"/>
                                <Button Style="{StaticResource TiMenuActionItem}"
                                        Tag="&#xE8A5;" Content="Export PDF"
                                        Command="{Binding ExportPdfCommand}"
                                        Click="MenuActionClicked"/>
                                <Border Height="1" Margin="10,4"
                                        Background="{DynamicResource OutlineBrush}"/>
                                <Button Style="{StaticResource TiMenuActionItem}"
                                        Tag="&#xE74D;" Content="Delete invoice"
                                        Command="{Binding DeleteCommand}"
                                        Click="MenuActionClicked"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ ROW 1 — LOADING / STATUS ══════════════════════════════ -->
        <StackPanel Grid.Row="1">
            <loading:LoadingStateControl
                    Visibility="{Binding IsLoading,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Message="Loading invoice…"
                    Margin="0,8,0,10"/>
            <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Visibility="{Binding HasStatusMessage,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{DynamicResource TintIndigoBrush}"
                    CornerRadius="{DynamicResource ControlCornerRadius}" Padding="14,10"
                    Margin="0,0,0,10">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
            </Border>
        </StackPanel>

        <!-- ══ ROW 2 — FINANCIAL STATS + ATTACHMENTS ═════════════════ -->
        <!-- ══ DETAIL TABS — Overview / Attachments / Family ═════════ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,14">
            <Button Content="OVERVIEW" Tag="&#xE8A5;" Margin="0,0,8,0"
                    ToolTip="Invoice content and financials"
                    Command="{Binding SwitchDetailTabCommand}" CommandParameter="Overview">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RowOutlinedButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOverviewTab}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="ATTACHMENTS" Tag="&#xE723;" Margin="0,0,8,0"
                    ToolTip="Attached images and PDFs"
                    Command="{Binding SwitchDetailTabCommand}" CommandParameter="Attachments">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RowOutlinedButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAttachmentsTab}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="FAMILY" Tag="&#xE716;"
                    ToolTip="Invoice family members"
                    Command="{Binding SwitchDetailTabCommand}" CommandParameter="Family">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RowOutlinedButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFamilyTab}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- ══ TAB CONTENT — each section is its own UserControl ═════ -->
        <Grid Grid.Row="3">
            <sections:TiOverviewSection
                Visibility="{Binding IsOverviewTab, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <sections:TiAttachmentsSection
                Visibility="{Binding IsAttachmentsTab, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <sections:TiFamilySection
                Visibility="{Binding IsFamilyTab, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</UserControl>