<UserControl x:Class="ProGlassAutomation.Views.TaxInvoice.TaxInvoiceDetail.TaxInvoiceDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding BackCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExportButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12,12,0,0"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="GridHeaderCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin" Value="6,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridNumericCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,8,10,8"/>
        </Style>

        <Style x:Key="GridDataCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,8"/>
        </Style>

        <Style x:Key="ColumnSeparatorStyle" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Opacity" Value="0.4"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style x:Key="CompactStatTileStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="MinHeight" Value="70"/>
        </Style>

        <Style x:Key="HeaderUploadButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#22FFFFFF"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SpecGroupCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

    </UserControl.Resources>

    <!--
        ROOT GRID — 4 rows (mirrors DeliveryNoteDetailView pattern exactly)
        Row 0: Action bar        (Auto)
        Row 1: Loading/Error     (Auto)
        Row 2: Stats + Attach    (Auto)
        Row 3: Items + Summary   (* fills)
    -->
    <Grid Margin="24,16,24,16"
          Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ ROW 0 — ACTION BAR ════════════════════════════════════ -->
        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back button -->
                <Button Grid.Column="0"
                        Content="← Back"
                        Command="{Binding BackCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="{DynamicResource MenuHoverBrush}"
                        Foreground="{DynamicResource PrimaryForegroundBrush}"
                        Margin="0,0,12,0"
                        ToolTip="Back to list (Esc)"/>

                <!-- Title + status badges -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageTitle}"
                               FontSize="18" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>

                    <Border CornerRadius="8" Padding="10,3"
                            Margin="10,0,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource TintIndigoBrush}">
                        <TextBlock Text="{Binding Status}"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Border>

                    <!-- TRN warning badge -->
                    <Border CornerRadius="8" Padding="10,3"
                            Margin="6,0,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource TintRedBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTrnValid}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="⚠️ TRN INVALID"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="#B91C1C"/>
                    </Border>

                    <!-- Saving indicator -->
                    <Border CornerRadius="8" Padding="10,3"
                            Margin="6,0,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource TintAmberBrush}"
                            Visibility="{Binding IsSaving,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="💾 Saving…"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="#B45309"/>
                    </Border>
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Content="💾  Save"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="0,0,6,0"
                            ToolTip="Save invoice (Ctrl+S)"/>

                    <Button Content="📤  Issue"
                            Command="{Binding IssueCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#B45309"
                            Margin="0,0,6,0"
                            ToolTip="Mark invoice as Issued"/>

                    <Button Content="✅  Mark Paid"
                            Command="{Binding MarkPaidCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#047857"
                            Margin="0,0,12,0"
                            ToolTip="Mark invoice as Paid"/>

                    <Border Width="1" Margin="0,4,12,4"
                            Background="{DynamicResource BorderBrush}"/>

                    <Button Content="📄  PDF"
                            Command="{Binding ExportPdfCommand}"
                            Style="{StaticResource ExportButtonStyle}"
                            Background="#FEF2F2"
                            BorderBrush="#B91C1C"
                            Foreground="#B91C1C"
                            Margin="0,0,6,0"
                            ToolTip="Export as PDF"/>

                    <Border Width="1" Margin="0,4,12,4"
                            Background="{DynamicResource BorderBrush}"/>

                    <Button Content="🗑️  Delete"
                            Command="{Binding DeleteCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#B91C1C"
                            Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ ROW 1 — LOADING / ERROR ═══════════════════════════════ -->
        <StackPanel Grid.Row="1">
            <Border Visibility="{Binding IsLoading,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Padding="20">
                <TextBlock Text="⏳  Loading invoice…"
                           FontSize="14" HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </Border>
            <Border Visibility="{Binding HasStatusMessage,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{DynamicResource TintIndigoBrush}"
                    CornerRadius="10" Padding="14,10"
                    Margin="0,0,0,10">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
            </Border>
        </StackPanel>

        <!-- ══ ROW 2 — FINANCIAL STATS + ATTACHMENTS ═════════════════ -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- ── FINANCIAL STATS CARD (left) ── -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Border Style="{StaticResource SectionHeaderStyle}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#047857" Offset="0"/>
                                <GradientStop Color="#10B981" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="💰  FINANCIAL SUMMARY"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="Live totals — updates as you edit rows"
                                       FontSize="10" Foreground="#CCFFFFFF"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="12,12,12,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Subtotal -->
                        <Border Grid.Row="0" Grid.Column="0"
                                Style="{StaticResource CompactStatTileStyle}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding SubtotalDisplay}"
                                           FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="SUBTOTAL"
                                           FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- VAT -->
                        <Border Grid.Row="0" Grid.Column="2"
                                Style="{StaticResource CompactStatTileStyle}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding VatDisplay}"
                                           FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="VAT (5%)"
                                           FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Discount -->
                        <Border Grid.Row="2" Grid.Column="0"
                                Style="{StaticResource CompactStatTileStyle}"
                                Background="{DynamicResource TintAmberBrush}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding DiscountAmountDisplay}"
                                           FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Foreground="#B45309"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="DISCOUNT"
                                           FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"
                                           Foreground="#B45309"/>
                            </StackPanel>
                        </Border>

                        <!-- Grand Total -->
                        <Border Grid.Row="2" Grid.Column="2"
                                Style="{StaticResource CompactStatTileStyle}"
                                Background="{DynamicResource TintGreenBrush}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding GrandTotalDisplay}"
                                           FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Foreground="#047857"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="GRAND TOTAL"
                                           FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"
                                           Foreground="#047857"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── ATTACHMENTS CARD (right) ── -->
            <Border Grid.Column="2"
                    Style="{StaticResource CardStyle}"
                    MaxHeight="260">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource SectionHeaderStyle}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#4338CA" Offset="0"/>
                                <GradientStop Color="#6366F1" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="📎  ATTACHMENTS"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="White"/>
                                <TextBlock Text="Signed PI · Signed DN · Supporting docs"
                                           FontSize="10" Foreground="#CCFFFFFF"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="+ Add File"
                                    Command="{Binding AddAttachmentCommand}"
                                    Style="{StaticResource HeaderUploadButtonStyle}"
                                    ToolTip="Attach PDF or image (max 10 MB)"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  IsDeferredScrollingEnabled="False"
                                  PanningMode="None"
                                  behaviors:SmoothScrollBehavior.IsEnabled="True">
                        <StackPanel>
                            <!-- Empty state -->
                            <Border Padding="16,20">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding Attachments.Count}"
                                                Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📎" FontSize="32"
                                               HorizontalAlignment="Center"
                                               Opacity="0.4"/>
                                    <TextBlock Text="No attachments yet"
                                               FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,4"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Text="Add signed PI or DN PDFs here."
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Attachment rows -->
                            <ItemsControl ItemsSource="{Binding Attachments}"
                                          Margin="10,6,10,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,4" Padding="12,10"
                                                CornerRadius="10"
                                                Background="{DynamicResource MenuHoverBrush}"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Type icon -->
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding TypeIcon}"
                                                           FontSize="22"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>

                                                <!-- File info -->
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Margin="10,0,8,0">
                                                    <TextBlock Text="{Binding FileName}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                    <TextBlock FontSize="10" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}">
                                                        <Run Text="{Binding TypeLabel, Mode=OneWay}"/>
                                                        <Run Text="  ·  "/>
                                                        <Run Text="{Binding FileSizeDisplay, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Attachment type selector -->
                                                <ComboBox Grid.Column="2"
                                                          SelectedItem="{Binding AttachmentType}"
                                                          FontSize="10"
                                                          Height="28"
                                                          Margin="0,0,6,0"
                                                          VerticalContentAlignment="Center">
                                                    <ComboBoxItem Content="SignedPI"/>
                                                    <ComboBoxItem Content="SignedDN"/>
                                                    <ComboBoxItem Content="Other"/>
                                                </ComboBox>

                                                <!-- Remove button -->
                                                <Button Grid.Column="3"
                                                        Content="✕"
                                                        Command="{Binding DataContext.RemoveAttachmentCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        FontSize="12" FontWeight="Bold"
                                                        Padding="8,4" Cursor="Hand"
                                                        Background="#B91C1C"
                                                        Foreground="White"
                                                        BorderThickness="0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ══ ROW 3 — MAIN CONTENT + FINANCIAL SUMMARY SIDEBAR ══════ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: INVOICE CONTENT CARD ── -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Hero strip -->
                        <RowDefinition Height="Auto"/>
                        <!-- Header fields form -->
                        <RowDefinition Height="*"/>
                        <!-- Spec groups scrolls -->
                    </Grid.RowDefinitions>

                    <!-- HERO STRIP -->
                    <Border Grid.Row="0" CornerRadius="12,12,0,0" Padding="18,14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4338CA" Offset="0"/>
                                <GradientStop Color="#6366F1" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧾  TAX INVOICE  ·  "
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="#CCFFFFFF"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CustomerName}"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="White"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="400"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ProjectName}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#EAFFFFFF"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="500"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="PI: " FontSize="10" FontWeight="Bold"
                                               Foreground="#CCFFFFFF" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ProformaId}"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="  ·  " FontSize="12"
                                               Foreground="#77FFFFFF" VerticalAlignment="Center"/>
                                    <TextBlock Text="TRN: " FontSize="10" FontWeight="Bold"
                                               Foreground="#CCFFFFFF" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CompanyTrn}"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding GrandTotalDisplay}"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding GrandTotalInWords}"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="#CCFFFFFF"
                                           HorizontalAlignment="Right"
                                           Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="260"/>
                                <TextBlock FontSize="10" Margin="0,6,0,0"
                                           HorizontalAlignment="Right"
                                           Foreground="#CCFFFFFF">
                                    <Run Text="Due: "/>
                                    <Run Text="{Binding DueDate,
                                                StringFormat='dd MMM yyyy',
                                                Mode=OneWay}"
                                         FontWeight="Bold" Foreground="White"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- HEADER FIELDS FORM -->
                    <Border Grid.Row="1"
                            Padding="18,14"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <!-- Row 1: PI ref, DN ref, PO, Status -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="PROFORMA INVOICE REF"/>
                                    <TextBox Text="{Binding ProformaId,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="DELIVERY NOTE REF"/>
                                    <TextBox Text="{Binding DeliveryNoteReference,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="CUSTOMER PO NUMBER"/>
                                    <TextBox Text="{Binding PurchaseOrderNumber,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="STATUS"/>
                                    <ComboBox ItemsSource="{Binding StatusOptions}"
                                              SelectedItem="{Binding Status}"
                                              FontSize="12" Height="38"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: Issue Date, Payment Terms, Bank, TRN -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="ISSUE DATE"/>
                                    <DatePicker SelectedDate="{Binding IssueDate}"
                                                FontSize="12" Height="38"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="PAYMENT TERMS"/>
                                    <ComboBox ItemsSource="{Binding PaymentTermsOptions}"
                                              SelectedItem="{Binding PaymentTerms}"
                                              FontSize="12" Height="38"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="BANK NAME"/>
                                    <TextBox Text="{Binding BankName,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="COMPANY TRN (15 DIGITS)"/>
                                    <TextBox Text="{Binding CompanyTrn,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- SPEC GROUPS + GLASS ITEM ROWS (internal scroll) -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  CanContentScroll="False"
                                  IsDeferredScrollingEnabled="False"
                                  PanningMode="None"
                                  behaviors:SmoothScrollBehavior.IsEnabled="True">
                        <StackPanel Margin="14,12,14,14">

                            <!-- Spec groups header + add button -->
                            <Grid Margin="4,0,4,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="📦  GLASS ITEMS"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Text="Add spec groups then enter glass rows with dimensions, qty and rate."
                                               FontSize="10" Margin="0,2,0,0"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="+ Add Spec Group"
                                        Command="{Binding AddSpecGroupCommand}"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Padding="14,7" FontSize="11"
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Empty state -->
                            <Border Padding="32,40">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding SpecGroups.Count}"
                                                Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📦" FontSize="48"
                                               HorizontalAlignment="Center"
                                               Opacity="0.3"/>
                                    <TextBlock Text="No glass items yet"
                                               FontSize="16" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,12,0,4"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Text="Click '+ Add Spec Group' to start building the invoice."
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Spec group cards -->
                            <ItemsControl ItemsSource="{Binding SpecGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SpecGroupCardStyle}">
                                            <StackPanel>

                                                <!-- Spec group header -->
                                                <Border CornerRadius="12,12,0,0" Padding="14,10">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#4338CA" Offset="0"/>
                                                            <GradientStop Color="#6366F1" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0"
                                                                Width="4" CornerRadius="2"
                                                                Background="White"
                                                                Margin="0,0,10,0"/>

                                                        <StackPanel Grid.Column="1"
                                                                    Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="SPEC: "
                                                                       FontSize="11" FontWeight="Bold"
                                                                       Foreground="#CCFFFFFF"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBox Text="{Binding GroupName,
                                                                           UpdateSourceTrigger=PropertyChanged}"
                                                                     FontSize="13" FontWeight="Bold"
                                                                     Background="Transparent"
                                                                     Foreground="White"
                                                                     BorderThickness="0"
                                                                     Padding="4,2"
                                                                     MinWidth="200"
                                                                     VerticalContentAlignment="Center"/>
                                                        </StackPanel>

                                                        <!-- Rate per SQM -->
                                                        <StackPanel Grid.Column="2"
                                                                    Orientation="Horizontal"
                                                                    VerticalAlignment="Center"
                                                                    Margin="16,0,0,0">
                                                            <TextBlock Text="Rate/SQM: "
                                                                       FontSize="10" FontWeight="Bold"
                                                                       Foreground="#CCFFFFFF"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBox Text="{Binding BaseRate,
                                                                           UpdateSourceTrigger=PropertyChanged,
                                                                           StringFormat={}{0:0.00}}"
                                                                     behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                                                     FontSize="12" FontWeight="Bold"
                                                                     Background="Transparent"
                                                                     Foreground="White"
                                                                     BorderThickness="0"
                                                                     Padding="4,2"
                                                                     Width="80"
                                                                     TextAlignment="Right"
                                                                     VerticalContentAlignment="Center"/>
                                                            <TextBlock Text=" AED"
                                                                       FontSize="10" FontWeight="Bold"
                                                                       Foreground="#CCFFFFFF"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>

                                                        <!-- Group total -->
                                                        <StackPanel Grid.Column="3"
                                                                    Orientation="Horizontal"
                                                                    VerticalAlignment="Center"
                                                                    Margin="16,0,0,0">
                                                            <TextBlock Text="Total: "
                                                                       FontSize="10"
                                                                       Foreground="#CCFFFFFF"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock FontSize="12" FontWeight="Bold"
                                                                       Foreground="White"
                                                                       VerticalAlignment="Center">
                                                                <Run Text="AED "/>
                                                                <Run Text="{Binding GroupTotalValue,
                                                                            Mode=OneWay,
                                                                            StringFormat={}{0:N2}}"/>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <!-- Add row button -->
                                                        <Button Grid.Column="4"
                                                                Content="+ Row"
                                                                Command="{Binding AddRowCommand}"
                                                                Margin="12,0,6,0"
                                                                FontSize="10" FontWeight="Bold"
                                                                Padding="10,4" Cursor="Hand"
                                                                Background="#22FFFFFF"
                                                                Foreground="White"
                                                                BorderThickness="0"/>

                                                        <!-- Remove group button -->
                                                        <Button Grid.Column="5"
                                                                Content="✕ Group"
                                                                Command="{Binding DataContext.RemoveSpecGroupCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                FontSize="10" FontWeight="Bold"
                                                                Padding="10,4" Cursor="Hand"
                                                                Background="#33FF0000"
                                                                Foreground="White"
                                                                BorderThickness="0"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Column headers -->
                                                <Border Background="{DynamicResource MenuHoverBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40"/>
                                                            <ColumnDefinition Width="*" MinWidth="160"/>
                                                            <ColumnDefinition Width="65"/>
                                                            <ColumnDefinition Width="65"/>
                                                            <ColumnDefinition Width="55"/>
                                                            <ColumnDefinition Width="55"/>
                                                            <ColumnDefinition Width="55"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="72"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="82"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="85"/>
                                                            <ColumnDefinition Width="40"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="#"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="GLASS REF"
                                                                   Style="{StaticResource GridHeaderCell}"/>
                                                        <TextBlock Grid.Column="2" Text="W1"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <TextBlock Grid.Column="3" Text="H1"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <TextBlock Grid.Column="4" Text="W2"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <TextBlock Grid.Column="5" Text="H2"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <TextBlock Grid.Column="6" Text="QTY"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <Border Grid.Column="7"
                                                                Style="{StaticResource ColumnSeparatorStyle}"/>
                                                        <TextBlock Grid.Column="8" Text="SQM"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <Border Grid.Column="9"
                                                                Style="{StaticResource ColumnSeparatorStyle}"/>
                                                        <TextBlock Grid.Column="10" Text="T.SQM"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <Border Grid.Column="11"
                                                                Style="{StaticResource ColumnSeparatorStyle}"/>
                                                        <TextBlock Grid.Column="12" Text="RATE · VALUE"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="#4338CA"
                                                                   Margin="6,8,10,8"/>
                                                        <TextBlock Grid.Column="13" Text=""
                                                                   Style="{StaticResource GridHeaderCell}"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Glass item rows -->
                                                <ItemsControl ItemsSource="{Binding Rows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="0,0,0,1"
                                                                    Padding="0,2">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="40"/>
                                                                        <ColumnDefinition Width="*" MinWidth="160"/>
                                                                        <ColumnDefinition Width="65"/>
                                                                        <ColumnDefinition Width="65"/>
                                                                        <ColumnDefinition Width="55"/>
                                                                        <ColumnDefinition Width="55"/>
                                                                        <ColumnDefinition Width="55"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="72"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="82"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="85"/>
                                                                        <ColumnDefinition Width="40"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- # -->
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding SerialNumber}"
                                                                               Style="{StaticResource GridDataCell}"
                                                                               HorizontalAlignment="Center"/>

                                                                    <!-- Glass Ref -->
                                                                    <TextBox Grid.Column="1"
                                                                             Text="{Binding GlassRef,
                                                                                   UpdateSourceTrigger=PropertyChanged}"
                                                                             FontSize="12"
                                                                             Padding="6,4"
                                                                             Margin="4,3"
                                                                             VerticalContentAlignment="Center"/>

                                                                    <!-- W1 -->
                                                                    <TextBox Grid.Column="2"
                                                                             Text="{Binding W1,
                                                                                   UpdateSourceTrigger=PropertyChanged}"
                                                                             behaviors:TextBoxBehaviors.AcceptIntegersOnly="True"
                                                                             FontSize="12" FontWeight="SemiBold"
                                                                             TextAlignment="Right"
                                                                             Padding="4,4,8,4" Margin="2,3"
                                                                             VerticalContentAlignment="Center"/>

                                                                    <!-- H1 -->
                                                                    <TextBox Grid.Column="3"
                                                                             Text="{Binding H1,
                                                                                   UpdateSourceTrigger=PropertyChanged}"
                                                                             behaviors:TextBoxBehaviors.AcceptIntegersOnly="True"
                                                                             FontSize="12" FontWeight="SemiBold"
                                                                             TextAlignment="Right"
                                                                             Padding="4,4,8,4" Margin="2,3"
                                                                             VerticalContentAlignment="Center"/>

                                                                    <!-- W2 -->
                                                                    <TextBox Grid.Column="4"
                                                                             Text="{Binding W2,
                                                                                   UpdateSourceTrigger=PropertyChanged}"
                                                                             behaviors:TextBoxBehaviors.AcceptIntegersOnly="True"
                                                                             FontSize="11"
                                                                             TextAlignment="Right"
                                                                             Padding="4,4,8,4" Margin="2,3"
                                                                             Opacity="0.7"
                                                                             VerticalContentAlignment="Center"/>

                                                                    <!-- H2 -->
                                                                    <TextBox Grid.Column="5"
                                                                             Text="{Binding H2,
                                                                                   UpdateSourceTrigger=PropertyChanged}"
                                                                             behaviors:TextBoxBehaviors.AcceptIntegersOnly="True"
                                                                             FontSize="11"
                                                                             TextAlignment="Right"
                                                                             Padding="4,4,8,4" Margin="2,3"
                                                                             Opacity="0.7"
                                                                             VerticalContentAlignment="Center"/>

                                                                    <!-- QTY -->
                                                                    <TextBox Grid.Column="6"
                                                                             Text="{Binding Qty,
                                                                                   UpdateSourceTrigger=PropertyChanged}"
                                                                             behaviors:TextBoxBehaviors.AcceptIntegersOnly="True"
                                                                             FontSize="12" FontWeight="Bold"
                                                                             TextAlignment="Right"
                                                                             Padding="4,4,8,4" Margin="2,3"
                                                                             BorderBrush="#4338CA"
                                                                             Background="#EEF2FF"
                                                                             Foreground="#3730A3"
                                                                             VerticalContentAlignment="Center"/>

                                                                    <Border Grid.Column="7"
                                                                            Style="{StaticResource ColumnSeparatorStyle}"/>

                                                                    <!-- SQM (computed) -->
                                                                    <TextBlock Grid.Column="8"
                                                                               Text="{Binding Sqm,
                                                                                      StringFormat={}{0:0.000}}"
                                                                               Style="{StaticResource GridNumericCell}"
                                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                                                                    <Border Grid.Column="9"
                                                                            Style="{StaticResource ColumnSeparatorStyle}"/>

                                                                    <!-- T.SQM (computed) -->
                                                                    <TextBlock Grid.Column="10"
                                                                               Text="{Binding TotalSqm,
                                                                                      StringFormat={}{0:0.000}}"
                                                                               Style="{StaticResource GridNumericCell}"
                                                                               FontWeight="Bold"/>

                                                                    <Border Grid.Column="11"
                                                                            Style="{StaticResource ColumnSeparatorStyle}"/>

                                                                    <!-- Rate · Value (stacked) -->
                                                                    <StackPanel Grid.Column="12"
                                                                                VerticalAlignment="Center"
                                                                                Margin="4,2">
                                                                        <TextBox Text="{Binding Rate,
                                                                                       UpdateSourceTrigger=PropertyChanged,
                                                                                       StringFormat={}{0:0.00}}"
                                                                                 behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                                                                 FontSize="11" FontWeight="Bold"
                                                                                 TextAlignment="Right"
                                                                                 Padding="4,2,6,2"
                                                                                 BorderBrush="#047857"
                                                                                 Background="#ECFDF5"
                                                                                 Foreground="#065F46"
                                                                                 VerticalContentAlignment="Center"/>
                                                                        <TextBlock Text="{Binding Value,
                                                                                          StringFormat=AED {0:N2}}"
                                                                                   FontSize="11" FontWeight="Bold"
                                                                                   HorizontalAlignment="Right"
                                                                                   Margin="0,2,4,0"
                                                                                   Foreground="#047857"/>
                                                                    </StackPanel>

                                                                    <!-- Remove row -->
                                                                    <Button Grid.Column="13"
                                                                            Content="✕"
                                                                            Command="{Binding DataContext.RemoveRowCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            FontSize="11" FontWeight="Bold"
                                                                            Padding="6,4" Cursor="Hand"
                                                                            Background="#B91C1C"
                                                                            Foreground="White"
                                                                            BorderThickness="0"
                                                                            Margin="4,3"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Spec group footer totals -->
                                                <Border Background="{DynamicResource TintIndigoBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="0,1,0,0"
                                                        Padding="16,10"
                                                        CornerRadius="0,0,12,12">
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Right">
                                                        <TextBlock Text="GROUP TOTAL: "
                                                                   FontSize="11" FontWeight="Bold"
                                                                   Foreground="#4338CA"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock FontSize="11"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="8,0,16,0">
                                                            <Run Text="{Binding GroupTotalQty, Mode=OneWay}"
                                                                 FontWeight="Bold"/>
                                                            <Run Text=" pcs  ·  "/>
                                                            <Run Text="{Binding GroupTotalSqm, Mode=OneWay,
                                                                        StringFormat={}{0:0.000}}"
                                                                 FontWeight="Bold"/>
                                                            <Run Text=" SQM"/>
                                                        </TextBlock>
                                                        <TextBlock FontSize="13" FontWeight="Bold"
                                                                   Foreground="#047857"
                                                                   VerticalAlignment="Center">
                                                            <Run Text="AED "/>
                                                            <Run Text="{Binding GroupTotalValue, Mode=OneWay,
                                                                        StringFormat={}{0:N2}}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ── RIGHT: FINANCIAL SUMMARY SIDEBAR ── -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar header -->
                    <Border Grid.Row="0"
                            Style="{StaticResource SectionHeaderStyle}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#047857" Offset="0"/>
                                <GradientStop Color="#10B981" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="💰  INVOICE DETAILS"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="Customer · Bank · Prepared by"
                                       FontSize="10" Foreground="#CCFFFFFF"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Sidebar scrollable fields -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  IsDeferredScrollingEnabled="False"
                                  PanningMode="None"
                                  behaviors:SmoothScrollBehavior.IsEnabled="True">
                        <StackPanel Margin="16,14,16,14">

                            <!-- CUSTOMER section -->
                            <TextBlock Text="CUSTOMER"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#4338CA"
                                       Margin="0,0,0,8"/>

                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                       Text="CUSTOMER NAME"/>
                            <TextBox Text="{Binding CustomerName,
                                           UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12" Margin="0,0,0,10"/>

                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                       Text="CUSTOMER TRN"/>
                            <TextBox Text="{Binding CustomerTrn,
                                           UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12" Margin="0,0,0,10"/>

                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                       Text="PROJECT NAME"/>
                            <TextBox Text="{Binding ProjectName,
                                           UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12" Margin="0,0,0,10"/>

                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                       Text="CONTACT PERSON"/>
                            <TextBox Text="{Binding ContactPerson,
                                           UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12" Margin="0,0,0,16"/>

                            <!-- BANK section -->
                            <TextBlock Text="BANK DETAILS"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#4338CA"
                                       Margin="0,0,0,8"/>

                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                       Text="IBAN"/>
                            <TextBox Text="{Binding Iban,
                                           UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12" Margin="0,0,0,10"/>

                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                       Text="SWIFT CODE"/>
                            <TextBox Text="{Binding SwiftCode,
                                           UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12" Margin="0,0,0,10"/>

                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                       Text="ACCOUNT NUMBER"/>
                            <TextBox Text="{Binding BankAccountNumber,
                                           UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12" Margin="0,0,0,16"/>

                            <!-- DISCOUNT section -->
                            <TextBlock Text="PRICING"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#4338CA"
                                       Margin="0,0,0,8"/>

                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                       Text="DISCOUNT %"/>
                            <TextBox Text="{Binding DiscountPercent,
                                           UpdateSourceTrigger=PropertyChanged,
                                           StringFormat={}{0:0.##}}"
                                     behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                     FontSize="12" Margin="0,0,0,10"/>

                            <!-- PREPARED BY section -->
                            <TextBlock Text="PREPARED BY"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#4338CA"
                                       Margin="0,0,0,8"/>

                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                       Text="NAME"/>
                            <TextBox Text="{Binding PreparedByName,
                                           UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12" Margin="0,0,0,10"/>

                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                       Text="TITLE"/>
                            <TextBox Text="{Binding PreparedByTitle,
                                           UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12" Margin="0,0,0,10"/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Financial totals (fixed bottom) -->
                    <Border Grid.Row="2"
                            Margin="12,0,12,12"
                            Padding="14,12"
                            CornerRadius="10"
                            Background="{DynamicResource TintIndigoBrush}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Subtotal"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <TextBlock Text="{Binding SubtotalDisplay}"
                                           FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Discount"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <TextBlock Text="{Binding DiscountAmountDisplay}"
                                           FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           Foreground="#B45309"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="After Discount"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <TextBlock Text="{Binding AfterDiscountDisplay}"
                                           FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="VAT (5%)"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <TextBlock Text="{Binding VatDisplay}"
                                           FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            </Grid>
                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="0,8,0,0">
                                <Grid>
                                    <TextBlock Text="GRAND TOTAL"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Text="{Binding GrandTotalDisplay}"
                                               FontSize="16" FontWeight="Bold"
                                               HorizontalAlignment="Right"
                                               Foreground="#047857"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding GrandTotalInWords}"
                                       FontSize="10" FontStyle="Italic"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>