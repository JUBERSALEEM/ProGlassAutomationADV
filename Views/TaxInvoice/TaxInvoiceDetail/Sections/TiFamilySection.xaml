<UserControl x:Class="ProGlassAutomation.Views.TaxInvoice.TaxInvoiceDetail.Sections.TiFamilySection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="TiSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
<!-- ══════════════════════════════════════════════════════════
                 RIGHT: INVOICE FAMILY SIDEBAR (Chat 16 — like DN History)
            ══════════════════════════════════════════════════════════ -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Header -->
                        <RowDefinition Height="*"/>
                        <!-- Family list scrolls -->
                        <RowDefinition Height="Auto"/>
                        <!-- Family totals fixed -->
                    </Grid.RowDefinitions>

                    <!-- Sidebar header -->
                    <Border Grid.Row="0"
                            Style="{StaticResource SectionHeaderStyle}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="11" FontWeight="Bold"
                                           Foreground="White"><Run Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"/><Run Text="  INVOICE FAMILY"/></TextBlock>
                                <TextBlock Text="Click any invoice to load it · Green = editing"
                                           FontSize="10" Foreground="#CCFFFFFF"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    CornerRadius="8" Padding="8,3"
                                    Background="#22FFFFFF"
                                    VerticalAlignment="Center">
                                <TextBlock FontSize="10" FontWeight="Bold" Foreground="White">
                                    <Run Text="{Binding FamilyMemberCount, Mode=OneWay}"/>
                                    <Run Text=" invoice(s)"/>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- FAMILY MEMBERS LIST — scrollable -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  IsDeferredScrollingEnabled="False"
                                  PanningMode="None"
                                  Focusable="True"
                                  FocusVisualStyle="{x:Null}"
                                  behaviors:SmoothScrollBehavior.IsEnabled="True">
                        <ItemsControl ItemsSource="{Binding FamilyMembers}"
                                      Margin="0,8,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource FamilyRowButtonStyle}"
                                            Command="{Binding DataContext.SelectFamilyMemberCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Border Style="{StaticResource FamilyRowContentBorderStyle}">
                                            <StackPanel>
                                                <!-- Row 1: Invoice number + badges -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0"
                                                                Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding InvoiceNumber}"
                                                                   Style="{StaticResource FamilyInvoiceNumberStyle}"/>

                                                        <!-- Editing badge -->
                                                        <Border CornerRadius="4" Padding="6,1"
                                                                Margin="6,0,0,0"
                                                                Background="{DynamicResource SuccessBrush}"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding IsCurrentInvoice,
                                                                    Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock FontSize="9" FontWeight="Bold"
                                                                       Foreground="White"><Run Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets"/><Run Text="  EDITING"/></TextBlock>
                                                        </Border>

                                                        <!-- Attachment count badge -->
                                                        <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1.5" CornerRadius="4" Padding="5,1"
                                                                Margin="5,0,0,0"
                                                                Background="{DynamicResource TintIndigoBrush}"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding HasAttachments,
                                                                    Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock FontSize="9" FontWeight="Bold"
                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}">
                                                                <Run Text="&#xE723;" FontFamily="Segoe MDL2 Assets"/><Run Text=" "/>
                                                                <Run Text="{Binding AttachmentCount, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Status pill -->
                                                    <Border Grid.Column="1"
                                                            CornerRadius="6" Padding="7,2"
                                                            VerticalAlignment="Center">
                                                        <Border.Background>
                                                            <Binding Path="StatusBrushKey"
                                                                     Converter="{StaticResource BrushKeyConverter}"/>
                                                        </Border.Background>
                                                        <TextBlock Text="{Binding StatusLabel}"
                                                                   FontSize="9" FontWeight="Bold"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                    </Border>
                                                </Grid>

                                                <!-- Row 2: Type + date + amount -->
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <Border CornerRadius="4" Padding="5,1"
                                                            VerticalAlignment="Center">
                                                        <Border.Background>
                                                            <Binding Path="InvoiceTypeBrushKey"
                                                                     Converter="{StaticResource BrushKeyConverter}"/>
                                                        </Border.Background>
                                                        <TextBlock Text="{Binding InvoiceTypeLabel}"
                                                                   FontSize="9" FontWeight="Bold"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                    </Border>

                                                    <TextBlock Text="{Binding IssueDateDisplay}"
                                                               FontSize="10"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0,0,0"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                </StackPanel>

                                                <!-- Row 3: Grand total + due -->
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0"
                                                                Orientation="Horizontal">
                                                        <TextBlock Text="Due: "
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                        <TextBlock Text="{Binding DueDateDisplay}"
                                                                   FontSize="10" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOverdue}"
                                                                                     Value="True">
                                                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding GrandTotalDisplay}"
                                                               FontSize="12" FontWeight="Bold"
                                                               Foreground="{DynamicResource SuccessBrush}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- FAMILY TOTALS (fixed at bottom) -->
                    <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1.5" Grid.Row="2"
                            Margin="12,0,12,12"
                            Padding="14,12"
                            CornerRadius="10"
                            Background="{DynamicResource TintIndigoBrush}">
                        <StackPanel>
                            <TextBlock Text="FAMILY TOTALS"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="PI Total"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <TextBlock Text="{Binding FamilyProformaTotalDisplay}"
                                           FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Invoiced"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <TextBlock Text="{Binding FamilyInvoicedTotalDisplay}"
                                           FontSize="11" FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                            </Grid>

                            <Border CornerRadius="{DynamicResource CardCornerRadius}" BorderBrush="{DynamicResource OutlineBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="0,6,0,0">
                                <Grid>
                                    <TextBlock Text="Balance"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Text="{Binding FamilyBalanceTotalDisplay}"
                                               FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource WarningBrush}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
    </Grid>
</UserControl>
