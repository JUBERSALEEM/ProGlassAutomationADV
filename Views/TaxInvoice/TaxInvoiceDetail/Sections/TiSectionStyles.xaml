<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tax Invoice styles use live nine-family semantic resources. -->

<!-- Scoped Overview Dashboard / Indigo Studio palette aliases -->
<!-- Bento Card Styles for Tax Invoice -->
    <Style x:Key="SurfaceDetailStyle" TargetType="Border" BasedOn="{StaticResource ProGlassRewriteInsetStyle}">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="14,12"/>
    </Style>

    <Style x:Key="CompactStatTileStyle" TargetType="Border" BasedOn="{StaticResource ProGlassRewriteInsetStyle}">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <Style x:Key="SpecGroupCardStyle" TargetType="Border" BasedOn="{StaticResource ProGlassRewriteCardStyle}">
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="CornerRadius" Value="18"/>
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="Border" BasedOn="{StaticResource ProGlassRewriteInsetStyle}">
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Background" Value="{DynamicResource ThemeCardHighlightBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="MasterHeroStripStyle" TargetType="Border" BasedOn="{StaticResource ProGlassRewriteCardStyle}">
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="CornerRadius" Value="18"/>
    </Style>

    <!-- Family Navigation & Row Elements -->
    <Style x:Key="FamilyRowButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Margin="12,4,12,4"
                            Background="Transparent"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.95"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FamilyInvoiceNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource Typography.Body}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.Bold}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCurrentInvoice}" Value="True">
                <Setter Property="FontSize" Value="{DynamicResource FontSize.H3}"/>
                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FamilyRowContentBorderStyle" TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}">
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCurrentInvoice}" Value="True">
                <Setter Property="BorderThickness" Value="4,2,2,2"/>
                <Setter Property="Background" Value="{DynamicResource TintGreenBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
