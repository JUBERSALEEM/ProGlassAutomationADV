<!-- TI attachments — document-section card.
     Bindings, AddAttachmentCommand, RemoveAttachmentCommand,
     AttachmentType combo, IsSelectedFamilyCurrent: unchanged. -->
<UserControl x:Class="ProGlassAutomation.Views.TaxInvoice.TaxInvoiceDetail.Sections.TiAttachmentsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="TiSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
            BorderThickness="{DynamicResource CardBorderThickness}"
            CornerRadius="{DynamicResource CardCornerRadius}"
            Background="{DynamicResource SurfacePrimaryBrush}"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource SectionHeaderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedFamilyHeaderText}"
                                   FontSize="{DynamicResource FontSize.Body}"
                                   FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{DynamicResource TaxInvoice.PhotosSignedDocsClickFamilyEntrySwitchView}"
                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource RowOutlinedButton}"
                            Tag="&#xE710;"
                            Content="{DynamicResource TaxInvoice.ADDFILE}"
                            Command="{Binding AddAttachmentCommand}"
                            ToolTip="{DynamicResource TaxInvoice.AttachPDFImageMax10MB}"/>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="{DynamicResource Border.HairlineThickness}"
                    Padding="12,8"
                    Margin="12,12,12,0"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Background="{DynamicResource TintAmberBrush}"
                    SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelectedFamilyCurrent}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontSize="{DynamicResource FontSize.Body}"
                           FontWeight="{DynamicResource Weight.SemiBold}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap">
                    <Run Text="&#xE7B3;" FontFamily="{DynamicResource FontFamily.Icon}"/><Run Text="{DynamicResource TaxInvoice.AttachmentsShownSelectedFamilyMember}"/>
                </TextBlock>
            </Border>

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          IsDeferredScrollingEnabled="False"
                          PanningMode="None"
                          behaviors:SmoothScrollBehavior.IsEnabled="True">
                <StackPanel>
                    <Border Padding="12,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Attachments.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE723;"
                                       FontFamily="{DynamicResource FontFamily.Icon}"
                                       FontSize="24"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <TextBlock Text="{DynamicResource DeliveryNote.NoAttachmentsYet}"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       FontWeight="{DynamicResource Weight.SemiBold}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,2"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource TaxInvoice.AddSignedPIDNPdfsHere}"
                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Attachments}"
                                  Margin="8,4,8,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ModuleListRowStyle}"
                                        Margin="0,0,0,4"
                                        Padding="8,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding TypeIcon}"
                                                   FontSize="{DynamicResource FontSize.H1}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Margin="12,0,8,0">
                                            <TextBlock Text="{Binding FileName}"
                                                       FontSize="{DynamicResource FontSize.Body}"
                                                       FontWeight="{DynamicResource Weight.SemiBold}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock FontSize="{DynamicResource FontSize.BodySmall}"
                                                       Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run Text="{Binding TypeLabel, Mode=OneWay}"/>
                                                <Run Text="  ·  "/>
                                                <Run Text="{Binding FileSizeDisplay, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2"
                                                  SelectedItem="{Binding AttachmentType}"
                                                  FontSize="{DynamicResource FontSize.BodySmall}"
                                                  Height="28"
                                                  Margin="0,0,8,0"
                                                  VerticalContentAlignment="Center"
                                                  Style="{StaticResource ComboBoxStyle}">
                                            <ComboBoxItem Content="{DynamicResource TaxInvoice.Signedpi}"/>
                                            <ComboBoxItem Content="{DynamicResource TaxInvoice.Signeddn}"/>
                                            <ComboBoxItem Content="{DynamicResource TaxInvoice.Other}"/>
                                        </ComboBox>
                                        <Button Grid.Column="3"
                                                Style="{StaticResource RowDangerButton}"
                                                Tag="&#xE74D;"
                                                MinWidth="40"
                                                ToolTip="{DynamicResource TaxInvoice.RemoveAttachment}"
                                                Command="{Binding DataContext.RemoveAttachmentCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
