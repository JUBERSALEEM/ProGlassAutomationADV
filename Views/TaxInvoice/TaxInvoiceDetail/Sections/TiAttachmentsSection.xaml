<UserControl x:Class="ProGlassAutomation.Views.TaxInvoice.TaxInvoiceDetail.Sections.TiAttachmentsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="TiSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
<!-- ── ATTACHMENTS CARD (right) — auto-switches per family entry ── -->
            <Border Grid.Column="2"
                    Style="{StaticResource CardStyle}"
                    >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource SectionHeaderStyle}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <!-- Chat 16: SelectedFamilyHeaderText updates when family entry clicked -->
                                <TextBlock Text="{Binding SelectedFamilyHeaderText}"
                                           FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{DynamicResource TaxInvoice.PhotosSignedDocsClickFamilyEntrySwitchView}"
                                           FontSize="{StaticResource TextCaption}" Foreground="{DynamicResource OnAccentForegroundBrush}" Opacity="0.80"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource RowOutlinedButton}"
                                    Tag="&#xE710;" Content="{DynamicResource TaxInvoice.ADDFILE}"
                                    Command="{Binding AddAttachmentCommand}"
                                    ToolTip="{DynamicResource TaxInvoice.AttachPDFImageMax10MB}"/>
                        </Grid>
                    </Border>

                    <!-- Viewing-different-family-member warning -->
                    <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Grid.Row="1"
                            Padding="12,8" Margin="10,10,10,0"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Background="{DynamicResource TintAmberBrush}"
                            SnapsToDevicePixels="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelectedFamilyCurrent}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   TextWrapping="Wrap">
                            <Run Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets"/><Run Text="{DynamicResource TaxInvoice.AttachmentsShownSelectedFamilyMember}"/>
                        </TextBlock>
                    </Border>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  IsDeferredScrollingEnabled="False"
                                  PanningMode="None"
                                  behaviors:SmoothScrollBehavior.IsEnabled="True">
                        <StackPanel>
                            <Border Padding="16,20">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding Attachments.Count}"
                                                Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE723;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock Text="{DynamicResource DeliveryNote.NoAttachmentsYet}"
                                               FontSize="{StaticResource TextBodyLarge}" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,4"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Text="{DynamicResource TaxInvoice.AddSignedPIDNPdfsHere}"
                                               FontSize="{StaticResource TextBody}"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Attachments}"
                                          Margin="10,6,10,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Margin="0,4" Padding="12,10"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Background="{DynamicResource MenuHoverBrush}"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding TypeIcon}"
                                                           FontSize="{StaticResource TextHeadline}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>

                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Margin="10,0,8,0">
                                                    <TextBlock Text="{Binding FileName}"
                                                               FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                    <TextBlock FontSize="{StaticResource TextCaption}" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}">
                                                        <Run Text="{Binding TypeLabel, Mode=OneWay}"/>
                                                        <Run Text="  ·  "/>
                                                        <Run Text="{Binding FileSizeDisplay, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <ComboBox Grid.Column="2"
                                                          SelectedItem="{Binding AttachmentType}"
                                                          FontSize="{StaticResource TextCaption}"
                                                          Height="28"
                                                          Margin="0,0,6,0"
                                                          VerticalContentAlignment="Center">
                                                    <ComboBoxItem Content="{DynamicResource TaxInvoice.Signedpi}"/>
                                                    <ComboBoxItem Content="{DynamicResource TaxInvoice.Signeddn}"/>
                                                    <ComboBoxItem Content="{DynamicResource TaxInvoice.Other}"/>
                                                </ComboBox>

                                                <Button Grid.Column="3"
                                                        Style="{StaticResource RowDangerButton}"
                                                        Tag="&#xE74D;" MinWidth="40"
                                                        ToolTip="{DynamicResource TaxInvoice.RemoveAttachment}"
                                                        Command="{Binding DataContext.RemoveAttachmentCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
    </Grid>
</UserControl>
