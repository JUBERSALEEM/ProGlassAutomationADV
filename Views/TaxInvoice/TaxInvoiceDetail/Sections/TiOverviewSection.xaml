<UserControl x:Class="ProGlassAutomation.Views.TaxInvoice.TaxInvoiceDetail.Sections.TiOverviewSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="TiSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- ── FINANCIAL STATS CARD ──
             LAYOUT FIX: Grid.Row="0" was missing. Both this card and the
             invoice-content card below defaulted to row 0 and rendered
             stacked on top of each other. -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Border Style="{StaticResource SectionHeaderStyle}"
                        Background="{DynamicResource AccentBrush}">
                        <StackPanel>
                            <TextBlock FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"><Run Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets"/><Run Text="  THIS INVOICE — FINANCIAL SUMMARY"/></TextBlock>
                            <TextBlock Text="Live totals — updates as you edit rows"
                                       FontSize="10" Foreground="{DynamicResource OnAccentForegroundBrush}" Opacity="0.8"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="12,12,12,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0"
                                Style="{StaticResource CompactStatTileStyle}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding SubtotalDisplay}"
                                           FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="SUBTOTAL"
                                           FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- LAYOUT FIX: Grid.Column="2" was missing, so the
                             VAT tile rendered on top of the SUBTOTAL tile. -->
                        <Border Grid.Row="0" Grid.Column="2"
                                Style="{StaticResource CompactStatTileStyle}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding VatDisplay}"
                                           FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="VAT (5%)"
                                           FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0"
                                Style="{StaticResource CompactStatTileStyle}"
                                Background="{DynamicResource TintAmberBrush}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding DiscountAmountDisplay}"
                                           FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource WarningBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="DISCOUNT"
                                           FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource WarningBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="2"
                                Style="{StaticResource CompactStatTileStyle}"
                                Background="{DynamicResource TintGreenBrush}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding GrandTotalDisplay}"
                                           FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="GRAND TOTAL"
                                           FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        <!-- ══════════════════════════════════════════════════════════
             INVOICE CONTENT
             Order: Hero → Details form → Spec groups
             LAYOUT FIX: now explicitly row 1 (the star-sized row), so it
             fills the remaining height beneath the stats card.
        ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- HERO STRIP -->
                    <Border Grid.Row="0" CornerRadius="12,12,0,0" Padding="18,14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4338CA" Offset="0"/>
                                <GradientStop Color="#6366F1" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="11" FontWeight="Bold"
                                               Foreground="#CCFFFFFF"
                                               VerticalAlignment="Center"><Run Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets"/><Run Text="  TAX INVOICE  ·  "/></TextBlock>
                                    <TextBlock Text="{Binding CustomerName}"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="White"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="400"/>
                                </StackPanel>
                                <!-- CHAT 20: Show project identifier + contract no in hero strip.
     ProjectIdentifierName is the short name (e.g. "IMAD HABIB").
     ProjectContractNo shown after separator if available. -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding ProjectIdentifierName}"
               FontSize="12" FontWeight="SemiBold"
               Foreground="#EAFFFFFF"
               TextTrimming="CharacterEllipsis"
               MaxWidth="250"/>
                                    <TextBlock Text="  ·  "
               FontSize="12"
               Foreground="#77FFFFFF"
               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ProjectContractNo}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding ProjectContractNo}"
               FontSize="11" FontWeight="SemiBold"
               Foreground="#CCFFFFFF"
               TextTrimming="CharacterEllipsis"
               MaxWidth="250">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ProjectContractNo}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="PI: " FontSize="10" FontWeight="Bold"
                                               Foreground="#CCFFFFFF" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ProformaId}"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="  ·  " FontSize="12"
                                               Foreground="#77FFFFFF" VerticalAlignment="Center"/>
                                    <TextBlock Text="TRN: " FontSize="10" FontWeight="Bold"
                                               Foreground="#CCFFFFFF" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CompanyTrn}"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding GrandTotalDisplay}"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding GrandTotalInWords}"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="#CCFFFFFF"
                                           HorizontalAlignment="Right"
                                           Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="260"/>
                                <TextBlock FontSize="10" Margin="0,6,0,0"
                                           HorizontalAlignment="Right"
                                           Foreground="#CCFFFFFF">
                                    <Run Text="Due: "/>
                                    <Run Text="{Binding DueDate,
                                                StringFormat='dd MMM yyyy',
                                                Mode=OneWay}"
                                         FontWeight="Bold" Foreground="White"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- HEADER FIELDS FORM (compact — includes customer + bank) -->
                    <Border Grid.Row="1"
                            Padding="18,14"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <!-- Row 1: PI ref, DN ref, PO, Status -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="PROFORMA INVOICE REF"/>
                                    <TextBox Text="{Binding ProformaId,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="DELIVERY NOTE REF"/>
                                    <TextBox Text="{Binding DeliveryNoteReference,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="CUSTOMER PO NUMBER"/>
                                    <TextBox Text="{Binding PurchaseOrderNumber,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="STATUS"/>
                                    <ComboBox ItemsSource="{Binding StatusOptions}"
                                              SelectedItem="{Binding Status}"
                                              FontSize="12" Height="38"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: Issue Date, Payment Terms, Bank, TRN -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="ISSUE DATE"/>
                                    <DatePicker SelectedDate="{Binding IssueDate}"
                                                FontSize="12" Height="38"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="PAYMENT TERMS"/>
                                    <ComboBox ItemsSource="{Binding PaymentTermsOptions}"
                                              SelectedItem="{Binding PaymentTerms}"
                                              FontSize="12" Height="38"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="BANK NAME"/>
                                    <TextBox Text="{Binding BankName,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="COMPANY TRN (15 DIGITS)"/>
                                    <TextBox Text="{Binding CompanyTrn,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            <!-- CHAT 20: Row 2.5 — Bank Account Number + Payment Notes -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="BANK ACCOUNT NUMBER"/>
                                    <TextBox Text="{Binding BankAccountNumber,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="PAYMENT NOTES"/>
                                    <TextBox Text="{Binding PaymentNotes,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="COMPANY ADDRESS"/>
                                    <TextBox Text="{Binding CompanyAddress,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="COMPANY LOCATION"/>
                                    <TextBox Text="{Binding CompanyLocation,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 3: Customer, Customer TRN, Contact, Discount -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="CUSTOMER NAME"/>
                                    <TextBox Text="{Binding CustomerName,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="CUSTOMER TRN"/>
                                    <TextBox Text="{Binding CustomerTrn,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="CONTACT PERSON"/>
                                    <TextBox Text="{Binding ContactPerson,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="DISCOUNT %"/>
                                    <TextBox Text="{Binding DiscountPercent,
                                                   UpdateSourceTrigger=PropertyChanged,
                                                   StringFormat={}{0:0.##}}"
                                             behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                             FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 4: IBAN, SWIFT, Prepared By, Prepared Title -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="IBAN"/>
                                    <TextBox Text="{Binding Iban,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="SWIFT CODE"/>
                                    <TextBox Text="{Binding SwiftCode,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="PREPARED BY"/>
                                    <TextBox Text="{Binding PreparedByName,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="PREPARED BY TITLE"/>
                                    <TextBox Text="{Binding PreparedByTitle,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            <!-- CHAT 20: Row 5 — Project fields (aligned with PI Step 3) -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="PROJECT IDENTIFIER NAME"/>
                                    <TextBox Text="{Binding ProjectIdentifierName,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="PROJECT NAME / NO"/>
                                    <TextBox Text="{Binding ProjectContractNo,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="PROJECT REFERENCE"/>
                                    <TextBox Text="{Binding ProjectReference,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="SITE / DELIVERY LOCATION"/>
                                    <TextBox Text="{Binding SiteDeliveryLocation,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- SPEC GROUPS + GLASS ITEM ROWS (internal scroll) -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  CanContentScroll="False"
                                  IsDeferredScrollingEnabled="False"
                                  PanningMode="None"
                                  behaviors:SmoothScrollBehavior.IsEnabled="True">
                        <StackPanel Margin="14,12,14,14">

                            <Grid Margin="4,0,4,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"><Run Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets"/><Run Text="  GLASS ITEMS"/></TextBlock>
                                    <TextBlock Text="Add spec groups then enter glass rows with dimensions, qty and rate."
                                               FontSize="10" Margin="0,2,0,0"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource RowOutlinedButton}"
                                        Tag="&#xE710;" Content="ADD SPEC GROUP"
                                        Command="{Binding AddSpecGroupCommand}"
                                        ToolTip="Add a specification group"
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <Border Padding="32,40">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding SpecGroups.Count}"
                                                Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                                               HorizontalAlignment="Center"
                                               Opacity="0.3"/>
                                    <TextBlock Text="No glass items yet"
                                               FontSize="16" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,12,0,4"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Text="Click '+ Add Spec Group' to start building the invoice."
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding SpecGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SpecGroupCardStyle}">
                                            <StackPanel>

                                                <Border CornerRadius="12,12,0,0" Padding="14,10">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#4338CA" Offset="0"/>
                                                            <GradientStop Color="#6366F1" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0"
                                                                Width="4" CornerRadius="2"
                                                                Background="White"
                                                                Margin="0,0,10,0"/>

                                                        <StackPanel Grid.Column="1"
                                                                    Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="SPEC: "
                                                                       FontSize="11" FontWeight="Bold"
                                                                       Foreground="#CCFFFFFF"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBox Text="{Binding GroupName,
                                                                           UpdateSourceTrigger=PropertyChanged}"
                                                                     FontSize="13" FontWeight="Bold"
                                                                     Background="Transparent"
                                                                     Foreground="White"
                                                                     BorderThickness="0"
                                                                     Padding="4,2"
                                                                     MinWidth="200"
                                                                     VerticalContentAlignment="Center"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2"
                                                                    Orientation="Horizontal"
                                                                    VerticalAlignment="Center"
                                                                    Margin="16,0,0,0">
                                                            <TextBlock Text="Rate/SQM: "
                                                                       FontSize="10" FontWeight="Bold"
                                                                       Foreground="#CCFFFFFF"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBox Text="{Binding BaseRate,
                                                                           UpdateSourceTrigger=PropertyChanged,
                                                                           StringFormat={}{0:0.00}}"
                                                                     behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                                                     FontSize="12" FontWeight="Bold"
                                                                     Background="Transparent"
                                                                     Foreground="White"
                                                                     BorderThickness="0"
                                                                     Padding="4,2"
                                                                     Width="80"
                                                                     TextAlignment="Right"
                                                                     VerticalContentAlignment="Center"/>
                                                            <TextBlock Text=" AED"
                                                                       FontSize="10" FontWeight="Bold"
                                                                       Foreground="#CCFFFFFF"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="3"
                                                                    Orientation="Horizontal"
                                                                    VerticalAlignment="Center"
                                                                    Margin="16,0,0,0">
                                                            <TextBlock Text="Total: "
                                                                       FontSize="10"
                                                                       Foreground="#CCFFFFFF"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock FontSize="12" FontWeight="Bold"
                                                                       Foreground="White"
                                                                       VerticalAlignment="Center">
                                                                <Run Text="AED "/>
                                                                <Run Text="{Binding GroupTotalValue,
                                                                            Mode=OneWay,
                                                                            StringFormat={}{0:N2}}"/>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <Button Grid.Column="4"
                                                                Style="{StaticResource RowOutlinedButton}"
                                                                Tag="&#xE710;" Content="ROW"
                                                                Command="{Binding AddRowCommand}"
                                                                ToolTip="Add a row"
                                                                Margin="12,0,6,0"/>

                                                        <Button Grid.Column="5"
                                                                Style="{StaticResource RowDangerButton}"
                                                                Tag="&#xE74D;" Content="GROUP"
                                                                ToolTip="Remove this group"
                                                                Command="{Binding DataContext.RemoveSpecGroupCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                FontSize="10" FontWeight="Bold"
                                                                Padding="10,4" Cursor="Hand"
                                                                Background="#33FF0000"
                                                                Foreground="White"
                                                                BorderThickness="0"/>
                                                    </Grid>
                                                </Border>

                                                <Border Background="{DynamicResource MenuHoverBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40"/>
                                                            <ColumnDefinition Width="*" MinWidth="160"/>
                                                            <ColumnDefinition Width="65"/>
                                                            <ColumnDefinition Width="65"/>
                                                            <ColumnDefinition Width="55"/>
                                                            <ColumnDefinition Width="55"/>
                                                            <ColumnDefinition Width="55"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="72"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="82"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="85"/>
                                                            <ColumnDefinition Width="40"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="#"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="GLASS REF"
                                                                   Style="{StaticResource GridHeaderCell}"/>
                                                        <TextBlock Grid.Column="2" Text="W1"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <TextBlock Grid.Column="3" Text="H1"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <TextBlock Grid.Column="4" Text="W2"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <TextBlock Grid.Column="5" Text="H2"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <TextBlock Grid.Column="6" Text="QTY"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <Border Grid.Column="7"
                                                                Style="{StaticResource ColumnSeparatorStyle}"/>
                                                        <TextBlock Grid.Column="8" Text="SQM"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <Border Grid.Column="9"
                                                                Style="{StaticResource ColumnSeparatorStyle}"/>
                                                        <TextBlock Grid.Column="10" Text="T.SQM"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <Border Grid.Column="11"
                                                                Style="{StaticResource ColumnSeparatorStyle}"/>
                                                        <TextBlock Grid.Column="12" Text="RATE · VALUE"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   Margin="6,8,10,8"/>
                                                        <TextBlock Grid.Column="13" Text=""
                                                                   Style="{StaticResource GridHeaderCell}"/>
                                                    </Grid>
                                                </Border>

                                                <ItemsControl ItemsSource="{Binding Rows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="0,0,0,1"
                                                                    Padding="0,2">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="40"/>
                                                                        <ColumnDefinition Width="*" MinWidth="160"/>
                                                                        <ColumnDefinition Width="65"/>
                                                                        <ColumnDefinition Width="65"/>
                                                                        <ColumnDefinition Width="55"/>
                                                                        <ColumnDefinition Width="55"/>
                                                                        <ColumnDefinition Width="55"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="72"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="82"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="85"/>
                                                                        <ColumnDefinition Width="40"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding SerialNumber}"
                                                                               Style="{StaticResource GridDataCell}"
                                                                               HorizontalAlignment="Center"/>

                                                                    <TextBox Grid.Column="1"
                                                                             Text="{Binding GlassRef,
                                                                                   UpdateSourceTrigger=PropertyChanged}"
                                                                             FontSize="12"
                                                                             Padding="6,4"
                                                                             Margin="4,3"
                                                                             VerticalContentAlignment="Center"/>

                                                                    <TextBox Grid.Column="2"
                                                                             Text="{Binding W1,
                                                                                   UpdateSourceTrigger=PropertyChanged}"
                                                                             behaviors:TextBoxBehaviors.AcceptIntegersOnly="True"
                                                                             FontSize="12" FontWeight="SemiBold"
                                                                             TextAlignment="Right"
                                                                             Padding="4,4,8,4" Margin="2,3"
                                                                             VerticalContentAlignment="Center"/>

                                                                    <TextBox Grid.Column="3"
                                                                             Text="{Binding H1,
                                                                                   UpdateSourceTrigger=PropertyChanged}"
                                                                             behaviors:TextBoxBehaviors.AcceptIntegersOnly="True"
                                                                             FontSize="12" FontWeight="SemiBold"
                                                                             TextAlignment="Right"
                                                                             Padding="4,4,8,4" Margin="2,3"
                                                                             VerticalContentAlignment="Center"/>

                                                                    <TextBox Grid.Column="4"
                                                                             Text="{Binding W2,
                                                                                   UpdateSourceTrigger=PropertyChanged}"
                                                                             behaviors:TextBoxBehaviors.AcceptIntegersOnly="True"
                                                                             FontSize="11"
                                                                             TextAlignment="Right"
                                                                             Padding="4,4,8,4" Margin="2,3"
                                                                             Opacity="0.7"
                                                                             VerticalContentAlignment="Center"/>

                                                                    <TextBox Grid.Column="5"
                                                                             Text="{Binding H2,
                                                                                   UpdateSourceTrigger=PropertyChanged}"
                                                                             behaviors:TextBoxBehaviors.AcceptIntegersOnly="True"
                                                                             FontSize="11"
                                                                             TextAlignment="Right"
                                                                             Padding="4,4,8,4" Margin="2,3"
                                                                             Opacity="0.7"
                                                                             VerticalContentAlignment="Center"/>

                                                                    <TextBox Grid.Column="6"
                                                                             Text="{Binding Qty,
                                                                                   UpdateSourceTrigger=PropertyChanged}"
                                                                             behaviors:TextBoxBehaviors.AcceptIntegersOnly="True"
                                                                             FontSize="12" FontWeight="Bold"
                                                                             TextAlignment="Right"
                                                                             Padding="4,4,8,4" Margin="2,3"
                                                                             BorderBrush="#4338CA"
                                                                             Background="{DynamicResource TintIndigoBrush}"
                                                                             Foreground="#3730A3"
                                                                             VerticalContentAlignment="Center"/>

                                                                    <Border Grid.Column="7"
                                                                            Style="{StaticResource ColumnSeparatorStyle}"/>

                                                                    <TextBlock Grid.Column="8"
                                                                               Text="{Binding Sqm,
                                                                                      StringFormat={}{0:0.000}}"
                                                                               Style="{StaticResource GridNumericCell}"
                                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                                                                    <Border Grid.Column="9"
                                                                            Style="{StaticResource ColumnSeparatorStyle}"/>

                                                                    <TextBlock Grid.Column="10"
                                                                               Text="{Binding TotalSqm,
                                                                                      StringFormat={}{0:0.000}}"
                                                                               Style="{StaticResource GridNumericCell}"
                                                                               FontWeight="Bold"/>

                                                                    <Border Grid.Column="11"
                                                                            Style="{StaticResource ColumnSeparatorStyle}"/>

                                                                    <StackPanel Grid.Column="12"
                                                                                VerticalAlignment="Center"
                                                                                Margin="4,2">
                                                                        <TextBox Text="{Binding Rate,
                                                                                       UpdateSourceTrigger=PropertyChanged,
                                                                                       StringFormat={}{0:0.00}}"
                                                                                 behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                                                                 FontSize="11" FontWeight="Bold"
                                                                                 TextAlignment="Right"
                                                                                 Padding="4,2,6,2"
                                                                                 BorderBrush="{DynamicResource SuccessBrush}"
                                                                                 Background="{DynamicResource TintGreenBrush}"
                                                                                 Foreground="#065F46"
                                                                                 VerticalContentAlignment="Center"/>
                                                                        <TextBlock Text="{Binding Value,
                                                                                          StringFormat=AED {0:N2}}"
                                                                                   FontSize="11" FontWeight="Bold"
                                                                                   HorizontalAlignment="Right"
                                                                                   Margin="0,2,4,0"
                                                                                   Foreground="{DynamicResource SuccessBrush}"/>
                                                                    </StackPanel>

                                                                    <Button Grid.Column="13"
                                                                            Style="{StaticResource RowDangerButton}"
                                                                            Tag="&#xE74D;" MinWidth="40"
                                                                            ToolTip="Remove row"
                                                                            Command="{Binding DataContext.RemoveRowCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            FontSize="11" FontWeight="Bold"
                                                                            Padding="6,4" Cursor="Hand"
                                                                            Background="#B91C1C"
                                                                            Foreground="White"
                                                                            BorderThickness="0"
                                                                            Margin="4,3"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Border Background="{DynamicResource TintIndigoBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="0,1,0,0"
                                                        Padding="16,10"
                                                        CornerRadius="0,0,12,12">
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Right">
                                                        <TextBlock Text="GROUP TOTAL: "
                                                                   FontSize="11" FontWeight="Bold"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock FontSize="11"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="8,0,16,0">
                                                            <Run Text="{Binding GroupTotalQty, Mode=OneWay}"
                                                                 FontWeight="Bold"/>
                                                            <Run Text=" pcs  ·  "/>
                                                            <Run Text="{Binding GroupTotalSqm, Mode=OneWay,
                                                                        StringFormat={}{0:0.000}}"
                                                                 FontWeight="Bold"/>
                                                            <Run Text=" SQM"/>
                                                        </TextBlock>
                                                        <TextBlock FontSize="13" FontWeight="Bold"
                                                                   Foreground="{DynamicResource SuccessBrush}"
                                                                   VerticalAlignment="Center">
                                                            <Run Text="AED "/>
                                                            <Run Text="{Binding GroupTotalValue, Mode=OneWay,
                                                                        StringFormat={}{0:N2}}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
    </Grid>
</UserControl>
