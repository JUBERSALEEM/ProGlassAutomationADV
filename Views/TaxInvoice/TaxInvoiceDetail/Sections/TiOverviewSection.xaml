<!-- LAYOUT — standard UAE tax invoice. Header fields auto from PI.
     Line grid matches PI Step 5: separate RATE and VALUE, centred SQM. -->
<UserControl x:Class="ProGlassAutomation.Views.TaxInvoice.TaxInvoiceDetail.Sections.TiOverviewSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="TiSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly"
                  Focusable="True"
                  FocusVisualStyle="{x:Null}"
                  behaviors:SmoothScrollBehavior.IsEnabled="True">
        <StackPanel>

        <!-- ══ INVOICE DOCUMENT ══════════════════════════════════════ -->
        <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,10">
            <StackPanel>
                <!-- Title + totals -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="TAX INVOICE"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{Binding CustomerName}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,4,16,0"/>
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding ProjectIdentifierName, Mode=OneWay}"/>
                            <Run Text="  ·  "/>
                            <Run Text="{Binding ProjectContractNo, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding GrandTotalDisplay}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding GrandTotalInWords}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   HorizontalAlignment="Right"
                                   MaxWidth="280"
                                   TextWrapping="Wrap"
                                   TextAlignment="Right"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Only the fields a clerk actually sets -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="ISSUE DATE"/>
                        <DatePicker SelectedDate="{Binding IssueDate}"
                                    FontSize="12" Height="{DynamicResource DensityInputHeight}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="DUE DATE"/>
                        <DatePicker SelectedDate="{Binding DueDate}"
                                    FontSize="12" Height="{DynamicResource DensityInputHeight}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="PAYMENT TERMS"/>
                        <ComboBox ItemsSource="{Binding PaymentTermsOptions}"
                                  SelectedItem="{Binding PaymentTerms}"
                                  FontSize="12" Height="{DynamicResource DensityInputHeight}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="DISCOUNT %"/>
                        <TextBox Text="{Binding DiscountPercent,
                                       UpdateSourceTrigger=PropertyChanged,
                                       StringFormat={}{0:0.##}}"
                                 behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                 FontSize="12"/>
                    </StackPanel>
                </Grid>

                <!-- Bill from / Bill to — FTA required identities -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CompactStatTileStyle}"
                            MinHeight="0" Padding="14,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource InvoicePartyLabelStyle}"
                                       Text="FROM  ·  SUPPLIER"/>
                            <TextBlock Text="{Binding CompanyName}"
                                       Style="{StaticResource InvoicePartyValueStyle}"/>
                            <TextBlock Margin="0,6,0,0" FontSize="12"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}">
                                <Run Text="TRN  " FontWeight="Bold"/>
                                <Run Text="{Binding CompanyTrn, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding CompanyLocation}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CompactStatTileStyle}"
                            MinHeight="0" Padding="14,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource InvoicePartyLabelStyle}"
                                       Text="BILL TO  ·  CUSTOMER"/>
                            <TextBlock Text="{Binding CustomerName}"
                                       Style="{StaticResource InvoicePartyValueStyle}"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TRN" FontSize="11" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding CustomerTrn, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12"
                                         ToolTip="Required on a full UAE tax invoice when the buyer is VAT-registered"/>
                            </Grid>
                            <TextBlock Text="{Binding CustomerAddress}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding ContactPerson}"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Refs — auto from PI / DN, not a wall of inputs -->
                <WrapPanel Margin="0,0,0,4">
                    <Border Style="{StaticResource InvoiceMetaChipStyle}">
                        <TextBlock FontSize="11">
                            <Run Text="PI  " FontWeight="Bold"
                                 Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <Run Text="{Binding ProformaId, Mode=OneWay}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource InvoiceMetaChipStyle}">
                        <TextBlock FontSize="11">
                            <Run Text="DN  " FontWeight="Bold"
                                 Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <Run Text="{Binding DeliveryNoteReference, Mode=OneWay}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource InvoiceMetaChipStyle}">
                        <TextBlock FontSize="11">
                            <Run Text="JO  " FontWeight="Bold"
                                 Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <Run Text="{Binding JobOrderId, Mode=OneWay}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource InvoiceMetaChipStyle}">
                        <TextBlock FontSize="11">
                            <Run Text="PO  " FontWeight="Bold"
                                 Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <Run Text="{Binding PurchaseOrderNumber, Mode=OneWay}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource InvoiceMetaChipStyle}">
                        <TextBlock FontSize="11">
                            <Run Text="SITE  " FontWeight="Bold"
                                 Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <Run Text="{Binding SiteDeliveryLocation, Mode=OneWay}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </TextBlock>
                    </Border>
                </WrapPanel>

                <!-- Payment — printed on PDF. Bank/account come from PI. -->
                <Border Background="{DynamicResource TintGrayBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10"
                        Margin="0,4,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="BANK"/>
                            <TextBlock Text="{Binding BankName}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="ACCOUNT NO"/>
                            <TextBlock Text="{Binding BankAccountNumber}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="IBAN"/>
                            <TextBox Text="{Binding Iban, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="SWIFT"/>
                            <TextBox Text="{Binding SwiftCode, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Financial strip -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CompactStatTileStyle}" MinHeight="56" Padding="12,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SubtotalDisplay}" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="SUBTOTAL" FontSize="10" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CompactStatTileStyle}" MinHeight="56" Padding="12,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding VatDisplay}" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="VAT 5%" FontSize="10" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource CompactStatTileStyle}"
                            Background="{DynamicResource TintAmberBrush}" MinHeight="56" Padding="12,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding DiscountAmountDisplay}" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource WarningBrush}"/>
                            <TextBlock Text="DISCOUNT" FontSize="10" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"
                                       Foreground="{DynamicResource WarningBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="6" Style="{StaticResource CompactStatTileStyle}"
                            Background="{DynamicResource TintGreenBrush}" MinHeight="56" Padding="12,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding GrandTotalDisplay}" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                            <TextBlock Text="GRAND TOTAL" FontSize="10" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ══ LINE ITEMS — PI Step 5 columns ════════════════════════ -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
            <StackPanel Margin="12,10,12,10">

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}">
                            <Run Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets"/>
                            <Run Text="  GLASS ITEMS"/>
                        </TextBlock>
                        <TextBlock Text="Qty and rate from the delivery. SQM and value follow the PI grid."
                                   FontSize="10" Margin="0,2,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource RowOutlinedButton}"
                            Tag="&#xE710;" Content="ADD SPEC GROUP"
                            Command="{Binding AddSpecGroupCommand}"
                            VerticalAlignment="Center"/>
                </Grid>

                <Border Padding="32,40">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SpecGroups.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                                   HorizontalAlignment="Center" Opacity="0.3"/>
                        <TextBlock Text="No glass items yet"
                                   FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,10,0,4"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="Items import from the Proforma when you create the invoice from a DN."
                                   FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding SpecGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SpecGroupCardStyle}">
                                    <StackPanel>
                                        <Border Background="{DynamicResource MenuHoverBrush}"
                                                BorderBrush="{DynamicResource DividerBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="22" Height="22"
                                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                                        Background="{DynamicResource AccentBrush}"
                                                        Margin="0,0,10,0">
                                                    <TextBlock Text="&#xE8A5;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="13" FontWeight="Bold"
                                                         Background="Transparent"
                                                         Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                         BorderThickness="0"
                                                         Padding="4,2"
                                                         MinWidth="160"
                                                         VerticalContentAlignment="Center"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <TextBlock Text="Rate/SQM  "
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBox Text="{Binding BaseRate,
                                                                   UpdateSourceTrigger=PropertyChanged,
                                                                   StringFormat={}{0:0.00}}"
                                                             behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                                             Style="{StaticResource LineItemsDecimalCellStyle}"
                                                             Width="72"/>
                                                </StackPanel>
                                                <Button Grid.Column="3"
                                                        Style="{StaticResource RowOutlinedButton}"
                                                        Tag="&#xE710;" Content="ROW"
                                                        Command="{Binding AddRowCommand}"
                                                        Margin="12,0,6,0"/>
                                                <Button Grid.Column="4"
                                                        Style="{StaticResource RowDangerButton}"
                                                        Tag="&#xE74D;" Content="GROUP"
                                                        Command="{Binding DataContext.RemoveSpecGroupCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        FontSize="10" FontWeight="Bold"
                                                        Padding="10,4"/>
                                            </Grid>
                                        </Border>

                                        <Border Background="{DynamicResource MenuHoverBrush}"
                                                BorderBrush="{DynamicResource OutlineBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="4,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="0.75*"/>
                                                    <ColumnDefinition Width="0.75*"/>
                                                    <ColumnDefinition Width="0.75*"/>
                                                    <ColumnDefinition Width="0.75*"/>
                                                    <ColumnDefinition Width="0.65*"/>
                                                    <ColumnDefinition Width="0.85*"/>
                                                    <ColumnDefinition Width="0.85*"/>
                                                    <ColumnDefinition Width="0.85*"/>
                                                    <ColumnDefinition Width="1.15*"/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="#"
                                                           Style="{StaticResource GridHeaderCell}"
                                                           HorizontalAlignment="Center" TextAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="GLASS REF"
                                                           Style="{StaticResource GridHeaderCell}"/>
                                                <TextBlock Grid.Column="2" Text="W1"
                                                           Style="{StaticResource GridHeaderCell}"
                                                           HorizontalAlignment="Center" TextAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="H1"
                                                           Style="{StaticResource GridHeaderCell}"
                                                           HorizontalAlignment="Center" TextAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="W2"
                                                           Style="{StaticResource GridHeaderCell}"
                                                           HorizontalAlignment="Center" TextAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="H2"
                                                           Style="{StaticResource GridHeaderCell}"
                                                           HorizontalAlignment="Center" TextAlignment="Center"/>
                                                <TextBlock Grid.Column="6" Text="QTY"
                                                           Style="{StaticResource GridHeaderCell}"
                                                           HorizontalAlignment="Center" TextAlignment="Center"/>
                                                <TextBlock Grid.Column="7" Text="SQM"
                                                           Style="{StaticResource GridHeaderCell}"
                                                           HorizontalAlignment="Center" TextAlignment="Center"/>
                                                <TextBlock Grid.Column="8" Text="T.SQM"
                                                           Style="{StaticResource GridHeaderCell}"
                                                           HorizontalAlignment="Center" TextAlignment="Center"/>
                                                <TextBlock Grid.Column="9" Text="RATE"
                                                           Style="{StaticResource GridHeaderCell}"
                                                           HorizontalAlignment="Center" TextAlignment="Center"/>
                                                <TextBlock Grid.Column="10" Text="VALUE"
                                                           Style="{StaticResource GridHeaderCell}"
                                                           HorizontalAlignment="Right" TextAlignment="Right"/>
                                            </Grid>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource OutlineBrush}"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="4,3">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28"/>
                                                                <ColumnDefinition Width="1.2*"/>
                                                                <ColumnDefinition Width="0.75*"/>
                                                                <ColumnDefinition Width="0.75*"/>
                                                                <ColumnDefinition Width="0.75*"/>
                                                                <ColumnDefinition Width="0.75*"/>
                                                                <ColumnDefinition Width="0.65*"/>
                                                                <ColumnDefinition Width="0.85*"/>
                                                                <ColumnDefinition Width="0.85*"/>
                                                                <ColumnDefinition Width="0.85*"/>
                                                                <ColumnDefinition Width="1.15*"/>
                                                                <ColumnDefinition Width="32"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding SerialNumber}"
                                                                       Style="{StaticResource GridDataCell}"
                                                                       HorizontalAlignment="Center"
                                                                       TextAlignment="Center"/>
                                                            <TextBox Grid.Column="1"
                                                                     Text="{Binding GlassRef, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource LineItemsTextCellStyle}"
                                                                     Margin="2,2"/>
                                                            <TextBox Grid.Column="2"
                                                                     Text="{Binding W1, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource LineItemsIntCellStyle}"
                                                                     Margin="2,2"/>
                                                            <TextBox Grid.Column="3"
                                                                     Text="{Binding H1, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource LineItemsIntCellStyle}"
                                                                     Margin="2,2"/>
                                                            <TextBox Grid.Column="4"
                                                                     Text="{Binding W2, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource LineItemsIntCellStyle}"
                                                                     Opacity="0.7" Margin="2,2"/>
                                                            <TextBox Grid.Column="5"
                                                                     Text="{Binding H2, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource LineItemsIntCellStyle}"
                                                                     Opacity="0.7" Margin="2,2"/>
                                                            <TextBox Grid.Column="6"
                                                                     Text="{Binding Qty, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource LineItemsIntCellStyle}"
                                                                     Margin="2,2"/>
                                                            <TextBlock Grid.Column="7"
                                                                       Text="{Binding Sqm, StringFormat={}{0:0.000}}"
                                                                       Style="{StaticResource GridNumericCenterCell}"
                                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                            <TextBlock Grid.Column="8"
                                                                       Text="{Binding TotalSqm, StringFormat={}{0:0.000}}"
                                                                       Style="{StaticResource GridNumericCenterCell}"
                                                                       FontWeight="Bold"/>
                                                            <TextBox Grid.Column="9"
                                                                     Text="{Binding Rate,
                                                                           UpdateSourceTrigger=PropertyChanged,
                                                                           StringFormat={}{0:0.00}}"
                                                                     Style="{StaticResource LineItemsDecimalCellStyle}"
                                                                     Margin="2,2"/>
                                                            <TextBlock Grid.Column="10"
                                                                       Text="{Binding Value, StringFormat=AED {0:N2}}"
                                                                       Style="{StaticResource GridNumericCell}"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource SuccessBrush}"/>
                                                            <Button Grid.Column="11"
                                                                    Style="{StaticResource RowDangerButton}"
                                                                    Tag="&#xE74D;" MinWidth="28"
                                                                    ToolTip="Remove row"
                                                                    Command="{Binding DataContext.RemoveRowCommand,
                                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="4,3" Margin="2,2"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Background="{DynamicResource TintIndigoBrush}"
                                                BorderBrush="{DynamicResource OutlineBrush}"
                                                BorderThickness="0,1,0,0"
                                                Padding="12,8"
                                                CornerRadius="0,0,12,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="0.75*"/>
                                                    <ColumnDefinition Width="0.75*"/>
                                                    <ColumnDefinition Width="0.75*"/>
                                                    <ColumnDefinition Width="0.75*"/>
                                                    <ColumnDefinition Width="0.65*"/>
                                                    <ColumnDefinition Width="0.85*"/>
                                                    <ColumnDefinition Width="0.85*"/>
                                                    <ColumnDefinition Width="0.85*"/>
                                                    <ColumnDefinition Width="1.15*"/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="GROUP TOTAL"
                                                           FontSize="11" FontWeight="Bold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Grid.Column="6"
                                                           Text="{Binding GroupTotalQty, Mode=OneWay, StringFormat={}{0} pcs}"
                                                           Style="{StaticResource GridNumericCenterCell}"
                                                           FontWeight="Bold"/>
                                                <TextBlock Grid.Column="8"
                                                           Text="{Binding GroupTotalSqm, Mode=OneWay, StringFormat={}{0:0.000}}"
                                                           Style="{StaticResource GridNumericCenterCell}"
                                                           FontWeight="Bold"/>
                                                <TextBlock Grid.Column="10"
                                                           FontSize="12" FontWeight="Bold"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource SuccessBrush}">
                                                    <Run Text="AED "/>
                                                    <Run Text="{Binding GroupTotalValue, Mode=OneWay, StringFormat={}{0:N2}}"/>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
