<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Shared/UnsavedChangesDialog.xaml
     PROJECT: ProGlassAutomation
     MODULE: Shared — unsaved changes confirmation (§28)
═══════════════════════════════════════════════════════════════════════ -->

<Window x:Class="ProGlassAutomation.Views.Shared.UnsavedChangesDialog"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unsaved Changes"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource ModuleBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                           FontSize="{StaticResource TextHeadline}" Foreground="{DynamicResource WarningBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="Unsaved Changes"
                               FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock x:Name="MessageText"
                               FontSize="{StaticResource TextBody}" Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Cursor="Hand" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                    Padding="18,9" Margin="0,0,10,0"
                    IsCancel="True"
                    BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource MenuHoverBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="{DynamicResource CardBorderThickness}"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="DiscardButton"
                    Content="Discard"
                    Cursor="Hand" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                    Padding="18,9" Margin="0,0,10,0"
                    BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Background="{DynamicResource TintRedBrush}"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="SaveButton"
                    Content="Save &amp; Continue"
                    Cursor="Hand" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                    Padding="18,9"
                    IsDefault="True"
                    BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource AccentBrush}"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
