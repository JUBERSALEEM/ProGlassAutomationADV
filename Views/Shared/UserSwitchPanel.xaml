<UserControl x:Class="ProGlassAutomation.Views.Shared.UserSwitchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
            Background="{DynamicResource ShellGlassBrush}"
            BorderBrush="{DynamicResource ShellGlassBorderBrush}"
            BorderThickness="1"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="3"
                              Opacity="0.18" Color="#000000" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Header ───────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{DynamicResource AccentBrush}"

                    Padding="18,12">
                <StackPanel>
                    <TextBlock Text="Switch User"
                               FontSize="14" FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="Pick a user and enter their password to continue as them"
                               FontSize="10" Foreground="White"
                               Opacity="0.85" Margin="0,2,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ── User list + password ─────────────────────────────── -->
            <Grid Grid.Row="1" Margin="16,14,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              MaxHeight="260"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="UserList"/>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <TextBlock x:Name="PasswordLabel"
                               Text="Password for the selected user"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    <PasswordBox x:Name="PasswordBox"
                                 Height="34"
                                 Margin="0,6,0,0"
                                 Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="12"
                                 Background="{DynamicResource ModuleBackgroundBrush}"
                                 Foreground="{DynamicResource PrimaryForegroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1"
                                 KeyDown="PasswordBox_KeyDown"/>
                    <TextBlock x:Name="ErrorText"
                               FontSize="10"
                               Foreground="{DynamicResource DangerBrush}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Grid>

            <!-- ── Footer ───────────────────────────────────────────── -->
            <Border Grid.Row="2"
                    Margin="0,14,0,0"
                    Padding="16,12"

                    Background="{DynamicResource MenuHoverBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Double-click anywhere to close."
                               FontSize="10"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <Button x:Name="SwitchButton"
                            Grid.Column="1"
                            Style="{StaticResource PrimaryPillButton}"
                            Content="SWITCH"
                            MinWidth="110"
                            IsEnabled="False"
                            Click="OnSwitchClick"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
