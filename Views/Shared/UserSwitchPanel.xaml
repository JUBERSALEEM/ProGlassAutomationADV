<UserControl x:Class="ProGlassAutomation.Views.Shared.UserSwitchPanel"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Margin="10,8,10,16">
    <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="3"
                              Opacity="0.18" Color="{DynamicResource LiquidShadowColor}" Direction="270"/>
        </Border.Effect>
        <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                Background="{DynamicResource ShellLiquidBrush}"
                BorderBrush="{DynamicResource ShellLiquidBorderBrush}"
                BorderThickness="{DynamicResource Border.HairlineThickness}"
                ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Header ───────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{DynamicResource AccentBrush}"
                    CornerRadius="{DynamicResource Radius.Top.Medium}"
                    Padding="18,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Login.SwitchUser}"
                               FontSize="{StaticResource TextSection}" FontWeight="Bold"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                    <TextBlock Text="{DynamicResource Shared.PickUserEnterPasswordContinue}"
                               FontSize="{StaticResource TextCaption}" Foreground="{DynamicResource OnAccentForegroundBrush}"
                               Opacity="0.85" Margin="0,2,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ── User list + password ─────────────────────────────── -->
            <Grid Grid.Row="1" Margin="16,14,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              MaxHeight="260"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="UserList"/>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <TextBlock x:Name="PasswordLabel"
                               Text="{DynamicResource Shared.PasswordSelectedUser}"
                               FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    <PasswordBox x:Name="PasswordBox"
                                 Height="34"
                                 Margin="0,6,0,0"
                                 Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="{StaticResource TextBody}"
                                 Background="{DynamicResource SurfacePrimaryBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="{DynamicResource Border.HairlineThickness}"
                                 KeyDown="PasswordBox_KeyDown"/>
                    <TextBlock x:Name="ErrorText"
                               FontSize="{StaticResource TextCaption}"
                               Foreground="{DynamicResource DangerBrush}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Grid>

            <!-- ── Footer ───────────────────────────────────────────── -->
            <Border Grid.Row="2"
                    Margin="0,14,0,0"
                    Padding="16,12"
                    CornerRadius="{DynamicResource Radius.Bottom.Medium}"
                    Background="{DynamicResource SurfaceTertiaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="{DynamicResource Border.TopHairlineThickness}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource Shared.DoubleClickAnywhereClose}"
                               FontSize="{StaticResource TextCaption}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <Button x:Name="SwitchButton"
                            Grid.Column="1"
                            Style="{StaticResource PrimaryPillButton}"
                            Content="{DynamicResource Shared.Switch}"
                            MinWidth="110"
                            IsEnabled="False"
                            Click="OnSwitchClick"/>
                </Grid>
            </Border>
        </Grid>
        </Border>
    </Border>
    </Grid>
</UserControl>
