<!--
    FILE: Views/Shared/LanguageSuggestionDialog.xaml
    PROJECT: ProGlassAutomation
    CREATED: 2026-09-02

    First-launch language offer. English is the default everywhere; when
    the detected country has a different primary language this asks ONCE
    whether to switch.

    Deliberately bilingual and NOT localized: the whole point is that the
    user may not read the current UI language, so the offer shows the
    target language in its NATIVE script next to English. Binding these
    to {DynamicResource} would defeat that.

    Background uses WindowBackgroundBrush, not ModuleBackgroundBrush:
    the latter is a glass brush with alpha 00 and renders a standalone
    Window as a black void (see the Sheet Store dialog fix).
-->
<Window x:Class="ProGlassAutomation.Views.Shared.LanguageSuggestionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Language"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource WindowBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border Padding="28,24"
            Background="{DynamicResource GlassUltraClearBrush}"
            BorderBrush="{DynamicResource GlassBorderGradientCrystal}"
            BorderThickness="{DynamicResource Border.HairlineThickness}"
            CornerRadius="{DynamicResource CardCornerRadiusLarge}"
            Margin="12">
        <StackPanel>

            <TextBlock Text="&#xE774;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="{StaticResource TextDisplay}"
                       Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <TextBlock Text="Choose your language"
                       FontSize="{StaticResource TextSection}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>

            <!-- Native-script line: the reason this dialog is not localized. -->
            <TextBlock x:Name="NativePromptText"
                       FontSize="{StaticResource TextBodyLarge}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,10,0,0"/>

            <TextBlock x:Name="ExplainText"
                       FontSize="{StaticResource TextBody}"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,10,0,0"/>

            <TextBlock Text="You can change this any time in Settings › Appearance."
                       FontSize="{StaticResource TextBody}"
                       Foreground="{DynamicResource MutedForegroundBrush}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,14,0,0"/>

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="KeepEnglishButton"
                        Grid.Column="0"
                        Content="Keep English"
                        Height="38"
                        Cursor="Hand"
                        IsCancel="True"
                        Click="KeepEnglish_Click"
                        Background="{DynamicResource GlassSurfaceElevated}"
                        Foreground="{DynamicResource PrimaryForegroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource Border.HairlineThickness}"/>

                <Button x:Name="SwitchButton"
                        Grid.Column="2"
                        Height="38"
                        Cursor="Hand"
                        IsDefault="True"
                        Click="Switch_Click"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="{DynamicResource OnAccentForegroundBrush}"
                        BorderThickness="{DynamicResource Border.NoneThickness}"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
