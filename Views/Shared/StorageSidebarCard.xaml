<UserControl x:Class="ProGlassAutomation.Views.Shared.StorageSidebarCard"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- Sidebar storage card — now an interactive button: clicking it
         opens the storage breakdown popup (icon · module · covered
         storage). Hover shows the menu-hover surface so the card
         reads as clickable, not as a static footer. -->
    <Button Command="{Binding StorageCardCommand}"
            Cursor="Hand"
            FocusVisualStyle="{x:Null}"
            Margin="12,0,12,14"
            Padding="0"
            HorizontalContentAlignment="Stretch"
            ToolTip="{DynamicResource Storage.TapForDetails}">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Card"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Background="{DynamicResource SidebarCardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{DynamicResource Border.HairlineThickness}"
                        Padding="14,12"
                        SnapsToDevicePixels="True">
                    <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Card" Property="Background"
                                Value="{DynamicResource SurfaceTertiaryBrush}"/>
                        <Setter TargetName="Card" Property="BorderBrush"
                                Value="{DynamicResource AccentBrush}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Card" Property="Background"
                                Value="{DynamicResource TintIndigoBrush}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>

        <StackPanel>
            <Grid Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8B7;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="{StaticResource TextXSmall}"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource Nav.GroupStorage}"
                               FontSize="{StaticResource TextXSmall}" FontWeight="Bold"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding StorageDisplay, FallbackValue='—'}"
                           HorizontalAlignment="Right"
                           FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Grid>
            <Border Height="6"
                    Background="{DynamicResource BorderBrush}"
                    CornerRadius="{DynamicResource Radius.XSmall}">
                <Border Width="180"
                        HorizontalAlignment="Left"
                        CornerRadius="{DynamicResource Radius.XSmall}"
                        Background="{DynamicResource StorageBarGradient}"/>
            </Border>
            <TextBlock Text="{Binding StorageSubtitle, FallbackValue='Storage unavailable'}"
                       FontSize="{StaticResource TextCaption}"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Button>
</UserControl>
