<UserControl x:Class="ProGlassAutomation.Views.Shared.StorageSidebarCard"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="{DynamicResource Ov.Canvas}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Dashboard/Overview/IndigoStudioResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         Sidebar storage footer card (Concept 30 PORCELAIN FLOW)
         Tiny "Local storage —" and "View breakdown", NO meter.
         Clicking opens the Storage breakdown popup.
    ═══════════════════════════════════════════════════════════════ -->
    <Button Command="{Binding StorageCardCommand}"
            Cursor="Hand"
            FocusVisualStyle="{x:Null}"
            Margin="10,0,10,12"
            Padding="0"
            HorizontalContentAlignment="Stretch"
            ToolTip="{DynamicResource Storage.TapForDetails}">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Card"
                        CornerRadius="8"
                        Background="{DynamicResource Ov.Soft}"
                        BorderBrush="{DynamicResource Ov.Line}"
                        BorderThickness="1"
                        Padding="12,9"
                        SnapsToDevicePixels="True">
                    <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource Ov.OnAccentMuted}"/>
                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Ov.Accent}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource Ov.Soft}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>

        <StackPanel>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Local storage —"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Ov.Ink}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StorageDisplay, FallbackValue='—'}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Ov.Accent}"
                               Typography.NumeralAlignment="Tabular"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="View breakdown"
                       FontSize="10"
                       FontWeight="Medium"
                       Foreground="{DynamicResource Ov.Muted}"
                       Margin="0,3,0,0"/>
        </StackPanel>
    </Button>
</UserControl>
