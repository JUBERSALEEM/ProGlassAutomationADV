<UserControl x:Class="ProGlassAutomation.Views.Shared.QuickSettingsPanel"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="QuickSettingsRow" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}" Style="{StaticResource SurfacePrimaryStyle}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource SurfaceTertiaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource TintIndigoBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        
        
    </UserControl.Resources>

    <Grid Margin="10,8,10,16">
        <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="3"
                                  Opacity="0.18" Color="{DynamicResource LiquidShadowColor}" Direction="270"/>
            </Border.Effect>
            <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                    Background="{DynamicResource ShellLiquidBrush}"
                    BorderBrush="{DynamicResource ShellLiquidBorderBrush}"
                    BorderThickness="{DynamicResource Border.HairlineThickness}"
                    ClipToBounds="True" Style="{StaticResource SurfacePrimaryStyle}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="{DynamicResource Radius.Top.Medium}"
                            Padding="18,12" Style="{StaticResource SurfacePrimaryStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Shell.NavSettings}"
                                       FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Text="{DynamicResource Settings.HintEveryPage}"
                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                       Opacity="0.85" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  MaxHeight="520"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="8,4,8,10">
                        <StackPanel>

                            <TextBlock Style="{StaticResource Typography.Label}" Text="{DynamicResource Settings.GrpLook}"/>
                            <Button Style="{StaticResource SurfaceDetailButtonStyle}" Command="{Binding OpenSettingsPageCommand}" CommandParameter="Appearance">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE790;"/>
                                    <TextBlock Style="{StaticResource Typography.Body}" Text="{DynamicResource Settings.SecAppearance}"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Style="{StaticResource Typography.Label}" Text="{DynamicResource Settings.GrpIntelligence}"/>
                            <Button Style="{StaticResource SurfaceDetailButtonStyle}" Command="{Binding OpenSettingsPageCommand}" CommandParameter="AI">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8F2;"/>
                                    <TextBlock Style="{StaticResource Typography.Body}" Text="{DynamicResource Settings.SecAi}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SurfaceDetailButtonStyle}" Command="{Binding OpenSettingsPageCommand}" CommandParameter="Agent">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE99A;"/>
                                    <TextBlock Style="{StaticResource Typography.Body}" Text="{DynamicResource Settings.SecAgent}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SurfaceDetailButtonStyle}" Command="{Binding OpenSettingsPageCommand}" CommandParameter="Voice">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE720;"/>
                                    <TextBlock Style="{StaticResource Typography.Body}" Text="{DynamicResource Settings.SecVoice}"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Style="{StaticResource Typography.Label}" Text="{DynamicResource Nav.GroupSystem}"/>
                            <Button Style="{StaticResource SurfaceDetailButtonStyle}" Command="{Binding OpenSettingsPageCommand}" CommandParameter="Data">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE74E;"/>
                                    <TextBlock Style="{StaticResource Typography.Body}" Text="{DynamicResource Settings.SecData}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SurfaceDetailButtonStyle}" Command="{Binding OpenSettingsPageCommand}" CommandParameter="Updates">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE72C;"/>
                                    <TextBlock Style="{StaticResource Typography.Body}" Text="{DynamicResource Settings.SecUpdates}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SurfaceDetailButtonStyle}" Command="{Binding OpenSettingsPageCommand}" CommandParameter="Demo">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE714;"/>
                                    <TextBlock Style="{StaticResource Typography.Body}" Text="{DynamicResource Settings.SecDemo}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SurfaceDetailButtonStyle}" Command="{Binding OpenSettingsPageCommand}" CommandParameter="Features">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE762;"/>
                                    <TextBlock Style="{StaticResource Typography.Body}" Text="{DynamicResource Settings.SecFeatures}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SurfaceDetailButtonStyle}" Command="{Binding OpenSettingsPageCommand}" CommandParameter="License">
                                <StackPanel Orientation="Horizontal">
                                    <!-- 2026-09-14: E192 was an MDL1 code point
                                         (broken box) — E72E (Shield) is valid
                                         MDL2 and fits license/activation. -->
                                    <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE72E;" Margin="0,0,10,0"/>
                                    <TextBlock Style="{StaticResource Typography.Body}" Text="{DynamicResource Settings.SecLicense}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SurfaceDetailButtonStyle}" Command="{Binding OpenSettingsPageCommand}" CommandParameter="About">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE946;"/>
                                    <TextBlock Style="{StaticResource Typography.Body}" Text="{DynamicResource Settings.SecAbout}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
