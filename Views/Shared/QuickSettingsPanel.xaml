<UserControl x:Class="ProGlassAutomation.Views.Shared.QuickSettingsPanel"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
            Background="{DynamicResource ShellGlassBrush}"
            BorderBrush="{DynamicResource ShellGlassBorderBrush}"
            BorderThickness="1"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="3"
                              Opacity="0.18" Color="#000000" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource AccentBrush}"

                    Padding="18,12">
                <StackPanel>
                    <TextBlock Text="Settings"
                               FontSize="14" FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="Quick access"
                               FontSize="10" Foreground="White"
                               Opacity="0.85" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="10,10,10,12">
                <Button Content="Appearance" Tag="Appearance"
                        Height="36" Margin="0,1" Cursor="Hand"
                        Background="Transparent" BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        FontSize="12" FontWeight="Medium"
                        Foreground="{DynamicResource PrimaryForegroundBrush}"
                        Click="Link_Click"/>
                <Button Content="AI &amp; Agent" Tag="AI"
                        Height="36" Margin="0,1" Cursor="Hand"
                        Background="Transparent" BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        FontSize="12" FontWeight="Medium"
                        Foreground="{DynamicResource PrimaryForegroundBrush}"
                        Click="Link_Click"/>
                <Button Content="Voice" Tag="Voice"
                        Height="36" Margin="0,1" Cursor="Hand"
                        Background="Transparent" BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        FontSize="12" FontWeight="Medium"
                        Foreground="{DynamicResource PrimaryForegroundBrush}"
                        Click="Link_Click"/>
                <Button Content="Data &amp; Database" Tag="Data"
                        Height="36" Margin="0,1" Cursor="Hand"
                        Background="Transparent" BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        FontSize="12" FontWeight="Medium"
                        Foreground="{DynamicResource PrimaryForegroundBrush}"
                        Click="Link_Click"/>
                <Button Content="Updates" Tag="Updates"
                        Height="36" Margin="0,1" Cursor="Hand"
                        Background="Transparent" BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        FontSize="12" FontWeight="Medium"
                        Foreground="{DynamicResource PrimaryForegroundBrush}"
                        Click="Link_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
