<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Shared/QuickSettingsPanel.xaml
     PROJECT: ProGlassAutomation
     MODULE: Shell — top-panel Settings quick list (the gear popup)

     The list is one grouped ItemsControl over SettingsViewModel.NavRows.
     Adding or renaming a settings page changes this panel for free
     (SettingsNavigationAuditTests locks it). Theme Studio is the Themes
     row, not a second banner and not a hard-coded page key.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Shared.QuickSettingsPanel"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Dashboard/Overview/IndigoStudioResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <CollectionViewSource x:Key="QuickSettingsView"
                              Source="{Binding SettingsVM.NavRows}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupLabel"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="QuickSettingsRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="8">
        <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="3"
                                  Opacity="0.18" Color="{DynamicResource LiquidShadowColor}" Direction="270"/>
            </Border.Effect>
            <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                    Background="{DynamicResource ShellLiquidBrush}"
                    BorderBrush="{DynamicResource Ov.Line}"
                    BorderThickness="{DynamicResource Border.HairlineThickness}"
                    ClipToBounds="True">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource Ov.Hero}"
                            Padding="16,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Shell.NavSettings}"
                                       FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Text="{DynamicResource Settings.HintEveryPage}"
                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                       Opacity="0.85" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  MaxHeight="420"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="8,6,8,4">
                        <ItemsControl ItemsSource="{Binding Source={StaticResource QuickSettingsView}}"
                                      KeyboardNavigation.TabNavigation="Cycle">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Typography.Label}"
                                                       Text="{Binding Name}"
                                                       Margin="6,8,6,4"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource QuickSettingsRowButton}"
                                            Margin="0,0,0,6"
                                            Command="{Binding DataContext.OpenSettingsPageCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Key}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Style="{StaticResource Typography.Icon}"
                                                       Text="{Binding Glyph}"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Typography.Body}"
                                                           Text="{Binding Label}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{DynamicResource Shell.ThemeStudioHint}"
                                                           FontSize="{DynamicResource FontSize.Badge}"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           Margin="0,1,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Key}" Value="Themes">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="2"
                            Style="{StaticResource QuickSettingsRowButton}"
                            Margin="8,0,8,8"
                            HorizontalContentAlignment="Center"
                            Foreground="{DynamicResource AccentBrush}"
                            FontWeight="SemiBold"
                            Content="{DynamicResource Shell.OpenFullSettings}"
                            Command="{Binding DataContext.OpenSettingsPageCommand,
                                RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
