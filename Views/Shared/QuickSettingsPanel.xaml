<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Shared/QuickSettingsPanel.xaml
     PROJECT: ProGlassAutomation
     MODULE: Shell — top-panel Settings quick list (the gear popup)

     2026-09-16 REWRITE — owner report:
       "check setting top panel … there are only 10 button when i have in
        setting side bar 12 button … button too overlapping apply proper
        spacing"

     WHAT WAS WRONG
     ──────────────
     The list was ten hand-copied <Button> blocks, each with its own
     CommandParameter string, its own glyph and no spacing:

       • ten entries against a twelve-page registry — Themes and Sharing
         could not be reached from this panel at all;
       • two glyphs disagreed with the rail: Features drew E762 (the
         rail's License glyph) and Agent drew E99A instead of the rail's
         E9F5, so one page wore two different icons depending on which
         surface you used;
       • no vertical margin between rows and Typography.Icon sets no
         right margin, so rows touched each other and each glyph touched
         its label. Exactly ONE button carried a hand-added
         Margin="0,0,10,0" — the gap was known and patched in one place.

     THE FIX — the architecture the rail already uses
     ────────────────────────────────────────────────
     ONE grouped ItemsControl over SettingsViewModel.NavRows — the
     registry that SettingsViewModel.Navigation.cs declares as the single
     source of truth. Adding or renaming a settings page now changes this
     panel for free, and it cannot drift again
     (SettingsNavigationAuditTests locks it).

       • Grouping is a CollectionViewSource over the row's LOCALIZED
         GroupLabel, so captions come from the same localization service
         as the rest of the app and the header template is one binding.
       • Spacing is explicit and uniform: 6 px between rows (item
         margin), 10 px between glyph and label — the same 10 px gap the
         rail documents for its icon column.
       • The glyph column is a fixed 20 px, so all twelve labels start on
         one vertical line instead of stepping with each glyph's width.

     The popup chrome (ShellLiquidBrush surface, CardCornerRadiusLarge,
     LiquidShadowColor drop shadow, padding) is UNCHANGED from the
     approved shell design — only the list inside it was rebuilt.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Shared.QuickSettingsPanel"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Dashboard/Overview/IndigoStudioResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <!-- The registry, grouped. The panel's DataContext is the shell
             (MainViewModel), which exposes the Settings view model as
             SettingsVM — so this binds the SAME rows the rail renders. -->
        <CollectionViewSource x:Key="QuickSettingsView"
                              Source="{Binding SettingsVM.NavRows}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupLabel"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10,8,10,16">
        <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="3"
                                  Opacity="0.18" Color="{DynamicResource LiquidShadowColor}" Direction="270"/>
            </Border.Effect>
            <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                    Background="{DynamicResource ShellLiquidBrush}"
                    BorderBrush="{DynamicResource ShellLiquidBorderBrush}"
                    BorderThickness="{DynamicResource Border.HairlineThickness}"
                    ClipToBounds="True">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource Ov.Hero}"
                            CornerRadius="{DynamicResource Radius.Top.Medium}"
                            Padding="18,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Shell.NavSettings}"
                                       FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Text="{DynamicResource Settings.HintEveryPage}"
                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                       Opacity="0.85" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 🎨 THEME STUDIO QUICK ACCESS BANNER -->
                    <Border Grid.Row="1" Background="{DynamicResource Ov.Soft}" BorderBrush="{DynamicResource Ov.Line}" BorderThickness="0,0,0,1" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15" Background="{DynamicResource Ov.Accent}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE790;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="13" Foreground="{DynamicResource OnAccentForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="THEME STUDIO" FontSize="{DynamicResource FontSize.Label}" FontWeight="Bold" Foreground="{DynamicResource Ov.Accent}"/>
                                <TextBlock Text="Family, light/dark, and crystal glass" FontSize="{DynamicResource FontSize.Badge}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource PrimaryPillButton}" Height="28" Padding="12,0"
                                    Command="{Binding DataContext.OpenSettingsPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="Themes"
                                    Content="Open Studio" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2"
                                  MaxHeight="520"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="10,6,10,12">
                        <ItemsControl ItemsSource="{Binding Source={StaticResource QuickSettingsView}}"
                                      KeyboardNavigation.TabNavigation="Cycle">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Typography.Label}"
                                                       Text="{Binding Name}"
                                                       Margin="6,8,6,4"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- One row = one registered page: the
                                         command comes from the shell and the
                                         parameter is the row's own key, so a
                                         page that has no host cannot be
                                         invented here. -->
                                    <Button Style="{StaticResource SurfaceDetailButtonStyle}"
                                            Margin="0,0,0,6"
                                            Command="{Binding DataContext.OpenSettingsPageCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Key}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Style="{StaticResource Typography.Icon}"
                                                       Text="{Binding Glyph}"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Style="{StaticResource Typography.Body}"
                                                       Text="{Binding Label}"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
