<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ProGlassAutomation.Views.Shared.Lists">
    <!-- Approved Studio Bento list system. Scoped to the five list views, never App.xaml. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../Dashboard/Overview/IndigoStudioResources.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <local:StudioListBrushConverter x:Key="Sl.StatusBrush" Palette="{StaticResource Ov.StatusBrush}"/>
    <local:StudioListTagGlyphConverter x:Key="Sl.TagGlyph"/>
    <local:StudioListGutterConverter x:Key="Sl.Gutter"/>
    <local:StudioListExtentConverter x:Key="Sl.Extent"/>
    <local:StudioListToolbarHeightConverter x:Key="Sl.ToolbarHeight"/>


    <!-- Scoped aliases for existing native input and context-menu templates. -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{Binding Color, Source={StaticResource Ov.Ink}}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{Binding Color, Source={StaticResource Ov.Muted}}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{Binding Color, Source={StaticResource Ov.Muted}}"/>
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="{Binding Color, Source={StaticResource Ov.Ink}}"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="{Binding Color, Source={StaticResource Ov.Muted}}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{Binding Color, Source={StaticResource Ov.Accent}}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{Binding Color, Source={StaticResource Ov.AccentHover}}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{Binding Color, Source={StaticResource Ov.AccentHover}}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{Binding Color, Source={StaticResource Ov.Success}}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{Binding Color, Source={StaticResource Ov.Warning}}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{Binding Color, Source={StaticResource Ov.Danger}}"/>
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="{Binding Color, Source={StaticResource Ov.Line}}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{Binding Color, Source={StaticResource Ov.Line}}"/>
    <SolidColorBrush x:Key="SurfacePrimaryBrush" Color="{Binding Color, Source={StaticResource Ov.Surface}}"/>
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{Binding Color, Source={StaticResource Ov.Surface}}"/>
    <SolidColorBrush x:Key="SurfaceTertiaryBrush" Color="{Binding Color, Source={StaticResource Ov.Soft}}"/>
    <SolidColorBrush x:Key="PopupSurfaceBrush" Color="{Binding Color, Source={StaticResource Ov.Surface}}"/>
    <SolidColorBrush x:Key="OnAccentForegroundBrush" Color="{Binding Color, Source={StaticResource Ov.OnAccent}}"/>
    <SolidColorBrush x:Key="TintIndigoBrush" Color="{Binding Color, Source={StaticResource Ov.Soft}}"/>
    <SolidColorBrush x:Key="TintBlueBrush" Color="{Binding Color, Source={StaticResource Ov.Soft}}"/>
    <SolidColorBrush x:Key="TintGrayBrush" Color="{Binding Color, Source={StaticResource Ov.Soft}}"/>
    <SolidColorBrush x:Key="TintRedBrush" Color="{Binding Color, Source={StaticResource Ov.DangerSoft}}"/>
    <SolidColorBrush x:Key="TintAmberBrush" Color="{Binding Color, Source={StaticResource Ov.WarningSoft}}"/>
    <SolidColorBrush x:Key="TintGreenBrush" Color="{Binding Color, Source={StaticResource Ov.SuccessSoft}}"/>
    <SolidColorBrush x:Key="Surface.Primary.BackgroundBrush" Color="{Binding Color, Source={StaticResource Ov.Surface}}"/>
    <SolidColorBrush x:Key="Surface.Secondary.BackgroundBrush" Color="{Binding Color, Source={StaticResource Ov.Surface}}"/>

    <SolidColorBrush x:Key="ModuleBackgroundBrush" Color="{Binding Color, Source={StaticResource Ov.Surface}}"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="{Binding Color, Source={StaticResource Ov.Line}}"/>
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="{Binding Color, Source={StaticResource Ov.Muted}}"/>
    <SolidColorBrush x:Key="SurfaceInputBrush" Color="{Binding Color, Source={StaticResource Ov.Surface}}"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{Binding Color, Source={StaticResource Ov.Line}}"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{Binding Color, Source={StaticResource Ov.Accent}}"/>
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">18</CornerRadius>
    <Style x:Key="Sl.Title" TargetType="TextBlock" BasedOn="{StaticResource Ov.Title}">
        <Setter Property="FontSize" Value="28"/>
    </Style>
    <Style x:Key="Sl.Subtitle" TargetType="TextBlock" BasedOn="{StaticResource Ov.Meta}">
        <Setter Property="Margin" Value="0,5,0,0"/>
    </Style>
    <Style x:Key="Sl.Label" TargetType="TextBlock" BasedOn="{StaticResource Ov.Meta}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Sl.Value" TargetType="TextBlock" BasedOn="{StaticResource Ov.Value}">
        <Setter Property="FontSize" Value="23"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,5,0,3"/>
    </Style>
    <Style x:Key="Sl.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ov.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ov.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="18"/>
    </Style>
    <Style x:Key="Sl.Hero" TargetType="Border" BasedOn="{StaticResource Sl.Card}">
        <Setter Property="Background" Value="{DynamicResource Ov.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ov.Accent}"/>
        <Setter Property="Padding" Value="22"/>
    </Style>
    <Style x:Key="Sl.Shell" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="Sl.FilterBar" TargetType="Border" BasedOn="{StaticResource Sl.Card}">
        <Setter Property="Padding" Value="14,8,8,4"/>
        <Setter Property="Margin" Value="0,8,0,8"/>
    </Style>
    <Style x:Key="Sl.TableHeader" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ov.Soft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ov.Line}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0,14"/>
    </Style>
    <Style x:Key="Sl.ColumnLabel" TargetType="TextBlock" BasedOn="{StaticResource Sl.Label}">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Sl.Row" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ov.Line}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="MinHeight" Value="62"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Ov.Soft}"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Background" Value="{DynamicResource Ov.Soft}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Sl.ListItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="ItemChrome" Background="{TemplateBinding Background}" BorderThickness="0">
                    <ContentPresenter HorizontalAlignment="Stretch"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource Ov.Soft}"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource Ov.Soft}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Sl.StatementItem" TargetType="ListViewItem" BasedOn="{StaticResource Sl.ListItem}"/>
    <Style x:Key="Sl.Input" TargetType="TextBox" BasedOn="{StaticResource ModuleListFilterInputStyle}">
        <Setter Property="Background" Value="{DynamicResource Ov.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ov.Ink}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ov.Line}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Ov.Accent}"/>
        <Setter Property="MinHeight" Value="38"/>
    </Style>
    <Style x:Key="Sl.Combo" TargetType="ComboBox" BasedOn="{StaticResource ModuleListFilterComboStyle}">
        <Style.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="StudioListPopupResources.xaml"/>
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Style.Resources>
        <Setter Property="Background" Value="{DynamicResource Ov.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ov.Ink}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ov.Line}"/>
        <Setter Property="MinHeight" Value="38"/>
    </Style>
    <Style x:Key="Sl.Date" TargetType="DatePicker" BasedOn="{StaticResource ModuleListFilterDatePickerStyle}">
        <Setter Property="Background" Value="{DynamicResource Ov.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ov.Ink}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ov.Line}"/>
        <Setter Property="MinHeight" Value="38"/>
    </Style>
    <Style x:Key="Sl.Button" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Ov.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ov.Ink}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ov.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="Glyph" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"
                                   Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Sl.TagGlyph}}"/>
                        <ContentPresenter RecognizesAccessKey="True" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Ov.Accent}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Ov.Accent}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Sl.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Sl.Button}">
        <Setter Property="Background" Value="{DynamicResource Ov.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ov.OnAccent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ov.Accent}"/>
    </Style>
    <Style x:Key="Sl.DangerButton" TargetType="Button" BasedOn="{StaticResource Sl.Button}">
        <Setter Property="Background" Value="{DynamicResource Ov.DangerSoft}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ov.Danger}"/>
    </Style>
    <Style x:Key="Sl.SuccessButton" TargetType="Button" BasedOn="{StaticResource Sl.Button}">
        <Setter Property="Background" Value="{DynamicResource Ov.SuccessSoft}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ov.Success}"/>
    </Style>
    <Style x:Key="Sl.Tab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Ov.Muted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Border x:Name="TabChrome" CornerRadius="10" Background="{DynamicResource Ov.Surface}"
                    BorderBrush="{DynamicResource Ov.Line}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                <StackPanel Orientation="Horizontal">
                    <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource Ov.Soft}" CornerRadius="5" Padding="6,2" Margin="8,0,0,0">
                        <TextBlock Text="{TemplateBinding CommandParameter}" Foreground="{DynamicResource Ov.Ink}"/>
                    </Border>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource Ov.Soft}"/><Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource Ov.Accent}"/><Setter Property="Foreground" Value="{DynamicResource Ov.Accent}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabChrome" Property="BorderThickness" Value="2"/><Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource Ov.Accent}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TabChrome" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Sl.Error" TargetType="Border" BasedOn="{StaticResource Sl.Card}">
        <Setter Property="Background" Value="{DynamicResource Ov.DangerSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ov.Danger}"/>
        <Setter Property="Padding" Value="14,10"/>
    </Style>
    <Style x:Key="Sl.ContextMenu" TargetType="ContextMenu" BasedOn="{StaticResource ModernContextMenuStyle}">
        <Style.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="StudioListPopupResources.xaml"/>
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Style.Resources>
        <Setter Property="Background" Value="{StaticResource Ov.Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource Ov.Ink}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Ov.Line}"/>
    </Style>
    <Style x:Key="Sl.MenuItem" TargetType="MenuItem" BasedOn="{StaticResource ModernMenuItemStyle}">
        <Style.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="StudioListPopupResources.xaml"/>
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Style.Resources>
        <Setter Property="Foreground" Value="{StaticResource Ov.Ink}"/>
    </Style>
    <Style x:Key="Sl.CheckableMenuItem" TargetType="MenuItem" BasedOn="{StaticResource ModernCheckableMenuItemStyle}">
        <Style.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="StudioListPopupResources.xaml"/>
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Style.Resources>
        <Setter Property="Foreground" Value="{StaticResource Ov.Ink}"/>
    </Style>
    <Style x:Key="Sl.MenuSeparator" TargetType="Separator" BasedOn="{StaticResource ModernMenuSeparatorStyle}">
        <Style.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="StudioListPopupResources.xaml"/>
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Style.Resources>
    </Style>
    <!-- Failed data is not presented as a successful empty result. Retry remains outside this gate. -->
    <Style x:Key="Sl.DataArea" TargetType="Grid">
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Studio Bento DataGrid styles for enterprise God Views & reporting grids -->
    <Style x:Key="Sl.DataGrid" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="RowBackground" Value="{DynamicResource Ov.Surface}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Ov.Soft}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ov.Ink}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ov.Line}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Ov.Line}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Ov.Line}"/>
        <Setter Property="RowHeight" Value="{DynamicResource DensityRowHeight}"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeColumns" Value="True"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="VirtualizingPanel.CacheLength" Value="400,800"/>
        <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Pixel"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="Sl.DataGridHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Ov.Soft}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ov.Muted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ov.Line}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="Sl.DataGridHeaderCenter" TargetType="DataGridColumnHeader" BasedOn="{StaticResource Sl.DataGridHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Sl.DataGridHeaderRight" TargetType="DataGridColumnHeader" BasedOn="{StaticResource Sl.DataGridHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>

    <Style x:Key="Sl.CellText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Ov.Ink}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="Sl.CellTextCenter" TargetType="TextBlock" BasedOn="{StaticResource Sl.CellText}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Sl.CellTextRight" TargetType="TextBlock" BasedOn="{StaticResource Sl.CellText}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
</ResourceDictionary>
