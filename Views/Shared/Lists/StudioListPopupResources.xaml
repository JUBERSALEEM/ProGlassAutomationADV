<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Studio Bento popup palette: detached visual tree resource contract. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../Dashboard/Overview/IndigoStudioResources.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <SolidColorBrush x:Key="ModuleBackgroundBrush" Color="{DynamicResource Ov.SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{DynamicResource Ov.SurfaceColor}"/>
    <SolidColorBrush x:Key="PopupSurfaceBrush" Color="{DynamicResource Ov.SurfaceColor}"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="{DynamicResource Ov.LineColor}"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{DynamicResource Ov.LineColor}"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{DynamicResource Ov.AccentColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource Ov.AccentColor}"/>
    <SolidColorBrush x:Key="MenuHoverBrush" Color="{DynamicResource Ov.SoftColor}"/>
    <SolidColorBrush x:Key="TintIndigoBrush" Color="{DynamicResource Ov.SoftColor}"/>
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="{DynamicResource Ov.InkColor}"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="{DynamicResource Ov.MutedColor}"/>
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="{DynamicResource Ov.MutedColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource Ov.InkColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource Ov.MutedColor}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{DynamicResource Ov.MutedColor}"/>
    <SolidColorBrush x:Key="OnAccentForegroundBrush" Color="{DynamicResource Ov.OnAccentColor}"/>
</ResourceDictionary>
