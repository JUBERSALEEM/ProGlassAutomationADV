<UserControl x:Class="ProGlassAutomation.Views.Shared.ScreenshotPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Border Width="320" CornerRadius="14"
            Background="{DynamicResource ModuleBackgroundBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="{StaticResource CardBorderThickness}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="3"
                              Opacity="0.18" Color="#000000" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource AccentBrush}"
                    CornerRadius="14,14,0,0"
                    Padding="16,12">
                <StackPanel>
                    <TextBlock Text="Capture Screenshot"
                               FontSize="13" FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="Choose a resolution and capture"
                               FontSize="10" Foreground="White"
                               Opacity="0.85" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="12,12,12,14">
                <CheckBox x:Name="FullPageCheck"
                          Content="Full module (capture the entire scrollable page)"
                          FontSize="11"
                          Foreground="{DynamicResource PrimaryForegroundBrush}"
                          Margin="0,0,0,10"
                          IsChecked="False"
                          ToolTip="Scrolls the active module top-to-bottom and stitches every section into one continuous screenshot so no rows are cut off"/>
                <StackPanel x:Name="QualityList"/>
                <TextBlock x:Name="CaptureStatus"
                           FontSize="10"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
