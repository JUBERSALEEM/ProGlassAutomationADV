<UserControl x:Class="ProGlassAutomation.Views.Shared.ScreenshotPanel"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Margin="10,8,10,16">
    <Border Width="360" CornerRadius="{DynamicResource CardCornerRadiusLarge}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="3"
                              Opacity="0.18" Color="#000000" Direction="270"/>
        </Border.Effect>
        <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                Background="{DynamicResource ShellLiquidBrush}"
                BorderBrush="{DynamicResource ShellLiquidBorderBrush}"
                BorderThickness="1"
                ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource AccentBrush}"
                    CornerRadius="16,16,0,0"
                    Padding="16,12">
                <StackPanel>
                    <TextBlock Text="Capture Screenshot"
                               FontSize="{StaticResource TextBodyLarge}" FontWeight="Bold"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                    <TextBlock Text="Choose a resolution and capture"
                               FontSize="{StaticResource TextCaption}" Foreground="{DynamicResource OnAccentForegroundBrush}"
                               Opacity="0.85" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="12,12,12,14">
                <CheckBox x:Name="FullPageCheck"
                          Content="Full module (capture the entire scrollable page)"
                          FontSize="{StaticResource TextBody}"
                          Foreground="{DynamicResource PrimaryForegroundBrush}"
                          Margin="0,0,0,10"
                          IsChecked="False"
                          ToolTip="Scrolls the active module top-to-bottom and stitches every section into one continuous screenshot so no rows are cut off"/>
                <StackPanel x:Name="QualityList"/>
                <TextBlock x:Name="CaptureStatus"
                           FontSize="{StaticResource TextCaption}"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
        </Border>
    </Border>
    </Grid>
</UserControl>
