<UserControl x:Class="ProGlassAutomation.Views.Shared.ScreenshotPanel"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Margin="10,8,10,16">
    <Border Width="360" CornerRadius="{DynamicResource CardCornerRadiusLarge}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="3"
                              Opacity="0.18" Color="{DynamicResource LiquidShadowColor}" Direction="270"/>
        </Border.Effect>
        <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                Background="{DynamicResource ShellLiquidBrush}"
                BorderBrush="{DynamicResource ShellLiquidBorderBrush}"
                BorderThickness="{DynamicResource Border.HairlineThickness}"
                ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource AccentBrush}"
                    CornerRadius="{DynamicResource Radius.Top.Medium}"
                    Padding="16,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource ToolTip.Screenshot}"
                               FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                    <TextBlock Text="{DynamicResource Shared.ChooseResolutionCapture}"
                               FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource OnAccentForegroundBrush}"
                               Opacity="0.85" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="12,12,12,14">
                <CheckBox x:Name="FullPageCheck"
                          Content="{DynamicResource Shared.FullModuleCaptureEntireScrollablePage}"
                          FontSize="{DynamicResource FontSize.Body}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          Margin="0,0,0,10"
                          IsChecked="False"
                          ToolTip="{DynamicResource Shared.ScrollsActiveModuleTopBottomStitchesSection}"/>
                <StackPanel x:Name="QualityList"/>
                <TextBlock x:Name="CaptureStatus"
                           FontSize="{DynamicResource FontSize.BodySmall}"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
        </Border>
    </Border>
    </Grid>
</UserControl>
