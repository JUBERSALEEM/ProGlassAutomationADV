<UserControl x:Class="ProGlassAutomation.Views.Shared.ActivityPanel"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Dashboard/Overview/IndigoStudioResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10,8,10,16">
    <Border Width="400" CornerRadius="{DynamicResource CardCornerRadiusLarge}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="3"
                              Opacity="0.18" Color="{DynamicResource LiquidShadowColor}" Direction="270"/>
        </Border.Effect>
        <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                Background="{DynamicResource ShellLiquidBrush}"
                BorderBrush="{DynamicResource ShellLiquidBorderBrush}"
                BorderThickness="{DynamicResource Border.HairlineThickness}"
                ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource AccentBrush}"
                    CornerRadius="{DynamicResource Radius.Top.Medium}"
                    Padding="18,12">
                <TextBlock Text="{DynamicResource ToolTip.RecentActivity}"
                           FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}"
                           Foreground="{DynamicResource OnAccentForegroundBrush}"/>
            </Border>

            <ScrollViewer Grid.Row="1" MaxHeight="320"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ActivityList" Margin="10,10,10,12"/>
            </ScrollViewer>
        </Grid>
        </Border>
    </Border>
    </Grid>
</UserControl>
