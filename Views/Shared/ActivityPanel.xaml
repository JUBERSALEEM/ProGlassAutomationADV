<UserControl x:Class="ProGlassAutomation.Views.Shared.ActivityPanel"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Border Width="360" CornerRadius="{DynamicResource CardCornerRadiusLarge}"
            Background="{DynamicResource ShellGlassBrush}"
            BorderBrush="{DynamicResource ShellGlassBorderBrush}"
            BorderThickness="1"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="3"
                              Opacity="0.18" Color="#000000" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource AccentBrush}"

                    Padding="18,12">
                <TextBlock Text="Recent Activity"
                           FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource OnAccentForegroundBrush}"/>
            </Border>

            <ScrollViewer Grid.Row="1" MaxHeight="320"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ActivityList" Margin="10,10,10,12"/>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
