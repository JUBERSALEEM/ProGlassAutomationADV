<Window x:Class="ProGlassAutomation.Views.Shared.RecordOverlayWindow"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Shared.Recording}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="{DynamicResource Shared.Widthandheight}"
        ShowActivated="False"
        FontFamily="{DynamicResource AppFontFamily}"
        FontWeight="{DynamicResource AppFontWeight}"
        FontStyle="{DynamicResource AppFontStyle}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Matches the app's rounded action buttons: CardCornerRadius (12). -->
        <!-- Compact HUD buttons (Aug 2026 senior audit: user asked to
             make the recorder smaller). Was 38x38; shrunk to 28x28
             with tighter padding for a more phone-like recorder pill. -->
        <Style x:Key="HudButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
      Compact recording card — same 12px card shape as the app's other
      top-bar cards (date/time, agent, connectivity), not a pill.

      Layout (single card, left → right):
        ● REC   12:34   [⏸] [⏹]

      - Time sits on the LEFT, followed by two small square controls
        (pause, stop) — the "time · pause · stop" trio of a phone screen
        recorder. The close button only appears when the recording has
        finished (SAVED / FAILED) so the user can dismiss the card.
      - A single status line appears only while the recording is finalizing
        or after it finishes.
    -->
    <Border x:Name="HudRoot"
            CornerRadius="{DynamicResource CardCornerRadius}"
            Padding="10,6"
            BorderThickness="1"
            BorderBrush="{DynamicResource GlassBorderSoft}"
            Cursor="SizeAll"
            ToolTip="{DynamicResource Shared.DragMoveRecorder}"
            MouseLeftButtonDown="HudDrag_MouseLeftButtonDown">
        <Border.Background>
            <SolidColorBrush Color="#E6101824"/>
        </Border.Background>

        <StackPanel>
            <DockPanel LastChildFill="False">
                <Ellipse x:Name="HudDot" DockPanel.Dock="Left"
                         Width="8" Height="8" Margin="0,0,8,0"
                         VerticalAlignment="Center" Fill="{DynamicResource DangerBrush}"/>

                <TextBlock x:Name="HudBadge" DockPanel.Dock="Left"
                           Text="{DynamicResource Shared.REC}" FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                           Foreground="{DynamicResource DangerLightBrush}" VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBlock x:Name="HudTime" DockPanel.Dock="Left"
                           Text="00:00" FontSize="{StaticResource TextSubhead}" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"
                           MinWidth="52" TextAlignment="Right"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="10,0,0,0">
                    <!-- Pause / Resume — ⏸ ▶ (Segoe MDL2) -->
                    <Button x:Name="HudPause"
                            Style="{StaticResource HudButtonStyle}"
                            Click="Pause_Click"
                            Margin="0,0,4,0"
                            Background="{DynamicResource GlassSurfaceElevated}"
                            AutomationProperties.Name="Pause or resume recording">
                        <TextBlock Text="&#xE769;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="{StaticResource TextBody}" VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                    <!-- Stop — ⏹ (Segoe MDL2) -->
                    <Button x:Name="HudStop"
                            Style="{StaticResource HudButtonStyle}"
                            Click="Stop_Click"
                            Margin="0,0,4,0"
                            Background="{DynamicResource DangerBrush}"
                            AutomationProperties.Name="Stop and save recording">
                        <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="{StaticResource TextBody}" VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                    <!-- Open folder — visible after SAVED (Aug 2026 fix) -->
                    <Button x:Name="HudOpenFolder"
                            Style="{StaticResource HudButtonStyle}"
                            Click="OpenFolder_Click"
                            Margin="0,0,4,0"
                            Background="{DynamicResource AccentBrush}"
                            Visibility="Collapsed"
                            ToolTip="{DynamicResource Shared.OpenFolderWhereVideoSaved}"
                            AutomationProperties.Name="Open recording folder">
                        <TextBlock Text="&#xE8DA;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="{StaticResource TextBody}" VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                    <!-- Dismiss after SAVED / FAILED -->
                    <Button x:Name="HudClose"
                            Style="{StaticResource HudButtonStyle}"
                            Click="Close_Click"
                            Background="{DynamicResource GlassSurfaceBrush}"
                            Visibility="Collapsed"
                            AutomationProperties.Name="Close">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="{StaticResource TextBody}" VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- Only visible while finalizing / finished -->
            <TextBlock x:Name="HudStage"
                       Text=""
                       FontSize="{StaticResource TextCaption}" Foreground="{DynamicResource MutedForegroundBrush}"
                       Margin="16,4,0,0" TextWrapping="Wrap"
                       MaxWidth="260"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</Window>
