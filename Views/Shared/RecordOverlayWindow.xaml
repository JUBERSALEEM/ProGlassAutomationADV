<Window x:Class="ProGlassAutomation.Views.Shared.RecordOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recording"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowActivated="False"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border x:Name="HudRoot"
            CornerRadius="12"
            Padding="14,10"
            MinWidth="420"
            BorderThickness="1">
        <Border.Background>
            <SolidColorBrush Color="#E6101824"/>
        </Border.Background>
        <Border.BorderBrush>
            <SolidColorBrush Color="#66FFFFFF"/>
        </Border.BorderBrush>
        <StackPanel>
            <DockPanel LastChildFill="True">
                <Ellipse x:Name="HudDot" DockPanel.Dock="Left"
                         Width="10" Height="10" Margin="0,0,8,0"
                         VerticalAlignment="Center" Fill="#EF4444"/>
                <TextBlock x:Name="HudBadge" DockPanel.Dock="Left"
                           Text="REC" FontSize="13" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button x:Name="HudPause" Content="PAUSE"
                            Click="Pause_Click" Cursor="Hand"
                            FontSize="11" FontWeight="SemiBold"
                            Padding="12,4" MinWidth="72" Margin="0,0,6,0"
                            Foreground="White" Background="#334155" BorderThickness="0"/>
                    <Button x:Name="HudStop" Content="STOP"
                            Click="Stop_Click" Cursor="Hand"
                            FontSize="11" FontWeight="SemiBold"
                            Padding="12,4" MinWidth="72"
                            Foreground="White" Background="#DC2626" BorderThickness="0"/>
                </StackPanel>
                <TextBlock x:Name="HudTime" Text="00:00.0"
                           FontSize="18" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="HudStats"
                       Text="0 frames · 0 dropped · live encode"
                       FontSize="11" Foreground="#CBD5E1" Margin="0,6,0,0"/>
            <TextBlock x:Name="HudAudio"
                       Text="Internal …  Mic …"
                       FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
            <Grid Margin="0,8,0,0">
                <Border Height="6" CornerRadius="3" Background="#334155"/>
                <Border x:Name="HudBar" Height="6" CornerRadius="3"
                        Background="#22C55E" HorizontalAlignment="Left" Width="0"/>
            </Grid>
            <TextBlock x:Name="HudStage"
                       Text=""
                       FontSize="11" Foreground="#E2E8F0" Margin="0,6,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
