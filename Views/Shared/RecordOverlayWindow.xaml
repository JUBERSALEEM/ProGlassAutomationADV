<Window x:Class="ProGlassAutomation.Views.Shared.RecordOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recording"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowActivated="False"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
      Compact Android-recorder style HUD.

      Layout (single pill, left → right):
        ● REC   12:34   [⏸] [⏹]

      - Time sits on the LEFT, followed by two small square controls
        (pause, stop) — exactly the "time · pause · stop" trio of a phone
        screen recorder. The close button only appears when the recording
        has finished (SAVED / FAILED) so the user can dismiss the HUD.
      - The stats / audio / progress-bar / stage rows that made the old HUD
        ~3× taller are gone. A single status line appears only while the
        recording is finalizing or after it finishes.
    -->
    <Border x:Name="HudRoot"
            CornerRadius="999"
            Padding="12,6"
            BorderThickness="1">
        <Border.Background>
            <SolidColorBrush Color="#E6101824"/>
        </Border.Background>
        <Border.BorderBrush>
            <SolidColorBrush Color="#55FFFFFF"/>
        </Border.BorderBrush>

        <StackPanel>
            <DockPanel LastChildFill="False">
                <Ellipse x:Name="HudDot" DockPanel.Dock="Left"
                         Width="10" Height="10" Margin="0,0,10,0"
                         VerticalAlignment="Center" Fill="#EF4444"/>

                <TextBlock x:Name="HudBadge" DockPanel.Dock="Left"
                           Text="REC" FontSize="11" FontWeight="Bold"
                           Foreground="#FCA5A5" VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                <TextBlock x:Name="HudTime" DockPanel.Dock="Left"
                           Text="00:00" FontSize="20" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"
                           MinWidth="72" TextAlignment="Right"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="14,0,0,0">
                    <!-- Pause / Resume — ⏸ ▶ (Segoe MDL2) -->
                    <Button x:Name="HudPause"
                            Click="Pause_Click" Cursor="Hand"
                            Width="40" Height="40" Margin="0,0,6,0"
                            Foreground="White" Background="#334155"
                            BorderThickness="0" FontFamily="Segoe MDL2 Assets"
                            FontSize="16" Padding="0" VerticalContentAlignment="Center"
                            HorizontalContentAlignment="Center"
                            AutomationProperties.Name="Pause or resume recording">
                        <TextBlock Text="&#xE769;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="16" VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                    <!-- Stop — ⏹ (Segoe MDL2) -->
                    <Button x:Name="HudStop"
                            Click="Stop_Click" Cursor="Hand"
                            Width="40" Height="40" Margin="0,0,6,0"
                            Foreground="White" Background="#DC2626"
                            BorderThickness="0" FontFamily="Segoe MDL2 Assets"
                            FontSize="16" Padding="0" VerticalContentAlignment="Center"
                            HorizontalContentAlignment="Center"
                            AutomationProperties.Name="Stop and save recording">
                        <TextBlock x:Name="HudStopGlyph" Text="&#xE71A;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <!-- Dismiss after SAVED / FAILED -->
                    <Button x:Name="HudClose"
                            Click="Close_Click" Cursor="Hand"
                            Width="40" Height="40"
                            Foreground="White" Background="#475569"
                            BorderThickness="0" FontFamily="Segoe MDL2 Assets"
                            FontSize="16" Padding="0" VerticalContentAlignment="Center"
                            HorizontalContentAlignment="Center"
                            Visibility="Collapsed"
                            AutomationProperties.Name="Close">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- Only visible while finalizing / finished -->
            <TextBlock x:Name="HudStage"
                       Text=""
                       FontSize="11" Foreground="#CBD5E1"
                       Margin="22,6,0,0" TextWrapping="Wrap"
                       MaxWidth="300"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</Window>
