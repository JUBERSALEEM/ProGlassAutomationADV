<Window x:Class="ProGlassAutomation.Views.Shared.RecordOverlayWindow"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recording"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowActivated="False"
        FontFamily="{DynamicResource AppFontFamily}"
        FontWeight="{DynamicResource AppFontWeight}"
        FontStyle="{DynamicResource AppFontStyle}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Matches the app's rounded action buttons: CardCornerRadius (12). -->
        <Style x:Key="HudButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
      Compact recording card — same 12px card shape as the app's other
      top-bar cards (date/time, agent, connectivity), not a pill.

      Layout (single card, left → right):
        ● REC   12:34   [⏸] [⏹]

      - Time sits on the LEFT, followed by two small square controls
        (pause, stop) — the "time · pause · stop" trio of a phone screen
        recorder. The close button only appears when the recording has
        finished (SAVED / FAILED) so the user can dismiss the card.
      - A single status line appears only while the recording is finalizing
        or after it finishes.
    -->
    <Border x:Name="HudRoot"
            CornerRadius="{DynamicResource CardCornerRadius}"
            Padding="14,10"
            BorderThickness="1"
            BorderBrush="#4DFFFFFF"
            Cursor="SizeAll"
            ToolTip="Drag to move the recorder"
            MouseLeftButtonDown="HudDrag_MouseLeftButtonDown">
        <Border.Background>
            <SolidColorBrush Color="#E6101824"/>
        </Border.Background>

        <StackPanel>
            <DockPanel LastChildFill="False">
                <Ellipse x:Name="HudDot" DockPanel.Dock="Left"
                         Width="10" Height="10" Margin="0,0,10,0"
                         VerticalAlignment="Center" Fill="#EF4444"/>

                <TextBlock x:Name="HudBadge" DockPanel.Dock="Left"
                           Text="REC" FontSize="11" FontWeight="Bold"
                           Foreground="#FCA5A5" VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                <TextBlock x:Name="HudTime" DockPanel.Dock="Left"
                           Text="00:00" FontSize="20" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"
                           MinWidth="72" TextAlignment="Right"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="14,0,0,0">
                    <!-- Pause / Resume — ⏸ ▶ (Segoe MDL2) -->
                    <Button x:Name="HudPause"
                            Style="{StaticResource HudButtonStyle}"
                            Click="Pause_Click"
                            Margin="0,0,6,0"
                            Background="#334155"
                            AutomationProperties.Name="Pause or resume recording">
                        <TextBlock Text="&#xE769;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="15" VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                    <!-- Stop — ⏹ (Segoe MDL2) -->
                    <Button x:Name="HudStop"
                            Style="{StaticResource HudButtonStyle}"
                            Click="Stop_Click"
                            Margin="0,0,6,0"
                            Background="#DC2626"
                            AutomationProperties.Name="Stop and save recording">
                        <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="15" VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                    <!-- Dismiss after SAVED / FAILED -->
                    <Button x:Name="HudClose"
                            Style="{StaticResource HudButtonStyle}"
                            Click="Close_Click"
                            Background="#475569"
                            Visibility="Collapsed"
                            AutomationProperties.Name="Close">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="13" VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- Only visible while finalizing / finished -->
            <TextBlock x:Name="HudStage"
                       Text=""
                       FontSize="11" Foreground="#CBD5E1"
                       Margin="22,6,0,0" TextWrapping="Wrap"
                       MaxWidth="300"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</Window>
