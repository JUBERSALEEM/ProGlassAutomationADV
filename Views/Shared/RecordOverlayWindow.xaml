<Window x:Class="ProGlassAutomation.Views.Shared.RecordOverlayWindow"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Shared.Recording}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowActivated="False"
        FontFamily="{DynamicResource AppFontFamily}"
        FontWeight="{DynamicResource AppFontWeight}"
        FontStyle="{DynamicResource AppFontStyle}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Matches the app's rounded action buttons: CardCornerRadius (12). -->
        <!-- Compact HUD buttons (Aug 2026 senior audit: user asked to
             make the recorder smaller). Was 38x38; shrunk to 28x28
             with tighter padding for a more phone-like recorder pill. -->
        <Style x:Key="HudButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                SnapsToDevicePixels="True" Style="{StaticResource SurfacePrimaryStyle}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
      Compact recording card — same 12px card shape as the app's other
      top-bar cards (date/time, agent, connectivity), not a pill.

      Layout (single card, left → right):
        ● REC   12:34   [⏸] [⏹]

      - Time sits on the LEFT, followed by two small square controls
        (pause, stop) — the "time · pause · stop" trio of a phone screen
        recorder. The close button only appears when the recording has
        finished (SAVED / FAILED) so the user can dismiss the card.
      - A single status line appears only while the recording is finalizing
        or after it finishes.
    -->
    <Border
            CornerRadius="{DynamicResource CardCornerRadius}"
            Padding="10,6"
            BorderThickness="{DynamicResource Border.HairlineThickness}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            Cursor="SizeAll"
            ToolTip="{DynamicResource Shared.DragMoveRecorder}"
            MouseLeftButtonDown="HudDrag_MouseLeftButtonDown" Style="{StaticResource SurfacePrimaryStyle}">
        <Border.Background>
            <SolidColorBrush Color="{DynamicResource LiquidOverlayColor}"/>
        </Border.Background>

        <StackPanel>
            <DockPanel LastChildFill="False">
                <Ellipse DockPanel.Dock="Left"
                         Width="8" Height="8" Margin="0,0,8,0"
                         VerticalAlignment="Center" Fill="{Binding DotBrush}"/>

                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding BadgeText}" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                           Foreground="{Binding BadgeBrush}" VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding TimeText}" FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}"
                           Foreground="{DynamicResource OnAccentForegroundBrush}" VerticalAlignment="Center"
                           MinWidth="52" TextAlignment="Right"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="10,0,0,0">
                    <!-- Pause / Resume — ⏸ ▶ (Segoe MDL2) -->
                    <Button
                            Style="{StaticResource Button.Ghost}"
                            Command="{Binding PauseCommand}"
                            Margin="0,0,4,0"
                            Visibility="{Binding PauseVisibility}"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            AutomationProperties.Name="Pause or resume recording">
                        <TextBlock Text="{Binding PauseGlyph}" FontFamily="{DynamicResource FontFamily.Icon}"
                                   FontSize="{DynamicResource FontSize.Body}" VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                    <!-- Stop — ⏹ (Segoe MDL2) -->
                    <Button
                            Style="{StaticResource Button.Ghost}"
                            Command="{Binding StopCommand}"
                            Margin="0,0,4,0"
                            Visibility="{Binding StopVisibility}"
                            IsEnabled="{Binding IsStopEnabled}"
                            Background="{DynamicResource DangerBrush}"
                            AutomationProperties.Name="Stop and save recording">
                        <TextBlock Text="&#xE71A;" FontFamily="{DynamicResource FontFamily.Icon}"
                                   FontSize="{DynamicResource FontSize.Body}" VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                    <!-- Open folder — visible after SAVED (Aug 2026 fix) -->
                    <Button
                            Style="{StaticResource Button.Ghost}"
                            Command="{Binding OpenFolderCommand}"
                            Margin="0,0,4,0"
                            Background="{DynamicResource AccentBrush}"
                            Visibility="{Binding OpenFolderVisibility}"
                            ToolTip="{DynamicResource Shared.OpenFolderWhereVideoSaved}"
                            AutomationProperties.Name="Open recording folder">
                        <TextBlock Text="&#xE8DA;" FontFamily="{DynamicResource FontFamily.Icon}"
                                   FontSize="{DynamicResource FontSize.Body}" VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                    <!-- Dismiss after SAVED / FAILED -->
                    <Button
                            Style="{StaticResource Button.Ghost}"
                            Command="{Binding CloseCommand}"
                            Background="{DynamicResource SurfacePrimaryBrush}"
                            Visibility="{Binding CloseVisibility}"
                            AutomationProperties.Name="Close">
                        <TextBlock Text="&#xE711;" FontFamily="{DynamicResource FontFamily.Icon}"
                                   FontSize="{DynamicResource FontSize.Body}" VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- Only visible while finalizing / finished -->
            <TextBlock
                       Text="{Binding StageText}"
                       FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextTertiaryBrush}"
                       Margin="16,4,0,0" TextWrapping="Wrap"
                       MaxWidth="260"
                       Visibility="{Binding StageVisibility}"/>
        </StackPanel>
    </Border>
</Window>
