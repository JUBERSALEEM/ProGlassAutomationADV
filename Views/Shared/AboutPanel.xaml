<UserControl x:Class="ProGlassAutomation.Views.Shared.AboutPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Border Width="320" CornerRadius="14"
            Background="{DynamicResource ModuleBackgroundBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="3"
                              Opacity="0.18" Color="#000000" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource AccentBrush}"
                    CornerRadius="14,14,0,0"
                    Padding="18,14">
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="10"
                            Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="PG" FontSize="15" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="ProGlass Automation"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="v2.0"
                                   FontSize="10" Foreground="White"
                                   Opacity="0.85" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="18,14,18,16">
                <TextBlock x:Name="VersionText"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                <TextBlock x:Name="DeveloperText"
                           FontSize="11" Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <TextBlock x:Name="CopyrightText"
                           FontSize="10" Margin="0,8,0,0"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           TextWrapping="Wrap"/>

                <!-- Screenshot capture -->
                <Border Margin="0,14,0,0"
                        Padding="12,10"
                        CornerRadius="10"
                        Background="{DynamicResource MenuHoverBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        SnapsToDevicePixels="True">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Capture Screenshot"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="CaptureMenuButton"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource PrimaryPillButton}"
                                    MinWidth="110"
                                    Click="CaptureMenuButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEB9F;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="11"
                                               Foreground="White"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <TextBlock Text="Capture"
                                               FontFamily="Segoe UI"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="CaptureStatus"
                                   FontSize="10"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
