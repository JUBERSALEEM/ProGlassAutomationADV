<Window x:Class="ProGlassAutomation.Views.Shared.AuditReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audit Event Report"
        Width="920" Height="680"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                Background="{DynamicResource AccentBrush}"
                Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="COMPLETE AUDIT EVENT REPORT"
                               FontSize="{StaticResource TextTitle}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                    <TextBlock Text="Who changed what, when, why, from where, and what field values changed before/after."
                               Margin="0,3,0,0"
                               FontSize="{StaticResource TextBody}"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                               Opacity="0.84"/>
                </StackPanel>
                <Border Grid.Column="1"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Background="{DynamicResource TintAmberBrush}"
                        Padding="10,5"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding OperationId}"
                               FontSize="{StaticResource TextCaption}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource WarningBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Who/When/What/Why -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,14,0,14">
            <Border Style="{StaticResource SecondarySurfaceCardStyle}" Margin="0,0,8,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="WHO" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock Text="{Binding ActorDisplay}" Margin="0,4,0,0" FontSize="{StaticResource TextBodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Username, StringFormat=Login: {0}}" FontSize="{StaticResource TextCaption}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    <TextBlock Text="{Binding OtherUserNotice}" FontSize="{StaticResource TextCaption}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SecondarySurfaceCardStyle}" Margin="0,0,8,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="WHEN" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock Text="{Binding TimeDisplay}" Margin="0,4,0,0" FontSize="{StaticResource TextBodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding UtcTimeDisplay}" FontSize="{StaticResource TextCaption}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SecondarySurfaceCardStyle}" Margin="0,0,8,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="WHAT" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock Text="{Binding Action}" Margin="0,4,0,0" FontSize="{StaticResource TextBodyLarge}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding EntityLine}" FontSize="{StaticResource TextCaption}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SecondarySurfaceCardStyle}" Padding="12">
                <StackPanel>
                    <TextBlock Text="WHY" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock Text="{Binding WhySummary}" Margin="0,4,0,0" FontSize="{StaticResource TextBody}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <!-- Full narrative -->
            <Border Grid.Column="0" Style="{StaticResource PrimarySurfaceCardStyle}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="AUDIT NARRATIVE" FontSize="{StaticResource TextSection}" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                        <!--
                          Mode=OneWay is required, not decorative. TextBox.Text
                          is one of the handful of dependency properties that
                          binds TwoWay BY DEFAULT, and AuditReportText is a
                          computed get-only property — so WPF threw at binding
                          activation rather than at load:

                              A TwoWay or OneWayToSource binding cannot work on
                              the read-only property 'AuditReportText'
                                                      (ERR-EDBDCD, 2026-09-09)

                          It surfaced ~90s after startup on a window resize,
                          because the binding only activates when the element is
                          laid out. IsReadOnly="True" means the user can never
                          edit this box, so nothing is lost by OneWay.
                        -->
                        <TextBox x:Name="ReportTextBox"
                                 Text="{Binding AuditReportText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource PrimaryForegroundBrush}"
                                 FontSize="{StaticResource TextBody}"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Before/after diff -->
            <Border Grid.Column="2" Style="{StaticResource PrimarySurfaceCardStyle}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="BEFORE / AFTER FIELD CHANGES" FontSize="{StaticResource TextSection}" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <Border Grid.Column="1" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource TintIndigoBrush}" Padding="8,3">
                            <TextBlock Text="{Binding ChangeSummary}" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Text="No field-level before/after details were attached to this audit row. New structured save flows will show exact old and new values here."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   FontSize="{StaticResource TextBody}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Visibility="{Binding HasChanges, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl x:Name="ChangesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="{DynamicResource CardCornerRadius}" BorderBrush="{DynamicResource OutlineBrush}"
                                                BorderThickness="{DynamicResource CardBorderThickness}" Margin="0,0,0,8" Padding="10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Field}" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                <Grid Grid.Row="1" Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{DynamicResource TintRedBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="8">
                                                        <StackPanel>
                                                            <TextBlock Text="BEFORE" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                                                            <TextBlock Text="{Binding Before}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="2" Background="{DynamicResource TintGreenBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="8">
                                                        <StackPanel>
                                                            <TextBlock Text="AFTER" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                                            <TextBlock Text="{Binding After}" TextWrapping="Wrap" Foreground="{DynamicResource SuccessBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!--
          Height="Auto" with a MinHeight is the fix for clipped button text,
          and it is worth explaining because the mistake is easy to repeat.

          Both pill styles set Height="{DynamicResource DensityButtonHeight}"
          — a FIXED 32px — and pair it with Padding="22,0". The zero vertical
          padding is not an oversight; it is required, because the height is
          already fixed. These two buttons overrode the padding to "18,8"
          without overriding the height, so 16 of the 32 pixels went to padding
          and the label had 16 left for a ~14px font. The text clipped.

          Auto-sizing with a MinHeight means the button is never shorter than
          any other button in the app, and grows instead of clipping when a
          localised label is longer than the English one.
        -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Copy report" Height="Auto" MinHeight="{DynamicResource DensityButtonHeight}" Padding="18,8" Margin="0,0,8,0" Style="{StaticResource OutlinedPillButton}" Click="CopyReport_Click"/>
            <Button Content="Close" Height="Auto" MinHeight="{DynamicResource DensityButtonHeight}" Padding="22,8" Style="{StaticResource PrimaryPillButton}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
