<UserControl x:Class="ProGlassAutomation.Views.Shared.ScreenRecordPanel"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Border Width="340" CornerRadius="{DynamicResource CardCornerRadiusLarge}"
            Background="{DynamicResource ShellGlassBrush}"
            BorderBrush="{DynamicResource ShellGlassBorderBrush}"
            BorderThickness="1"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="3"
                              Opacity="0.18" Color="#000000" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource AccentBrush}"

                    Padding="16,12">
                <StackPanel>
                    <TextBlock Text="Screen recording"
                               FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                    <TextBlock Text="This app window only — not the desktop"
                               FontSize="10"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                               Opacity="0.85" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="14,12,14,14">
                <TextBlock Text="Quality"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Qualities}"
                          SelectedItem="{Binding SelectedQuality, Mode=TwoWay}"
                          DisplayMemberPath="Title"
                          IsEnabled="{Binding IsIdle}"
                          IsSynchronizedWithCurrentItem="False"
                          Padding="10,7"
                          FontSize="13"/>

                <TextBlock Text="Frame rate"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Margin="0,12,0,4"/>
                <ComboBox ItemsSource="{Binding FpsChoices}"
                          SelectedItem="{Binding SelectedFps, Mode=TwoWay}"
                          DisplayMemberPath="Title"
                          IsEnabled="{Binding IsIdle}"
                          IsSynchronizedWithCurrentItem="False"
                          Padding="10,7"
                          FontSize="13"/>

                <DockPanel Margin="0,14,0,0">
                    <TextBlock Text="Internal audio"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               VerticalAlignment="Center"/>
                    <CheckBox HorizontalAlignment="Right"
                              IsChecked="{Binding CaptureLiveAudio, Mode=TwoWay}"
                              IsEnabled="{Binding IsIdle}"
                              VerticalAlignment="Center"/>
                </DockPanel>
                <DockPanel Margin="0,10,0,0">
                    <TextBlock Text="Microphone"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               VerticalAlignment="Center"/>
                    <CheckBox HorizontalAlignment="Right"
                              IsChecked="{Binding CaptureMicrophone, Mode=TwoWay}"
                              IsEnabled="{Binding IsIdle}"
                              VerticalAlignment="Center"/>
                </DockPanel>

                <TextBlock Text="{Binding Hint}"
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"/>

                <WrapPanel Margin="0,14,0,0">
                    <Button Content="START"
                            Command="{Binding StartCommand}"
                            AutomationProperties.AutomationId="ScreenRecord.Start"
                            MinWidth="96" Height="32" Padding="14,0"
                            Margin="0,0,8,8" Cursor="Hand"
                            FontSize="12" FontWeight="SemiBold"
                            Foreground="{DynamicResource OnAccentForegroundBrush}"
                            Background="{DynamicResource AccentBrush}"
                            BorderThickness="0"
                            Visibility="{Binding IsIdle,
                                Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="PAUSE / RESUME"
                            Command="{Binding PauseCommand}"
                            MinWidth="120" Height="32" Padding="14,0"
                            Margin="0,0,8,8" Cursor="Hand"
                            FontSize="12" FontWeight="SemiBold"
                            Foreground="{DynamicResource PrimaryForegroundBrush}"
                            Background="{DynamicResource MenuHoverBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Visibility="{Binding IsRecording,
                                Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="STOP &amp; SAVE"
                            Command="{Binding StopCommand}"
                            AutomationProperties.AutomationId="ScreenRecord.Stop"
                            MinWidth="120" Height="32" Padding="14,0"
                            Margin="0,0,8,8" Cursor="Hand"
                            FontSize="12" FontWeight="SemiBold"
                            Foreground="{DynamicResource OnAccentForegroundBrush}"
                            Background="{DynamicResource DangerBrush}"
                            BorderThickness="0"
                            Visibility="{Binding IsRecording,
                                Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="OPEN FOLDER"
                            Command="{Binding OpenOutputCommand}"
                            MinWidth="110" Height="32" Padding="14,0"
                            Margin="0,0,0,8" Cursor="Hand"
                            FontSize="12" FontWeight="SemiBold"
                            Foreground="{DynamicResource PrimaryForegroundBrush}"
                            Background="{DynamicResource MenuHoverBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"/>
                </WrapPanel>

                <TextBlock Text="{Binding Status}"
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
                <TextBlock Text="{Binding LastMp4Text}"
                           FontSize="10"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
