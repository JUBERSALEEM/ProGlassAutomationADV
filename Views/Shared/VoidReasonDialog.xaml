<Window x:Class="ProGlassAutomation.Views.Shared.VoidReasonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Void.Title}"
        Width="540"
        Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
            Background="{DynamicResource ModuleBackgroundBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="{DynamicResource CardBorderThickness}"
            Margin="24,20,24,28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0"
                              Opacity="0.25" Color="{DynamicResource LiquidShadowColor}"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Drag header -->
            <Grid Grid.Row="0" Height="44" MouseLeftButtonDown="OnHeaderMouseDown">
                <Border Background="Transparent"/>
            </Grid>

            <!-- Header: icon + title -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="28,0,28,16">
                <Border Width="44" Height="44"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Margin="0,0,14,0"
                        Background="{DynamicResource TintRedBrush}">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                               FontSize="{StaticResource TextHeadline}"
                               Foreground="{DynamicResource DangerBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Void.Title}"
                               FontSize="{StaticResource TextTitleLarge}" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="{Binding DocumentLabel}"
                               FontSize="{StaticResource TextBody}"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Reason input -->
            <Grid Grid.Row="2" Margin="28,0,28,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{DynamicResource Void.ReasonLabel}"
                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                           Margin="2,0,0,6"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <Border Grid.Row="1"
                        Background="{DynamicResource WindowBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource ControlCornerRadius}">
                    <TextBox x:Name="ReasonTextBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="12,10"
                             FontSize="{StaticResource TextSection}"
                             Foreground="{DynamicResource PrimaryForegroundBrush}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Text="{Binding Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </Border>
            </Grid>

            <!-- Validation hint -->
            <TextBlock Grid.Row="3"
                       Text="{DynamicResource Void.ReasonRequired}"
                       Margin="30,8,28,0"
                       FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                       Foreground="{DynamicResource DangerBrush}"
                       Visibility="{Binding ValidationVisibility}"/>

            <!-- Buttons -->
            <Border Grid.Row="4"
                    Background="{DynamicResource MenuHoverBrush}"
                    CornerRadius="{DynamicResource Radius.Bottom.Medium}"
                    Padding="24,16"
                    Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource OutlinedPillButton}"
                            Tag="&#xE711;" Content="{DynamicResource Action.Cancel}"
                            Margin="0,0,10,0"
                            Command="{Binding CancelCommand}"
                            IsCancel="True"/>
                    <Button Style="{StaticResource PrimaryPillButton}"
                            Tag="&#xE7BA;" Content="{DynamicResource Void.ConfirmButton}"
                            Command="{Binding ConfirmCommand}"
                            IsDefault="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
