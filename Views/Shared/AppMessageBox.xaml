<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Shared/AppMessageBox.xaml
     PROJECT: ProGlassAutomation
     MODULE: One professional dialog shell for the whole app

     2026-09-09 (owner defect): every "quick message" in the product was a
     Windows OS chrome MessageBox — tiny, unthemed, unprofessional and
     visibly foreign next to the themed UI. This shell replaces it: the
     same semantics as MessageBox.Show (buttons / icons / default result /
     DialogResult mapping), rendered as a proper product surface —
     theme-bound card, tinted severity chip, wrapped body, accent action.

     CONTRACT (kept byte-identical for callers):
       AppMessageBox.ShowBox(owner, message, caption, buttons, icon,
         defaultResult) → MessageBoxResult
       — same inputs, same outputs as MessageBox.Show.

     DESIGN INVARIANTS (pins in Tests/Agent/AppMessageBoxSourceTests.cs):
       • NOT a marketing card: information-first, restrained chrome,
         16px root radius (CardCornerRadiusLarge), 1px Outline border.
       • Severity is ONE tinted chip + glyph; never a colored background
         fill on the whole dialog (the 90s-error-window look).
       • Buttons: accent for the affirmative/default action, ghost for
         the dismiss/deny actions — one eye-level on the right.
       • Esc behaves like the OS box (Cancel if offered else does
         nothing for Yes/No per MessageBox semantics), IsDefault=
         affirmative on the affirmative button.
═══════════════════════════════════════════════════════════════════════ -->
<Window x:Class="ProGlassAutomation.Views.Shared.AppMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        MinWidth="400"
        MaxWidth="580"
        FontFamily="{DynamicResource AppFontFamily}"
        FontWeight="{DynamicResource AppFontWeight}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown"
        Title="AppMessageBox">

    <Window.Resources>
        <!-- Affirmative action (accent) -->
        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="Black" BlurRadius="12"
                                                          ShadowDepth="0" Opacity="0.35"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dismiss action (ghost) -->
        <Style x:Key="GhostActionButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="Transparent"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer margin carries the soft elevation shadow -->
    <Border Margin="18">
        <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1"
                Padding="24,20,24,20"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="24"
                                  ShadowDepth="0" Opacity="0.45"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Severity chip + title -->
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Width="40" Height="40"
                            CornerRadius="12"
                            Padding="0"
                            Background="{Binding IconTint, RelativeSource={RelativeSource AncestorType=Window}}"
                            SnapsToDevicePixels="True">
                        <TextBlock Text="{Binding IconGlyph, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="19"
                                   Foreground="{Binding IconBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Row="0"
                               Text="{Binding Caption, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="{StaticResource TextSection}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"
                               TextWrapping="Wrap"
                               MaxWidth="470"/>
                </StackPanel>

                <!-- Body -->
                <ScrollViewer Grid.Row="1"
                              MaxHeight="280"
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,14,0,0">
                    <TextBlock Text="{Binding BodyText, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="{StaticResource TextBody}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               TextWrapping="Wrap"
                               LineHeight="19"
                               MaxWidth="500"/>
                </ScrollViewer>

                <!-- Actions -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">
                    <Button x:Name="OkButton"
                            Style="{StaticResource PrimaryActionButton}"
                            Content="{DynamicResource Action.OK}"
                            IsDefault="True"
                            Click="OnOk"/>
                    <Button x:Name="YesButton"
                            Style="{StaticResource PrimaryActionButton}"
                            Content="{DynamicResource Action.Yes}"
                            IsDefault="True"
                            Margin="8,0,0,0"
                            Click="OnYes"/>
                    <Button x:Name="NoButton"
                            Style="{StaticResource GhostActionButton}"
                            Content="{DynamicResource Action.No}"
                            IsCancel="False"
                            Margin="8,0,0,0"
                            Click="OnNo"/>
                    <Button x:Name="CancelButton"
                            Style="{StaticResource GhostActionButton}"
                            Content="{DynamicResource Action.Cancel}"
                            IsCancel="True"
                            Margin="8,0,0,0"
                            Click="OnCancel"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
