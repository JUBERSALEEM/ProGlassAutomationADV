<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Shared/ComingSoonView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Shared — placeholder hero for not-yet-built modules

     Rendered by the 9 placeholder modules (Optimization + 8 Production
     stages). A full-page hero — not a bounding card — so it reads as a
     deliberate "under construction" landing rather than an empty list.

     Phase 5 upgrades:
       • R2  — SnapsToDevicePixels / UseLayoutRounding / ClearType +
               Fixed hinting added (was soft/blurry).
       • D3  — icon now Segoe MDL2 Assets (ViewModels return the
               canonical glyphs matching AboutView's production stages).
       • C4  — glyph/pill text use OnAccentForegroundBrush, not white.
       • C5  — accent gradient tile follows AccentColor/AccentDarkColor.
     Theme-correct throughout: no hardcoded colours.
═══════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.Shared.ComingSoonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Background="Transparent">

        <!-- Ambient accent wash behind the hero, so the placeholder sits
             on the same soft tinted stage as the dashboards (theme-aware). -->
        <Border
                Opacity="0.5"
                IsHitTestVisible="False"/>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="560"
                    SnapsToDevicePixels="True">

            <!-- ══ Accent icon badge ═════════════════════════════════ -->
            <Border Width="96" Height="96"
                    CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                    HorizontalAlignment="Center"
                    SnapsToDevicePixels="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource AccentDarkColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22"
                                      ShadowDepth="5"
                                      Opacity="0.30"
                                      Color="{DynamicResource LiquidShadowColor}"/>
                </Border.Effect>
                <TextBlock Text="{Binding Icon}"
                           FontFamily="{DynamicResource FontFamily.Icon}"
                           FontSize="{DynamicResource FontSize.Display}"
                           Foreground="{DynamicResource OnAccentForegroundBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Border>

            <!-- ══ Status chip (badge above the heading) ══════════════ -->
            <Border Background="{DynamicResource TintIndigoBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Padding="14,6"
                    HorizontalAlignment="Center"
                    Margin="0,24,0,0"
                    SnapsToDevicePixels="True" Style="{StaticResource SurfacePrimaryStyle}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7"
                             Fill="{DynamicResource AccentBrush}"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False"/>
                    <TextBlock Text="{DynamicResource Shared.ComingSOON}"
                               FontSize="{DynamicResource FontSize.BodySmall}"
                               FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </StackPanel>
            </Border>

            <!-- ══ Module name ════════════════════════════════════════ -->
            <TextBlock Text="{Binding ModuleName}"
                       FontSize="{DynamicResource FontSize.Display}"
                       FontWeight="{DynamicResource Weight.Bold}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,18,0,0"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <!-- ══ Description ════════════════════════════════════════ -->
            <TextBlock Text="{Binding Description}"
                       FontSize="{DynamicResource FontSize.Title}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       MaxWidth="460"
                       Margin="0,10,0,0"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>

            <!-- ══ Roadmap hint ═══════════════════════════════════════ -->
            <TextBlock Text="{DynamicResource Shared.ModuleDevelopmentAvailableUpcomingRelease}"
                       FontSize="{DynamicResource FontSize.Body}"
                       FontStyle="Italic"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,24,0,0"
                       Foreground="{DynamicResource TextTertiaryBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
