<!-- Per-section audit register. Same row contract as the proforma invoice list.
     Bindings, refresh, diff and report commands are unchanged. -->
<UserControl x:Class="ProGlassAutomation.Views.Shared.SectionActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="{DynamicResource Ov.Canvas}"
             Foreground="{DynamicResource Ov.Ink}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Lists/StudioListResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Sl.FilterBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Section" Style="{StaticResource Sl.Label}"/>
                    <TextBlock Text="{Binding Section, Mode=OneWay}" Style="{StaticResource Sl.Value}" FontSize="18"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource Sl.PrimaryButton}"
                        Command="{Binding RefreshCommand}"
                        Tag="&#xE72C;"
                        Content="{DynamicResource Action.Refresh}"
                        ToolTip="Reload activity feed"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Sl.Card}" Padding="0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False" x:Name="ActivityViewport">
                <Grid MinWidth="1100" Width="{Binding ViewportWidth, ElementName=ActivityViewport, Converter={StaticResource Sl.Extent}}" Height="{Binding ViewportHeight, ElementName=ActivityViewport, Converter={StaticResource Sl.Extent}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Sl.TableHeader}" Margin="{Binding Source={x:Static SystemParameters.VerticalScrollBarWidth}, Converter={StaticResource Sl.Gutter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="When" Style="{StaticResource Sl.ColumnLabel}" Margin="12,0"/>
                            <TextBlock Grid.Column="2" Text="Who" Style="{StaticResource Sl.ColumnLabel}" Margin="12,0"/>
                            <TextBlock Grid.Column="3" Text="What" Style="{StaticResource Sl.ColumnLabel}" Margin="12,0"/>
                            <TextBlock Grid.Column="4" Text="Details" Style="{StaticResource Sl.ColumnLabel}" Margin="12,0"/>
                            <TextBlock Grid.Column="5" Text="{DynamicResource Common.Actions}" Style="{StaticResource Sl.ColumnLabel}" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <Border Panel.ZIndex="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <emptyState:EmptyStateControl Icon="&#xE81C;"
                                                           Title="No audit activity recorded yet"
                                                           Message="User actions in this section will appear here instantly."/>
                        </Border>
                        <ListBox Panel.ZIndex="0"
                                 ItemsSource="{Binding Rows}"
                                 ItemContainerStyle="{StaticResource Sl.ListItem}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingStackPanel.ScrollUnit="Pixel"
                                 behaviors:SmoothScrollBehavior.IsEnabled="True">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Sl.Row}" MinHeight="62" ToolTip="{Binding RowTooltip}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3"/>
                                                <ColumnDefinition Width="190"/>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="190"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="170"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Ov.Accent}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOtherUser}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource Ov.Warning}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource Ov.Success}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,8">
                                                <TextBlock Text="{Binding TimeDisplay}" FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource Ov.Ink}" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular"/>
                                                <TextBlock Text="{Binding UtcTimeDisplay}" Foreground="{DynamicResource Ov.Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,8">
                                                <TextBlock Text="{Binding ActorDisplay}" FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource Ov.Ink}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Username, StringFormat=login: {0}}" Foreground="{DynamicResource Ov.Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding OtherUserNotice}" Foreground="{DynamicResource Ov.Warning}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="12,8">
                                                <TextBlock Text="{Binding Action}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.Accent}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding EntityLine}" Foreground="{DynamicResource Ov.Muted}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="12,8">
                                                <TextBlock Text="{Binding Details}" Foreground="{DynamicResource Ov.Ink}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}"/>
                                                <TextBlock Text="{Binding WhySummary, StringFormat=Why: {0}}" Foreground="{DynamicResource Ov.Accent}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding WhySummary}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasReason}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding ChangeSummary}" Foreground="{DynamicResource Ov.Muted}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Content="Diff"
                                                        Style="{StaticResource Sl.Button}"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding DataContext.ShowChangesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <Button Content="Report"
                                                        Style="{StaticResource Sl.PrimaryButton}"
                                                        Command="{Binding DataContext.ShowAuditReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
