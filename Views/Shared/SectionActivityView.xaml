<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Shared/SectionActivityView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Shared — per-section Activity tab

     Renders the live audit feed for one section. DataContext must be
     a SectionActivityViewModel. Used inside the module tab strips
     (Delivery Note / Job Order / Tax Invoice) so each section shows
     its own user-action history, updating live as actions happen.
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.Shared.SectionActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Margin="20">

        <!-- Fade-in uses the hardware-scaled motion token: snappier on
             120/144/165 Hz panels, calmer on 60 Hz (PerformanceProfileService). -->
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1"
                                         Duration="{DynamicResource MotionDurationNorm}"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ HEADER ═════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}">
                    <Run Text="📜  Activity — "/>
                    <Run Text="{Binding Section, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="Every user action in this section, recorded by the audit system"
                           FontSize="12" Margin="0,2,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Command="{Binding RefreshCommand}"
                    Cursor="Hand"
                    Padding="16,9"
                    BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource AccentBrush}"
                                CornerRadius="{DynamicResource PillCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="↻  Refresh"
                           Foreground="White"
                           FontSize="13" FontWeight="SemiBold"/>
            </Button>
        </Grid>

        <!-- ══ FEED ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                CornerRadius="{DynamicResource CardCornerRadius}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource ModuleBackgroundBrush}"
                ClipToBounds="True">

            <Grid>
                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="🕓"
                               FontSize="36"
                               HorizontalAlignment="Center"
                               Opacity="0.6"/>
                    <TextBlock Text="No activity recorded yet"
                               FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,3"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="Actions you take in this section will appear here instantly."
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>

                <!-- Rows -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,10"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding TimeDisplay}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   VerticalAlignment="Center"/>

                                        <Border Grid.Column="1"
                                                Background="{DynamicResource TintIndigoBrush}"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Padding="8,3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Action}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>

                                        <TextBlock Grid.Column="2"
                                                   Margin="12,0,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   Text="{Binding Details}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding Details}"/>

                                        <!-- GitHub-style diff viewer -->
                                        <Button Grid.Column="3"
                                                Margin="10,0,0,0"
                                                Content="± Changes"
                                                FontSize="10" FontWeight="Bold"
                                                Padding="9,3"
                                                Cursor="Hand"
                                                BorderThickness="0"
                                                Background="{DynamicResource TintIndigoBrush}"
                                                Foreground="{DynamicResource AccentBrush}"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.ShowChangesCommand,
                                                            RelativeSource={RelativeSource
                                                                AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
