<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Shared/SectionActivityView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Shared — per-section Activity tab

     Renders the live audit feed for one section. DataContext must be
     a SectionActivityViewModel. Used inside the module tab strips
     (Delivery Note / Job Order / Tax Invoice) so each section shows
     its own user-action history, updating live as actions happen.
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.Shared.SectionActivityView"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Margin="20">

        <!-- Fade-in uses the hardware-scaled motion token: snappier on
             120/144/165 Hz panels, calmer on 60 Hz (PerformanceProfileService). -->
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1"
                                         Duration="{DynamicResource MotionDurationNorm}"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ HEADER ═════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets"
                               FontSize="{StaticResource TextTitle}"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               VerticalAlignment="Center">
                        <Run Text="{DynamicResource Shared.Activity}"/>
                        <Run Text="{Binding Section, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
                <TextBlock Text="{DynamicResource Shared.UserActionSectionRecordedAuditSystem}"
                           FontSize="{StaticResource TextBody}" Margin="0,2,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource PrimaryPillButton}"
                    Tag="&#xE72C;" Content="{DynamicResource Action.Refresh}"
                    ToolTip="{DynamicResource Shared.ReloadActivityFeed}"/>
        </Grid>

        <!-- ══ FEED ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="{DynamicResource CardBorderThickness}"
                Background="{DynamicResource ModuleBackgroundBrush}"
                ClipToBounds="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- v2: column headers with tooltips -->
                <Border CornerRadius="{DynamicResource CardCornerRadius}" Grid.Row="0"
                        Background="{DynamicResource AccentBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="{DynamicResource Border.BottomHairlineThickness}"
                        Padding="16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Shared.DATETIME}"
                                   Style="{StaticResource ModuleColumnHeaderStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   ToolTip="{DynamicResource Shared.WhenActionHappened}"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Shared.Action}"
                                   Style="{StaticResource ModuleColumnHeaderStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   ToolTip="{DynamicResource Shared.WhatDone}"/>
                        <TextBlock Grid.Column="2" Text="{DynamicResource Shared.Details}"
                                   Style="{StaticResource ModuleColumnHeaderStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   Margin="12,0,0,0"
                                   ToolTip="{DynamicResource Shared.FullDetailAction}"/>
                        <TextBlock Grid.Column="3" Text="{DynamicResource Reports.StatementGenerator.Diff}"
                                   Style="{StaticResource ModuleColumnHeaderStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   Margin="10,0,0,0"
                                   ToolTip="{DynamicResource Shared.BeforeAfterChangesWhenRecorded}"/>
                    </Grid>
                </Border>

                <!-- Empty state -->
                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets"
                               FontSize="{StaticResource TextDisplayLarge}"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Shared.NoActivityRecordedYet}"
                               FontSize="{StaticResource TextSection}" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,3"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="{DynamicResource Shared.ActionsTakeSectionAppearHereInstantly}"
                               FontSize="{StaticResource TextBody}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>

                <!-- Rows -->
                <!-- Virtualized: stays smooth even with thousands of rows -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                    <ItemsControl ItemsSource="{Binding Rows}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="{DynamicResource CardCornerRadius}" Padding="16,10"
                                        BorderBrush="{DynamicResource OutlineBrush}"
                                        BorderThickness="{DynamicResource Border.BottomHairlineThickness}"
                                        ToolTip="{Binding RowTooltip}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding TimeDisplay}"
                                                   FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{DynamicResource Shared.DateTimeAction}"/>

                                        <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Grid.Column="1"
                                                Background="{DynamicResource TintIndigoBrush}"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Padding="8,3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Action}"
                                                       FontSize="{StaticResource TextBody}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>

                                        <!-- Details + PHASE D "Why" note -->
                                        <StackPanel Grid.Column="2"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock FontSize="{StaticResource TextBody}"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       Text="{Binding Details}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Details}"/>

                                            <!-- The human reason behind the action -->
                                            <TextBlock FontSize="{StaticResource TextBody}"
                                                       FontStyle="Italic"
                                                       Margin="0,3,0,0"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Reason}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasReason}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="{DynamicResource Shared.Why}"/><Run Text="{Binding Reason, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- GitHub-style diff viewer -->
                                        <Button Grid.Column="3"
                                                Margin="10,0,0,0"
                                                Content="{DynamicResource Shared.Changes2}"
                                                FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                Padding="9,3"
                                                Cursor="Hand"
                                                BorderThickness="{DynamicResource Border.NoneThickness}"
                                                Background="{DynamicResource TintIndigoBrush}"
                                                Foreground="{DynamicResource AccentBrush}"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.ShowChangesCommand,
                                                            RelativeSource={RelativeSource
                                                                AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
