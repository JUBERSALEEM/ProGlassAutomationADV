<UserControl x:Class="ProGlassAutomation.Views.Shared.SectionActivityView"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Margin="20">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1"
                                         Duration="{DynamicResource MotionDurationNorm}"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Professional audit header -->
        <Border Grid.Row="0"
                CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                Background="{DynamicResource AccentBrush}"
                Padding="18,14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE81C;" FontFamily="{DynamicResource FontFamily.Icon}"
                                   FontSize="{DynamicResource FontSize.H2}"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock FontSize="{DynamicResource FontSize.H2}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   VerticalAlignment="Center">
                            <Run Text="AUDIT TRAIL · "/>
                            <Run Text="{Binding Section, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="Who did what, when, why, from which session/workstation, with before/after values when captured."
                               FontSize="{DynamicResource FontSize.Body}" Margin="0,3,0,0"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                               Opacity="0.84"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource OutlinedPillButton}"
                        Tag="&#xE72C;" Content="Refresh"
                        ToolTip="Reload activity feed"/>
            </Grid>
        </Border>

        <!-- Feed -->
        <Border Grid.Row="1"
                CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="{DynamicResource CardBorderThickness}"
                Background="{DynamicResource SurfacePrimaryBrush}"
                ClipToBounds="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Column headers -->
                <Border Grid.Row="0"
                        Background="{DynamicResource Surface.Secondary.BackgroundBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="{DynamicResource Border.BottomHairlineThickness}"
                        Padding="16,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="WHEN" Style="{StaticResource ModuleColumnHeaderStyle}" ToolTip="Local time and UTC time are available in the report."/>
                        <TextBlock Grid.Column="1" Text="WHO" Style="{StaticResource ModuleColumnHeaderStyle}" ToolTip="Display name, login and role."/>
                        <TextBlock Grid.Column="2" Text="WHAT / RECORD" Style="{StaticResource ModuleColumnHeaderStyle}" ToolTip="Action and entity id."/>
                        <TextBlock Grid.Column="3" Text="DETAILS / WHY / BEFORE-AFTER" Style="{StaticResource ModuleColumnHeaderStyle}" ToolTip="Details, reason and change summary."/>
                        <TextBlock Grid.Column="4" Text="REPORT" Style="{StaticResource ModuleColumnHeaderStyle}" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- Empty state -->
                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="&#xE81C;" FontFamily="{DynamicResource FontFamily.Icon}"
                               FontSize="{DynamicResource FontSize.Display}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="No audit activity recorded yet"
                               FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.SemiBold}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,3"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="User actions in this section will appear here instantly."
                               FontSize="{DynamicResource FontSize.Body}"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Rows -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding Rows}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="{DynamicResource CardCornerRadius}"
                                        Margin="10,8,10,0"
                                        Padding="14,12"
                                        Background="{DynamicResource Surface.Primary.BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                                        BorderThickness="{DynamicResource CardBorderThickness}"
                                        ToolTip="{Binding RowTooltip}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- WHEN -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TimeDisplay}"
                                                       FontSize="{DynamicResource FontSize.Body}"
                                                       FontWeight="{DynamicResource Weight.SemiBold}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Typography.NumeralAlignment="Tabular"/>
                                            <TextBlock Text="{Binding UtcTimeDisplay}"
                                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       Typography.NumeralAlignment="Tabular"/>
                                        </StackPanel>

                                        <!-- WHO -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding ActorDisplay}"
                                                       FontSize="{DynamicResource FontSize.Body}"
                                                       FontWeight="{DynamicResource Weight.SemiBold}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Username, StringFormat=login: {0}}"
                                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding OtherUserNotice}"
                                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- WHAT / RECORD -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource CardBorderThickness}"
                                                    Background="{DynamicResource TintIndigoBrush}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Action}"
                                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                                           FontWeight="{DynamicResource Weight.Bold}"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                            <TextBlock Text="{Binding EntityLine}"
                                                       Margin="0,4,0,0"
                                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- DETAILS / WHY / DIFF -->
                                        <StackPanel Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Details}"
                                                       FontSize="{DynamicResource FontSize.Body}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Details}"/>
                                            <TextBlock Text="{Binding WhySummary, StringFormat=Why: {0}}"
                                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                                       Margin="0,3,0,0"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding WhySummary}"/>
                                            <TextBlock Text="{Binding ChangeSummary}"
                                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                                       Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- REPORT BUTTONS -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="Diff"
                                                    Margin="0,0,6,0"
                                                    Padding="9,4"
                                                    FontSize="{DynamicResource FontSize.BodySmall}"
                                                    Style="{StaticResource OutlinedPillButton}"
                                                    Command="{Binding DataContext.ShowChangesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Button Content="Report"
                                                    Padding="11,4"
                                                    FontSize="{DynamicResource FontSize.BodySmall}"
                                                    Style="{StaticResource PrimaryPillButton}"
                                                    Command="{Binding DataContext.ShowAuditReportCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
