<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Shared/Dialogs/ThemedMessageBoxWindow.xaml
     PROJECT: ProGlassAutomation
     MODULE: Unified dialog platform — themed replacement for MessageBox

     The themed counterpart of the native OS MessageBox. It composes the
     shared ThemedDialogWindow chrome (icon badge, wrapping title, close,
     scroll-clamped body, footer strip) so the ~263 prompts routed through
     IDialogService (including Delivery Note delete/void confirmations)
     look and behave like the rest of the product:
       • theme-aware surfaces/typography (no OS-styled box);
       • message text WRAPS and SCROLLS — long localized or exception
         text can never be clipped;
       • proper default/cancel semantics per MessageBoxButton.
     ═══════════════════════════════════════════════════════════════════ -->

<dialogs:ThemedDialogWindow x:Class="ProGlassAutomation.Views.Shared.Dialogs.ThemedMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:ProGlassAutomation.Views.Shared.Dialogs"
        Width="560"
        SizeToContent="Height">

    <!-- The message. Long text wraps; the chrome's body ScrollViewer keeps
         everything reachable when the work-area clamp engages. -->
    <TextBlock x:Name="MessageText"
               FontSize="{StaticResource TextBodyLarge}"
               LineHeight="20"
               Foreground="{DynamicResource PrimaryForegroundBrush}"
               TextWrapping="Wrap"/>
</dialogs:ThemedDialogWindow>
