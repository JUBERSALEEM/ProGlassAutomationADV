<Window x:Class="ProGlassAutomation.Views.Shared.UserSwitchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Switch User"
        Width="460" Height="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border CornerRadius="16"
            Background="{DynamicResource ModuleBackgroundBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0"
                              Opacity="0.22" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Header ───────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{DynamicResource AccentBrush}"
                    CornerRadius="16,16,0,0"
                    Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Switch User"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Choose a user and enter their password to continue as them"
                                   FontSize="11" Foreground="White"
                                   Opacity="0.85" Margin="0,3,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource RowOutlinedButton}"
                            Tag="&#xE711;" MinWidth="40"
                            Click="OnCancelClick"
                            ToolTip="Close"/>
                </Grid>
            </Border>

            <!-- ── User list ─────────────────────────────────────────── -->
            <Grid Grid.Row="1" Margin="24,16,24,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="UserList"/>
                </ScrollViewer>

                <!-- ── Password prompt ───────────────────────────────── -->
                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <TextBlock x:Name="PasswordLabel"
                               Text="Password for the selected user"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    <PasswordBox x:Name="PasswordBox"
                                 Height="38"
                                 Margin="0,6,0,0"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="13"
                                 Background="{DynamicResource ModuleBackgroundBrush}"
                                 Foreground="{DynamicResource PrimaryForegroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1"
                                 KeyDown="PasswordBox_KeyDown"/>
                    <TextBlock x:Name="ErrorText"
                               FontSize="11"
                               Foreground="{DynamicResource DangerBrush}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Grid>

            <!-- ── Footer ────────────────────────────────────────────── -->
            <Border Grid.Row="2"
                    Margin="0,16,0,0"
                    Padding="24,14"
                    CornerRadius="0,0,16,16"
                    Background="{DynamicResource MenuHoverBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Your password is required to sign in as another user."
                               FontSize="11"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource RowOutlinedButton}"
                                Content="CANCEL"
                                MinWidth="96"
                                Margin="0,0,10,0"
                                Click="OnCancelClick"/>
                        <Button x:Name="SwitchButton"
                                Style="{StaticResource PrimaryPillButton}"
                                Content="SWITCH USER"
                                MinWidth="120"
                                IsEnabled="False"
                                Click="OnSwitchClick"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
