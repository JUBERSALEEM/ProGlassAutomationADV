<Window x:Class="ProGlassAutomation.Views.Login.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Login.ResetPasswordProglassAutomation}"
        Width="480"
        Height="640"
        MinWidth="480"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AuthSurfaceStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- ═══ NAVY GLASS STAGE — same visual language as the login ═══ -->
    <Grid Background="{DynamicResource PageBg}">
        <Ellipse Width="320" Height="320"
                 Fill="{DynamicResource OrbRight}"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-120,-100,0" IsHitTestVisible="False"/>
        <Ellipse Width="280" Height="280"
                 Fill="{DynamicResource OrbLeft}"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-90,0,0,-90" IsHitTestVisible="False"/>

        <!-- ═══ FROSTED GLASS CARD ═══ -->
        <Border Width="440"
                Margin="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                Background="{DynamicResource LiquidCard}"
                BorderBrush="{DynamicResource GlassBorderSoft}"
                BorderThickness="{DynamicResource Border.HairlineThickness}"
                Effect="{StaticResource CardShadow}"
                SnapsToDevicePixels="True">
            <Grid>
                <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                        Background="{DynamicResource CardSheen}"
                        IsHitTestVisible="False"/>

                <Grid Margin="28,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ── HEADER ─────────────────────────────────────── -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="{DynamicResource CardCornerRadius}" Margin="0,0,12,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                        <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="{StaticResource TextTitle}" Foreground="{DynamicResource OnAccentForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Login.ResetPassword2}"
                                           FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                <TextBlock Text="{DynamicResource Login.UnlockAccountSetNewPassword}"
                                           FontSize="{StaticResource TextBody}"
                                           Foreground="{DynamicResource Frost}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Login.ActiveAdministratorConfirmsPasswordThenSets}"
                                   TextWrapping="Wrap"
                                   FontSize="{StaticResource TextBody}"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource Cerulean}"
                                   Margin="8,10,8,0"/>
                        <Rectangle Style="{StaticResource HairlineStyle}" Margin="0,14,0,0"/>
                    </StackPanel>

                    <!-- ── FORM (scrollable so it never clips) ─────────── -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False"
                                  FocusVisualStyle="{x:Null}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Login.AdminUsername}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="AdminUsernameBox"
                                     Tag="&#xE77B;"
                                     Style="{StaticResource RoundedTextBox}"/>

                            <TextBlock Text="{DynamicResource Login.AdminPassword}" Style="{StaticResource FieldLabel}"
                                       Margin="2,12,0,6"/>
                            <PasswordBox x:Name="AdminPasswordBox"
                                         Tag="&#xE72E;"
                                         Style="{StaticResource RoundedPasswordBox}"/>

                            <TextBlock Text="{DynamicResource Login.AccountReset}" Style="{StaticResource FieldLabel}"
                                       Margin="2,12,0,6"/>
                            <TextBox x:Name="TargetUsernameBox"
                                     Tag="&#xE77B;"
                                     Style="{StaticResource RoundedTextBox}"/>

                            <TextBlock Text="{DynamicResource Login.NEWPassword}" Style="{StaticResource FieldLabel}"
                                       Margin="2,12,0,6"/>
                            <PasswordBox x:Name="NewPasswordBox"
                                         Tag="&#xE72E;"
                                         Style="{StaticResource RoundedPasswordBox}"/>

                            <TextBlock Text="{DynamicResource Login.ConfirmNEWPassword}" Style="{StaticResource FieldLabel}"
                                       Margin="2,12,0,6"/>
                            <PasswordBox x:Name="ConfirmPasswordBox"
                                         Tag="&#xE72E;"
                                         Style="{StaticResource RoundedPasswordBox}"/>

                            <TextBlock Text="{DynamicResource Login.Minimum8Characters}"
                                       FontSize="{StaticResource TextCaption}"
                                       Foreground="{DynamicResource Cerulean}"
                                       Margin="2,8,0,0"/>

                            <!-- Error -->
                            <Border x:Name="ErrorPanel"
                                    Margin="0,14,0,0" Padding="12,9"
                                    CornerRadius="{DynamicResource Radius.Medium}"
                                    Background="{DynamicResource DangerSurfaceBrush}"
                                    BorderBrush="{DynamicResource DangerOnLiquid}"
                                    BorderThickness="{DynamicResource Border.HairlineThickness}"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA39;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="{StaticResource TextBodyLarge}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,9,0"
                                               Foreground="{DynamicResource DangerOnLiquid}"/>
                                    <TextBlock x:Name="ErrorText"
                                               FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               MaxWidth="330"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource DangerOnLiquid}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── FOOTER ─────────────────────────────────────── -->
                    <Border Grid.Row="2"
                            BorderBrush="{DynamicResource GlassBorderSoft}"
                            BorderThickness="{DynamicResource Border.TopHairlineThickness}"
                            Background="{DynamicResource LiquidCard}"
                            CornerRadius="{DynamicResource Radius.Bottom.Medium}"
                            Padding="16,12"
                            Margin="0,12,-8,-8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{DynamicResource Action.Close}"
                                    Style="{StaticResource OutlinedPillButton}"
                                    Margin="0,0,10,0"
                                    IsCancel="True"
                                    
                                    ToolTip="{DynamicResource Login.CloseWithoutResetting}"/>
                            <Button x:Name="ResetButton"
                                    Content="{DynamicResource Login.ResetPassword}"
                                    Style="{StaticResource PrimaryPillButton}"
                                    IsDefault="True"
                                    Click="Reset_Click"
                                    ToolTip="{DynamicResource Login.ResetAccountPassword}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
