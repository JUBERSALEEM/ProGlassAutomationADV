<Window x:Class="ProGlassAutomation.Views.Login.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset password — ProGlass Automation"
        Width="480"
        Height="640"
        MinWidth="480"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#0A1A44"
        FontFamily="{DynamicResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AuthGlassStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- ═══ NAVY GLASS STAGE — same visual language as the login ═══ -->
    <Grid Background="{StaticResource PageBg}">
        <Ellipse Width="320" Height="320"
                 Fill="{StaticResource OrbRight}"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-120,-100,0" IsHitTestVisible="False"/>
        <Ellipse Width="280" Height="280"
                 Fill="{StaticResource OrbLeft}"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-90,0,0,-90" IsHitTestVisible="False"/>

        <!-- ═══ FROSTED GLASS CARD ═══ -->
        <Border Width="440"
                Margin="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                Background="{StaticResource GlassCard}"
                BorderBrush="#55FFFFFF"
                BorderThickness="1"
                Effect="{StaticResource CardShadow}"
                SnapsToDevicePixels="True">
            <Grid>
                <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                        Background="{StaticResource CardSheen}"
                        IsHitTestVisible="False"/>

                <Grid Margin="28,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ── HEADER ─────────────────────────────────────── -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="{DynamicResource CardCornerRadius}" Margin="0,0,12,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                        <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="{StaticResource TextTitle}" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Reset a password"
                                           FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                           Foreground="White"/>
                                <TextBlock Text="Unlock an account and set a new password"
                                           FontSize="{StaticResource TextBody}"
                                           Foreground="{StaticResource Frost}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="An active Administrator confirms their own password, then sets a new one for the account. Locked accounts are unlocked by this reset."
                                   TextWrapping="Wrap"
                                   FontSize="{StaticResource TextBody}"
                                   TextAlignment="Center"
                                   Foreground="{StaticResource Cerulean}"
                                   Margin="8,10,8,0"/>
                        <Rectangle Style="{StaticResource HairlineStyle}" Margin="0,14,0,0"/>
                    </StackPanel>

                    <!-- ── FORM (scrollable so it never clips) ─────────── -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False"
                                  FocusVisualStyle="{x:Null}">
                        <StackPanel>
                            <TextBlock Text="ADMIN USERNAME" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="AdminUsernameBox"
                                     Tag="&#xE77B;"
                                     Style="{StaticResource RoundedTextBox}"/>

                            <TextBlock Text="ADMIN PASSWORD" Style="{StaticResource FieldLabel}"
                                       Margin="2,12,0,6"/>
                            <PasswordBox x:Name="AdminPasswordBox"
                                         Tag="&#xE72E;"
                                         Style="{StaticResource RoundedPasswordBox}"/>

                            <TextBlock Text="ACCOUNT TO RESET" Style="{StaticResource FieldLabel}"
                                       Margin="2,12,0,6"/>
                            <TextBox x:Name="TargetUsernameBox"
                                     Tag="&#xE77B;"
                                     Style="{StaticResource RoundedTextBox}"/>

                            <TextBlock Text="NEW PASSWORD" Style="{StaticResource FieldLabel}"
                                       Margin="2,12,0,6"/>
                            <PasswordBox x:Name="NewPasswordBox"
                                         Tag="&#xE72E;"
                                         Style="{StaticResource RoundedPasswordBox}"/>

                            <TextBlock Text="CONFIRM NEW PASSWORD" Style="{StaticResource FieldLabel}"
                                       Margin="2,12,0,6"/>
                            <PasswordBox x:Name="ConfirmPasswordBox"
                                         Tag="&#xE72E;"
                                         Style="{StaticResource RoundedPasswordBox}"/>

                            <TextBlock Text="Minimum 8 characters."
                                       FontSize="{StaticResource TextCaption}"
                                       Foreground="{StaticResource Cerulean}"
                                       Margin="2,8,0,0"/>

                            <!-- Error -->
                            <Border x:Name="ErrorPanel"
                                    Margin="0,14,0,0" Padding="12,9"
                                    CornerRadius="10"
                                    Background="#33DC2626"
                                    BorderBrush="{StaticResource DangerOnGlass}"
                                    BorderThickness="1"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA39;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="{StaticResource TextBodyLarge}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,9,0"
                                               Foreground="{StaticResource DangerOnGlass}"/>
                                    <TextBlock x:Name="ErrorText"
                                               FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               MaxWidth="330"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource DangerOnGlass}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── FOOTER ─────────────────────────────────────── -->
                    <Border Grid.Row="2"
                            BorderBrush="#2EFFFFFF"
                            BorderThickness="0,1,0,0"
                            Background="{StaticResource GlassCard}"
                            CornerRadius="0,0,12,12"
                            Padding="16,12"
                            Margin="0,12,-8,-8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Close"
                                    Style="{StaticResource OutlinedPillButton}"
                                    Margin="0,0,10,0"
                                    IsCancel="True"
                                    Click="Cancel_Click"
                                    ToolTip="Close without resetting"/>
                            <Button x:Name="ResetButton"
                                    Content="RESET PASSWORD"
                                    Style="{StaticResource PrimaryPillButton}"
                                    IsDefault="True"
                                    Click="Reset_Click"
                                    ToolTip="Reset the account password"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
