<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Login/AuthGlassStyles.xaml
     PROJECT: ProGlassAutomation
     MODULE: Authentication — shared glass visual language

     ONE source of truth for the entire sign-in flow. Merged by:
       • LoginPanel.xaml            (hosted on the splash stage)
       • ResetPasswordWindow.xaml   (Forgot password →)
       • ForcePasswordChangeWindow.xaml (default-password gate)

     Frosted-glass inputs, navy stage, glass card, accent-gradient
     primary button, text links. Every key here is theme-aware through
     DynamicResource where appropriate and frozen where static.
═══════════════════════════════════════════════════════════════════════ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- ═══ STAGE — deep navy (translucent when over the splash) ═══ -->
    <LinearGradientBrush x:Key="PageBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D9040B1C" Offset="0.0"/>
        <GradientStop Color="#D90A1A44" Offset="0.45"/>
        <GradientStop Color="#D90B2A6E" Offset="1.0"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="OrbRight" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#4D82F6FF" Offset="0.0"/>
        <GradientStop Color="#1D4ED84D" Offset="0.55"/>
        <GradientStop Color="#1D4ED800" Offset="1.0"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="OrbLeft" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#60A5FA66" Offset="0.0"/>
        <GradientStop Color="#3B82F633" Offset="0.55"/>
        <GradientStop Color="#3B82F600" Offset="1.0"/>
    </RadialGradientBrush>

    <!-- ═══ FROSTED CARD ═══ -->
    <LinearGradientBrush x:Key="GlassCard" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#26FFFFFF" Offset="0.0"/>
        <GradientStop Color="#0CFFFFFF" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardSheen" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1AFFFFFF" Offset="0.0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.55"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="CardShadow" Color="#000000"
                      BlurRadius="40" ShadowDepth="6" Opacity="0.45"/>

    <!-- ═══ BRAND / TEXT ═══ -->
    <LinearGradientBrush x:Key="NameGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFFF" Offset="0.0"/>
        <GradientStop Color="#BFDBFE" Offset="0.5"/>
        <GradientStop Color="#93C5FD" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Ice" Color="#DBEAFE" po:Freeze="True"/>
    <SolidColorBrush x:Key="Frost" Color="#BFDBFE" po:Freeze="True"/>
    <SolidColorBrush x:Key="Cerulean" Color="#93C5FD" po:Freeze="True"/>
    <SolidColorBrush x:Key="Snow" Color="#F8FAFC" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerOnGlass" Color="#FCA5A5" po:Freeze="True"/>
    <SolidColorBrush x:Key="WarningOnGlass" Color="#FCD34D" po:Freeze="True"/>

    <!-- ═══ FIELD LABEL ═══ -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Frost}"/>
        <Setter Property="Margin" Value="2,0,0,6"/>
    </Style>

    <!-- ═══ TEXT INPUT — frosted glass, icon chip, rounded ═══ -->
    <Style x:Key="RoundedTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="42"/>
        <Setter Property="FontSize" Value="{StaticResource TextSubhead}"/>
        <Setter Property="Foreground" Value="{StaticResource Snow}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Ice}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            CornerRadius="10"
                            Background="{DynamicResource LiquidGlassSubtleBrush}"
                            BorderBrush="{DynamicResource GlassEdgeBrush}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{TemplateBinding Tag}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource TextSubhead}"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Cerulean}"/>
                            <ScrollViewer Grid.Column="1"
                                          x:Name="PART_ContentHost"
                                          Margin="12,0,16,0"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#A5CFFD"/>
                            <Setter TargetName="Chrome" Property="Background" Value="#2CFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#93C5FD"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ PASSWORD INPUT — frosted glass ═══ -->
    <Style x:Key="RoundedPasswordBox" TargetType="PasswordBox">
        <Setter Property="Height" Value="42"/>
        <Setter Property="FontSize" Value="{StaticResource TextSubhead}"/>
        <Setter Property="Foreground" Value="{StaticResource Snow}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Ice}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Chrome"
                            CornerRadius="10"
                            Background="{DynamicResource LiquidGlassSubtleBrush}"
                            BorderBrush="{DynamicResource GlassEdgeBrush}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{TemplateBinding Tag}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource TextSubhead}"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Cerulean}"/>
                            <ScrollViewer Grid.Column="1"
                                          x:Name="PART_ContentHost"
                                          Margin="12,0,16,0"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#A5CFFD"/>
                            <Setter TargetName="Chrome" Property="Background" Value="#2CFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#93C5FD"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ REMEMBER-ME CHECKBOX — rounded tick, theme-tinted ═══ -->
    <Style x:Key="LoginCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{StaticResource Frost}"/>
        <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box"
                                Width="18" Height="18"
                                CornerRadius="5"
                                Background="{DynamicResource LiquidGlassSubtleBrush}"
                                BorderBrush="{DynamicResource GlassEdgeBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <TextBlock x:Name="Glyph"
                                       Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource TextBody}"
                                       Foreground="{StaticResource Ice}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="9,0,0,0"
                                          VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="#93C5FD"/>
                            <Setter TargetName="Box" Property="Background" Value="#2A93C5FD"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#93C5FD"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ PRIMARY ACTION — accent gradient, full width ═══ -->
    <Style x:Key="SignInButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="{StaticResource TextSection}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.82"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="White"/>
                            <Setter TargetName="Bg" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ TEXT LINK (Forgot password / Exit / Sign out) ═══ -->
    <Style x:Key="TextLinkButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Cerulean}"/>
        <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══ STATUS / DIVIDER ═══ -->
    <Style x:Key="HairlineStyle" TargetType="Rectangle">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Fill" Value="#2EFFFFFF"/>
        <Setter Property="Margin" Value="0,0,0,0"/>
    </Style>

</ResourceDictionary>
