<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Login/AuthSurfaceStyles.xaml
     PROJECT: ProGlassAutomation
     MODULE: Authentication — shared crystal visual language

     ONE source of truth for the entire sign-in flow. Merged by:
       • LoginPanel.xaml            (hosted on the splash stage)
       • ResetPasswordWindow.xaml   (Forgot password →)
       • ForcePasswordChangeWindow.xaml (default-password gate)

     Frosted inputs, navy stage, liquid card, accent-gradient
     primary button, text links. Every key here is theme-aware through
     DynamicResource where appropriate and frozen where static.
═══════════════════════════════════════════════════════════════════════ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Dashboard/Overview/IndigoStudioResources.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ═══ STAGE — deep navy (translucent when over the splash) ═══ -->
    <LinearGradientBrush x:Key="PageBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{DynamicResource ModuleBackgroundColor}" Offset="0.0"/>
        <GradientStop Color="{DynamicResource WindowBackgroundColor}" Offset="0.45"/>
        <GradientStop Color="{DynamicResource AccentDarkColor}" Offset="1.0"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="OrbRight" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="{DynamicResource AccentLightColor}" Offset="0.0"/>
        <GradientStop Color="{DynamicResource AccentColor}" Offset="0.55"/>
        <GradientStop Color="{DynamicResource AccentColor}" Offset="1.0"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="OrbLeft" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="{DynamicResource AccentLightColor}" Offset="0.0"/>
        <GradientStop Color="{DynamicResource AccentColor}" Offset="0.55"/>
        <GradientStop Color="{DynamicResource AccentColor}" Offset="1.0"/>
    </RadialGradientBrush>

    <!-- ═══ FROSTED CARD ═══ -->
    <LinearGradientBrush x:Key="LiquidCard" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource ModuleBackgroundColor}" Offset="0.0"/>
        <GradientStop Color="{DynamicResource ModuleBackgroundColor}" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardSheen" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{DynamicResource ModuleBackgroundColor}" Offset="0.0"/>
        <GradientStop Color="{DynamicResource ModuleBackgroundColor}" Offset="0.55"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="CardShadow" Color="{DynamicResource LiquidShadowColor}"
                      BlurRadius="22" ShadowDepth="6" Opacity="0.28"/>

    <!-- ═══ BRAND / TEXT ═══ -->
    <LinearGradientBrush x:Key="NameGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{DynamicResource ModuleBackgroundColor}" Offset="0.0"/>
        <GradientStop Color="{DynamicResource AccentLightColor}" Offset="0.5"/>
        <GradientStop Color="{DynamicResource AccentLightColor}" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Ice" Color="{DynamicResource PrimaryForegroundColor}"/>
    <SolidColorBrush x:Key="Frost" Color="{DynamicResource AccentLightColor}"/>
    <SolidColorBrush x:Key="Cerulean" Color="{DynamicResource AccentLightColor}"/>
    <SolidColorBrush x:Key="Snow" Color="{DynamicResource PrimaryForegroundColor}"/>
    <SolidColorBrush x:Key="DangerOnLiquid" Color="{DynamicResource DangerColor}"/>
    <SolidColorBrush x:Key="WarningOnLiquid" Color="{DynamicResource WarningColor}"/>

    <!-- ═══ FIELD LABEL ═══ -->
    

    <!-- ═══ TEXT INPUT — frosted surface, icon chip, rounded ═══ -->
    <Style x:Key="RoundedTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="42"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.H3}"/>
        <Setter Property="Foreground" Value="{StaticResource Snow}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Ice}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            CornerRadius="{DynamicResource Radius.Medium}"
                            Background="{DynamicResource SurfacePrimaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{TemplateBinding Tag}"
                                       FontFamily="{DynamicResource FontFamily.Icon}"
                                       FontSize="{DynamicResource FontSize.H3}"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Cerulean}"/>
                            <ScrollViewer Grid.Column="1"
                                          x:Name="PART_ContentHost"
                                          Margin="12,0,16,0"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ PASSWORD INPUT — frosted surface ═══ -->
    <Style x:Key="RoundedPasswordBox" TargetType="PasswordBox">
        <Setter Property="Height" Value="42"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.H3}"/>
        <Setter Property="Foreground" Value="{StaticResource Snow}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Ice}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Chrome"
                            CornerRadius="{DynamicResource Radius.Medium}"
                            Background="{DynamicResource SurfacePrimaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{TemplateBinding Tag}"
                                       FontFamily="{DynamicResource FontFamily.Icon}"
                                       FontSize="{DynamicResource FontSize.H3}"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Cerulean}"/>
                            <ScrollViewer Grid.Column="1"
                                          x:Name="PART_ContentHost"
                                          Margin="12,0,16,0"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ REMEMBER-ME CHECKBOX — rounded tick, theme-tinted ═══ -->
    <Style x:Key="LoginCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{StaticResource Frost}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Title}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box"
                                Width="18" Height="18"
                                CornerRadius="{DynamicResource Radius.Small}"
                               
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="{DynamicResource Border.HairlineThickness}"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <TextBlock x:Name="Glyph"
                                       Text="&#xE73E;"
                                       FontFamily="{DynamicResource FontFamily.Icon}"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{DynamicResource Ice}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="9,0,0,0"
                                          VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ PRIMARY ACTION — accent gradient, full width ═══ -->
    <Style x:Key="SignInButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.H3}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.Bold}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            CornerRadius="{DynamicResource Radius.Medium}"
                            SnapsToDevicePixels="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.82"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="White"/>
                            <Setter TargetName="Bg" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ TEXT LINK (Forgot password / Exit / Sign out) ═══ -->
    <Style x:Key="TextLinkButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Cerulean}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Title}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══ STATUS / DIVIDER ═══ -->
    

</ResourceDictionary>
