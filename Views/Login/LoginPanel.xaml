<UserControl x:Class="ProGlassAutomation.Views.Login.LoginPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:updates="clr-namespace:ProGlassAutomation.Services.Updates"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.BitmapScalingMode="HighQuality"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- ═══════════════════════════════════════════════════════════════
         SIGN-IN PANEL — professional glass login.

         Composition (one action, no duplicated references):
           • brand mark + tagline          (identity, not an action)
           • username / password fields    (Enter submits, like every
                                            professional login)
           • ONE "SIGN IN" button — the single action on the page; its
             label flips to "SIGNING IN…" the moment it is clicked or
             Enter is pressed
           • status strip is hidden while idle and only appears during
             signing / after success (no permanent "Ready to sign in")

         Glassmorphism: the panel root is translucent so the splash's
         aurora glows through, and the card is a frosted glass sheet
         (translucent white gradient + light border + top sheen +
         soft shadow).

         ALL x:Name elements and event handlers required by
         LoginPanel.xaml.cs are preserved verbatim:
           SignInBusyDot, SignInStatusText, DefaultCredWarning,
           UsernameBox, PasswordBox, RememberUserCheck, ErrorPanel,
           ErrorText, SignInButton, ForgotPasswordButton, ExitButton
         (StatusStrip is a NEW container used by SetSigningState).
    ═══════════════════════════════════════════════════════════════════ -->
    <UserControl.Resources>

        <!-- ═══ STAGE — translucent so the splash aurora shows through ═══ -->
        <LinearGradientBrush x:Key="PageBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D9040B1C" Offset="0.0"/>
            <GradientStop Color="#D90A1A44" Offset="0.45"/>
            <GradientStop Color="#D90B2A6E" Offset="1.0"/>
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="OrbRight" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#4D82F6FF" Offset="0.0"/>
            <GradientStop Color="#1D4ED84D" Offset="0.55"/>
            <GradientStop Color="#1D4ED800" Offset="1.0"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="OrbLeft" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#60A5FA66" Offset="0.0"/>
            <GradientStop Color="#3B82F633" Offset="0.55"/>
            <GradientStop Color="#3B82F600" Offset="1.0"/>
        </RadialGradientBrush>

        <!-- ═══ FROSTED CARD ═══ -->
        <LinearGradientBrush x:Key="GlassCard" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#26FFFFFF" Offset="0.0"/>
            <GradientStop Color="#0CFFFFFF" Offset="1.0"/>
        </LinearGradientBrush>
        <!-- Diagonal sheen across the top-left of the card (glass look). -->
        <LinearGradientBrush x:Key="CardSheen" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1AFFFFFF" Offset="0.0"/>
            <GradientStop Color="#00FFFFFF" Offset="0.55"/>
        </LinearGradientBrush>
        <DropShadowEffect x:Key="CardShadow" Color="#000000"
                          BlurRadius="40" ShadowDepth="6" Opacity="0.45"/>

        <!-- ═══ BRAND / TEXT ═══ -->
        <LinearGradientBrush x:Key="NameGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#BFDBFE" Offset="0.5"/>
            <GradientStop Color="#93C5FD" Offset="1.0"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Ice" Color="#DBEAFE" po:Freeze="True"/>
        <SolidColorBrush x:Key="Frost" Color="#BFDBFE" po:Freeze="True"/>
        <SolidColorBrush x:Key="Cerulean" Color="#93C5FD" po:Freeze="True"/>
        <SolidColorBrush x:Key="Snow" Color="#F8FAFC" po:Freeze="True"/>
        <SolidColorBrush x:Key="DangerOnGlass" Color="#FCA5A5" po:Freeze="True"/>
        <SolidColorBrush x:Key="WarningOnGlass" Color="#FCD34D" po:Freeze="True"/>

        <!-- ═══ FIELD LABEL ═══ -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Frost}"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <!-- ═══ TEXT INPUT — frosted glass, icon chip, rounded ═══ -->
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource Snow}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Ice}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome"
                                CornerRadius="10"
                                Background="#1CFFFFFF"
                                BorderBrush="#66BFDBFE"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Cerulean}"/>
                                <ScrollViewer Grid.Column="1"
                                              x:Name="PART_ContentHost"
                                              Margin="12,0,16,0"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#A5CFFD"/>
                                <Setter TargetName="Chrome" Property="Background" Value="#2CFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ PASSWORD INPUT — frosted glass ═══ -->
        <Style x:Key="RoundedPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource Snow}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Ice}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Chrome"
                                CornerRadius="10"
                                Background="#1CFFFFFF"
                                BorderBrush="#66BFDBFE"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Cerulean}"/>
                                <ScrollViewer Grid.Column="1"
                                              x:Name="PART_ContentHost"
                                              Margin="12,0,16,0"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#A5CFFD"/>
                                <Setter TargetName="Chrome" Property="Background" Value="#2CFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ REMEMBER-ME CHECKBOX — rounded tick, theme-tinted ═══ -->
        <Style x:Key="LoginCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource Frost}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box"
                                    Width="18" Height="18"
                                    CornerRadius="5"
                                    Background="#14FFFFFF"
                                    BorderBrush="#66BFDBFE"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True">
                                <TextBlock x:Name="Glyph"
                                           Text="&#xE73E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="11"
                                           Foreground="{StaticResource Ice}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0"
                                              VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#93C5FD"/>
                                <Setter TargetName="Box" Property="Background" Value="#2A93C5FD"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ PRIMARY ACTION — accent gradient, full width ═══ -->
        <Style x:Key="SignInButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ TEXT LINK (Forgot password / Exit) ═══ -->
        <Style x:Key="TextLinkButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Cerulean}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ STATUS / DIVIDER ═══ -->
        <Style x:Key="HairlineStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Fill" Value="#2EFFFFFF"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>

    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         STAGE (translucent — the splash aurora glows through)
    ═══════════════════════════════════════════════════════════════════ -->
    <Grid Background="{StaticResource PageBg}">
        <Ellipse Width="360" Height="360"
                 Fill="{StaticResource OrbRight}"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-80,-80,0" IsHitTestVisible="False"/>
        <Ellipse Width="300" Height="300"
                 Fill="{StaticResource OrbLeft}"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-80,0,0,-80" IsHitTestVisible="False"/>

        <!-- ═══════════════════════════════════════════════════════════
             FROSTED GLASS SIGN-IN CARD
        ═══════════════════════════════════════════════════════════════ -->
        <Border Width="420"
                Margin="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                Background="{StaticResource GlassCard}"
                BorderBrush="#66FFFFFF"
                BorderThickness="1"
                Effect="{StaticResource CardShadow}"
                SnapsToDevicePixels="True">

            <Grid>
                <!-- Diagonal glass sheen (top-left highlight). -->
                <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                        Background="{StaticResource CardSheen}"
                        IsHitTestVisible="False"/>

                <Border Padding="28,24"
                        CornerRadius="{DynamicResource CardCornerRadiusLarge}">
                    <!-- Safety net: on unusually short screens the card scrolls
                         instead of clipping; on normal screens (≥768px tall)
                         the content fits and the scrollbar never appears. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  Focusable="False"
                                  FocusVisualStyle="{x:Null}">
                        <StackPanel>

                            <!-- ── BRAND ─────────────────────────────── -->
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="54" Height="54" CornerRadius="13"
                                        SnapsToDevicePixels="True"
                                        HorizontalAlignment="Center">
                                    <Border.Background>
                                        <ImageBrush ImageSource="pack://application:,,,/Resources/proglass_icon_256.png"
                                                    Stretch="UniformToFill"/>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#1D4ED8" BlurRadius="24"
                                                          ShadowDepth="0" Opacity="0.55"/>
                                    </Border.Effect>
                                </Border>
                                <TextBlock Text="ProGlass Automation"
                                           FontSize="19" FontWeight="Bold"
                                           Foreground="{StaticResource NameGradient}"
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,0"/>
                                <TextBlock Text="Industrial ERP for glass production"
                                           FontSize="12"
                                           Foreground="{StaticResource Cerulean}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <Rectangle Style="{StaticResource HairlineStyle}" Margin="0,18,0,0"/>

                            <!-- ── DEFAULT-CREDENTIAL WARNING (first run) ── -->
                            <Border x:Name="DefaultCredWarning"
                                    Margin="0,14,0,0" Padding="12,9"
                                    CornerRadius="10"
                                    Background="#22F59E0B"
                                    BorderBrush="{StaticResource WarningOnGlass}"
                                    BorderThickness="1"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               VerticalAlignment="Top"
                                               Margin="0,1,10,0"
                                               Foreground="{StaticResource WarningOnGlass}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12.5"
                                               Foreground="{StaticResource Ice}">
                                        <Run Text="First run:" FontWeight="Bold"/>
                                        <Run Text=" use"/>
                                        <Run Text=" admin / admin" FontWeight="Bold"/>
                                        <Run Text=" — then change the password in User Center."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- ── FIELDS ────────────────────────────── -->
                            <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"
                                       Margin="2,18,0,6"/>
                            <TextBox x:Name="UsernameBox"
                                     Tag="&#xE77B;"
                                     Style="{StaticResource RoundedTextBox}"
                                     KeyDown="Field_KeyDown"/>

                            <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}"
                                       Margin="2,14,0,6"/>
                            <PasswordBox x:Name="PasswordBox"
                                         Tag="&#xE72E;"
                                         Style="{StaticResource RoundedPasswordBox}"
                                         KeyDown="Field_KeyDown"/>

                            <!-- ── REMEMBER / FORGOT ROW ─────────────── -->
                            <Grid Margin="2,14,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="RememberUserCheck"
                                          Content="Remember username"
                                          IsChecked="True"
                                          Style="{StaticResource LoginCheckBoxStyle}"
                                          HorizontalAlignment="Left"/>
                                <Button x:Name="ForgotPasswordButton"
                                        Grid.Column="1"
                                        Content="Forgot password?"
                                        Style="{StaticResource TextLinkButtonStyle}"
                                        Click="ForgotPassword_Click"
                                        HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- ── ERROR PANEL ───────────────────────── -->
                            <Border x:Name="ErrorPanel"
                                    Margin="0,14,0,0" Padding="13,10"
                                    CornerRadius="10"
                                    Background="#33DC2626"
                                    BorderBrush="{StaticResource DangerOnGlass}"
                                    BorderThickness="1"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA39;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"
                                               Foreground="{StaticResource DangerOnGlass}"/>
                                    <TextBlock x:Name="ErrorText"
                                               FontSize="12.5" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource DangerOnGlass}"/>
                                </StackPanel>
                            </Border>

                            <!-- ── THE SINGLE ACTION ─────────────────── -->
                            <Button x:Name="SignInButton"
                                    Content="SIGN IN"
                                    Height="44"
                                    Margin="0,16,0,0"
                                    Style="{StaticResource SignInButtonStyle}"
                                    Click="SignIn_Click"/>

                            <!-- ── STATUS STRIP — hidden until signing ── -->
                            <StackPanel x:Name="StatusStrip"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,12,0,0"
                                        Visibility="Collapsed">
                                <Ellipse x:Name="SignInBusyDot" Width="8" Height="8"
                                         Fill="#4ADE80" Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed"/>
                                <TextBlock x:Name="SignInStatusText"
                                           Text=""
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ice}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- ── FOOTER ────────────────────────────── -->
                            <Rectangle Style="{StaticResource HairlineStyle}" Margin="0,16,0,0"/>

                            <Button x:Name="ExitButton"
                                    Content="Exit"
                                    Height="26"
                                    Margin="0,10,0,0"
                                    Style="{StaticResource TextLinkButtonStyle}"
                                    Click="Exit_Click"
                                    HorizontalAlignment="Center"/>

                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{StaticResource Frost}"
                                       Opacity="0.75"
                                       Margin="0,8,0,0">
                                <Run Text="Version"/>
                                <Run Text=" "/>
                                <Run Text="{x:Static updates:AppInfo.Version}"/>
                            </TextBlock>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
