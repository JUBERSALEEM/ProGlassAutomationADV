<UserControl x:Class="ProGlassAutomation.Views.Login.LoginPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:updates="clr-namespace:ProGlassAutomation.Services.Updates"
             PreviewKeyDown="Root_PreviewKeyDown"
             FontFamily="{DynamicResource AppFontFamily}"
             FontWeight="{DynamicResource AppFontWeight}"
             FontStyle="{DynamicResource AppFontStyle}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.BitmapScalingMode="HighQuality"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- ═══════════════════════════════════════════════════════════════
         SIGN-IN PANEL — professional glass login.

         Composition (one action, no duplicated references):
           • brand mark + tagline          (identity, not an action)
           • username / password fields    (Enter submits, like every
                                            professional login)
           • ONE "SIGN IN" button — the single action on the page; its
             label flips to "SIGNING IN…" the moment it is clicked or
             Enter is pressed
           • status strip is hidden while idle and only appears during
             signing / after success (no permanent "Ready to sign in")

         Glassmorphism: the panel root is translucent so the splash's
         aurora glows through, and the card is a frosted glass sheet
         (translucent white gradient + light border + top sheen +
         soft shadow).

         ALL visual resources come from the shared AuthGlassStyles
         dictionary — one source of truth for the whole auth flow
         (login, forgot-password reset, forced password change).

         ALL x:Name elements and event handlers required by
         LoginPanel.xaml.cs are preserved verbatim:
           SignInBusyDot, SignInStatusText, DefaultCredWarning,
           UsernameBox, PasswordBox, RememberUserCheck, ErrorPanel,
           ErrorText, SignInButton, ForgotPasswordButton, ExitButton
         (StatusStrip is a NEW container used by SetSigningState).
    ═══════════════════════════════════════════════════════════════════ -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AuthGlassStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         STAGE (translucent — the splash aurora glows through)
    ═══════════════════════════════════════════════════════════════════ -->
    <Grid Background="{StaticResource PageBg}">
        <Ellipse Width="360" Height="360"
                 Fill="{StaticResource OrbRight}"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-80,-80,0" IsHitTestVisible="False"/>
        <Ellipse Width="300" Height="300"
                 Fill="{StaticResource OrbLeft}"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-80,0,0,-80" IsHitTestVisible="False"/>

        <!-- ═══════════════════════════════════════════════════════════
             FROSTED GLASS SIGN-IN CARD
        ═══════════════════════════════════════════════════════════════ -->
        <Border Width="420"
                Margin="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                Background="{StaticResource GlassCard}"
                BorderBrush="#66FFFFFF"
                BorderThickness="1"
                Effect="{StaticResource CardShadow}"
                SnapsToDevicePixels="True">

            <Grid>
                <!-- Diagonal glass sheen (top-left highlight). -->
                <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                        Background="{StaticResource CardSheen}"
                        IsHitTestVisible="False"/>

                <Border Padding="28,24"
                        CornerRadius="{DynamicResource CardCornerRadiusLarge}">
                    <!-- Safety net: on unusually short screens the card scrolls
                         instead of clipping; on normal screens (≥768px tall)
                         the content fits and the scrollbar never appears. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  Focusable="False"
                                  FocusVisualStyle="{x:Null}">
                        <StackPanel>

                            <!-- ── BRAND ─────────────────────────────── -->
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="54" Height="54" CornerRadius="13"
                                        SnapsToDevicePixels="True"
                                        HorizontalAlignment="Center">
                                    <Border.Background>
                                        <ImageBrush ImageSource="pack://application:,,,/Resources/proglass_icon_256.png"
                                                    Stretch="UniformToFill"/>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#1D4ED8" BlurRadius="24"
                                                          ShadowDepth="0" Opacity="0.55"/>
                                    </Border.Effect>
                                </Border>
                                <TextBlock Text="ProGlass Automation"
                                           FontSize="{StaticResource TextTitleLarge}" FontWeight="Bold"
                                           Foreground="{StaticResource NameGradient}"
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,0"/>
                                <TextBlock Text="Made in India · for the UAE glass industry"
                                           FontSize="{StaticResource TextBody}"
                                           Foreground="{StaticResource Cerulean}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <Rectangle Style="{StaticResource HairlineStyle}" Margin="0,18,0,0"/>

                            <!-- ── DEFAULT-CREDENTIAL WARNING (first run) ── -->
                            <Border x:Name="DefaultCredWarning"
                                    Margin="0,14,0,0" Padding="12,9"
                                    CornerRadius="10"
                                    Background="#22F59E0B"
                                    BorderBrush="{StaticResource WarningOnGlass}"
                                    BorderThickness="1"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="{StaticResource TextSection}"
                                               VerticalAlignment="Top"
                                               Margin="0,1,10,0"
                                               Foreground="{StaticResource WarningOnGlass}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="{StaticResource TextBodyLarge}"
                                               Foreground="{StaticResource Ice}">
                                        <Run Text="First run:" FontWeight="Bold"/>
                                        <Run Text=" use"/>
                                        <Run Text=" admin / admin" FontWeight="Bold"/>
                                        <Run Text=" — then change the password in User Center."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- ── FIELDS ────────────────────────────── -->
                            <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"
                                       Margin="2,18,0,6"/>
                            <TextBox x:Name="UsernameBox"
                                     Tag="&#xE77B;"
                                     Style="{StaticResource RoundedTextBox}"/>

                            <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}"
                                       Margin="2,14,0,6"/>
                            <PasswordBox x:Name="PasswordBox"
                                         Tag="&#xE72E;"
                                         Style="{StaticResource RoundedPasswordBox}"/>

                            <!-- ── REMEMBER / FORGOT ROW ─────────────── -->
                            <Grid Margin="2,14,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="RememberUserCheck"
                                          Content="Remember username"
                                          IsChecked="True"
                                          Style="{StaticResource LoginCheckBoxStyle}"
                                          HorizontalAlignment="Left"/>
                                <Button x:Name="ForgotPasswordButton"
                                        Grid.Column="1"
                                        Content="Forgot password?"
                                        Style="{StaticResource TextLinkButtonStyle}"
                                        Click="ForgotPassword_Click"
                                        HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- ── SKIP-LOGIN PILL (iPhone-style ON/OFF) ──
                                 When ON, this device auto-signs in with the
                                 saved credentials on every launch until the
                                 next installed update. The pill deliberately
                                 resets on update so a fresh binary always
                                 re-verifies the user (Auth-2 contract).
                                 Password is DPAPI-encrypted in SecretVault;
                                 the pill is bound to
                                 App.Config.SkipLoginUntilUpdate. -->
                            <Border Margin="2,14,2,0" Padding="14,10"
                                    CornerRadius="12"
                                    Background="#26FFFFFF"
                                    BorderBrush="#33FFFFFF"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Skip login until update"
                                                   FontSize="{StaticResource TextBodyLarge}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Ice}"/>
                                        <TextBlock Text="Auto sign-in on this device. Resets on the next app update."
                                                   FontSize="{StaticResource TextCaption}"
                                                   Foreground="{StaticResource Frost}"
                                                   Opacity="0.75"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="SkipLoginPill"
                                                  Grid.Column="1"
                                                  Style="{StaticResource PiToggleSwitch}"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Margin="12,0,0,0"
                                                  ToolTip="Auto-sign-in with these credentials on the next launch (resets on app update)."
                                                  AutomationProperties.Name="Skip login until update"/>
                                </Grid>
                            </Border>

                            <!-- ── ERROR PANEL ───────────────────────── -->
                            <Border x:Name="ErrorPanel"
                                    Margin="0,14,0,0" Padding="13,10"
                                    CornerRadius="10"
                                    Background="#33DC2626"
                                    BorderBrush="{StaticResource DangerOnGlass}"
                                    BorderThickness="1"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA39;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="{StaticResource TextSection}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"
                                               Foreground="{StaticResource DangerOnGlass}"/>
                                    <TextBlock x:Name="ErrorText"
                                               FontSize="{StaticResource TextBodyLarge}" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource DangerOnGlass}"/>
                                </StackPanel>
                            </Border>

                            <!-- ── THE SINGLE ACTION ─────────────────── -->
                            <Button x:Name="SignInButton"
                                    Content="SIGN IN"
                                    Height="44"
                                    Margin="0,16,0,0"
                                    Style="{StaticResource SignInButtonStyle}"
                                    Click="SignIn_Click"
                                    IsDefault="True"
                                    ToolTip="Sign in to ProGlass Automation"
                                    AutomationProperties.Name="Sign in"/>

                            <!-- ── STATUS STRIP — space ALWAYS reserved.
                                 Visibility toggles Hidden/Visible only, so
                                 showing "Signing in…" never shifts the
                                 button, footer or version line. ───────── -->
                            <StackPanel x:Name="StatusStrip"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,12,0,0"
                                        Visibility="Hidden">
                                <Ellipse x:Name="SignInBusyDot" Width="8" Height="8"
                                         Fill="#4ADE80" Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed"/>
                                <TextBlock x:Name="SignInStatusText"
                                           Text=""
                                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ice}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- ── FOOTER ────────────────────────────── -->
                            <Rectangle Style="{StaticResource HairlineStyle}" Margin="0,16,0,0"/>

                            <Button x:Name="ExitButton"
                                    Content="Exit"
                                    Height="26"
                                    Margin="0,10,0,0"
                                    Style="{StaticResource TextLinkButtonStyle}"
                                    Click="Exit_Click"
                                    HorizontalAlignment="Center"/>

                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="{StaticResource TextBody}"
                                       Foreground="{StaticResource Frost}"
                                       Opacity="0.75"
                                       Margin="0,8,0,0">
                                <Run Text="Version"/>
                                <Run Text=" "/>
                                <Run Text="{x:Static updates:AppInfo.Version}"/>
                            </TextBlock>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
