<UserControl x:Class="ProGlassAutomation.Views.Login.LoginPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:updates="clr-namespace:ProGlassAutomation.Services.Updates"
             PreviewKeyDown="Root_PreviewKeyDown"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.BitmapScalingMode="HighQuality"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- ═══════════════════════════════════════════════════════════════
         SIGN-IN PANEL — industrial steel login.

         Composition (one action, no duplicated references):
           • brand mark + tagline          (identity, not an action)
           • username / password fields    (Enter submits)
           • ONE "SIGN IN" button          (label flips to "SIGNING IN…")
           • status strip hidden while idle

         Industrial: flat steel-navy card with 12px corners and a 1px
         border — matching the splash. No glass, no orbs.

         ALL x:Name elements and event handlers required by
         LoginPanel.xaml.cs are preserved verbatim:
           SignInBusyDot, SignInStatusText, DefaultCredWarning,
           UsernameBox, PasswordBox, RememberUserCheck, ErrorPanel,
           ErrorText, SignInButton, ForgotPasswordButton, ExitButton,
           StatusStrip
    ═══════════════════════════════════════════════════════════════════ -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AuthGlassStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Blueprint grid (matches the splash stage) -->
            <DrawingBrush x:Key="BlueprintGrid"
                          TileMode="Tile"
                          Viewport="0,0,40,40" ViewportUnits="Absolute"
                          Viewbox="0,0,40,40" ViewboxUnits="Absolute">
                <DrawingBrush.Drawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#0AFFFFFF" Thickness="1"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,0" EndPoint="0,40"/>
                                <LineGeometry StartPoint="0,0" EndPoint="40,0"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         STAGE (opaque steel — matches the splash)
    ═══════════════════════════════════════════════════════════════════ -->
    <Grid Background="{StaticResource PageBg}">
        <Rectangle Fill="{StaticResource BlueprintGrid}" Opacity="0.7" IsHitTestVisible="False"/>
        <Rectangle Height="1" Fill="#33438BDF" VerticalAlignment="Top" IsHitTestVisible="False"/>

        <!-- ═══════════════════════════════════════════════════════════
             STEEL SIGN-IN CARD
        ═══════════════════════════════════════════════════════════════ -->
        <Border Width="420"
                Margin="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                Background="{StaticResource GlassCard}"
                BorderBrush="#2A3A55"
                BorderThickness="1"
                Effect="{StaticResource CardShadow}"
                SnapsToDevicePixels="True">

            <Grid>
                <!-- Top hairline accent on the card -->
                <Rectangle Height="2" Fill="#33438BDF" VerticalAlignment="Top"
                           RadiusX="2" RadiusY="2" IsHitTestVisible="False"/>

                <Border Padding="28,24"
                        CornerRadius="{DynamicResource CardCornerRadiusLarge}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  Focusable="False"
                                  FocusVisualStyle="{x:Null}">
                        <StackPanel>

                            <!-- ── BRAND ─────────────────────────────── -->
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="54" Height="54"
                                        CornerRadius="{DynamicResource CardCornerRadius}"
                                        SnapsToDevicePixels="True"
                                        Background="#0C1626"
                                        BorderBrush="#2A3A55"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center">
                                    <Border Width="46" Height="46"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            ClipToBounds="True">
                                        <Border.Background>
                                            <ImageBrush ImageSource="pack://application:,,,/Resources/proglass_icon_256.png"
                                                        Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                </Border>
                                <TextBlock Text="ProGlass Automation"
                                           FontSize="19" FontWeight="Bold"
                                           Foreground="{StaticResource NameGradient}"
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,0"/>
                                <TextBlock Text="Industrial ERP for glass production"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="{StaticResource Cerulean}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <Rectangle Style="{StaticResource HairlineStyle}" Margin="0,18,0,0"/>

                            <!-- ── DEFAULT-CREDENTIAL WARNING (first run) ── -->
                            <Border x:Name="DefaultCredWarning"
                                    Margin="0,14,0,0" Padding="12,9"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Background="#22F59E0B"
                                    BorderBrush="{StaticResource WarningOnGlass}"
                                    BorderThickness="1"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               VerticalAlignment="Top"
                                               Margin="0,1,10,0"
                                               Foreground="{StaticResource WarningOnGlass}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12.5"
                                               Foreground="{StaticResource Ice}">
                                        <Run Text="First run:" FontWeight="Bold"/>
                                        <Run Text=" use"/>
                                        <Run Text=" admin / admin" FontWeight="Bold"/>
                                        <Run Text=" — then change the password in User Center."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- ── FIELDS ────────────────────────────── -->
                            <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"
                                       Margin="2,18,0,6"/>
                            <TextBox x:Name="UsernameBox"
                                     Tag="&#xE77B;"
                                     Style="{StaticResource RoundedTextBox}"/>

                            <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}"
                                       Margin="2,14,0,6"/>
                            <PasswordBox x:Name="PasswordBox"
                                         Tag="&#xE72E;"
                                         Style="{StaticResource RoundedPasswordBox}"/>

                            <!-- ── REMEMBER / FORGOT ROW ─────────────── -->
                            <Grid Margin="2,14,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="RememberUserCheck"
                                          Content="Remember username"
                                          IsChecked="True"
                                          Style="{StaticResource LoginCheckBoxStyle}"
                                          HorizontalAlignment="Left"/>
                                <Button x:Name="ForgotPasswordButton"
                                        Grid.Column="1"
                                        Content="Forgot password?"
                                        Style="{StaticResource TextLinkButtonStyle}"
                                        Click="ForgotPassword_Click"
                                        HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- ── ERROR PANEL ───────────────────────── -->
                            <Border x:Name="ErrorPanel"
                                    Margin="0,14,0,0" Padding="13,10"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Background="#33DC2626"
                                    BorderBrush="{StaticResource DangerOnGlass}"
                                    BorderThickness="1"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA39;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"
                                               Foreground="{StaticResource DangerOnGlass}"/>
                                    <TextBlock x:Name="ErrorText"
                                               FontSize="12.5" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource DangerOnGlass}"/>
                                </StackPanel>
                            </Border>

                            <!-- ── THE SINGLE ACTION ─────────────────── -->
                            <Button x:Name="SignInButton"
                                    Content="SIGN IN"
                                    Height="44"
                                    Margin="0,16,0,0"
                                    Style="{StaticResource SignInButtonStyle}"
                                    Click="SignIn_Click"
                                    IsDefault="True"
                                    ToolTip="Sign in to ProGlass Automation"
                                    AutomationProperties.Name="Sign in"/>

                            <!-- ── STATUS STRIP — space ALWAYS reserved. ── -->
                            <StackPanel x:Name="StatusStrip"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,12,0,0"
                                        Visibility="Hidden">
                                <Ellipse x:Name="SignInBusyDot" Width="8" Height="8"
                                         Fill="#4ADE80" Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed"/>
                                <TextBlock x:Name="SignInStatusText"
                                           Text=""
                                           FontFamily="Consolas"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ice}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- ── FOOTER ────────────────────────────── -->
                            <Rectangle Style="{StaticResource HairlineStyle}" Margin="0,16,0,0"/>

                            <Button x:Name="ExitButton"
                                    Content="Exit"
                                    Height="26"
                                    Margin="0,10,0,0"
                                    Style="{StaticResource TextLinkButtonStyle}"
                                    Click="Exit_Click"
                                    HorizontalAlignment="Center"/>

                            <TextBlock HorizontalAlignment="Center"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Foreground="{StaticResource Cerulean}"
                                       Opacity="0.75"
                                       Margin="0,8,0,0">
                                <Run Text="VERSION"/><Run Text=" "/><Run Text="{x:Static updates:AppInfo.Version}"/>
                            </TextBlock>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
