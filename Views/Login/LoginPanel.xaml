<UserControl x:Class="ProGlassAutomation.Views.Login.LoginPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:updates="clr-namespace:ProGlassAutomation.Services.Updates"
             xmlns:viewsAbout="clr-namespace:ProGlassAutomation.Views.About"
             PreviewKeyDown="Root_PreviewKeyDown"
             FontFamily="{DynamicResource AppFontFamily}"
             FontWeight="{DynamicResource AppFontWeight}"
             FontStyle="{DynamicResource AppFontStyle}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.BitmapScalingMode="HighQuality"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- ═══════════════════════════════════════════════════════════════
         SIGN-IN PANEL — professional glass login.

         Composition (one action, no duplicated references):
           • brand mark + tagline          (identity, not an action)
           • username / password fields    (Enter submits, like every
                                            professional login)
           • ONE "SIGN IN" button — the single action on the page; its
             label flips to "SIGNING IN…" the moment it is clicked or
             Enter is pressed
           • status strip is hidden while idle and only appears during
             signing / after success (no permanent "Ready to sign in")

         Glassmorphism: the panel root is translucent so the splash's
         aurora glows through, and the card is a frosted glass sheet
         (translucent white gradient + light border + top sheen +
         soft shadow).

         ALL visual resources come from the shared AuthSurfaceStyles
         dictionary — one source of truth for the whole auth flow
         (login, forgot-password reset, forced password change).

         2026-09-02 (Phase 3.7): sign-in state moved to
         LoginPanelViewModel — only the PasswordBox-focused x:Names
         remain (UsernameBox, PasswordBox, RememberUserCheck,
         SkipLoginPill, SignInButton, ForgotPasswordButton, ExitButton)
         plus the by-design Enter-tunnel handler Root_PreviewKeyDown.
    ═══════════════════════════════════════════════════════════════════ -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AuthSurfaceStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         STAGE (translucent — the splash aurora glows through)
    ═══════════════════════════════════════════════════════════════════ -->
    <Grid Background="{DynamicResource PageBg}">
        <Ellipse Width="360" Height="360"
                 Fill="{DynamicResource OrbRight}"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-80,-80,0" IsHitTestVisible="False"/>
        <Ellipse Width="300" Height="300"
                 Fill="{DynamicResource OrbLeft}"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-80,0,0,-80" IsHitTestVisible="False"/>

        <!-- ═══════════════════════════════════════════════════════════
             FROSTED GLASS SIGN-IN CARD
        ═══════════════════════════════════════════════════════════════ -->
        <Border Width="420"
                Margin="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="{DynamicResource CardCornerRadiusLarge}"
               
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="{DynamicResource Border.HairlineThickness}"
               
                SnapsToDevicePixels="True" Style="{StaticResource SurfacePrimaryStyle}">

            <Grid>
                <!-- Diagonal glass sheen (top-left highlight). -->
                <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                       
                        IsHitTestVisible="False" Style="{StaticResource SurfacePrimaryStyle}"/>

                <Border Padding="28,24"
                        CornerRadius="{DynamicResource CardCornerRadiusLarge}">
                    <!-- Safety net: on unusually short screens the card scrolls
                         instead of clipping; on normal screens (≥768px tall)
                         the content fits and the scrollbar never appears. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  Focusable="False"
                                  FocusVisualStyle="{x:Null}">
                        <StackPanel>

                            <!-- ── BRAND ─────────────────────────────── -->
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="54" Height="54" CornerRadius="{DynamicResource Radius.Large}"
                                        SnapsToDevicePixels="True"
                                        HorizontalAlignment="Center">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{x:Static viewsAbout:AppIconResource.Icon}"
                                                    Stretch="UniformToFill"/>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="22"
                                                          ShadowDepth="0" Opacity="0.28"/>
                                    </Border.Effect>
                                </Border>
                                <TextBlock Text="ProGlass Automation"
                                           FontSize="{DynamicResource FontSize.H1}" FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource NameGradient}"
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,0"/>
                                <TextBlock Text="{DynamicResource Login.MadeIndiaUAEGlassIndustry}"
                                           FontSize="{DynamicResource FontSize.Body}"
                                           Foreground="{DynamicResource Cerulean}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <Rectangle Style="{StaticResource HairlineStyle}" Margin="0,18,0,0"/>

                            <!-- ── DEFAULT-CREDENTIAL WARNING (first run) ── -->
                            <Border Margin="0,14,0,0" Padding="12,9"
                                    CornerRadius="{DynamicResource Radius.Medium}"
                                    Background="{DynamicResource WarningSurfaceBrush}"
                                    BorderBrush="{DynamicResource WarningOnLiquid}"
                                    BorderThickness="{DynamicResource Border.HairlineThickness}"
                                    Visibility="{Binding DefaultCredWarningVisibility}" Style="{StaticResource SurfacePrimaryStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;"
                                               FontFamily="{DynamicResource FontFamily.Icon}"
                                               FontSize="{DynamicResource FontSize.H3}"
                                               VerticalAlignment="Top"
                                               Margin="0,1,10,0"
                                               Foreground="{DynamicResource WarningOnLiquid}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Title}"
                                               Foreground="{DynamicResource Ice}">
                                        <Run Text="{DynamicResource Login.FirstRun}" FontWeight="{DynamicResource Weight.Bold}"/>
                                        <Run Text="{DynamicResource Login.Use}"/>
                                        <Run Text="{DynamicResource Login.AdminAdmin}" FontWeight="{DynamicResource Weight.Bold}"/>
                                        <Run Text="{DynamicResource Login.ThenChangePasswordUserCenter}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- ── FIELDS ────────────────────────────── -->
                            <TextBlock Text="{DynamicResource Login.Username}" Style="{StaticResource FieldLabel}"
                                       Margin="2,18,0,6"/>
                            <TextBox x:Name="UsernameBox"
                                     Tag="&#xE77B;"
                                     Style="{StaticResource RoundedTextBox}"
                                     Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsFormEnabled}"/>

                            <TextBlock Text="{DynamicResource Login.Password}" Style="{StaticResource FieldLabel}"
                                       Margin="2,14,0,6"/>
                            <PasswordBox x:Name="PasswordBox"
                                         Tag="&#xE72E;"
                                         Style="{StaticResource RoundedPasswordBox}"
                                         IsEnabled="{Binding IsFormEnabled}"/>

                            <!-- ── REMEMBER / FORGOT ROW ─────────────── -->
                            <Grid Margin="2,14,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="RememberUserCheck"
                                          Content="{DynamicResource Login.RememberMe}"
                                          IsChecked="{Binding RememberUsername, Mode=TwoWay}"
                                          IsEnabled="{Binding IsFormEnabled}"
                                          Style="{StaticResource LoginCheckBoxStyle}"
                                          HorizontalAlignment="Left"/>
                                <Button x:Name="ForgotPasswordButton"
                                        Grid.Column="1"
                                        Content="{DynamicResource Login.ForgotPassword}"
                                        Style="{StaticResource TextLinkButtonStyle}"
                                        Command="{Binding ForgotPasswordCommand}"
                                        IsEnabled="{Binding IsFormEnabled}"
                                        HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- ── SKIP-LOGIN PILL (iPhone-style ON/OFF) ──
                                 When ON, this device auto-signs in with the
                                 saved credentials on every launch until the
                                 next installed update. The pill deliberately
                                 resets on update so a fresh binary always
                                 re-verifies the user (Auth-2 contract).
                                 Password is DPAPI-encrypted in SecretVault;
                                 the pill is bound to
                                 App.Config.SkipLoginUntilUpdate. -->
                            <Border Margin="2,14,2,0" Padding="14,10"
                                    CornerRadius="{DynamicResource Radius.Large}"
                                    Background="{DynamicResource SurfacePrimaryBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="{DynamicResource Border.HairlineThickness}" Style="{StaticResource SurfacePrimaryStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Login.SkipLoginUntilUpdate}"
                                                   FontSize="{DynamicResource FontSize.Title}"
                                                   FontWeight="{DynamicResource Weight.SemiBold}"
                                                   Foreground="{DynamicResource Ice}"/>
                                        <TextBlock Text="{DynamicResource Login.AutoSignDeviceResetsNextAppUpdate}"
                                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                                   Foreground="{DynamicResource Frost}"
                                                   Opacity="0.75"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="SkipLoginPill"
                                                  Grid.Column="1"
                                                  Style="{StaticResource PiToggleSwitch}"
                                                  IsChecked="{Binding SkipLogin, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsFormEnabled}"
                                                  VerticalAlignment="Center"
                                                  Margin="12,0,0,0"
                                                  ToolTip="{DynamicResource Login.AutoSignCredentialsNextLaunchResetsAppUpdate}"
                                                  AutomationProperties.Name="Skip login until update"/>
                                </Grid>
                            </Border>

                            <!-- ── ERROR PANEL ───────────────────────── -->
                            <Border Margin="0,14,0,0" Padding="13,10"
                                    CornerRadius="{DynamicResource Radius.Medium}"
                                    Background="{DynamicResource DangerSurfaceBrush}"
                                    BorderBrush="{DynamicResource DangerOnLiquid}"
                                    BorderThickness="{DynamicResource Border.HairlineThickness}"
                                    Visibility="{Binding ErrorVisibility}" Style="{StaticResource SurfacePrimaryStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA39;"
                                               FontFamily="{DynamicResource FontFamily.Icon}"
                                               FontSize="{DynamicResource FontSize.H3}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"
                                               Foreground="{DynamicResource DangerOnLiquid}"/>
                                    <TextBlock FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.SemiBold}"
                                               Text="{Binding ErrorText}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource DangerOnLiquid}"/>
                                </StackPanel>
                            </Border>

                            <!-- ── THE SINGLE ACTION ─────────────────── -->
                            <Button x:Name="SignInButton"
                                    Content="{Binding SignInButtonText}"
                                    Height="44"
                                    Margin="0,16,0,0"
                                    Style="{StaticResource SignInButtonStyle}"
                                    Command="{Binding SignInCommand}"
                                    CommandParameter="{Binding ElementName=PasswordBox}"
                                    IsEnabled="{Binding IsFormEnabled}"
                                    IsDefault="True"
                                    ToolTip="{DynamicResource Login.SignProglassAutomation}"
                                    AutomationProperties.Name="Sign in"/>

                            <!-- ── STATUS STRIP — space ALWAYS reserved.
                                 Visibility toggles Hidden/Visible only, so
                                 showing "Signing in…" never shifts the
                                 button, footer or version line. ───────── -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,12,0,0"
                                        Visibility="{Binding StatusVisibility}">
                                <Ellipse Width="8" Height="8"
                                         Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding BusyDotVisibility}"/>
                                <TextBlock Text="{Binding StatusText}"
                                           FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                           Foreground="{DynamicResource Ice}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- ── FOOTER ────────────────────────────── -->
                            <Rectangle Style="{StaticResource HairlineStyle}" Margin="0,16,0,0"/>

                            <Button x:Name="ExitButton"
                                    Content="{DynamicResource Shell.Exit}"
                                    Height="26"
                                    Margin="0,10,0,0"
                                    Style="{StaticResource TextLinkButtonStyle}"
                                    Command="{Binding ExitCommand}"
                                    IsEnabled="{Binding IsFormEnabled}"
                                    HorizontalAlignment="Center"/>

                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{DynamicResource Frost}"
                                       Opacity="0.75"
                                       Margin="0,8,0,0">
                                <Run Text="{DynamicResource About.Version}"/>
                                <Run Text=" "/>
                                <Run Text="{x:Static updates:AppInfo.Version}"/>
                            </TextBlock>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
