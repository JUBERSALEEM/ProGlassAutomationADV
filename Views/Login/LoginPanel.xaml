<UserControl x:Class="ProGlassAutomation.Views.Login.LoginPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:updates="clr-namespace:ProGlassAutomation.Services.Updates"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.BitmapScalingMode="HighQuality"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="PageBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#040B1C" Offset="0.0"/>
            <GradientStop Color="#0A1A44" Offset="0.42"/>
            <GradientStop Color="#0B2A6E" Offset="1.0"/>
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="OrbRight" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#4D82F6FF" Offset="0.0"/>
            <GradientStop Color="#1D4ED84D" Offset="0.55"/>
            <GradientStop Color="#1D4ED800" Offset="1.0"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="OrbLeft" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#60A5FA66" Offset="0.0"/>
            <GradientStop Color="#3B82F633" Offset="0.55"/>
            <GradientStop Color="#3B82F600" Offset="1.0"/>
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="GlassCard" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#28FFFFFF" Offset="0.0"/>
            <GradientStop Color="#10FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NameGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#BFDBFE" Offset="0.5"/>
            <GradientStop Color="#93C5FD" Offset="1.0"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Ice" Color="#DBEAFE" po:Freeze="True"/>
        <SolidColorBrush x:Key="Frost" Color="#BFDBFE" po:Freeze="True"/>
        <SolidColorBrush x:Key="Cerulean" Color="#93C5FD" po:Freeze="True"/>
        <SolidColorBrush x:Key="Snow" Color="#F8FAFC" po:Freeze="True"/>
        <SolidColorBrush x:Key="DangerOnGlass" Color="#FCA5A5" po:Freeze="True"/>
        <SolidColorBrush x:Key="WarningOnGlass" Color="#FCD34D" po:Freeze="True"/>
        <DropShadowEffect x:Key="CardGlow" Color="#1D4ED8" BlurRadius="36" ShadowDepth="0" Opacity="0.45"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Frost}"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>

        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource Snow}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Ice}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome"
                                CornerRadius="12"
                                Background="#18FFFFFF"
                                BorderBrush="#66BFDBFE"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Cerulean}"/>
                                <ScrollViewer Grid.Column="1"
                                              x:Name="PART_ContentHost"
                                              Margin="12,0,16,0"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#93C5FD"/>
                                <Setter TargetName="Chrome" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedPasswordBox" TargetType="PasswordBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource Snow}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Ice}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Chrome"
                                CornerRadius="12"
                                Background="#18FFFFFF"
                                BorderBrush="#66BFDBFE"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Cerulean}"/>
                                <ScrollViewer Grid.Column="1"
                                              x:Name="PART_ContentHost"
                                              Margin="12,0,16,0"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#93C5FD"/>
                                <Setter TargetName="Chrome" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SignInButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                CornerRadius="12"
                                Background="{DynamicResource AccentBrush}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource AccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource Frost}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                CornerRadius="12"
                                Background="Transparent"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PageBg}">
        <Ellipse Width="900" Height="900"
                 Fill="{StaticResource OrbRight}"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-320,-320,0" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="120"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="760" Height="760"
                 Fill="{StaticResource OrbLeft}"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-280,0,0,-280" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="110"/>
            </Ellipse.Effect>
        </Ellipse>

        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="40,36,0,0" Padding="16,8" CornerRadius="12"
                Background="#16FFFFFF" BorderBrush="#40BFDBFE" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets"
                           FontSize="13" Foreground="{StaticResource Ice}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="MADE FOR UAE" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource Ice}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,36,40,0" Padding="16,8" CornerRadius="12"
                Background="#16FFFFFF" BorderBrush="#40BFDBFE" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                           FontSize="13" Foreground="{StaticResource Ice}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="OFFLINE · SECURE" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource Ice}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Width="540"
                MaxWidth="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="12"
                Background="{StaticResource GlassCard}"
                BorderBrush="#55FFFFFF"
                BorderThickness="1"
                Effect="{StaticResource CardGlow}"
                SnapsToDevicePixels="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          Focusable="False"
                          FocusVisualStyle="{x:Null}">
                <Border Padding="44,40,44,36">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="12"
                                    SnapsToDevicePixels="True">
                                <Border.Background>
                                    <ImageBrush ImageSource="pack://application:,,,/Resources/proglass_icon_256.png"
                                                Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="ProGlass Automation"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource NameGradient}"/>
                                <TextBlock Text="Industrial ERP for glass production"
                                           FontSize="13"
                                           Foreground="{StaticResource Cerulean}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Welcome back"
                                   FontSize="32" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,32,0,0"
                                   Foreground="White"/>
                        <TextBlock Text="Sign in to continue to your workspace"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource Frost}"/>

                        <Border x:Name="DefaultCredWarning"
                                Margin="0,26,0,0" Padding="16,12"
                                CornerRadius="12"
                                Background="#22F59E0B"
                                BorderBrush="{StaticResource WarningOnGlass}"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           VerticalAlignment="Top"
                                           Margin="0,1,12,0"
                                           Foreground="{StaticResource WarningOnGlass}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13"
                                           MaxWidth="380"
                                           Foreground="{StaticResource Ice}">
                                    <Run Text="First run:" FontWeight="Bold"/>
                                    <Run Text=" sign in as"/>
                                    <Run Text=" admin / admin" FontWeight="Bold"/>
                                    <Run Text=" — then change the password in User Center."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"
                                   Margin="2,28,0,8"/>
                        <TextBox x:Name="UsernameBox"
                                 Height="52"
                                 Tag="&#xE77B;"
                                 Style="{StaticResource RoundedTextBox}"
                                 KeyDown="Field_KeyDown"/>

                        <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}"
                                   Margin="2,18,0,8"/>
                        <PasswordBox x:Name="PasswordBox"
                                     Height="52"
                                     Tag="&#xE72E;"
                                     Style="{StaticResource RoundedPasswordBox}"
                                     KeyDown="Field_KeyDown"/>

                        <CheckBox x:Name="RememberUserCheck"
                                  Content="Remember username on this computer"
                                  IsChecked="True"
                                  Margin="2,16,0,0"
                                  FontSize="13"
                                  Foreground="{StaticResource Frost}"
                                  Cursor="Hand"/>

                        <Border x:Name="ErrorPanel"
                                Margin="0,16,0,0" Padding="14,10"
                                CornerRadius="12"
                                Background="#33DC2626"
                                BorderBrush="{StaticResource DangerOnGlass}"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA39;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           Foreground="{StaticResource DangerOnGlass}"/>
                                <TextBlock x:Name="ErrorText"
                                           FontSize="13" FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           MaxWidth="380"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource DangerOnGlass}"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="SignInButton"
                                Content="SIGN IN"
                                Height="52"
                                Margin="0,24,0,0"
                                Style="{StaticResource SignInButtonStyle}"
                                Click="SignIn_Click"/>

                        <Button x:Name="ForgotPasswordButton"
                                Content="Forgot password?"
                                Height="34"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Center"
                                Click="ForgotPassword_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="{StaticResource Cerulean}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="ExitButton"
                                Content="Exit"
                                Height="44"
                                Margin="0,12,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="Exit_Click"/>

                        <TextBlock Text="Sign-in identifies who signs each document and audit entry. The password is never saved."
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,24,0,0"
                                   Foreground="{StaticResource Cerulean}"/>

                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{StaticResource Frost}"
                                   Opacity="0.7"
                                   Margin="0,16,0,0">
                            <Run Text="Version"/>
                            <Run Text=" "/>
                            <Run Text="{x:Static updates:AppInfo.Version}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
