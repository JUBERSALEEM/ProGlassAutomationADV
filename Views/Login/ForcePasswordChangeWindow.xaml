<Window x:Class="ProGlassAutomation.Views.Login.ForcePasswordChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change password required — ProGlass Automation"
        Width="460"
        Height="620"
        MinWidth="460"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource ModuleBackgroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AuthSurfaceStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- ═══ NAVY GLASS STAGE — same visual language as the login ═══ -->
    <Grid Background="{StaticResource PageBg}">
        <Ellipse Width="300" Height="300"
                 Fill="{StaticResource OrbRight}"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-110,-90,0" IsHitTestVisible="False"/>
        <Ellipse Width="260" Height="260"
                 Fill="{StaticResource OrbLeft}"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-80,0,0,-80" IsHitTestVisible="False"/>

        <!-- ═══ FROSTED GLASS CARD ═══ -->
        <Border Width="420"
                Margin="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                Background="{StaticResource LiquidCard}"
                BorderBrush="{DynamicResource GlassBorderSoft}"
                BorderThickness="1"
                Effect="{StaticResource CardShadow}"
                SnapsToDevicePixels="True">
            <Grid>
                <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                        Background="{StaticResource CardSheen}"
                        IsHitTestVisible="False"/>

                <Grid Margin="28,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ── HEADER ─────────────────────────────────────── -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="{DynamicResource CardCornerRadius}" Margin="0,0,12,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{DynamicResource WarningColor}" Offset="0"/>
                                        <GradientStop Color="{DynamicResource AccentColor}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="{StaticResource TextTitle}" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Security: change your password"
                                           FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                           Foreground="White"/>
                                <TextBlock Text="Default credentials must be replaced"
                                           FontSize="{StaticResource TextBody}"
                                           Foreground="{StaticResource Frost}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="For your security you must replace the default sign-in password before continuing."
                                   TextWrapping="Wrap"
                                   FontSize="{StaticResource TextBody}"
                                   TextAlignment="Center"
                                   Foreground="{StaticResource Cerulean}"
                                   Margin="8,10,8,0"/>
                        <Rectangle Style="{StaticResource HairlineStyle}" Margin="0,14,0,0"/>
                    </StackPanel>

                    <!-- ── FORM (scrollable so it never clips) ─────────── -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False"
                                  FocusVisualStyle="{x:Null}">
                        <StackPanel>
                            <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="UsernameBox"
                                     Tag="&#xE77B;"
                                     Style="{StaticResource RoundedTextBox}"
                                     IsReadOnly="True"
                                     IsTabStop="False"/>

                            <TextBlock Text="CURRENT PASSWORD" Style="{StaticResource FieldLabel}"
                                       Margin="2,12,0,6"/>
                            <PasswordBox x:Name="CurrentPasswordBox"
                                         Tag="&#xE72E;"
                                         Style="{StaticResource RoundedPasswordBox}"/>

                            <TextBlock Text="NEW PASSWORD" Style="{StaticResource FieldLabel}"
                                       Margin="2,12,0,6"/>
                            <PasswordBox x:Name="NewPasswordBox"
                                         Tag="&#xE72E;"
                                         Style="{StaticResource RoundedPasswordBox}"/>

                            <TextBlock Text="CONFIRM NEW PASSWORD" Style="{StaticResource FieldLabel}"
                                       Margin="2,12,0,6"/>
                            <PasswordBox x:Name="ConfirmPasswordBox"
                                         Tag="&#xE72E;"
                                         Style="{StaticResource RoundedPasswordBox}"/>

                            <TextBlock Text="Minimum 8 characters."
                                       FontSize="{StaticResource TextCaption}"
                                       Foreground="{StaticResource Cerulean}"
                                       Margin="2,8,0,0"/>

                            <!-- Error -->
                            <Border x:Name="ErrorPanel"
                                    Margin="0,14,0,0" Padding="12,9"
                                    CornerRadius="10"
                                    Background="{DynamicResource DangerSurfaceBrush}"
                                    BorderBrush="{StaticResource DangerOnLiquid}"
                                    BorderThickness="1"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA39;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="{StaticResource TextBodyLarge}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,9,0"
                                               Foreground="{StaticResource DangerOnLiquid}"/>
                                    <TextBlock x:Name="ErrorText"
                                               FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               MaxWidth="330"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource DangerOnLiquid}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── FOOTER ─────────────────────────────────────── -->
                    <Border Grid.Row="2"
                            BorderBrush="{DynamicResource GlassBorderSoft}"
                            BorderThickness="0,1,0,0"
                            Background="{StaticResource LiquidCard}"
                            CornerRadius="0,0,12,12"
                            Padding="16,12"
                            Margin="0,12,-8,-8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CancelButton"
                                    Content="Sign out"
                                    Style="{StaticResource OutlinedPillButton}"
                                    Margin="0,0,10,0"
                                    IsCancel="True"
                                    Click="Cancel_Click"
                                    ToolTip="Sign out without changing the password"/>
                            <Button x:Name="SaveButton"
                                    Content="SAVE &amp; CONTINUE"
                                    Style="{StaticResource PrimaryPillButton}"
                                    IsDefault="True"
                                    Click="Save_Click"
                                    ToolTip="Save the new password and continue"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
