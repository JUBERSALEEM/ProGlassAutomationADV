<Window x:Class="ProGlassAutomation.Views.Login.ForcePasswordChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change password required — ProGlass Automation"
        MinWidth="460"
        MinHeight="600"
        Width="460"
        Height="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid>
        <Border Style="{StaticResource DialogCardStyle}" Margin="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="2,4,2,14">
                    <TextBlock Text="&#xE72E;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="30"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="Security: change your password"
                               Style="{StaticResource DialogTitleStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                    <TextBlock Text="For your security you must replace the default sign-in password before continuing."
                               TextWrapping="Wrap"
                               FontSize="12.5"
                               TextAlignment="Center"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Margin="8,8,8,0"/>
                </StackPanel>

                <!-- Form (scrollable so it never clips on short windows) -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False"
                              FocusVisualStyle="{x:Null}">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="USERNAME"
                                   FontSize="10.5" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Margin="2,0,0,6"/>
                        <TextBox x:Name="UsernameBox"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 IsReadOnly="True"
                                 IsTabStop="False"/>

                        <TextBlock Text="CURRENT PASSWORD"
                                   FontSize="10.5" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Margin="2,14,0,6"/>
                        <PasswordBox x:Name="CurrentPasswordBox"
                                     Style="{StaticResource ModernPasswordBoxStyle}"/>

                        <TextBlock Text="NEW PASSWORD"
                                   FontSize="10.5" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Margin="2,14,0,6"/>
                        <PasswordBox x:Name="NewPasswordBox"
                                     Style="{StaticResource ModernPasswordBoxStyle}"/>

                        <TextBlock Text="CONFIRM NEW PASSWORD"
                                   FontSize="10.5" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Margin="2,14,0,6"/>
                        <PasswordBox x:Name="ConfirmPasswordBox"
                                     Style="{StaticResource ModernPasswordBoxStyle}"/>

                        <TextBlock Text="Minimum 8 characters."
                                   FontSize="10.5"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Margin="2,8,0,0"/>

                        <!-- Error -->
                        <Border x:Name="ErrorPanel"
                                Margin="0,14,0,0" Padding="12,9"
                                CornerRadius="10"
                                Background="{DynamicResource WindowBackgroundBrush}"
                                BorderBrush="{DynamicResource DangerBrush}"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA39;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="0,0,9,0"
                                           Foreground="{DynamicResource DangerBrush}"/>
                                <TextBlock x:Name="ErrorText"
                                           FontSize="11.5" FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           MaxWidth="330"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource DangerBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton"
                                Content="Sign out"
                                Style="{StaticResource OutlinedPillButton}"
                                Margin="0,0,10,0"
                                Click="Cancel_Click"/>
                        <Button x:Name="SaveButton"
                                Content="SAVE &amp; CONTINUE"
                                Style="{StaticResource PrimaryPillButton}"
                                Click="Save_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
