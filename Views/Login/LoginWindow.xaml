<Window x:Class="ProGlassAutomation.Views.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:updates="clr-namespace:ProGlassAutomation.Services.Updates"
        Title="Sign in — ProGlass Automation"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- ── Full-bleed brand background, THEME-DRIVEN ──────────────────
             Built from the accent colour resources that ThemeManager swaps,
             so it follows Light/Dark and the Monet/Professional families
             instead of hardcoding a single blue. -->
        <LinearGradientBrush x:Key="LoginBrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource AccentDarkColor}" Offset="0.0"/>
            <GradientStop Color="{DynamicResource AccentColor}" Offset="0.62"/>
            <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Soft glow behind the card for depth (accent-driven, faint). -->
        <RadialGradientBrush x:Key="LoginGlow"
                             GradientOrigin="0.5,0.42" Center="0.5,0.42"
                             RadiusX="0.55" RadiusY="0.55">
            <GradientStop Color="{DynamicResource AccentLightColor}" Offset="0.0"/>
            <GradientStop Color="{DynamicResource AccentLightColor}" Offset="0.6" />
            <GradientStop Color="{DynamicResource AccentColor}" Offset="1.0"/>
        </RadialGradientBrush>

        <DropShadowEffect x:Key="LoginCardShadow" po:Freeze="True"
                          BlurRadius="36" ShadowDepth="10"
                          Direction="270" Opacity="0.30" Color="#050A14"/>

        <!-- ── Form field label ─────────────────────────────────────────── -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <!-- Rounded input chrome. TextBox and PasswordBox do not share a
             common templated base, so each gets its own template. -->
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome"
                                CornerRadius="12"
                                Background="{DynamicResource WindowBackgroundBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="{StaticResource CardBorderThickness}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <ScrollViewer Grid.Column="1"
                                              x:Name="PART_ContentHost"
                                              Margin="12,0,14,0"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="1.6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedPasswordBox" TargetType="PasswordBox">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Chrome"
                                CornerRadius="12"
                                Background="{DynamicResource WindowBackgroundBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="{StaticResource CardBorderThickness}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <ScrollViewer Grid.Column="1"
                                              x:Name="PART_ContentHost"
                                              Margin="12,0,14,0"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="1.6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action -->
        <Style x:Key="SignInButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                CornerRadius="12"
                                Background="{DynamicResource AccentBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="{StaticResource CardBorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource AccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                CornerRadius="12"
                                Background="Transparent"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="{StaticResource CardBorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Full-bleed branded stage with ONE centered floating card. Everything
         lives inside the card (vertical StackPanel), so nothing can overlap;
         the card scrolls on very short windows instead of clipping. -->
    <Grid Background="{DynamicResource WindowBackgroundBrush}">

        <!-- Full-bleed theme-driven brand background -->
        <Rectangle Fill="{StaticResource LoginBrandGradient}"/>
        <Rectangle Fill="{StaticResource LoginGlow}" Opacity="0.35" IsHitTestVisible="False"/>

        <Border Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="22"
                Background="{DynamicResource ModuleBackgroundBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="{StaticResource CardBorderThickness}"
                Effect="{StaticResource LoginCardShadow}"
                SnapsToDevicePixels="True">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          Focusable="False"
                          FocusVisualStyle="{x:Null}">
                <Border Padding="38,34,38,30">
                <StackPanel>

                    <!-- App mark + name -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="56" Height="56"
                                CornerRadius="16"
                                SnapsToDevicePixels="True">
                            <Border.Background>
                                <ImageBrush ImageSource="pack://application:,,,/Resources/proglass_icon_256.png"
                                            Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="ProGlass Automation"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="Glass manufacturing ERP"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Welcome back"
                               FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,26,0,0"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="Sign in to continue to your workspace"
                               FontSize="12.5"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                    <!-- First-run credential hint -->
                    <Border x:Name="DefaultCredWarning"
                            Margin="0,22,0,0" Padding="14,11"
                            CornerRadius="12"
                            Background="{DynamicResource WindowBackgroundBrush}"
                            BorderBrush="{DynamicResource WarningBrush}"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       VerticalAlignment="Top"
                                       Margin="0,1,11,0"
                                       Foreground="{DynamicResource WarningBrush}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11"
                                       MaxWidth="300"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}">
                                <Run Text="First run:" FontWeight="Bold"/>
                                <Run Text="sign in as"/>
                                <Run Text="admin / admin" FontWeight="Bold"/>
                                <Run Text="— then change the password in User Center straight away."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"
                               Margin="2,24,0,6"/>
                    <TextBox x:Name="UsernameBox"
                             Height="46"
                             Tag="&#xE77B;"
                             Style="{StaticResource RoundedTextBox}"
                             KeyDown="Field_KeyDown"/>

                    <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}"
                               Margin="2,16,0,6"/>
                    <PasswordBox x:Name="PasswordBox"
                                 Height="46"
                                 Tag="&#xE72E;"
                                 Style="{StaticResource RoundedPasswordBox}"
                                 KeyDown="Field_KeyDown"/>

                    <Border x:Name="ErrorPanel"
                            Margin="0,14,0,0" Padding="12,9"
                            CornerRadius="10"
                            Background="{DynamicResource WindowBackgroundBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA39;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="0,0,9,0"
                                       Foreground="{DynamicResource DangerBrush}"/>
                            <TextBlock x:Name="ErrorText"
                                       FontSize="11.5" FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       MaxWidth="300"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource DangerBrush}"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="SignInButton"
                            Content="SIGN IN"
                            Height="46"
                            Margin="0,22,0,0"
                            Style="{StaticResource SignInButtonStyle}"
                            Click="SignIn_Click"/>

                    <Button x:Name="ExitButton"
                            Content="Exit"
                            Height="38"
                            Margin="0,10,0,0"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="Exit_Click"/>

                    <TextBlock Text="Sign-in identifies who signs each document and audit entry."
                               FontSize="10.5"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,20,0,0"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>

                    <TextBlock HorizontalAlignment="Center"
                               FontSize="10"
                               Opacity="0.6"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Margin="0,14,0,0">
                        <Run Text="Version"/>
                        <Run Text="{x:Static updates:AppInfo.Version}"/>
                    </TextBlock>
                </StackPanel>
                </Border>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
