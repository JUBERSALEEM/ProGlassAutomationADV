<Window x:Class="ProGlassAutomation.Views.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in — ProGlass Automation"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="LoginFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="LoginInput" TargetType="Control">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <!-- Full-screen stage, with the sign-in card centred on it. Filling the
         whole screen with form fields would look broken; a centred card on a
         maximized window is the standard full-screen sign-in shape. -->
    <Grid>
        <Border Width="460"
                Padding="40,36"
                CornerRadius="18"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Background="{DynamicResource ElevatedSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
        <StackPanel>

            <!-- Brand -->
            <TextBlock Text="&#xE7EE;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="34"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource AccentBrush}"/>

            <TextBlock Text="ProGlass Automation"
                       FontSize="21" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"
                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>

            <TextBlock Text="Sign in to continue"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>

            <!-- Default-credential warning -->
            <Border x:Name="DefaultCredWarning"
                    Margin="0,20,0,0" Padding="12,10" CornerRadius="8"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="15" VerticalAlignment="Top"
                               Margin="0,1,10,0"
                               Foreground="{DynamicResource WarningBrush}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11"
                               MaxWidth="300"
                               Foreground="{DynamicResource SecondaryForegroundBrush}">
                        <Run Text="First run:" FontWeight="Bold"/>
                        <Run Text="sign in as"/>
                        <Run Text="admin / admin" FontWeight="Bold"/>
                        <Run Text="— then change the password in User Center immediately."/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Username -->
            <TextBlock Text="USERNAME"
                       Style="{StaticResource LoginFieldLabel}"
                       Margin="0,22,0,5"/>
            <TextBox x:Name="UsernameBox"
                     Style="{StaticResource LoginInput}"
                     KeyDown="Field_KeyDown"/>

            <!-- Password -->
            <TextBlock Text="PASSWORD"
                       Style="{StaticResource LoginFieldLabel}"
                       Margin="0,14,0,5"/>
            <PasswordBox x:Name="PasswordBox"
                         Style="{StaticResource LoginInput}"
                         KeyDown="Field_KeyDown"/>

            <!-- Error -->
            <TextBlock x:Name="ErrorText"
                       FontSize="11" FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"
                       Foreground="{DynamicResource DangerBrush}"
                       Visibility="Collapsed"/>

            <!-- Sign in -->
            <Button x:Name="SignInButton"
                    Content="SIGN IN"
                    Height="42"
                    Margin="0,20,0,0"
                    FontSize="12" FontWeight="Bold"
                    Cursor="Hand"
                    FocusVisualStyle="{x:Null}"
                    Foreground="White"
                    Background="{DynamicResource AccentBrush}"
                    BorderThickness="0"
                    Click="SignIn_Click"/>

            <Button x:Name="ExitButton"
                    Content="EXIT"
                    Height="34"
                    Margin="0,10,0,0"
                    FontSize="11"
                    Cursor="Hand"
                    FocusVisualStyle="{x:Null}"
                    Background="Transparent"
                    Foreground="{DynamicResource MutedForegroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Click="Exit_Click"/>

            <TextBlock Text="Your data stays on this PC. Sign-in identifies who signs each document and audit entry."
                       FontSize="10"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,18,0,0"
                       Foreground="{DynamicResource MutedForegroundBrush}"/>
        </StackPanel>
        </Border>
    </Grid>
</Window>
