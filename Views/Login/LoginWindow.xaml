<Window x:Class="ProGlassAutomation.Views.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:updates="clr-namespace:ProGlassAutomation.Services.Updates"
        Title="Sign in — ProGlass Automation"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- Palette frozen once: these are brand colours for the sign-in
             stage specifically, so they intentionally do NOT follow the
             app theme the way in-app surfaces do. -->
        <SolidColorBrush x:Key="Ink"      Color="#070F22" po:Freeze="True"/>
        <SolidColorBrush x:Key="Royal"    Color="#1D4ED8" po:Freeze="True"/>
        <SolidColorBrush x:Key="Azure"    Color="#60A5FA" po:Freeze="True"/>
        <SolidColorBrush x:Key="Frost"    Color="#BFDBFE" po:Freeze="True"/>

        <LinearGradientBrush x:Key="BrandPanelBg" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
            <GradientStop Color="#0A1730" Offset="0.0"/>
            <GradientStop Color="#12275A" Offset="0.55"/>
            <GradientStop Color="#0B1B3D" Offset="1.0"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="BrandGlow" po:Freeze="True"
                             GradientOrigin="0.3,0.25" Center="0.3,0.25"
                             RadiusX="0.75" RadiusY="0.75">
            <GradientStop Color="#3B82F6" Offset="0.0"/>
            <GradientStop Color="#003B82F6" Offset="1.0"/>
        </RadialGradientBrush>

        <DropShadowEffect x:Key="CardShadow" po:Freeze="True"
                          BlurRadius="34" ShadowDepth="8"
                          Direction="270" Opacity="0.18" Color="#0F172A"/>

        <!-- Field label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <!-- Rounded input chrome. TextBox and PasswordBox do not share a
             common templated base beyond Control, so each gets its own
             template rather than a shared one. -->
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome"
                                CornerRadius="12"
                                Background="{DynamicResource ModuleBackgroundBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="1.5"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <ScrollViewer Grid.Column="1"
                                              x:Name="PART_ContentHost"
                                              Margin="12,0,14,0"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="1.6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedPasswordBox" TargetType="PasswordBox">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Chrome"
                                CornerRadius="12"
                                Background="{DynamicResource ModuleBackgroundBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="1.5"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <ScrollViewer Grid.Column="1"
                                              x:Name="PART_ContentHost"
                                              Margin="12,0,14,0"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="1.6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action -->
        <Style x:Key="SignInButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                CornerRadius="12"
                                Background="{DynamicResource AccentBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="1.5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource AccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                CornerRadius="12"
                                Background="Transparent"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="1.5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Left-panel feature line -->
        <Style x:Key="BrandPointStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Frost}"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BrandGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource Azure}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,13,0"/>
        </Style>
    </Window.Resources>

    <!-- Two-panel SaaS sign-in: brand story on the left, the form on the
         right. The whole thing is a single rounded card floating on a tinted
         stage so it reads as one deliberate object rather than a dialog
         dropped on an empty screen. -->
    <Grid Background="{DynamicResource WindowBackgroundBrush}">

        <Border MaxWidth="1040" MaxHeight="620"
                Margin="40"
                CornerRadius="22"
                Background="{DynamicResource ModuleBackgroundBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1.5"
                Effect="{StaticResource CardShadow}"
                SnapsToDevicePixels="True">

            <!-- Clip keeps the left panel's gradient inside the rounded
                 corners; without it the fill squares off the card. -->
            <Border CornerRadius="22" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ══ BRAND PANEL ══ -->
                    <Grid Grid.Column="0" Background="{StaticResource BrandPanelBg}">
                        <Rectangle Fill="{StaticResource BrandGlow}"
                                   Opacity="0.30"
                                   IsHitTestVisible="False"/>

                        <StackPanel Margin="46,0,46,0"
                                    VerticalAlignment="Center">

                            <!-- Icon on a frosted plate: the app icon is blue
                                 glass on blue, so it needs a light surface
                                 behind it to stay legible on this panel. -->
                            <Border Width="92" Height="92"
                                    CornerRadius="24"
                                    HorizontalAlignment="Left"
                                    SnapsToDevicePixels="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F2FFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#D9E8F2FF" Offset="0.6"/>
                                        <GradientStop Color="#BFD3E8FF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border Width="80" Height="80"
                                        CornerRadius="20"
                                        BorderBrush="#59FFFFFF"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <Border.Background>
                                        <ImageBrush ImageSource="pack://application:,,,/Resources/proglass_icon_256.png"
                                                    Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Border>

                            <TextBlock Text="ProGlass Automation"
                                       FontSize="27" FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,26,0,0"/>

                            <TextBlock Text="Glass manufacturing ERP, built for the UAE."
                                       FontSize="13.5"
                                       Foreground="{StaticResource Frost}"
                                       Opacity="0.85"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                            <Rectangle Height="1" Width="70"
                                       HorizontalAlignment="Left"
                                       Margin="0,26,0,26"
                                       Opacity="0.30"
                                       Fill="{StaticResource Azure}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="&#xE8A5;" Style="{StaticResource BrandGlyphStyle}"/>
                                <TextBlock Text="Quotation to tax invoice, tracked end to end"
                                           Style="{StaticResource BrandPointStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource BrandGlyphStyle}"/>
                                <TextBlock Text="FTA 5% VAT ready"
                                           Style="{StaticResource BrandPointStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="&#xE72E;" Style="{StaticResource BrandGlyphStyle}"/>
                                <TextBlock Text="Works offline — your data stays on this PC"
                                           Style="{StaticResource BrandPointStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81C;" Style="{StaticResource BrandGlyphStyle}"/>
                                <TextBlock Text="Every change signed in the audit trail"
                                           Style="{StaticResource BrandPointStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock VerticalAlignment="Bottom"
                                   Margin="46,0,0,26"
                                   FontSize="10.5"
                                   Opacity="0.55"
                                   Foreground="{StaticResource Frost}">
                            <Run Text="Version"/>
                            <Run Text="{x:Static updates:AppInfo.Version}"/>
                        </TextBlock>
                    </Grid>

                    <!-- ══ FORM PANEL ══ -->
                    <Grid Grid.Column="1">
                        <StackPanel Margin="52,0,52,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Welcome back"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="Sign in to continue to your workspace"
                                       FontSize="12.5"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                            <!-- First-run credential hint -->
                            <Border x:Name="DefaultCredWarning"
                                    Margin="0,20,0,0" Padding="14,11"
                                    CornerRadius="12"
                                    Background="{DynamicResource WindowBackgroundBrush}"
                                    BorderBrush="{DynamicResource WarningBrush}"
                                    BorderThickness="1"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="15"
                                               VerticalAlignment="Top"
                                               Margin="0,1,11,0"
                                               Foreground="{DynamicResource WarningBrush}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11"
                                               MaxWidth="270"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}">
                                        <Run Text="First run:" FontWeight="Bold"/>
                                        <Run Text="sign in as"/>
                                        <Run Text="admin / admin" FontWeight="Bold"/>
                                        <Run Text="— then change the password in User Center straight away."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"
                                       Margin="2,24,0,6"/>
                            <TextBox x:Name="UsernameBox"
                                     Height="46"
                                     Tag="&#xE77B;"
                                     Style="{StaticResource RoundedTextBox}"
                                     KeyDown="Field_KeyDown"/>

                            <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}"
                                       Margin="2,16,0,6"/>
                            <PasswordBox x:Name="PasswordBox"
                                         Height="46"
                                         Tag="&#xE72E;"
                                         Style="{StaticResource RoundedPasswordBox}"
                                         KeyDown="Field_KeyDown"/>

                            <Border x:Name="ErrorPanel"
                                    Margin="0,14,0,0" Padding="12,9"
                                    CornerRadius="10"
                                    Background="{DynamicResource WindowBackgroundBrush}"
                                    BorderBrush="{DynamicResource DangerBrush}"
                                    BorderThickness="1"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA39;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Margin="0,0,9,0"
                                               Foreground="{DynamicResource DangerBrush}"/>
                                    <TextBlock x:Name="ErrorText"
                                               FontSize="11.5" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               MaxWidth="280"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource DangerBrush}"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="SignInButton"
                                    Content="SIGN IN"
                                    Height="46"
                                    Margin="0,22,0,0"
                                    Style="{StaticResource SignInButtonStyle}"
                                    Click="SignIn_Click"/>

                            <Button x:Name="ExitButton"
                                    Content="Exit"
                                    Height="38"
                                    Margin="0,10,0,0"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Click="Exit_Click"/>

                            <TextBlock Text="Sign-in identifies who signs each document and audit entry."
                                       FontSize="10.5"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,20,0,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
