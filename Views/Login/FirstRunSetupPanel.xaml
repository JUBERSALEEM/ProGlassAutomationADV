<!--
  FirstRunSetupPanel — interactive first-run user setup wizard.

  Commit 5 of the licensing refactor replaces the
  admin/admin seed with an interactive first-run
  flow:

    * On a fresh install (empty Users table), the
      splash shows THIS panel instead of the
      LoginPanel.
    * The operator types a username, display name,
      and a password (twice) to create the first
      administrator.
    * On success, the panel transitions to the
      regular LoginPanel so the same operator can
      sign in with the credentials they just
      created.

  The visual chrome (frosted glass card, brand
  mark, field labels) matches LoginPanel so the
  first-run experience feels like a continuation of
  the splash, not a different app.

  No skip / no exit — the only escape is closing the
  whole splash window via the OS (the app cannot run
  without a user). A hint line at the bottom tells
  the operator what closing the window will do.
-->
<UserControl x:Class="ProGlassAutomation.Views.Login.FirstRunSetupPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:updates="clr-namespace:ProGlassAutomation.Services.Updates"
             PreviewKeyDown="Root_PreviewKeyDown"
             FontFamily="{DynamicResource AppFontFamily}"
             FontWeight="{DynamicResource AppFontWeight}"
             FontStyle="{DynamicResource AppFontStyle}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.BitmapScalingMode="HighQuality"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AuthSurfaceStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource PageBg}">
        <Ellipse Width="360" Height="360"
                 Fill="{DynamicResource OrbRight}"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-80,-80,0" IsHitTestVisible="False"/>
        <Ellipse Width="300" Height="300"
                 Fill="{DynamicResource OrbLeft}"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-80,0,0,-80" IsHitTestVisible="False"/>
        <Border Width="460"
                Margin="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="{DynamicResource CardCornerRadiusLarge}"
               
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="{DynamicResource Border.HairlineThickness}"
               
                SnapsToDevicePixels="True" Style="{StaticResource SurfacePrimaryStyle}">
            <Grid>
                <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                       
                        IsHitTestVisible="False" Style="{StaticResource SurfacePrimaryStyle}"/>
                <Border Padding="28,24"
                        CornerRadius="{DynamicResource CardCornerRadiusLarge}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  Focusable="False"
                                  FocusVisualStyle="{x:Null}">
                        <StackPanel>

                            <!-- ── BRAND ─────────────────────────────── -->
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="54" Height="54" CornerRadius="{DynamicResource Radius.Large}"
                                        SnapsToDevicePixels="True"
                                        HorizontalAlignment="Center">
                                    <Border.Background>
                                        <ImageBrush ImageSource="pack://application:,,,/Resources/proglass_icon_256.png"
                                                    Stretch="UniformToFill"/>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="22"
                                                          ShadowDepth="0" Opacity="0.28"/>
                                    </Border.Effect>
                                </Border>
                                <TextBlock Text="{DynamicResource Login.WelcomeProglass}"
                                           FontSize="{DynamicResource FontSize.H1}" FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource NameGradient}"
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,0"/>
                                <TextBlock Text="{DynamicResource Login.CreateFirstAdministratorAccount}"
                                           FontSize="{DynamicResource FontSize.Body}"
                                           Foreground="{DynamicResource Cerulean}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <Rectangle Style="{StaticResource HairlineStyle}" Margin="0,18,0,0"/>

                            <!-- ── HEADLINE COPY ─────────────────────── -->
                            <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{DynamicResource Ice}"
                                       Opacity="0.9"
                                       Margin="0,14,0,0"
                                       HorizontalAlignment="Center">
                                <Run Text="{DynamicResource Login.ProglassNeedsAdministratorGetStartedChoose}"/>
                            </TextBlock>

                            <!-- ── USERNAME ─────────────────────────── -->
                            <TextBlock Text="{DynamicResource Login.Username}" Style="{StaticResource FieldLabel}"
                                       Margin="2,18,0,6"/>
                            <TextBox x:Name="UsernameBox"
                                     Tag="&#xE77B;"
                                     Style="{StaticResource RoundedTextBox}"/>

                            <!-- ── DISPLAY NAME ─────────────────────── -->
                            <TextBlock Text="{DynamicResource Login.DisplayNAME}" Style="{StaticResource FieldLabel}"
                                       Margin="2,14,0,6"/>
                            <TextBox x:Name="DisplayNameBox"
                                     Tag="&#xE77B;"
                                     Style="{StaticResource RoundedTextBox}"/>

                            <!-- ── PASSWORD ─────────────────────────── -->
                            <TextBlock Text="{DynamicResource Login.Password}" Style="{StaticResource FieldLabel}"
                                       Margin="2,14,0,6"/>
                            <PasswordBox x:Name="PasswordBox"
                                         Tag="&#xE72E;"
                                         Style="{StaticResource RoundedPasswordBox}"
                                         PasswordChanged="PasswordBox_PasswordChanged"/>

                            <!-- ── STRENGTH METER ─────────────────────── -->
                            <StackPanel x:Name="PasswordMeter" Orientation="Horizontal" Margin="2,6,0,0">
                                <Border Height="5" Width="52" CornerRadius="{DynamicResource Radius.XSmall}" Margin="0,0,6,0" Background="{DynamicResource BorderDefaultBrush}" Style="{StaticResource SurfacePrimaryStyle}"/>
                                <Border Height="5" Width="52" CornerRadius="{DynamicResource Radius.XSmall}" Margin="0,0,6,0" Background="{DynamicResource BorderDefaultBrush}" Style="{StaticResource SurfacePrimaryStyle}"/>
                                <Border Height="5" Width="52" CornerRadius="{DynamicResource Radius.XSmall}" Margin="0,0,6,0" Background="{DynamicResource BorderDefaultBrush}" Style="{StaticResource SurfacePrimaryStyle}"/>
                                <Border Height="5" Width="52" CornerRadius="{DynamicResource Radius.XSmall}" Margin="0,0,8,0" Background="{DynamicResource BorderDefaultBrush}" Style="{StaticResource SurfacePrimaryStyle}"/>
                                <TextBlock x:Name="PasswordMeterLabel"
                                           FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="PasswordGuidance"
                                       TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{DynamicResource Frost}"
                                       Opacity="0.85"
                                       Margin="2,2,0,0"
                                       Visibility="Collapsed"/>

                            <!-- ── CONFIRM PASSWORD ─────────────────── -->
                            <TextBlock Text="{DynamicResource Login.ConfirmPassword}" Style="{StaticResource FieldLabel}"
                                       Margin="2,14,0,6"/>
                            <PasswordBox x:Name="ConfirmPasswordBox"
                                         Tag="&#xE72E;"
                                         Style="{StaticResource RoundedPasswordBox}"/>

                            <!-- ── PASSWORD RULES (small reminder) ───── -->
                            <TextBlock x:Name="PasswordHintText"
                                       TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{DynamicResource Frost}"
                                       Opacity="0.75"
                                       Margin="2,6,0,0">
                                <Run Text="{DynamicResource Login.PasswordMustLeast6CharactersChooseSomething}"/>
                            </TextBlock>

                            <!-- ── ERROR PANEL ───────────────────────── -->
                            <Border x:Name="ErrorPanel"
                                    Margin="0,14,0,0" Padding="13,10"
                                    CornerRadius="{DynamicResource Radius.Medium}"
                                    Background="{DynamicResource DangerSurfaceBrush}"
                                    BorderBrush="{DynamicResource DangerOnLiquid}"
                                    BorderThickness="{DynamicResource Border.HairlineThickness}"
                                    Visibility="Collapsed" Style="{StaticResource SurfacePrimaryStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA39;"
                                               FontFamily="{DynamicResource FontFamily.Icon}"
                                               FontSize="{DynamicResource FontSize.H3}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"
                                               Foreground="{DynamicResource DangerOnLiquid}"/>
                                    <TextBlock x:Name="ErrorText"
                                               FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.SemiBold}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource DangerOnLiquid}"/>
                                </StackPanel>
                            </Border>

                            <!-- ── THE SINGLE ACTION ─────────────────── -->
                            <Button x:Name="CreateButton"
                                    Content="{DynamicResource Login.CreateAdmin}"
                                    Height="44"
                                    Margin="0,16,0,0"
                                    Style="{StaticResource SignInButtonStyle}"
                                    Click="Create_Click"
                                    IsDefault="True"
                                    ToolTip="{DynamicResource Login.CreateFirstAdministratorContinueSign}"
                                    AutomationProperties.Name="Create administrator"/>

                            <!-- ── STATUS STRIP (busy / created) ─────── -->
                            <StackPanel x:Name="StatusStrip"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,12,0,0"
                                        Visibility="Hidden">
                                <Ellipse x:Name="CreateBusyDot" Width="8" Height="8"
                                         Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed"/>
                                <TextBlock x:Name="CreateStatusText"
                                           Text=""
                                           FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                           Foreground="{DynamicResource Ice}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Rectangle Style="{StaticResource HairlineStyle}" Margin="0,16,0,0"/>

                            <!-- ── FOOTER (no Exit — fresh install) ──── -->
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{DynamicResource Frost}"
                                       Opacity="0.65"
                                       Margin="0,10,0,0">
                                <Run Text="{DynamicResource About.Version}"/>
                                <Run Text=" "/>
                                <Run Text="{x:Static updates:AppInfo.Version}"/>
                            </TextBlock>
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Frost}"
                                       Opacity="0.55"
                                       Margin="0,6,0,0">
                                <Run Text="{DynamicResource Login.ClosingSplashExitAppProglassCannotRunWithout}"/>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
