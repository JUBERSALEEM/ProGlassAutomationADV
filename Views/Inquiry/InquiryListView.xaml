<UserControl x:Class="ProGlassAutomation.Views.Inquiry.InquiryListView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="Segoe UI" FontSize="13" Foreground="#111827"
 TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources>
  <SolidColorBrush x:Key="Blue" Color="#0967D8"/>
  <SolidColorBrush x:Key="Line" Color="#D9E0E8"/>
  <Style TargetType="Button"><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="14,7"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#26364A"/><Setter Property="BorderBrush" Value="#C7D1DD"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="BlueButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#0967D8"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#0967D8"/></Style>
  <Style TargetType="TextBox"><Setter Property="Height" Value="40"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Padding" Value="34,0,10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#D1D8E0"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Height" Value="40"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Padding" Value="11,5"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#D1D8E0"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#172033"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#DFE5EC"/><Setter Property="VerticalGridLinesBrush" Value="Transparent"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="47"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Height" Value="47"/><Setter Property="Background" Value="#F5F7FA"/><Setter Property="Foreground" Value="#1E293B"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="10,0"/><Setter Property="BorderBrush" Value="#D7DEE7"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
  <Style TargetType="DataGridRow"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F4F8FD"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EDF4FF"/><Setter Property="Foreground" Value="#102A56"/><Setter Property="BorderBrush" Value="#0967D8"/><Setter Property="BorderThickness" Value="3,0,0,0"/></Trigger></Style.Triggers></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style x:Key="DrawerLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#1F2937"/><Setter Property="Margin" Value="0,12,0,4"/></Style>
 </UserControl.Resources>

 <Grid Background="#F7F8FA">
  <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="118"/><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>

  <!-- Exact mockup header -->
  <Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="Inquiry Management" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
   <Button Grid.Column="1" Content="EXPORT" Command="{Binding ExportCommand}" Background="Transparent" BorderThickness="0" Foreground="#344054" Margin="18,0,0,0"/>
   <Button Grid.Column="3" Content="＋  NEW INQUIRY" Command="{Binding NewInquiryCommand}" Style="{StaticResource BlueButton}" VerticalAlignment="Center"/>
  </Grid>

  <!-- One continuous metric strip, not inherited cards -->
  <Border Grid.Row="1" Margin="24,0" Background="#FFFFFF" BorderBrush="#D6DEE7" BorderThickness="1" CornerRadius="9">
   <UniformGrid Columns="4">
    <Grid Margin="24,18"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="44" Height="44" CornerRadius="7" Background="#F0F2F6"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="#5C6675" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Total" FontSize="13"/><TextBlock Text="{Binding TotalCount, FallbackValue=128}" FontSize="28" FontWeight="Bold"/></StackPanel><Border Grid.Column="1" Width="1" Background="#DDE3EA" HorizontalAlignment="Right" Margin="0,0,-24,0"/></Grid>
    <Grid Margin="24,18"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="44" Height="44" CornerRadius="7" Background="#EAF2FF"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="#075FD8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Open" FontSize="13"/><TextBlock Text="{Binding OpenCount, FallbackValue=59}" FontSize="28" FontWeight="Bold"/></StackPanel><Border Grid.Column="1" Width="1" Background="#DDE3EA" HorizontalAlignment="Right" Margin="0,0,-24,0"/></Grid>
    <Grid Margin="24,18"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="44" Height="44" CornerRadius="7" Background="#E9F7F0"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#009B69" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Confirmed" FontSize="13"/><TextBlock Text="{Binding ConfirmedCount, FallbackValue=16}" FontSize="28" FontWeight="Bold"/></StackPanel><Border Grid.Column="1" Width="1" Background="#DDE3EA" HorizontalAlignment="Right" Margin="0,0,-24,0"/></Grid>
    <Grid Margin="24,18"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="44" Height="44" CornerRadius="7" Background="#EEF2FF"><TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#075FD8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Converted" FontSize="13"/><TextBlock Text="{Binding ConvertedCount, FallbackValue=39}" FontSize="28" FontWeight="Bold"/></StackPanel></Grid>
   </UniformGrid>
  </Border>

  <!-- Exact filter sequence from approved mockup -->
  <Grid Grid.Row="2" Margin="24,17,24,17"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="125"/><ColumnDefinition Width="112"/><ColumnDefinition Width="125"/><ColumnDefinition Width="112"/><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#667085" Margin="13,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search inquiry/customer/project"/></Grid>
   <ComboBox Grid.Column="1" Margin="10,0,0,0" ItemsSource="{Binding DateRanges}" SelectedItem="{Binding SelectedDateRange}"/>
   <ComboBox Grid.Column="2" Margin="10,0,0,0" ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}"/>
   <ComboBox Grid.Column="3" Margin="10,0,0,0" ItemsSource="{Binding Salesmen}" SelectedItem="{Binding SelectedSalesman}"/>
   <ComboBox Grid.Column="4" Margin="10,0,0,0" ItemsSource="{Binding Priorities}" SelectedItem="{Binding SelectedPriority}"/>
   <CheckBox Grid.Column="5" Content="Has Attachments" IsChecked="{Binding HasAttachmentsOnly}" VerticalAlignment="Center" Margin="12,0,0,0"/>
   <StackPanel Grid.Column="7" Orientation="Horizontal"><Button Content="RESET" Command="{Binding ResetFiltersCommand}"/><Button Content="↻  REFRESH" Command="{Binding RefreshCommand}" Style="{StaticResource BlueButton}" Margin="8,0,0,0"/></StackPanel>
  </Grid>

  <!-- Approved table columns and proportions -->
  <Border Grid.Row="3" Margin="24,0" Background="#FFFFFF" BorderBrush="#D6DEE7" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
   <DataGrid ItemsSource="{Binding Inquiries}" SelectedItem="{Binding SelectedInquiry, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
    <DataGrid.Columns>
     <DataGridTemplateColumn Width="40"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="Inquiry" Binding="{Binding InquiryNumber}" Width="120"/>
     <DataGridTextColumn Header="Received" Binding="{Binding ReceivedAt, StringFormat={}{0:dd MMM yyyy}}" Width="105"/>
     <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="145"/>
     <DataGridTextColumn Header="Project/Subject" Binding="{Binding Subject}" Width="*"/>
     <DataGridTextColumn Header="Salesman" Binding="{Binding Salesman}" Width="95"/>
     <DataGridTemplateColumn Header="Priority" Width="78"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border CornerRadius="4" Padding="7,3" HorizontalAlignment="Left"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#EEF0F3"/><Style.Triggers><DataTrigger Binding="{Binding Priority}" Value="High"><Setter Property="Background" Value="#FFDADA"/></DataTrigger><DataTrigger Binding="{Binding Priority}" Value="Medium"><Setter Property="Background" Value="#FFF0BF"/></DataTrigger><DataTrigger Binding="{Binding Priority}" Value="Low"><Setter Property="Background" Value="#E4E7EC"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Priority}" FontSize="10.5"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="Attachments" Width="92"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE723;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0"/><TextBlock Text="{Binding AttachmentCount}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="Status" Width="98"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#CFE0F8"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Confirmed"><Setter Property="Background" Value="#CDEEDC"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="In Progress"><Setter Property="Background" Value="#D9E5FA"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Converted"><Setter Property="Background" Value="#C8DBF7"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Cancelled"><Setter Property="Background" Value="#DEDFE1"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Status}" FontSize="10.5"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
  </Border>

  <DockPanel Grid.Row="4" Margin="24,0"><TextBlock Text="{Binding PageStatus, FallbackValue=Showing 1–50 of 128}" Foreground="#667085" VerticalAlignment="Center"/><TextBlock DockPanel.Dock="Right" Text="Select a row to open quick details" Foreground="#98A2B3" VerticalAlignment="Center"/></DockPanel>

  <!-- Drawer overlays KPI/filter/table exactly like approved image -->
  <Border Grid.Row="1" Grid.RowSpan="4" Width="410" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,-16,8,8" Background="#FFFFFF" BorderBrush="#D6DEE7" BorderThickness="1" CornerRadius="8" Panel.ZIndex="20" Visibility="{Binding IsDetailsDrawerOpen, Converter={StaticResource BoolToVisibilityConverter}}">
   <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.20" Color="#344054"/></Border.Effect>
   <Grid><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="142"/></Grid.RowDefinitions>
    <Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SelectedInquiry.InquiryNumber}" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/><Border Grid.Column="1" Background="#FFF0B8" CornerRadius="4" Padding="9,4" VerticalAlignment="Center"><TextBlock Text="{Binding SelectedInquiry.Status}" FontSize="11"/></Border><Button Grid.Column="2" Content="×" Command="{Binding CloseDetailsCommand}" FontSize="23" BorderThickness="0" Background="Transparent" Padding="0"/></Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="16,0,16,12">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Customer" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding SelectedInquiry.CustomerName}" Foreground="#174A8B" TextDecorations="Underline"/></Grid>
     <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Contact" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding SelectedInquiry.ContactSummary}"/></Grid>
     <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Project/Subject" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding SelectedInquiry.Subject}" TextWrapping="Wrap"/></Grid>
     <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Received" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding SelectedInquiry.ReceivedAt, StringFormat={}{0:dd MMM yyyy, hh:mm tt}}"/></Grid>
     <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Salesman" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding SelectedInquiry.Salesman}"/></Grid>
     <TextBlock Text="Notes Preview" FontWeight="SemiBold" Margin="0,12,0,3"/><TextBlock Text="{Binding SelectedInquiry.NotesPreview}" TextWrapping="Wrap" MaxHeight="56"/>
     <TextBlock Text="Attachments" Style="{StaticResource DrawerLabel}"/>
     <ItemsControl ItemsSource="{Binding SelectedInquiry.Attachments}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="#D92D20"/><TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/><Border Grid.Column="2" Background="#DDF3E7" CornerRadius="4" Padding="5,2"><TextBlock Text="{Binding ProcessingStatus}" HorizontalAlignment="Center" FontSize="10"/></Border></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="Linked Documents" Style="{StaticResource DrawerLabel}"/><Border Background="#F1F5FA" CornerRadius="5" Padding="9"><TextBlock Text="{Binding SelectedInquiry.DocumentChainText}"/></Border>
     <TextBlock Text="Recent Activity" Style="{StaticResource DrawerLabel}"/><ItemsControl ItemsSource="{Binding SelectedInquiry.RecentActivity}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="11" Margin="0,3" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="2" Margin="16,10"><Button Content="OPEN FULL WORKSPACE" Command="{Binding OpenWorkspaceCommand}" Style="{StaticResource BlueButton}" Margin="0,0,0,7"/><Button Content="CONVERT TO PI" Command="{Binding ConvertToPiCommand}" Margin="0,0,0,5"/><Button Content="View History" Command="{Binding ShowHistoryCommand}" BorderThickness="0" Background="Transparent" Foreground="#475467"/></StackPanel>
   </Grid>
  </Border>
 </Grid>
</UserControl>
