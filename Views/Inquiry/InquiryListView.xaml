<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Inquiry/InquiryListView.xaml
     MODULE: Inquiry register — Clean list + slide-in lifecycle rail
                                              (SheetStore pattern, applied)

     LAYOUT
     ──────
       Row 0   Header bar      title + subtitle + search + actions
       Row 1   KPI strip       4 cards: pipeline / open / awaiting / confirmed
       Row 2   Status tabs + filter row
       Row 3   Main list       dense single-line rows; no pipeline noise
       Row 4   Footer          result count + pagination

     SLIDE-IN RAIL (right, ~376px)
     ─────────────────────────────
       Hidden by default. Opens when a row is clicked; clicking the same
       row again closes it. Animation: ColumnDefinition.Width 0→376 plus
       TranslateTransform slide. Contains:
         • Title + status pill + priority chip
         • PIPELINE — vertical 6-stage list (INQ → PI → JO → DN → TI → STMT)
             with state dot, document number, status, "Open / Create" action
         • MONEY — total billed + outstanding
         • ACTIVITY — last 5 communications
         • ACTIONS — Open workspace, workflow transitions, Convert to PI

     DESIGN SYSTEM
     ─────────────
       Only shared primitives from DesignTokens / ListPageStyles / PillStyles
       / IconBadgeStyles. The previous module-local "InquiryTheme.xaml" is
       removed. No private vocabulary.
════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Inquiry.InquiryListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inq="clr-namespace:ProGlassAutomation.Models.Inquiry"
             x:Name="Root"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- Status-tinted left bar on each row.
             DataTrigger re-binds Background to a tinted brush per status. -->
        <Style x:Key="InquiryStatusSpineStyle" TargetType="Border">
            <Setter Property="Width" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Received">
                    <Setter Property="Background" Value="{DynamicResource InfoBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Prepared">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Sent">
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Confirmed">
                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Hold">
                    <Setter Property="Background" Value="{DynamicResource NeutralBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Status pill that picks its colour from the row's Status.
             Used in both the row and the right rail. -->
        <Style x:Key="InquiryStatusPillDynamicStyle" TargetType="Border"
               BasedOn="{StaticResource StatusPillBaseStyle}">
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Received">
                    <Setter Property="Background" Value="{DynamicResource InfoBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Prepared">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Sent">
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Confirmed">
                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Hold">
                    <Setter Property="Background" Value="{DynamicResource NeutralBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Compact initials tile for the customer cell.
             Reads CustomerInitials from the row. -->
        <Style x:Key="InquiryInitialsTileStyle" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Background" Value="{DynamicResource TintBlueBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InquiryInitialsTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Segmented status pill for the tab row above the list.
             Inactive = pale surface with grey text; active = accent surface.

             Note: this style is used inside a 7-column Grid that gives each
             tab 1/7 of the available width. The Margin / Padding below are
             tuned for that: a small vertical + horizontal pad, no right
             margin (the grid spacing handles the gap), and the content
             is centred horizontally so the label and count pill are
             visually balanced inside the cell. Count is hidden when 0 so
             the tab isn't a noisy "All 0" pill before any data lands. -->
        <Style x:Key="InquiryStatusTabStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,8"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{DynamicResource MenuHoverBrush}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <Border x:Name="CountPill" Margin="8,0,0,0" Padding="7,1.5" CornerRadius="12"
                                        Background="{DynamicResource ModuleBackgroundBrush}">
                                    <TextBlock Text="{Binding Count, Mode=OneWay}" FontSize="{StaticResource TextCaption}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource TintBlueBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                            </DataTrigger>
                            <!-- Hide the count pill when there are zero rows
                                 in this bucket. Showing "0" is noise. -->
                            <DataTrigger Binding="{Binding Count}" Value="0">
                                <Setter TargetName="CountPill" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One cell in the right-rail PIPELINE list.
             Has a 4px state dot on the left, a stage name, a document
             number, a status text, a relative date and an action button. -->
        <Style x:Key="PipelineStageRowStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="PipelineStageNameStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
        </Style>

        <Style x:Key="PipelineStageValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="PipelineStageMetaStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
        </Style>

        <!-- 4px state dot for a pipeline row -->
        <Style x:Key="PipelineStateDotStyle" TargetType="Border">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource NeutralBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ 1 · HEADER BAR ═══════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="24,18,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Inquiries" Style="{StaticResource ModulePageTitleStyle}"/>
                    <Border Margin="14,4,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="10,3" SnapsToDevicePixels="True">
                        <TextBlock Text="REGISTER" FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Commercial intake — capture, prepare, send, confirm, convert, deliver, bill, collect."
                           Style="{StaticResource ModulePageSubtitleStyle}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Margin="0,0,8,0" MinWidth="100"
                        Style="{StaticResource ModuleToolbarSecondaryButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="REFRESH" Tag="↻"/>
                <Button Margin="0,0,8,0" MinWidth="92"
                        Style="{StaticResource ModuleToolbarSecondaryButtonStyle}"
                        Command="{Binding ImportCommand}"
                        Content="IMPORT" Tag="↧"/>
                <Button Margin="0,0,8,0" MinWidth="92"
                        Style="{StaticResource ModuleToolbarSecondaryButtonStyle}"
                        Command="{Binding ExportCommand}"
                        Content="EXPORT" Tag="↥"/>
                <Button MinWidth="140"
                        Style="{StaticResource ModuleToolbarPrimaryButtonStyle}"
                        Command="{Binding NewInquiryCommand}"
                        Content="＋ NEW INQUIRY" Tag="＋"/>
            </StackPanel>
        </Grid>

        <!-- ══ 1.5 · NEW-PI-FROM-INQUIRY BANNER ═════════════════════
             Visible only when the user was sent here from the PI
             module's "Start from Inquiry" prompt. Tells them to pick
             a Confirmed inquiry (right-click → Convert) or cancel
             the round-trip. Cleared automatically on selection /
             cancel. -->
        <Border Grid.Row="1" Margin="24,0,24,0"
                Background="{DynamicResource TintAmberBrush}"
                BorderBrush="{DynamicResource WarningBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}"
                Padding="14,10" SnapsToDevicePixels="True"
                Visibility="{Binding IsAwaitingNewPiSelection, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⤴" FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                           Foreground="{DynamicResource WarningBrush}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1" Text="{Binding AwaitingNewPiBannerText}"
                           FontSize="{StaticResource TextBody}" Foreground="{DynamicResource PrimaryForegroundBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="Cancel"
                        Style="{StaticResource ModuleToolbarSecondaryButtonStyle}"
                        Command="{Binding CancelNewPiFromInquiryCommand}"
                        Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══ 2 · KPI STRIP ═══════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource ModuleListKpiStripStyle}" Margin="24,0,24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource ModuleListKpiIconStyle}"
                            Background="{DynamicResource TintGreenBrush}">
                        <TextBlock Text="AED" FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Pipeline value" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                        <TextBlock Text="{Binding PipelineValueText}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                        <TextBlock Text="Cancelled excluded" Style="{StaticResource ModuleListKpiHintStyle}"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource ModuleListKpiIconStyle}"
                            Background="{DynamicResource TintBlueBrush}">
                        <TextBlock Text="●" FontSize="{StaticResource TextSection}" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Open" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                        <TextBlock Text="{Binding OpenCount, Mode=OneWay}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                        <TextBlock Text="Received + prepared" Style="{StaticResource ModuleListKpiHintStyle}"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="3" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource ModuleListKpiIconStyle}"
                            Background="{DynamicResource TintAmberBrush}">
                        <TextBlock Text="◐" FontSize="{StaticResource TextBodyLarge}" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Awaiting customer" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                        <TextBlock Text="{Binding AwaitingCount, Mode=OneWay}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                        <TextBlock Text="Sent, waiting confirmation" Style="{StaticResource ModuleListKpiHintStyle}"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="5" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource ModuleListKpiIconStyle}"
                            Background="{DynamicResource TintGreenBrush}">
                        <TextBlock Text="✓" FontSize="{StaticResource TextBodyLarge}" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Confirmed" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                        <TextBlock Text="{Binding ConfirmedCount, Mode=OneWay}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                        <TextBlock Text="Ready to convert to PI" Style="{StaticResource ModuleListKpiHintStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ 3 · STATUS TABS + PIPELINE TABS + FILTER ROW ═══════ -->
        <Grid Grid.Row="3" Margin="24,0,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Status tabs (All / Received / Prepared / Sent / Confirmed / Hold / Cancelled).
                 Implemented as a 7-column Grid (not a StackPanel) so each
                 tab gets an equal 1/7 of the available width. The previous
                 StackPanel layout was collapsing on narrow windows and the
                 "Cancel inquiry" label was clipping into the next tab. -->
            <Border Grid.Row="0" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ItemsControl ItemsSource="{Binding StatusTabs}" Grid.ColumnSpan="7">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}"
                                        Command="{Binding ElementName=Root, Path=DataContext.SelectStatusTabCommand}"
                                        CommandParameter="{Binding Key}"
                                        Style="{StaticResource InquiryStatusTabStyle}"
                                        HorizontalContentAlignment="Stretch"
                                        HorizontalAlignment="Stretch"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Pipeline tabs (INQ / PI / JO / DN / TI / STMT).
                 Same full-width pattern as the status tabs above. This row
                 was wired in the VM (PipelineTabs collection, the
                 SelectPipelineTabCommand, the in-memory pipeline filter
                 in LoadAsync) but never bound to the UI — fixed now. The
                 "Inquiry" tab maps to the default (no filter); the rest
                 filter to inquiries that have reached that downstream
                 stage. -->
            <Border Grid.Row="1" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ItemsControl ItemsSource="{Binding PipelineTabs}" Grid.ColumnSpan="6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}"
                                        Command="{Binding ElementName=Root, Path=DataContext.SelectPipelineTabCommand}"
                                        CommandParameter="{Binding Kind}"
                                        Style="{StaticResource InquiryStatusTabStyle}"
                                        HorizontalContentAlignment="Stretch"
                                        HorizontalAlignment="Stretch"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Filter row — six inputs (search / date / salesman / prepared-by / priority / sort)
                 plus a "Has attachments" checkbox and the RESET button.
                 All controls span the row evenly; the checkbox sits next to
                 RESET so it doesn't crowd the date / sort combos. -->
            <Border Grid.Row="2" Style="{StaticResource ModuleListFilterBarStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             Style="{StaticResource ModuleListFilterInputStyle}"
                             ToolTip="Search inquiry number, customer, project, salesman or prepared by"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding DateRanges}"
                              SelectedItem="{Binding SelectedDateRange}"
                              Style="{StaticResource ModuleListFilterComboStyle}"
                              ToolTip="Received date range"/>
                    <ComboBox Grid.Column="4" ItemsSource="{Binding Salesmen}"
                              SelectedItem="{Binding SelectedSalesman}"
                              Style="{StaticResource ModuleListFilterComboStyle}"
                              ToolTip="Salesman"/>
                    <ComboBox Grid.Column="6" ItemsSource="{Binding PreparedByUsers}"
                              SelectedItem="{Binding SelectedPreparedBy}"
                              Style="{StaticResource ModuleListFilterComboStyle}"
                              ToolTip="Prepared by"/>
                    <ComboBox Grid.Column="8" ItemsSource="{Binding Priorities}"
                              SelectedItem="{Binding SelectedPriority}"
                              Style="{StaticResource ModuleListFilterComboStyle}"
                              ToolTip="Priority"/>
                    <ComboBox Grid.Column="10" ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSort}"
                              Style="{StaticResource ModuleListFilterComboStyle}"
                              ToolTip="Sort order"/>
                    <CheckBox Grid.Column="12" Content="Has attachments"
                              VerticalAlignment="Center" Margin="4,0,0,0"
                              IsChecked="{Binding HasAttachmentsOnly}"
                              ToolTip="Show only inquiries that have at least one attachment"/>
                    <Button Grid.Column="14" MinWidth="92" Margin="8,0,0,0"
                            Style="{StaticResource ModuleToolbarSecondaryButtonStyle}"
                            Command="{Binding ResetFiltersCommand}"
                            Content="RESET" Tag="↺"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ══ 4 · MAIN LIST + SLIDE-IN RAIL ═════════════════════════ -->
        <Grid Grid.Row="4" Margin="24,0,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="DetailColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- ── Main list (takes full width when rail is closed) ── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Sticky column header (accent) -->
                <Border Grid.Row="0"
                        Background="{DynamicResource AccentBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="12,12,0,0" Padding="14,10"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="INQ#"
                                   Style="{StaticResource ModuleListHeaderTextStyle}"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock Grid.Column="1" Text="STATUS"
                                   Style="{StaticResource ModuleListHeaderTextStyle}"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock Grid.Column="2" Text="CUSTOMER"
                                   Style="{StaticResource ModuleListHeaderTextStyle}"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock Grid.Column="3" Text="PROJECT"
                                   Style="{StaticResource ModuleListHeaderTextStyle}"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock Grid.Column="4" Text="VALUE" Margin="0,0,8,0"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource ModuleListHeaderTextStyle}"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock Grid.Column="5" Text="RECEIVED"
                                   Style="{StaticResource ModuleListHeaderTextStyle}"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock Grid.Column="6" Text="OWNER"
                                   Style="{StaticResource ModuleListHeaderTextStyle}"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                    </Grid>
                </Border>

                <!-- Virtualized inquiry rows -->
                <Border Grid.Row="1"
                        Background="{DynamicResource ModuleBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="1,0,1,1"
                        CornerRadius="0,0,12,12"
                        SnapsToDevicePixels="True">
                    <ListBox x:Name="InquiriesList"
                             ItemsSource="{Binding Inquiries}"
                             ItemContainerStyle="{StaticResource ModuleListBoxItemStyle}"
                             SelectedItem="{Binding SelectedInquiry, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="8,6,8,8"
                             Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             VirtualizingStackPanel.ScrollUnit="Pixel"
                             VirtualizingStackPanel.CacheLength="400,800"
                             VirtualizingStackPanel.CacheLengthUnit="Pixel"
                             ScrollViewer.CanContentScroll="True"
                             MouseDoubleClick="OnRowDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ModuleListRowStyle}"
                                        Cursor="Hand"
                                        Tag="{Binding DataContext, ElementName=Root}"
                                        MouseLeftButtonUp="OnRowClick">
                                    <!-- Right-click row context menu.

                                         Senior fix: ContextMenu lives in a Popup,
                                         outside the normal visual tree, so it does
                                         NOT reliably see ElementName=Root command
                                         bindings. We therefore bind the menu's
                                         DataContext to its PlacementTarget row and
                                         stash the InquiryListViewModel on the row
                                         Border.Tag. Every command below resolves
                                         through PlacementTarget.Tag, which is the
                                         real VM instance, while CommandParameter
                                         stays the right-clicked row. -->
                                    <Border.ContextMenu>
                                        <ContextMenu Style="{DynamicResource ModernContextMenuStyle}"
                                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <!-- Edit / Convert / Change status — the
                                                 three primary table actions. Edit
                                                 opens the inquiry editor; Convert
                                                 hands off to the Proforma Invoice
                                                 module; Change status is a submenu
                                                 gated by the workflow state machine. -->
                                            <MenuItem Header="Edit inquiry…"
                                                      Style="{DynamicResource ModernMenuItemStyle}"
                                                      Command="{Binding PlacementTarget.Tag.EditInquiryRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="Convert to Proforma Invoice"
                                                      Style="{DynamicResource ModernMenuItemStyle}"
                                                      Command="{Binding PlacementTarget.Tag.ConvertToPiRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"
                                                      IsEnabled="{Binding CanConvert}"/>
                                            <MenuItem Header="Change status"
                                                      Style="{DynamicResource ModernMenuItemStyle}">
                                                <MenuItem Header="Prepare"
                                                          Style="{DynamicResource ModernMenuItemStyle}"
                                                          IsEnabled="{Binding CanPrepareWorkflow}"
                                                          Command="{Binding PlacementTarget.Tag.PrepareRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"/>
                                                <MenuItem Header="Send"
                                                          Style="{DynamicResource ModernMenuItemStyle}"
                                                          IsEnabled="{Binding CanSendWorkflow}"
                                                          Command="{Binding PlacementTarget.Tag.SendRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"/>
                                                <MenuItem Header="Confirm"
                                                          Style="{DynamicResource ModernMenuItemStyle}"
                                                          IsEnabled="{Binding CanConfirmWorkflow}"
                                                          Command="{Binding PlacementTarget.Tag.ConfirmRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"/>
                                                <MenuItem Header="Hold"
                                                          Style="{DynamicResource ModernMenuItemStyle}"
                                                          IsEnabled="{Binding CanHoldWorkflow}"
                                                          Command="{Binding PlacementTarget.Tag.HoldRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"/>
                                                <MenuItem Header="Cancel inquiry"
                                                          Style="{DynamicResource ModernMenuItemStyle}"
                                                          IsEnabled="{Binding CanCancelWorkflow}"
                                                          Command="{Binding PlacementTarget.Tag.CancelRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"/>
                                            </MenuItem>
                                            <MenuItem Header="Change priority"
                                                      Style="{DynamicResource ModernMenuItemStyle}">
                                                <MenuItem Header="Urgent"
                                                          Style="{DynamicResource ModernMenuItemStyle}"
                                                          Command="{Binding PlacementTarget.Tag.SetUrgentPriorityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"/>
                                                <MenuItem Header="High"
                                                          Style="{DynamicResource ModernMenuItemStyle}"
                                                          Command="{Binding PlacementTarget.Tag.SetHighPriorityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"/>
                                                <MenuItem Header="Normal"
                                                          Style="{DynamicResource ModernMenuItemStyle}"
                                                          Command="{Binding PlacementTarget.Tag.SetNormalPriorityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"/>
                                                <MenuItem Header="Low"
                                                          Style="{DynamicResource ModernMenuItemStyle}"
                                                          Command="{Binding PlacementTarget.Tag.SetLowPriorityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"/>
                                            </MenuItem>
                                            <Separator Style="{DynamicResource ModernMenuSeparatorStyle}"/>
                                            <!-- Structural row actions. Duplicate is a
                                                 non-destructive copy; Delete is
                                                 destructive and the VM gates it
                                                 with a confirmation dialog wired by
                                                 the view plus the workflow service
                                                 permission check. -->
                                            <MenuItem Header="Duplicate inquiry"
                                                      Style="{DynamicResource ModernMenuItemStyle}"
                                                      Command="{Binding PlacementTarget.Tag.DuplicateInquiryRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="Delete inquiry"
                                                      Style="{DynamicResource ModernMenuItemStyle}"
                                                      Foreground="{DynamicResource DangerBrush}"
                                                      Command="{Binding PlacementTarget.Tag.DeleteInquiryRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"/>
                                            <Separator Style="{DynamicResource ModernMenuSeparatorStyle}"/>
                                            <MenuItem Header="Copy inquiry number"
                                                      Style="{DynamicResource ModernMenuItemStyle}"
                                                      Command="{Binding PlacementTarget.Tag.CopyInquiryNumberCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"/>
                                            <MenuItem Header="Copy summary"
                                                      Style="{DynamicResource ModernMenuItemStyle}"
                                                      Command="{Binding PlacementTarget.Tag.CopySummaryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"/>
                                            <MenuItem Header="Open attachments folder"
                                                      Style="{DynamicResource ModernMenuItemStyle}"
                                                      IsEnabled="{Binding HasAttachments}"
                                                      Command="{Binding PlacementTarget.Tag.OpenAttachmentsFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="117"/>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource InquiryStatusSpineStyle}"/>
                                        <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                                   Text="{Binding InquiryNumber}"
                                                   FontSize="{StaticResource TextBodyLarge}" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding InquiryNumber}"/>
                                        <Border Grid.Column="2" Margin="0,0,0,0"
                                                Style="{StaticResource InquiryStatusPillDynamicStyle}">
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                       Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="8,0,0,0">
                                            <Border Style="{StaticResource InquiryInitialsTileStyle}"
                                                    Margin="0,0,8,0">
                                                <TextBlock Text="{Binding CustomerInitials, Mode=OneWay}"
                                                           Style="{StaticResource InquiryInitialsTextStyle}"/>
                                            </Border>
                                            <TextBlock Text="{Binding CustomerName}"
                                                       FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding CustomerName}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="4" Margin="8,0,8,0"
                                                   Text="{Binding Project}"
                                                   FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Project}"/>
                                        <TextBlock Grid.Column="5" Margin="0,0,8,0"
                                                   Text="{Binding ValueText, Mode=OneWay}"
                                                   FontSize="{StaticResource TextBodyLarge}" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="6" Margin="0,0,0,0"
                                                   Text="{Binding ReceivedDateText, Mode=OneWay}"
                                                   FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="7" Margin="0,0,0,0"
                                                   Text="{Binding Salesman, Mode=OneWay}"
                                                   FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="58"
                                                   ToolTip="{Binding Salesman}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- ── Slide-in rail (right, ~376px) ── -->
            <Grid x:Name="DetailPanel" Grid.Column="1" Margin="14,0,0,0"
                  Visibility="Collapsed">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="PanelSlide" X="0"/>
                </Grid.RenderTransform>

                <Border Width="360"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource ModuleBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="20"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="5"
                                          Direction="270" Opacity="0.18"
                                          Color="#000000"/>
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Header -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40"
                                        CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                                        Background="{DynamicResource AccentBrush}"
                                        Grid.Column="0">
                                    <TextBlock Text="INQ"
                                               FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="LIFECYCLE"
                                               FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding SelectedInquiry.InquiryNumber}"
                                               FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Style="{StaticResource ModuleToolbarSecondaryButtonStyle}"
                                        Command="{Binding CloseDetailsCommand}"
                                        VerticalAlignment="Top"
                                        Padding="9,4" FontSize="{StaticResource TextBody}"
                                        Content="✕"/>
                            </Grid>

                            <!-- Selected inquiry summary -->
                            <TextBlock Text="{Binding SelectedInquiry.CustomerName}"
                                       FontSize="{StaticResource TextBodyLarge}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedInquiry.Project}"
                                       FontSize="{StaticResource TextBody}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"/>

                            <!-- PIPELINE — the killer section: 6 stages, each with
                                 a state dot, name, document number, status, action. -->
                            <TextBlock Text="PIPELINE"
                                       FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="0,18,0,8"/>

                            <!-- Stage 1 · INQUIRY (always exists) -->
                            <Border Style="{StaticResource PipelineStageRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource PipelineStateDotStyle}"
                                            Background="{DynamicResource AccentBrush}"
                                            Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="INQUIRY" Style="{StaticResource PipelineStageNameStyle}"/>
                                        <TextBlock Text="{Binding SelectedInquiry.InquiryNumber}"
                                                   Style="{StaticResource PipelineStageValueStyle}"/>
                                        <TextBlock Text="{Binding SelectedInquiry.Status}"
                                                   Style="{StaticResource PipelineStageMetaStyle}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="active"
                                               FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Stage 2 · PI -->
                            <Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Margin="0,0,10,0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource PipelineStateDotStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedInquiry.ProformaState}" Value="{x:Static inq:InquiryLifecycleState.NotStarted}">
                                                        <Setter Property="Background" Value="{DynamicResource NeutralBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedInquiry.ProformaState}" Value="{x:Static inq:InquiryLifecycleState.Draft}">
                                                        <Setter Property="Background" Value="{DynamicResource InfoBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedInquiry.ProformaState}" Value="{x:Static inq:InquiryLifecycleState.Active}">
                                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedInquiry.ProformaState}" Value="{x:Static inq:InquiryLifecycleState.Completed}">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedInquiry.ProformaState}" Value="{x:Static inq:InquiryLifecycleState.Skipped}">
                                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="PROFORMA INVOICE"
                                                   Style="{StaticResource PipelineStageNameStyle}"/>
                                        <TextBlock Text="{Binding SelectedInquiry.ProformaCellText}"
                                                   Style="{StaticResource PipelineStageValueStyle}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="Open"
                                            FontSize="{StaticResource TextCaption}" Padding="9,3"
                                            Style="{StaticResource ModuleToolbarSecondaryButtonStyle}"
                                            IsEnabled="{Binding SelectedInquiry.Lifecycle.HasProforma}"
                                            Command="{Binding ElementName=Root, Path=DataContext.OpenProformaForRowCommand}"
                                            CommandParameter="{Binding SelectedInquiry}"/>
                                </Grid>
                                <!-- Right-click context menu on the PI stage. -->
                                <Border.ContextMenu>
                                    <ContextMenu Style="{DynamicResource ModernContextMenuStyle}"
                                                 DataContext="{Binding PlacementTarget.DataContext.SelectedInquiry, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Open Proforma Invoice"
                                                  Style="{DynamicResource ModernMenuItemStyle}"
                                                  IsEnabled="{Binding Lifecycle.HasProforma}"
                                                  Command="{Binding PlacementTarget.DataContext.OpenProformaForRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Copy PI number"
                                                  Style="{DynamicResource ModernMenuItemStyle}"
                                                  IsEnabled="{Binding Lifecycle.HasProforma}"
                                                  Command="{Binding PlacementTarget.DataContext.CopyProformaNumberCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator Style="{DynamicResource ModernMenuSeparatorStyle}"/>
                                        <MenuItem Header="View inquiry workspace"
                                                  Style="{DynamicResource ModernMenuItemStyle}"
                                                  Command="{Binding PlacementTarget.DataContext.OpenWorkspaceRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource PipelineStageRowStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedInquiry.ProformaState}"
                                                         Value="{x:Static inq:InquiryLifecycleState.NotStarted}">
                                                <Setter Property="Opacity" Value="0.55"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Stage 3 · JO -->
                            <Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Margin="0,0,10,0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource PipelineStateDotStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedInquiry.JobOrderState}" Value="{x:Static inq:InquiryLifecycleState.NotStarted}">
                                                        <Setter Property="Background" Value="{DynamicResource NeutralBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedInquiry.JobOrderState}" Value="{x:Static inq:InquiryLifecycleState.Draft}">
                                                        <Setter Property="Background" Value="{DynamicResource InfoBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedInquiry.JobOrderState}" Value="{x:Static inq:InquiryLifecycleState.Active}">
                                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedInquiry.JobOrderState}" Value="{x:Static inq:InquiryLifecycleState.Completed}">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedInquiry.JobOrderState}" Value="{x:Static inq:InquiryLifecycleState.Skipped}">
                                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="JOB ORDER"
                                                   Style="{StaticResource PipelineStageNameStyle}"/>
                                        <TextBlock Text="{Binding SelectedInquiry.JobOrderCellText}"
                                                   Style="{StaticResource PipelineStageValueStyle}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="Open"
                                            FontSize="{StaticResource TextCaption}" Padding="9,3"
                                            Style="{StaticResource ModuleToolbarSecondaryButtonStyle}"
                                            IsEnabled="{Binding SelectedInquiry.Lifecycle.HasJobOrder}"
                                            Command="{Binding ElementName=Root, Path=DataContext.OpenJobOrderForRowCommand}"
                                            CommandParameter="{Binding SelectedInquiry}"/>
                                </Grid>
                                <Border.ContextMenu>
                                    <ContextMenu Style="{DynamicResource ModernContextMenuStyle}"
                                                 DataContext="{Binding PlacementTarget.DataContext.SelectedInquiry, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Open Job Order"
                                                  Style="{DynamicResource ModernMenuItemStyle}"
                                                  IsEnabled="{Binding Lifecycle.HasJobOrder}"
                                                  Command="{Binding PlacementTarget.DataContext.OpenJobOrderForRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Copy JO number"
                                                  Style="{DynamicResource ModernMenuItemStyle}"
                                                  IsEnabled="{Binding Lifecycle.HasJobOrder}"
                                                  Command="{Binding PlacementTarget.DataContext.CopyJobOrderNumberCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator Style="{DynamicResource ModernMenuSeparatorStyle}"/>
                                        <MenuItem Header="View inquiry workspace"
                                                  Style="{DynamicResource ModernMenuItemStyle}"
                                                  Command="{Binding PlacementTarget.DataContext.OpenWorkspaceRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource PipelineStageRowStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedInquiry.JobOrderState}"
                                                         Value="{x:Static inq:InquiryLifecycleState.NotStarted}">
                                                <Setter Property="Opacity" Value="0.55"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Stage 4 · DN -->
                            <Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Margin="0,0,10,0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource PipelineStateDotStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedInquiry.DeliveryNoteState}" Value="{x:Static inq:InquiryLifecycleState.NotStarted}">
                                                        <Setter Property="Background" Value="{DynamicResource NeutralBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedInquiry.DeliveryNoteState}" Value="{x:Static inq:InquiryLifecycleState.Draft}">
                                                        <Setter Property="Background" Value="{DynamicResource InfoBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedInquiry.DeliveryNoteState}" Value="{x:Static inq:InquiryLifecycleState.Active}">
                                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedInquiry.DeliveryNoteState}" Value="{x:Static inq:InquiryLifecycleState.Completed}">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedInquiry.DeliveryNoteState}" Value="{x:Static inq:InquiryLifecycleState.Skipped}">
                                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="DELIVERY NOTE"
                                                   Style="{StaticResource PipelineStageNameStyle}"/>
                                        <TextBlock Text="{Binding SelectedInquiry.DeliveryNoteCellText}"
                                                   Style="{StaticResource PipelineStageValueStyle}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="Open"
                                            FontSize="{StaticResource TextCaption}" Padding="9,3"
                                            Style="{StaticResource ModuleToolbarSecondaryButtonStyle}"
                                            IsEnabled="{Binding SelectedInquiry.Lifecycle.HasDeliveryNote}"
                                            Command="{Binding ElementName=Root, Path=DataContext.OpenDeliveryNoteForRowCommand}"
                                            CommandParameter="{Binding SelectedInquiry}"/>
                                </Grid>
                                <Border.ContextMenu>
                                    <ContextMenu Style="{DynamicResource ModernContextMenuStyle}"
                                                 DataContext="{Binding PlacementTarget.DataContext.SelectedInquiry, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Open Delivery Note"
                                                  Style="{DynamicResource ModernMenuItemStyle}"
                                                  IsEnabled="{Binding Lifecycle.HasDeliveryNote}"
                                                  Command="{Binding PlacementTarget.DataContext.OpenDeliveryNoteForRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Copy DN number"
                                                  Style="{DynamicResource ModernMenuItemStyle}"
                                                  IsEnabled="{Binding Lifecycle.HasDeliveryNote}"
                                                  Command="{Binding PlacementTarget.DataContext.CopyDeliveryNoteNumberCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator Style="{DynamicResource ModernMenuSeparatorStyle}"/>
                                        <MenuItem Header="View inquiry workspace"
                                                  Style="{DynamicResource ModernMenuItemStyle}"
                                                  Command="{Binding PlacementTarget.DataContext.OpenWorkspaceRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource PipelineStageRowStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedInquiry.DeliveryNoteState}"
                                                         Value="{x:Static inq:InquiryLifecycleState.NotStarted}">
                                                <Setter Property="Opacity" Value="0.55"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Stage 5 · TI -->
                            <Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Margin="0,0,10,0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource PipelineStateDotStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedInquiry.TaxInvoiceState}" Value="{x:Static inq:InquiryLifecycleState.NotStarted}">
                                                        <Setter Property="Background" Value="{DynamicResource NeutralBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedInquiry.TaxInvoiceState}" Value="{x:Static inq:InquiryLifecycleState.Draft}">
                                                        <Setter Property="Background" Value="{DynamicResource InfoBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedInquiry.TaxInvoiceState}" Value="{x:Static inq:InquiryLifecycleState.Active}">
                                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedInquiry.TaxInvoiceState}" Value="{x:Static inq:InquiryLifecycleState.Completed}">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedInquiry.TaxInvoiceState}" Value="{x:Static inq:InquiryLifecycleState.Skipped}">
                                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="TAX INVOICE"
                                                   Style="{StaticResource PipelineStageNameStyle}"/>
                                        <TextBlock Text="{Binding SelectedInquiry.TaxInvoiceCellText}"
                                                   Style="{StaticResource PipelineStageValueStyle}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="Open"
                                            FontSize="{StaticResource TextCaption}" Padding="9,3"
                                            Style="{StaticResource ModuleToolbarSecondaryButtonStyle}"
                                            IsEnabled="{Binding SelectedInquiry.Lifecycle.HasTaxInvoice}"
                                            Command="{Binding ElementName=Root, Path=DataContext.OpenTaxInvoiceForRowCommand}"
                                            CommandParameter="{Binding SelectedInquiry}"/>
                                </Grid>
                                <Border.ContextMenu>
                                    <ContextMenu Style="{DynamicResource ModernContextMenuStyle}"
                                                 DataContext="{Binding PlacementTarget.DataContext.SelectedInquiry, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Open Tax Invoice"
                                                  Style="{DynamicResource ModernMenuItemStyle}"
                                                  IsEnabled="{Binding Lifecycle.HasTaxInvoice}"
                                                  Command="{Binding PlacementTarget.DataContext.OpenTaxInvoiceForRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Copy TI number"
                                                  Style="{DynamicResource ModernMenuItemStyle}"
                                                  IsEnabled="{Binding Lifecycle.HasTaxInvoice}"
                                                  Command="{Binding PlacementTarget.DataContext.CopyTaxInvoiceNumberCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator Style="{DynamicResource ModernMenuSeparatorStyle}"/>
                                        <MenuItem Header="View inquiry workspace"
                                                  Style="{DynamicResource ModernMenuItemStyle}"
                                                  Command="{Binding PlacementTarget.DataContext.OpenWorkspaceRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource PipelineStageRowStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedInquiry.TaxInvoiceState}"
                                                         Value="{x:Static inq:InquiryLifecycleState.NotStarted}">
                                                <Setter Property="Opacity" Value="0.55"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Stage 6 · STMT -->
                            <Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Margin="0,0,10,0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource PipelineStateDotStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedInquiry.StatementState}" Value="{x:Static inq:InquiryLifecycleState.Completed}">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="STATEMENT"
                                                   Style="{StaticResource PipelineStageNameStyle}"/>
                                        <TextBlock Text="Generated from Tax Invoices"
                                                   Style="{StaticResource PipelineStageMetaStyle}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="Open"
                                            FontSize="{StaticResource TextCaption}" Padding="9,3"
                                            Style="{StaticResource ModuleToolbarSecondaryButtonStyle}"
                                            IsEnabled="{Binding SelectedInquiry.Lifecycle.HasStatement}"
                                            Command="{Binding ElementName=Root, Path=DataContext.OpenStatementForRowCommand}"
                                            CommandParameter="{Binding SelectedInquiry}"/>
                                </Grid>
                                <Border.ContextMenu>
                                    <ContextMenu Style="{DynamicResource ModernContextMenuStyle}"
                                                 DataContext="{Binding PlacementTarget.DataContext.SelectedInquiry, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Open Statement"
                                                  Style="{DynamicResource ModernMenuItemStyle}"
                                                  IsEnabled="{Binding Lifecycle.HasStatement}"
                                                  Command="{Binding PlacementTarget.DataContext.OpenStatementForRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Open statement module"
                                                  Style="{DynamicResource ModernMenuItemStyle}"
                                                  Command="{Binding PlacementTarget.DataContext.OpenStatementForRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator Style="{DynamicResource ModernMenuSeparatorStyle}"/>
                                        <MenuItem Header="View inquiry workspace"
                                                  Style="{DynamicResource ModernMenuItemStyle}"
                                                  Command="{Binding PlacementTarget.DataContext.OpenWorkspaceRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource PipelineStageRowStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedInquiry.StatementState}"
                                                         Value="{x:Static inq:InquiryLifecycleState.NotStarted}">
                                                <Setter Property="Opacity" Value="0.55"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- MONEY — total billed + outstanding -->
                            <TextBlock Text="MONEY"
                                       FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="0,16,0,8"/>
                            <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Background="{DynamicResource TintBlueBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1" Padding="12,8"
                                    Margin="0,0,0,6" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="TOTAL BILLED"
                                                   FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="{Binding SelectedInquiry.TotalBilledText}"
                                                   FontSize="{StaticResource TextSection}" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Background="{DynamicResource TintRedBrush}"
                                    BorderBrush="{DynamicResource DangerBrush}"
                                    BorderThickness="1" Padding="12,8"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="OUTSTANDING"
                                                   FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                   Foreground="{DynamicResource DangerBrush}"/>
                                        <TextBlock Text="{Binding SelectedInquiry.TotalOutstandingText}"
                                                   FontSize="{StaticResource TextSection}" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ACTIVITY — last 5 communications -->
                            <TextBlock Text="ACTIVITY"
                                       FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="0,16,0,8"/>
                            <ItemsControl ItemsSource="{Binding SelectedInquiry.RecentActivity}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="8" Height="8" CornerRadius="4"
                                                    Background="{DynamicResource AccentBrush}"
                                                    VerticalAlignment="Top" Margin="0,5,8,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                <TextBlock Text="{Binding OccurredText}"
                                                           FontSize="{StaticResource TextXSmall}"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="{StaticResource TextCaption}"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ACTIONS -->
                            <TextBlock Text="ACTIONS"
                                       FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="0,16,0,8"/>
                            <Button Style="{StaticResource ModuleToolbarPrimaryButtonStyle}"
                                    Content="OPEN WORKSPACE"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding OpenWorkspaceCommand}"/>
                            <WrapPanel>
                                <Button Content="Prepare" Margin="0,0,6,6"
                                        FontSize="{StaticResource TextBody}" Padding="11,5"
                                        Style="{StaticResource ModuleToolbarSecondaryButtonStyle}"
                                        Command="{Binding ChangeStatusCommand}"
                                        CommandParameter="Prepared"
                                        IsEnabled="{Binding SelectedInquiry.CanPrepareWorkflow}"/>
                                <Button Content="Send" Margin="0,0,6,6"
                                        FontSize="{StaticResource TextBody}" Padding="11,5"
                                        Style="{StaticResource ModuleToolbarSecondaryButtonStyle}"
                                        Command="{Binding ChangeStatusCommand}"
                                        CommandParameter="Sent"
                                        IsEnabled="{Binding SelectedInquiry.CanSendWorkflow}"/>
                                <Button Content="Confirm" Margin="0,0,6,6"
                                        FontSize="{StaticResource TextBody}" Padding="11,5"
                                        Style="{StaticResource ModuleToolbarSecondaryButtonStyle}"
                                        Command="{Binding ChangeStatusCommand}"
                                        CommandParameter="Confirmed"
                                        IsEnabled="{Binding SelectedInquiry.CanConfirmWorkflow}"/>
                                <Button Content="Hold" Margin="0,0,6,6"
                                        FontSize="{StaticResource TextBody}" Padding="11,5"
                                        Style="{StaticResource ModuleToolbarSecondaryButtonStyle}"
                                        Command="{Binding ChangeStatusCommand}"
                                        CommandParameter="Hold"
                                        IsEnabled="{Binding SelectedInquiry.CanHoldWorkflow}"/>
                                <Button Content="Cancel" Margin="0,0,0,6"
                                        FontSize="{StaticResource TextBody}" Padding="11,5"
                                        Style="{StaticResource ModuleToolbarSecondaryButtonStyle}"
                                        Command="{Binding ChangeStatusCommand}"
                                        CommandParameter="Cancelled"
                                        IsEnabled="{Binding SelectedInquiry.CanCancelWorkflow}"/>
                            </WrapPanel>
                            <Button Style="{StaticResource ModuleToolbarSecondaryButtonStyle}"
                                    Content="CONVERT TO PROFORMA INVOICE"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding ConvertToPiCommand}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- ══ 5 · FOOTER ═══════════════════════════════════════════ -->
        <Grid Grid.Row="5" Margin="24,0,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding PageStatus}" FontSize="{StaticResource TextBody}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button MinWidth="80" Margin="0,0,8,0"
                        Style="{StaticResource ModuleToolbarSecondaryButtonStyle}"
                        Command="{Binding PreviousPageCommand}"
                        Content="◀ PREV"/>
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" FontSize="{StaticResource TextBody}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}">
                    <Run Text="Page "/>
                    <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                    <Run Text=" of "/>
                    <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                </TextBlock>
                <Button MinWidth="80"
                        Style="{StaticResource ModuleToolbarSecondaryButtonStyle}"
                        Command="{Binding NextPageCommand}"
                        Content="NEXT ▶"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
