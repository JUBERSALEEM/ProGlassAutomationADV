<UserControl x:Class="ProGlassAutomation.Views.Inquiry.InquiryListView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="Segoe UI" FontSize="13" Foreground="#111827"
 TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources>
  <SolidColorBrush x:Key="Blue" Color="#0967D8"/>
  <SolidColorBrush x:Key="Line" Color="#D9E0E8"/>
  <Style TargetType="Button"><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="14,7"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#26364A"/><Setter Property="BorderBrush" Value="#C7D1DD"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="BlueButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#0967D8"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#0967D8"/></Style>
  <Style TargetType="TextBox"><Setter Property="Height" Value="40"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Padding" Value="34,0,10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#D1D8E0"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Height" Value="40"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Padding" Value="11,5"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#D1D8E0"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#172033"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#DFE5EC"/><Setter Property="VerticalGridLinesBrush" Value="Transparent"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="47"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Height" Value="47"/><Setter Property="Background" Value="#F5F7FA"/><Setter Property="Foreground" Value="#1E293B"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="10,0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#D7DEE7"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
  <Style TargetType="DataGridRow"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F4F8FD"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EDF4FF"/><Setter Property="Foreground" Value="#102A56"/><Setter Property="BorderBrush" Value="#0967D8"/><Setter Property="BorderThickness" Value="3,0,0,0"/></Trigger></Style.Triggers></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style x:Key="StatButton" TargetType="Button"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#E1E6ED"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Height" Value="78"/><Setter Property="Margin" Value="5,0"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#8CB7F0"/><Setter TargetName="Card" Property="Background" Value="#F8FBFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Card" Property="Background" Value="#EEF5FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="AttachmentToggle" TargetType="ToggleButton"><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="12,0"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#D5DCE6"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="16" Height="16" CornerRadius="4" BorderBrush="#98A2B3" BorderThickness="1.5" Background="White" Margin="0,0,8,0"><TextBlock x:Name="Tick" Text="✓" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Border><ContentPresenter VerticalAlignment="Center"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Shell" Property="Background" Value="#EEF5FF"/><Setter TargetName="Shell" Property="BorderBrush" Value="#6EA8F4"/><Setter TargetName="Box" Property="Background" Value="#0967D8"/><Setter TargetName="Box" Property="BorderBrush" Value="#0967D8"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#84AEE6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="DrawerLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#667085"/><Setter Property="Margin" Value="0,16,0,5"/></Style>
 </UserControl.Resources>

 <Grid Background="#F7F8FA">
  <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="118"/><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>

  <!-- Exact mockup header -->
  <Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center"><TextBlock Text="INQUIRIES" FontSize="28" FontWeight="Bold"/><TextBlock Text="Customer inquiries, communication history and commercial workflow" FontSize="12" Foreground="#667085" Margin="0,2,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0"><Button Content="EXPORT" Command="{Binding ExportCommand}" Background="Transparent" BorderThickness="0" Foreground="#344054"/><Button Content="IMPORT" Command="{Binding ImportCommand}" Background="Transparent" BorderThickness="0" Foreground="#344054"/></StackPanel>
   <Button Grid.Column="3" Content="＋  NEW INQUIRY" Command="{Binding NewInquiryCommand}" Style="{StaticResource BlueButton}" VerticalAlignment="Center"/>
  </Grid>

  <!-- One continuous metric strip, not inherited cards -->
  <Border Grid.Row="1" Margin="19,0" Background="Transparent" BorderThickness="0">
   <UniformGrid Columns="6">
    <Button Style="{StaticResource StatButton}" Command="{Binding FilterByStatisticCommand}" CommandParameter="All statuses"><Grid Margin="15,18"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="6" Background="#F0F2F6"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#5C6675" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="ALL INQUIRIES" FontSize="9.5" Foreground="#667085"/><TextBlock Text="{Binding TotalCount}" FontSize="24" FontWeight="Bold"/></StackPanel><Border Grid.Column="1" Width="1" Background="#DDE3EA" HorizontalAlignment="Right" Margin="0,0,-15,0"/></Grid></Button>
    <Button Style="{StaticResource StatButton}" Command="{Binding FilterByStatisticCommand}" CommandParameter="Received"><Grid Margin="15,18"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="6" Background="#EAF2FF"><TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#075FD8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="RECEIVED" FontSize="9.5" Foreground="#667085"/><TextBlock Text="{Binding ReceivedCount}" FontSize="24" FontWeight="Bold"/></StackPanel><Border Grid.Column="1" Width="1" Background="#DDE3EA" HorizontalAlignment="Right" Margin="0,0,-15,0"/></Grid></Button>
    <Button Style="{StaticResource StatButton}" Command="{Binding FilterByStatisticCommand}" CommandParameter="Sent"><Grid Margin="15,18"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="6" Background="#EEF2FF"><TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#475CC7" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="SENT" FontSize="9.5" Foreground="#667085"/><TextBlock Text="{Binding SentCount}" FontSize="24" FontWeight="Bold"/></StackPanel><Border Grid.Column="1" Width="1" Background="#DDE3EA" HorizontalAlignment="Right" Margin="0,0,-15,0"/></Grid></Button>
    <Button Style="{StaticResource StatButton}" Command="{Binding FilterByStatisticCommand}" CommandParameter="Confirmed"><Grid Margin="15,18"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="6" Background="#E9F7F0"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#009B69" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="CONFIRMED" FontSize="9.5" Foreground="#667085"/><TextBlock Text="{Binding ConfirmedCount}" FontSize="24" FontWeight="Bold"/></StackPanel><Border Grid.Column="1" Width="1" Background="#DDE3EA" HorizontalAlignment="Right" Margin="0,0,-15,0"/></Grid></Button>
    <Button Style="{StaticResource StatButton}" Command="{Binding FilterByStatisticCommand}" CommandParameter="Hold"><Grid Margin="15,18"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="6" Background="#FFF4D8"><TextBlock Text="&#xE769;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#B7791F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="ON HOLD" FontSize="9.5" Foreground="#667085"/><TextBlock Text="{Binding HoldCount}" FontSize="24" FontWeight="Bold"/></StackPanel><Border Grid.Column="1" Width="1" Background="#DDE3EA" HorizontalAlignment="Right" Margin="0,0,-15,0"/></Grid></Button>
    <Button Style="{StaticResource StatButton}" Command="{Binding FilterByStatisticCommand}" CommandParameter="Cancelled"><Grid Margin="15,18"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="6" Background="#FDECEC"><TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#C2413B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="CANCELLED" FontSize="9.5" Foreground="#667085"/><TextBlock Text="{Binding CancelledCount}" FontSize="24" FontWeight="Bold"/></StackPanel><Border Grid.Column="1" Width="1" Background="#DDE3EA" HorizontalAlignment="Right" Margin="0,0,-15,0"/></Grid></Button>
   </UniformGrid>
  </Border>

  <!-- 2026 SaaS command bar: search left, filters center, actions locked right -->
  <Border Grid.Row="2" Margin="24,14,24,12" Background="#FFFFFF" BorderBrush="#E1E6ED" BorderThickness="1" CornerRadius="10" Padding="10">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#667085" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search inquiry, customer, project, salesman or prepared by" BorderBrush="#D8DEE7"/></Grid>
    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="10,0"><StackPanel Orientation="Horizontal">
     <ComboBox Width="122" ItemsSource="{Binding DateRanges}" SelectedItem="{Binding SelectedDateRange}" ToolTip="Received date"/>
     <ComboBox Width="124" Margin="8,0,0,0" ItemsSource="{Binding Salesmen}" SelectedItem="{Binding SelectedSalesman}" ToolTip="Salesman"/>
     <ComboBox Width="138" Margin="8,0,0,0" ItemsSource="{Binding PreparedByUsers}" SelectedItem="{Binding SelectedPreparedBy}" ToolTip="Prepared By"/>
     <ToggleButton Style="{StaticResource AttachmentToggle}" Content="Has attachments" IsChecked="{Binding HasAttachmentsOnly}" Margin="8,0,0,0"/>
     <ComboBox Width="136" Margin="8,0,0,0" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" ToolTip="Sort register"/>
     <Grid Margin="8,0,0,0"><Button x:Name="MoreFiltersButton" Content="MORE FILTERS" Command="{Binding ToggleMoreFiltersCommand}"/><Popup IsOpen="{Binding IsMoreFiltersOpen}" PlacementTarget="{Binding ElementName=MoreFiltersButton}" Placement="Bottom" StaysOpen="False"><Border Background="White" BorderBrush="#D8DEE7" BorderThickness="1" CornerRadius="8" Padding="14" Width="220"><StackPanel><TextBlock Text="STATUS" FontSize="10" FontWeight="SemiBold" Foreground="#667085"/><ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}" Margin="0,5,0,12"/><TextBlock Text="PRIORITY" FontSize="10" FontWeight="SemiBold" Foreground="#667085"/><ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding SelectedPriority}" Margin="0,5,0,0"/></StackPanel></Border></Popup></Grid>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="RESET" Command="{Binding ResetFiltersCommand}" Background="#FFFFFF" Foreground="#475467" BorderBrush="#D8DEE7"/><Button Content="REFRESH" Command="{Binding RefreshCommand}" Style="{StaticResource BlueButton}" Margin="8,0,0,0"/></StackPanel>
   </Grid>
  </Border>

  <!-- Approved table columns and proportions -->
  <Border Grid.Row="3" Margin="24,0" Background="#FFFFFF" BorderBrush="#D6DEE7" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
   <Grid>
   <DataGrid ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ItemsSource="{Binding Inquiries}" SelectedItem="{Binding SelectedInquiry, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
    <DataGrid.Columns>
     <DataGridTemplateColumn Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="INQUIRY" Width="1.05*" MinWidth="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel HorizontalAlignment="Left"><TextBlock Text="{Binding InquiryNumber}" FontWeight="SemiBold"/><TextBlock Text="{Binding InquiryReference}" FontSize="10.5" Foreground="#7A8699"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="CUSTOMER" Width="1.25*" MinWidth="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel HorizontalAlignment="Left"><TextBlock Text="{Binding CustomerName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding CustomerLocation}" FontSize="10.5" Foreground="#7A8699" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="PROJECT" Width="1.45*" MinWidth="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel HorizontalAlignment="Left"><TextBlock Text="{Binding Project}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subject}" FontSize="10.5" Foreground="#7A8699" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="ATTACHMENTS" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding AttachmentBadgeText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#475467"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="SALESMAN" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Salesman}"/><TextBlock Text="Sales owner" FontSize="10.5" Foreground="#7A8699"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="PREPARED BY" Width="135"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding PreparedBy}"/><TextBlock Text="{Binding PreparedByRole}" FontSize="10.5" Foreground="#7A8699"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="RECEIVED" Width="128"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding ReceivedAt, StringFormat={}{0:dd MMM yyyy}}"/><TextBlock Text="{Binding ReceivedAt, StringFormat={}{0:hh:mm tt}}" FontSize="10.5" Foreground="#7A8699"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="LAST UPDATED" Width="128"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:dd MMM yyyy}}"/><TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:hh:mm tt}}" FontSize="10.5" Foreground="#7A8699"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Width="40"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="···" FontWeight="Bold" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoInquiries, Converter={StaticResource BoolToVisibilityConverter}}"><TextBlock Text="No inquiries found" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Try changing your filters or create a new inquiry." Foreground="#667085" Margin="0,6,0,12"/><Button Content="+ NEW INQUIRY" Command="{Binding NewInquiryCommand}" Style="{StaticResource BlueButton}" HorizontalAlignment="Center"/></StackPanel>
   <Border Background="#D9FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar IsIndeterminate="True" Width="180" Height="4"/><TextBlock Text="Loading inquiries…" Margin="0,10,0,0"/></StackPanel></Border>
   <Border Background="#FDF2F2" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Unable to load inquiries" FontSize="17" FontWeight="SemiBold" Foreground="#B42318"/><TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" MaxWidth="520" Margin="0,6,0,12"/><Button Content="RETRY" Command="{Binding RefreshCommand}"/></StackPanel></Border>
   </Grid>
  </Border>

  <DockPanel Grid.Row="4" Margin="24,0"><TextBlock Text="{Binding PageStatus}" Foreground="#667085" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="PREVIOUS" Command="{Binding PreviousPageCommand}" Height="30" Padding="10,3"/><TextBlock VerticalAlignment="Center" Margin="10,0"><Run Text="Page "/><Run Text="{Binding CurrentPage, Mode=OneWay}"/><Run Text=" of "/><Run Text="{Binding TotalPages, Mode=OneWay}"/></TextBlock><Button Content="NEXT" Command="{Binding NextPageCommand}" Height="30" Padding="10,3"/></StackPanel></DockPanel>

  <!-- Drawer overlays KPI/filter/table exactly like approved image -->
  <Border Grid.Row="1" Grid.RowSpan="4" Width="460" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,-16,8,8" Background="#FFFFFF" BorderBrush="#D6DEE7" BorderThickness="1" CornerRadius="8" Panel.ZIndex="20" RenderTransformOrigin="1,0.5">
   <Border.RenderTransform><TranslateTransform X="470"/></Border.RenderTransform>
   <Border.Style><Style TargetType="Border"><Setter Property="Opacity" Value="0"/><Setter Property="IsHitTestVisible" Value="False"/><Style.Triggers><DataTrigger Binding="{Binding IsDetailsDrawerOpen}" Value="True"><Setter Property="IsHitTestVisible" Value="True"/><DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.20"/><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.20"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.EnterActions><DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="470" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.ExitActions></DataTrigger></Style.Triggers></Style></Border.Style>
   <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.20" Color="#344054"/></Border.Effect>
   <Grid><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="142"/></Grid.RowDefinitions>
    <Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SelectedInquiry.InquiryNumber}" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/><Border Grid.Column="1" Background="#FFF0B8" CornerRadius="4" Padding="9,4" VerticalAlignment="Center"><TextBlock Text="{Binding SelectedInquiry.Status}" FontSize="11"/></Border><Button Grid.Column="2" Content="×" Command="{Binding CloseDetailsCommand}" FontSize="23" BorderThickness="0" Background="Transparent" Padding="0"/></Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="16,0,16,12">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Customer" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding SelectedInquiry.CustomerName}" Foreground="#174A8B" TextDecorations="Underline"/></Grid>
     <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Contact" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding SelectedInquiry.ContactSummary}"/></Grid>
     <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Project/Subject" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding SelectedInquiry.Subject}" TextWrapping="Wrap"/></Grid>
     <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Received" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding SelectedInquiry.ReceivedAt, StringFormat={}{0:dd MMM yyyy, hh:mm tt}}"/></Grid>
     <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Salesman" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding SelectedInquiry.Salesman}"/></Grid>
     <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Prepared By" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding SelectedInquiry.PreparedBy}"/></Grid>
     <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Inquiry Value" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding SelectedInquiry.InquiryValue, StringFormat=AED {0:N2}}"/></Grid>
     <TextBlock Text="Notes Preview" FontWeight="SemiBold" Margin="0,12,0,3"/><TextBlock Text="{Binding SelectedInquiry.NotesPreview}" TextWrapping="Wrap" MaxHeight="56"/>
     <TextBlock Text="Attachments" Style="{StaticResource DrawerLabel}"/>
     <ItemsControl ItemsSource="{Binding SelectedInquiry.Attachments}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="#596579"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding FileSizeDisplay}" FontSize="10" Foreground="#7A8699"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Extension}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/><Button Grid.Column="3" Content="OPEN" Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Height="28" Padding="5,2" FontSize="9"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="Linked Documents" Style="{StaticResource DrawerLabel}"/><Border Background="#F1F5FA" CornerRadius="5" Padding="9"><TextBlock Text="{Binding SelectedInquiry.DocumentChainText}"/></Border>
     <TextBlock Text="Recent Activity" Style="{StaticResource DrawerLabel}"/><ItemsControl ItemsSource="{Binding SelectedInquiry.RecentActivity}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="11" Margin="0,3" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="2" Margin="16,10"><Button Content="OPEN FULL WORKSPACE" Command="{Binding OpenWorkspaceCommand}" Style="{StaticResource BlueButton}" Margin="0,0,0,7"/><Button Content="CONVERT TO PI" Command="{Binding ConvertToPiCommand}" Margin="0,0,0,5"/><Button Content="View History" Command="{Binding ShowHistoryCommand}" BorderThickness="0" Background="Transparent" Foreground="#475467"/></StackPanel>
   </Grid>
  </Border>
 </Grid>
</UserControl>
