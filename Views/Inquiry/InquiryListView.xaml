                            </Border>
                            <Border CornerRadius="{DynamicResource Radius.Medium}"
                                    Background="{DynamicResource Ov.DangerSoft}"
                                    BorderBrush="{DynamicResource Ov.Danger}"
                                    BorderThickness="1" Padding="12,10"
                                    SnapsToDevicePixels="True">
                                <StackPanel>
                                    <TextBlock Text="OUTSTANDING"
                                               FontSize="{DynamicResource FontSize.Caption}" FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource Ov.Danger}"/>
                                    <TextBlock Text="{Binding SelectedInquiry.TotalOutstandingText}"
                                               FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource Ov.Ink}"
                                               Margin="0,2,0,0" Typography.NumeralAlignment="Tabular"/>
                                </StackPanel>
                            </Border>

                            <!-- ACTIVITY — last communications -->
                            <TextBlock Text="ACTIVITY"
                                       FontSize="{DynamicResource FontSize.Caption}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource Ov.Muted}"
                                       Margin="0,16,0,8"/>
                            <ItemsControl ItemsSource="{Binding SelectedInquiry.RecentActivity}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="8" Height="8" CornerRadius="{DynamicResource Radius.XSmall}"
                                                    Background="{DynamicResource Ov.Accent}"
                                                    VerticalAlignment="Top" Margin="0,5,10,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                           Foreground="{DynamicResource Ov.Ink}"/>
                                                <TextBlock Text="{Binding OccurredText}"
                                                           FontSize="{DynamicResource FontSize.Caption}"
                                                           Foreground="{DynamicResource Ov.Muted}"/>
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                                           Foreground="{DynamicResource Ov.Muted}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ACTIONS -->
                            <TextBlock Text="ACTIONS"
                                       FontSize="{DynamicResource FontSize.Caption}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource Ov.Muted}"
                                       Margin="0,14,0,8"/>
                            <Button Style="{StaticResource Sl.PrimaryButton}"
                                    Content="Open workspace" Tag="&#xE8A7;"
                                    Margin="0,0,0,8" HorizontalAlignment="Stretch"
                                    Command="{Binding OpenWorkspaceCommand}"/>
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="Prepare" Margin="0,0,6,6" Padding="10,6" MinHeight="30"
                                        Style="{StaticResource Sl.Button}"
                                        Command="{Binding ChangeStatusCommand}" CommandParameter="Prepared"
                                        IsEnabled="{Binding SelectedInquiry.CanPrepareWorkflow}"/>
                                <Button Content="Send" Margin="0,0,6,6" Padding="10,6" MinHeight="30"
                                        Style="{StaticResource Sl.Button}"
                                        Command="{Binding ChangeStatusCommand}" CommandParameter="Sent"
                                        IsEnabled="{Binding SelectedInquiry.CanSendWorkflow}"/>
                                <Button Content="Confirm" Margin="0,0,6,6" Padding="10,6" MinHeight="30"
                                        Style="{StaticResource Sl.Button}"
                                        Command="{Binding ChangeStatusCommand}" CommandParameter="Confirmed"
                                        IsEnabled="{Binding SelectedInquiry.CanConfirmWorkflow}"/>
                                <Button Content="Hold" Margin="0,0,6,6" Padding="10,6" MinHeight="30"
                                        Style="{StaticResource Sl.Button}"
                                        Command="{Binding ChangeStatusCommand}" CommandParameter="Hold"
                                        IsEnabled="{Binding SelectedInquiry.CanHoldWorkflow}"/>
                                <Button Content="Cancel" Margin="0,0,0,6" Padding="10,6" MinHeight="30"
                                        Style="{StaticResource Sl.DangerButton}"
                                        Command="{Binding ChangeStatusCommand}" CommandParameter="Cancelled"
                                        IsEnabled="{Binding SelectedInquiry.CanCancelWorkflow}"/>
                            </WrapPanel>
                            <Button Style="{StaticResource Sl.SuccessButton}"
                                    Content="Convert to Proforma Invoice" Tag="&#xE8AB;"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding ConvertToPiCommand}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- ══ 6 · FOOTER / PAGINATION ═══════════════════════════════ -->
        <Grid Grid.Row="5" Margin="16,0,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding PageStatus}" FontSize="{DynamicResource FontSize.Body}"
                       Foreground="{DynamicResource Ov.Muted}"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button MinWidth="84" Margin="0,0,8,0"
                        Style="{StaticResource Sl.Button}"
                        Command="{Binding PreviousPageCommand}"
                        Tag="&#xE76B;" Content="Prev"/>
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" FontSize="{DynamicResource FontSize.Body}"
                           Foreground="{DynamicResource Ov.Muted}">
                    <Run Text="Page "/>
                    <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                    <Run Text=" of "/>
                    <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                </TextBlock>
                <Button MinWidth="84"
                        Style="{StaticResource Sl.Button}"
                        Command="{Binding NextPageCommand}"
                        Tag="&#xE76C;" Content="Next"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
