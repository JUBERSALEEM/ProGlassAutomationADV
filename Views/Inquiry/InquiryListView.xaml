<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Inquiry/InquiryListView.xaml
     MODULE: Inquiry register — "Lumen" redesign

     Layout concept (functionality identical to the ViewModel contract):
       1. COMMAND DECK — one floating bar: identity + inline search + actions
       2. BENTO STATS — four oversized-number tiles
       3. STATUS RAIL — pill segments with live counts + compact filter cluster
       4. REGISTER — virtualized rows. Each row is a 7-column grid that
          lines up with the header (no off-grid children):
            col 0  SPINE  (4 px, status-tinted, no header label)
            col 1  ID     (inquiry number — identity column)
            col 2  INQUIRY(status pill + caller reference)
            col 3  CUSTOMER(avatar + customer name)
            col 4  PROJECT (project name)
            col 5  FILES · CHAIN (attachment chip + conversion chip)
            col 6  VALUE · RECEIVED · OWNERS
                          (date + time + salesman + prepared by | value)
       5. FOOTER — result count + round pagination
       6. DETAILS DRAWER — cover-tinted panel: workflow chips, fields,
          notes, attachment tiles, timeline, convert actions
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Inquiry.InquiryListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ProGlassAutomation.Converters"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="InquiryTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <conv:ReferenceEqualityConverter x:Key="RowSelectedConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="22,16,22,12">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ 1 · COMMAND DECK ═══════════════════════════════════════ -->
        <Border Style="{StaticResource InqSurfaceStyle}" Padding="18,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.10" Color="#475569"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="10"
                            Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="13,0,18,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Inquiries" Style="{StaticResource InqDisplayStyle}"/>
                            <Border Margin="9,1,0,0" Padding="8,2.5" VerticalAlignment="Center"
                                    CornerRadius="12"
                                    Background="{DynamicResource TintBlueBrush}">
                                <TextBlock FontSize="10.5" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="{Binding StatusTabs[0].Count, Mode=OneWay}"/>
                                    <Run Text=" records"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Commercial intake — capture, prepare, send, confirm, convert."
                                   Style="{StaticResource InqHintStyle}" Margin="1,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Inline search in the deck -->
                <Grid Grid.Column="1" Width="300" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border CornerRadius="10"
                            Background="{DynamicResource ModuleBackgroundBrush}"
                            BorderBrush="{DynamicResource OutlineStrongBrush}" BorderThickness="1" Height="36">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Border>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Height="36" Padding="34,0,10,0" BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource PrimaryForegroundBrush}"
                             VerticalContentAlignment="Center" FontSize="12.5"
                             CaretBrush="{DynamicResource PrimaryForegroundBrush}"
                             ToolTip="Search inquiry number, customer, project, salesman or prepared by"/>
                    <TextBlock Text="Search" FontSize="11" IsHitTestVisible="False" Margin="34,0,10,0"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource InqIconButtonStyle}"
                            Margin="0,0,8,0" ToolTip="Reload the register">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </Button>
                    <Button Content="Import" Command="{Binding ImportCommand}"
                            Style="{StaticResource InqSecondaryButtonStyle}" Margin="0,0,7,0"/>
                    <Button Content="Export" Command="{Binding ExportCommand}"
                            Style="{StaticResource InqSecondaryButtonStyle}" Margin="0,0,7,0"/>
                    <Button Content="＋ New inquiry" Command="{Binding NewInquiryCommand}"
                            Style="{StaticResource InqPrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ 2 · BENTO STATS ════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource InqSurfaceStyle}" Padding="16,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="26" Height="26" CornerRadius="7"
                                Background="{DynamicResource TintGreenBrush}" VerticalAlignment="Center">
                            <TextBlock Text="&#xE9C9;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text=" PIPELINE VALUE" Style="{StaticResource InqOverlineStyle}" Margin="4,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding PipelineValueText, Mode=OneWay}" FontSize="21" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="1,7,0,1"/>
                    <TextBlock Text="Cancelled excluded" Style="{StaticResource InqHintStyle}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource InqSurfaceStyle}" Padding="16,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="26" Height="26" CornerRadius="7"
                                Background="{DynamicResource TintBlueBrush}" VerticalAlignment="Center">
                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text=" OPEN" Style="{StaticResource InqOverlineStyle}" Margin="4,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding OpenCount, Mode=OneWay}" FontSize="21" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="1,7,0,1"/>
                    <TextBlock Text="Received + prepared" Style="{StaticResource InqHintStyle}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource InqSurfaceStyle}" Padding="16,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="26" Height="26" CornerRadius="7"
                                Background="{DynamicResource TintAmberBrush}" VerticalAlignment="Center">
                            <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{DynamicResource WarningBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text=" AWAITING CUSTOMER" Style="{StaticResource InqOverlineStyle}" Margin="4,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding AwaitingCount, Mode=OneWay}" FontSize="21" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="1,7,0,1"/>
                    <TextBlock Text="Sent, waiting confirmation" Style="{StaticResource InqHintStyle}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource InqSurfaceStyle}" Padding="16,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="26" Height="26" CornerRadius="7"
                                Background="{DynamicResource TintGreenBrush}" VerticalAlignment="Center">
                            <TextBlock Text="&#xE930;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text=" CONFIRMED" Style="{StaticResource InqOverlineStyle}" Margin="4,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ConfirmedCount, Mode=OneWay}" FontSize="21" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="1,7,0,1"/>
                    <TextBlock Text="Ready to convert to PI" Style="{StaticResource InqHintStyle}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ 3 · STATUS RAIL + FILTER CLUSTER ══════════════════════ -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="10,8" Style="{StaticResource InqSurfaceStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding StatusTabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}"
                                        Command="{Binding DataContext.SelectStatusTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Key}"
                                        Style="{StaticResource InqSegmentPillStyle}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Border Width="7" Height="7" CornerRadius="4" Margin="0,0,8,0"
                            VerticalAlignment="Center" Background="{DynamicResource AccentBrush}"
                            ToolTip="Filters are active"
                            Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}"/>
                    <ComboBox Width="112" ItemsSource="{Binding DateRanges}"
                              SelectedItem="{Binding SelectedDateRange}"
                              Style="{StaticResource InqFilterComboStyle}" ToolTip="Received date range"/>
                    <ComboBox Width="136" Margin="7,0,0,0" ItemsSource="{Binding Salesmen}"
                              SelectedItem="{Binding SelectedSalesman}"
                              Style="{StaticResource InqFilterComboStyle}" ToolTip="Salesman"/>
                    <ComboBox Width="146" Margin="7,0,0,0" ItemsSource="{Binding PreparedByUsers}"
                              SelectedItem="{Binding SelectedPreparedBy}"
                              Style="{StaticResource InqFilterComboStyle}" ToolTip="Prepared by"/>
                    <ComboBox Width="118" Margin="7,0,0,0" ItemsSource="{Binding Priorities}"
                              SelectedItem="{Binding SelectedPriority}"
                              Style="{StaticResource InqFilterComboStyle}" ToolTip="Priority"/>
                    <ComboBox Width="158" Margin="7,0,0,0" ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSort}"
                              Style="{StaticResource InqFilterComboStyle}" ToolTip="Sort order"/>
                    <ToggleButton Margin="7,0,0,0" Content="Has files" FontSize="11.5"
                                  IsChecked="{Binding HasAttachmentsOnly}" Cursor="Hand"
                                  ToolTip="Only show inquiries with attachments">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bg" CornerRadius="12"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource OutlineStrongBrush}" BorderThickness="1"
                                        Padding="11,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10" Margin="0,0,6,0" Visibility="Collapsed"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center"/>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TintBlueBrush}"/>
                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <Button Content="Reset" Command="{Binding ResetFiltersCommand}"
                            Style="{StaticResource InqGhostActionStyle}" Margin="9,0,2,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ 4 · REGISTER (row cards) ══════════════════════════════ -->
        <Border Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource InqSurfaceStyle}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- COLUMN HEADER — five named zones that match the row
                     card exactly. Each header cell has a tooltip that
                     describes what lives under it.
                       0  SPINE   (4 px, status-tinted on the row)
                       1  ID      (inquiry number, the unique reference)
                       2  INQUIRY (workflow status + caller reference)
                       3  CUSTOMER(customer name + avatar)
                       4  PROJECT (project name)
                       5  FILES · CHAIN (attachment count, conversion link)
                       6  VALUE · RECEIVED · OWNERS (value, date+time, owners)
                -->
                <Border Margin="0" Padding="0"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1"
                        Background="{DynamicResource TintGrayBrush}"
                        SnapsToDevicePixels="True">
                    <Grid Margin="14,9,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="ID" Style="{StaticResource InqOverlineStyle}"
                                   ToolTip="Inquiry number (the unique commercial reference)"/>
                        <TextBlock Grid.Column="2" Text="INQUIRY" Style="{StaticResource InqOverlineStyle}"
                                   ToolTip="Workflow status and the caller's reference supplied on the inquiry"/>
                        <TextBlock Grid.Column="3" Text="CUSTOMER" Style="{StaticResource InqOverlineStyle}"
                                   ToolTip="Customer / company the inquiry is for"/>
                        <TextBlock Grid.Column="4" Text="PROJECT" Style="{StaticResource InqOverlineStyle}"
                                   ToolTip="Project name the inquiry is about"/>
                        <TextBlock Grid.Column="5" Text="FILES · CHAIN"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource InqOverlineStyle}"
                                   ToolTip="Attached source documents and the proforma-invoice / job-order linkage"/>
                        <TextBlock Grid.Column="6" Text="VALUE · RECEIVED · OWNERS"
                                   Style="{StaticResource InqOverlineStyle}"
                                   ToolTip="Estimated value, received date and time, salesman and prepared by"/>
                    </Grid>
                </Border>

                <ListBox Grid.Row="1" x:Name="RegisterList"
                         ItemsSource="{Binding Inquiries}"
                         SelectedItem="{Binding SelectedInquiry, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.CanContentScroll="True"
                         HorizontalContentAlignment="Stretch"
                         Padding="0"
                         MouseDoubleClick="OnRowDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- ROW CARD — Lumen card chrome. Each of the 7
                                 grid columns renders the data its header
                                 promises, no nested re-stacking. -->
                            <Border x:Name="Card" CornerRadius="0"
                                    Background="{DynamicResource ModuleBackgroundBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                                    Padding="0" Cursor="Hand" MinHeight="62"
                                    SnapsToDevicePixels="True">
                                <Grid Margin="14,10,14,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 0 · SPINE — status-tinted 4 px bar (visual only) -->
                                    <Border Style="{StaticResource InqSpineStyle}"
                                            HorizontalAlignment="Stretch" Width="Auto"/>

                                    <!-- 1 · ID — the inquiry number (identity column) -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,8,0">
                                        <TextBlock Text="{Binding InquiryNumber}" FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding InquiryNumber}"/>
                                        <Border Margin="0,6,0,0" HorizontalAlignment="Left"
                                                Style="{StaticResource InqMetaChipStyle}" Padding="8,2.5">
                                            <TextBlock Text="{Binding Priority, Mode=OneWay}"
                                                       Style="{StaticResource InqMetaChipTextStyle}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- 2 · INQUIRY — status pill + caller reference -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,8,0">
                                        <Border HorizontalAlignment="Left" Style="{StaticResource InqStatusPillStyle}">
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource InqPillTextStyle}"/>
                                        </Border>
                                        <TextBlock Text="{Binding InquiryReference, Mode=OneWay}" FontSize="11"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding InquiryReference}"/>
                                    </StackPanel>

                                    <!-- 3 · CUSTOMER — avatar + name -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal"
                                                Margin="8,0,8,0">
                                        <Border Style="{StaticResource InqAvatarStyle}" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding CustomerInitials, Mode=OneWay}"
                                                       Style="{StaticResource InqAvatarTextStyle}"/>
                                        </Border>
                                        <TextBlock Text="{Binding CustomerName}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   ToolTip="{Binding CustomerName}"/>
                                    </StackPanel>

                                    <!-- 4 · PROJECT -->
                                    <TextBlock Grid.Column="4" Text="{Binding Project}" FontSize="12.5"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Margin="8,0,8,0" ToolTip="{Binding Project}"/>

                                    <!-- 5 · FILES · CHAIN — attachment chip + conversion chip -->
                                    <StackPanel Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Orientation="Horizontal" Margin="4,0,4,0">
                                        <Border Style="{StaticResource InqMetaChipStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding AttachmentChipText, Mode=OneWay}"
                                                           Style="{StaticResource InqMetaChipTextStyle}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="6,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource InqMetaChipStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConverted}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource TintGreenBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding ChainText, Mode=OneWay}" FontSize="10"
                                                       FontWeight="SemiBold" MaxWidth="160"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ChainText}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- 6 · VALUE · RECEIVED · OWNERS — value (right) + date / time / owners (left) -->
                                    <Grid Grid.Column="6" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ReceivedDateText, Mode=OneWay}" FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding ReceivedTimeText, Mode=OneWay}" FontSize="10"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                <TextBlock Text=" · " FontSize="10"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                <TextBlock Text="{Binding Salesman, Mode=OneWay}" FontSize="10"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="120"
                                                           ToolTip="{Binding Salesman}"/>
                                                <TextBlock Text=" · " FontSize="10"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                <TextBlock Text="{Binding PreparedBy, Mode=OneWay}" FontSize="10"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="120"
                                                           ToolTip="{Binding PreparedBy}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding ValueText, Mode=OneWay}"
                                                   FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                                   TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
                                    </Grid>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <!-- hover — pale row tint -->
                                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="Background"
                                            Value="{DynamicResource MenuHoverBrush}"/>
                                </Trigger>
                                <!-- selection — accent tint across the whole card -->
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource RowSelectedConverter}">
                                            <Binding Path="DataContext.SelectedInquiry"
                                                     RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            <Binding/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter TargetName="Card" Property="Background"
                                            Value="{DynamicResource TintBlueBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                            </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- In-card overlays -->
                <Grid Grid.Row="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility"
                                        Value="{Binding HasInquiries, Converter={StaticResource InverseBoolToVis}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="62" Height="62" CornerRadius="16"
                                Background="{DynamicResource TintBlueBrush}" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Nothing here yet" FontSize="16" FontWeight="Bold" Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="No inquiries match the current filters. Widen the date range, clear the filters, or capture the first inquiry."
                                   Style="{StaticResource InqHintStyle}" Margin="0,7,0,0" TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        <Button Content="＋ New inquiry" Command="{Binding NewInquiryCommand}"
                                Style="{StaticResource InqPrimaryButtonStyle}" Margin="0,14,0,0"
                                HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Width="210" Height="4" IsIndeterminate="True" Background="Transparent"
                                     Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Loading inquiries…" Style="{StaticResource InqHintStyle}"
                                   Margin="0,11,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                            Padding="18,14" CornerRadius="10"
                            Background="{DynamicResource TintRedBrush}"
                            BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEB90;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Could not load the register" FontSize="13.5" FontWeight="Bold"
                                           Margin="9,0,0,0" Foreground="{DynamicResource DangerBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ErrorText}" Style="{StaticResource InqHintStyle}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,8,0,0"/>
                            <Button Content="Retry" Command="{Binding RefreshCommand}"
                                    Style="{StaticResource InqSecondaryButtonStyle}" Margin="0,12,0,0"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ══ DETAILS DRAWER ═════════════════════════════════ -->
                <Border x:Name="Drawer" Width="452" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                        Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="{DynamicResource OutlineStrongBrush}" BorderThickness="1,0,0,0"
                        Opacity="0" IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="DrawerShift" X="452"/>
                    </Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDetailsDrawerOpen}" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Setter Property="IsHitTestVisible" Value="True"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.24">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="452" Duration="0:0:0.19">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseIn"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.25" Color="#334155"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Cover header -->
                        <Grid>
                            <Border Background="{DynamicResource AccentBrush}" Opacity="0.10"/>
                            <Border Background="{DynamicResource TintBlueBrush}" Opacity="0.5"/>
                            <Grid Margin="18,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SelectedInquiry.InquiryNumber}" FontSize="17"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Border Margin="10,0,0,0" Style="{StaticResource InqStatusPillStyle}">
                                            <TextBlock Text="{Binding SelectedInquiry.Status}"
                                                       Style="{StaticResource InqPillTextStyle}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedInquiry.InquiryReference, Mode=OneWay}"
                                               Style="{StaticResource InqHintStyle}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding CloseDetailsCommand}"
                                        Style="{StaticResource InqIconButtonStyle}" VerticalAlignment="Top"
                                        ToolTip="Close details">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                </Button>
                            </Grid>
                        </Grid>

                        <!-- Body -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,4,18,14">
                            <StackPanel>
                                <TextBlock Text="WORKFLOW" Style="{StaticResource InqOverlineStyle}" Margin="2,8,0,6"/>
                                <WrapPanel>
                                    <Button Content="Prepare" Command="{Binding ChangeStatusCommand}" CommandParameter="Prepared"
                                            Style="{StaticResource InqSecondaryButtonStyle}" Padding="13,6" Margin="0,0,6,6"
                                            IsEnabled="{Binding SelectedInquiry.CanPrepareWorkflow, Mode=OneWay}"/>
                                    <Button Content="Send" Command="{Binding ChangeStatusCommand}" CommandParameter="Sent"
                                            Style="{StaticResource InqSecondaryButtonStyle}" Padding="13,6" Margin="0,0,6,6"
                                            IsEnabled="{Binding SelectedInquiry.CanSendWorkflow, Mode=OneWay}"/>
                                    <Button Content="Confirm" Command="{Binding ChangeStatusCommand}" CommandParameter="Confirmed"
                                            Style="{StaticResource InqSecondaryButtonStyle}" Padding="13,6" Margin="0,0,6,6"
                                            IsEnabled="{Binding SelectedInquiry.CanConfirmWorkflow, Mode=OneWay}"/>
                                    <Button Content="Hold" Command="{Binding ChangeStatusCommand}" CommandParameter="Hold"
                                            Style="{StaticResource InqSecondaryButtonStyle}" Padding="13,6" Margin="0,0,6,6"
                                            IsEnabled="{Binding SelectedInquiry.CanHoldWorkflow, Mode=OneWay}"/>
                                    <Button Content="Cancel" Command="{Binding ChangeStatusCommand}" CommandParameter="Cancelled"
                                            Style="{StaticResource InqSecondaryButtonStyle}" Padding="13,6"
                                            IsEnabled="{Binding SelectedInquiry.CanCancelWorkflow, Mode=OneWay}"/>
                                </WrapPanel>

                                <TextBlock Text="DETAILS" Style="{StaticResource InqOverlineStyle}" Margin="2,14,0,6"/>
                                <Border Style="{StaticResource InqInsetStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="106"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Customer" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,5"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedInquiry.CustomerName}"
                                                   FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="1" Text="Location" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,5"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedInquiry.ContactSummary, Mode=OneWay}"
                                                   FontSize="12" Margin="0,0,0,5"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="2" Text="Project" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,5"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedInquiry.Project}"
                                                   FontSize="12" Margin="0,0,0,5"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="3" Text="Subject" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,5"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedInquiry.Subject}"
                                                   FontSize="12" Margin="0,0,0,5"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="4" Text="Received" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,5"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1"
                                                   Text="{Binding SelectedInquiry.ReceivedAt, StringFormat={}{0:dd MMM yyyy · hh:mm tt}}"
                                                   FontSize="12" Margin="0,0,0,5"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        <TextBlock Grid.Row="5" Text="Value" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1"
                                                   Text="{Binding SelectedInquiry.InquiryValue, StringFormat=AED {0:N2}}"
                                                   FontSize="12.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="NOTES" Style="{StaticResource InqOverlineStyle}" Margin="2,14,0,6"/>
                                <Border Style="{StaticResource InqInsetStyle}">
                                    <TextBlock Text="{Binding SelectedInquiry.NotesPreview, Mode=OneWay}"
                                               FontSize="11.5" MaxHeight="110" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                </Border>

                                <TextBlock Text="ATTACHMENTS" Style="{StaticResource InqOverlineStyle}" Margin="2,14,0,6"/>
                                <ItemsControl ItemsSource="{Binding SelectedInquiry.Attachments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10"
                                                    Background="{DynamicResource ModuleBackgroundBrush}"
                                                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                                                    Padding="10,8" Margin="0,0,0,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="32" Height="32" CornerRadius="8"
                                                            Background="{DynamicResource TintBlueBrush}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                                                        <TextBlock Text="{Binding FileName}" FontSize="11.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding TypeLabel, Mode=OneWay}" FontSize="9.5"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource AccentBrush}"/>
                                                            <TextBlock Text=" · " FontSize="9.5"
                                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                            <TextBlock Text="{Binding FileSizeDisplay, Mode=OneWay}" FontSize="9.5"
                                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="Preview"
                                                                Command="{Binding DataContext.PreviewAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource InqGhostActionStyle}" Margin="0,0,4,0"/>
                                                        <Button Content="Open"
                                                                Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource InqGhostActionStyle}" Margin="0,0,4,0"/>
                                                        <Button Content="Delete"
                                                                Command="{Binding DataContext.DeleteAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource InqGhostActionStyle}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No files attached." Margin="2,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource InqHintStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedInquiry.HasAttachments}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="DOCUMENT CHAIN" Style="{StaticResource InqOverlineStyle}" Margin="2,14,0,6"/>
                                <Border Style="{StaticResource InqInsetStyle}">
                                    <TextBlock Text="{Binding SelectedInquiry.ChainText, Mode=OneWay}" FontSize="11.5"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="ACTIVITY" Style="{StaticResource InqOverlineStyle}" Margin="2,14,0,8"/>
                                <ItemsControl ItemsSource="{Binding SelectedInquiry.RecentActivity}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Style="{StaticResource InqTimelineDotStyle}"/>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,12">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                        <TextBlock Text="{Binding OccurredText, Mode=OneWay}" FontSize="9.5"
                                                                   Margin="8,1.5,0,0"
                                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Drawer footer -->
                        <Border Grid.Row="2" Padding="18,12" BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="0,1,0,0"
                                Background="{DynamicResource ModuleBackgroundBrush}">
                            <StackPanel>
                                <Button Content="Open workspace" Command="{Binding OpenWorkspaceCommand}"
                                        Style="{StaticResource InqPrimaryButtonStyle}" Margin="0,0,0,7"/>
                                <Button Content="Convert to proforma invoice" Command="{Binding ConvertToPiCommand}"
                                        Style="{StaticResource InqSecondaryButtonStyle}" Margin="0,0,0,7"/>
                                <TextBlock Text="Conversion is available for confirmed inquiries that have no PI yet."
                                           Style="{StaticResource InqHintStyle}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ══ 5 · FOOTER ═════════════════════════════════════════════ -->
        <Grid Grid.Row="4" Margin="2,10,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                         Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding PageStatus}" FontSize="11"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           VerticalAlignment="Center" Margin="8,0,12,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding PreviousPageCommand}" Style="{StaticResource InqIconButtonStyle}"
                        ToolTip="Previous page">
                    <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </Button>
                <TextBlock VerticalAlignment="Center" Margin="11,0" FontSize="11.5"
                           Foreground="{DynamicResource SecondaryForegroundBrush}">
                    <Run Text="Page "/><Run Text="{Binding CurrentPage, Mode=OneWay, StringFormat={}{0}}"/><Run Text=" of "/><Run Text="{Binding TotalPages, Mode=OneWay}"/>
                </TextBlock>
                <Button Command="{Binding NextPageCommand}" Style="{StaticResource InqIconButtonStyle}"
                        ToolTip="Next page">
                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
