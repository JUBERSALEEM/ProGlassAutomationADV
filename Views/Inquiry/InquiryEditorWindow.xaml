<Window x:Class="ProGlassAutomation.Views.Inquiry.InquiryEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Inquiry" Width="1120" Height="740" MinWidth="900" MinHeight="650" WindowStartupLocation="CenterOwner" Background="#F6F8FB" FontFamily="Segoe UI">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="INQUIRY WORKSPACE" FontSize="22" FontWeight="Bold"/><TextBlock Text="Commercial intake, communication and source documents" Foreground="#667085"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="White" BorderBrush="#D6DEE7" BorderThickness="1" CornerRadius="7" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,8,12"><TextBlock Text="Inquiry Reference"/><TextBox Text="{Binding Record.InquiryReference}" Height="36"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,12"><TextBlock Text="Received"/><DatePicker SelectedDate="{Binding ReceivedDate}" Height="36"/></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,0,8,12"><TextBlock Text="Customer *"/><ComboBox ItemsSource="{Binding Customers}" IsEditable="True" Text="{Binding Record.CustomerName, UpdateSourceTrigger=PropertyChanged}" Height="36"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,12"><TextBlock Text="Customer Location"/><TextBox Text="{Binding Record.CustomerLocation}" Height="36"/></StackPanel>
    <StackPanel Grid.Row="2" Margin="0,0,8,12"><TextBlock Text="Project *"/><TextBox Text="{Binding Record.ProjectName}" Height="36"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,12"><TextBlock Text="Priority"/><ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding Record.Priority}" Height="36"/></StackPanel>
    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,12"><TextBlock Text="Project Description"/><TextBox Text="{Binding Record.ProjectDescription}" Height="58" AcceptsReturn="True" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Grid.Row="4" Margin="0,0,8,12"><TextBlock Text="Salesman"/><ComboBox ItemsSource="{Binding Salesmen}" IsEditable="True" Text="{Binding Record.SalesmanName}" Height="36"/></StackPanel><StackPanel Grid.Row="4" Grid.Column="1" Margin="8,0,0,12"><TextBlock Text="Inquiry Value (AED)"/><TextBox Text="{Binding Record.InquiryValue}" Height="36"/></StackPanel>
    <StackPanel Grid.Row="5" Grid.ColumnSpan="2"><TextBlock Text="Notes"/><TextBox Text="{Binding Record.Notes}" Height="100" AcceptsReturn="True" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,14,0,0"><TextBlock Text="CONTROLLED WORKFLOW" FontSize="10" FontWeight="Bold" Foreground="#667085"/><WrapPanel Margin="0,6,0,0"><Button Content="PREPARE" Command="{Binding ChangeStatusCommand}" CommandParameter="Prepared" Margin="0,0,6,4"/><Button Content="SEND" Command="{Binding ChangeStatusCommand}" CommandParameter="Sent" Margin="0,0,6,4"/><Button Content="CONFIRM" Command="{Binding ChangeStatusCommand}" CommandParameter="Confirmed" Margin="0,0,6,4"/><Button Content="HOLD" Command="{Binding ChangeStatusCommand}" CommandParameter="Hold" Margin="0,0,6,4"/><Button Content="CANCEL INQUIRY" Command="{Binding ChangeStatusCommand}" CommandParameter="Cancelled" Margin="0,0,6,4"/></WrapPanel></StackPanel>
   </Grid></ScrollViewer></Border>

   <Border Grid.Column="2" Background="White" BorderBrush="#D6DEE7" BorderThickness="1" CornerRadius="7" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="ATTACHMENTS" FontSize="15" FontWeight="Bold"/><TextBlock Text="Images and PDFs preview inside ProGlass" FontSize="11" Foreground="#667085"/></StackPanel>
    <ListBox Grid.Row="1" ItemsSource="{Binding AttachmentItems}" SelectedItem="{Binding SelectedAttachment}" Margin="0,12" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#E1E7EE" BorderThickness="0,0,0,1" Padding="6,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock FontSize="10" Foreground="#667085"><Run Text="{Binding Extension, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding FileSize, Mode=OneWay, StringFormat={}{0:N0} bytes}"/></TextBlock></StackPanel><Button Grid.Column="1" Content="PREVIEW" Command="{Binding DataContext.PreviewAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="4,0"/><Button Grid.Column="2" Content="DELETE" Command="{Binding DataContext.DeleteAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    <Button Grid.Row="2" Content="+ ADD IMAGE / PDF / DRAWING" Command="{Binding AddAttachmentCommand}" Height="38" Background="#0967D8" Foreground="White"/>
   </Grid></Border>
  </Grid>
  <DockPanel Grid.Row="2"><TextBlock Text="{Binding StatusText}" Foreground="#B42318" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="CANCEL" Command="{Binding CancelCommand}" Width="100" Height="38" Margin="0,0,8,0"/><Button Content="SAVE INQUIRY" Command="{Binding SaveCommand}" Width="140" Height="38" Background="#0967D8" Foreground="White"/></StackPanel></DockPanel>
 </Grid>
</Window>
