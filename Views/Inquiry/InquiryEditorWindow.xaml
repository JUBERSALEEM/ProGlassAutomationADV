<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Inquiry/InquiryEditorWindow.xaml
     MODULE: Inquiry workspace — "Lumen" redesign (from scratch)

     Composition:
       header  — floating identity bar: icon tile, title + status pill,
                  unsaved dot, subtitle, shortcut hint
       body    — LEFT workflow rail (vertical timeline with live state +
                 transition chips) · RIGHT scrollable canvas of floating
                 section cards (Customer → Project → Commercial → Notes →
                 Source documents with dashed drop zone)
       footer  — diagnostic strip (error dot + message) + Discard / Save
═══════════════════════════════════════════════════════════════════ -->
<Window x:Class="ProGlassAutomation.Views.Inquiry.InquiryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ProGlassAutomation.Converters"
        xmlns:features="clr-namespace:ProGlassAutomation.Services.Features"
        Title="{DynamicResource Inquiry.InquiryWorkspace}"
        Width="1180" Height="790" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown"
        AllowDrop="True" Drop="OnFileDrop" DragOver="OnDragOver">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

            </ResourceDictionary.MergedDictionaries>

            <!-- Right-click field context menu. One shared definition so the
                 Cut / Copy / Paste / Select all pattern is consistent across
                 every editable input. The customer-specific actions
                 (Open in master data, View history) are always present
                 and gated by whether the customer exists in master data.
                 "Clear all customer info" is intentionally not "Clear
                 <field>" because this same menu is shown on the Customer,
                 Location, AND Salesman fields; clearing always targets
                 the customer (name + location) regardless of which
                 field the user right-clicked. The header was renamed from
                 "Clear customer field" to "Clear all customer info" to
                 make that unambiguous. -->
            <ContextMenu x:Key="EditorFieldContextMenu" Style="{DynamicResource ModernContextMenuStyle}">
                <MenuItem Header="{DynamicResource Inquiry.Cut}"
                          Style="{DynamicResource ModernMenuItemStyle}"
                          Command="ApplicationCommands.Cut"/>
                <MenuItem Header="{DynamicResource Inquiry.Copy}"
                          Style="{DynamicResource ModernMenuItemStyle}"
                          Command="ApplicationCommands.Copy"/>
                <MenuItem Header="{DynamicResource Inquiry.Paste}"
                          Style="{DynamicResource ModernMenuItemStyle}"
                          Command="ApplicationCommands.Paste"/>
                <Separator Style="{DynamicResource ModernMenuSeparatorStyle}"/>
                <MenuItem Header="{DynamicResource Inquiry.Select}"
                          Style="{DynamicResource ModernMenuItemStyle}"
                          Command="ApplicationCommands.SelectAll"/>
                <Separator Style="{DynamicResource ModernMenuSeparatorStyle}"/>
                <MenuItem Header="{DynamicResource Inquiry.CustomerActions}"
                          IsEnabled="False"
                          FontWeight="Bold"
                          Style="{DynamicResource ModernMenuItemStyle}"/>
                <MenuItem Header="{DynamicResource Inquiry.ClearCustomerInfo}"
                          Style="{DynamicResource ModernMenuItemStyle}"
                          Command="{Binding ClearCustomerCommand}"/>
                <MenuItem Header="{DynamicResource Inquiry.OpenCustomerMasterData}"
                          Style="{DynamicResource ModernMenuItemStyle}"
                          Command="{Binding OpenCustomerInMasterDataCommand}"
                          IsEnabled="{Binding CanOpenCustomerInMasterData}"/>
                <MenuItem Header="{DynamicResource Inquiry.ViewCustomerHistory}"
                          Style="{DynamicResource ModernMenuItemStyle}"
                          Command="{Binding ViewCustomerHistoryCommand}"
                          IsEnabled="{Binding CanViewCustomerHistory}"/>
            </ContextMenu>

            <!-- Workflow step node: dot + label + timestamp -->
            <Style x:Key="StepDotStyle" TargetType="Border">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="CornerRadius" Value="15"/>
                <Setter Property="Background" Value="{DynamicResource TintGrayBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource OutlineStrongBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <Style x:Key="StepNumberStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="StepTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            </Style>

            <!-- Section card heading row -->
            <Style x:Key="SectionCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="16,13"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <!-- Editor-local adornments. These are small one-off
                 styles that don't exist in the shared design system
                 because they're only used here. -->
            <Style x:Key="InqHintStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
                <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="InqGhostActionStyle" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" CornerRadius="7" Background="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="InqDropZoneStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource TintBlueBrush}"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="18,14"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>
            <Style x:Key="InqTimelineLineStyle" TargetType="Border">
                <Setter Property="Width" Value="2"/>
                <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Margin" Value="3.5,4,0,4"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ HEADER ═════════════════════════════════════════════════ -->
        <Border Style="{StaticResource ModuleSectionCardStyle}" Padding="16,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.09" Color="#1E293B"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="10"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextTitle}"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding HeaderTitle}" FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="●" FontSize="{StaticResource TextBody}" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource WarningBrush}"
                                       ToolTip="{DynamicResource Inquiry.UnsavedChanges}"
                                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <Border Margin="11,0,0,0" Padding="9,3" CornerRadius="12"
                                    Background="{DynamicResource TintBlueBrush}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Status}" FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding HeaderSubtitle}" FontSize="{StaticResource TextCaption}" Margin="0,3,0,0"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{DynamicResource Inquiry.CtrlSSaveEscClose}" FontSize="{StaticResource TextCaption}" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedForegroundBrush}"/>
            </Grid>
        </Border>

        <!-- ══ BODY ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT · workflow rail -->
            <Border Style="{StaticResource ModuleSectionCardStyle}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Inquiry.Workflow}" Style="{StaticResource ModuleColumnHeaderStyle}" Margin="2,0,0,10"/>

                    <!-- Step 1 · Received (always active) -->
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource StepDotStyle}" Background="{DynamicResource AccentBrush}"
                                BorderBrush="{DynamicResource AccentBrush}">
                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextBody}"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,3,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Inquiry.Received}" Style="{StaticResource StepTitleStyle}"/>
                            <TextBlock Text="{DynamicResource Inquiry.CapturedCustomer}" Style="{StaticResource InqHintStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource InqTimelineLineStyle}" Height="14"/>

                    <!-- Step 2 · Prepared -->
                    <StackPanel Orientation="Horizontal">
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepDotStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Prepared">
                                            <Setter Property="Background" Value="{DynamicResource TintBlueBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Sent">
                                            <Setter Property="Background" Value="{DynamicResource TintBlueBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Confirmed">
                                            <Setter Property="Background" Value="{DynamicResource TintBlueBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="2" Style="{StaticResource StepNumberStyle}"/>
                        </Border>
                        <StackPanel Margin="11,3,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Inquiry.Prepared}" Style="{StaticResource StepTitleStyle}"/>
                            <TextBlock Text="{Binding PreparedDateText, Mode=OneWay}" Style="{StaticResource InqHintStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource InqTimelineLineStyle}" Height="14"/>

                    <!-- Step 3 · Sent -->
                    <StackPanel Orientation="Horizontal">
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepDotStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Sent">
                                            <Setter Property="Background" Value="{DynamicResource TintAmberBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Confirmed">
                                            <Setter Property="Background" Value="{DynamicResource TintAmberBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="3" Style="{StaticResource StepNumberStyle}"/>
                        </Border>
                        <StackPanel Margin="11,3,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Inquiry.SentCustomer}" Style="{StaticResource StepTitleStyle}"/>
                            <TextBlock Text="{Binding SentDateText, Mode=OneWay}" Style="{StaticResource InqHintStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource InqTimelineLineStyle}" Height="14"/>

                    <!-- Step 4 · Confirmed -->
                    <StackPanel Orientation="Horizontal">
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepDotStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Confirmed">
                                            <Setter Property="Background" Value="{DynamicResource TintGreenBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="4" Style="{StaticResource StepNumberStyle}"/>
                        </Border>
                        <StackPanel Margin="11,3,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Inquiry.Confirmed}" Style="{StaticResource StepTitleStyle}"/>
                            <TextBlock Text="{Binding ConfirmedDateText, Mode=OneWay}" Style="{StaticResource InqHintStyle}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{DynamicResource Inquiry.Transitions}" Style="{StaticResource ModuleColumnHeaderStyle}" Margin="2,18,0,9"/>
                    <WrapPanel>
                        <Button Content="{DynamicResource Inquiry.Prepare}" Command="{Binding ChangeStatusCommand}" CommandParameter="Prepared"
                                Style="{StaticResource ModuleToolbarSecondaryButtonStyle}" Padding="12,6" Margin="0,0,6,6"
                                IsEnabled="{Binding CanPrepare}"/>
                        <Button Content="{DynamicResource Inquiry.Send}" Command="{Binding ChangeStatusCommand}" CommandParameter="Sent"
                                Style="{StaticResource ModuleToolbarSecondaryButtonStyle}" Padding="12,6" Margin="0,0,6,6"
                                IsEnabled="{Binding CanSend}"/>
                        <Button Content="{DynamicResource Action.Confirm}" Command="{Binding ChangeStatusCommand}" CommandParameter="Confirmed"
                                Style="{StaticResource ModuleToolbarSecondaryButtonStyle}" Padding="12,6" Margin="0,0,6,6"
                                IsEnabled="{Binding CanConfirm}"/>
                        <Button Content="{DynamicResource Inquiry.Hold}" Command="{Binding ChangeStatusCommand}" CommandParameter="Hold"
                                Style="{StaticResource ModuleToolbarSecondaryButtonStyle}" Padding="12,6" Margin="0,0,6,6"
                                IsEnabled="{Binding CanHold}"/>
                        <Button Content="{DynamicResource Inquiry.CancelInquiry}" Command="{Binding ChangeStatusCommand}" CommandParameter="Cancelled"
                                Style="{StaticResource ModuleToolbarSecondaryButtonStyle}" Padding="12,6"
                                IsEnabled="{Binding CanCancel}"/>
                    </WrapPanel>
                    <TextBlock Text="{DynamicResource Inquiry.TransitionsNeedSavedRecordNoUnsavedEdits}"
                               Style="{StaticResource InqHintStyle}" Margin="2,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- RIGHT · content canvas -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Customer -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource Common.Customer}" Style="{StaticResource ModuleColumnHeaderStyle}"/>
                                <Rectangle Width="26" Height="1" Fill="{DynamicResource DividerBrush}"
                                           VerticalAlignment="Center" Margin="9,0,0,0"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Inquiry.Customer}" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                    <ComboBox x:Name="CustomerInput" ItemsSource="{Binding Customers}"
                                              Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource ModernEditableComboBoxStyle}" StaysOpenOnEdit="True"
                                              ContextMenu="{StaticResource EditorFieldContextMenu}"
                                              ToolTip="{DynamicResource Inquiry.TypeNewCustomerPickSavedClient}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            Visibility="{Binding Path=ShowCustomerLocation,
                                                Source={x:Static features:InquiryFieldVisibility.Instance},
                                                Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{DynamicResource CompanyCenter.Location}" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                    <!-- Editable ComboBox: shows the saved addresses for
                                         the currently-typed customer, but the user can still
                                         type a brand-new one. The dropdown is empty when
                                         the customer is unknown or master data is missing. -->
                                    <ComboBox ItemsSource="{Binding CustomerLocations}"
                                              Text="{Binding CustomerLocation, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource ModernEditableComboBoxStyle}"
                                              IsTextSearchEnabled="True"
                                              ContextMenu="{StaticResource EditorFieldContextMenu}"
                                              ToolTip="{DynamicResource Inquiry.SavedAddressesCustomerTypeNewOneIfNeeded}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Project -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource Common.Project}" Style="{StaticResource ModuleColumnHeaderStyle}"/>
                                <Rectangle Width="26" Height="1" Fill="{DynamicResource DividerBrush}"
                                           VerticalAlignment="Center" Margin="9,0,0,0"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Inquiry.Project}" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                    <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            Visibility="{Binding Path=ShowInquiryReference,
                                                Source={x:Static features:InquiryFieldVisibility.Instance},
                                                Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{DynamicResource Inquiry.InquiryReference}" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                    <TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding Path=ShowProjectDescription,
                                            Source={x:Static features:InquiryFieldVisibility.Instance},
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{DynamicResource Inquiry.DescriptionSubject}" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <TextBox Text="{Binding ProjectDescription, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}" Height="66" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="11,9"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Commercial -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource Inquiry.Commercial}" Style="{StaticResource ModuleColumnHeaderStyle}"/>
                                <Rectangle Width="26" Height="1" Fill="{DynamicResource DividerBrush}"
                                           VerticalAlignment="Center" Margin="9,0,0,0"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Inquiry.ReceivedDate}" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                    <DatePicker SelectedDate="{Binding ReceivedDate}" Height="34" FontSize="{StaticResource TextBodyLarge}"
                                                VerticalContentAlignment="Center"/>
                                    <TextBlock Text="{Binding ReceivedHint, Mode=OneWay}"
                                               Style="{StaticResource InqHintStyle}" Margin="2,5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            Visibility="{Binding Path=ShowSalesman,
                                                Source={x:Static features:InquiryFieldVisibility.Instance},
                                                Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{DynamicResource Common.Salesman}" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding Salesmen}"
                                              Text="{Binding SalesmanName, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource ModernEditableComboBoxStyle}"
                                              IsTextSearchEnabled="True"
                                              ContextMenu="{StaticResource EditorFieldContextMenu}"
                                              ToolTip="{DynamicResource Inquiry.PickSavedSalesmanTypeNewNameSavedMasterData}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4"
                                            Visibility="{Binding Path=ShowPriority,
                                                Source={x:Static features:InquiryFieldVisibility.Instance},
                                                Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{DynamicResource Common.Priority}" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}"
                                              Style="{StaticResource ModernComboBoxStyle}"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="0,12,0,0" MaxWidth="260" HorizontalAlignment="Left"
                                        Visibility="{Binding Path=ShowInquiryValue,
                                            Source={x:Static features:InquiryFieldVisibility.Instance},
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{DynamicResource Inquiry.InquiryValueAED}" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <TextBox x:Name="ValueInput"
                                         Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}" TextAlignment="Right"
                                         PreviewTextInput="OnValuePreviewTextInput"
                                         DataObject.Pasting="OnValuePaste"
                                         ToolTip="{DynamicResource Inquiry.NumbersThousandsSeparatorsAllowed}"/>
                                <TextBlock Text="{Binding ValueHint, Mode=OneWay}" Margin="2,5,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource InqHintStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasValueError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Notes -->
                    <Border Style="{StaticResource SectionCardStyle}"
                            Visibility="{Binding Path=ShowNotes,
                                Source={x:Static features:InquiryFieldVisibility.Instance},
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource Common.Notes}" Style="{StaticResource ModuleColumnHeaderStyle}"/>
                                <Rectangle Width="26" Height="1" Fill="{DynamicResource DividerBrush}"
                                           VerticalAlignment="Center" Margin="9,0,0,0"/>
                            </StackPanel>
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}" Height="108" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="11,9"
                                     ToolTip="{DynamicResource Inquiry.InternalNotesVisibleRegisterDrawer}"/>
                        </StackPanel>
                    </Border>

                    <!-- ══ SCOPE OF SUPPLY (BOQ) · PHASE 2 ═════════════════ -->
                    <!-- Rows marked importable (spec name + W × H + qty)  -->
                    <!-- travel into the PI data grid on Convert → so the  -->
                    <!-- estimator never re-types quoted shapes.           -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="SCOPE OF SUPPLY" Style="{StaticResource ModuleColumnHeaderStyle}"/>
                                <Rectangle Width="26" Height="1" Fill="{DynamicResource DividerBrush}"
                                           VerticalAlignment="Center" Margin="9,0,0,0"/>
                                <TextBlock Text="converted into the PI data grid — nothing re-typed"
                                           Margin="9,0,0,0" FontSize="{StaticResource TextXSmall}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                            </StackPanel>

                            <DataGrid ItemsSource="{Binding LineItems}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource DividerBrush}"
                                      HeadersVisibility="Column" RowHeaderWidth="0"
                                      MinHeight="120" MaxHeight="260"
                                      Background="Transparent"
                                      BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                      Margin="0,8,0,6">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Build" Width="86">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox SelectedItem="{Binding GlassType, UpdateSourceTrigger=PropertyChanged}"
                                                          ItemsSource="{Binding DataContext.BoqGlassTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          IsEditable="False" BorderThickness="0"
                                                          Background="Transparent" Padding="4,2"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Item / specification" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding SpecName, UpdateSourceTrigger=PropertyChanged}"
                                                         BorderThickness="0" Background="Transparent" Padding="4,2"
                                                         ToolTip="Generated-style spec (e.g. 6 CL FT + 12 AS + 6 CL TPR) or the customer's own wording."/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Outer" Width="84">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding OuterGlassColor, UpdateSourceTrigger=PropertyChanged}"
                                                         BorderThickness="0" Background="Transparent" Padding="4,2"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Inner" Width="84">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding InnerGlassColor, UpdateSourceTrigger=PropertyChanged}"
                                                         BorderThickness="0" Background="Transparent" Padding="4,2"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="W mm" Width="64">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding WidthMm, UpdateSourceTrigger=PropertyChanged}"
                                                         BorderThickness="0" Background="Transparent" Padding="4,2"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="H mm" Width="64">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding HeightMm, UpdateSourceTrigger=PropertyChanged}"
                                                         BorderThickness="0" Background="Transparent" Padding="4,2"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Qty" Width="52">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Qty, UpdateSourceTrigger=PropertyChanged}"
                                                         BorderThickness="0" Background="Transparent" Padding="4,2"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Rate/sqm" Width="74">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding RatePerSqm, UpdateSourceTrigger=PropertyChanged}"
                                                         BorderThickness="0" Background="Transparent" Padding="4,2"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Notes" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                         BorderThickness="0" Background="Transparent" Padding="4,2"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="" Width="30">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕"
                                                        Command="{Binding DataContext.RemoveLineItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="{DynamicResource DangerBrush}"
                                                        FontSize="12" Padding="4,2"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding AddLineItemCommand}" Padding="12,6"
                                        Style="{StaticResource ModuleToolbarSecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="＋" FontSize="{StaticResource TextBody}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Add BOQ line" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Rows with a spec name, W × H and quantity convert into the PI grid — others stay as inquiry notes."
                                           FontSize="{StaticResource TextXSmall}" VerticalAlignment="Center" Margin="12,0,0,0"
                                           TextWrapping="Wrap" MaxWidth="520"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Source documents -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{DynamicResource Inquiry.SourceDocuments}" Style="{StaticResource ModuleColumnHeaderStyle}"/>
                                <Rectangle Width="26" Height="1" Fill="{DynamicResource DividerBrush}"
                                           VerticalAlignment="Center" Margin="9,0,0,0"/>
                                <TextBlock Text="{DynamicResource Inquiry.ManifestBackedWorksDatabase}" Margin="9,0,0,0"
                                           FontSize="{StaticResource TextXSmall}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                            </StackPanel>

                            <!-- Dashed drop zone -->
                            <Grid Margin="0,8,0,4" Cursor="Hand">
                                <Button Command="{Binding AddAttachmentCommand}" HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                        Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Border Style="{StaticResource InqDropZoneStyle}">
                                        <Grid>
                                            <Rectangle Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4"
                                                       StrokeDashArray="6 4" RadiusX="9" RadiusY="9"
                                                       Opacity="0.55"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Margin="14,12">
                                                <Border Width="40" Height="40" CornerRadius="10"
                                                        Background="{DynamicResource ElevatedSurfaceBrush}"
                                                        HorizontalAlignment="Center">
                                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextTitle}"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{DynamicResource Inquiry.DropFilesHereClickBrowse}" FontSize="{StaticResource TextBodyLarge}"
                                                           FontWeight="SemiBold" Margin="0,9,0,0" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                <TextBlock Text="{DynamicResource Inquiry.NewInquirySavedAutomaticallyBeforeFirstFile}"
                                                           Style="{StaticResource InqHintStyle}" Margin="0,4,0,0"
                                                           HorizontalAlignment="Center" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding AttachmentItems}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10"
                                                Background="{DynamicResource ModuleBackgroundBrush}"
                                                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                                                Padding="10,8" Margin="0,0,0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="32" Height="32" CornerRadius="8"
                                                        Background="{DynamicResource TintBlueBrush}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextBodyLarge}"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                                                    <TextBlock Text="{Binding FileName}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Extension, Mode=OneWay}" FontSize="{StaticResource TextXSmall}"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource AccentBrush}"/>
                                                        <TextBlock Text=" · " FontSize="{StaticResource TextXSmall}"
                                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                        <TextBlock Text="{Binding FileSize, Mode=OneWay, StringFormat={}{0:N0} bytes}"
                                                                   FontSize="{StaticResource TextXSmall}"
                                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="{DynamicResource Phone.Preview}"
                                                            Command="{Binding DataContext.PreviewAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource InqGhostActionStyle}" Margin="0,0,4,0"/>
                                                    <Button Content="{DynamicResource Action.Delete}"
                                                            Command="{Binding DataContext.DeleteAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource InqGhostActionStyle}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{DynamicResource Inquiry.NoFilesAttachedYet}" Margin="2,3,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource InqHintStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAttachments}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ══ FOOTER ═════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource ModuleSectionCardStyle}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource DangerBrush}" VerticalAlignment="Center"
                             Visibility="{Binding IsStatusError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource TextBody}" VerticalAlignment="Center" Margin="9,0,0,0"
                               TextWrapping="Wrap" MaxWidth="640"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{DynamicResource Inquiry.Discard}" Command="{Binding CancelCommand}"
                            Style="{StaticResource ModuleToolbarSecondaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="{Binding SaveCommandText}" Command="{Binding SaveCommand}"
                            Style="{StaticResource ModuleToolbarPrimaryButtonStyle}" MinWidth="150"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
