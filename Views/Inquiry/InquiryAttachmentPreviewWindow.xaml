<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Inquiry/InquiryAttachmentPreviewWindow.xaml
     MODULE: Inquiry attachment preview — "Lumen" redesign

     Viewer chrome: command strip on top (icon tile + name + meta + open
     action), full-bleed content area. Lock-free image decode and PDF
     release behaviour are in the code-behind (A1/A2 fixes) and unchanged.
═══════════════════════════════════════════════════════════════════ -->
<Window x:Class="ProGlassAutomation.Views.Inquiry.InquiryAttachmentPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Attachment preview"
        Width="1000" Height="760" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closed="OnClosed">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="InquiryTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Command strip -->
        <Border Padding="16,10" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                Background="{DynamicResource ElevatedSurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="{StaticResource InqRadiusControl}"
                        Background="{DynamicResource TintBlueBrush}" VerticalAlignment="Center">
                    <TextBlock x:Name="IconGlyph" Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock x:Name="MetaText" FontSize="10" Margin="0,2,0,0"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                </StackPanel>
                <Button Grid.Column="2" Content="Open with system app" Click="OpenExternal_Click" Cursor="Hand"
                        Style="{StaticResource InqSecondaryButtonStyle}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Surfaces -->
        <Grid Grid.Row="1" Background="{DynamicResource ModuleBackgroundBrush}">
            <Image x:Name="ImagePreview" Stretch="Uniform" Margin="16" Visibility="Collapsed"/>
            <WebBrowser x:Name="PdfPreview" Margin="8" Visibility="Collapsed"/>

            <Border x:Name="MissingPanel" Visibility="Collapsed">
                <Border.Background>
                    <SolidColorBrush Color="Transparent"/>
                </Border.Background>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="470">
                    <Border Width="62" Height="62" CornerRadius="{StaticResource InqRadiusSurface}"
                            Background="{DynamicResource TintRedBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                   Foreground="{DynamicResource DangerBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="File not found on disk" FontSize="16" FontWeight="Bold" Margin="0,16,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock x:Name="MissingDetail" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Text="The attachment metadata exists, but the stored file cannot be found. It may have been moved or deleted outside ProGlass."/>
                </StackPanel>
            </Border>

            <Border x:Name="UnsupportedPanel" Background="Transparent" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="470">
                    <Border Width="62" Height="62" CornerRadius="{StaticResource InqRadiusSurface}"
                            Background="{DynamicResource TintGrayBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="In-app preview is not available for this file type" FontSize="15" FontWeight="Bold"
                               Margin="0,16,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Text="Drawings and spreadsheets open with their system application."/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
