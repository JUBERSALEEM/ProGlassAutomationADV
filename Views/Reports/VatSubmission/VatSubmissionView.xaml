<UserControl x:Class="ProGlassAutomation.Views.Reports.VatSubmission.VatSubmissionView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loading="clr-namespace:ProGlassAutomation.Controls.LoadingState"
             xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- ═══════════════════════════════════════════════════════════════════
         VAT SUBMISSION REPORT — Professional SaaS Layout
         Matches PiReport and DeliveryReport design system exactly.
         4 view modes: Detail (row-level), BySalesman, ByCompany, ByProject.
    ═══════════════════════════════════════════════════════════════════ -->
    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Title & Scope Subtitle -->
        <StackPanel Grid.Row="0" Margin="16,14,16,12">
            <TextBlock Text="VAT Submission Report" Style="{StaticResource ModulePageTitleStyle}" FontSize="{StaticResource TextTitleLarge}" FontWeight="Bold"/>
            <TextBlock Text="5% UAE FTA VAT breakdown by salesman, company, and project · Export for tax filing compliance." Style="{StaticResource ModulePageSubtitleStyle}" TextWrapping="Wrap" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- Main Shell Card -->
        <Border Grid.Row="1" Style="{StaticResource ModuleListShellStyle}" Margin="16,0,16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- KPI Strip -->
                    <RowDefinition Height="Auto"/> <!-- Filter Bar -->
                    <RowDefinition Height="*"/>    <!-- Table + Tabs -->
                    <RowDefinition Height="Auto"/> <!-- Pagination Footer -->
                </Grid.RowDefinitions>

                <!-- ══════════════════════════════════════════════════════════
                     1. KPI STRIP
                ══════════════════════════════════════════════════════════ -->
                <Border Grid.Row="0" Style="{StaticResource ModuleListKpiStripStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Total VAT Collected -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Total 5% VAT collected across all invoices (respects active filters)">
                            <Border Width="38" Height="38" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource TintGreenBrush}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE913;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSubhead}" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="TOTAL VAT" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding Summary.TotalVatCollected, StringFormat={}AED {0:N2}}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="5% FTA rate" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <!-- Card 2: Total Revenue -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Total revenue including VAT">
                            <Border Width="38" Height="38" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource TintBlueBrush}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSubhead}" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="TOTAL REVENUE" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding Summary.TotalGrandTotal, StringFormat={}AED {0:N2}}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="{Binding Summary.TotalSubtotal, Mode=OneWay, StringFormat={}AED {0:N0} ex-VAT}" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="3" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <!-- Card 3: Total Invoices -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Total invoice count in the selected period">
                            <Border Width="38" Height="38" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource TintAmberBrush}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSubhead}" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="INVOICES" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding Summary.TotalInvoices}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="Proforma invoices" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="5" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <!-- Card 4: Active Salesmen -->
                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Number of active salesmen contributing to VAT">
                            <Border Width="38" Height="38" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource TintIndigoBrush}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSubhead}" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SALESMEN" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding Summary.BySalesman.Count}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="{Binding Summary.ByCompany.Count, Mode=OneWay, StringFormat={}{0} companies}" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════════════════
                     2. FILTER BAR
                ══════════════════════════════════════════════════════════ -->
                <Border Grid.Row="1" Style="{StaticResource ModuleListFilterBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Date From -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="FROM DATE" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <DatePicker Width="128" Style="{StaticResource ModuleListFilterDatePickerStyle}" SelectedDate="{Binding DateFrom}" ToolTip="Filter by start date"/>
                            </StackPanel>

                            <!-- Date To -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="TO DATE" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <DatePicker Width="128" Style="{StaticResource ModuleListFilterDatePickerStyle}" SelectedDate="{Binding DateTo}" ToolTip="Filter by end date"/>
                            </StackPanel>

                            <!-- Company -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="COMPANY" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox Width="140" Style="{StaticResource ModuleListFilterComboStyle}" ItemsSource="{Binding CompanyOptions}" SelectedItem="{Binding CompanyFilter}" ToolTip="Filter by company"/>
                            </StackPanel>

                            <!-- Salesman -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="SALESMAN" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox Width="140" Style="{StaticResource ModuleListFilterComboStyle}" ItemsSource="{Binding SalesmanOptions}" SelectedItem="{Binding SalesmanFilter}" ToolTip="Filter by salesman"/>
                            </StackPanel>

                            <!-- Project -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="PROJECT" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox Width="150" Style="{StaticResource ModuleListFilterComboStyle}" ItemsSource="{Binding ProjectOptions}" SelectedItem="{Binding ProjectFilter}" ToolTip="Filter by project"/>
                            </StackPanel>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,6,6">
                                <Button Content="Clear" Command="{Binding ClearFilterCommand}" Style="{StaticResource ReportToolbarOutlinedButton}" ToolTip="Reset all filters"/>
                            </StackPanel>
                        </WrapPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="8,0,0,6">
                            <TextBlock Text="EXPORT" Style="{StaticResource ModuleFieldLabelStyle}" HorizontalAlignment="Right"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource ReportExportOutlinedButton}" ToolTip="Export filtered records to CSV"/>
                                <Button Content="Excel" Command="{Binding ExportExcelCommand}" Style="{StaticResource ReportExportOutlinedButton}" ToolTip="Export filtered records to Excel (.xlsx)"/>
                                <Button Content="PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource ReportExportPrimaryButton}" ToolTip="Export professional PDF report"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════════════════
                     3. VIEW TABS + TABLE
                ══════════════════════════════════════════════════════════ -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- View Mode Tabs -->
                        <RowDefinition Height="Auto"/> <!-- Table Header -->
                        <RowDefinition Height="*"/>    <!-- Table Rows -->
                    </Grid.RowDefinitions>

                    <!-- View Mode Tabs -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource GlassBorderSoft}" BorderThickness="0,0,0,1" Background="{DynamicResource GlassUltraClearBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Command="{Binding ChangeViewModeCommand}" CommandParameter="Detail"
                                    Cursor="Hand" Height="40" Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="8,0" SnapsToDevicePixels="True">
                                            <Grid>
                                                <TextBlock x:Name="TabText" Text="Detail View" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,6"/>
                                                <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Background="Transparent" CornerRadius="1"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDetailView}" Value="True">
                                                <Setter TargetName="TabText" Property="FontWeight" Value="Bold"/>
                                                <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsDetailView}" Value="False"/>
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                            </MultiDataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="1" Command="{Binding ChangeViewModeCommand}" CommandParameter="BySalesman"
                                    Cursor="Hand" Height="40" Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="8,0" SnapsToDevicePixels="True">
                                            <Grid>
                                                <TextBlock x:Name="TabText" Text="By Salesman" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,6"/>
                                                <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Background="Transparent" CornerRadius="1"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSalesmanView}" Value="True">
                                                <Setter TargetName="TabText" Property="FontWeight" Value="Bold"/>
                                                <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsSalesmanView}" Value="False"/>
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                            </MultiDataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="2" Command="{Binding ChangeViewModeCommand}" CommandParameter="ByCompany"
                                    Cursor="Hand" Height="40" Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="8,0" SnapsToDevicePixels="True">
                                            <Grid>
                                                <TextBlock x:Name="TabText" Text="By Company" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,6"/>
                                                <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Background="Transparent" CornerRadius="1"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCompanyView}" Value="True">
                                                <Setter TargetName="TabText" Property="FontWeight" Value="Bold"/>
                                                <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsCompanyView}" Value="False"/>
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                            </MultiDataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="3" Command="{Binding ChangeViewModeCommand}" CommandParameter="ByProject"
                                    Cursor="Hand" Height="40" Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="8,0" SnapsToDevicePixels="True">
                                            <Grid>
                                                <TextBlock x:Name="TabText" Text="By Project" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,6"/>
                                                <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Background="Transparent" CornerRadius="1"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsProjectView}" Value="True">
                                                <Setter TargetName="TabText" Property="FontWeight" Value="Bold"/>
                                                <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsProjectView}" Value="False"/>
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                            </MultiDataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ══════════════════════════════════════════════════
                         DETAIL VIEW — Row-level invoice data
                    ══════════════════════════════════════════════════ -->
                    <Grid Grid.Row="1" Visibility="{Binding IsDetailView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Table header -->
                        <Border Grid.Row="0" Style="{StaticResource ReportTableHeaderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.9*"/>
                                    <ColumnDefinition Width="1.0*"/>
                                    <ColumnDefinition Width="1.0*"/>
                                    <ColumnDefinition Width="0.9*"/>
                                    <ColumnDefinition Width="0.7*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="1.0*"/>
                                    <ColumnDefinition Width="0.9*"/>
                                    <ColumnDefinition Width="1.0*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="PI # / DATE" Style="{StaticResource ReportHeaderTextStyle}"/>
                                <TextBlock Grid.Column="1" Text="COMPANY" Style="{StaticResource ReportHeaderTextStyle}"/>
                                <TextBlock Grid.Column="2" Text="CUSTOMER" Style="{StaticResource ReportHeaderTextStyle}"/>
                                <TextBlock Grid.Column="3" Text="PROJECT" Style="{StaticResource ReportHeaderTextStyle}"/>
                                <TextBlock Grid.Column="4" Text="SALESMAN" Style="{StaticResource ReportHeaderTextStyle}"/>
                                <TextBlock Grid.Column="5" Text="STATUS" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="DATE" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="7" Text="SUBTOTAL" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="8" Text="VAT (5%)" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="9" Text="TOTAL" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Loading State -->
                        <loading:LoadingStateControl Grid.Row="1" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" Message="Loading VAT submission data…"/>

                        <!-- Empty State -->
                        <emptyState:EmptyStateControl Grid.Row="1" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" Title="No VAT records found" Message="Try adjusting your filters or date range. The report queries Proforma Invoice records." Icon="&#xE913;"/>

                        <!-- Error State -->
                        <Border Grid.Row="1" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="{DynamicResource TintRedBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource CardCornerRadius}" Margin="16" Padding="20">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextDisplayLarge}" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Unable to load records" FontSize="{StaticResource TextSection}" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding ErrorMessage}" FontSize="{StaticResource TextBody}" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,4,0,12" MaxWidth="500" TextAlignment="Center"/>
                                <Button Content="Retry" Command="{Binding RefreshCommand}" Style="{StaticResource ReportRetryButton}" HorizontalAlignment="Center" ToolTip="Retry loading records"/>
                            </StackPanel>
                        </Border>

                        <!-- Row-level data -->
                        <ListBox Grid.Row="1" ItemsSource="{Binding Rows}"
                                 Style="{StaticResource ModuleReportListBoxStyle}"
                                 Visibility="{Binding IsContentVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ModuleListRowStyle}" Padding="14,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.9*"/>
                                                <ColumnDefinition Width="1.0*"/>
                                                <ColumnDefinition Width="1.0*"/>
                                                <ColumnDefinition Width="0.9*"/>
                                                <ColumnDefinition Width="0.7*"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="1.0*"/>
                                                <ColumnDefinition Width="0.9*"/>
                                                <ColumnDefinition Width="1.0*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- PI # + Date (stacked) -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding ProformaId}" FontSize="{StaticResource TextBody}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Company -->
                                            <TextBlock Grid.Column="1" Text="{Binding CompanyName}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>

                                            <!-- Customer -->
                                            <TextBlock Grid.Column="2" Text="{Binding CustomerName}" FontSize="{StaticResource TextBody}" Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>

                                            <!-- Project -->
                                            <TextBlock Grid.Column="3" Text="{Binding ProjectName}" FontSize="{StaticResource TextBody}" Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>

                                            <!-- Salesman -->
                                            <TextBlock Grid.Column="4" Text="{Binding Salesman}" FontSize="{StaticResource TextBody}" Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>

                                            <!-- Status Badge -->
                                            <Border Grid.Column="5" CornerRadius="6" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource TintGrayBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Approved"><Setter Property="Background" Value="{DynamicResource TintGreenBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Sent"><Setter Property="Background" Value="{DynamicResource TintBlueBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Rejected"><Setter Property="Background" Value="{DynamicResource TintRedBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Draft"><Setter Property="Background" Value="{DynamicResource TintAmberBrush}"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Approved"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Sent"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Rejected"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Draft"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Date -->
                                            <TextBlock Grid.Column="6" Text="{Binding IssueDate, StringFormat={}{0:dd MMM}}" FontSize="{StaticResource TextBody}" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                            <!-- Subtotal -->
                                            <TextBlock Grid.Column="7" Text="{Binding SubtotalBeforeVat, StringFormat={}AED {0:N2}}" FontSize="{StaticResource TextBody}" Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                            <!-- VAT -->
                                            <TextBlock Grid.Column="8" Text="{Binding VatAmount, StringFormat={}AED {0:N2}}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                            <!-- Total -->
                                            <TextBlock Grid.Column="9" Text="{Binding GrandTotalVatInclusive, StringFormat={}AED {0:N2}}" FontSize="{StaticResource TextBody}" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- ══════════════════════════════════════════════════
                         BY SALESMAN VIEW
                    ══════════════════════════════════════════════════ -->
                    <Grid Grid.Row="1" Visibility="{Binding IsSalesmanView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Table header -->
                        <Border Grid.Row="0" Style="{StaticResource ReportTableHeaderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="1.0*"/>
                                    <ColumnDefinition Width="1.0*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="SALESMAN" Style="{StaticResource ReportHeaderTextStyle}"/>
                                <TextBlock Grid.Column="1" Text="INVOICES" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="TOTAL VAT" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="TOTAL REVENUE" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Loading / Empty / Error -->
                        <loading:LoadingStateControl Grid.Row="1" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" Message="Loading VAT data…"/>
                        <emptyState:EmptyStateControl Grid.Row="1" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" Title="No salesman data" Message="No VAT records found for the selected filters." Icon="&#xE77B;"/>

                        <!-- Data rows -->
                        <ListBox Grid.Row="1" ItemsSource="{Binding SalesmanSummary}"
                                 Style="{StaticResource ModuleReportListBoxStyle}"
                                 Visibility="{Binding IsContentVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ModuleListRowStyle}" Padding="14,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="1.0*"/>
                                                <ColumnDefinition Width="1.0*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Salesman}" FontSize="{StaticResource TextBody}" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <Border Grid.Column="1" Background="{DynamicResource TintBlueBrush}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding InvoiceCount}" FontSize="{StaticResource TextBody}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                            </Border>

                                            <TextBlock Grid.Column="2" Text="{Binding TotalVat, StringFormat={}AED {0:N2}}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                            <TextBlock Grid.Column="3" Text="{Binding TotalRevenue, StringFormat={}AED {0:N2}}" FontSize="{StaticResource TextBody}" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- ══════════════════════════════════════════════════
                         BY COMPANY VIEW
                    ══════════════════════════════════════════════════ -->
                    <Grid Grid.Row="1" Visibility="{Binding IsCompanyView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Table header -->
                        <Border Grid.Row="0" Style="{StaticResource ReportTableHeaderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="1.0*"/>
                                    <ColumnDefinition Width="1.0*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="COMPANY" Style="{StaticResource ReportHeaderTextStyle}"/>
                                <TextBlock Grid.Column="1" Text="INVOICES" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="TOTAL VAT" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="TOTAL REVENUE" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Loading / Empty / Error -->
                        <loading:LoadingStateControl Grid.Row="1" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" Message="Loading VAT data…"/>
                        <emptyState:EmptyStateControl Grid.Row="1" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" Title="No company data" Message="No VAT records found for the selected filters." Icon="&#xE82F;"/>

                        <!-- Data rows -->
                        <ListBox Grid.Row="1" ItemsSource="{Binding CompanySummary}"
                                 Style="{StaticResource ModuleReportListBoxStyle}"
                                 Visibility="{Binding IsContentVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ModuleListRowStyle}" Padding="14,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="1.0*"/>
                                                <ColumnDefinition Width="1.0*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding CompanyName}" FontSize="{StaticResource TextBody}" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <Border Grid.Column="1" Background="{DynamicResource TintBlueBrush}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding InvoiceCount}" FontSize="{StaticResource TextBody}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                            </Border>

                                            <TextBlock Grid.Column="2" Text="{Binding TotalVat, StringFormat={}AED {0:N2}}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                            <TextBlock Grid.Column="3" Text="{Binding TotalRevenue, StringFormat={}AED {0:N2}}" FontSize="{StaticResource TextBody}" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- ══════════════════════════════════════════════════
                         BY PROJECT VIEW
                    ══════════════════════════════════════════════════ -->
                    <Grid Grid.Row="1" Visibility="{Binding IsProjectView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Table header -->
                        <Border Grid.Row="0" Style="{StaticResource ReportTableHeaderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.0*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="1.0*"/>
                                    <ColumnDefinition Width="1.0*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="PROJECT" Style="{StaticResource ReportHeaderTextStyle}"/>
                                <TextBlock Grid.Column="1" Text="COMPANY" Style="{StaticResource ReportHeaderTextStyle}"/>
                                <TextBlock Grid.Column="2" Text="INVOICES" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="TOTAL VAT" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="TOTAL REVENUE" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Loading / Empty / Error -->
                        <loading:LoadingStateControl Grid.Row="1" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" Message="Loading VAT data…"/>
                        <emptyState:EmptyStateControl Grid.Row="1" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" Title="No project data" Message="No VAT records found for the selected filters." Icon="&#xE82F;"/>

                        <!-- Data rows -->
                        <ListBox Grid.Row="1" ItemsSource="{Binding ProjectSummary}"
                                 Style="{StaticResource ModuleReportListBoxStyle}"
                                 Visibility="{Binding IsContentVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ModuleListRowStyle}" Padding="14,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.0*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="1.0*"/>
                                                <ColumnDefinition Width="1.0*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding ProjectName}" FontSize="{StaticResource TextBody}" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding CompanyName}" FontSize="{StaticResource TextBody}" Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>

                                            <Border Grid.Column="2" Background="{DynamicResource TintBlueBrush}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding InvoiceCount}" FontSize="{StaticResource TextBody}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                            </Border>

                                            <TextBlock Grid.Column="3" Text="{Binding TotalVat, StringFormat={}AED {0:N2}}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                            <TextBlock Grid.Column="4" Text="{Binding TotalRevenue, StringFormat={}AED {0:N2}}" FontSize="{StaticResource TextBody}" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>

                <!-- ══════════════════════════════════════════════════════════
                     4. PAGINATION FOOTER
                ══════════════════════════════════════════════════════════ -->
                <Border Grid.Row="3" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding PageDisplay}" FontSize="{StaticResource TextBody}" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="‹ Prev" Command="{Binding PrevPageCommand}" Style="{StaticResource ReportPaginationButton}" ToolTip="Go to previous page"/>
                            <Button Content="Next ›" Command="{Binding NextPageCommand}" Style="{StaticResource ReportPaginationButton}" ToolTip="Go to next page"/>
                            <Button Content="↻" Command="{Binding RefreshCommand}" Style="{StaticResource ReportPaginationButton}" ToolTip="Refresh report data"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>
