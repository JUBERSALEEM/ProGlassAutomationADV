<UserControl x:Class="ProGlassAutomation.Views.Reports.VatSubmission.VatSubmissionView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loading="clr-namespace:ProGlassAutomation.Controls.LoadingState"
             xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ 1 · HEADER BAR ═══════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="24,18,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="VAT Submission" Style="{StaticResource ModulePageTitleStyle}"/>
                    <Border Margin="14,4,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="10,3" SnapsToDevicePixels="True">
                        <TextBlock Text="5% UAE FTA" FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="VAT breakdown by salesman, company, project · Export for tax filing compliance."
                           Style="{StaticResource ModulePageSubtitleStyle}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Margin="0,0,8,0" MinWidth="100"
                        Style="{StaticResource ModuleToolbarSecondaryButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="REFRESH" Tag="↻"/>
                <Button MinWidth="120"
                        Style="{StaticResource ModuleToolbarPrimaryButtonStyle}"
                        Command="{Binding ExportPdfCommand}"
                        Content="EXPORT PDF" Tag="📄"/>
            </StackPanel>
        </Grid>

        <!-- ══ 2 · KPI STRIP ═══════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource ModuleListKpiStripStyle}" Margin="24,0,24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total VAT Collected -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource ModuleListKpiIconStyle}"
                            Background="{DynamicResource TintGreenBrush}">
                        <TextBlock Text="💰" FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Total VAT Collected" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                        <TextBlock Text="{Binding Summary.TotalVatCollected, StringFormat={}{0:N2} AED}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                        <TextBlock Text="5% VAT amount" Style="{StaticResource ModuleListKpiHintStyle}"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                <!-- Total Revenue -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource ModuleListKpiIconStyle}"
                            Background="{DynamicResource TintBlueBrush}">
                        <TextBlock Text="📊" FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Total Revenue" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                        <TextBlock Text="{Binding Summary.TotalGrandTotal, StringFormat={}{0:N2} AED}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                        <TextBlock Text="Grand total incl. VAT" Style="{StaticResource ModuleListKpiHintStyle}"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="3" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                <!-- Total Invoices -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource ModuleListKpiIconStyle}"
                            Background="{DynamicResource TintAmberBrush}">
                        <TextBlock Text="📋" FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Total Invoices" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                        <TextBlock Text="{Binding Summary.TotalInvoices}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                        <TextBlock Text="Proforma invoices" Style="{StaticResource ModuleListKpiHintStyle}"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="5" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                <!-- Average VAT per Invoice -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource ModuleListKpiIconStyle}"
                            Background="{DynamicResource TintRedBrush}">
                        <TextBlock Text="📈" FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource DangerBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Avg VAT/Invoice" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                        <TextBlock Text="{Binding Summary.AverageVatPerInvoice, StringFormat={}{0:N2} AED}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                        <TextBlock Text="Per invoice average" Style="{StaticResource ModuleListKpiHintStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ 3 · FILTER BAR + VIEW MODE TABS ═════════════════════ -->
        <Grid Grid.Row="2" Margin="24,0,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Filter Bar -->
            <Border Grid.Row="0" Style="{StaticResource ModuleListFilterBarStyle}" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <DatePicker Grid.Column="0" 
                               SelectedDate="{Binding DateFrom, Mode=TwoWay}"
                               Style="{StaticResource ModuleListFilterDatePickerStyle}"
                               ToolTip="From date"/>
                    <DatePicker Grid.Column="2" 
                               SelectedDate="{Binding DateTo, Mode=TwoWay}"
                               Style="{StaticResource ModuleListFilterDatePickerStyle}"
                               ToolTip="To date"/>
                    <ComboBox Grid.Column="4" 
                             ItemsSource="{Binding CompanyOptions}"
                             SelectedItem="{Binding CompanyFilter, Mode=TwoWay}"
                             Style="{StaticResource ModuleListFilterComboStyle}"
                             ToolTip="Filter by company"/>
                    <ComboBox Grid.Column="6" 
                             ItemsSource="{Binding SalesmanOptions}"
                             SelectedItem="{Binding SalesmanFilter, Mode=TwoWay}"
                             Style="{StaticResource ModuleListFilterComboStyle}"
                             ToolTip="Filter by salesman"/>
                    <ComboBox Grid.Column="8" 
                             ItemsSource="{Binding ProjectOptions}"
                             SelectedItem="{Binding ProjectFilter, Mode=TwoWay}"
                             Style="{StaticResource ModuleListFilterComboStyle}"
                             ToolTip="Filter by project"/>
                    <Button Grid.Column="10" MinWidth="92" Margin="8,0,0,0"
                            Style="{StaticResource ModuleToolbarSecondaryButtonStyle}"
                            Command="{Binding ClearFilterCommand}"
                            Content="RESET" Tag="↺"/>
                </Grid>
            </Border>

            <!-- View Mode Tabs -->
            <Border Grid.Row="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Content="Detail View"
                            Command="{Binding ChangeViewModeCommand}"
                            CommandParameter="Detail"
                            Style="{StaticResource ModuleListTabActiveStyle}"
                            HorizontalContentAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,4,0"/>
                    <Button Grid.Column="1" Content="By Salesman"
                            Command="{Binding ChangeViewModeCommand}"
                            CommandParameter="BySalesman"
                            Style="{StaticResource ModuleListTabInactiveStyle}"
                            HorizontalContentAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            Margin="4,0,4,0"/>
                    <Button Grid.Column="2" Content="By Company"
                            Command="{Binding ChangeViewModeCommand}"
                            CommandParameter="ByCompany"
                            Style="{StaticResource ModuleListTabInactiveStyle}"
                            HorizontalContentAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            Margin="4,0,4,0"/>
                    <Button Grid.Column="3" Content="By Project"
                            Command="{Binding ChangeViewModeCommand}"
                            CommandParameter="ByProject"
                            Style="{StaticResource ModuleListTabInactiveStyle}"
                            HorizontalContentAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            Margin="4,0,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ══ 4 · DATA GRIDS ═══════════════════════════════════════ -->
        <Grid Grid.Row="3" Margin="24,0,24,12">
            <!-- Loading State -->
            <loading:LoadingStateControl Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" 
                                        Message="Loading VAT data…"/>

            <!-- Empty State -->
            <emptyState:EmptyStateControl Message="No VAT data available for the selected filters"
                                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- ══ DETAIL VIEW ══ -->
            <Border Visibility="{Binding IsDetailView, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="12,12,0,0"
                            Padding="16,12"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PI NUMBER" Style="{StaticResource ModuleListHeaderTextStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Grid.Column="1" Text="COMPANY" Style="{StaticResource ModuleListHeaderTextStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Grid.Column="2" Text="CUSTOMER" Style="{StaticResource ModuleListHeaderTextStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Grid.Column="3" Text="PROJECT" Style="{StaticResource ModuleListHeaderTextStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Grid.Column="4" Text="SALESMAN" Style="{StaticResource ModuleListHeaderTextStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Grid.Column="5" Text="ISSUE DATE" Style="{StaticResource ModuleListHeaderTextStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Grid.Column="6" Text="STATUS" Style="{StaticResource ModuleListHeaderTextStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Grid.Column="7" Text="SUBTOTAL" Style="{StaticResource ModuleListHeaderTextStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="8" Text="VAT (5%)" Style="{StaticResource ModuleListHeaderTextStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="9" Text="TOTAL" Style="{StaticResource ModuleListHeaderTextStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1"
                             ItemsSource="{Binding Rows}"
                             Style="{StaticResource LiquidGlassDataGridStyle}"
                             AutoGenerateColumns="False"
                             IsReadOnly="True"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             HeadersVisibility="None"
                             BorderThickness="0"
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding ProformaId}" Width="120"/>
                            <DataGridTextColumn Binding="{Binding CompanyName}" Width="150"/>
                            <DataGridTextColumn Binding="{Binding CustomerName}" Width="150"/>
                            <DataGridTextColumn Binding="{Binding ProjectName}" Width="150"/>
                            <DataGridTextColumn Binding="{Binding Salesman}" Width="120"/>
                            <DataGridTextColumn Binding="{Binding IssueDateDisplay}" Width="100"/>
                            <DataGridTextColumn Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Binding="{Binding SubtotalDisplay}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding VatDisplay}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding TotalDisplay}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ══ BY SALESMAN VIEW ══ -->
            <Border Visibility="{Binding IsSalesmanView, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="12,12,0,0"
                            Padding="16,12"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SALESMAN" Style="{StaticResource ModuleListHeaderTextStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Grid.Column="1" Text="INVOICES" Style="{StaticResource ModuleListHeaderTextStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="TOTAL VAT" Style="{StaticResource ModuleListHeaderTextStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="TOTAL REVENUE" Style="{StaticResource ModuleListHeaderTextStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1"
                             ItemsSource="{Binding SalesmanSummary}"
                             Style="{StaticResource LiquidGlassDataGridStyle}"
                             AutoGenerateColumns="False"
                             IsReadOnly="True"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             HeadersVisibility="None"
                             BorderThickness="0"
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Salesman}" Width="200"/>
                            <DataGridTextColumn Binding="{Binding InvoiceCount}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding TotalVatDisplay}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding TotalRevenueDisplay}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ══ BY COMPANY VIEW ══ -->
            <Border Visibility="{Binding IsCompanyView, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="12,12,0,0"
                            Padding="16,12"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="COMPANY" Style="{StaticResource ModuleListHeaderTextStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Grid.Column="1" Text="INVOICES" Style="{StaticResource ModuleListHeaderTextStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="TOTAL VAT" Style="{StaticResource ModuleListHeaderTextStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="TOTAL REVENUE" Style="{StaticResource ModuleListHeaderTextStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1"
                             ItemsSource="{Binding CompanySummary}"
                             Style="{StaticResource LiquidGlassDataGridStyle}"
                             AutoGenerateColumns="False"
                             IsReadOnly="True"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             HeadersVisibility="None"
                             BorderThickness="0"
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding CompanyName}" Width="200"/>
                            <DataGridTextColumn Binding="{Binding InvoiceCount}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding TotalVatDisplay}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding TotalRevenueDisplay}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ══ BY PROJECT VIEW ══ -->
            <Border Visibility="{Binding IsProjectView, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="12,12,0,0"
                            Padding="16,12"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PROJECT" Style="{StaticResource ModuleListHeaderTextStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Grid.Column="1" Text="COMPANY" Style="{StaticResource ModuleListHeaderTextStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Grid.Column="2" Text="INVOICES" Style="{StaticResource ModuleListHeaderTextStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="TOTAL VAT" Style="{StaticResource ModuleListHeaderTextStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="TOTAL REVENUE" Style="{StaticResource ModuleListHeaderTextStyle}" Foreground="{DynamicResource OnAccentForegroundBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1"
                             ItemsSource="{Binding ProjectSummary}"
                             Style="{StaticResource LiquidGlassDataGridStyle}"
                             AutoGenerateColumns="False"
                             IsReadOnly="True"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             HeadersVisibility="None"
                             BorderThickness="0"
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding ProjectName}" Width="180"/>
                            <DataGridTextColumn Binding="{Binding CompanyName}" Width="150"/>
                            <DataGridTextColumn Binding="{Binding InvoiceCount}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding TotalVatDisplay}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding TotalRevenueDisplay}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ══ 5 · FOOTER ═══════════════════════════════════════════ -->
        <Grid Grid.Row="4" Margin="24,0,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontSize="{StaticResource TextBody}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           VerticalAlignment="Center">
                    <Run Text="Showing "/>
                    <Run Text="{Binding Rows.Count, Mode=OneWay}"/>
                    <Run Text=" of "/>
                    <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                    <Run Text=" records"/>
                </TextBlock>
            </StackPanel>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="CSV" 
                       Command="{Binding ExportCsvCommand}"
                       Style="{StaticResource ExportButtonStyle}"
                       Margin="0,0,8,0"
                       ToolTip="Export to CSV"/>
                <Button Content="Excel" 
                       Command="{Binding ExportExcelCommand}"
                       Style="{StaticResource ExportButtonStyle}"
                       Margin="0,0,8,0"
                       ToolTip="Export to Excel"/>
                <Button Content="PDF" 
                       Command="{Binding ExportPdfCommand}"
                       Style="{StaticResource ModuleToolbarPrimaryButtonStyle}"
                       ToolTip="Export to PDF"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
