<UserControl x:Class="ProGlassAutomation.Views.Reports.DeliveryReport.DeliveryReportView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loading="clr-namespace:ProGlassAutomation.Controls.LoadingState"
             xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- ═══════════════════════════════════════════════════════════════════
         DELIVERY NOTE REPORT — ROW-LEVEL (SINGLE GRID)
         One grid row per exact PI specification row (PI → Spec → Sr No).
         Quantities are reconciled per row from the stored DeliveryNoteItems
         table: Total = original order qty · Delivered = sum across DNs ·
         Balance = Total − Delivered. The related Delivery Notes expand
         INLINE inside each row — no split list + side panel.
    ═══════════════════════════════════════════════════════════════════ -->
    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="16,14,16,12">
            <TextBlock Text="Delivery Note Report" Style="{StaticResource ModulePageTitleStyle}" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Row-level delivery trace: every PI specification row with Total / Delivered / Balance quantities, reconciled from the actual stored Delivery Notes." Style="{StaticResource ModulePageSubtitleStyle}" TextWrapping="Wrap" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- Main Shell Card -->
        <Border Grid.Row="1" Style="{StaticResource ModuleListShellStyle}" Margin="16,0,16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- KPI Strip -->
                    <RowDefinition Height="Auto"/> <!-- Filter Bar -->
                    <RowDefinition Height="*"/>    <!-- Table -->
                    <RowDefinition Height="Auto"/> <!-- Pagination Footer -->
                </Grid.RowDefinitions>

                <!-- ══════════════════════════════════════════════════════════
                     1. KPI STRIP — row-level buckets
                ══════════════════════════════════════════════════════════════ -->
                <Border Grid.Row="0" Style="{StaticResource ModuleListKpiStripStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Total rows -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Total specification rows across all job orders">
                            <Border Width="38" Height="38" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource TintBlueBrush}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ROWS" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding Summary.TotalRows}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="{Binding CompletionText}" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <!-- Not delivered -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Rows with zero delivered quantity">
                            <Border Width="38" Height="38" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource TintGrayBrush}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource NeutralBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="NOT DELIVERED" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding Summary.NotDelivered}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="No delivery yet" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="3" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <!-- Partial -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Rows delivered in part with balance remaining">
                            <Border Width="38" Height="38" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource TintAmberBrush}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE9FA;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="PARTIAL" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding Summary.Partial}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="In progress" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="5" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <!-- Fully delivered -->
                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Rows with zero balance">
                            <Border Width="38" Height="38" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource TintGreenBrush}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="FULLY DELIVERED" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding Summary.FullyDelivered}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="Balance = 0" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════════════════
                     2. FILTER BAR
                ══════════════════════════════════════════════════════════════ -->
                <Border Grid.Row="1" Style="{StaticResource ModuleListFilterBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <!-- PI number -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="PI NUMBER" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox Width="130" Style="{StaticResource ModuleListFilterComboStyle}"
                                          ItemsSource="{Binding PiOptions}"
                                          SelectedItem="{Binding PiFilter}"
                                          ToolTip="Filter by Proforma Invoice number"/>
                            </StackPanel>

                            <!-- Specification -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="SPECIFICATION" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox Width="210" Style="{StaticResource ModuleListFilterComboStyle}"
                                          ItemsSource="{Binding SpecificationOptions}"
                                          SelectedItem="{Binding SpecificationFilter}"
                                          ToolTip="Filter by exact glass specification"/>
                            </StackPanel>

                            <!-- Glass ref -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="GLASS REF" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox Width="110" Style="{StaticResource ModuleListFilterComboStyle}"
                                          ItemsSource="{Binding GlassRefOptions}"
                                          SelectedItem="{Binding GlassRefFilter}"
                                          ToolTip="Filter by exact glass reference"/>
                            </StackPanel>

                            <!-- Glass type -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="GLASS TYPE" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox Width="120" Style="{StaticResource ModuleListFilterComboStyle}"
                                          ItemsSource="{Binding GlassTypeOptions}"
                                          SelectedItem="{Binding GlassTypeFilter}"
                                          ToolTip="Filter by glass type (SGU / DGU / LAM / DGU+LAM)"/>
                            </StackPanel>

                            <!-- Salesman -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="SALESMAN" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox Width="140" Style="{StaticResource ModuleListFilterComboStyle}"
                                          ItemsSource="{Binding DeliverySalesmanOptions}"
                                          SelectedItem="{Binding SalesmanFilter}"
                                          ToolTip="Filter by sales representative"/>
                            </StackPanel>

                            <!-- Project -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="PROJECT" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox Width="150" Style="{StaticResource ModuleListFilterComboStyle}"
                                          ItemsSource="{Binding DeliveryProjectOptions}"
                                          SelectedItem="{Binding ProjectFilter}"
                                          ToolTip="Filter by project"/>
                            </StackPanel>

                            <!-- Customer -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="CUSTOMER" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox Width="150" Style="{StaticResource ModuleListFilterComboStyle}"
                                          ItemsSource="{Binding DeliveryCustomerOptions}"
                                          SelectedItem="{Binding CustomerFilter}"
                                          ToolTip="Filter by customer"/>
                            </StackPanel>

                            <!-- Delivery status -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="STATUS" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox Width="140" Style="{StaticResource ModuleListFilterComboStyle}"
                                          ItemsSource="{Binding StatusOptions}"
                                          SelectedItem="{Binding SelectedStatus}"
                                          ToolTip="Filter by delivery status"/>
                            </StackPanel>

                            <!-- Date From -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="FROM DATE" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <DatePicker Width="128" Style="{StaticResource ModuleListFilterDatePickerStyle}" SelectedDate="{Binding DateFrom}" ToolTip="Filter rows by delivery date start"/>
                            </StackPanel>

                            <!-- Date To -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="TO DATE" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <DatePicker Width="128" Style="{StaticResource ModuleListFilterDatePickerStyle}" SelectedDate="{Binding DateTo}" ToolTip="Filter rows by delivery date end"/>
                            </StackPanel>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,6,6">
                                <Button Content="Apply" Command="{Binding ApplyFilterCommand}" Style="{StaticResource ReportToolbarPrimaryButton}" ToolTip="Apply selected filters"/>
                                <Button Content="Clear" Command="{Binding ClearFilterCommand}" Style="{StaticResource ReportToolbarOutlinedButton}" ToolTip="Reset filters"/>
                            </StackPanel>
                        </WrapPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="8,0,0,6">
                            <TextBlock Text="EXPORT" Style="{StaticResource ModuleFieldLabelStyle}" HorizontalAlignment="Right"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource ReportExportOutlinedButton}" ToolTip="Export row-level report to CSV"/>
                                <Button Content="Excel" Command="{Binding ExportExcelCommand}" Style="{StaticResource ReportExportOutlinedButton}" ToolTip="Export row-level report to Excel (.xlsx)"/>
                                <Button Content="PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource ReportExportPrimaryButton}" ToolTip="Export professional PDF report"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                                <!-- ══════════════════════════════════════════════════════════
                     3. TABLE + RIGHT SLIDE-IN ROW DETAIL PANEL (Sheet Store)
                ══════════════════════════════════════════════════════════ -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <!-- Animated panel column: width 0 when closed, expands to
                             370 (360 panel + 10 margin) when a row is selected. -->
                        <ColumnDefinition x:Name="DetailColumn" Width="0"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Table header -->
                    <Border Grid.Row="0" Style="{StaticResource ReportTableHeaderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="0.7*"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="58"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SR NO" Style="{StaticResource ReportHeaderTextStyle}"/>
                            <TextBlock Grid.Column="1" Text="PI #" Style="{StaticResource ReportHeaderTextStyle}"/>
                            <TextBlock Grid.Column="2" Text="SPECIFICATION" Style="{StaticResource ReportHeaderTextStyle}"/>
                            <TextBlock Grid.Column="3" Text="GLASS TYPE" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="GLASS REF" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="CUSTOMER" Style="{StaticResource ReportHeaderTextStyle}"/>
                            <TextBlock Grid.Column="6" Text="SALESMAN" Style="{StaticResource ReportHeaderTextStyle}"/>
                            <TextBlock Grid.Column="7" Text="PROJECT" Style="{StaticResource ReportHeaderTextStyle}"/>
                            <TextBlock Grid.Column="8" Text="W1" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="9" Text="H1" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="10" Text="W2" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="11" Text="H2" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="12" Text="TOTAL" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="13" Text="DELIV." Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="14" Text="BALANCE" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- States -->
                    <loading:LoadingStateControl Grid.Row="1" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" Message="Loading row-level delivery trace…"/>
                    <emptyState:EmptyStateControl Grid.Row="1" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" Title="No delivery rows found" Message="No PI specification rows match the current filters. Rows appear once their quote has a Job Order." Icon="&#xE814;"/>

                    <!-- Error State -->
                    <Border Grid.Row="1" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="{DynamicResource TintRedBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource CardCornerRadius}" Margin="16" Padding="20">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Unable to load records" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,4,0,12" MaxWidth="500" TextAlignment="Center"/>
                            <Button Content="Retry" Command="{Binding RefreshCommand}" Style="{StaticResource ReportRetryButton}" HorizontalAlignment="Center" ToolTip="Retry loading records"/>
                        </StackPanel>
                    </Border>

                    <!-- Row-level rows (virtualized, single grid) -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding Rows}"
                             Style="{StaticResource ModuleReportListBoxStyle}"
                             Visibility="{Binding IsContentVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,9" Cursor="Hand"
                                        ToolTip="Click to view delivery history for this row"
                                        MouseLeftButtonDown="Row_Click"
                                        Tag="{Binding}">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ModuleListRowStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource TintBlueBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="0.7*"/>
                                            <ColumnDefinition Width="0.9*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="0.9*"/>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="58"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding SerialNumber}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ProformaId}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Specification}" FontSize="12" Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" ToolTip="{Binding Specification}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding GlassType}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="4" Text="{Binding GlassRef}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="5" Text="{Binding CustomerName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="6" Text="{Binding Salesman}" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="7" Text="{Binding ProjectName}" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="8" Text="{Binding W1}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        <TextBlock Grid.Column="9" Text="{Binding H1}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        <TextBlock Grid.Column="10" Text="{Binding W2}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        <TextBlock Grid.Column="11" Text="{Binding H2}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        <TextBlock Grid.Column="12" Text="{Binding TotalQty}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        <TextBlock Grid.Column="13" Text="{Binding DeliveredQty}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SuccessBrush}"/>
                                        <TextBlock Grid.Column="14" Text="{Binding BalanceQty}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Grid>

                    <!-- ══ RIGHT SLIDE-IN ROW DETAIL PANEL (Sheet Store pattern) ══
                         Collapsed by default; opens when a row is selected. Shows
                         the selected row's spec / glass / quantities and its
                         delivery history. -->
                    <Grid x:Name="DetailPanel" Grid.Column="1" Margin="10,0,0,0"
                          Visibility="Collapsed">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="PanelSlide" X="0"/>
                        </Grid.RenderTransform>

                        <Border Width="360"
                                VerticalAlignment="Stretch"
                                Background="{DynamicResource ModuleBackgroundBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                Padding="20"
                                SnapsToDevicePixels="True">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <!-- Panel header + close -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                                                Grid.Column="0" Background="{DynamicResource AccentBrush}">
                                            <TextBlock Text="&#xE814;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0">
                                            <TextBlock Text="ROW DETAILS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="{Binding SidebarSubtitle}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource RowOutlinedButton}"
                                                Tag="&#xE711;" Content="" VerticalAlignment="Top"
                                                ToolTip="Close (click the row again)" Command="{Binding CloseDetailCommand}"/>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource OutlineBrush}" Margin="0,16,0,16"/>

                                    <!-- Selected row identity -->
                                    <TextBlock Text="SPECIFICATION" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" Margin="4,0,0,8"/>
                                    <Border CornerRadius="{DynamicResource CardCornerRadius}" Padding="12,10" Margin="0,0,0,12"
                                            Background="{DynamicResource TintBlueBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedRow.Specification}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap"/>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,4,0,0">
                                                <Run Text="Glass type: "/><Run Text="{Binding SelectedRow.GlassType, Mode=OneWay}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0">
                                                <Run Text="Glass ref: "/><Run Text="{Binding SelectedRow.GlassRef, Mode=OneWay}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0">
                                                <Run Text="Dimensions: "/><Run Text="{Binding SelectedRow.GlassDetails, Mode=OneWay}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Selected row quantities -->
                                    <TextBlock Text="QUANTITIES" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" Margin="4,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="12,10" Margin="0,0,4,10"
                                                Background="{DynamicResource TintBlueBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="TOTAL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="{Binding SelectedRow.TotalQty}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="12,10" Margin="4,0,4,10"
                                                Background="{DynamicResource TintGreenBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="DELIVERED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                                <TextBlock Text="{Binding SelectedRow.DeliveredQty}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="12,10" Margin="4,0,0,10"
                                                Background="{DynamicResource TintAmberBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="BALANCE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                                <TextBlock Text="{Binding SelectedRow.BalanceQty}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Delivery history -->
                                    <TextBlock Text="DELIVERY HISTORY" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource MutedForegroundBrush}" Margin="4,0,0,8"/>
                                    <Border Background="{DynamicResource ModuleBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding SelectedRow.Deliveries}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="2,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock Text="{Binding DeliveryNoteId}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                                                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,1,0,0">
                                                                        <Run Text="{Binding DeliveryDate, Mode=OneWay, StringFormat={}{0:dd MMM yyyy}}"/>
                                                                        <Run Text=" · "/>
                                                                        <Run Text="{Binding Status, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,1,0,0">
                                                                        <Run Text="{Binding DriverName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding VehicleNumber, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <Border Grid.Column="1" CornerRadius="6" Padding="8,3" Background="{DynamicResource TintGreenBrush}" VerticalAlignment="Center">
                                                                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}">
                                                                        <Run Text="{Binding QtyDelivered, Mode=OneWay}"/><Run Text=" pcs"/>
                                                                    </TextBlock>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="No deliveries recorded for this row yet."
                                                       FontSize="11.5" Foreground="{DynamicResource MutedForegroundBrush}"
                                                       Visibility="{Binding SelectedRow.Deliveries.Count, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=0}"
                                                       Margin="2,6"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
<!-- ══════════════════════════════════════════════════════════
                     4. PAGINATION FOOTER
                ══════════════════════════════════════════════════════════════ -->
                <Border Grid.Row="3" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding PageDisplay}" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="‹ Prev" Command="{Binding PrevPageCommand}" Style="{StaticResource ReportPaginationButton}" ToolTip="Go to previous page"/>
                            <Button Content="Next ›" Command="{Binding NextPageCommand}" Style="{StaticResource ReportPaginationButton}" ToolTip="Go to next page"/>
                            <Button Content="↻" Command="{Binding RefreshCommand}" Style="{StaticResource ReportPaginationButton}" ToolTip="Refresh report data"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>
