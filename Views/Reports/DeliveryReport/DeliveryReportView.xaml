<UserControl x:Class="ProGlassAutomation.Views.Reports.DeliveryReport.DeliveryReportView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:loading="clr-namespace:ProGlassAutomation.Controls.LoadingState"
             xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState"
             xmlns:reporting="clr-namespace:ProGlassAutomation.Controls.Reporting"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- ═══════════════════════════════════════════════════════════════════
         DELIVERY NOTE REPORT — ROW-LEVEL (SINGLE GRID)
         One grid row per exact PI specification row (PI → Spec → Sr No).
         Quantities are reconciled per row from the stored DeliveryNoteItems
         table: Total = original order qty · Delivered = sum across DNs ·
         Balance = Total − Delivered. The related Delivery Notes expand
         INLINE inside each row — no split list + side panel.
    ═══════════════════════════════════════════════════════════════════ -->
    <Grid Background="{DynamicResource SurfacePrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="16,14,16,12">
            <TextBlock Text="{DynamicResource Reports.DeliveryReport.DeliveryNoteReport}" Style="{StaticResource ModulePageTitleStyle}" FontSize="{StaticResource TextTitleLarge}" FontWeight="Bold"/>
            <TextBlock Text="{DynamicResource Reports.DeliveryReport.RowLevelDeliveryTracePISpecificationRowTotal}" Style="{StaticResource ModulePageSubtitleStyle}" TextWrapping="Wrap" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- Main Shell Card -->
        <Border Grid.Row="1" Style="{StaticResource ModuleListShellStyle}" Margin="16,0,16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- KPI Strip -->
                    <RowDefinition Height="Auto"/> <!-- Filter Bar -->
                    <RowDefinition Height="Auto"/> <!-- Ageing analytics -->
                    <RowDefinition Height="*"/>    <!-- Table -->
                    <RowDefinition Height="Auto"/> <!-- Pagination Footer -->
                </Grid.RowDefinitions>

                <!-- ══════════════════════════════════════════════════════════
                     1. KPI STRIP — quantity stats (TOTAL / DELIVERED / BALANCE
                        / COMPLETION), recomputed for the current filters.
                ══════════════════════════════════════════════════════════════ -->
                <Border Grid.Row="0" Style="{StaticResource ModuleListKpiStripStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Total ordered qty -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{DynamicResource Reports.DeliveryReport.TotalOrderedPiecesFilteredRows}">
                            <Border Width="38" Height="38" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource TintBlueBrush}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSubhead}" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Reports.DeliveryReport.TotalQTY}" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding Summary.TotalOrderedQty}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="{Binding OrderedText}" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <!-- Delivered qty -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{DynamicResource Reports.DeliveryReport.TotalDeliveredPiecesFilteredRows}">
                            <Border Width="38" Height="38" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource TintGreenBrush}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSubhead}" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Common.Delivered}" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding Summary.TotalDeliveredQty}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="{Binding DeliveredText}" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="3" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <!-- Balance qty -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{DynamicResource Reports.DeliveryReport.RemainingPiecesTotalDeliveredFilteredRows}">
                            <Border Width="38" Height="38" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource TintAmberBrush}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE9FA;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSubhead}" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Common.Balance}" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding Summary.TotalRemainingQty}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="{Binding BalanceText}" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="5" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <!-- Completion % -->
                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{DynamicResource Reports.DeliveryReport.DeliveredPercentageOrderedPieces}">
                            <Border Width="38" Height="38" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource TintGrayBrush}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSubhead}" Foreground="{DynamicResource InfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Reports.DeliveryReport.Completion}" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding Summary.CompletionPct, StringFormat={}{0:0.0}%}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="{Binding CompletionText}" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════════════════
                     2. FILTER BAR
                ══════════════════════════════════════════════════════════════ -->
                <Border Grid.Row="1" Style="{StaticResource ReportFilterCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                            <!-- PI number -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="{DynamicResource Reports.DeliveryReport.PINumber}" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox Width="130" Style="{StaticResource ModernComboBoxStyle}" Height="40" MinHeight="40"
                                          ItemsSource="{Binding PiOptions}"
                                          SelectedItem="{Binding PiFilter}"
                                          ToolTip="{DynamicResource Reports.DeliveryReport.FilterProformaInvoiceNumber}"/>
                            </StackPanel>

                            <!-- Specification -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="{DynamicResource Common.Specification}" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox Width="210" Style="{StaticResource ModernComboBoxStyle}" Height="40" MinHeight="40"
                                          ItemsSource="{Binding SpecificationOptions}"
                                          SelectedItem="{Binding SpecificationFilter}"
                                          ToolTip="{DynamicResource Reports.DeliveryReport.FilterExactGlassSpecification}"/>
                            </StackPanel>

                            <!-- Glass ref -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="{DynamicResource DeliveryNote.GlassRef}" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox Width="110" Style="{StaticResource ModernComboBoxStyle}" Height="40" MinHeight="40"
                                          ItemsSource="{Binding GlassRefOptions}"
                                          SelectedItem="{Binding GlassRefFilter}"
                                          ToolTip="{DynamicResource Reports.DeliveryReport.FilterExactGlassReference}"/>
                            </StackPanel>

                            <!-- Glass type -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="{DynamicResource JobOrder.GlassType}" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox Width="120" Style="{StaticResource ModernComboBoxStyle}" Height="40" MinHeight="40"
                                          ItemsSource="{Binding GlassTypeOptions}"
                                          SelectedItem="{Binding GlassTypeFilter}"
                                          ToolTip="{DynamicResource Reports.DeliveryReport.FilterGlassTypeSGUDGULAMDGULAM}"/>
                            </StackPanel>

                            <!-- Salesman -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="{DynamicResource Common.Salesman}" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox Width="140" Style="{StaticResource ModernComboBoxStyle}" Height="40" MinHeight="40"
                                          ItemsSource="{Binding DeliverySalesmanOptions}"
                                          SelectedItem="{Binding SalesmanFilter}"
                                          ToolTip="{DynamicResource Reports.DeliveryReport.FilterSalesRepresentative}"/>
                            </StackPanel>

                            <!-- Project -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="{DynamicResource Common.Project}" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox Width="150" Style="{StaticResource ModernComboBoxStyle}" Height="40" MinHeight="40"
                                          ItemsSource="{Binding DeliveryProjectOptions}"
                                          SelectedItem="{Binding ProjectFilter}"
                                          ToolTip="{DynamicResource Reports.DeliveryReport.FilterProject}"/>
                            </StackPanel>

                            <!-- Customer -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="{DynamicResource Common.Customer}" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox Width="150" Style="{StaticResource ModernComboBoxStyle}" Height="40" MinHeight="40"
                                          ItemsSource="{Binding DeliveryCustomerOptions}"
                                          SelectedItem="{Binding CustomerFilter}"
                                          ToolTip="{DynamicResource Reports.DeliveryReport.FilterCustomer}"/>
                            </StackPanel>

                            <!-- Delivery status -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="{DynamicResource Common.Status}" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox Width="140" Style="{StaticResource ModernComboBoxStyle}" Height="40" MinHeight="40"
                                          ItemsSource="{Binding StatusOptions}"
                                          SelectedItem="{Binding SelectedStatus}"
                                          ToolTip="{DynamicResource Reports.DeliveryReport.FilterDeliveryStatus}"/>
                            </StackPanel>

                            <!-- Date From -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="{DynamicResource Common.FromDate}" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <DatePicker Width="128" Style="{StaticResource ModuleListFilterDatePickerStyle}" Height="40" SelectedDate="{Binding DateFrom}" ToolTip="{DynamicResource Reports.DeliveryReport.FilterRowsDeliveryDateStart}"/>
                            </StackPanel>

                            <!-- Date To -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="{DynamicResource Common.ToDate}" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <DatePicker Width="128" Style="{StaticResource ModuleListFilterDatePickerStyle}" Height="40" SelectedDate="{Binding DateTo}" ToolTip="{DynamicResource Reports.DeliveryReport.FilterRowsDeliveryDateEnd}"/>
                            </StackPanel>

                            <!-- Sort by + direction -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="{DynamicResource Reports.Common.SortBy}" Style="{StaticResource ModuleFieldLabelStyle}" Foreground="{DynamicResource AccentBrush}"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Width="120" Style="{StaticResource ModernComboBoxStyle}" Height="40" MinHeight="40" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" DisplayMemberPath="Display" ToolTip="{DynamicResource Reports.Common.SortByTip}"/>
                                    <Button Command="{Binding ToggleSortDirectionCommand}" Style="{StaticResource ReportToolbarOutlinedButton}" Margin="6,0,0,0" ToolTip="{Binding SortDirectionTooltip}" Content="{Binding SortDirectionGlyph}" FontFamily="Segoe MDL2 Assets"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,6,6">
                                <Button Content="{DynamicResource Action.Clear}" Tag="&#xE711;" Command="{Binding ClearFilterCommand}" Style="{StaticResource OutlinedPillButton}" MinWidth="110" ToolTip="{DynamicResource Reports.DeliveryReport.ResetFilters}"/>
                            </StackPanel>
                        </WrapPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" VerticalAlignment="Bottom" Margin="8,0,0,6">
                            <TextBlock Text="{DynamicResource Action.Export}" Style="{StaticResource ModuleFieldLabelStyle}" HorizontalAlignment="Right"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource ReportExportOutlinedButton}" ToolTip="{DynamicResource Reports.DeliveryReport.ExportRowLevelReportCSV}"/>
                                <Button Content="{DynamicResource JobOrder.Excel}" Command="{Binding ExportExcelCommand}" Style="{StaticResource ReportExportOutlinedButton}" ToolTip="{DynamicResource Reports.DeliveryReport.ExportRowLevelReportExcelXlsx}"/>
                                <Button Content="PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource ReportExportPrimaryButton}" ToolTip="{DynamicResource Reports.DeliveryReport.ExportProfessionalPDFReport}"/>
                                <Button Content="&#xE72D;" FontFamily="Segoe MDL2 Assets" Command="{Binding ShareCommand}" Style="{StaticResource ReportExportOutlinedButton}" ToolTip="{DynamicResource Sharing.Share}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                                <!-- ══════════════════════════════════════════════════════════
                     3. TABLE + RIGHT SLIDE-IN ROW DETAIL PANEL (Sheet Store)
                ══════════════════════════════════════════════════════════ -->
                <!-- ══════════════════════════════════════════════════════════
                     2b. DELIVERY AGEING  (slice 2)
                     The KPI strip above answers "how many gone / how many
                     pending". This answers HOW OLD the pending work is —
                     "47 pending" is inert, "12 pending over 30 days" is a
                     call list. Ageing runs from the ORDER date, so a
                     partial delivery cannot reset the clock on a late row.
                ══════════════════════════════════════════════════════════════ -->
                <Border Grid.Row="2"
                        Margin="10,0,10,10"
                        Visibility="{Binding HasAnalytics, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                    <Expander IsExpanded="False"
                              Foreground="{DynamicResource TextPrimaryBrush}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Reports.AgeingAnalysis}"
                                           FontSize="{StaticResource TextBody}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <!-- Escalation badge: only shown when there
                                     IS overdue work, so it never becomes
                                     background noise. -->
                                <Border Margin="12,0,0,0"
                                        Padding="8,2"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Background="{DynamicResource DangerBrush}"
                                        Visibility="{Binding HasCriticalPending, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                                    <TextBlock Text="{Binding CriticalPendingText}"
                                               FontSize="{StaticResource TextBody}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                </Border>
                            </StackPanel>
                        </Expander.Header>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Ageing buckets -->
                            <Border Grid.Column="0" Style="{StaticResource SoftCardStyle}"
                                    Padding="14,12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Reports.PendingAgeing}"
                                               FontSize="{StaticResource TextBody}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{DynamicResource Reports.ByPieces}"
                                               FontSize="{StaticResource TextBody}"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Margin="0,2,0,8"/>

                                    <ItemsControl ItemsSource="{Binding Analytics.PendingAgeing}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="52"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Label}"
                                                               FontSize="{StaticResource TextBody}"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Qty}"
                                                               FontSize="{StaticResource TextBody}"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding SharePctDisplay}"
                                                               FontSize="{StaticResource TextBody}"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AccentBrush}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <reporting:MixPanel Grid.Column="1"
                                Title="{DynamicResource Reports.PendingByCustomer}"
                                Subtitle="{DynamicResource Reports.ByPieces}"
                                Rows="{Binding Analytics.PendingByCustomer}"
                                Margin="4,0,4,0"/>

                            <reporting:MixPanel Grid.Column="2"
                                Title="{DynamicResource Reports.PendingBySpecification}"
                                Subtitle="{DynamicResource Reports.ByPieces}"
                                Rows="{Binding Analytics.PendingBySpecification}"
                                Margin="8,0,0,0"/>
                        </Grid>
                    </Expander>
                </Border>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <!-- Animated panel column: width 0 when closed, expands to
                             370 (360 panel + 10 margin) when a row is selected. -->
                        <ColumnDefinition x:Name="DetailColumn" Width="0"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Table header -->
                    <Border Grid.Row="0" Style="{StaticResource ReportTableHeaderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="0.7*"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="58"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Padding="0,0,6,0" Text="{DynamicResource Reports.DeliveryReport.SRNO}" Style="{StaticResource ReportHeaderTextStyle}"/>
                            <TextBlock Grid.Column="1" Padding="6,0" Text="{DynamicResource Reports.DeliveryReport.PI}" Style="{StaticResource ReportHeaderTextStyle}"/>
                            <TextBlock Grid.Column="2" Padding="6,0" Text="{DynamicResource Common.Specification}" Style="{StaticResource ReportHeaderTextStyle}"/>
                            <TextBlock Grid.Column="3" Padding="6,0" Text="{DynamicResource JobOrder.GlassType}" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Padding="6,0" Text="{DynamicResource DeliveryNote.GlassRef}" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Padding="6,0" Text="{DynamicResource Common.Customer}" Style="{StaticResource ReportHeaderTextStyle}"/>
                            <TextBlock Grid.Column="6" Padding="6,0" Text="{DynamicResource Common.Salesman}" Style="{StaticResource ReportHeaderTextStyle}"/>
                            <TextBlock Grid.Column="7" Padding="6,0" Text="{DynamicResource Common.Project}" Style="{StaticResource ReportHeaderTextStyle}"/>
                            <TextBlock Grid.Column="8" Padding="6,0" Text="W1" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="9" Padding="6,0" Text="H1" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="10" Padding="6,0" Text="W2" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="11" Padding="6,0" Text="H2" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="12" Padding="6,0" Text="TOTAL" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="13" Padding="6,0" Text="{DynamicResource Reports.DeliveryReport.Deliv}" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="14" Padding="6,0,0,0" Text="{DynamicResource Common.Balance}" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- States -->
                    <loading:LoadingStateControl Grid.Row="1" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" Message="Loading row-level delivery trace…"/>
                    <emptyState:EmptyStateControl Grid.Row="1" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" Title="{DynamicResource Reports.DeliveryReport.NoDeliveryRowsFound}" Message="No PI specification rows match the current filters. Rows appear once their quote has a Job Order." Icon="&#xE814;"/>

                    <!-- Error State -->
                    <Border Grid.Row="1" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="{DynamicResource TintRedBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}"
                            CornerRadius="{DynamicResource CardCornerRadius}" Margin="16" Padding="20">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextDisplayLarge}" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Reports.DeliveryReport.UnableLoadRecords}" FontSize="{StaticResource TextSection}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="{StaticResource TextBody}" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,4,0,12" MaxWidth="500" TextAlignment="Center"/>
                            <Button Content="{DynamicResource Action.Retry}" Command="{Binding RefreshCommand}" Style="{StaticResource ReportRetryButton}" HorizontalAlignment="Center" ToolTip="{DynamicResource Reports.DeliveryReport.RetryLoadingRecords}"/>
                        </StackPanel>
                    </Border>

                    <!-- Row-level rows (virtualized, single grid) -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding Rows}"
                             Style="{StaticResource ModuleReportListBoxStyle}"
                             Visibility="{Binding IsContentVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,9" Cursor="Hand"
                                        ToolTip="{DynamicResource Reports.DeliveryReport.ClickViewDeliveryHistoryRow}"
                                        behaviors:ClickToCommandBehavior.Command="{Binding DataContext.SelectRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        behaviors:ClickToCommandBehavior.CommandParameter="{Binding}">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource ModuleListRowStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource TintBlueBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="0.7*"/>
                                            <ColumnDefinition Width="0.9*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="0.9*"/>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="58"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Padding="0,0,6,0" Text="{Binding SerialNumber}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Padding="6,0" Text="{Binding ProformaId}" FontSize="{StaticResource TextBody}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Padding="6,0" Text="{Binding SpecificationDisplay}" FontSize="{StaticResource TextBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"  ToolTip="{Binding SpecificationDisplay}"/>
                                        <TextBlock Grid.Column="3" Padding="6,0" Text="{Binding GlassType}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" Padding="6,0" Text="{Binding GlassRef}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="5" Padding="6,0" Text="{Binding CustomerName}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="6" Padding="6,0" Text="{Binding Salesman}" FontSize="{StaticResource TextBody}" Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="7" Padding="6,0" Text="{Binding ProjectName}" FontSize="{StaticResource TextBody}" Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="8" Padding="6,0" Text="{Binding W1}" FontSize="{StaticResource TextBody}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        <TextBlock Grid.Column="9" Padding="6,0" Text="{Binding H1}" FontSize="{StaticResource TextBody}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        <TextBlock Grid.Column="10" Padding="6,0" Text="{Binding W2}" FontSize="{StaticResource TextBody}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        <TextBlock Grid.Column="11" Padding="6,0" Text="{Binding H2}" FontSize="{StaticResource TextBody}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        <TextBlock Grid.Column="12" Padding="6,0" Text="{Binding TotalQty}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Grid.Column="13" Padding="6,0" Text="{Binding DeliveredQty}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SuccessBrush}"/>
                                        <TextBlock Grid.Column="14" Padding="6,0,0,0" Text="{Binding BalanceQty}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Grid>

                    <!-- ══ RIGHT SLIDE-IN ROW DETAIL PANEL (Sheet Store pattern) ══
                         Collapsed by default; opens when a row is selected. Shows
                         the selected row's spec / glass / quantities and its
                         delivery history. -->
                    <Grid x:Name="DetailPanel" Grid.Column="1" Margin="10,0,0,0"
                          Visibility="Collapsed">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="PanelSlide" X="0"/>
                        </Grid.RenderTransform>

                        <Border Width="360"
                                VerticalAlignment="Stretch"
                                Background="{DynamicResource SurfacePrimaryBrush}"
                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                BorderThickness="{DynamicResource Border.HairlineThickness}"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                Padding="20"
                                SnapsToDevicePixels="True">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <!-- Panel header + close -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                                                Grid.Column="0" Background="{DynamicResource AccentBrush}">
                                            <TextBlock Text="&#xE814;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextTitle}"
                                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0">
                                            <TextBlock Text="{DynamicResource DeliveryNote.ROWDetails}" FontSize="{StaticResource TextBody}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="{Binding SidebarSubtitle}" FontSize="{StaticResource TextBodyLarge}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource RowOutlinedButton}"
                                                Tag="&#xE711;" Content="" VerticalAlignment="Top"
                                                ToolTip="{DynamicResource DeliveryNote.CloseClickRowAgain}" Command="{Binding CloseDetailCommand}"/>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource BorderDefaultBrush}" Margin="0,16,0,16"/>

                                    <!-- Open the owning Job Order (same affordance as PI/JO/TI reports) -->
                                    <Button Content="{DynamicResource Inquiry.OpenJobOrder}"
                                            Command="{Binding OpenJobOrderCommand}"
                                            CommandParameter="{Binding SelectedRow}"
                                            Style="{StaticResource PrimaryPillButton}"
                                            Height="36" Margin="0,0,0,14"
                                            HorizontalAlignment="Stretch"
                                            ToolTip="{DynamicResource Reports.DeliveryReport.OpenJobOrderOwnsDeliveryRow}"/>

                                    <!-- Selected row identity -->
                                    <TextBlock Text="{DynamicResource Common.Specification}" FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="4,0,0,8"/>
                                    <Border CornerRadius="{DynamicResource CardCornerRadius}" Padding="12,10" Margin="0,0,0,12"
                                            Background="{DynamicResource TintBlueBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedRow.SpecificationDisplay}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                            <TextBlock FontSize="{StaticResource TextBody}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0">
                                                <Run Text="{DynamicResource JobOrder.GlassType}"/><Run Text="{Binding SelectedRow.GlassType, Mode=OneWay}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                            <TextBlock FontSize="{StaticResource TextBody}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0">
                                                <Run Text="{DynamicResource DeliveryNote.GlassRef}"/><Run Text="{Binding SelectedRow.GlassRef, Mode=OneWay}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                            <TextBlock FontSize="{StaticResource TextBody}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0">
                                                <Run Text="{DynamicResource DeliveryNote.Dimensions}"/><Run Text="{Binding SelectedRow.GlassDetails, Mode=OneWay}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Selected row quantities -->
                                    <TextBlock Text="{DynamicResource DeliveryNote.Quantities}" FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="4,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="12,10" Margin="0,0,4,10"
                                                Background="{DynamicResource TintBlueBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}">
                                            <StackPanel>
                                                <TextBlock Text="TOTAL" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="{Binding SelectedRow.TotalQty}" FontSize="{StaticResource TextTitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="12,10" Margin="4,0,4,10"
                                                Background="{DynamicResource TintGreenBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Common.Delivered}" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                                <TextBlock Text="{Binding SelectedRow.DeliveredQty}" FontSize="{StaticResource TextTitle}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="12,10" Margin="4,0,0,10"
                                                Background="{DynamicResource TintAmberBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Common.Balance}" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                                <TextBlock Text="{Binding SelectedRow.BalanceQty}" FontSize="{StaticResource TextTitle}" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Delivery history -->
                                    <TextBlock Text="{DynamicResource DeliveryNote.DeliveryHistory}" FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="4,0,0,8"/>
                                    <Border Background="{DynamicResource SurfacePrimaryBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}" CornerRadius="{DynamicResource Radius.Small}" Padding="10,8">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding SelectedRow.Deliveries}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="{DynamicResource Border.BottomHairlineThickness}" Padding="2,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock Text="{Binding DeliveryNoteId}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                                                    <TextBlock FontSize="{StaticResource TextBody}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,1,0,0">
                                                                        <Run Text="{Binding DeliveryDate, Mode=OneWay, StringFormat={}{0:dd MMM yyyy}}"/>
                                                                        <Run Text=" · "/>
                                                                        <Run Text="{Binding Status, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                    <TextBlock FontSize="{StaticResource TextBody}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,1,0,0">
                                                                        <Run Text="{Binding DriverName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding VehicleNumber, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <Border Grid.Column="1" CornerRadius="{DynamicResource Radius.Small}" Padding="8,3" Background="{DynamicResource TintGreenBrush}" VerticalAlignment="Center">
                                                                    <TextBlock FontSize="{StaticResource TextBody}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}">
                                                                        <Run Text="{Binding QtyDelivered, Mode=OneWay}"/><Run Text=" pcs"/>
                                                                    </TextBlock>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{DynamicResource Reports.DeliveryReport.NoDeliveriesRecordedRowYet}"
                                                       FontSize="{StaticResource TextBody}" Foreground="{DynamicResource TextTertiaryBrush}"
                                                       Visibility="{Binding SelectedRow.Deliveries.Count, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=0}"
                                                       Margin="2,6"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
<!-- ══════════════════════════════════════════════════════════
                     4. PAGINATION FOOTER
                ══════════════════════════════════════════════════════════════ -->
                <Border Grid.Row="4" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="{DynamicResource Border.TopHairlineThickness}" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding PageDisplay}" FontSize="{StaticResource TextBody}" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{DynamicResource Reports.DeliveryReport.Prev}" Command="{Binding PrevPageCommand}" Style="{StaticResource ReportPaginationButton}" ToolTip="{DynamicResource Reports.DeliveryReport.GoPreviousPage}"/>
                            <Button Content="{DynamicResource Reports.DeliveryReport.Next}" Command="{Binding NextPageCommand}" Style="{StaticResource ReportPaginationButton}" ToolTip="{DynamicResource Reports.DeliveryReport.GoNextPage}"/>
                            <Button Content="↻" Command="{Binding RefreshCommand}" Style="{StaticResource ReportPaginationButton}" ToolTip="{DynamicResource Reports.DeliveryReport.RefreshReportData}"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>
