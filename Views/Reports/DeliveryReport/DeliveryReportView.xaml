<UserControl x:Class="ProGlassAutomation.Views.Reports.DeliveryReport.DeliveryReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loading="clr-namespace:ProGlassAutomation.Controls.LoadingState"
             xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="16,14,16,12">
            <TextBlock Text="Delivery Report" Style="{StaticResource ModulePageTitleStyle}" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Delivery Notes · Dispatched items · Ordered vs Delivered vs Remaining · Invoicing fulfillment status." Style="{StaticResource ModulePageSubtitleStyle}" TextWrapping="Wrap" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- Main Shell Card -->
        <Border Grid.Row="1" Style="{StaticResource ModuleListShellStyle}" Margin="16,0,16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ══════════════════════════════════════════════════════════
                     1. KPI STRIP
                ══════════════════════════════════════════════════════════════ -->
                <Border Grid.Row="0" Style="{StaticResource ModuleListKpiStripStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Total DN -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Total Delivery Notes issued and overall fulfillment percentage">
                            <Border Width="38" Height="38" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource TintBlueBrush}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE814;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="DELIVERY NOTES" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding Summary.TotalDn}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="{Binding Summary.CompletionPct, Mode=OneWay, StringFormat={}{0:0.#}% delivered}" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <!-- Pending -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Delivery notes with items not yet dispatched">
                            <Border Width="38" Height="38" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource TintAmberBrush}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="PENDING" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding Summary.Pending}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="Not yet dispatched" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="3" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <!-- Partial -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Delivery notes partially fulfilled with balance remaining">
                            <Border Width="38" Height="38" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource TintIndigoBrush}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE9FA;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="PARTIAL" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding Summary.Partial}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="Partial deliveries" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="5" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <!-- Completed -->
                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Delivery notes where 100% of items have been delivered">
                            <Border Width="38" Height="38" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource TintGreenBrush}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="COMPLETED" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding Summary.Completed}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="Fully fulfilled" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════════════════
                     2. FILTER BAR
                ══════════════════════════════════════════════════════════════ -->
                <Border Grid.Row="1" Style="{StaticResource ModuleListFilterBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <!-- Search -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="SEARCH" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <TextBox Width="160" Style="{StaticResource ModuleListFilterInputStyle}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="DN # / JO #..." ToolTip="Search by Delivery Note #, Job Order #, or Customer"/>
                            </StackPanel>

                            <!-- Date From -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="FROM DATE" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <DatePicker Width="135" SelectedDate="{Binding DateFrom}" ToolTip="Filter by delivery date start"/>
                            </StackPanel>

                            <!-- Date To -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="TO DATE" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <DatePicker Width="135" SelectedDate="{Binding DateTo}" ToolTip="Filter by delivery date end"/>
                            </StackPanel>

                            <!-- Customer -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="CUSTOMER" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox Width="140" IsEditable="True" Text="{Binding SelectedCustomer, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding CustomerOptions}" ToolTip="Filter by customer"/>
                            </StackPanel>

                            <!-- Status -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="STATUS" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox Width="120" IsEditable="True" Text="{Binding SelectedStatus, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter by delivery status">
                                    <ComboBoxItem Content="Draft"/><ComboBoxItem Content="Dispatched"/><ComboBoxItem Content="Delivered"/><ComboBoxItem Content="Signed"/><ComboBoxItem Content="Received"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,6,6">
                                <Button Content="Apply" Command="{Binding ApplyFilterCommand}" Style="{StaticResource RowPrimaryButton}" Height="32" Padding="16,0" Margin="0,0,6,0" ToolTip="Apply selected filters"/>
                                <Button Content="Clear" Command="{Binding ClearFilterCommand}" Style="{StaticResource RowOutlinedButton}" Height="32" Padding="16,0" ToolTip="Reset filters"/>
                            </StackPanel>
                        </WrapPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="8,0,0,6">
                            <TextBlock Text="EXPORT" Style="{StaticResource ModuleFieldLabelStyle}" HorizontalAlignment="Right"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource RowOutlinedButton}" Height="32" Margin="0,0,6,0" ToolTip="Export to CSV"/>
                                <Button Content="Excel" Command="{Binding ExportExcelCommand}" Style="{StaticResource RowOutlinedButton}" Height="32" Margin="0,0,6,0" ToolTip="Export to Excel (.xlsx)"/>
                                <Button Content="PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource PrimaryPillButton}" Height="32" ToolTip="Export to PDF report"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════════════════
                     3. TABLE HEADER
                ══════════════════════════════════════════════════════════════ -->
                <Border Grid.Row="2" Style="{StaticResource ModuleListTableHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="DN #" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="1" Text="JO # / PI #" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="2" Text="CUSTOMER" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="3" Text="PROJECT" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="4" Text="STATUS" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="5" Text="ORDER / DELIV / BAL" Style="{StaticResource ModuleListHeaderTextStyle}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="6" Text="INVOICED" Style="{StaticResource ModuleListHeaderTextStyle}" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════════════════
                     4. DATA ROWS / STATES
                ══════════════════════════════════════════════════════════════ -->
                <loading:LoadingStateControl Grid.Row="3" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" Message="Loading delivery records…"/>
                <emptyState:EmptyStateControl Grid.Row="3" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" Title="No deliveries found" Message="No Delivery Notes match the current filters." Icon="&#xE814;"/>

                <!-- Error State -->
                <Border Grid.Row="3" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="{DynamicResource TintRedBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                        CornerRadius="10" Margin="16" Padding="20">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Unable to load records" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,4,0,12" MaxWidth="500" TextAlignment="Center"/>
                        <Button Content="Retry" Command="{Binding RefreshCommand}" Style="{StaticResource RowPrimaryButton}" Height="30" Padding="20,0" HorizontalAlignment="Center" ToolTip="Retry loading records"/>
                    </StackPanel>
                </Border>

                <ListBox Grid.Row="3" ItemsSource="{Binding Rows}"
                         Style="{StaticResource ModuleReportListBoxStyle}"
                         Visibility="{Binding IsContentVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ModuleListRowStyle}" Padding="16,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Col 0: DN # & Date -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DeliveryNoteId}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        <TextBlock Text="{Binding DeliveryDate, StringFormat={}{0:dd MMM yyyy}}" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,1,0,0"/>
                                    </StackPanel>

                                    <!-- Col 1: JO # & PI # -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding JobOrderId}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="{Binding ProformaId}" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,1,0,0"/>
                                    </StackPanel>

                                    <!-- Col 2: Customer -->
                                    <TextBlock Grid.Column="2" Text="{Binding CustomerName}" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                    <!-- Col 3: Project -->
                                    <TextBlock Grid.Column="3" Text="{Binding ProjectName}" FontSize="11" Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0"/>

                                    <!-- Col 4: Status -->
                                    <Border Grid.Column="4" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource TintBlueBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Delivered"><Setter Property="Background" Value="{DynamicResource TintGreenBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Received"><Setter Property="Background" Value="{DynamicResource TintGreenBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Signed"><Setter Property="Background" Value="{DynamicResource TintIndigoBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Draft"><Setter Property="Background" Value="{DynamicResource TintGrayBrush}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Delivered"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Received"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Signed"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Draft"><Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Col 5: Ordered / Delivered / Balance -->
                                    <TextBlock Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11">
                                        <Run Text="{Binding TotalOrderedQty, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding TotalDeliveredQty, Mode=OneWay}" Foreground="{DynamicResource SuccessBrush}"/><Run Text=" / "/><Run Text="{Binding TotalBalanceQty, Mode=OneWay}" Foreground="{DynamicResource WarningBrush}"/>
                                    </TextBlock>

                                    <!-- Col 6: Invoiced Pill -->
                                    <Border Grid.Column="6" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="6" Padding="8,3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource TintGrayBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasTaxInvoice}" Value="True"><Setter Property="Background" Value="{DynamicResource TintGreenBrush}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="10" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Pending"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasTaxInvoice}" Value="True">
                                                            <Setter Property="Text" Value="Invoiced"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- ══════════════════════════════════════════════════════════
                     5. PAGINATION FOOTER
                ══════════════════════════════════════════════════════════════ -->
                <Border Grid.Row="4" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding PageDisplay}" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="‹ Prev" Command="{Binding PrevPageCommand}" Style="{StaticResource RowOutlinedButton}" Height="28" Padding="12,0" Margin="0,0,8,0" ToolTip="Go to previous page"/>
                            <Button Content="Next ›" Command="{Binding NextPageCommand}" Style="{StaticResource RowOutlinedButton}" Height="28" Padding="12,0" ToolTip="Go to next page"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>