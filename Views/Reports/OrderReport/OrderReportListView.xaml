<!-- Order Report list — Archetype 1 (saved reports register).
     Bindings, commands, IsEmpty / IsListVisible / HasSearchText,
     design-time xmlns, ListView selection: unchanged.
     Literal English kept (no Statement localization keys). -->
<UserControl Style="{StaticResource ErpPageRootStyle}"
             x:Class="ProGlassAutomation.Views.Reports.OrderReport.OrderReportListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels.Reports.OrderReport"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OrderReportListViewModel, IsDesignTimeCreatable=False}"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,16,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Overall Order Reports" Style="{StaticResource ModulePageTitleStyle}"/>
                <TextBlock Text="Report Generator" Style="{StaticResource ModulePageSubtitleStyle}"/>
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource ModulePageSubtitleStyle}"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Command="{Binding NewReportCommand}"
                    Style="{StaticResource PrimaryPillButton}"
                    Tag="&#xE710;"
                    Content="New Report"
                    MinWidth="192"
                    VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource ModuleListShellStyle}" Margin="16,0,16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource ModuleListKpiStripStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintBlueBrush}">
                                <TextBlock Text="&#xE9F9;"
                                           FontFamily="{DynamicResource FontFamily.Icon}"
                                           FontSize="{DynamicResource FontSize.H3}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Reports" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding TotalReportsDisplay}"
                                           Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="Total saved" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintGreenBrush}">
                                <TextBlock Text="&#xE8A3;"
                                           FontFamily="{DynamicResource FontFamily.Icon}"
                                           FontSize="{DynamicResource FontSize.H3}"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Invoiced Value" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding TotalInvoicedValueDisplay}"
                                           Style="{StaticResource ModuleListKpiValueStyle}"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                                <TextBlock Text="Across all reports" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="3" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintRedBrush}">
                                <TextBlock Text="&#xE7BA;"
                                           FontFamily="{DynamicResource FontFamily.Icon}"
                                           FontSize="{DynamicResource FontSize.H3}"
                                           Foreground="{DynamicResource DangerBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Missing Documents" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding TotalMissingDocumentsDisplay}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ModuleListKpiValueStyle}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMissingDocuments}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Delivery notes without attachments"
                                           Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource ModuleListFilterBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="160"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Margin="0,0,8,0">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                     Style="{StaticResource ModuleListFilterInputStyle}"/>
                            <TextBlock Text="Search report number, customer, project or company…"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding HasSearchText,
                                          Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        </Grid>
                        <ScrollViewer Grid.Column="1"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollBarVisibility="Auto">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding ClearSearchCommand}"
                                        Visibility="{Binding HasSearchText,
                                            Converter={StaticResource BoolToVisibilityConverter}}"
                                        Style="{StaticResource RowDangerButton}"
                                        Tag="&#xE711;"
                                        ToolTip="Clear search"
                                        Width="32"
                                        Height="32"
                                        MinWidth="32"
                                        Padding="0"
                                        Margin="0,0,8,0"/>
                                <Button Command="{Binding RefreshCommand}"
                                        Style="{StaticResource PrimaryPillButton}"
                                        Tag="&#xE72C;"
                                        Content="Refresh"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Style="{StaticResource ModuleListTableHeaderStyle}"
                        Visibility="{Binding IsListVisible,
                            Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="1.5*" MinWidth="140"/>
                            <ColumnDefinition Width="0.9*" MinWidth="95"/>
                            <ColumnDefinition Width="0.9*" MinWidth="95"/>
                            <ColumnDefinition Width="0.8*" MinWidth="85"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1"
                                   Text="Report"
                                   Style="{StaticResource ModuleListHeaderTextStyle}"
                                   Margin="12,0"/>
                        <TextBlock Grid.Column="2"
                                   Text="Quantities"
                                   Style="{StaticResource ModuleListHeaderTextStyle}"
                                   Margin="8,0"/>
                        <TextBlock Grid.Column="3"
                                   Text="Invoiced Value"
                                   Style="{StaticResource ModuleListHeaderTextStyle}"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="4"
                                   Text="Missing Docs"
                                   Style="{StaticResource ModuleListHeaderTextStyle}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="5"
                                   Text="Actions"
                                   Style="{StaticResource ModuleListHeaderTextStyle}"
                                   HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="3">
                    <Border Panel.ZIndex="2"
                            Visibility="{Binding IsLoading,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,48,0,48">
                            <TextBlock Text="&#xE72C;"
                                       FontFamily="{DynamicResource FontFamily.Icon}"
                                       FontSize="{DynamicResource FontSize.Kpi}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Loading order reports…"
                                       FontSize="{DynamicResource FontSize.H3}"
                                       FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Panel.ZIndex="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsEmpty,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="420"
                                    Margin="0,48,0,48">
                            <TextBlock Text="No reports yet"
                                       FontSize="{DynamicResource FontSize.H2}"
                                       FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="Generate an Overall Report to track a proforma invoice through job order, delivery and invoicing."
                                       FontSize="{DynamicResource FontSize.Body}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,20"/>
                            <Button Content="+ New Report"
                                    Command="{Binding NewReportCommand}"
                                    Style="{StaticResource PrimaryPillButton}"
                                    Tag="&#xE710;"
                                    HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ListView Panel.ZIndex="0"
                              ItemsSource="{Binding Rows}"
                              SelectedItem="{Binding SelectedRow}"
                              Background="Transparent"
                              BorderThickness="{DynamicResource Border.NoneThickness}"
                              HorizontalContentAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              VirtualizingPanel.CacheLength="400,800"
                              VirtualizingPanel.CacheLengthUnit="Pixel"
                              ScrollViewer.CanContentScroll="False"
                              ScrollViewer.IsDeferredScrollingEnabled="False"
                              ScrollViewer.PanningMode="None"
                              behaviors:SmoothScrollBehavior.IsEnabled="True"
                              Visibility="{Binding IsListVisible,
                                  Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ModuleListRowStyle}"
                                        MinHeight="56"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="1.5*" MinWidth="140"/>
                                            <ColumnDefinition Width="0.9*" MinWidth="95"/>
                                            <ColumnDefinition Width="0.9*" MinWidth="95"/>
                                            <ColumnDefinition Width="0.8*" MinWidth="85"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasMissingDocuments}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,8,8,8" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding ReportNumber, Mode=OneWay}"
                                                           FontSize="{DynamicResource FontSize.Title}"
                                                           FontWeight="{DynamicResource Weight.Bold}"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="  /  "
                                                           FontSize="{DynamicResource FontSize.Title}"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                <TextBlock Text="{Binding Title, Mode=OneWay}"
                                                           FontSize="{DynamicResource FontSize.Title}"
                                                           FontWeight="{DynamicResource Weight.SemiBold}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{DynamicResource TintIndigoBrush}"
                                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                                        Padding="8,4"
                                                        Margin="0,0,8,0">
                                                    <TextBlock FontSize="{DynamicResource FontSize.BodySmall}"
                                                               FontWeight="{DynamicResource Weight.Bold}"
                                                               Foreground="{DynamicResource AccentBrush}">
                                                        <Run Text="{Binding PiCount, Mode=OneWay}"/>
                                                        <Run Text=" PI(s)"/>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding CreatedAtDisplay, Mode=OneWay}"
                                                           FontSize="{DynamicResource FontSize.Body}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding QuantitiesDisplay, Mode=OneWay}"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding TotalInvoicedValueDisplay, Mode=OneWay}"
                                                   FontSize="{DynamicResource FontSize.Title}"
                                                   FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>

                                        <Border Grid.Column="4"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Padding="8,4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasMissingDocuments}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="{DynamicResource FontSize.BodySmall}"
                                                       FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource OnAccentForegroundBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Complete"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasMissingDocuments}" Value="True">
                                                                <Setter Property="Text" Value="{Binding MissingDocuments}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <StackPanel Grid.Column="5"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Margin="4,0,8,0">
                                            <Button Style="{StaticResource RowPrimaryButton}"
                                                    Command="{Binding DataContext.OpenPdfCommand,
                                                        RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding HasPdf}"
                                                    Content="PDF"
                                                    ToolTip="PDF"
                                                    Margin="0,0,8,0"/>
                                            <Button Style="{StaticResource RowSuccessButton}"
                                                    Command="{Binding DataContext.ShareReportCommand,
                                                        RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding HasPdf}"
                                                    ToolTip="{DynamicResource Sharing.Share}"
                                                    Tag="&#xE72D;"
                                                    Margin="0,0,8,0"/>
                                            <Button Style="{StaticResource RowOutlinedButton}"
                                                    Command="{Binding DataContext.OpenReportCommand,
                                                        RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Open"
                                                    Tag="&#xE8E5;"
                                                    Margin="0,0,8,0"/>
                                            <Button Style="{StaticResource RowDangerButton}"
                                                    Command="{Binding DataContext.DeleteReportCommand,
                                                        RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    Tag="&#xE74D;"
                                                    Width="34"
                                                    Height="34"
                                                    MinWidth="34"
                                                    Padding="0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
