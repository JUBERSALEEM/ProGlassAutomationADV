<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Reports/OrderReport/Preview/PreviewStep.xaml
     PROJECT: ProGlassAutomation
     MODULE: Report Generator — Step 2: Preview (2026-09-06)

     Lists every Proforma Invoice matching the Step 1 filters. Each row
     is ticked by default; select ONE (single overall report) or MANY
     (consolidated multi-PI report). Bound to
     OrderReportGeneratorViewModel.PreviewVM + the generator's own
     SelectAll / DeselectAll / Generate commands.
═══════════════════════════════════════════════════════════════════ -->
<UserControl
    x:Class="ProGlassAutomation.Views.Reports.OrderReport.Preview.PreviewStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels.Reports.OrderReport"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:OrderReportGeneratorViewModel, IsDesignTimeCreatable=False}"
    FontFamily="{DynamicResource AppFontFamily}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header + selection summary -->
        <StackPanel Grid.Row="0" Margin="40,24,40,16">
            <TextBlock Text="Step 2 — Select Proforma Invoices"
                       FontSize="{DynamicResource FontSize.H2}" FontWeight="{DynamicResource Weight.Bold}"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding PreviewVM.SelectionSummaryDisplay}"
                       FontSize="{DynamicResource FontSize.H3}"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0"/>
            <TextBlock Text="{Binding PreviewVM.SelectedValueDisplay}"
                       FontSize="{DynamicResource FontSize.Body}"
                       Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Rows -->
        <Border Grid.Row="1" Margin="40,0,40,0"
                Background="{DynamicResource SurfacePrimaryBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="{DynamicResource CardBorderThickness}"
                CornerRadius="{DynamicResource CardCornerRadiusLarge}" Style="{StaticResource SurfacePrimaryStyle}">
            <Grid>
                <ListBox ItemsSource="{Binding PreviewVM.Rows}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.CacheLength="400,800"
                         VirtualizingPanel.CacheLengthUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16,10"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Center"
                                              Cursor="Hand"/>

                                    <StackPanel Grid.Column="1" Margin="14,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ProformaId}"
                                                       FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Border Background="{DynamicResource TintIndigoBrush}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}" Padding="8,1" Margin="10,0,0,0"
                                                    VerticalAlignment="Center" Style="{StaticResource SurfacePrimaryStyle}">
                                                <TextBlock Text="{Binding Status}"
                                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock FontSize="{DynamicResource FontSize.Body}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   Margin="0,3,0,0">
                                            <Run Text="{Binding CompanyName, Mode=OneWay}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding CustomerName, Mode=OneWay}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding ProjectName, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding GrandTotalDisplay}"
                                                   FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding CreatedAtDisplay}"
                                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty state -->
                <TextBlock Text="No proforma invoices match the filters yet. Go back and adjust them, then click Preview."
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="24">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PreviewVM.Rows.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Action bar -->
        <Border Grid.Row="2" Margin="40,16,40,20">
            <StackPanel Orientation="Horizontal">
                <Button Content="Select All"
                        Command="{Binding SelectAllCommand}"
                        Style="{StaticResource NavButtonSecondaryStyle}"/>
                <Button Content="Deselect All"
                        Command="{Binding DeselectAllCommand}"
                        Style="{StaticResource NavButtonSecondaryStyle}"
                        Margin="10,0,0,0"/>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
