<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Reports/OrderReport/Filter/FilterStep.xaml
     PROJECT: ProGlassAutomation
     MODULE: Report Generator — Step 1: Filter (2026-09-06)

     Filters the Proforma Invoice list that drives the report. Simple,
     self-contained form (no Statement localization keys): company /
     customer / project / salesman dropdowns, a date range and a status
     chip list, bound to OrderReportGeneratorViewModel.
═══════════════════════════════════════════════════════════════════ -->
<UserControl
    x:Class="ProGlassAutomation.Views.Reports.OrderReport.Filter.FilterStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels.Reports.OrderReport"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:OrderReportGeneratorViewModel, IsDesignTimeCreatable=False}"
    FontFamily="{DynamicResource AppFontFamily}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- Field label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <!-- Field input (TextBox-like) -->
        <Style x:Key="FieldInput" TargetType="Control">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Status chip -->
        <Style x:Key="StatusChip" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="40,28,40,28">

                <!-- Header -->
                <TextBlock Text="Step 1 — Filter Orders"
                           FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                <TextBlock Text="Choose which proforma invoices to include. The preview lists every matching PI so you can generate one overall report or a consolidated multi-PI report."
                           FontSize="{StaticResource TextSection}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>

                <!-- Live match count (auto-refreshes as filters change) -->
                <Border Margin="0,14,0,0"
                        Background="{DynamicResource ModuleBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="14,10"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="10" Height="10" CornerRadius="5"
                                Background="{DynamicResource SuccessBrush}"
                                VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding MatchCountDisplay}"
                                   FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Filters card -->
                <Border Margin="0,20,0,0"
                        Background="{DynamicResource ModuleBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                        Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Company" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource ModernEditableComboBoxStyle}"
                                      Height="40"
                                      ItemsSource="{Binding Companies}"
                                      Text="{Binding FilterCompany, UpdateSourceTrigger=PropertyChanged}"
                                      IsTextSearchEnabled="True"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Customer" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource ModernEditableComboBoxStyle}"
                                      Height="40"
                                      ItemsSource="{Binding Customers}"
                                      Text="{Binding FilterCustomer, UpdateSourceTrigger=PropertyChanged}"
                                      IsTextSearchEnabled="True"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Project" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource ModernEditableComboBoxStyle}"
                                      Height="40"
                                      ItemsSource="{Binding Projects}"
                                      Text="{Binding FilterProject, UpdateSourceTrigger=PropertyChanged}"
                                      IsTextSearchEnabled="True"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Salesman" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource ModernEditableComboBoxStyle}"
                                      Height="40"
                                      ItemsSource="{Binding Salesmen}"
                                      Text="{Binding FilterSalesman, UpdateSourceTrigger=PropertyChanged}"
                                      IsTextSearchEnabled="True"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <TextBlock Text="Date From" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding DateFrom}"
                                        Height="40" FontSize="{StaticResource TextBodyLarge}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2">
                            <TextBlock Text="Date To" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding DateTo}"
                                        Height="40" FontSize="{StaticResource TextBodyLarge}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Status card -->
                <Border Margin="0,20,0,0"
                        Background="{DynamicResource ModuleBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                        Padding="24">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Proforma Status" FontSize="{StaticResource TextSection}" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="(leave all unchecked to ignore status)"
                                       FontSize="{StaticResource TextCaption}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       VerticalAlignment="Bottom" Margin="10,0,0,2"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding StatusItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource StatusChip}"
                                              IsChecked="{Binding IsChecked}"
                                              Content="{Binding StatusLabel}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                    <Button Content="Clear Filters"
                            Command="{Binding ClearFiltersCommand}"
                            Style="{StaticResource NavButtonSecondaryStyle}"/>
                    <Button Content="Preview Matches"
                            Command="{Binding PreviewCommand}"
                            Style="{StaticResource NavButtonPrimaryStyle}"
                            Margin="12,0,0,0"/>
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Margin="0,14,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
