<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Reports/OrderReport/Filter/FilterStep.xaml
     PROJECT: ProGlassAutomation
     MODULE: Report Generator — Step 1: Filter Criteria (2026-09-06)

     Industrial scope-definition panel. Unlike the Statement Generator's
     card wizard, this is a linear SOURCE SEQUENCE rail:

        01 COMPANY  →  02 SALESMAN  →  03 CUSTOMER  →  04 PROJECT

     • Company is OUR company (resolved from the Company module) and is
       pre-selected by default — Step 1 is always scoped to us.
     • Each stage cascades: Salesman scopes Customer, Customer scopes
       Project — dropdowns only show RELATED records.
     • A DATE WINDOW and a STATUS GATE complete the scope; a live match
       counter reports how many PIs fall inside the current scope.
═══════════════════════════════════════════════════════════════════ -->
<UserControl
    x:Class="ProGlassAutomation.Views.Reports.OrderReport.Filter.FilterStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels.Reports.OrderReport"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:OrderReportGeneratorViewModel, IsDesignTimeCreatable=False}"
    FontFamily="{DynamicResource AppFontFamily}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- Small uppercase section label -->
        

        <!-- Field label (uppercase, muted, engineering feel) -->
        

        <!-- Helper caption under a field -->
        

        <!-- Numbered stage badge (01…04) -->
        

        <!-- Status gate chip: LED dot + label, filled when active -->
        <Style x:Key="IndustrialStatusChip" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Chip"
                                Background="{DynamicResource SurfacePrimaryBrush}"
                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                BorderThickness="{DynamicResource CardBorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="14,8" Style="{StaticResource SurfacePrimaryStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Led" Width="8" Height="8" CornerRadius="{DynamicResource Radius.XSmall}"
                                        Background="{DynamicResource TintGrayBrush}"
                                        VerticalAlignment="Center" Margin="0,0,9,0" Style="{StaticResource SurfacePrimaryStyle}"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontSize="{DynamicResource FontSize.Body}"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource OutlineStrongBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Status}" Value="Draft">
                                <Setter TargetName="Led" Property="Background" Value="{DynamicResource TintGrayBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Sent">
                                <Setter TargetName="Led" Property="Background" Value="{DynamicResource InfoBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Approved">
                                <Setter TargetName="Led" Property="Background" Value="{DynamicResource SuccessBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                <Setter TargetName="Led" Property="Background" Value="{DynamicResource DangerBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Expired">
                                <Setter TargetName="Led" Property="Background" Value="{DynamicResource WarningBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                <Setter TargetName="Led" Property="Background" Value="{DynamicResource DangerBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="36,26,36,28">

                <!-- ═══════════════════════════════════════════════════════
                     HEADER — title + live match counter
                ═══════════════════════════════════════════════════════ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="REPORT SCOPE · STEP 01"
                                   Style="{StaticResource SurfacePrimaryStyle}"/>
                        <TextBlock Text="Filter Criteria"
                                   FontSize="{DynamicResource FontSize.H2}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="Define which proforma invoices feed this report. Each stage narrows the scope to related records only."
                                   FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" MaxWidth="640"/>
                    </StackPanel>

                    <!-- Live match counter -->
                    <Border Grid.Column="1"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SurfacePrimaryBrush}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="{DynamicResource CardBorderThickness}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="16,12" Margin="24,0,0,0" Style="{StaticResource SurfacePrimaryStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="10" Height="10" CornerRadius="{DynamicResource Radius.Small}"
                                    Background="{DynamicResource SuccessBrush}"
                                    VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource SurfacePrimaryStyle}"/>
                            <TextBlock Text="{Binding MatchCountDisplay}"
                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════
                     SOURCE SEQUENCE — Company → Salesman → Customer → Project
                ═══════════════════════════════════════════════════════ -->
                <Border Margin="0,22,0,0"
                        Background="{DynamicResource SurfacePrimaryBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                        Padding="22,20" Style="{StaticResource SurfacePrimaryStyle}">

                    <StackPanel>
                        <!-- Section header -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="4" Height="14" CornerRadius="{DynamicResource Radius.XSmall}"
                                        Background="{DynamicResource AccentBrush}"
                                        VerticalAlignment="Center" Margin="0,0,9,0" Style="{StaticResource SurfacePrimaryStyle}"/>
                                <TextBlock Text="SOURCE SEQUENCE" Style="{StaticResource SurfacePrimaryStyle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="1" Height="1" Background="{DynamicResource BorderDefaultBrush}"
                                    VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </Grid>

                        <!-- 4-stage rail -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 01 · COMPANY -->
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource SurfacePrimaryStyle}">
                                        <TextBlock Text="01" FontWeight="{DynamicResource Weight.Bold}"
                                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="COMPANY" Style="{StaticResource Typography.Label}" Margin="0"/>
                                        <TextBlock Text="OUR COMPANY" FontSize="{DynamicResource FontSize.Caption}"
                                                   FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource SuccessBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <ComboBox Style="{StaticResource ModernEditableComboBoxStyle}"
                                          Height="40"
                                          ItemsSource="{Binding Companies}"
                                          Text="{Binding FilterCompany, UpdateSourceTrigger=PropertyChanged}"
                                          IsTextSearchEnabled="True"/>
                                <TextBlock Text="Issuing entity — pre-selected from the Company module."
                                           Style="{StaticResource SurfacePrimaryStyle}"/>
                            </StackPanel>

                            <!-- connector -->
                            <TextBlock Grid.Column="1" Text="→" FontSize="{DynamicResource FontSize.H3}"
                                       FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Top"
                                       Margin="12,40,12,0"/>

                            <!-- 02 · SALESMAN -->
                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource SurfacePrimaryStyle}">
                                        <TextBlock Text="02" FontWeight="{DynamicResource Weight.Bold}"
                                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="SALESMAN" Style="{StaticResource Typography.Label}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <ComboBox Style="{StaticResource ModernEditableComboBoxStyle}"
                                          Height="40"
                                          ItemsSource="{Binding Salesmen}"
                                          Text="{Binding FilterSalesman, UpdateSourceTrigger=PropertyChanged}"
                                          IsTextSearchEnabled="True"/>
                                <TextBlock Text="Scopes the customer list to this sales representative."
                                           Style="{StaticResource SurfacePrimaryStyle}"/>
                            </StackPanel>

                            <!-- connector -->
                            <TextBlock Grid.Column="3" Text="→" FontSize="{DynamicResource FontSize.H3}"
                                       FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Top"
                                       Margin="12,40,12,0"/>

                            <!-- 03 · CUSTOMER -->
                            <StackPanel Grid.Column="4">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource SurfacePrimaryStyle}">
                                        <TextBlock Text="03" FontWeight="{DynamicResource Weight.Bold}"
                                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="CUSTOMER" Style="{StaticResource Typography.Label}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <ComboBox Style="{StaticResource ModernEditableComboBoxStyle}"
                                          Height="40"
                                          ItemsSource="{Binding Customers}"
                                          Text="{Binding FilterCustomer, UpdateSourceTrigger=PropertyChanged}"
                                          IsTextSearchEnabled="True"/>
                                <TextBlock Text="Scopes the project list to this customer."
                                           Style="{StaticResource SurfacePrimaryStyle}"/>
                            </StackPanel>

                            <!-- connector -->
                            <TextBlock Grid.Column="5" Text="→" FontSize="{DynamicResource FontSize.H3}"
                                       FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Top"
                                       Margin="12,40,12,0"/>

                            <!-- 04 · PROJECT -->
                            <StackPanel Grid.Column="6">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource SurfacePrimaryStyle}">
                                        <TextBlock Text="04" FontWeight="{DynamicResource Weight.Bold}"
                                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="PROJECT" Style="{StaticResource Typography.Label}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <ComboBox Style="{StaticResource ModernEditableComboBoxStyle}"
                                          Height="40"
                                          ItemsSource="{Binding Projects}"
                                          Text="{Binding FilterProject, UpdateSourceTrigger=PropertyChanged}"
                                          IsTextSearchEnabled="True"/>
                                <TextBlock Text="Specific project — leave empty to include all."
                                           Style="{StaticResource SurfacePrimaryStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════
                     DATE WINDOW
                ═══════════════════════════════════════════════════════ -->
                <Border Margin="0,16,0,0"
                        Background="{DynamicResource SurfacePrimaryBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                        Padding="22,20" Style="{StaticResource SurfacePrimaryStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="4" Height="14" CornerRadius="{DynamicResource Radius.XSmall}"
                                        Background="{DynamicResource AccentBrush}"
                                        VerticalAlignment="Center" Margin="0,0,9,0" Style="{StaticResource SurfacePrimaryStyle}"/>
                                <TextBlock Text="DATE WINDOW" Style="{StaticResource SurfacePrimaryStyle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="1" Height="1" Background="{DynamicResource BorderDefaultBrush}"
                                    VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DATE FROM" Style="{StaticResource Typography.Label}"/>
                                <DatePicker SelectedDate="{Binding DateFrom}"
                                            Height="40" FontSize="{DynamicResource FontSize.Title}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DATE TO" Style="{StaticResource Typography.Label}"/>
                                <DatePicker SelectedDate="{Binding DateTo}"
                                            Height="40" FontSize="{DynamicResource FontSize.Title}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Filters on the proforma issue date. Leave blank for an open-ended window."
                                   Style="{StaticResource SurfacePrimaryStyle}"/>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════
                     STATUS GATE
                ═══════════════════════════════════════════════════════ -->
                <Border Margin="0,16,0,0"
                        Background="{DynamicResource SurfacePrimaryBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                        Padding="22,20" Style="{StaticResource SurfacePrimaryStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="4" Height="14" CornerRadius="{DynamicResource Radius.XSmall}"
                                        Background="{DynamicResource AccentBrush}"
                                        VerticalAlignment="Center" Margin="0,0,9,0" Style="{StaticResource SurfacePrimaryStyle}"/>
                                <TextBlock Text="STATUS GATE" Style="{StaticResource SurfacePrimaryStyle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="1" Height="1" Background="{DynamicResource BorderDefaultBrush}"
                                    VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding StatusItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource IndustrialStatusChip}"
                                              IsChecked="{Binding IsChecked}"
                                              Content="{Binding StatusLabel}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Checked statuses are included. Leave all unchecked to ignore status."
                                   Style="{StaticResource SurfacePrimaryStyle}" Margin="2,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════
                     ACTIONS
                ═══════════════════════════════════════════════════════ -->
                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Clear Filters"
                            Command="{Binding ClearFiltersCommand}"
                            Style="{StaticResource NavButtonSecondaryStyle}"
                            HorizontalAlignment="Left"/>
                    <Button Grid.Column="1" Content="Preview Matches"
                            Command="{Binding PreviewCommand}"
                            Style="{StaticResource Button.Primary}"/>
                </Grid>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Margin="0,14,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
