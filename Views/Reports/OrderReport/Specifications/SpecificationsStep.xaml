<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Reports/OrderReport/Specifications/SpecificationsStep.xaml
     PROJECT: ProGlassAutomation
     MODULE: Report Generator — Step 5: Specifications (2026-09-06)

     The detailed specification breakdown of the generated report, laid
     out after the Proforma Invoice Step-5 data-grid pattern:

        PI 1 · PI-2025-001
          └─ Spec 1 — 6mm Clear Float
               [ # | Glass Ref | Specification | Dimensions | Qty | SQM | Rate | Amount ]
               [ rows…                                                                    ]
               [ TOTAL                                   | Qty  | SQM  |      | Amount   ]  ← sums sit exactly under their columns

     Header / data rows / footer share ONE set of column definitions, so
     the total row lands at the exact same position in height as the
     columns. Export CSV / Excel / PDF actions sit in the toolbar.
═══════════════════════════════════════════════════════════════════ -->
<UserControl
    x:Class="ProGlassAutomation.Views.Reports.OrderReport.Specifications.SpecificationsStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels.Reports.OrderReport"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:OrderReportGeneratorViewModel, IsDesignTimeCreatable=False}"
    FontFamily="{DynamicResource AppFontFamily}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- Section eyebrow (small uppercase accent label) -->
        

        <!-- Table header cell -->
        

        <!-- Table body cell -->
        

        <!-- Numbered badge (Spec 1 …) -->
        

        <!-- Export action button -->
        <Style x:Key="ExportButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}" Style="{StaticResource SurfacePrimaryStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border x:Name="Dot" Width="8" Height="8" CornerRadius="{DynamicResource Radius.XSmall}"
                                        Background="{DynamicResource AccentBrush}"
                                        VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource SurfacePrimaryStyle}"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="36,26,36,32">

                <!-- ═══════════════════════════════════════════════════════
                     HEADER + EXPORT TOOLBAR
                ═══════════════════════════════════════════════════════ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="REPORT BREAKDOWN · STEP 05" Style="{StaticResource SurfacePrimaryStyle}"/>
                        <TextBlock Text="Specifications"
                                   FontSize="{DynamicResource FontSize.H2}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="Every proforma invoice broken into its specification groups — glass reference, dimensions, quantity, area, rate and amount — with column-aligned totals."
                                   FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" MaxWidth="640"/>
                    </StackPanel>

                    <!-- Export toolbar -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                        <Button Style="{StaticResource ExportButton}" Content="Export CSV"
                                Command="{Binding ExportCsvCommand}"/>
                        <Button Style="{StaticResource ExportButton}" Content="Export Excel"
                                Command="{Binding ExportExcelCommand}"/>
                        <Button Style="{StaticResource ExportButton}" Content="Export PDF"
                                Command="{Binding ExportPdfCommand}" Margin="0"/>
                    </StackPanel>
                </Grid>

                <!-- Empty state -->
                <Border Margin="0,20,0,0"
                        Background="{DynamicResource SurfacePrimaryBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="24,20" Style="{StaticResource SurfacePrimaryStyle}">
                    <TextBlock Text="Generate the report first — the specification breakdown appears here."
                               FontSize="{DynamicResource FontSize.Body}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasReport}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- ═══════════════════════════════════════════════════════
                     PI GROUPS
                ═══════════════════════════════════════════════════════ -->
                <ItemsControl ItemsSource="{Binding SpecificationGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,20,0,0"
                                    Background="{DynamicResource SurfacePrimaryBrush}"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    BorderThickness="{DynamicResource CardBorderThickness}"
                                    CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                                    Padding="22,20" Style="{StaticResource SurfacePrimaryStyle}">

                                <StackPanel>

                                    <!-- ── PI header ── -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding TitleDisplay}"
                                                           FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                                <Border Background="{DynamicResource TintIndigoBrush}"
                                                        CornerRadius="{DynamicResource Radius.Small}" Padding="8,1" Margin="10,0,0,0"
                                                        VerticalAlignment="Center" Style="{StaticResource SurfacePrimaryStyle}">
                                                    <TextBlock Text="{Binding PiStatus}"
                                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                                               Foreground="{DynamicResource AccentBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="{DynamicResource FontSize.Body}"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       Margin="0,4,0,0">
                                                <Run Text="{Binding CustomerName, Mode=OneWay}"/>
                                                <Run Text="  ·  "/>
                                                <Run Text="{Binding ProjectName, Mode=OneWay}"/>
                                                <Run Text="  ·  "/>
                                                <Run Text="{Binding IssueDateDisplay, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- PI grand totals -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource Surface.Secondary.BackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                    BorderThickness="{DynamicResource CardBorderThickness}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Padding="12,6" Margin="0,0,8,0" Style="{StaticResource SurfacePrimaryStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="QTY" Style="{StaticResource SurfacePrimaryStyle}" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding TotalQtyDisplay}" Style="{StaticResource SurfacePrimaryStyle}" FontWeight="{DynamicResource Weight.Bold}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource Surface.Secondary.BackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                    BorderThickness="{DynamicResource CardBorderThickness}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Padding="12,6" Margin="0,0,8,0" Style="{StaticResource SurfacePrimaryStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="SQM" Style="{StaticResource SurfacePrimaryStyle}" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding TotalSqmDisplay}" Style="{StaticResource SurfacePrimaryStyle}" FontWeight="{DynamicResource Weight.Bold}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource TintIndigoBrush}"
                                                    BorderBrush="{DynamicResource AccentBrush}"
                                                    BorderThickness="{DynamicResource CardBorderThickness}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Padding="12,6" Style="{StaticResource SurfacePrimaryStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="VALUE" Style="{StaticResource SurfacePrimaryStyle}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding TotalValueDisplay}" Style="{StaticResource SurfacePrimaryStyle}" FontWeight="{DynamicResource Weight.Bold}"
                                                               Foreground="{DynamicResource AccentBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource BorderDefaultBrush}" Margin="0,16,0,2"/>

                                    <!-- ── Spec groups ── -->
                                    <ItemsControl ItemsSource="{Binding Groups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,16,0,0">

                                                    <!-- Spec header -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                        <Border Style="{StaticResource SurfacePrimaryStyle}">
                                                            <TextBlock Text="{Binding SpecDisplayName}"
                                                                       FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding GlassType}"
                                                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                    </StackPanel>

                                                    <!-- ── Column header ── -->
                                                    <Border Background="{DynamicResource Surface.Secondary.BackgroundBrush}"
                                                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                            BorderThickness="{DynamicResource CardBorderThickness}"
                                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                                            Padding="12,8" Style="{StaticResource SurfacePrimaryStyle}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36"/>
                                                                <ColumnDefinition Width="1.0*"/>
                                                                <ColumnDefinition Width="1.8*"/>
                                                                <ColumnDefinition Width="1.0*"/>
                                                                <ColumnDefinition Width="0.55*"/>
                                                                <ColumnDefinition Width="0.7*"/>
                                                                <ColumnDefinition Width="0.7*"/>
                                                                <ColumnDefinition Width="0.95*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="#" Style="{StaticResource SurfacePrimaryStyle}" HorizontalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="GLASS REF" Style="{StaticResource SurfacePrimaryStyle}"/>
                                                            <TextBlock Grid.Column="2" Text="SPECIFICATION" Style="{StaticResource SurfacePrimaryStyle}"/>
                                                            <TextBlock Grid.Column="3" Text="DIMENSIONS" Style="{StaticResource SurfacePrimaryStyle}"/>
                                                            <TextBlock Grid.Column="4" Text="QTY" Style="{StaticResource SurfacePrimaryStyle}" HorizontalAlignment="Right"/>
                                                            <TextBlock Grid.Column="5" Text="SQM" Style="{StaticResource SurfacePrimaryStyle}" HorizontalAlignment="Right"/>
                                                            <TextBlock Grid.Column="6" Text="RATE" Style="{StaticResource SurfacePrimaryStyle}" HorizontalAlignment="Right"/>
                                                            <TextBlock Grid.Column="7" Text="AMOUNT (AED)" Style="{StaticResource SurfacePrimaryStyle}" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- ── Data rows ── -->
                                                    <ItemsControl ItemsSource="{Binding Rows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Padding="12,8" BorderThickness="{DynamicResource Border.BottomHairlineThickness}"
                                                                        BorderBrush="{DynamicResource BorderDefaultBrush}">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="36"/>
                                                                            <ColumnDefinition Width="1.0*"/>
                                                                            <ColumnDefinition Width="1.8*"/>
                                                                            <ColumnDefinition Width="1.0*"/>
                                                                            <ColumnDefinition Width="0.55*"/>
                                                                            <ColumnDefinition Width="0.7*"/>
                                                                            <ColumnDefinition Width="0.7*"/>
                                                                            <ColumnDefinition Width="0.95*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding SerialNumber}" Style="{StaticResource SurfacePrimaryStyle}"
                                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding GlassRef}" Style="{StaticResource SurfacePrimaryStyle}" FontWeight="{DynamicResource Weight.SemiBold}"/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding SpecName}" Style="{StaticResource SurfacePrimaryStyle}"/>
                                                                        <TextBlock Grid.Column="3" Text="{Binding DimensionsDisplay}" Style="{StaticResource SurfacePrimaryStyle}"
                                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                                        <TextBlock Grid.Column="4" Text="{Binding Qty}" Style="{StaticResource SurfacePrimaryStyle}" HorizontalAlignment="Right"/>
                                                                        <TextBlock Grid.Column="5" Text="{Binding TotalSqm, StringFormat={}{0:N3}}" Style="{StaticResource SurfacePrimaryStyle}" HorizontalAlignment="Right"/>
                                                                        <TextBlock Grid.Column="6" Text="{Binding Rate, StringFormat={}{0:N2}}" Style="{StaticResource SurfacePrimaryStyle}" HorizontalAlignment="Right"/>
                                                                        <TextBlock Grid.Column="7" Text="{Binding Amount, StringFormat={}{0:N2}}" Style="{StaticResource SurfacePrimaryStyle}" HorizontalAlignment="Right" FontWeight="{DynamicResource Weight.SemiBold}"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- ── Footer total — SAME columns, sums land exactly under Qty / SQM / Amount ── -->
                                                    <Border Padding="12,10"
                                                            Background="{DynamicResource TintIndigoBrush}"
                                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                                            Margin="0,1,0,0" Style="{StaticResource SurfacePrimaryStyle}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36"/>
                                                                <ColumnDefinition Width="1.0*"/>
                                                                <ColumnDefinition Width="1.8*"/>
                                                                <ColumnDefinition Width="1.0*"/>
                                                                <ColumnDefinition Width="0.55*"/>
                                                                <ColumnDefinition Width="0.7*"/>
                                                                <ColumnDefinition Width="0.7*"/>
                                                                <ColumnDefinition Width="0.95*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Grid.ColumnSpan="4" Text="TOTAL"
                                                                       FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding TotalQtyDisplay}"
                                                                       Style="{StaticResource SurfacePrimaryStyle}" FontWeight="{DynamicResource Weight.Bold}" HorizontalAlignment="Right"/>
                                                            <TextBlock Grid.Column="5" Text="{Binding TotalSqmDisplay}"
                                                                       Style="{StaticResource SurfacePrimaryStyle}" FontWeight="{DynamicResource Weight.Bold}" HorizontalAlignment="Right"/>
                                                            <TextBlock Grid.Column="6" Text="—" Style="{StaticResource SurfacePrimaryStyle}"
                                                                       Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Right"/>
                                                            <TextBlock Grid.Column="7" Text="{Binding TotalValueDisplay}"
                                                                       Style="{StaticResource SurfacePrimaryStyle}" FontWeight="{DynamicResource Weight.Bold}"
                                                                       Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Margin="0,14,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
