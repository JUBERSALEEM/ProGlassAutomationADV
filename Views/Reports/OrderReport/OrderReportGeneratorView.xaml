<!-- Report Generator shell. Indigo bento generator: hero, staged progress,
     step chips, then the existing step surfaces. All commands retained. -->
<UserControl x:Class="ProGlassAutomation.Views.Reports.OrderReport.OrderReportGeneratorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="clr-namespace:ProGlassAutomation.Views.Dashboard"
             xmlns:filter="clr-namespace:ProGlassAutomation.Views.Reports.OrderReport.Filter"
             xmlns:preview="clr-namespace:ProGlassAutomation.Views.Reports.OrderReport.Preview"
             xmlns:pipeline="clr-namespace:ProGlassAutomation.Views.Reports.OrderReport.Pipeline"
             xmlns:review="clr-namespace:ProGlassAutomation.Views.Reports.OrderReport.Review"
             xmlns:specs="clr-namespace:ProGlassAutomation.Views.Reports.OrderReport.Specifications"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="{DynamicResource Ov.Canvas}"
             Foreground="{DynamicResource Ov.Ink}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Shared/GeneratorStudio.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Sl.ToolbarHeight}}">
            <StackPanel>
                <layout:IndigoDashboardPanel MaxColumns="2" MinimumColumnWidth="320" Gap="14">
                    <Border Style="{StaticResource Sl.Hero}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Report Generator" Style="{StaticResource Sl.Label}" Foreground="{DynamicResource Ov.OnAccent}"/>
                            <TextBlock Text="{Binding CurrentStepTitle}" Style="{StaticResource Sl.Value}" FontSize="26" Foreground="{DynamicResource Ov.OnAccent}"/>
                            <TextBlock Text="Proforma, job order, delivery and tax invoice in one run."
                                       Style="{StaticResource Sl.Subtitle}"
                                       Foreground="{DynamicResource Ov.OnAccentMuted}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Sl.Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Generator" Style="{StaticResource Sl.Label}"/>
                                    <TextBlock Text="{Binding GenerationStage}" Style="{StaticResource Sl.Value}" FontSize="20"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding GenerationProgressDisplay}"
                                           Style="{StaticResource Sl.Value}"
                                           Foreground="{DynamicResource Ov.Accent}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <ProgressBar Margin="0,10,0,0">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource Gen.Track}">
                                        <Setter Property="IsIndeterminate" Value="False"/>
                                        <Setter Property="Value" Value="{Binding GenerationProgress}"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsLoading}" Value="True"/>
                                                    <Condition Binding="{Binding IsGenerating}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="IsIndeterminate" Value="True"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Sl.Subtitle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </layout:IndigoDashboardPanel>

                <Border Style="{StaticResource Sl.FilterBar}">
                    <WrapPanel>
                        <Button Content="Filter" Tag="&#xE71C;" Command="{Binding GoToStepCommand}" CommandParameter="1">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Gen.Step}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStep1Complete}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Ov.Success}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsStep1Active}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Ov.Accent}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Ov.OnAccent}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Ov.Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Preview" Tag="&#xE8A5;" Command="{Binding GoToStepCommand}" CommandParameter="2">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Gen.Step}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStep2Complete}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Ov.Success}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsStep2Active}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Ov.Accent}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Ov.OnAccent}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Ov.Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Execute" Tag="&#xE768;" Command="{Binding GoToStepCommand}" CommandParameter="3">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Gen.Step}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStep3Complete}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Ov.Success}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsStep3Active}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Ov.Accent}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Ov.OnAccent}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Ov.Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Review" Tag="&#xE8A1;" Command="{Binding GoToStepCommand}" CommandParameter="4">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Gen.Step}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStep4Complete}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Ov.Success}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsStep4Active}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Ov.Accent}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Ov.OnAccent}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Ov.Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Specifications" Tag="&#xE9F9;" Command="{Binding GoToStepCommand}" CommandParameter="5">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Gen.Step}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStep5Complete}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Ov.Success}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsStep5Active}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Ov.Accent}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Ov.OnAccent}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Ov.Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Style="{StaticResource Sl.Card}" Padding="0" Margin="0,0,0,10">
            <Grid>
                <filter:FilterStep>
                    <filter:FilterStep.Style>
                        <Style TargetType="filter:FilterStep">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </filter:FilterStep.Style>
                </filter:FilterStep>
                <preview:PreviewStep>
                    <preview:PreviewStep.Style>
                        <Style TargetType="preview:PreviewStep">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </preview:PreviewStep.Style>
                </preview:PreviewStep>
                <pipeline:ExecuteStep>
                    <pipeline:ExecuteStep.Style>
                        <Style TargetType="pipeline:ExecuteStep">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="3"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </pipeline:ExecuteStep.Style>
                </pipeline:ExecuteStep>
                <review:ReviewStep>
                    <review:ReviewStep.Style>
                        <Style TargetType="review:ReviewStep">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="4"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </review:ReviewStep.Style>
                </review:ReviewStep>
                <specs:SpecificationsStep>
                    <specs:SpecificationsStep.Style>
                        <Style TargetType="specs:SpecificationsStep">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="5"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </specs:SpecificationsStep.Style>
                </specs:SpecificationsStep>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Sl.Card}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{Binding CancelCommand}" Style="{StaticResource Sl.DangerButton}" Tag="&#xE711;" Content="Cancel"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Style="{StaticResource Sl.Subtitle}" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding PreviousStepCommand}" Style="{StaticResource Sl.Button}" Tag="&#xE72B;" Content="Previous" Margin="0,0,8,0"
                            Visibility="{Binding CanGoPrevious, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Command="{Binding NextStepCommand}" Style="{StaticResource Sl.PrimaryButton}" Tag="&#xE72A;" Content="Next Step"
                            Visibility="{Binding ShowNextButton, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Command="{Binding NextStepCommand}" Style="{StaticResource Sl.PrimaryButton}" Tag="&#xE768;" Content="Generate Report"
                            Visibility="{Binding ShowGenerateButton, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Command="{Binding FinishCommand}" Style="{StaticResource Sl.SuccessButton}" Tag="&#xE73E;" Content="Finish"
                            Visibility="{Binding ShowFinishButton, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
