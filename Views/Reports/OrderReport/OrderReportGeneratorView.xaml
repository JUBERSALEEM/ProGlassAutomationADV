<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Reports/OrderReport/OrderReportGeneratorView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Report Generator — 4-step wizard shell (2026-09-06)

     Clones the Statement Generator wizard shell: a clickable 4-step
     stepper (Filter → Preview → Execute → Review), a step-content grid
     and a footer with Cancel / Previous / Next / Generate / Finish.
     Uses only app-wide resources (WizardStyles.xaml is merged globally
     in App.xaml) and literal text — no Statement localization keys.
═══════════════════════════════════════════════════════════════════ -->
<UserControl Style="{StaticResource ErpPageRootStyle}"
    x:Class="ProGlassAutomation.Views.Reports.OrderReport.OrderReportGeneratorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:filter="clr-namespace:ProGlassAutomation.Views.Reports.OrderReport.Filter"
    xmlns:preview="clr-namespace:ProGlassAutomation.Views.Reports.OrderReport.Preview"
    xmlns:pipeline="clr-namespace:ProGlassAutomation.Views.Reports.OrderReport.Pipeline"
    xmlns:review="clr-namespace:ProGlassAutomation.Views.Reports.OrderReport.Review"
    xmlns:specs="clr-namespace:ProGlassAutomation.Views.Reports.OrderReport.Specifications"
    xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels.Reports.OrderReport"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:OrderReportGeneratorViewModel, IsDesignTimeCreatable=False}"
    FontFamily="{DynamicResource AppFontFamily}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- Clickable step badge (theme-agnostic hover/pressed). -->
        <Style x:Key="StepBadgeButtonStyle" TargetType="Button">
            <Setter Property="Background"          Value="Transparent"/>
            <Setter Property="BorderThickness"     Value="0"/>
            <Setter Property="Padding"             Value="10,4"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="FocusVisualStyle"    Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="hoverBg"
                                Background="Transparent"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hoverBg" Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="hoverBg" Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                    <Setter Property="Cursor"  Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="62"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 0 — STEPPER BAR
        ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource ReportTableHeaderStyle}"
                Background="{DynamicResource SurfacePrimaryBrush}"
                BorderThickness="{DynamicResource Border.BottomHairlineThickness}"
                BorderBrush="{DynamicResource BorderDefaultBrush}">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Module title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Width="6" Height="26" CornerRadius="{DynamicResource Radius.XSmall}"
                            Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource ReportHeaderTextStyle}" Text="Report Generator" FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Style="{StaticResource ReportHeaderTextStyle}" Text="Proforma → Job Order → Delivery → Invoice"
                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Centered stepper -->
                <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="660" MaxWidth="920">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- STEP 1 — FILTER -->
                    <Button Grid.Column="0" Style="{StaticResource StepBadgeButtonStyle}"
                            Command="{Binding GoToStepCommand}" CommandParameter="1"
                            IsEnabled="{Binding CanNavigateToStep1}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Badge.Primary}">
                                        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep1Complete}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsStep1Active}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="1"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStep1Complete}" Value="True">
                                                    <Setter Property="Text" Value="✓"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsStep1Active}" Value="True">
                                                    <Setter Property="Text" Value="1"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Filters">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Typography.Label}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep1Complete}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsStep1Active}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="FontWeight" Value="{DynamicResource Weight.Bold}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <Border Grid.Column="1">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep1Complete}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- STEP 2 — PREVIEW -->
                    <Button Grid.Column="2" Style="{StaticResource StepBadgeButtonStyle}"
                            Command="{Binding GoToStepCommand}" CommandParameter="2"
                            IsEnabled="{Binding CanNavigateToStep2}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Badge.Primary}">
                                        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep2Complete}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsStep2Active}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="2"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStep2Complete}" Value="True">
                                                    <Setter Property="Text" Value="✓"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsStep2Active}" Value="True">
                                                    <Setter Property="Text" Value="2"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Preview">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Typography.Label}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep2Complete}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsStep2Active}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="FontWeight" Value="{DynamicResource Weight.Bold}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <Border Grid.Column="3">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep2Complete}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- STEP 3 — EXECUTE -->
                    <Button Grid.Column="4" Style="{StaticResource StepBadgeButtonStyle}"
                            Command="{Binding GoToStepCommand}" CommandParameter="3"
                            IsEnabled="{Binding CanNavigateToStep3}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Badge.Primary}">
                                        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep3Complete}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsStep3Active}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="3"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStep3Complete}" Value="True">
                                                    <Setter Property="Text" Value="✓"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsStep3Active}" Value="True">
                                                    <Setter Property="Text" Value="3"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Execute">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Typography.Label}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep3Complete}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsStep3Active}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="FontWeight" Value="{DynamicResource Weight.Bold}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <Border Grid.Column="5">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep3Complete}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- STEP 4 — REVIEW -->
                    <Button Grid.Column="6" Style="{StaticResource StepBadgeButtonStyle}"
                            Command="{Binding GoToStepCommand}" CommandParameter="4"
                            IsEnabled="{Binding CanNavigateToStep4}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Badge.Primary}">
                                        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep4Complete}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsStep4Active}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="4"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStep4Complete}" Value="True">
                                                    <Setter Property="Text" Value="✓"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsStep4Active}" Value="True">
                                                    <Setter Property="Text" Value="4"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Review">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Typography.Label}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep4Complete}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsStep4Active}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="FontWeight" Value="{DynamicResource Weight.Bold}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <Border Grid.Column="7">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep4Complete}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- STEP 5 — SPECIFICATIONS -->
                    <Button Grid.Column="8" Style="{StaticResource StepBadgeButtonStyle}"
                            Command="{Binding GoToStepCommand}" CommandParameter="5"
                            IsEnabled="{Binding CanNavigateToStep5}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Badge.Primary}">
                                        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep5Complete}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsStep5Active}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="5"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStep5Complete}" Value="True">
                                                    <Setter Property="Text" Value="✓"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsStep5Active}" Value="True">
                                                    <Setter Property="Text" Value="5"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Specifications">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Typography.Label}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep5Complete}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsStep5Active}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="FontWeight" Value="{DynamicResource Weight.Bold}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Close ✕ button -->
                <Button Grid.Column="2" Command="{Binding CancelCommand}"
                        Width="38" Height="38" Cursor="Hand" BorderThickness="{DynamicResource Border.NoneThickness}"
                        Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center"
                        FocusVisualStyle="{x:Null}" ToolTip="Back to saved reports">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Width="32" Height="32" SnapsToDevicePixels="True" Style="{StaticResource SurfacePrimaryStyle}">
                                <TextBlock x:Name="ic" Text="✕"
                                           FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource TintRedBrush}"/>
                                    <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 1 — STEP CONTENT
        ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Background="{DynamicResource Surface.Secondary.BackgroundBrush}"
              UseLayoutRounding="True" SnapsToDevicePixels="True">

            <filter:FilterStep>
                <filter:FilterStep.Style>
                    <Style TargetType="filter:FilterStep">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </filter:FilterStep.Style>
            </filter:FilterStep>

            <preview:PreviewStep>
                <preview:PreviewStep.Style>
                    <Style TargetType="preview:PreviewStep">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </preview:PreviewStep.Style>
            </preview:PreviewStep>

            <pipeline:ExecuteStep>
                <pipeline:ExecuteStep.Style>
                    <Style TargetType="pipeline:ExecuteStep">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </pipeline:ExecuteStep.Style>
            </pipeline:ExecuteStep>

            <review:ReviewStep>
                <review:ReviewStep.Style>
                    <Style TargetType="review:ReviewStep">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </review:ReviewStep.Style>
            </review:ReviewStep>

            <specs:SpecificationsStep>
                <specs:SpecificationsStep.Style>
                    <Style TargetType="specs:SpecificationsStep">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentStep}" Value="5">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </specs:SpecificationsStep.Style>
            </specs:SpecificationsStep>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 2 — FOOTER NAVIGATION
        ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource SurfacePrimaryBrush}"
                BorderThickness="{DynamicResource Border.TopHairlineThickness}" BorderBrush="{DynamicResource BorderDefaultBrush}">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding CancelCommand}"
                        Style="{StaticResource NavButtonDangerStyle}"
                        Content="Cancel" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="12,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding PreviousStepCommand}"
                            Style="{StaticResource NavButtonSecondaryStyle}"
                            Content="Previous" Margin="0,0,10,0"
                            Visibility="{Binding CanGoPrevious, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <Button Command="{Binding NextStepCommand}"
                            Style="{StaticResource Button.Primary}"
                            Content="Next Step"
                            Visibility="{Binding ShowNextButton, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <Button Command="{Binding NextStepCommand}"
                            Style="{StaticResource Button.Primary}"
                            Content="Generate Report"
                            Visibility="{Binding ShowGenerateButton, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <Button Command="{Binding FinishCommand}"
                            Style="{StaticResource NavButtonSuccessStyle}"
                            Content="Finish"
                            Visibility="{Binding ShowFinishButton, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
