<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared indigo generator chrome. Merges the proforma list system so
         both generators use the same hero, cards, chips and buttons. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../Shared/Lists/StudioListResources.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Gen.Step" TargetType="Button" BasedOn="{StaticResource Sl.Button}">
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="MinWidth" Value="112"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Gen.Track" TargetType="ProgressBar">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Foreground" Value="{DynamicResource Ov.Accent}"/>
        <Setter Property="Background" Value="{DynamicResource Ov.Soft}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
</ResourceDictionary>
