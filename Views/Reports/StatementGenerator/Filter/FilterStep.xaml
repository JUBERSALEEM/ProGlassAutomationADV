<!-- ═══════════════════════════════════════════════════════════════
     FILE: Views/Reports/StatementGenerator/Filter/FilterStep.xaml
     PROJECT: ProGlassAutomation
     MODULE: Statement Generator — Step 1: FILTER (Chat 22 v5.2 — Perf Hardened)

     CHAT 22 v5.2 OPTIMIZATIONS (visual UNCHANGED from v5.1):
       ✓ Panel.ZIndex on ambient Canvas (prevents render-order issues)
       ✓ Inner Grid background set (short-circuits transparency compositing)
       ✓ StatusChip template extracted to shared resource (was 7× cloned)
       ✓ PdfOptionCardStyle extracted to shared resource (was 6× duplicated)
       ✓ Popup animation Slide → Fade (GPU-composited)
       ✓ All DropShadowEffects extracted to frozen resources
       ✓ RenderOptions hints at root for antialiasing efficiency

     DESIGN PATTERN: Neo-crystal surfaces
       Reference: Linear.app + Vercel + Stripe design systems
═══════════════════════════════════════════════════════════════ -->
<UserControl
    x:Class="ProGlassAutomation.Views.Reports.StatementGenerator.Filter.FilterStep"
             TextOptions.TextHintingMode="Fixed"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels.Reports.StatementGenerator"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:StatementGeneratorViewModel, IsDesignTimeCreatable=False}"
    FontFamily="{DynamicResource AppFontFamily}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    RenderOptions.BitmapScalingMode="HighQuality"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ══════════════════════════════════════════════════════════
             FROZEN BRUSHES
        ══════════════════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="IndigoPrimary" Color="{DynamicResource AccentColor}"/>
        
        <SolidColorBrush x:Key="IndigoLight" Color="{DynamicResource TintIndigoColor}"/>
        <SolidColorBrush x:Key="CyanAccent" Color="{DynamicResource AccentLightColor}"/>
        
        
        <SolidColorBrush x:Key="ChevronBrush" Color="{DynamicResource MutedForegroundColor}"/>
        <SolidColorBrush x:Key="CountBadgeBg" Color="{DynamicResource TintGrayColor}"/>
        <SolidColorBrush x:Key="CountBadgeText" Color="{DynamicResource SecondaryForegroundColor}"/>
        <SolidColorBrush x:Key="HoverFillLight" Color="{DynamicResource TintGrayColor}"/>
        <SolidColorBrush x:Key="ChipCheckedBg" Color="{DynamicResource TintIndigoColor}"/>
        <SolidColorBrush x:Key="ClearHoverBg" Color="{DynamicResource TintRedColor}"/>
        <SolidColorBrush x:Key="ClearHoverBorder" Color="{DynamicResource DangerColor}"/>
        <SolidColorBrush x:Key="ClearHoverText" Color="{DynamicResource DangerColor}"/>

        <!-- ══════════════════════════════════════════════════════════
             FROZEN GRADIENTS
        ══════════════════════════════════════════════════════════ -->
        <LinearGradientBrush x:Key="IndigoIconGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource AccentDarkColor}" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="VioletPinkGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource AccentLightColor}" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="IndigoAccentBar" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource AccentDarkColor}" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CyanAccentBar" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{DynamicResource AccentLightColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource AccentDarkColor}" Offset="1"/>
        </LinearGradientBrush>

        <!-- ══════════════════════════════════════════════════════════
             FROZEN EFFECTS
        ══════════════════════════════════════════════════════════ -->
        <DropShadowEffect x:Key="MatchCountShadow"
                          BlurRadius="22" ShadowDepth="4"
                          Opacity="0.08" Color="{DynamicResource AccentColor}"/>

        <DropShadowEffect x:Key="IndigoIconShadow"
                          BlurRadius="12" ShadowDepth="4"
                          Opacity="0.35" Color="{DynamicResource AccentColor}"/>

        <DropShadowEffect x:Key="VioletIconShadow"
                          BlurRadius="12" ShadowDepth="4"
                          Opacity="0.35" Color="{DynamicResource AccentColor}"/>

        <DropShadowEffect x:Key="InputShadow"
                          BlurRadius="4" ShadowDepth="1"
                          Opacity="0.04" Color="{DynamicResource LiquidShadowColor}"
                         />

        <DropShadowEffect x:Key="PopupShadow"
                          BlurRadius="20" ShadowDepth="4"
                          Opacity="0.15" Color="{DynamicResource LiquidShadowColor}"
                         />

        <DropShadowEffect x:Key="OptionCardHoverShadow"
                          BlurRadius="16" ShadowDepth="4"
                          Opacity="0.1" Color="{DynamicResource AccentColor}"/>

        <!-- ══════════════════════════════════════════════════════════
             MODERN COMBOBOX TOGGLE TEMPLATE
        ══════════════════════════════════════════════════════════ -->
        <ControlTemplate x:Key="ModernComboBoxToggleButtonTemplate"
                         TargetType="ToggleButton">
            <Border Background="Transparent" BorderThickness="{DynamicResource Border.NoneThickness}"
                    SnapsToDevicePixels="True">
                <Path x:Name="chevron"
                      Data="M7,10L12,15L17,10H7Z"
                      Fill="{DynamicResource ChevronBrush}"
                      Stretch="Uniform"
                      Width="14" Height="14"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="0,0,14,0"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="chevron" Property="Fill" Value="{DynamicResource IndigoPrimary}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ══════════════════════════════════════════════════════════
             MODERN COMBOBOX STYLE
        ══════════════════════════════════════════════════════════ -->
        <Style x:Key="LiquidComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="rootBorder"
                                    Background="{DynamicResource ModuleBackgroundBrush}"
                                    BorderBrush="{DynamicResource OutlineBrush}"
                                    BorderThickness="{DynamicResource CardBorderThickness}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    SnapsToDevicePixels="True"
                                    Effect="{StaticResource InputShadow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="PART_EditableTextBox"
                                             Grid.Column="0"
                                             Background="Transparent"
                                             BorderThickness="{DynamicResource Border.NoneThickness}"
                                             Foreground="{TemplateBinding Foreground}"
                                             FontSize="{TemplateBinding FontSize}"
                                             FontWeight="{TemplateBinding FontWeight}"
                                             Padding="{TemplateBinding Padding}"
                                             VerticalContentAlignment="Center"
                                             CaretBrush="{DynamicResource IndigoPrimary}"
                                             SelectionBrush="{DynamicResource TintIndigoBrush}"
                                             Focusable="True"/>

                                    <ToggleButton Grid.Column="1"
                                                  x:Name="ToggleButton"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  Template="{StaticResource ModernComboBoxToggleButtonTemplate}"
                                                  IsChecked="{Binding IsDropDownOpen,
                                                      RelativeSource={RelativeSource TemplatedParent},
                                                      Mode=TwoWay}"/>
                                </Grid>
                            </Border>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   VerticalOffset="4">
                                <Border Background="{DynamicResource PopupSurfaceBrush}"
                                        BorderBrush="{DynamicResource OutlineBrush}"
                                        BorderThickness="{DynamicResource CardBorderThickness}"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="280"
                                        Padding="4"
                                        SnapsToDevicePixels="True"
                                        Effect="{StaticResource PopupShadow}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  CanContentScroll="True">
                                        <VirtualizingStackPanel IsItemsHost="True"
                                                                VirtualizationMode="Recycling"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="rootBorder" Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="rootBorder" Property="BorderBrush" Value="{DynamicResource IndigoPrimary}"/>
                                <Setter TargetName="rootBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox items -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBd"
                                Background="Transparent"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBd" Property="Background" Value="{StaticResource HoverFillLight}"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBd" Property="Background" Value="{StaticResource IndigoLight}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBd" Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════
             MODERN DATEPICKER STYLE
        ══════════════════════════════════════════════════════════ -->
        <Style x:Key="LiquidDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="rootBorder"
                                Background="{DynamicResource ModuleBackgroundBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="{DynamicResource CardBorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True"
                                Effect="{StaticResource InputShadow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Grid.Column="0"
                                                   Background="Transparent"
                                                   BorderThickness="{DynamicResource Border.NoneThickness}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   FontWeight="{TemplateBinding FontWeight}"
                                                   Padding="{TemplateBinding Padding}"
                                                   VerticalContentAlignment="Center"
                                                   Focusable="{TemplateBinding Focusable}"/>

                                <Button Grid.Column="1"
                                        x:Name="PART_Button"
                                        Focusable="False"
                                        Width="36" Height="36"
                                        Margin="0,0,4,0"
                                        Background="Transparent"
                                        BorderThickness="{DynamicResource Border.NoneThickness}"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBd"
                                                    Background="Transparent"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    SnapsToDevicePixels="True">
                                                <Path Data="M19,3H18V1H16V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,19H5V8H19V19Z"
                                                      Fill="{DynamicResource ChevronBrush}"
                                                      Stretch="Uniform"
                                                      Width="16" Height="16"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBd" Property="Background" Value="{StaticResource IndigoLight}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Placement="Bottom"
                                       PlacementTarget="{Binding ElementName=PART_Button}"
                                       StaysOpen="False"
                                       PopupAnimation="Fade"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="rootBorder" Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="rootBorder" Property="BorderBrush" Value="{DynamicResource IndigoPrimary}"/>
                                <Setter TargetName="rootBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════
             FIELD LABEL
        ══════════════════════════════════════════════════════════ -->
        <Style x:Key="LiquidFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>

        <!-- ══════════════════════════════════════════════════════════
             SHARED PDF OPTION CARD STYLE (was inline × 6)
        ══════════════════════════════════════════════════════════ -->
        <Style x:Key="PdfOptionCardStyle" TargetType="Border" BasedOn="{StaticResource SurfaceSecondaryStyle}">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource IndigoPrimary}"/>
                    <Setter Property="Effect" Value="{StaticResource OptionCardHoverShadow}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ══════════════════════════════════════════════════════════
             SHARED STATUS CHIP TEMPLATE (was cloned per chip × 7)
        ══════════════════════════════════════════════════════════ -->
        <ControlTemplate x:Key="StatusChipTemplate" TargetType="CheckBox">
            <Border x:Name="chipRoot"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Padding="14,8"
                    Background="{DynamicResource PopupSurfaceBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    SnapsToDevicePixels="True">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border x:Name="tick"
                            Width="18" Height="18"
                            CornerRadius="{DynamicResource Radius.Small}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="{DynamicResource CardBorderThickness}"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            SnapsToDevicePixels="True">
                        <Path x:Name="tickGlyph"
                              Data="M9,20.42L2.79,14.21L5.62,11.38L9,14.77L18.88,4.88L21.71,7.71L9,20.42Z"
                              Fill="{DynamicResource OnAccentForegroundBrush}"
                              Stretch="Uniform"
                              Width="11" Height="11"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Visibility="Collapsed"/>
                    </Border>

                    <TextBlock Text="{Binding StatusLabel}"
                               FontSize="{StaticResource TextBodyLarge}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"/>

                    <Border x:Name="countBadge"
                            Background="{DynamicResource CountBadgeBg}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="8,3"
                            Margin="10,0,0,0"
                            MinWidth="24"
                            VerticalAlignment="Center"
                            SnapsToDevicePixels="True"
                            Visibility="{Binding HasCount,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock x:Name="countText"
                                   Text="{Binding CountDisplay}"
                                   FontSize="{StaticResource TextBody}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource CountBadgeText}"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="chipRoot" Property="Background" Value="{StaticResource ChipCheckedBg}"/>
                    <Setter TargetName="chipRoot" Property="BorderBrush" Value="{DynamicResource IndigoPrimary}"/>
                    <Setter TargetName="tick" Property="Background" Value="{DynamicResource IndigoPrimary}"/>
                    <Setter TargetName="tick" Property="BorderBrush" Value="{DynamicResource IndigoPrimary}"/>
                    <Setter TargetName="tickGlyph" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="countBadge" Property="Background" Value="{DynamicResource IndigoPrimary}"/>
                    <Setter TargetName="countText" Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsChecked" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="chipRoot" Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
                    <Setter TargetName="chipRoot" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                </MultiTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         ROOT
    ═══════════════════════════════════════════════════════════════ -->
    <Grid Background="{DynamicResource WindowBackgroundBrush}">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      IsDeferredScrollingEnabled="False"
                      PanningMode="VerticalOnly"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">

            <Grid Margin="40,32,40,32" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ═══════════════════════════════════════════════════
                     ROW 0 — HEADER
                ═══════════════════════════════════════════════════ -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="6" Height="6"
                                    Background="{DynamicResource IndigoPrimary}"
                                    CornerRadius="{DynamicResource Radius.XSmall}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource Reports.StatementGenerator.STEP14}"
                                       FontSize="{StaticResource TextBody}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource IndigoPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Reports.StatementGenerator.FilterCriteria}"
                                   FontSize="{StaticResource TextDisplay}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{DynamicResource Reports.StatementGenerator.NarrowInvoicesCompanySalesmanCustomerProject}"
                                   FontSize="{StaticResource TextSection}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{DynamicResource ModuleBackgroundBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="{DynamicResource CardBorderThickness}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="22,18"
                            VerticalAlignment="Center"
                            MinWidth="240"
                            Effect="{StaticResource MatchCountShadow}"
                            CacheMode="BitmapCache"
                            SnapsToDevicePixels="True">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10"
                                        CornerRadius="{DynamicResource Radius.Small}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0"
                                        Background="{DynamicResource GreenLed}"
                                        Effect="{StaticResource GreenLedGlow}"/>
                                <TextBlock Text="{DynamicResource Reports.StatementGenerator.LIVEMatchCount}"
                                           FontSize="{StaticResource TextCaption}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding MatchCountDisplay}"
                                       FontSize="{StaticResource TextSubhead}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════════════════════
                     ROW 2 — FILTERS CARD
                ═══════════════════════════════════════════════════ -->
                <Border Grid.Row="2"
                        Background="{DynamicResource ModuleBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                        Padding="0"
                        CacheMode="BitmapCache"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Card header -->
                        <Grid Grid.Row="0" Margin="28,24,28,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="44" Height="44"
                                    CornerRadius="{DynamicResource CardCornerRadius}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,16,0"
                                    Background="{DynamicResource IndigoIconGradient}"
                                    Effect="{StaticResource IndigoIconShadow}"
                                    SnapsToDevicePixels="True">
                                <Path Data="M15.5,14L20.5,19L19,20.5L14,15.5V14.71L13.73,14.43C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.43,13.73L14.71,14H15.5M9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14Z"
                                      Fill="{DynamicResource OnAccentForegroundBrush}"
                                      Stretch="Uniform"
                                      Width="22" Height="22"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Reports.StatementGenerator.StatementFilters}"
                                           FontSize="{StaticResource TextTitle}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{DynamicResource Reports.StatementGenerator.ConfigureBusinessDimensionsInvoiceStatus}"
                                           FontSize="{StaticResource TextBodyLarge}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Command="{Binding ClearFiltersCommand}"
                                    Height="40"
                                    Padding="18,0"
                                    Cursor="Hand"
                                    BorderThickness="{DynamicResource Border.NoneThickness}"
                                    Background="Transparent"
                                    VerticalAlignment="Center"
                                    ToolTip="{DynamicResource Reports.StatementGenerator.ResetFilterValues}"
                                    FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd"
                                                Background="{DynamicResource ModuleBackgroundBrush}"
                                                BorderBrush="{DynamicResource OutlineBrush}"
                                                BorderThickness="{DynamicResource CardBorderThickness}"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True">
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Path x:Name="ic"
                                                      Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                                      Fill="{DynamicResource TextSecondary}"
                                                      Stretch="Uniform"
                                                      Width="12" Height="12"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0"/>
                                                <TextBlock x:Name="tx"
                                                           Text="{DynamicResource Action.ClearFilters}"
                                                           FontSize="{StaticResource TextBodyLarge}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ClearHoverBg}"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ClearHoverBorder}"/>
                                                <Setter TargetName="ic" Property="Fill" Value="{StaticResource ClearHoverText}"/>
                                                <Setter TargetName="tx" Property="Foreground" Value="{StaticResource ClearHoverText}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Body -->
                        <Grid Grid.Row="1" Margin="28,0,28,28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.7*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT: Form fields -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.ColumnSpan="3"
                                            Orientation="Horizontal"
                                            Margin="0,0,0,4">
                                    <Border Width="4" Height="18"
                                            CornerRadius="{DynamicResource Radius.XSmall}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0"
                                            Background="{DynamicResource IndigoAccentBar}"/>
                                    <TextBlock Text="{DynamicResource Reports.StatementGenerator.BusinessDimensions}"
                                               FontSize="{StaticResource TextBody}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource IndigoPrimary}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="{DynamicResource Common.Company}" Style="{StaticResource LiquidFieldLabelStyle}"/>
                                    <ComboBox Style="{StaticResource LiquidComboBoxStyle}"
                                              ItemsSource="{Binding Companies}"
                                              Text="{Binding FilterCompany, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="{DynamicResource Reports.StatementGenerator.SelectSupplierFactoryCompany}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Common.Salesman}" Style="{StaticResource LiquidFieldLabelStyle}"/>
                                    <ComboBox Style="{StaticResource LiquidComboBoxStyle}"
                                              ItemsSource="{Binding Salesmen}"
                                              Text="{Binding FilterSalesman, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="{DynamicResource Reports.DeliveryReport.FilterSalesRepresentative}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="0">
                                    <TextBlock Text="{DynamicResource Common.Customer}" Style="{StaticResource LiquidFieldLabelStyle}"/>
                                    <ComboBox Style="{StaticResource LiquidComboBoxStyle}"
                                              ItemsSource="{Binding Customers}"
                                              Text="{Binding FilterCustomer, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="{DynamicResource Reports.StatementGenerator.SelectBillingCustomer}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Common.Project}" Style="{StaticResource LiquidFieldLabelStyle}"/>
                                    <ComboBox Style="{StaticResource LiquidComboBoxStyle}"
                                              ItemsSource="{Binding Projects}"
                                              Text="{Binding FilterProject, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="{DynamicResource Reports.StatementGenerator.FilterProjectReference}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="6" Grid.Column="0">
                                    <TextBlock Text="{DynamicResource Reports.StatementGenerator.Date2}" Style="{StaticResource LiquidFieldLabelStyle}"/>
                                    <DatePicker Style="{StaticResource LiquidDatePickerStyle}"
                                                SelectedDate="{Binding DateFrom}"
                                                ToolTip="{DynamicResource Reports.StatementGenerator.InvoicesIssuedAfterDate}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="6" Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Reports.StatementGenerator.Date}" Style="{StaticResource LiquidFieldLabelStyle}"/>
                                    <DatePicker Style="{StaticResource LiquidDatePickerStyle}"
                                                SelectedDate="{Binding DateTo}"
                                                ToolTip="{DynamicResource Reports.StatementGenerator.InvoicesIssuedBeforeDate}"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Column="1"
                                    Width="1"
                                    Background="{DynamicResource OutlineBrush}"
                                    Margin="14,10"
                                    Opacity="0.5"/>

                            <!-- RIGHT: Status chips -->
                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,4">
                                    <Border Width="4" Height="18"
                                            CornerRadius="{DynamicResource Radius.XSmall}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0"
                                            Background="{DynamicResource CyanAccentBar}"/>
                                    <TextBlock Text="{DynamicResource Reports.StatementGenerator.InvoiceStatus}"
                                               FontSize="{StaticResource TextBody}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource CyanAccent}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="{DynamicResource Reports.StatementGenerator.SelectStatusesInclude}"
                                           FontSize="{StaticResource TextBodyLarge}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,6,0,16"/>

                                <ItemsControl ItemsSource="{Binding StatusItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked}"
                                                      Cursor="Hand"
                                                      Margin="0,0,8,8"
                                                      FocusVisualStyle="{x:Null}"
                                                      Template="{StaticResource StatusChipTemplate}">
                                                <CheckBox.ToolTip>
                                                    <ToolTip>
                                                        <StackPanel MaxWidth="240">
                                                            <TextBlock Text="{Binding StatusLabel}"
                                                                       FontWeight="Bold"
                                                                       FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="{DynamicResource Reports.StatementGenerator.ClickToggleNumberShowsCurrentMatchCount}"
                                                                       FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource OutlineBrush}"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </CheckBox.ToolTip>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════════════
                     ROW 4 — PDF OPTIONS CARD
                ═══════════════════════════════════════════════════ -->
                <Border Grid.Row="4"
                        Background="{DynamicResource ModuleBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                        Padding="0"
                        CacheMode="BitmapCache"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal"
                                    Margin="28,24,28,20">
                            <Border Width="44" Height="44"
                                    CornerRadius="{DynamicResource CardCornerRadius}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,16,0"
                                    Background="{DynamicResource VioletPinkGradient}"
                                    Effect="{StaticResource VioletIconShadow}"
                                    SnapsToDevicePixels="True">
                                <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"
                                      Fill="{DynamicResource OnAccentForegroundBrush}"
                                      Stretch="Uniform"
                                      Width="22" Height="22"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Reports.StatementGenerator.PDFGenerationOptions}"
                                           FontSize="{StaticResource TextTitle}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{DynamicResource Reports.StatementGenerator.ChooseWhatIncludeFinalMergedReport}"
                                           FontSize="{StaticResource TextBodyLarge}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <UniformGrid Grid.Row="1" Rows="2" Columns="3"
                                     Margin="20,0,20,20">
                            <Border Style="{StaticResource PdfOptionCardStyle}"
                                    ToolTip="{DynamicResource Reports.StatementGenerator.MergeTaxInvoicesDeliveryNotesProforma}">
                                <CheckBox IsChecked="{Binding IncludeAttachments}"
                                          Cursor="Hand"
                                          Padding="18,16"
                                          VerticalContentAlignment="Top">
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="{DynamicResource Reports.StatementGenerator.IncludeAttachments}"
                                                   FontSize="{StaticResource TextSection}" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{DynamicResource Reports.StatementGenerator.MergeTaxInvoicesDeliveryNotes}"
                                                   FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Style="{StaticResource PdfOptionCardStyle}"
                                    ToolTip="{DynamicResource Reports.StatementGenerator.ShowDeliveryNoteLineItemDetails}">
                                <CheckBox IsChecked="{Binding IncludeDnDetails}"
                                          Cursor="Hand"
                                          Padding="18,16"
                                          VerticalContentAlignment="Top">
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="{DynamicResource Reports.StatementGenerator.DNLineItems}"
                                                   FontSize="{StaticResource TextSection}" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{DynamicResource Reports.StatementGenerator.ShowDeliveryNoteDetailsBody}"
                                                   FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Style="{StaticResource PdfOptionCardStyle}"
                                    ToolTip="{DynamicResource Reports.StatementGenerator.AddOrderedVsDeliveredComparisonTable}">
                                <CheckBox IsChecked="{Binding IncludeBalanceAnalysis}"
                                          Cursor="Hand"
                                          Padding="18,16"
                                          VerticalContentAlignment="Top">
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="{DynamicResource Reports.StatementGenerator.BalanceAnalysis}"
                                                   FontSize="{StaticResource TextSection}" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{DynamicResource Reports.StatementGenerator.OrderedVsDeliveredComparison}"
                                                   FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Style="{StaticResource PdfOptionCardStyle}"
                                    ToolTip="{DynamicResource Reports.StatementGenerator.VisualBreakdown0303160619090Days}">
                                <CheckBox IsChecked="{Binding IncludeAgingChart}"
                                          Cursor="Hand"
                                          Padding="18,16"
                                          VerticalContentAlignment="Top">
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="{DynamicResource Reports.StatementGenerator.AgingChart}"
                                                   FontSize="{StaticResource TextSection}" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{DynamicResource Reports.StatementGenerator.VisualAgingBucketBreakdown}"
                                                   FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Style="{StaticResource PdfOptionCardStyle}"
                                    ToolTip="{DynamicResource Reports.StatementGenerator.AddPlaceholderPagesFailedRegenerations}">
                                <CheckBox IsChecked="{Binding IncludeInsertPlaceholders}"
                                          Cursor="Hand"
                                          Padding="18,16"
                                          VerticalContentAlignment="Top">
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="{DynamicResource Reports.StatementGenerator.InsertPlaceholders}"
                                                   FontSize="{StaticResource TextSection}" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{DynamicResource Reports.StatementGenerator.PagesFailedInvoiceRegenerations}"
                                                   FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Style="{StaticResource PdfOptionCardStyle}"
                                    ToolTip="{DynamicResource Reports.StatementGenerator.IncludeWarningsAlertsSummarySection}">
                                <CheckBox IsChecked="{Binding IncludeWarningsSummary}"
                                          Cursor="Hand"
                                          Padding="18,16"
                                          VerticalContentAlignment="Top">
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="{DynamicResource Reports.StatementGenerator.WarningsSummary}"
                                                   FontSize="{StaticResource TextSection}" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{DynamicResource Reports.StatementGenerator.AlertsWarningsReport}"
                                                   FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>