<!-- ═══════════════════════════════════════════════════════════════
     FILE: Views/Reports/StatementGenerator/Filter/FilterStep.xaml
     PROJECT: ProGlassAutomation
     MODULE: Statement Generator — Step 1: FILTER (Chat 22 v5.2 — Perf Hardened)

     CHAT 22 v5.2 OPTIMIZATIONS (visual UNCHANGED from v5.1):
       ✓ Panel.ZIndex on ambient Canvas (prevents render-order issues)
       ✓ Inner Grid background set (short-circuits transparency compositing)
       ✓ StatusChip template extracted to shared resource (was 7× cloned)
       ✓ PdfOptionCardStyle extracted to shared resource (was 6× duplicated)
       ✓ Popup animation Slide → Fade (GPU-composited)
       ✓ All DropShadowEffects extracted to frozen resources
       ✓ RenderOptions hints at root for antialiasing efficiency

     DESIGN PATTERN: Neo-Glassmorphism
       Reference: Linear.app + Vercel + Stripe design systems
═══════════════════════════════════════════════════════════════ -->
<UserControl
    x:Class="ProGlassAutomation.Views.Reports.StatementGenerator.Filter.FilterStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels.Reports.StatementGenerator"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:StatementGeneratorViewModel, IsDesignTimeCreatable=False}"
    FontFamily="Segoe UI"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    TextOptions.TextHintingMode="Fixed"
    RenderOptions.BitmapScalingMode="HighQuality"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ══════════════════════════════════════════════════════════
             FROZEN BRUSHES
        ══════════════════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="GlassCardBg" Color="#FFFFFF" Opacity="0.72" po:Freeze="True"/>
        <SolidColorBrush x:Key="GlassCardBorder" Color="#FFFFFF" Opacity="0.8" po:Freeze="True"/>
        <SolidColorBrush x:Key="GlassInnerBg" Color="#FFFFFF" Opacity="0.6" po:Freeze="True"/>
        <SolidColorBrush x:Key="ChipBg" Color="#FFFFFF" Opacity="0.69" po:Freeze="True"/>
        <SolidColorBrush x:Key="ClearBtnBg" Color="#FFFFFF" Opacity="0.67" po:Freeze="True"/>

        <SolidColorBrush x:Key="IndigoPrimary" Color="#4F46E5" po:Freeze="True"/>
        <SolidColorBrush x:Key="IndigoDark" Color="{DynamicResource AccentColor}"/>
        <SolidColorBrush x:Key="IndigoLight" Color="#EEF2FF" po:Freeze="True"/>
        <SolidColorBrush x:Key="VioletAccent" Color="#8B5CF6" po:Freeze="True"/>
        <SolidColorBrush x:Key="CyanAccent" Color="#06B6D4" po:Freeze="True"/>
        <SolidColorBrush x:Key="EmeraldAccent" Color="#3B82F6" po:Freeze="True"/>

        <SolidColorBrush x:Key="TextPrimary" Color="#0F172A" po:Freeze="True"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#475569" po:Freeze="True"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" po:Freeze="True"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#E2E8F0" po:Freeze="True"/>
        <SolidColorBrush x:Key="BorderHover" Color="#CBD5E1" po:Freeze="True"/>
        <SolidColorBrush x:Key="ChevronBrush" Color="#64748B" po:Freeze="True"/>
        <SolidColorBrush x:Key="CountBadgeBg" Color="#F1F5F9" po:Freeze="True"/>
        <SolidColorBrush x:Key="CountBadgeText" Color="#475569" po:Freeze="True"/>
        <SolidColorBrush x:Key="HoverFillLight" Color="#F1F5F9" po:Freeze="True"/>
        <SolidColorBrush x:Key="ChipCheckedBg" Color="#EEF2FF" po:Freeze="True"/>
        <SolidColorBrush x:Key="ClearHoverBg" Color="#FEE2E2" po:Freeze="True"/>
        <SolidColorBrush x:Key="ClearHoverBorder" Color="#EF4444" po:Freeze="True"/>
        <SolidColorBrush x:Key="ClearHoverText" Color="#DC2626" po:Freeze="True"/>

        <!-- ══════════════════════════════════════════════════════════
             FROZEN GRADIENTS
        ══════════════════════════════════════════════════════════ -->
        <LinearGradientBrush x:Key="AmbientBg" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
            <GradientStop Color="#F8FAFC" Offset="0"/>
            <GradientStop Color="#EEF2FF" Offset="0.5"/>
            <GradientStop Color="#F0F9FF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="IndigoIconGradient" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
            <GradientStop Color="#4F46E5" Offset="0"/>
            <GradientStop Color="#7C3AED" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="VioletPinkGradient" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
            <GradientStop Color="#8B5CF6" Offset="0"/>
            <GradientStop Color="#EC4899" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="IndigoAccentBar" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
            <GradientStop Color="#4F46E5" Offset="0"/>
            <GradientStop Color="#7C3AED" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CyanAccentBar" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
            <GradientStop Color="#06B6D4" Offset="0"/>
            <GradientStop Color="#0891B2" Offset="1"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="VioletBlob" po:Freeze="True">
            <GradientStop Color="#8B5CF6" Offset="0"/>
            <GradientStop Color="Transparent" Offset="1"/>
        </RadialGradientBrush>

        <RadialGradientBrush x:Key="CyanBlob" po:Freeze="True">
            <GradientStop Color="#06B6D4" Offset="0"/>
            <GradientStop Color="Transparent" Offset="1"/>
        </RadialGradientBrush>

        <RadialGradientBrush x:Key="GreenLed" po:Freeze="True">
            <GradientStop Color="#34D399" Offset="0"/>
            <GradientStop Color="#3B82F6" Offset="1"/>
        </RadialGradientBrush>

        <!-- ══════════════════════════════════════════════════════════
             FROZEN EFFECTS
        ══════════════════════════════════════════════════════════ -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="32" ShadowDepth="8"
                          Opacity="0.08" Color="#1E1B4B"
                          po:Freeze="True"/>

        <DropShadowEffect x:Key="MatchCountShadow"
                          BlurRadius="24" ShadowDepth="4"
                          Opacity="0.08" Color="#4F46E5"
                          po:Freeze="True"/>

        <DropShadowEffect x:Key="IndigoIconShadow"
                          BlurRadius="12" ShadowDepth="4"
                          Opacity="0.35" Color="#4F46E5"
                          po:Freeze="True"/>

        <DropShadowEffect x:Key="VioletIconShadow"
                          BlurRadius="12" ShadowDepth="4"
                          Opacity="0.35" Color="#8B5CF6"
                          po:Freeze="True"/>

        <DropShadowEffect x:Key="InputShadow"
                          BlurRadius="4" ShadowDepth="1"
                          Opacity="0.04" Color="Black"
                          po:Freeze="True"/>

        <DropShadowEffect x:Key="PopupShadow"
                          BlurRadius="20" ShadowDepth="4"
                          Opacity="0.15" Color="Black"
                          po:Freeze="True"/>

        <DropShadowEffect x:Key="GreenLedGlow"
                          BlurRadius="8" ShadowDepth="0"
                          Opacity="0.6" Color="#3B82F6"
                          po:Freeze="True"/>

        <DropShadowEffect x:Key="OptionCardHoverShadow"
                          BlurRadius="16" ShadowDepth="4"
                          Opacity="0.1" Color="#4F46E5"
                          po:Freeze="True"/>

        <!-- ══════════════════════════════════════════════════════════
             MODERN COMBOBOX TOGGLE TEMPLATE
        ══════════════════════════════════════════════════════════ -->
        <ControlTemplate x:Key="ModernComboBoxToggleButtonTemplate"
                         TargetType="ToggleButton">
            <Border Background="Transparent" BorderThickness="0"
                    SnapsToDevicePixels="True">
                <Path x:Name="chevron"
                      Data="M7,10L12,15L17,10H7Z"
                      Fill="{StaticResource ChevronBrush}"
                      Stretch="Uniform"
                      Width="14" Height="14"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="0,0,14,0"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="chevron" Property="Fill" Value="{StaticResource IndigoPrimary}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ══════════════════════════════════════════════════════════
             MODERN COMBOBOX STYLE
        ══════════════════════════════════════════════════════════ -->
        <Style x:Key="GlassComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="rootBorder"
                                    Background="White"
                                    BorderBrush="{DynamicResource OutlineBrush}"
                                    BorderThickness="{StaticResource CardBorderThickness}"
                                    CornerRadius="10"
                                    SnapsToDevicePixels="True"
                                    Effect="{StaticResource InputShadow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="PART_EditableTextBox"
                                             Grid.Column="0"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{TemplateBinding Foreground}"
                                             FontSize="{TemplateBinding FontSize}"
                                             FontWeight="{TemplateBinding FontWeight}"
                                             Padding="{TemplateBinding Padding}"
                                             VerticalContentAlignment="Center"
                                             CaretBrush="{StaticResource IndigoPrimary}"
                                             SelectionBrush="#C7D2FE"
                                             Focusable="True"/>

                                    <ToggleButton Grid.Column="1"
                                                  x:Name="ToggleButton"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  Template="{StaticResource ModernComboBoxToggleButtonTemplate}"
                                                  IsChecked="{Binding IsDropDownOpen,
                                                      RelativeSource={RelativeSource TemplatedParent},
                                                      Mode=TwoWay}"/>
                                </Grid>
                            </Border>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   VerticalOffset="4">
                                <Border Background="White"
                                        BorderBrush="{DynamicResource OutlineBrush}"
                                        BorderThickness="{StaticResource CardBorderThickness}"
                                        CornerRadius="10"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="280"
                                        Padding="4"
                                        SnapsToDevicePixels="True"
                                        Effect="{StaticResource PopupShadow}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  CanContentScroll="True">
                                        <VirtualizingStackPanel IsItemsHost="True"
                                                                VirtualizationMode="Recycling"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="rootBorder" Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="rootBorder" Property="BorderBrush" Value="{StaticResource IndigoPrimary}"/>
                                <Setter TargetName="rootBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox items -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBd"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBd" Property="Background" Value="{StaticResource HoverFillLight}"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBd" Property="Background" Value="{StaticResource IndigoLight}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBd" Property="Background" Value="#E0E7FF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════
             MODERN DATEPICKER STYLE
        ══════════════════════════════════════════════════════════ -->
        <Style x:Key="GlassDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="rootBorder"
                                Background="White"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="{StaticResource CardBorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True"
                                Effect="{StaticResource InputShadow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Grid.Column="0"
                                                   Background="Transparent"
                                                   BorderThickness="0"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   FontWeight="{TemplateBinding FontWeight}"
                                                   Padding="{TemplateBinding Padding}"
                                                   VerticalContentAlignment="Center"
                                                   Focusable="{TemplateBinding Focusable}"/>

                                <Button Grid.Column="1"
                                        x:Name="PART_Button"
                                        Focusable="False"
                                        Width="36" Height="36"
                                        Margin="0,0,4,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBd"
                                                    Background="Transparent"
                                                    CornerRadius="8"
                                                    SnapsToDevicePixels="True">
                                                <Path Data="M19,3H18V1H16V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,19H5V8H19V19Z"
                                                      Fill="{StaticResource ChevronBrush}"
                                                      Stretch="Uniform"
                                                      Width="16" Height="16"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBd" Property="Background" Value="{StaticResource IndigoLight}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Placement="Bottom"
                                       PlacementTarget="{Binding ElementName=PART_Button}"
                                       StaysOpen="False"
                                       PopupAnimation="Fade"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="rootBorder" Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="rootBorder" Property="BorderBrush" Value="{StaticResource IndigoPrimary}"/>
                                <Setter TargetName="rootBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════
             FIELD LABEL
        ══════════════════════════════════════════════════════════ -->
        <Style x:Key="GlassFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>

        <!-- ══════════════════════════════════════════════════════════
             SHARED PDF OPTION CARD STYLE (was inline × 6)
        ══════════════════════════════════════════════════════════ -->
        <Style x:Key="PdfOptionCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{StaticResource GlassInnerBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="BorderBrush" Value="{StaticResource IndigoPrimary}"/>
                    <Setter Property="Effect" Value="{StaticResource OptionCardHoverShadow}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ══════════════════════════════════════════════════════════
             SHARED STATUS CHIP TEMPLATE (was cloned per chip × 7)
        ══════════════════════════════════════════════════════════ -->
        <ControlTemplate x:Key="StatusChipTemplate" TargetType="CheckBox">
            <Border x:Name="chipRoot"
                    BorderThickness="{StaticResource CardBorderThickness}"
                    CornerRadius="10"
                    Padding="14,8"
                    Background="{StaticResource ChipBg}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    SnapsToDevicePixels="True">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border x:Name="tick"
                            Width="18" Height="18"
                            CornerRadius="5"
                            Background="Transparent"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="{StaticResource CardBorderThickness}"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            SnapsToDevicePixels="True">
                        <Path x:Name="tickGlyph"
                              Data="M9,20.42L2.79,14.21L5.62,11.38L9,14.77L18.88,4.88L21.71,7.71L9,20.42Z"
                              Fill="White"
                              Stretch="Uniform"
                              Width="11" Height="11"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Visibility="Collapsed"/>
                    </Border>

                    <TextBlock Text="{Binding StatusLabel}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center"/>

                    <Border x:Name="countBadge"
                            Background="{StaticResource CountBadgeBg}"
                            CornerRadius="10"
                            Padding="8,3"
                            Margin="10,0,0,0"
                            MinWidth="24"
                            VerticalAlignment="Center"
                            SnapsToDevicePixels="True"
                            Visibility="{Binding HasCount,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock x:Name="countText"
                                   Text="{Binding CountDisplay}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource CountBadgeText}"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="chipRoot" Property="Background" Value="{StaticResource ChipCheckedBg}"/>
                    <Setter TargetName="chipRoot" Property="BorderBrush" Value="{StaticResource IndigoPrimary}"/>
                    <Setter TargetName="tick" Property="Background" Value="{StaticResource IndigoPrimary}"/>
                    <Setter TargetName="tick" Property="BorderBrush" Value="{StaticResource IndigoPrimary}"/>
                    <Setter TargetName="tickGlyph" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="countBadge" Property="Background" Value="{StaticResource IndigoPrimary}"/>
                    <Setter TargetName="countText" Property="Foreground" Value="White"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsChecked" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="chipRoot" Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
                    <Setter TargetName="chipRoot" Property="Background" Value="White"/>
                </MultiTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         ROOT
    ═══════════════════════════════════════════════════════════════ -->
    <Grid Background="{StaticResource AmbientBg}">

        <!-- Ambient blobs — ZIndex -1 keeps them behind, BitmapCache renders once -->
        <Canvas Panel.ZIndex="-1"
                IsHitTestVisible="False"
                CacheMode="BitmapCache"
                ClipToBounds="True">
            <Ellipse Canvas.Left="-100" Canvas.Top="-100"
                     Width="500" Height="500"
                     Opacity="0.35"
                     Fill="{StaticResource VioletBlob}"/>
            <Ellipse Canvas.Right="-150" Canvas.Top="200"
                     Width="600" Height="600"
                     Opacity="0.25"
                     Fill="{StaticResource CyanBlob}"/>
        </Canvas>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      IsDeferredScrollingEnabled="False"
                      PanningMode="VerticalOnly"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">

            <Grid Margin="40,32,40,32" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ═══════════════════════════════════════════════════
                     ROW 0 — HEADER
                ═══════════════════════════════════════════════════ -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="6" Height="6"
                                    Background="{StaticResource IndigoPrimary}"
                                    CornerRadius="3"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0"/>
                            <TextBlock Text="STEP 1 OF 4"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource IndigoPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Filter Criteria"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Narrow invoices by company, salesman, customer, project, dates, or status. Preview updates automatically as you type."
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{DynamicResource ModuleBackgroundBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="{StaticResource CardBorderThickness}"
                            CornerRadius="16"
                            Padding="22,18"
                            VerticalAlignment="Center"
                            MinWidth="240"
                            Effect="{StaticResource MatchCountShadow}"
                            CacheMode="BitmapCache"
                            SnapsToDevicePixels="True">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10"
                                        CornerRadius="5"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0"
                                        Background="{StaticResource GreenLed}"
                                        Effect="{StaticResource GreenLedGlow}"/>
                                <TextBlock Text="LIVE MATCH COUNT"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding MatchCountDisplay}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════════════════════
                     ROW 2 — FILTERS CARD
                ═══════════════════════════════════════════════════ -->
                <Border Grid.Row="2"
                        Background="{DynamicResource ModuleBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{StaticResource CardBorderThickness}"
                        CornerRadius="20"
                        Padding="0"
                        Effect="{StaticResource CardShadow}"
                        CacheMode="BitmapCache"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Card header -->
                        <Grid Grid.Row="0" Margin="28,24,28,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="44" Height="44"
                                    CornerRadius="12"
                                    VerticalAlignment="Center"
                                    Margin="0,0,16,0"
                                    Background="{StaticResource IndigoIconGradient}"
                                    Effect="{StaticResource IndigoIconShadow}"
                                    SnapsToDevicePixels="True">
                                <Path Data="M15.5,14L20.5,19L19,20.5L14,15.5V14.71L13.73,14.43C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.43,13.73L14.71,14H15.5M9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14Z"
                                      Fill="White"
                                      Stretch="Uniform"
                                      Width="22" Height="22"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Statement Filters"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Configure business dimensions and invoice status"
                                           FontSize="13"
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Command="{Binding ClearFiltersCommand}"
                                    Height="40"
                                    Padding="18,0"
                                    Cursor="Hand"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    VerticalAlignment="Center"
                                    ToolTip="Reset all filter values"
                                    FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd"
                                                Background="{StaticResource ClearBtnBg}"
                                                BorderBrush="{DynamicResource OutlineBrush}"
                                                BorderThickness="{StaticResource CardBorderThickness}"
                                                CornerRadius="10"
                                                Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True">
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Path x:Name="ic"
                                                      Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                                      Fill="{StaticResource TextSecondary}"
                                                      Stretch="Uniform"
                                                      Width="12" Height="12"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"/>
                                                <TextBlock x:Name="tx"
                                                           Text="Clear filters"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ClearHoverBg}"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource ClearHoverBorder}"/>
                                                <Setter TargetName="ic" Property="Fill" Value="{StaticResource ClearHoverText}"/>
                                                <Setter TargetName="tx" Property="Foreground" Value="{StaticResource ClearHoverText}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Body -->
                        <Grid Grid.Row="1" Margin="28,0,28,28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.7*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT: Form fields -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.ColumnSpan="3"
                                            Orientation="Horizontal"
                                            Margin="0,0,0,4">
                                    <Border Width="4" Height="18"
                                            CornerRadius="2"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0"
                                            Background="{StaticResource IndigoAccentBar}"/>
                                    <TextBlock Text="BUSINESS DIMENSIONS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource IndigoPrimary}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="Company" Style="{StaticResource GlassFieldLabelStyle}"/>
                                    <ComboBox Style="{StaticResource GlassComboBoxStyle}"
                                              ItemsSource="{Binding Companies}"
                                              Text="{Binding FilterCompany, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Select the supplier / factory company"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="Salesman" Style="{StaticResource GlassFieldLabelStyle}"/>
                                    <ComboBox Style="{StaticResource GlassComboBoxStyle}"
                                              ItemsSource="{Binding Salesmen}"
                                              Text="{Binding FilterSalesman, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Filter by sales representative"/>
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="0">
                                    <TextBlock Text="Customer" Style="{StaticResource GlassFieldLabelStyle}"/>
                                    <ComboBox Style="{StaticResource GlassComboBoxStyle}"
                                              ItemsSource="{Binding Customers}"
                                              Text="{Binding FilterCustomer, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Select the billing customer"/>
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="2">
                                    <TextBlock Text="Project" Style="{StaticResource GlassFieldLabelStyle}"/>
                                    <ComboBox Style="{StaticResource GlassComboBoxStyle}"
                                              ItemsSource="{Binding Projects}"
                                              Text="{Binding FilterProject, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Filter by project reference"/>
                                </StackPanel>

                                <StackPanel Grid.Row="6" Grid.Column="0">
                                    <TextBlock Text="Date From" Style="{StaticResource GlassFieldLabelStyle}"/>
                                    <DatePicker Style="{StaticResource GlassDatePickerStyle}"
                                                SelectedDate="{Binding DateFrom}"
                                                ToolTip="Invoices issued on or after this date"/>
                                </StackPanel>
                                <StackPanel Grid.Row="6" Grid.Column="2">
                                    <TextBlock Text="Date To" Style="{StaticResource GlassFieldLabelStyle}"/>
                                    <DatePicker Style="{StaticResource GlassDatePickerStyle}"
                                                SelectedDate="{Binding DateTo}"
                                                ToolTip="Invoices issued on or before this date"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Column="1"
                                    Width="1"
                                    Background="{DynamicResource OutlineBrush}"
                                    Margin="14,10"
                                    Opacity="0.5"/>

                            <!-- RIGHT: Status chips -->
                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,4">
                                    <Border Width="4" Height="18"
                                            CornerRadius="2"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0"
                                            Background="{StaticResource CyanAccentBar}"/>
                                    <TextBlock Text="INVOICE STATUS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource CyanAccent}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="Select statuses to include"
                                           FontSize="13"
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="0,6,0,16"/>

                                <ItemsControl ItemsSource="{Binding StatusItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked}"
                                                      Cursor="Hand"
                                                      Margin="0,0,8,8"
                                                      FocusVisualStyle="{x:Null}"
                                                      Template="{StaticResource StatusChipTemplate}">
                                                <CheckBox.ToolTip>
                                                    <ToolTip>
                                                        <StackPanel MaxWidth="240">
                                                            <TextBlock Text="{Binding StatusLabel}"
                                                                       FontWeight="Bold"
                                                                       FontSize="12"
                                                                       Foreground="White"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="Click to toggle. Number shows current match count."
                                                                       FontSize="11"
                                                                       Foreground="#CBD5E1"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </CheckBox.ToolTip>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════════════
                     ROW 4 — PDF OPTIONS CARD
                ═══════════════════════════════════════════════════ -->
                <Border Grid.Row="4"
                        Background="{DynamicResource ModuleBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{StaticResource CardBorderThickness}"
                        CornerRadius="20"
                        Padding="0"
                        Effect="{StaticResource CardShadow}"
                        CacheMode="BitmapCache"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal"
                                    Margin="28,24,28,20">
                            <Border Width="44" Height="44"
                                    CornerRadius="12"
                                    VerticalAlignment="Center"
                                    Margin="0,0,16,0"
                                    Background="{StaticResource VioletPinkGradient}"
                                    Effect="{StaticResource VioletIconShadow}"
                                    SnapsToDevicePixels="True">
                                <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"
                                      Fill="White"
                                      Stretch="Uniform"
                                      Width="22" Height="22"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="PDF Generation Options"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Choose what to include in the final merged report"
                                           FontSize="13"
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <UniformGrid Grid.Row="1" Rows="2" Columns="3"
                                     Margin="20,0,20,20">
                            <Border Style="{StaticResource PdfOptionCardStyle}"
                                    ToolTip="Merge tax invoices, delivery notes, proforma invoices">
                                <CheckBox IsChecked="{Binding IncludeAttachments}"
                                          Cursor="Hand"
                                          Padding="18,16"
                                          VerticalContentAlignment="Top">
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="Include Attachments"
                                                   FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="Merge tax invoices &amp; delivery notes"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Style="{StaticResource PdfOptionCardStyle}"
                                    ToolTip="Show delivery note line item details">
                                <CheckBox IsChecked="{Binding IncludeDnDetails}"
                                          Cursor="Hand"
                                          Padding="18,16"
                                          VerticalContentAlignment="Top">
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="DN Line Items"
                                                   FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="Show delivery note details in body"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Style="{StaticResource PdfOptionCardStyle}"
                                    ToolTip="Add ordered-vs-delivered comparison table">
                                <CheckBox IsChecked="{Binding IncludeBalanceAnalysis}"
                                          Cursor="Hand"
                                          Padding="18,16"
                                          VerticalContentAlignment="Top">
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="Balance Analysis"
                                                   FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="Ordered vs delivered comparison"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Style="{StaticResource PdfOptionCardStyle}"
                                    ToolTip="Visual breakdown: 0-30, 31-60, 61-90, 90+ days">
                                <CheckBox IsChecked="{Binding IncludeAgingChart}"
                                          Cursor="Hand"
                                          Padding="18,16"
                                          VerticalContentAlignment="Top">
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="Aging Chart"
                                                   FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="Visual aging bucket breakdown"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Style="{StaticResource PdfOptionCardStyle}"
                                    ToolTip="Add placeholder pages for failed regenerations">
                                <CheckBox IsChecked="{Binding IncludeInsertPlaceholders}"
                                          Cursor="Hand"
                                          Padding="18,16"
                                          VerticalContentAlignment="Top">
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="Insert Placeholders"
                                                   FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="Pages for failed invoice regenerations"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Style="{StaticResource PdfOptionCardStyle}"
                                    ToolTip="Include warnings and alerts summary section">
                                <CheckBox IsChecked="{Binding IncludeWarningsSummary}"
                                          Cursor="Hand"
                                          Padding="18,16"
                                          VerticalContentAlignment="Top">
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="Warnings Summary"
                                                   FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="All alerts and warnings in report"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>