<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Reports/StatementGenerator/StatementGeneratorView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Account Statement / Sales Report (Chat 16)

     UI REDESIGN — Modern Professional Layout:
       • Filter panel: grouped in cards with icons + section dividers
       • Preview rows: card-style with accent left border + hover feel
       • Aging bars: gradient accent strip with rounded mini-cards
       • Header bar: premium gradient accent line under title
       • KPI footer: glass-card style with subtle background tints
       • All CornerRadius=12 on cards, 10 on inputs
       • Consistent 8px grid spacing throughout
       • All bindings UNCHANGED — only visual styling modified
═══════════════════════════════════════════════════════════════════════ -->
<UserControl
    x:Class="ProGlassAutomation.Views.Reports.StatementGenerator.StatementGeneratorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
    FontFamily="Segoe UI"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    TextOptions.TextHintingMode="Fixed"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ── Modern input style (ComboBox + DatePicker containers) ──── -->
        <Style x:Key="FilterLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin" Value="2,0,0,5"/>
        </Style>

        <!-- ── Accent pill button style ─────────────────────────────── -->
        <Style x:Key="AccentPillButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"
                    Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd"
                                        Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd"
                                        Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd"
                                        Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Secondary outline button style ───────────────────────── -->
        <Style x:Key="OutlinePillButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd"
                                        Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="Auto"/>
            <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             ROW 0 — HEADER BAR (premium feel)
        ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SideMenuBackgroundBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3"/>
                    <!-- accent line -->
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="24,12,24,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Back button -->
                    <Button Grid.Column="0"
                            Content="← Back"
                            Command="{Binding CancelCommand}"
                            Padding="16,0"
                            Style="{StaticResource OutlinePillButton}"
                            Foreground="{DynamicResource MutedForegroundBrush}"
                            Margin="0,0,16,0"/>

                    <!-- Title area -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="SALES REPORT"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding PageTitle}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </StackPanel>

                    <!-- Preview button -->
                    <Button Grid.Column="2"
                            Content="🔍  Preview"
                            Command="{Binding PreviewCommand}"
                            Padding="20,0"
                            Style="{StaticResource OutlinePillButton}"
                            Margin="0,0,10,0"/>

                    <!-- Generate PDF button -->
                    <Button Grid.Column="3"
                            Command="{Binding GenerateCommand}"
                            Padding="20,0"
                            Style="{StaticResource AccentPillButton}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄 " FontSize="14"
                                           VerticalAlignment="Center"/>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="13" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text"
                                                    Value="Generate PDF"/>
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsGenerating}"
                                                    Value="True">
                                                    <Setter Property="Text"
                                                            Value="Generating…"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>

                <!-- Accent gradient line under header -->
                <Border Grid.Row="1" CornerRadius="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#4338CA" Offset="0"/>
                            <GradientStop Color="#6366F1" Offset="0.5"/>
                            <GradientStop Color="#8B5CF6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             ROW 1 — MAIN CONTENT
        ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <!-- Filter panel -->
                <ColumnDefinition Width="*"/>
                <!-- Preview panel -->
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: FILTER PANEL ─────────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SideMenuBackgroundBrush}"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource BorderBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,16,16,24">

                        <!-- ─── SEARCH FILTERS CARD ─── -->
                        <Border Background="{DynamicResource ModuleBackgroundBrush}"
                                CornerRadius="12"
                                Padding="16"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <!-- Section header -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,14">
                                    <TextBlock Text="🔍"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="SEARCH FILTERS"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Company -->
                                <TextBlock Text="Company"
                                           Style="{StaticResource FilterLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding Companies}"
                                          Text="{Binding FilterCompany,
                                              UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Height="38" FontSize="12"
                                          Background="{DynamicResource SideMenuBackgroundBrush}"
                                          Foreground="{DynamicResource PrimaryForegroundBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}"
                                          Margin="0,0,0,10"/>

                                <!-- Customer -->
                                <TextBlock Text="Customer"
                                           Style="{StaticResource FilterLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding Customers}"
                                          Text="{Binding FilterCustomer,
                                              UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Height="38" FontSize="12"
                                          Background="{DynamicResource SideMenuBackgroundBrush}"
                                          Foreground="{DynamicResource PrimaryForegroundBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}"
                                          Margin="0,0,0,10"/>

                                <!-- Project -->
                                <TextBlock Text="Project"
                                           Style="{StaticResource FilterLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding Projects}"
                                          Text="{Binding FilterProject,
                                              UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Height="38" FontSize="12"
                                          Background="{DynamicResource SideMenuBackgroundBrush}"
                                          Foreground="{DynamicResource PrimaryForegroundBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}"
                                          Margin="0,0,0,10"/>

                                <!-- Salesman -->
                                <TextBlock Text="Salesman"
                                           Style="{StaticResource FilterLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding Salesmen}"
                                          Text="{Binding FilterSalesman,
                                              UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Height="38" FontSize="12"
                                          Background="{DynamicResource SideMenuBackgroundBrush}"
                                          Foreground="{DynamicResource PrimaryForegroundBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- ─── DATE RANGE CARD ─── -->
                        <Border Background="{DynamicResource ModuleBackgroundBrush}"
                                CornerRadius="12"
                                Padding="16"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,14">
                                    <TextBlock Text="📅"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="DATE RANGE"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="From"
                                                   Style="{StaticResource FilterLabelStyle}"/>
                                        <DatePicker
                                            SelectedDate="{Binding DateFrom}"
                                            Height="38" FontSize="12"
                                            Background="{DynamicResource SideMenuBackgroundBrush}"
                                            Foreground="{DynamicResource PrimaryForegroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="To"
                                                   Style="{StaticResource FilterLabelStyle}"/>
                                        <DatePicker
                                            SelectedDate="{Binding DateTo}"
                                            Height="38" FontSize="12"
                                            Background="{DynamicResource SideMenuBackgroundBrush}"
                                            Foreground="{DynamicResource PrimaryForegroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ─── INVOICE STATUS CARD ─── -->
                        <Border Background="{DynamicResource ModuleBackgroundBrush}"
                                CornerRadius="12"
                                Padding="16"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,12">
                                    <TextBlock Text="📋"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="INVOICE STATUS"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding StatusItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SideMenuBackgroundBrush}"
                                                    CornerRadius="8"
                                                    Padding="10,6"
                                                    Margin="0,0,6,6"
                                                    Cursor="Hand">
                                                <CheckBox IsChecked="{Binding IsChecked}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center">
                                                            <Ellipse.Fill>
                                                                <SolidColorBrush
                                                                    Color="{Binding StatusColor,
                                                                        Converter={StaticResource ColorStringConverter}}"/>
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                        <TextBlock
                                                            Text="{Binding StatusLabel}"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                            VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </CheckBox>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- ─── PDF OPTIONS CARD ─── -->
                        <Border Background="{DynamicResource ModuleBackgroundBrush}"
                                CornerRadius="12"
                                Padding="16"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,12">
                                    <TextBlock Text="⚙"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="PDF OPTIONS"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Include signed documents -->
                                <Border Background="{DynamicResource SideMenuBackgroundBrush}"
                                        CornerRadius="10"
                                        Padding="12,10"
                                        Margin="0,0,0,8">
                                    <CheckBox IsChecked="{Binding IncludeAttachments}"
                                              Cursor="Hand">
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock Text="📎  Include Signed Documents"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                            <TextBlock
                                                Text="Appends signed PI/DN PDFs after statement pages"
                                                FontSize="10"
                                                Foreground="{DynamicResource MutedForegroundBrush}"
                                                Margin="0,2,0,0"
                                                TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </CheckBox>
                                </Border>

                                <!-- Show DN breakdown -->
                                <Border Background="{DynamicResource SideMenuBackgroundBrush}"
                                        CornerRadius="10"
                                        Padding="12,10">
                                    <CheckBox IsChecked="{Binding IncludeDnDetails}"
                                              Cursor="Hand">
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock Text="🚚  Show DN Breakdown"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                            <TextBlock
                                                Text="Expand delivery note rows per invoice"
                                                FontSize="10"
                                                Foreground="{DynamicResource MutedForegroundBrush}"
                                                Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Clear filters button -->
                        <Button Content="✕  Clear All Filters"
                                Command="{Binding ClearFiltersCommand}"
                                Padding="0"
                                Foreground="{DynamicResource MutedForegroundBrush}"
                                Style="{StaticResource OutlinePillButton}"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ── RIGHT: PREVIEW PANEL ───────────────────────────── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Status -->
                    <RowDefinition Height="Auto"/>
                    <!-- Aging strip -->
                    <RowDefinition Height="*"/>
                    <!-- List -->
                    <RowDefinition Height="Auto"/>
                    <!-- KPI footer -->
                </Grid.RowDefinitions>

                <!-- Preview status heading -->
                <Border Grid.Row="0"
                        Padding="20,14">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- ── Aging bars strip ───────────────────────────── -->
                <Border Grid.Row="1"
                        Margin="16,0,16,8"
                        Visibility="{Binding HasPreview,
                            Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding PreviewVM.AgingBars}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="4,0"
                                        Background="{DynamicResource SideMenuBackgroundBrush}"
                                        CornerRadius="10"
                                        Padding="12,10"
                                        BorderThickness="0,3,0,0">
                                    <Border.BorderBrush>
                                        <SolidColorBrush
                                            Color="{Binding Color,
                                                Converter={StaticResource ColorStringConverter}}"/>
                                    </Border.BorderBrush>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding AmountDisplay}"
                                                   FontSize="14" FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush
                                                    Color="{Binding Color,
                                                        Converter={StaticResource ColorStringConverter}}"/>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                        <TextBlock Text="{Binding PercentDisplay}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- ── No preview placeholder ─────────────────────── -->
                <Border Grid.Row="2"
                        Visibility="{Binding HasPreview,
                            Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Background="{DynamicResource SideMenuBackgroundBrush}"
                                CornerRadius="16"
                                Padding="40,32"
                                HorizontalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📊"
                                           FontSize="56"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Set Filters &amp; Preview"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,16,0,6"/>
                                <TextBlock
                                    Text="Select your filter criteria on the left panel,&#x0a;then click Preview to see matching invoices."
                                    FontSize="12"
                                    Foreground="{DynamicResource MutedForegroundBrush}"
                                    HorizontalAlignment="Center"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    MaxWidth="340"
                                    LineHeight="18"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ── Preview invoice list (virtualized) ─────────── -->
                <ListView
                    Grid.Row="2"
                    ItemsSource="{Binding PreviewVM.Rows}"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalContentAlignment="Stretch"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    ScrollViewer.CanContentScroll="False"
                    ScrollViewer.IsDeferredScrollingEnabled="False"
                    behaviors:SmoothScrollBehavior.IsEnabled="True"
                    Margin="16,4,16,4"
                    Visibility="{Binding HasPreview,
                        Converter={StaticResource BoolToVisibilityConverter}}">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <!-- Card with accent left border -->
                            <Border Background="{DynamicResource SideMenuBackgroundBrush}"
                                    CornerRadius="10"
                                    Padding="0"
                                    BorderThickness="3,0,0,0">
                                <Border.BorderBrush>
                                    <SolidColorBrush
                                        Color="{Binding StatusColor,
                                            Converter={StaticResource ColorStringConverter}}"/>
                                </Border.BorderBrush>

                                <Grid Margin="14,10,14,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Invoice identity -->
                                    <StackPanel Grid.Column="0"
                                                VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Text="{Binding InvoiceNumber}"
                                                FontSize="13" FontWeight="Bold"
                                                Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="  ·  "
                                                       FontSize="12"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            <TextBlock
                                                Text="{Binding IssueDateDisplay}"
                                                FontSize="12"
                                                Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,3,0,0">
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource MutedForegroundBrush}">
                                                <Run Text="PI: "/>
                                                <Run Text="{Binding ProformaId}"/>
                                            </TextBlock>
                                            <TextBlock Text="  ·  DN: "
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            <TextBlock
                                                Text="{Binding DeliveryNoteRef}"
                                                FontSize="11"
                                                Foreground="{DynamicResource MutedForegroundBrush}"
                                                MaxWidth="160"
                                                TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <!-- Overdue badge -->
                                        <TextBlock
                                            Text="{Binding DaysOverdueDisplay}"
                                            FontSize="10" FontWeight="Bold"
                                            Foreground="#B91C1C"
                                            Margin="0,2,0,0"
                                            Visibility="{Binding IsOverdue,
                                                Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <!-- Grand Total -->
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="16,0">
                                        <TextBlock Text="TOTAL"
                                                   FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock
                                            Text="{Binding GrandTotalDisplay}"
                                            FontSize="13" FontWeight="Bold"
                                            Foreground="{DynamicResource PrimaryForegroundBrush}"
                                            HorizontalAlignment="Right"
                                            Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Balance -->
                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Margin="8,0,16,0"
                                                MinWidth="90">
                                        <TextBlock Text="BALANCE"
                                                   FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock
                                            Text="{Binding BalanceDisplay}"
                                            FontSize="13" FontWeight="Bold"
                                            HorizontalAlignment="Right"
                                            Margin="0,2,0,0">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush
                                                    Color="{Binding BalanceColor,
                                                        Converter={StaticResource ColorStringConverter}}"/>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Status pill -->
                                    <Border Grid.Column="3"
                                            CornerRadius="8"
                                            Padding="10,5"
                                            VerticalAlignment="Center"
                                            MinWidth="56"
                                            HorizontalAlignment="Center">
                                        <Border.Background>
                                            <SolidColorBrush
                                                Color="{Binding StatusColor,
                                                    Converter={StaticResource ColorStringConverter}}"
                                                Opacity="0.15"/>
                                        </Border.Background>
                                        <TextBlock
                                            Text="{Binding Status}"
                                            FontSize="10" FontWeight="Bold"
                                            HorizontalAlignment="Center">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush
                                                    Color="{Binding StatusColor,
                                                        Converter={StaticResource ColorStringConverter}}"/>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- ── KPI FOOTER ─────────────────────────────────── -->
                <Border Grid.Row="3"
                        Background="{DynamicResource SideMenuBackgroundBrush}"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Padding="20,14"
                        Visibility="{Binding HasPreview,
                            Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Total Invoiced -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource TintIndigoBrush}"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="TOTAL INVOICED"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <TextBlock
                                    Text="{Binding PreviewVM.TotalInvoicedDisplay}"
                                    FontSize="15" FontWeight="Bold"
                                    Foreground="{DynamicResource AccentBrush}"
                                    Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- VAT -->
                        <Border Grid.Column="1"
                                Background="{DynamicResource ModuleBackgroundBrush}"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="3,0">
                            <StackPanel>
                                <TextBlock Text="VAT (5%)"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <TextBlock
                                    Text="{Binding PreviewVM.TotalVatDisplay}"
                                    FontSize="15" FontWeight="Bold"
                                    Foreground="{DynamicResource PrimaryForegroundBrush}"
                                    Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Outstanding -->
                        <Border Grid.Column="2"
                                Background="{DynamicResource TintAmberBrush}"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="3,0">
                            <StackPanel>
                                <TextBlock Text="OUTSTANDING"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <TextBlock
                                    Text="{Binding PreviewVM.TotalOutstandingDisplay}"
                                    FontSize="15" FontWeight="Bold"
                                    Foreground="#B45309"
                                    Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Overdue -->
                        <Border Grid.Column="3"
                                Background="{DynamicResource TintRedBrush}"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="OVERDUE"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                <TextBlock
                                    Text="{Binding PreviewVM.OverdueAmountDisplay}"
                                    FontSize="15" FontWeight="Bold"
                                    Foreground="#B91C1C"
                                    Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════
             ROW 2 — STATUS BAR (minimal, professional)
        ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource SideMenuBackgroundBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderBrush}"
                Padding="24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="11"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Processing indicator -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Visibility="{Binding IsLoading,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="⏳" FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBlock Text="Processing…"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>