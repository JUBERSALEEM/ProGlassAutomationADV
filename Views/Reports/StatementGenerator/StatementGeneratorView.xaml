<UserControl
    x:Class="ProGlassAutomation.Views.Reports.StatementGenerator.StatementGeneratorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
    FontFamily="Segoe UI"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    TextOptions.TextHintingMode="Fixed"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <UserControl.Resources>

        <Style x:Key="FilterLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin" Value="2,0,0,5"/>
        </Style>

        <Style x:Key="FilterCardStyle" TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Width" Value="270"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Filter Drawer -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="Auto"/>
            <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             ROW 0 — RICH INDIGO HEADER
        ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="#3730A3"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- BACK — White pill, indigo text, maximum contrast -->
                <Button Grid.Column="0"
                        Command="{Binding CancelCommand}"
                        Height="42"
                        Padding="18,0"
                        Cursor="Hand"
                        BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd"
                                    Background="White"
                                    CornerRadius="12"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="←"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#3730A3"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="BACK"
                                               FontSize="12"
                                               FontWeight="Black"
                                               Foreground="#3730A3"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd"
                                            Property="Background"
                                            Value="#E0E7FF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd"
                                            Property="Background"
                                            Value="#C7D2FE"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Title -->
                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center">
                    <TextBlock Text="SALES REPORT"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#A5B4FC"
                               Margin="0,0,0,3"/>
                    <TextBlock Text="{Binding PageTitle}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"/>
                </StackPanel>

                <!-- FILTERS hamburger toggle — Amber -->
                <ToggleButton x:Name="FilterMenuToggle"
                              Grid.Column="3"
                              Height="42"
                              Padding="18,0"
                              Cursor="Hand"
                              BorderThickness="0">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="bd"
                                    Background="#B45309"
                                    CornerRadius="12"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="☰"
                                               FontSize="16"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="White"/>
                                                <Style.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding IsChecked,
                                                            RelativeSource={RelativeSource
                                                                AncestorType=ToggleButton}}"
                                                        Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="#B45309"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="FILTERS"
                                               FontSize="12"
                                               FontWeight="Black"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="White"/>
                                                <Style.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding IsChecked,
                                                            RelativeSource={RelativeSource
                                                                AncestorType=ToggleButton}}"
                                                        Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="#B45309"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd"
                                            Property="Opacity" Value="0.88"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd"
                                            Property="Opacity" Value="0.75"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd"
                                            Property="Background" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <!-- PREVIEW — Indigo -->
                <Button Grid.Column="5"
                        Command="{Binding PreviewCommand}"
                        Height="42"
                        Padding="22,0"
                        Cursor="Hand"
                        BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd"
                                    Background="#4338CA"
                                    BorderBrush="#6366F1"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="{TemplateBinding Padding}">
                                <TextBlock Text="PREVIEW"
                                           FontSize="12"
                                           FontWeight="Black"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd"
                                            Property="Background"
                                            Value="#4F46E5"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd"
                                            Property="Opacity" Value="0.8"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd"
                                            Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- GENERATE PDF — Green -->
                <Button Grid.Column="7"
                        Command="{Binding GenerateCommand}"
                        Height="42"
                        Padding="22,0"
                        Cursor="Hand"
                        BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd"
                                    Background="#047857"
                                    CornerRadius="12"
                                    Padding="{TemplateBinding Padding}">
                                <TextBlock FontSize="12"
                                           FontWeight="Black"
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text"
                                                    Value="GENERATE PDF"/>
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsGenerating}"
                                                    Value="True">
                                                    <Setter Property="Text"
                                                            Value="GENERATING..."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd"
                                            Property="Background"
                                            Value="#059669"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd"
                                            Property="Opacity" Value="0.8"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd"
                                            Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             ROW 1 — FILTER DRAWER (hamburger expand/collapse)
             Visibility driven by FilterMenuToggle.IsChecked
             No ViewModel changes needed.
        ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{DynamicResource SideMenuBackgroundBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush}"
                Visibility="{Binding IsChecked,
                    ElementName=FilterMenuToggle,
                    Converter={StaticResource BoolToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="400">
                <StackPanel Margin="16,16,16,12">

                    <!-- ALL 4 FILTER CARDS IN A WRAP PANEL -->
                    <WrapPanel>

                        <!-- SEARCH FILTERS CARD -->
                        <Border Style="{StaticResource FilterCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Background="#4338CA"
                                        CornerRadius="12,12,0,0"/>
                                <Border Grid.Row="1"
                                        Padding="14,14,14,14">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,0,0,14">
                                            <Border Width="28" Height="28"
                                                    Background="#4338CA"
                                                    CornerRadius="7"
                                                    Margin="0,0,10,0">
                                                <TextBlock Text="⌕"
                                                           FontSize="13"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="SEARCH FILTERS"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="#4338CA"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Text="Company"
                                                   Style="{StaticResource FilterLabelStyle}"/>
                                        <ComboBox
                                            ItemsSource="{Binding Companies}"
                                            Text="{Binding FilterCompany,
                                                UpdateSourceTrigger=PropertyChanged}"
                                            IsEditable="True"
                                            Height="38" FontSize="12"
                                            Background="{DynamicResource SideMenuBackgroundBrush}"
                                            Foreground="{DynamicResource PrimaryForegroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            Margin="0,0,0,10"/>

                                        <TextBlock Text="Customer"
                                                   Style="{StaticResource FilterLabelStyle}"/>
                                        <ComboBox
                                            ItemsSource="{Binding Customers}"
                                            Text="{Binding FilterCustomer,
                                                UpdateSourceTrigger=PropertyChanged}"
                                            IsEditable="True"
                                            Height="38" FontSize="12"
                                            Background="{DynamicResource SideMenuBackgroundBrush}"
                                            Foreground="{DynamicResource PrimaryForegroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            Margin="0,0,0,10"/>

                                        <TextBlock Text="Project"
                                                   Style="{StaticResource FilterLabelStyle}"/>
                                        <ComboBox
                                            ItemsSource="{Binding Projects}"
                                            Text="{Binding FilterProject,
                                                UpdateSourceTrigger=PropertyChanged}"
                                            IsEditable="True"
                                            Height="38" FontSize="12"
                                            Background="{DynamicResource SideMenuBackgroundBrush}"
                                            Foreground="{DynamicResource PrimaryForegroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            Margin="0,0,0,10"/>

                                        <TextBlock Text="Salesman"
                                                   Style="{StaticResource FilterLabelStyle}"/>
                                        <ComboBox
                                            ItemsSource="{Binding Salesmen}"
                                            Text="{Binding FilterSalesman,
                                                UpdateSourceTrigger=PropertyChanged}"
                                            IsEditable="True"
                                            Height="38" FontSize="12"
                                            Background="{DynamicResource SideMenuBackgroundBrush}"
                                            Foreground="{DynamicResource PrimaryForegroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- DATE RANGE CARD -->
                        <Border Style="{StaticResource FilterCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Background="#B45309"
                                        CornerRadius="12,12,0,0"/>
                                <Border Grid.Row="1"
                                        Padding="14,14,14,14">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,0,0,14">
                                            <Border Width="28" Height="28"
                                                    Background="#B45309"
                                                    CornerRadius="7"
                                                    Margin="0,0,10,0">
                                                <TextBlock Text="≋"
                                                           FontSize="14"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="DATE RANGE"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="#B45309"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="From"
                                                           Style="{StaticResource FilterLabelStyle}"/>
                                                <DatePicker
                                                    SelectedDate="{Binding DateFrom}"
                                                    Height="38" FontSize="12"
                                                    Background="{DynamicResource SideMenuBackgroundBrush}"
                                                    Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="To"
                                                           Style="{StaticResource FilterLabelStyle}"/>
                                                <DatePicker
                                                    SelectedDate="{Binding DateTo}"
                                                    Height="38" FontSize="12"
                                                    Background="{DynamicResource SideMenuBackgroundBrush}"
                                                    Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- INVOICE STATUS CARD -->
                        <Border Style="{StaticResource FilterCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Background="#047857"
                                        CornerRadius="12,12,0,0"/>
                                <Border Grid.Row="1"
                                        Padding="14,14,14,14">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,0,0,12">
                                            <Border Width="28" Height="28"
                                                    Background="#047857"
                                                    CornerRadius="7"
                                                    Margin="0,0,10,0">
                                                <TextBlock Text="≡"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="INVOICE STATUS"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="#047857"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <ItemsControl
                                            ItemsSource="{Binding StatusItems}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Background="{DynamicResource SideMenuBackgroundBrush}"
                                                        CornerRadius="8"
                                                        Padding="10,6"
                                                        Margin="0,0,6,6"
                                                        Cursor="Hand">
                                                        <CheckBox
                                                            IsChecked="{Binding IsChecked}">
                                                            <StackPanel
                                                                Orientation="Horizontal">
                                                                <Ellipse
                                                                    Width="8"
                                                                    Height="8"
                                                                    Margin="0,0,6,0"
                                                                    VerticalAlignment="Center">
                                                                    <Ellipse.Fill>
                                                                        <SolidColorBrush
                                                                            Color="{Binding StatusColor,
                                                                                Converter={StaticResource ColorStringConverter}}"/>
                                                                    </Ellipse.Fill>
                                                                </Ellipse>
                                                                <TextBlock
                                                                    Text="{Binding StatusLabel}"
                                                                    FontSize="11"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                    VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- PDF OPTIONS CARD -->
                        <Border Style="{StaticResource FilterCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Background="#B91C1C"
                                        CornerRadius="12,12,0,0"/>
                                <Border Grid.Row="1"
                                        Padding="14,14,14,14">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,0,0,12">
                                            <Border Width="28" Height="28"
                                                    Background="#B91C1C"
                                                    CornerRadius="7"
                                                    Margin="0,0,10,0">
                                                <TextBlock Text="⚙"
                                                           FontSize="13"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="PDF OPTIONS"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="#B91C1C"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Border
                                            Background="{DynamicResource SideMenuBackgroundBrush}"
                                            CornerRadius="10"
                                            Padding="12,10"
                                            Margin="0,0,0,8">
                                            <CheckBox
                                                IsChecked="{Binding IncludeAttachments}"
                                                Cursor="Hand">
                                                <StackPanel Margin="4,0,0,0">
                                                    <TextBlock
                                                        Text="Include Signed Documents"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                    <TextBlock
                                                        Text="Appends signed PI/DN PDFs after statement pages"
                                                        FontSize="10"
                                                        Foreground="{DynamicResource MutedForegroundBrush}"
                                                        Margin="0,2,0,0"
                                                        TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </Border>

                                        <Border
                                            Background="{DynamicResource SideMenuBackgroundBrush}"
                                            CornerRadius="10"
                                            Padding="12,10">
                                            <CheckBox
                                                IsChecked="{Binding IncludeDnDetails}"
                                                Cursor="Hand">
                                                <StackPanel Margin="4,0,0,0">
                                                    <TextBlock
                                                        Text="Show DN Breakdown"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                    <TextBlock
                                                        Text="Expand delivery note rows per invoice"
                                                        FontSize="10"
                                                        Foreground="{DynamicResource MutedForegroundBrush}"
                                                        Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </WrapPanel>

                    <!-- CLEAR FILTERS -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,4,0,4">
                        <Button Command="{Binding ClearFiltersCommand}"
                                Height="40"
                                Padding="20,0"
                                Cursor="Hand"
                                BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            Background="#B91C1C"
                                            CornerRadius="10"
                                            Padding="{TemplateBinding Padding}">
                                        <TextBlock
                                            Text="✕  Clear All Filters"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="bd"
                                                    Property="Opacity"
                                                    Value="0.88"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed"
                                                 Value="True">
                                            <Setter TargetName="bd"
                                                    Property="Opacity"
                                                    Value="0.75"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             ROW 2 — PREVIEW CONTENT (full width)
        ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Status heading -->
                <RowDefinition Height="Auto"/>
                <!-- Aging bars -->
                <RowDefinition Height="*"/>
                <!-- Empty state / List -->
                <RowDefinition Height="Auto"/>
                <!-- KPI footer -->
            </Grid.RowDefinitions>

            <!-- Status heading -->
            <Border Grid.Row="0" Padding="20,14">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- AGING BARS — D1: PercentDisplay restored -->
            <Border Grid.Row="1"
                    Margin="16,0,16,8"
                    Visibility="{Binding HasPreview,
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding PreviewVM.AgingBars}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4,0"
                                    CornerRadius="10"
                                    Padding="12,10">
                                <Border.Background>
                                    <SolidColorBrush
                                        Color="{Binding Color,
                                            Converter={StaticResource ColorStringConverter}}"/>
                                </Border.Background>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               Opacity="0.85"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding AmountDisplay}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                    <!-- D1: PercentDisplay RESTORED -->
                                    <TextBlock Text="{Binding PercentDisplay}"
                                               FontSize="10"
                                               Foreground="White"
                                               Opacity="0.7"
                                               HorizontalAlignment="Center"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- EMPTY STATE -->
            <Border Grid.Row="2"
                    Visibility="{Binding HasPreview,
                        Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border
                        Background="{DynamicResource SideMenuBackgroundBrush}"
                        CornerRadius="16"
                        Padding="48,36"
                        HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="80" Height="80"
                                    CornerRadius="18"
                                    ClipToBounds="True"
                                    HorizontalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0"
                                            Background="#4338CA"/>
                                    <Border Grid.Row="0" Grid.Column="1"
                                            Background="#047857"/>
                                    <Border Grid.Row="1" Grid.Column="0"
                                            Background="#B45309"/>
                                    <Border Grid.Row="1" Grid.Column="1"
                                            Background="#B91C1C"/>
                                </Grid>
                            </Border>

                            <TextBlock
                                Text="Set Filters and Preview"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="{DynamicResource PrimaryForegroundBrush}"
                                HorizontalAlignment="Center"
                                Margin="0,20,0,8"/>
                            <TextBlock
                                Text="Click FILTERS above, choose your criteria,&#x0a;then press PREVIEW to see matching invoices."
                                FontSize="12"
                                Foreground="{DynamicResource MutedForegroundBrush}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                MaxWidth="360"
                                LineHeight="18"
                                HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- PREVIEW LIST — all settings + D2/D3/D4/D5/D6/D7/D8 restored -->
            <ListView Grid.Row="2"
                      ItemsSource="{Binding PreviewVM.Rows}"
                      Background="Transparent"
                      BorderThickness="0"
                      HorizontalContentAlignment="Stretch"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="False"
                      ScrollViewer.IsDeferredScrollingEnabled="False"
                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                      Margin="16,4,16,4"
                      Visibility="{Binding HasPreview,
                          Converter={StaticResource BoolToVisibilityConverter}}">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>
                        <Setter Property="Background"
                                Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <!-- D5: FocusVisualStyle restored -->
                        <Setter Property="FocusVisualStyle"
                                Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Background="{DynamicResource SideMenuBackgroundBrush}"
                            CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BorderBrush}"
                            ClipToBounds="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="BorderBrush"
                                                    Value="#4338CA"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left accent bar -->
                                <Border Grid.Column="0"
                                        CornerRadius="10,0,0,10">
                                    <Border.Background>
                                        <SolidColorBrush
                                            Color="{Binding StatusColor,
                                                Converter={StaticResource ColorStringConverter}}"/>
                                    </Border.Background>
                                </Border>

                                <!-- D2 + D3 + D4: Invoice info FULLY RESTORED -->
                                <Border Grid.Column="1"
                                        Padding="14,10,14,10">
                                    <StackPanel VerticalAlignment="Center">

                                        <!-- Row 1: Number + Date -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Text="{Binding InvoiceNumber}"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="#4338CA"/>
                                            <TextBlock
                                                Text="  ·  "
                                                FontSize="12"
                                                Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            <!-- D4: IssueDateDisplay RESTORED -->
                                            <TextBlock
                                                Text="{Binding IssueDateDisplay}"
                                                FontSize="12"
                                                Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        </StackPanel>

                                        <!-- D2: PI + DN reference RESTORED -->
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,3,0,0">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource MutedForegroundBrush}">
                                                <Run Text="PI: "/>
                                                <Run Text="{Binding ProformaId}"/>
                                            </TextBlock>
                                            <TextBlock
                                                Text="  ·  DN: "
                                                FontSize="11"
                                                Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            <TextBlock
                                                Text="{Binding DeliveryNoteRef}"
                                                FontSize="11"
                                                Foreground="{DynamicResource MutedForegroundBrush}"
                                                MaxWidth="200"
                                                TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- D3: Overdue badge RESTORED -->
                                        <Border
                                            Background="#B91C1C"
                                            CornerRadius="5"
                                            Padding="6,2"
                                            Margin="0,4,0,0"
                                            HorizontalAlignment="Left"
                                            Visibility="{Binding IsOverdue,
                                                Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock
                                                Text="{Binding DaysOverdueDisplay}"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- TOTAL — solid green -->
                                <Border Grid.Column="2"
                                        Background="#047857"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        Margin="0,8,6,8"
                                        VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="#6EE7B7"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock
                                            Text="{Binding GrandTotalDisplay}"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            HorizontalAlignment="Right"
                                            Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- BALANCE — solid amber -->
                                <Border Grid.Column="3"
                                        Background="#B45309"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        Margin="0,8,6,8"
                                        VerticalAlignment="Center"
                                        MinWidth="90">
                                    <StackPanel>
                                        <TextBlock Text="BALANCE"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="#FCD34D"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock
                                            Text="{Binding BalanceDisplay}"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            HorizontalAlignment="Right"
                                            Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- STATUS PILL -->
                                <Border Grid.Column="4"
                                        CornerRadius="8"
                                        Padding="10,5"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0"
                                        MinWidth="70"
                                        HorizontalAlignment="Center">
                                    <Border.Background>
                                        <SolidColorBrush
                                            Color="{Binding StatusColor,
                                                Converter={StaticResource ColorStringConverter}}"/>
                                    </Border.Background>
                                    <TextBlock
                                        Text="{Binding Status}"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- KPI FOOTER -->
            <Border Grid.Row="3"
                    Background="{DynamicResource SideMenuBackgroundBrush}"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Padding="16,12"
                    Visibility="{Binding HasPreview,
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#4338CA"
                            CornerRadius="10"
                            Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="TOTAL INVOICED"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="#A5B4FC"/>
                            <TextBlock
                                Text="{Binding PreviewVM.TotalInvoicedDisplay}"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="White"
                                Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="#3730A3"
                            CornerRadius="10"
                            Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="VAT (5%)"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="#A5B4FC"/>
                            <TextBlock
                                Text="{Binding PreviewVM.TotalVatDisplay}"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="White"
                                Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4"
                            Background="#B45309"
                            CornerRadius="10"
                            Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="OUTSTANDING"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="#FCD34D"/>
                            <TextBlock
                                Text="{Binding PreviewVM.TotalOutstandingDisplay}"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="White"
                                Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6"
                            Background="#B91C1C"
                            CornerRadius="10"
                            Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="OVERDUE"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="#FCA5A5"/>
                            <TextBlock
                                Text="{Binding PreviewVM.OverdueAmountDisplay}"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="White"
                                Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ══ ROW 3 — STATUS BAR ══ -->
        <Border Grid.Row="3"
                Background="#3730A3"
                Padding="24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="11"
                           Foreground="#C7D2FE"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Visibility="{Binding IsLoading,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="↻"
                               FontSize="13"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBlock Text="Processing..."
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>