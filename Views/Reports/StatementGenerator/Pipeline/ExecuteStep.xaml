<!-- ═══════════════════════════════════════════════════════════════
     FILE: Views/Reports/StatementGenerator/Pipeline/ExecuteStep.xaml
     PROJECT: ProGlassAutomation
     MODULE: Statement Generator — Wizard Step 3: EXECUTE (Chat 22 v5.2 — Glass UI Verified)

     CHAT 22 v5.2 CHANGES (analysis-driven):
       BUG FIX:
         ✓ {Binding Step} → {Binding Order} (was showing enum name
           like "ReadProformaInvoice" instead of "1")

       STYLE OVERHAUL:
         ✓ Neo-glassmorphism matching FilterStep
         ✓ Ambient gradient + blobs behind everything
         ✓ Frozen brushes/gradients/effects (all)
         ✓ Shared PipelineStepStyle (was inline × 8 clones)
         ✓ Shared PipelineStepBadgeStyle (was inline × 8 clones)
         ✓ BitmapCache on Progress card + Warning column
         ✓ Terminal preserved (dark aesthetic, NOT cached)

       PRESERVED (verified against original):
         ✓ x:Name="TerminalLogScroller" (code-behind uses this)
         ✓ x:Name="TerminalLogItems" (safety — preserved)
         ✓ All bindings unchanged (verified against models):
           - LastWorkflowStatusText, LastWorkflowProgressDisplay
           - LastWorkflowProgressPercent, LastWorkflowSteps
           - ProcessingLog (LogEntry.Text, SeverityColor, FontWeightDisplay)
           - WorkflowWarnings (Title, Detail, AmountDisplay, ActionLabel,
             TitleColorHex, AmountColorHex, ActionColorHex, BackgroundBrushKey)
           - WarningSummaryDisplay
           - OrderedQtyDisplay, DeliveredQtyDisplay, BalanceQtyDisplay,
             DeliveryRateDisplay
         ✓ SmoothScrollBehavior on all 3 ScrollViewers
         ✓ Terminal MultiBinding for progress bar width preserved
         ✓ Converters used: ColorStringConverter, BrushKeyConverter,
           PercentToWidthConverter (all verified exist)

     DESIGN PATTERN: Neo-Glassmorphism (matches FilterStep)
═══════════════════════════════════════════════════════════════ -->
<UserControl
    x:Class="ProGlassAutomation.Views.Reports.StatementGenerator.Pipeline.ExecuteStep"
             TextOptions.TextHintingMode="Fixed"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels.Reports.StatementGenerator"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:StatementGeneratorViewModel, IsDesignTimeCreatable=False}"
    FontFamily="{DynamicResource AppFontFamily}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    RenderOptions.BitmapScalingMode="HighQuality"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ══════════════════════════════════════════════════════════
             FROZEN BRUSHES
        ══════════════════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="GlassCardBg" Color="#FFFFFF" Opacity="0.72" po:Freeze="True"/>
        <SolidColorBrush x:Key="GlassCardBorder" Color="#FFFFFF" Opacity="0.8" po:Freeze="True"/>

        <SolidColorBrush x:Key="IndigoPrimary" Color="{DynamicResource AccentColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="VioletAccent" Color="#8B5CF6" po:Freeze="True"/>
        <SolidColorBrush x:Key="EmeraldAccent" Color="{DynamicResource AccentLightColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="AmberAccent" Color="{DynamicResource WarningColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="RedAccent" Color="{DynamicResource DangerColor}" po:Freeze="True"/>

        <SolidColorBrush x:Key="TextPrimary" Color="{DynamicResource PrimaryForegroundColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource SecondaryForegroundColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="TextMuted" Color="{DynamicResource MutedForegroundColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="{DynamicResource BorderColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="ProgressTrack" Color="{DynamicResource BorderColor}" po:Freeze="True"/>

        <!-- Terminal palette (stays dark) -->
        <SolidColorBrush x:Key="TerminalBg" Color="{DynamicResource PrimaryForegroundColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="TerminalTitle" Color="{DynamicResource MutedForegroundColor}" po:Freeze="True"/>

        <!-- Step status backgrounds -->
        <SolidColorBrush x:Key="StepIdleBg" Color="{DynamicResource TintGrayColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="StepSuccessBg" Color="{DynamicResource TintGreenColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="StepSuccessBorder" Color="#BBF7D0" po:Freeze="True"/>
        <SolidColorBrush x:Key="StepWarningBg" Color="{DynamicResource TintAmberColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="StepWarningBorder" Color="#FDE68A" po:Freeze="True"/>
        <SolidColorBrush x:Key="StepBlockedBg" Color="{DynamicResource TintRedColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="StepBlockedBorder" Color="#FECACA" po:Freeze="True"/>
        <SolidColorBrush x:Key="StepRunningBg" Color="{DynamicResource TintPurpleColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="StepBadgeIdle" Color="{DynamicResource MutedForegroundColor}" po:Freeze="True"/>

        <!-- Metric accents -->
        <SolidColorBrush x:Key="MetricOrdered" Color="{DynamicResource AccentColor}"/>
        <SolidColorBrush x:Key="MetricDelivered" Color="{DynamicResource AccentColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="MetricBalance" Color="{DynamicResource DangerColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="MetricRate" Color="{DynamicResource WarningColor}" po:Freeze="True"/>

        <SolidColorBrush x:Key="WarnBadgeBg" Color="{DynamicResource WarningColor}" po:Freeze="True"/>

        <!-- ══════════════════════════════════════════════════════════
             FROZEN GRADIENTS
        ══════════════════════════════════════════════════════════ -->
        <LinearGradientBrush x:Key="AmbientBg" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
            <GradientStop Color="{DynamicResource TintGrayColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource TintIndigoColor}" Offset="0.5"/>
            <GradientStop Color="#F0F9FF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ProgressGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
            <GradientStop Color="#8B5CF6" Offset="0.5"/>
            <GradientStop Color="#EC4899" Offset="1"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="VioletBlob" po:Freeze="True">
            <GradientStop Color="#8B5CF6" Offset="0"/>
            <GradientStop Color="Transparent" Offset="1"/>
        </RadialGradientBrush>

        <RadialGradientBrush x:Key="CyanBlob" po:Freeze="True">
            <GradientStop Color="#06B6D4" Offset="0"/>
            <GradientStop Color="Transparent" Offset="1"/>
        </RadialGradientBrush>

        <RadialGradientBrush x:Key="GreenLed" po:Freeze="True">
            <GradientStop Color="#34D399" Offset="0"/>
            <GradientStop Color="{DynamicResource AccentLightColor}" Offset="1"/>
        </RadialGradientBrush>

        <!-- ══════════════════════════════════════════════════════════
             FROZEN EFFECTS
        ══════════════════════════════════════════════════════════ -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="32" ShadowDepth="8"
                          Opacity="0.08" Color="#1E1B4B"
                          po:Freeze="True"/>

        <DropShadowEffect x:Key="ProgressCardShadow"
                          BlurRadius="24" ShadowDepth="4"
                          Opacity="0.08" Color="{DynamicResource AccentColor}"
                          po:Freeze="True"/>

        <DropShadowEffect x:Key="GreenLedGlow"
                          BlurRadius="8" ShadowDepth="0"
                          Opacity="0.6" Color="{DynamicResource AccentLightColor}"
                          po:Freeze="True"/>

        <DropShadowEffect x:Key="RunningStepGlow"
                          BlurRadius="10" ShadowDepth="0"
                          Opacity="0.3" Color="#8B5CF6"
                          po:Freeze="True"/>

        <!-- ══════════════════════════════════════════════════════════
             SHARED PIPELINE STEP STYLE (was inline × 8)
        ══════════════════════════════════════════════════════════ -->
        <Style x:Key="PipelineStepStyle" TargetType="Border">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="{StaticResource StepIdleBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                    <Setter Property="Background" Value="{StaticResource StepSuccessBg}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StepSuccessBorder}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                    <Setter Property="Background" Value="{StaticResource StepWarningBg}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StepWarningBorder}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                    <Setter Property="Background" Value="{StaticResource StepBlockedBg}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StepBlockedBorder}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Background" Value="{StaticResource StepRunningBg}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource VioletAccent}"/>
                    <Setter Property="Effect" Value="{StaticResource RunningStepGlow}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Shared step badge style -->
        <Style x:Key="PipelineStepBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource StepBadgeIdle}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                    <Setter Property="Background" Value="{StaticResource EmeraldAccent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AmberAccent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                    <Setter Property="Background" Value="{StaticResource RedAccent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Background" Value="{StaticResource VioletAccent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Metric card style -->
        <Style x:Key="MetricCardStyleGlass" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="MinHeight" Value="90"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         ROOT — Glass background with ambient blobs
    ═══════════════════════════════════════════════════════════════ -->
    <Grid Background="{StaticResource AmbientBg}">

        <!-- Ambient blobs (cached, behind everything) -->
        <Canvas Panel.ZIndex="-1"
                IsHitTestVisible="False"
                CacheMode="BitmapCache"
                ClipToBounds="True">
            <Ellipse Canvas.Left="-100" Canvas.Top="-100"
                     Width="500" Height="500"
                     Opacity="0.35"
                     Fill="{StaticResource VioletBlob}"/>
            <Ellipse Canvas.Right="-150" Canvas.Top="250"
                     Width="600" Height="600"
                     Opacity="0.25"
                     Fill="{StaticResource CyanBlob}"/>
        </Canvas>

        <Grid Margin="40,32,40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Page header -->
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <!-- Progress card -->
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
                <!-- 3-column layout -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════
                 ROW 0 — PAGE HEADER (matches FilterStep pattern)
            ═══════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border Width="6" Height="6"
                            Background="{StaticResource IndigoPrimary}"
                            CornerRadius="3"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"/>
                    <TextBlock Text="STEP 3 OF 4"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource IndigoPrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Execute Pipeline"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="8-step workflow processing your data in real-time. Watch each step complete and review live output below."
                           FontSize="14"
                           Foreground="{StaticResource TextSecondary}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════
                 ROW 2 — PROGRESS CARD
                 CACHED: content only changes on status/percent update
            ═══════════════════════════════════════════════════════ -->
            <Border Grid.Row="2"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="24,20"
                    Effect="{StaticResource ProgressCardShadow}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Width="12" Height="12"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{StaticResource GreenLed}"
                                Effect="{StaticResource GreenLedGlow}"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding LastWorkflowStatusText}"
                                   FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="{Binding LastWorkflowProgressDisplay}"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource VioletAccent}"
                               VerticalAlignment="Center"/>

                    <!-- Progress bar — MultiBinding preserved from original -->
                    <Border Grid.Row="2" Grid.ColumnSpan="3"
                            Height="10" CornerRadius="5"
                            Background="{StaticResource ProgressTrack}"
                            ClipToBounds="True"
                            SnapsToDevicePixels="True">
                        <Border HorizontalAlignment="Left"
                                CornerRadius="5"
                                Background="{StaticResource ProgressGradient}">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                    <Binding Path="LastWorkflowProgressPercent"/>
                                    <Binding Path="ActualWidth"
                                             RelativeSource="{RelativeSource AncestorType=Border}"/>
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════
                 ROW 4 — 3-COLUMN LAYOUT
            ═══════════════════════════════════════════════════════ -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <!-- ═══ COLUMN 1: PIPELINE STEPS (glass card) ═══ -->
                <Border Grid.Column="0"
                        Background="{DynamicResource ModuleBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="20"
                        Effect="{StaticResource CardShadow}"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal"
                                    Margin="0,0,0,16">
                            <Border Width="4" Height="18"
                                    CornerRadius="2"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0"
                                    Background="{StaticResource IndigoPrimary}"/>
                            <TextBlock Text="PIPELINE STEPS"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource IndigoPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsDeferredScrollingEnabled="False"
                                      behaviors:SmoothScrollBehavior.IsEnabled="True">
                            <ItemsControl ItemsSource="{Binding LastWorkflowSteps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource PipelineStepStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Style="{StaticResource PipelineStepBadgeStyle}">
                                                    <TextBlock Text="{Binding StatusIcon}"
                                                               FontSize="14" FontWeight="Bold"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center">
                                                    <!-- BUG FIX: Order (int) instead of Step (enum) -->
                                                    <TextBlock FontSize="12" FontWeight="Bold"
                                                               Foreground="{StaticResource TextPrimary}">
                                                        <Run Text="Step "/>
                                                        <Run Text="{Binding Order, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Title, Mode=OneWay}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimary}"
                                                               Margin="0,1,0,0"/>
                                                    <TextBlock Text="{Binding CurrentMessage}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,3,0,0"
                                                               Foreground="{Binding StatusColor,
                                                                   Converter={StaticResource ColorStringConverter}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ═══ COLUMN 2: TERMINAL + METRICS ═══ -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Terminal — DARK aesthetic preserved, NOT cached (content streams) -->
                    <Border Grid.Row="0"
                            Background="{StaticResource TerminalBg}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="22,18"
                            MinHeight="360"
                            Effect="{StaticResource CardShadow}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal"
                                        Margin="0,0,0,12">
                                <Ellipse Width="9" Height="9" Fill="{DynamicResource DangerBrush}"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Ellipse Width="9" Height="9" Fill="{DynamicResource WarningBrush}"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Ellipse Width="9" Height="9" Fill="{DynamicResource SuccessBrush}"
                                         VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <TextBlock Text="PROCESSING LOG"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TerminalTitle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- CRITICAL: x:Name preserved for code-behind auto-scroll -->
                            <ScrollViewer x:Name="TerminalLogScroller"
                                          Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          IsDeferredScrollingEnabled="False"
                                          behaviors:SmoothScrollBehavior.IsEnabled="True">
                                <ItemsControl x:Name="TerminalLogItems"
                                              ItemsSource="{Binding ProcessingLog}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       Margin="0,1"
                                                       TextWrapping="Wrap"
                                                       Foreground="{Binding SeverityColor,
                                                           Converter={StaticResource ColorStringConverter}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FontWeightDisplay}" Value="Bold">
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Metrics 2×2 glass -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0"
                                Style="{StaticResource MetricCardStyleGlass}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding OrderedQtyDisplay}"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource MetricOrdered}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Ordered"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondary}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="2"
                                Style="{StaticResource MetricCardStyleGlass}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding DeliveredQtyDisplay}"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource MetricDelivered}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Delivered"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondary}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0"
                                Style="{StaticResource MetricCardStyleGlass}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding BalanceQtyDisplay}"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource MetricBalance}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Balance"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondary}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="2"
                                Style="{StaticResource MetricCardStyleGlass}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding DeliveryRateDisplay}"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource MetricRate}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Rate"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondary}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ═══ COLUMN 3: WARNINGS & ALERTS ═══ -->
                <Border Grid.Column="4"
                        Background="{DynamicResource ModuleBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="20"
                        Effect="{StaticResource CardShadow}"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="4" Height="18"
                                    CornerRadius="2"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0"
                                    Background="{StaticResource AmberAccent}"/>
                            <TextBlock Grid.Column="1"
                                       Text="WARNINGS &amp; ALERTS"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource AmberAccent}"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="2"
                                    Background="{StaticResource WarnBadgeBg}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="10,3"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding WarningSummaryDisplay}"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="White"/>
                            </Border>
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsDeferredScrollingEnabled="False"
                                      behaviors:SmoothScrollBehavior.IsEnabled="True">
                            <ItemsControl ItemsSource="{Binding WorkflowWarnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="{DynamicResource CardCornerRadius}"
                                                Padding="14,12"
                                                Margin="0,0,0,10"
                                                BorderThickness="1"
                                                Background="{Binding BackgroundBrushKey,
                                                    Converter={StaticResource BrushKeyConverter}}"
                                                BorderBrush="{Binding TitleColorHex,
                                                    Converter={StaticResource ColorStringConverter}}"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Ellipse Grid.Column="0"
                                                         Width="10" Height="10"
                                                         Margin="0,4,10,0"
                                                         VerticalAlignment="Top"
                                                         Fill="{Binding TitleColorHex,
                                                             Converter={StaticResource ColorStringConverter}}"/>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="13" FontWeight="Bold"
                                                               Margin="0,0,0,4"
                                                               Foreground="{Binding TitleColorHex,
                                                                   Converter={StaticResource ColorStringConverter}}"/>

                                                    <TextBlock Text="{Binding Detail}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondary}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,0,10"/>

                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding AmountDisplay}"
                                                                   FontSize="12" FontWeight="Bold"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,10,0"
                                                                   Foreground="{Binding AmountColorHex,
                                                                       Converter={StaticResource ColorStringConverter}}"/>
                                                        <Border Background="White"
                                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                                Padding="8,3"
                                                                VerticalAlignment="Center"
                                                                BorderThickness="1"
                                                                BorderBrush="{Binding ActionColorHex,
                                                                    Converter={StaticResource ColorStringConverter}}">
                                                            <TextBlock Text="{Binding ActionLabel}"
                                                                       FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{Binding ActionColorHex,
                                                                           Converter={StaticResource ColorStringConverter}}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>