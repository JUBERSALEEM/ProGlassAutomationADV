<!-- ═══════════════════════════════════════════════════════════════
     FILE: Views/Reports/StatementGenerator/Pipeline/ExecuteStep.xaml
     PROJECT: ProGlassAutomation
     MODULE: Statement Generator — Wizard Step 3: EXECUTE

     LAYOUT (senior pass):
       • METRICS FIRST: a full-width KPI strip (Order / Delivered / Balance /
         Rate) sits directly under the progress strip.
       • PROCESSING LOG SECOND: the three columns below are
         Pipeline Steps | Processing Log | Warnings & Alerts — the log is the
         middle (second) column.
       • Pipeline steps and warnings are FLAT rows with a thin 1px border
         line (no outer card). Warnings show the same detail as steps: the
         originating step label + a quantity breakdown when present.
       • Processing log surface is theme-adaptive (light in Light, dark in
         Dark) with semantic severity colours.
       • Consistent icon→text spacing throughout.

     PRESERVED (verified):
       • x:Name="TerminalLogScroller" + "TerminalLogItems" (code-behind auto-scroll)
       • All VM bindings (steps / log / warnings / metrics / progress).
═══════════════════════════════════════════════════════════════ -->
<UserControl
    x:Class="ProGlassAutomation.Views.Reports.StatementGenerator.Pipeline.ExecuteStep"
             TextOptions.TextHintingMode="Fixed"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels.Reports.StatementGenerator"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:StatementGeneratorViewModel, IsDesignTimeCreatable=False}"
    FontFamily="{DynamicResource AppFontFamily}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    RenderOptions.BitmapScalingMode="HighQuality"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ══════════════════════════════════════════════════════════
             THEME-ALIASED BRUSHES (no hardcoded hex)
        ══════════════════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="IndigoPrimary" Color="{DynamicResource AccentColor}"/>
<SolidColorBrush x:Key="AmberAccent" Color="{DynamicResource WarningColor}"/>
        <SolidColorBrush x:Key="RedAccent" Color="{DynamicResource DangerColor}"/>
<SolidColorBrush x:Key="ProgressTrack" Color="{DynamicResource BorderColor}"/>

        <!-- Processing log surface — theme-adaptive. -->
        <SolidColorBrush x:Key="TerminalBg" Color="{DynamicResource ModuleBackgroundColor}"/>
        <SolidColorBrush x:Key="TerminalTitle" Color="{DynamicResource MutedForegroundColor}"/>

        <!-- Step status tint backgrounds -->
        <SolidColorBrush x:Key="StepIdleBg" Color="{DynamicResource TintGrayColor}"/>
        <SolidColorBrush x:Key="StepSuccessBg" Color="{DynamicResource TintGreenColor}"/>
        <SolidColorBrush x:Key="StepWarningBg" Color="{DynamicResource TintAmberColor}"/>
        <SolidColorBrush x:Key="StepBlockedBg" Color="{DynamicResource TintRedColor}"/>
        <SolidColorBrush x:Key="StepRunningBg" Color="{DynamicResource TintPurpleColor}"/>
        <SolidColorBrush x:Key="StepBadgeIdle" Color="{DynamicResource MutedForegroundColor}"/>

        <!-- Metric accents -->
        <SolidColorBrush x:Key="MetricOrdered" Color="{DynamicResource AccentColor}"/>
        <SolidColorBrush x:Key="MetricDelivered" Color="{DynamicResource AccentColor}"/>
        <SolidColorBrush x:Key="MetricBalance" Color="{DynamicResource DangerColor}"/>
        <SolidColorBrush x:Key="MetricRate" Color="{DynamicResource WarningColor}"/>

        <SolidColorBrush x:Key="WarnBadgeBg" Color="{DynamicResource WarningColor}"/>

        <!-- Progress gradient (theme-aware) -->
        <LinearGradientBrush x:Key="ProgressGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource AccentLightColor}" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="ProgressCardShadow"
                          BlurRadius="18" ShadowDepth="3"
                          Opacity="0.08" Color="{DynamicResource AccentColor}"/>

        <!-- ══════════════════════════════════════════════════════════
             FLAT PIPELINE STEP ROW — tinted + thin border line
        ══════════════════════════════════════════════════════════ -->
        

        <!-- Circular step status badge -->
        

        <!-- KPI metric tile -->
        

    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         ROOT
    ═══════════════════════════════════════════════════════════════ -->
    <Grid Background="Transparent">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      IsDeferredScrollingEnabled="False"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">
            <StackPanel Margin="40,32,40,40">

                <!-- ═══════════════════════════════════════════════════
                     PAGE HEADER
                ═══════════════════════════════════════════════════ -->
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="6" Height="6"
                                Background="{DynamicResource IndigoPrimary}"
                                CornerRadius="{DynamicResource Radius.XSmall}"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0" Style="{StaticResource SurfacePrimaryStyle}"/>
                        <TextBlock Text="{DynamicResource Reports.StatementGenerator.STEP34}"
                                   FontSize="{DynamicResource FontSize.Body}"
                                   FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource IndigoPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Reports.StatementGenerator.ExecutePipeline}"
                               FontSize="{DynamicResource FontSize.Display}"
                               FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{DynamicResource Reports.StatementGenerator.8StepWorkflowProcessingDataRealTimeWatchStep}"
                               FontSize="{DynamicResource FontSize.H3}"
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <!-- ═══════════════════════════════════════════════════
                     PROGRESS STRIP (slim)
                ═══════════════════════════════════════════════════ -->
                <Border Margin="0,24,0,0"
                        Background="{DynamicResource SurfacePrimaryBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="20,16"
                        Effect="{StaticResource ProgressCardShadow}"
                        SnapsToDevicePixels="True" Style="{StaticResource SurfacePrimaryStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Width="12" Height="12"
                                    CornerRadius="{DynamicResource Radius.Small}"
                                    Background="{DynamicResource GreenLed}"
                                    Effect="{StaticResource GreenLedGlow}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0" Style="{StaticResource SurfacePrimaryStyle}"/>
                            <TextBlock Text="{Binding LastWorkflowStatusText}"
                                       FontSize="{DynamicResource FontSize.H2}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="{Binding LastWorkflowProgressDisplay}"
                                   FontSize="{DynamicResource FontSize.Kpi}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource VioletAccent}"
                                   VerticalAlignment="Center"/>

                        <Border Grid.Row="2" Grid.ColumnSpan="3"
                                Height="8" CornerRadius="{DynamicResource Radius.XSmall}"
                                Background="{DynamicResource ProgressTrack}"
                                ClipToBounds="True"
                                SnapsToDevicePixels="True" Style="{StaticResource SurfacePrimaryStyle}">
                            <Border HorizontalAlignment="Left"
                                    CornerRadius="{DynamicResource Radius.XSmall}"
                                    Background="{DynamicResource ProgressGradient}" Style="{StaticResource SurfacePrimaryStyle}">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                        <Binding Path="LastWorkflowProgressPercent"/>
                                        <Binding Path="ActualWidth"
                                                 RelativeSource="{RelativeSource AncestorType=Border}"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Border>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════════════
                     METRICS — FIRST (full-width KPI strip)
                ═══════════════════════════════════════════════════ -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SurfacePrimaryStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding OrderedQtyDisplay}"
                                       FontSize="{DynamicResource FontSize.Kpi}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource MetricOrdered}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Common.Ordered}"
                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SurfacePrimaryStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding DeliveredQtyDisplay}"
                                       FontSize="{DynamicResource FontSize.Kpi}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource MetricDelivered}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Common.Delivered}"
                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource SurfacePrimaryStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding BalanceQtyDisplay}"
                                       FontSize="{DynamicResource FontSize.Kpi}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource MetricBalance}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Common.Balance}"
                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Style="{StaticResource SurfacePrimaryStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding DeliveryRateDisplay}"
                                       FontSize="{DynamicResource FontSize.Kpi}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource MetricRate}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Common.Rate}"
                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════════════════════
                     3 SECTIONS: steps · processing log · warnings
                ═══════════════════════════════════════════════════ -->
                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.0*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="0.95*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ═══ COLUMN 1: PIPELINE STEPS (flat rows) ═══ -->
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="4" Height="16"
                                    CornerRadius="{DynamicResource Radius.XSmall}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"
                                    Background="{DynamicResource IndigoPrimary}" Style="{StaticResource SurfacePrimaryStyle}"/>
                            <TextBlock Text="{DynamicResource Reports.StatementGenerator.PipelineSteps}"
                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource IndigoPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding LastWorkflowSteps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SurfacePrimaryStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Style="{StaticResource SurfacePrimaryStyle}">
                                                <TextBlock Text="{Binding StatusIcon}"
                                                           FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.Bold}"
                                                           Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                           Foreground="{DynamicResource TextPrimary}">
                                                    <Run Text="{DynamicResource Reports.StatementGenerator.Step}"/>
                                                    <Run Text="{Binding Order, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding Title, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding CurrentMessage}"
                                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                                           FontWeight="{DynamicResource Weight.SemiBold}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,4,0,0"
                                                           Foreground="{Binding StatusBrushKey,
                                                               Converter={StaticResource BrushKeyConverter}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ═══ COLUMN 2: PROCESSING LOG (second) ═══ -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource TerminalBg}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="{DynamicResource CardBorderThickness}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="18,14"
                            SnapsToDevicePixels="True" Style="{StaticResource SurfacePrimaryStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <Ellipse Width="9" Height="9" Fill="{DynamicResource DangerBrush}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Ellipse Width="9" Height="9" Fill="{DynamicResource WarningBrush}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Ellipse Width="9" Height="9" Fill="{DynamicResource SuccessBrush}"
                                         VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <TextBlock Text="{DynamicResource Reports.StatementGenerator.ProcessingLOG}"
                                           FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource TerminalTitle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- CRITICAL: x:Name preserved for code-behind auto-scroll -->
                            <ScrollViewer x:Name="TerminalLogScroller"
                                          Grid.Row="1"
                                          MinHeight="360"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          IsDeferredScrollingEnabled="False"
                                          behaviors:SmoothScrollBehavior.IsEnabled="True">
                                <ItemsControl x:Name="TerminalLogItems"
                                              ItemsSource="{Binding ProcessingLog}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}"
                                                       FontFamily="{DynamicResource FontFamily.Code}"
                                                       FontSize="{DynamicResource FontSize.Body}"
                                                       Margin="0,1"
                                                       TextWrapping="Wrap"
                                                       Foreground="{Binding SeverityColor,
                                                           Converter={StaticResource BrushKeyConverter}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="{DynamicResource Weight.Regular}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FontWeightDisplay}" Value="Bold">
                                                                <Setter Property="FontWeight" Value="{DynamicResource Weight.Bold}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- ═══ COLUMN 3: WARNINGS & ALERTS (flat, detailed) ═══ -->
                    <StackPanel Grid.Column="4">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="4" Height="16"
                                    CornerRadius="{DynamicResource Radius.XSmall}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"
                                    Background="{DynamicResource AmberAccent}" Style="{StaticResource SurfacePrimaryStyle}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{DynamicResource Reports.StatementGenerator.WarningsAlerts}"
                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource AmberAccent}"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="2"
                                    Background="{DynamicResource WarnBadgeBg}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="10,3"
                                    VerticalAlignment="Center" Style="{StaticResource SurfacePrimaryStyle}">
                                <TextBlock Text="{Binding WarningSummaryDisplay}"
                                           FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            </Border>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding WorkflowWarnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Padding="14,12"
                                            Margin="0,0,0,8"
                                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                                            BorderBrush="{Binding TitleBrushKey,
                                                Converter={StaticResource BrushKeyConverter}}"
                                            Background="{Binding BackgroundBrushKey,
                                                Converter={StaticResource BrushKeyConverter}}"
                                            SnapsToDevicePixels="True" Style="{StaticResource SurfacePrimaryStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Column="0"
                                                     Width="10" Height="10"
                                                     Margin="0,5,12,0"
                                                     VerticalAlignment="Top"
                                                     Fill="{Binding TitleBrushKey,
                                                         Converter={StaticResource BrushKeyConverter}}"/>

                                            <StackPanel Grid.Column="1">
                                                <!-- Originating step (same detail as pipeline steps) -->
                                                <TextBlock Text="{Binding StepLabel}"
                                                           FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           Margin="0,0,0,4"/>

                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.Bold}"
                                                           Margin="0,0,0,4"
                                                           Foreground="{Binding TitleBrushKey,
                                                               Converter={StaticResource BrushKeyConverter}}"/>

                                                <TextBlock Text="{Binding Detail}"
                                                           FontSize="{DynamicResource FontSize.Body}"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,8"/>

                                                <!-- Quantity breakdown -->
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,0,0,10"
                                                            Visibility="{Binding HasQuantities,
                                                                Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Border Background="{DynamicResource TintIndigoBrush}"
                                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                                            Padding="8,3" Margin="0,0,8,0" Style="{StaticResource SurfacePrimaryStyle}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{DynamicResource Common.Ordered}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                                       Foreground="{DynamicResource TextMuted}"/>
                                                            <TextBlock Text="{Binding OrderedText}" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                                                       Foreground="{DynamicResource TextPrimary}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="{DynamicResource TintGreenBrush}"
                                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                                            Padding="8,3" Margin="0,0,8,0" Style="{StaticResource SurfacePrimaryStyle}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{DynamicResource Common.Delivered}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                                       Foreground="{DynamicResource TextMuted}"/>
                                                            <TextBlock Text="{Binding DeliveredText}" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                                                       Foreground="{DynamicResource SuccessBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="{DynamicResource TintRedBrush}"
                                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                                            Padding="8,3" Style="{StaticResource SurfacePrimaryStyle}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{DynamicResource Reports.StatementGenerator.Diff}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                                       Foreground="{DynamicResource TextMuted}"/>
                                                            <TextBlock Text="{Binding DifferenceText}" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                                                       Foreground="{DynamicResource DangerBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding AmountDisplay}"
                                                               FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,12,0"
                                                               Foreground="{Binding AmountBrushKey,
                                                                   Converter={StaticResource BrushKeyConverter}}"/>
                                                    <!-- Actionable button — routes to the related document -->
                                                    <Button Cursor="Hand"
                                                            Padding="10,3"
                                                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                                                            Visibility="{Binding HasAction,
                                                                Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Command="{Binding DataContext.OpenWarningActionCommand,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}">
                                                        <Button.Template Style="{StaticResource SecondaryButtonStyle}">
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bd"
                                                                        Background="{DynamicResource SurfacePrimaryBrush}"
                                                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                                                        Padding="{TemplateBinding Padding}"
                                                                        BorderThickness="{DynamicResource Border.HairlineThickness}"
                                                                        BorderBrush="{Binding ActionBrushKey,
                                                                            Converter={StaticResource BrushKeyConverter}}"
                                                                        SnapsToDevicePixels="True" Style="{StaticResource SurfacePrimaryStyle}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE76B;"
                                                                                   FontFamily="{DynamicResource FontFamily.Icon}"
                                                                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                                                                   Foreground="{Binding ActionBrushKey,
                                                                                       Converter={StaticResource BrushKeyConverter}}"
                                                                                   Margin="0,0,6,0"
                                                                                   VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding ActionLabel}"
                                                                                   FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                                                   Foreground="{Binding ActionBrushKey,
                                                                                       Converter={StaticResource BrushKeyConverter}}"
                                                                                   VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
