<!-- ═══════════════════════════════════════════════════════════════
     FILE: Views/Reports/StatementGenerator/Pipeline/ExecuteStep.xaml
     PROJECT: ProGlassAutomation
     MODULE: Statement Generator — Wizard Step 3: EXECUTE

     LAYOUT (senior pass — 3 sections restored):
       • THREE columns, as before: Pipeline Steps · Processing Log + Metrics ·
         Warnings & Alerts.
       • Pipeline steps and warnings are FLAT rows — no big outer card — but
         each row keeps a thin BORDER LINE (outline) so they read as distinct
         items. No nested ScrollViewers on those two columns.
       • Processing log uses a THEME-ADAPTIVE surface (light in Light mode,
         dark in Dark mode) with theme-aware severity colours — no hardcoded
         hex, no inverted white terminal.

     PRESERVED (verified):
       • x:Name="TerminalLogScroller" + "TerminalLogItems" (code-behind auto-scroll)
       • All bindings: LastWorkflowStatusText / LastWorkflowProgressDisplay /
         LastWorkflowProgressPercent / LastWorkflowSteps / ProcessingLog /
         WorkflowWarnings / Ordered/Delivered/Balance/Rate displays.
═══════════════════════════════════════════════════════════════ -->
<UserControl
    x:Class="ProGlassAutomation.Views.Reports.StatementGenerator.Pipeline.ExecuteStep"
             TextOptions.TextHintingMode="Fixed"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:vm="clr-namespace:ProGlassAutomation.ViewModels.Reports.StatementGenerator"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:StatementGeneratorViewModel, IsDesignTimeCreatable=False}"
    FontFamily="{DynamicResource AppFontFamily}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    RenderOptions.BitmapScalingMode="HighQuality"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ══════════════════════════════════════════════════════════
             THEME-ALIASED BRUSHES (no hardcoded hex)
        ══════════════════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="IndigoPrimary" Color="{DynamicResource AccentColor}"/>
        <SolidColorBrush x:Key="VioletAccent" Color="{DynamicResource AccentColor}"/>
        <SolidColorBrush x:Key="EmeraldAccent" Color="{DynamicResource AccentLightColor}"/>
        <SolidColorBrush x:Key="AmberAccent" Color="{DynamicResource WarningColor}"/>
        <SolidColorBrush x:Key="RedAccent" Color="{DynamicResource DangerColor}"/>

        <SolidColorBrush x:Key="TextPrimary" Color="{DynamicResource PrimaryForegroundColor}"/>
        <SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource SecondaryForegroundColor}"/>
        <SolidColorBrush x:Key="TextMuted" Color="{DynamicResource MutedForegroundColor}"/>
        <SolidColorBrush x:Key="ProgressTrack" Color="{DynamicResource BorderColor}"/>

        <!-- Processing log surface — theme-adaptive (light in Light, dark in
             Dark). Replaces the old inverted "terminal" (was near-black in
             Light and near-white in Dark). -->
        <SolidColorBrush x:Key="TerminalBg" Color="{DynamicResource ModuleBackgroundColor}"/>
        <SolidColorBrush x:Key="TerminalTitle" Color="{DynamicResource MutedForegroundColor}"/>

        <!-- Step status tint backgrounds -->
        <SolidColorBrush x:Key="StepIdleBg" Color="{DynamicResource TintGrayColor}"/>
        <SolidColorBrush x:Key="StepSuccessBg" Color="{DynamicResource TintGreenColor}"/>
        <SolidColorBrush x:Key="StepWarningBg" Color="{DynamicResource TintAmberColor}"/>
        <SolidColorBrush x:Key="StepBlockedBg" Color="{DynamicResource TintRedColor}"/>
        <SolidColorBrush x:Key="StepRunningBg" Color="{DynamicResource TintPurpleColor}"/>
        <SolidColorBrush x:Key="StepBadgeIdle" Color="{DynamicResource MutedForegroundColor}"/>

        <!-- Metric accents -->
        <SolidColorBrush x:Key="MetricOrdered" Color="{DynamicResource AccentColor}"/>
        <SolidColorBrush x:Key="MetricDelivered" Color="{DynamicResource AccentColor}"/>
        <SolidColorBrush x:Key="MetricBalance" Color="{DynamicResource DangerColor}"/>
        <SolidColorBrush x:Key="MetricRate" Color="{DynamicResource WarningColor}"/>

        <SolidColorBrush x:Key="WarnBadgeBg" Color="{DynamicResource WarningColor}"/>

        <!-- Progress gradient (theme-aware) -->
        <LinearGradientBrush x:Key="ProgressGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource AccentLightColor}" Offset="1"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="GreenLed">
            <GradientStop Color="{DynamicResource SuccessColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource AccentLightColor}" Offset="1"/>
        </RadialGradientBrush>

        <DropShadowEffect x:Key="ProgressCardShadow"
                          BlurRadius="18" ShadowDepth="3"
                          Opacity="0.08" Color="{DynamicResource AccentColor}"/>

        <DropShadowEffect x:Key="GreenLedGlow"
                          BlurRadius="8" ShadowDepth="0"
                          Opacity="0.6" Color="{DynamicResource AccentLightColor}"/>

        <!-- ══════════════════════════════════════════════════════════
             FLAT PIPELINE STEP ROW — tinted + thin border line
             (no outer card, but keeps its outline so rows read distinct)
        ══════════════════════════════════════════════════════════ -->
        <Style x:Key="PipelineStepStyle" TargetType="Border">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="{StaticResource StepIdleBg}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                    <Setter Property="Background" Value="{StaticResource StepSuccessBg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                    <Setter Property="Background" Value="{StaticResource StepWarningBg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                    <Setter Property="Background" Value="{StaticResource StepBlockedBg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Background" Value="{StaticResource StepRunningBg}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource VioletAccent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Circular step status badge -->
        <Style x:Key="PipelineStepBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource StepBadgeIdle}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                    <Setter Property="Background" Value="{StaticResource EmeraldAccent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AmberAccent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                    <Setter Property="Background" Value="{StaticResource RedAccent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Background" Value="{StaticResource VioletAccent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Compact metric tile -->
        <Style x:Key="MetricTileStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         ROOT
    ═══════════════════════════════════════════════════════════════ -->
    <Grid Background="{DynamicResource WindowBackgroundBrush}">

        <!-- Single page scroll; the pipeline and warning columns are fully
             expanded (no inner scrollbars) — only the streaming log scrolls. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      IsDeferredScrollingEnabled="False"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">
            <StackPanel Margin="40,32,40,40">

                <!-- ═══════════════════════════════════════════════════
                     PAGE HEADER
                ═══════════════════════════════════════════════════ -->
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="6" Height="6"
                                Background="{StaticResource IndigoPrimary}"
                                CornerRadius="3"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0"/>
                        <TextBlock Text="STEP 3 OF 4"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource IndigoPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Execute Pipeline"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="8-step workflow processing your data in real-time. Watch each step complete and review the live output below."
                               FontSize="14"
                               Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <!-- ═══════════════════════════════════════════════════
                     PROGRESS STRIP (slim)
                ═══════════════════════════════════════════════════ -->
                <Border Margin="0,24,0,0"
                        Background="{DynamicResource ModuleBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="20,16"
                        Effect="{StaticResource ProgressCardShadow}"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Width="12" Height="12"
                                    CornerRadius="6"
                                    Background="{StaticResource GreenLed}"
                                    Effect="{StaticResource GreenLedGlow}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding LastWorkflowStatusText}"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="{Binding LastWorkflowProgressDisplay}"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource VioletAccent}"
                                   VerticalAlignment="Center"/>

                        <!-- Progress bar -->
                        <Border Grid.Row="2" Grid.ColumnSpan="3"
                                Height="8" CornerRadius="4"
                                Background="{StaticResource ProgressTrack}"
                                ClipToBounds="True"
                                SnapsToDevicePixels="True">
                            <Border HorizontalAlignment="Left"
                                    CornerRadius="4"
                                    Background="{StaticResource ProgressGradient}">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                        <Binding Path="LastWorkflowProgressPercent"/>
                                        <Binding Path="ActualWidth"
                                                 RelativeSource="{RelativeSource AncestorType=Border}"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Border>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════════════
                     3 SECTIONS (restored): steps · log+metrics · warnings
                ═══════════════════════════════════════════════════ -->
                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="0.95*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ═══ SECTION 1: PIPELINE STEPS (flat rows) ═══ -->
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="4" Height="16"
                                    CornerRadius="2"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0"
                                    Background="{StaticResource IndigoPrimary}"/>
                            <TextBlock Text="PIPELINE STEPS"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource IndigoPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding LastWorkflowSteps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PipelineStepStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Style="{StaticResource PipelineStepBadgeStyle}">
                                                <TextBlock Text="{Binding StatusIcon}"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock FontSize="12" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimary}">
                                                    <Run Text="Step "/>
                                                    <Run Text="{Binding Order, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding Title, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding CurrentMessage}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,3,0,0"
                                                           Foreground="{Binding StatusBrushKey,
                                                               Converter={StaticResource BrushKeyConverter}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ═══ SECTION 2: PROCESSING LOG + METRICS ═══ -->
                    <StackPanel Grid.Column="2">
                        <!-- Processing log — theme-adaptive surface -->
                        <Border Background="{StaticResource TerminalBg}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="{DynamicResource CardBorderThickness}"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                Padding="18,14"
                                MinHeight="280"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource DangerBrush}"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource WarningBrush}"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource SuccessBrush}"
                                             VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Text="PROCESSING LOG"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource TerminalTitle}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- CRITICAL: x:Name preserved for code-behind auto-scroll -->
                                <ScrollViewer x:Name="TerminalLogScroller"
                                              Grid.Row="1"
                                              MaxHeight="380"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              IsDeferredScrollingEnabled="False"
                                              behaviors:SmoothScrollBehavior.IsEnabled="True">
                                    <ItemsControl x:Name="TerminalLogItems"
                                                  ItemsSource="{Binding ProcessingLog}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Text}"
                                                           FontFamily="Consolas"
                                                           FontSize="12"
                                                           Margin="0,1"
                                                           TextWrapping="Wrap"
                                                           Foreground="{Binding SeverityColor,
                                                               Converter={StaticResource BrushKeyConverter}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontWeight" Value="Normal"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding FontWeightDisplay}" Value="Bold">
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Metrics 2×2 -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricTileStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding OrderedQtyDisplay}"
                                               FontSize="22" FontWeight="Bold"
                                               Foreground="{StaticResource MetricOrdered}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Ordered"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource MetricTileStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding DeliveredQtyDisplay}"
                                               FontSize="22" FontWeight="Bold"
                                               Foreground="{StaticResource MetricDelivered}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Delivered"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource MetricTileStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding BalanceQtyDisplay}"
                                               FontSize="22" FontWeight="Bold"
                                               Foreground="{StaticResource MetricBalance}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Balance"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource MetricTileStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding DeliveryRateDisplay}"
                                               FontSize="22" FontWeight="Bold"
                                               Foreground="{StaticResource MetricRate}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Rate"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- ═══ SECTION 3: WARNINGS & ALERTS (flat rows) ═══ -->
                    <StackPanel Grid.Column="4">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="4" Height="16"
                                    CornerRadius="2"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0"
                                    Background="{StaticResource AmberAccent}"/>
                            <TextBlock Grid.Column="1"
                                       Text="WARNINGS &amp; ALERTS"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource AmberAccent}"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="2"
                                    Background="{StaticResource WarnBadgeBg}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="10,3"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding WarningSummaryDisplay}"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            </Border>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding WorkflowWarnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Padding="12,10"
                                            Margin="0,0,0,8"
                                            BorderThickness="1"
                                            BorderBrush="{Binding TitleBrushKey,
                                                Converter={StaticResource BrushKeyConverter}}"
                                            Background="{Binding BackgroundBrushKey,
                                                Converter={StaticResource BrushKeyConverter}}"
                                            SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Column="0"
                                                     Width="10" Height="10"
                                                     Margin="0,4,10,0"
                                                     VerticalAlignment="Top"
                                                     Fill="{Binding TitleBrushKey,
                                                         Converter={StaticResource BrushKeyConverter}}"/>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="13" FontWeight="Bold"
                                                           Margin="0,0,0,4"
                                                           Foreground="{Binding TitleBrushKey,
                                                               Converter={StaticResource BrushKeyConverter}}"/>

                                                <TextBlock Text="{Binding Detail}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,8"/>

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding AmountDisplay}"
                                                               FontSize="12" FontWeight="Bold"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,0"
                                                               Foreground="{Binding AmountBrushKey,
                                                                   Converter={StaticResource BrushKeyConverter}}"/>
                                                    <Border Background="{DynamicResource ModuleBackgroundBrush}"
                                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                                            Padding="8,3"
                                                            VerticalAlignment="Center"
                                                            BorderThickness="1"
                                                            BorderBrush="{Binding ActionBrushKey,
                                                                Converter={StaticResource BrushKeyConverter}}">
                                                        <TextBlock Text="{Binding ActionLabel}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{Binding ActionBrushKey,
                                                                       Converter={StaticResource BrushKeyConverter}}"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
