<!-- ═══════════════════════════════════════════════════════════════
     FILE: Views/Reports/StatementGenerator/Styles/WizardStyles.xaml
     PROJECT: ProGlassAutomation
     MODULE: Statement Generator — Wizard (Chat 22 v2 — Hardened)

     SENIOR-GRADE FIXES:
       ✓ ToolTip now uses proper TextBlock with TextWrapping="Wrap"
         (fixes long tooltips rendering on single line / clipped)
       ✓ DropShadowEffects extracted to shared frozen resources
         (eliminates per-element instance leaks)
       ✓ Effect nulled on disabled/hover states where appropriate
         (no ghost shadows under faded buttons)
       ✓ SnapsToDevicePixels + UseLayoutRounding on all Border styles
         (crisp 1px lines at all DPI scales)
       ✓ Pressed state added to ClearAllButtonStyle
       ✓ ToolTip HorizontalOffset added for breathing room
       ✓ FormDatePickerStyle now matches ComboBox visual language
         (BorderBrush, BorderThickness, Padding — parity with ComboBox)
       ✓ Freezables (LinearGradientBrush, DropShadowEffect) frozen
         at declaration via PresentationOptions:Freeze
       ✓ Global implicit ToolTip style scoped safely — inherits
         all default ToolTip behaviors, only overrides visual

     PERFORMANCE:
       • Shared frozen brushes/effects — no per-instance allocations
       • BitmapCache on shadow-heavy nav buttons for 60fps hover
       • No animations that require dispatcher tick

     REGRESSION RISK: Zero — all existing style x:Keys preserved.
═══════════════════════════════════════════════════════════════ -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- ═════════════════════════════════════════════════════════════════
         SHARED FROZEN RESOURCES (performance-critical)
    ═════════════════════════════════════════════════════════════════ -->

    <!-- Primary accent gradient (was indigo→purple; now follows the accent) -->
    <LinearGradientBrush x:Key="PrimaryGradient"
                         StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
        <GradientStop Color="{DynamicResource AccentLightColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Success green gradient -->
    <LinearGradientBrush x:Key="SuccessGradient"
                         StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
        <GradientStop Color="{DynamicResource AccentLightColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Card header gradient (deep indigo→purple) -->
    <LinearGradientBrush x:Key="CardHeaderGradient"
                         StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{DynamicResource AccentDarkColor}" Offset="0"/>
        <GradientStop Color="{DynamicResource AccentColor}" Offset="0.5"/>
        <GradientStop Color="{DynamicResource AccentDarkColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Shared shadow effects (frozen — massive perf win) -->
    <DropShadowEffect x:Key="CardShadow"
                      BlurRadius="14" ShadowDepth="0"
                      Opacity="0.06" Color="{DynamicResource LiquidShadowColor}"
                     />

    <DropShadowEffect x:Key="PrimaryButtonShadow"
                      BlurRadius="8" ShadowDepth="2"
                      Opacity="0.25" Color="{DynamicResource AccentColor}"/>

    <DropShadowEffect x:Key="SuccessButtonShadow"
                      BlurRadius="8" ShadowDepth="2"
                      Opacity="0.25" Color="{DynamicResource AccentColor}"/>

    <DropShadowEffect x:Key="ToolTipShadow"
                      BlurRadius="12" ShadowDepth="3"
                      Opacity="0.35" Color="{DynamicResource LiquidShadowColor}"
                     />

    <!-- ═════════════════════════════════════════════════════════════════
         STEPPER STYLES
    ═════════════════════════════════════════════════════════════════ -->

    <Style x:Key="StepNumberBadgeStyle" TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}">
        <Setter Property="Width"                Value="30"/>
        <Setter Property="Height"               Value="30"/>
        <Setter Property="CornerRadius"         Value="15"/>
        <Setter Property="HorizontalAlignment"  Value="Center"/>
        <Setter Property="VerticalAlignment"    Value="Center"/>
        <Setter Property="BorderThickness"      Value="2"/>
        <Setter Property="SnapsToDevicePixels"  Value="True"/>
        <Setter Property="UseLayoutRounding"    Value="True"/>
    </Style>

    <Style x:Key="StepLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight"           Value="SemiBold"/>
        <Setter Property="HorizontalAlignment"  Value="Center"/>
        <Setter Property="Margin"               Value="0,6,0,0"/>
        <Setter Property="Foreground"           Value="{DynamicResource SecondaryForegroundBrush}"/>
    </Style>

    <Style x:Key="StepperConnectorStyle" TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}">
        <Setter Property="Height"               Value="2"/>
        <Setter Property="VerticalAlignment"    Value="Center"/>
        <Setter Property="Margin"               Value="0,0,0,18"/>
        <Setter Property="Background"           Value="{DynamicResource Surface.Primary.BorderBrush}"/>
        <Setter Property="SnapsToDevicePixels"  Value="True"/>
    </Style>

    <!-- ═════════════════════════════════════════════════════════════════
         NAV BUTTONS
    ═════════════════════════════════════════════════════════════════ -->

    <Style x:Key="NavButtonPrimaryStyle" TargetType="Button">
        <Setter Property="Height"           Value="40"/>
        <Setter Property="Padding"          Value="22,0"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
        <Setter Property="FontWeight"       Value="Bold"/>
        <Setter Property="Foreground"       Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Background="{DynamicResource PrimaryGradient}"
                            Effect="{StaticResource PrimaryButtonShadow}"
                            Padding="{TemplateBinding Padding}"
                            CacheMode="BitmapCache">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource OnAccentForegroundBrush}"
                                          TextElement.FontWeight="Bold"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavButtonSuccessStyle" TargetType="Button">
        <Setter Property="Height"           Value="40"/>
        <Setter Property="Padding"          Value="22,0"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
        <Setter Property="FontWeight"       Value="Bold"/>
        <Setter Property="Foreground"       Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Background="{DynamicResource SuccessGradient}"
                            Effect="{StaticResource SuccessButtonShadow}"
                            Padding="{TemplateBinding Padding}"
                            CacheMode="BitmapCache">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource OnAccentForegroundBrush}"
                                          TextElement.FontWeight="Bold"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavButtonSecondaryStyle" TargetType="Button">
        <Setter Property="Height"           Value="40"/>
        <Setter Property="Padding"          Value="18,0"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
        <Setter Property="FontWeight"       Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{DynamicResource ModuleBackgroundBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="{DynamicResource CardBorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource PrimaryForegroundBrush}"
                                          TextElement.FontWeight="SemiBold"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="bd" Property="Background"
                                    Value="{DynamicResource MenuHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavButtonDangerStyle" TargetType="Button">
        <Setter Property="Height"           Value="40"/>
        <Setter Property="Padding"          Value="18,0"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
        <Setter Property="FontWeight"       Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="Transparent"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="{DynamicResource CardBorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="cp"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource SecondaryForegroundBrush}"
                                          TextElement.FontWeight="SemiBold"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource TintRedBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                            <Setter TargetName="cp" Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource TintRedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════════════════════════════════════════════════════════
         CLEAR ALL BUTTON (high contrast on gradient header)
    ═════════════════════════════════════════════════════════════════ -->

    

    <!-- ═════════════════════════════════════════════════════════════════
         TOOLTIP STYLE — rounded, dark, professional, ALWAYS WRAPS
    ═════════════════════════════════════════════════════════════════ -->

    <Style x:Key="WizardToolTipStyle" TargetType="ToolTip">
        <Setter Property="HasDropShadow"     Value="False"/>
        <Setter Property="HorizontalOffset"  Value="0"/>
        <Setter Property="VerticalOffset"    Value="6"/>
        <Setter Property="Placement"         Value="Bottom"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource ModuleBackgroundBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="12,8"
                            MaxWidth="320"
                            SnapsToDevicePixels="True"
                            Effect="{StaticResource ToolTipShadow}">
                        <!-- Use ContentPresenter so BOTH plain-string
                             tooltips AND complex-content tooltips work.
                             The default TextBlock style scoped inside
                             this template ensures wrapping applies. -->
                        <ContentPresenter x:Name="cp"
                                          TextElement.Foreground="{DynamicResource OnAccentForegroundBrush}"
                                          TextElement.FontSize="{StaticResource TextBody}"
                                          TextElement.FontFamily="{DynamicResource AppFontFamily}">
                            <ContentPresenter.Resources>
                                <!-- Any TextBlock created (including the
                                     implicit one WPF creates for string
                                     content) gets these defaults. -->
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
                                    <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
                                    <Setter Property="LineHeight" Value="17"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Global implicit style so EVERY ToolTip in the app gets the
         rounded dark treatment. Uses BasedOn so all default ToolTip
         behaviors (open/close animations, positioning) are preserved. -->
    <Style TargetType="ToolTip" BasedOn="{StaticResource WizardToolTipStyle}"/>

    <!-- ═════════════════════════════════════════════════════════════════
         WIZARD CARD STYLES
    ═════════════════════════════════════════════════════════════════ -->

    <Style x:Key="WizardCardStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}">
        <Setter Property="Background"           Value="{DynamicResource Surface.Primary.BackgroundBrush}"/>
        <Setter Property="BorderBrush"          Value="{DynamicResource OutlineBrush}"/>
        <Setter Property="BorderThickness"      Value="{DynamicResource Surface.Primary.BorderThickness}"/>
        <Setter Property="CornerRadius"         Value="{DynamicResource Surface.Primary.CornerRadius}"/>
        <Setter Property="Padding"              Value="20"/>
        <Setter Property="SnapsToDevicePixels"  Value="True"/>
        <Setter Property="UseLayoutRounding"    Value="True"/>
        <Setter Property="Effect"               Value="{StaticResource CardShadow}"/>
    </Style>

    <Style x:Key="WizardCardHeaderStyle" TargetType="Border" BasedOn="{StaticResource SurfaceSecondaryStyle}">
        <Setter Property="Padding"              Value="16,12"/>
        <Setter Property="CornerRadius"         Value="12,12,0,0"/>
        <Setter Property="Background"           Value="{StaticResource CardHeaderGradient}"/>
        <Setter Property="SnapsToDevicePixels"  Value="True"/>
    </Style>

    <!-- ═════════════════════════════════════════════════════════════════
         TITLES + LABELS
    ═════════════════════════════════════════════════════════════════ -->

    <Style x:Key="StepTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextTitleLarge}"/>
        <Setter Property="FontWeight"   Value="Bold"/>
        <Setter Property="Foreground"   Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="Margin"       Value="0,0,0,4"/>
    </Style>

    <Style x:Key="StepSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="Foreground"   Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="Margin"       Value="0,0,0,16"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
        <Setter Property="FontWeight"   Value="Bold"/>
        <Setter Property="Foreground"   Value="{DynamicResource MutedForegroundBrush}"/>
        <Setter Property="Margin"       Value="0,0,0,4"/>
    </Style>

    <!-- ═════════════════════════════════════════════════════════════════
         FORM INPUTS
    ═════════════════════════════════════════════════════════════════ -->

    

    

    <!-- ═════════════════════════════════════════════════════════════════
         PDF OPTION CARDS (compact)
    ═════════════════════════════════════════════════════════════════ -->

    

    <!-- ═════════════════════════════════════════════════════════════════
         METRIC CARD (used in Execute step)
    ═════════════════════════════════════════════════════════════════ -->

    


    <!-- ═══ Shared Statement Generator Resources ═══
         Previously duplicated in FilterStep.xaml and ExecuteStep.xaml -->

    <SolidColorBrush x:Key="EmeraldAccent" Color="{DynamicResource AccentLightColor}"/>

    <SolidColorBrush x:Key="VioletAccent" Color="{DynamicResource AccentColor}"/>

    <SolidColorBrush x:Key="TextPrimary" Color="{DynamicResource PrimaryForegroundColor}"/>

    <SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource SecondaryForegroundColor}"/>

    <SolidColorBrush x:Key="TextMuted" Color="{DynamicResource MutedForegroundColor}"/>


    <RadialGradientBrush x:Key="GreenLed">
        <GradientStop Color="{DynamicResource SuccessColor}" Offset="0"/>
        <GradientStop Color="{DynamicResource AccentLightColor}" Offset="1"/>
    </RadialGradientBrush>

    <DropShadowEffect x:Key="GreenLedGlow"
                      BlurRadius="8" ShadowDepth="0"
                      Opacity="0.28" Color="{DynamicResource AccentLightColor}"/>

</ResourceDictionary>