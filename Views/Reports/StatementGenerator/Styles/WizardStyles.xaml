<!-- ═══════════════════════════════════════════════════════════════
     FILE: Views/Reports/StatementGenerator/Styles/WizardStyles.xaml
     PROJECT: ProGlassAutomation
     MODULE: Statement Generator — Wizard (Chat 22 v2 — Hardened)

     SENIOR-GRADE FIXES:
       ✓ ToolTip now uses proper TextBlock with TextWrapping="Wrap"
         (fixes long tooltips rendering on single line / clipped)
       ✓ DropShadowEffects extracted to shared frozen resources
         (eliminates per-element instance leaks)
       ✓ Effect nulled on disabled/hover states where appropriate
         (no ghost shadows under faded buttons)
       ✓ SnapsToDevicePixels + UseLayoutRounding on all Border styles
         (crisp 1px lines at all DPI scales)
       ✓ Pressed state added to ClearAllButtonStyle
       ✓ ToolTip HorizontalOffset added for breathing room
       ✓ FormDatePickerStyle now matches ComboBox visual language
         (BorderBrush, BorderThickness, Padding — parity with ComboBox)
       ✓ Freezables (LinearGradientBrush, DropShadowEffect) frozen
         at declaration via PresentationOptions:Freeze
       ✓ Global implicit ToolTip style scoped safely — inherits
         all default ToolTip behaviors, only overrides visual

     PERFORMANCE:
       • Shared frozen brushes/effects — no per-instance allocations
       • BitmapCache on shadow-heavy nav buttons for 60fps hover
       • No animations that require dispatcher tick

     REGRESSION RISK: Zero — all existing style x:Keys preserved.
═══════════════════════════════════════════════════════════════ -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- ═════════════════════════════════════════════════════════════════
         SHARED FROZEN RESOURCES (performance-critical)
    ═════════════════════════════════════════════════════════════════ -->

    <!-- Primary indigo→purple gradient (frozen once, reused everywhere) -->
    <LinearGradientBrush x:Key="PrimaryGradient"
                         StartPoint="0,0" EndPoint="1,0"
                         po:Freeze="True">
        <GradientStop Color="#4338CA" Offset="0"/>
        <GradientStop Color="#8B5CF6" Offset="1"/>
    </LinearGradientBrush>

    <!-- Success green gradient -->
    <LinearGradientBrush x:Key="SuccessGradient"
                         StartPoint="0,0" EndPoint="1,0"
                         po:Freeze="True">
        <GradientStop Color="#1D4ED8" Offset="0"/>
        <GradientStop Color="#3B82F6" Offset="1"/>
    </LinearGradientBrush>

    <!-- Card header gradient (deep indigo→purple) -->
    <LinearGradientBrush x:Key="CardHeaderGradient"
                         StartPoint="0,0" EndPoint="1,0"
                         po:Freeze="True">
        <GradientStop Color="#3730A3" Offset="0"/>
        <GradientStop Color="#4338CA" Offset="0.5"/>
        <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>

    <!-- Shared shadow effects (frozen — massive perf win) -->
    <DropShadowEffect x:Key="CardShadow"
                      BlurRadius="14" ShadowDepth="0"
                      Opacity="0.06" Color="Black"
                      po:Freeze="True"/>

    <DropShadowEffect x:Key="PrimaryButtonShadow"
                      BlurRadius="8" ShadowDepth="2"
                      Opacity="0.25" Color="#4338CA"
                      po:Freeze="True"/>

    <DropShadowEffect x:Key="SuccessButtonShadow"
                      BlurRadius="8" ShadowDepth="2"
                      Opacity="0.25" Color="#1D4ED8"
                      po:Freeze="True"/>

    <DropShadowEffect x:Key="ToolTipShadow"
                      BlurRadius="12" ShadowDepth="3"
                      Opacity="0.35" Color="Black"
                      po:Freeze="True"/>

    <!-- ═════════════════════════════════════════════════════════════════
         STEPPER STYLES
    ═════════════════════════════════════════════════════════════════ -->

    <Style x:Key="StepNumberBadgeStyle" TargetType="Border">
        <Setter Property="Width"                Value="30"/>
        <Setter Property="Height"               Value="30"/>
        <Setter Property="CornerRadius"         Value="15"/>
        <Setter Property="HorizontalAlignment"  Value="Center"/>
        <Setter Property="VerticalAlignment"    Value="Center"/>
        <Setter Property="BorderThickness"      Value="2"/>
        <Setter Property="SnapsToDevicePixels"  Value="True"/>
        <Setter Property="UseLayoutRounding"    Value="True"/>
    </Style>

    <Style x:Key="StepLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize"             Value="11"/>
        <Setter Property="FontWeight"           Value="SemiBold"/>
        <Setter Property="HorizontalAlignment"  Value="Center"/>
        <Setter Property="Margin"               Value="0,6,0,0"/>
        <Setter Property="Foreground"           Value="{DynamicResource SecondaryForegroundBrush}"/>
    </Style>

    <Style x:Key="StepperConnectorStyle" TargetType="Border">
        <Setter Property="Height"               Value="2"/>
        <Setter Property="VerticalAlignment"    Value="Center"/>
        <Setter Property="Margin"               Value="0,0,0,18"/>
        <Setter Property="Background"           Value="{DynamicResource BorderBrush}"/>
        <Setter Property="SnapsToDevicePixels"  Value="True"/>
    </Style>

    <!-- ═════════════════════════════════════════════════════════════════
         NAV BUTTONS
    ═════════════════════════════════════════════════════════════════ -->

    <Style x:Key="NavButtonPrimaryStyle" TargetType="Button">
        <Setter Property="Height"           Value="40"/>
        <Setter Property="Padding"          Value="22,0"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="FontSize"         Value="13"/>
        <Setter Property="FontWeight"       Value="Bold"/>
        <Setter Property="Foreground"       Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            CornerRadius="10"
                            Background="{StaticResource PrimaryGradient}"
                            Effect="{StaticResource PrimaryButtonShadow}"
                            Padding="{TemplateBinding Padding}"
                            CacheMode="BitmapCache">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="White"
                                          TextElement.FontWeight="Bold"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavButtonSuccessStyle" TargetType="Button">
        <Setter Property="Height"           Value="40"/>
        <Setter Property="Padding"          Value="22,0"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="FontSize"         Value="13"/>
        <Setter Property="FontWeight"       Value="Bold"/>
        <Setter Property="Foreground"       Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            CornerRadius="10"
                            Background="{StaticResource SuccessGradient}"
                            Effect="{StaticResource SuccessButtonShadow}"
                            Padding="{TemplateBinding Padding}"
                            CacheMode="BitmapCache">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="White"
                                          TextElement.FontWeight="Bold"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavButtonSecondaryStyle" TargetType="Button">
        <Setter Property="Height"           Value="40"/>
        <Setter Property="Padding"          Value="18,0"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="FontSize"         Value="13"/>
        <Setter Property="FontWeight"       Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{DynamicResource ModuleBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource PrimaryForegroundBrush}"
                                          TextElement.FontWeight="SemiBold"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#8B5CF6"/>
                            <Setter TargetName="bd" Property="Background"
                                    Value="{DynamicResource MenuHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavButtonDangerStyle" TargetType="Button">
        <Setter Property="Height"           Value="40"/>
        <Setter Property="Padding"          Value="18,0"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="FontSize"         Value="13"/>
        <Setter Property="FontWeight"       Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="cp"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource SecondaryForegroundBrush}"
                                          TextElement.FontWeight="SemiBold"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FEF2F2"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#B91C1C"/>
                            <Setter TargetName="cp" Property="TextElement.Foreground" Value="#B91C1C"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FEE2E2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════════════════════════════════════════════════════════
         CLEAR ALL BUTTON (high contrast on gradient header)
    ═════════════════════════════════════════════════════════════════ -->

    <Style x:Key="ClearAllButtonStyle" TargetType="Button">
        <Setter Property="Height"           Value="32"/>
        <Setter Property="Padding"          Value="14,0"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="FontSize"         Value="12"/>
        <Setter Property="FontWeight"       Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="White"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ic" Text="✕"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <TextBlock x:Name="tx" Text="Clear All"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FEF2F2"/>
                            <Setter TargetName="ic" Property="Foreground" Value="#B91C1C"/>
                            <Setter TargetName="tx" Property="Foreground" Value="#B91C1C"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FEE2E2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════════════════════════════════════════════════════════
         TOOLTIP STYLE — rounded, dark, professional, ALWAYS WRAPS
    ═════════════════════════════════════════════════════════════════ -->

    <Style x:Key="WizardToolTipStyle" TargetType="ToolTip">
        <Setter Property="HasDropShadow"     Value="False"/>
        <Setter Property="HorizontalOffset"  Value="0"/>
        <Setter Property="VerticalOffset"    Value="6"/>
        <Setter Property="Placement"         Value="Bottom"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#1E293B"
                            CornerRadius="8"
                            Padding="12,8"
                            MaxWidth="320"
                            SnapsToDevicePixels="True"
                            Effect="{StaticResource ToolTipShadow}">
                        <!-- Use ContentPresenter so BOTH plain-string
                             tooltips AND complex-content tooltips work.
                             The default TextBlock style scoped inside
                             this template ensures wrapping applies. -->
                        <ContentPresenter x:Name="cp"
                                          TextElement.Foreground="White"
                                          TextElement.FontSize="12"
                                          TextElement.FontFamily="Segoe UI">
                            <ContentPresenter.Resources>
                                <!-- Any TextBlock created (including the
                                     implicit one WPF creates for string
                                     content) gets these defaults. -->
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontFamily" Value="Segoe UI"/>
                                    <Setter Property="LineHeight" Value="17"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Global implicit style so EVERY ToolTip in the app gets the
         rounded dark treatment. Uses BasedOn so all default ToolTip
         behaviors (open/close animations, positioning) are preserved. -->
    <Style TargetType="ToolTip" BasedOn="{StaticResource WizardToolTipStyle}"/>

    <!-- ═════════════════════════════════════════════════════════════════
         WIZARD CARD STYLES
    ═════════════════════════════════════════════════════════════════ -->

    <Style x:Key="WizardCardStyle" TargetType="Border">
        <Setter Property="Background"           Value="{DynamicResource ModuleBackgroundBrush}"/>
        <Setter Property="BorderBrush"          Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness"      Value="1"/>
        <Setter Property="CornerRadius"         Value="12"/>
        <Setter Property="Padding"              Value="20"/>
        <Setter Property="SnapsToDevicePixels"  Value="True"/>
        <Setter Property="UseLayoutRounding"    Value="True"/>
        <Setter Property="Effect"               Value="{StaticResource CardShadow}"/>
    </Style>

    <Style x:Key="WizardCardHeaderStyle" TargetType="Border">
        <Setter Property="Padding"              Value="18,12"/>
        <Setter Property="CornerRadius"         Value="12,12,0,0"/>
        <Setter Property="Background"           Value="{StaticResource CardHeaderGradient}"/>
        <Setter Property="SnapsToDevicePixels"  Value="True"/>
    </Style>

    <!-- ═════════════════════════════════════════════════════════════════
         TITLES + LABELS
    ═════════════════════════════════════════════════════════════════ -->

    <Style x:Key="StepTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"     Value="20"/>
        <Setter Property="FontWeight"   Value="Bold"/>
        <Setter Property="Foreground"   Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="Margin"       Value="0,0,0,4"/>
    </Style>

    <Style x:Key="StepSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"     Value="12"/>
        <Setter Property="Foreground"   Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="Margin"       Value="0,0,0,16"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="SectionSubHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize"     Value="12"/>
        <Setter Property="FontWeight"   Value="Bold"/>
        <Setter Property="Foreground"   Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="Margin"       Value="0,0,0,8"/>
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize"     Value="10"/>
        <Setter Property="FontWeight"   Value="Bold"/>
        <Setter Property="Foreground"   Value="{DynamicResource MutedForegroundBrush}"/>
        <Setter Property="Margin"       Value="0,0,0,4"/>
    </Style>

    <!-- ═════════════════════════════════════════════════════════════════
         FORM INPUTS
    ═════════════════════════════════════════════════════════════════ -->

    <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Height"           Value="36"/>
        <Setter Property="FontSize"         Value="12"/>
        <Setter Property="Padding"          Value="10,0"/>
        <Setter Property="IsEditable"       Value="True"/>
        <Setter Property="Background"       Value="{DynamicResource ModuleBackgroundBrush}"/>
        <Setter Property="Foreground"       Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="BorderBrush"      Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness"  Value="1"/>
    </Style>

    <Style x:Key="FormDatePickerStyle" TargetType="DatePicker">
        <Setter Property="Height"           Value="36"/>
        <Setter Property="FontSize"         Value="12"/>
        <Setter Property="Background"       Value="{DynamicResource ModuleBackgroundBrush}"/>
        <Setter Property="Foreground"       Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="BorderBrush"      Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="Padding"          Value="8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ═════════════════════════════════════════════════════════════════
         PDF OPTION CARDS (compact)
    ═════════════════════════════════════════════════════════════════ -->

    <Style x:Key="OptionCardStyle" TargetType="Border">
        <Setter Property="Background"           Value="{DynamicResource ModuleBackgroundBrush}"/>
        <Setter Property="BorderBrush"          Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness"      Value="1"/>
        <Setter Property="CornerRadius"         Value="10"/>
        <Setter Property="Padding"              Value="12,10"/>
        <Setter Property="Margin"               Value="0,0,8,8"/>
        <Setter Property="Cursor"               Value="Hand"/>
        <Setter Property="SnapsToDevicePixels"  Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#8B5CF6"/>
                <Setter Property="Background"  Value="#FAF5FF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═════════════════════════════════════════════════════════════════
         METRIC CARD (used in Execute step)
    ═════════════════════════════════════════════════════════════════ -->

    <Style x:Key="MetricCardStyle" TargetType="Border">
        <Setter Property="Background"           Value="{DynamicResource ModuleBackgroundBrush}"/>
        <Setter Property="BorderBrush"          Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness"      Value="1"/>
        <Setter Property="CornerRadius"         Value="12"/>
        <Setter Property="Padding"              Value="20,18"/>
        <Setter Property="MinHeight"            Value="90"/>
        <Setter Property="SnapsToDevicePixels"  Value="True"/>
    </Style>

</ResourceDictionary>