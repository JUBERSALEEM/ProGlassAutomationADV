    <!-- ═════════════════════════════════════════════════════════════════
         NAV BUTTONS
    ═════════════════════════════════════════════════════════════════ -->

    <Style x:Key="NavButtonPrimaryStyle" TargetType="Button">
        <Setter Property="Height"           Value="40"/>
        <Setter Property="Padding"          Value="22,0"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Title}"/>
        <Setter Property="FontWeight"       Value="{DynamicResource Weight.Bold}"/>
        <Setter Property="Foreground"       Value="{DynamicResource OnAccentForegroundBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Background="{DynamicResource PrimaryGradient}"
                            Effect="{StaticResource PrimaryButtonShadow}"
                            Padding="{TemplateBinding Padding}"
                            CacheMode="BitmapCache">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource OnAccentForegroundBrush}"
                                          TextElement.FontWeight="{DynamicResource Weight.Bold}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavButtonSuccessStyle" TargetType="Button">
        <Setter Property="Height"           Value="40"/>
        <Setter Property="Padding"          Value="22,0"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Title}"/>
        <Setter Property="FontWeight"       Value="{DynamicResource Weight.Bold}"/>
        <Setter Property="Foreground"       Value="{DynamicResource OnAccentForegroundBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Background="{DynamicResource SuccessGradient}"
                            Effect="{StaticResource SuccessButtonShadow}"
                            Padding="{TemplateBinding Padding}"
                            CacheMode="BitmapCache">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource OnAccentForegroundBrush}"
                                          TextElement.FontWeight="{DynamicResource Weight.Bold}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavButtonSecondaryStyle" TargetType="Button">
        <Setter Property="Height"           Value="40"/>
        <Setter Property="Padding"          Value="18,0"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Title}"/>
        <Setter Property="FontWeight"       Value="{DynamicResource Weight.SemiBold}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{DynamicResource SurfacePrimaryBrush}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="{DynamicResource CardBorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
                                          TextElement.FontWeight="{DynamicResource Weight.SemiBold}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="bd" Property="Background"
                                    Value="{DynamicResource SurfaceTertiaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavButtonDangerStyle" TargetType="Button">
        <Setter Property="Height"           Value="40"/>
        <Setter Property="Padding"          Value="18,0"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Title}"/>
        <Setter Property="FontWeight"       Value="{DynamicResource Weight.SemiBold}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="{DynamicResource CardBorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="cp"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource TextSecondaryBrush}"
                                          TextElement.FontWeight="{DynamicResource Weight.SemiBold}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource TintRedBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                            <Setter TargetName="cp" Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource TintRedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

