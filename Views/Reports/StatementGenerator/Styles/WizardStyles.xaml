    <!-- ═════════════════════════════════════════════════════════════════
         TOOLTIP STYLE — rounded, dark, professional, ALWAYS WRAPS
    ═════════════════════════════════════════════════════════════════ -->

    <Style x:Key="WizardToolTipStyle" TargetType="ToolTip">
        <Setter Property="HasDropShadow"     Value="False"/>
        <Setter Property="HorizontalOffset"  Value="0"/>
        <Setter Property="VerticalOffset"    Value="6"/>
        <Setter Property="Placement"         Value="Bottom"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <!--
                      Background is PopupSurfaceBrush, and this is a bug fix
                      rather than a restyle. It was ModuleBackgroundBrush, which
                      is #00FFFFFF in LightTheme and #00000000 in DarkTheme —
                      alpha 00, i.e. FULLY TRANSPARENT in both. The tooltip had
                      no background at all, so whatever sat behind it showed
                      through, and because the text below was hardcoded White
                      the whole thing was white-on-white and unreadable.

                      PopupSurfaceBrush is the token that exists for exactly
                      this: opaque #FFF8FAFC in light, #FF111827 in dark.

                      A border is added because an opaque light surface on a
                      light window needs an edge to read as a popup.
                    -->
                    <Border Background="{DynamicResource PopupSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="12,8"
                            MaxWidth="320"
                            SnapsToDevicePixels="True"
                            Effect="{StaticResource ToolTipShadow}">
                        <!-- Use ContentPresenter so BOTH plain-string
                             tooltips AND complex-content tooltips work.
                             The default TextBlock style scoped inside
                             this template ensures wrapping applies. -->
                        <ContentPresenter x:Name="cp"
                                          TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
                                          TextElement.FontSize="{DynamicResource FontSize.Body}"
                                          TextElement.FontFamily="{DynamicResource AppFontFamily}">
                            <ContentPresenter.Resources>
                                <!-- Any TextBlock created (including the
                                     implicit one WPF creates for string
                                     content) gets these defaults. -->
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <!-- Was a hardcoded White, which is what
                                         made the text invisible once the
                                         background was fixed. Must track the
                                         theme. -->
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
                                    <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
                                    <Setter Property="LineHeight" Value="17"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Global implicit style so EVERY ToolTip in the app gets the rounded
         treatment. Uses BasedOn so all default ToolTip behaviors (open/close
         animations, positioning) are preserved.

         Note "dark" was removed from this comment: the treatment is
         theme-driven, and describing it as dark is part of how the hardcoded
         White text below survived review. It is merged app-wide from
         App.xaml, so a mistake here is not a Statement Generator problem — it
         is every tooltip in the product. -->

    <!-- Global implicit style REMOVED (2026-09 dialog audit): the app-wide
         implicit ToolTip style now lives centrally in
         Themes/Styles/DialogStyles.xaml (AppToolTipStyle — identical
         treatment: PopupSurfaceBrush, wrap, MaxWidth, theme foreground).
         This keyed style is retained for any explicit opt-in. -->

