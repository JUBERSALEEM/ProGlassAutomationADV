                                                   FontFamily="{DynamicResource FontFamily.Icon}"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <TextBlock Text="{Binding LastPdfFileName}"
                                       FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="360"/>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,10,0,0">
                                <Border Background="{DynamicResource TintIndigoBrush}"
                                        BorderBrush="{DynamicResource TintIndigoBrush}"
                                        BorderThickness="{DynamicResource Border.HairlineThickness}"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Padding="8,4"
                                        Margin="0,0,6,0" Style="{StaticResource SurfacePrimaryStyle}">
                                    <TextBlock Text="{Binding LastPdfPageInfo}"
                                               FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                                <Border Background="{DynamicResource TintPurpleBrush}"
                                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                                        BorderThickness="{DynamicResource Border.HairlineThickness}"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Padding="8,4" Style="{StaticResource SurfacePrimaryStyle}">
                                    <TextBlock Text="{Binding LastPdfSize}"
                                               FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                               Foreground="{DynamicResource AccentDarkBrush}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Download button (primary, big) -->
                        <Button Grid.Row="2"
                                Command="{Binding DownloadLastPdfCommand}"
                                Height="52" Margin="24,0,24,12"
                                Cursor="Hand" BorderThickness="{DynamicResource Border.NoneThickness}" Style="{StaticResource SecondaryButtonStyle}">
                            <Button.Template Style="{StaticResource SecondaryButtonStyle}">
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="{DynamicResource CardCornerRadius}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                                <GradientStop Color="{DynamicResource AccentLightColor}" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="3"
                                                              Opacity="0.3" Color="{DynamicResource AccentColor}"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="&#xE896;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.H2}" FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Reports.StatementGenerator.DownloadPDF}"
                                                       FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Share button (secondary) -->
                        <Button Grid.Row="3"
                                Command="{Binding ShareLastPdfCommand}"
