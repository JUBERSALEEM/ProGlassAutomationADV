                                               FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Giant PDF icon + filename -->
                        <StackPanel Grid.Row="1"
                                    Margin="24,32,24,24"
                                    HorizontalAlignment="Center">
                            <Border Width="96" Height="120"
                                    CornerRadius="{DynamicResource CardCornerRadius}"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,20">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{DynamicResource DangerColor}" Offset="0"/>
                                        <GradientStop Color="{DynamicResource DangerColor}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="4"
                                                      Opacity="0.25" Color="{DynamicResource DangerColor}"/>
                                </Border.Effect>
                                <Grid>
                                    <TextBlock Text="PDF"
                                               FontSize="{DynamicResource FontSize.Kpi}" FontWeight="{DynamicResource Weight.Regular}"
                                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <Border Width="24" Height="24"
                                            Background="{DynamicResource SurfacePrimaryBrush}"
                                            CornerRadius="{DynamicResource Radius.Medium}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top" Style="{StaticResource SurfacePrimaryStyle}">
