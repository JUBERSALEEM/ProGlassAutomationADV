                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Style="{StaticResource Typography.Title}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36"
                                        Background="{DynamicResource SurfacePrimaryBrush}"
                                        CornerRadius="{DynamicResource CardCornerRadius}"
                                        Margin="0,0,16,0" Style="{StaticResource SurfacePrimaryStyle}">
                                    <TextBlock Text="&#xE8F1;"
                                               FontFamily="{DynamicResource FontFamily.Icon}"
                                               FontSize="{DynamicResource FontSize.H2}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Reports.StatementGenerator.PDFSectionBrowser}"
                                               FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                    <TextBlock Text="{DynamicResource Reports.StatementGenerator.BrowseWhatSInsideMergedReport}"
                                               FontSize="{DynamicResource FontSize.Body}"
                                               Foreground="{DynamicResource OnAccentForegroundBrush}" Opacity="0.85"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Tabs -->
                        <Border CornerRadius="{DynamicResource CardCornerRadius}" Grid.Row="1"
                                BorderThickness="{DynamicResource Border.BottomHairlineThickness}"
                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                Padding="16,10" Style="{StaticResource SurfacePrimaryStyle}">
                            <StackPanel Orientation="Horizontal">

                                <!-- Merged tab -->
                                <Button Command="{Binding SelectMergedTabCommand}"
                                        Height="36" Padding="14,0" Margin="0,0,6,0"
                                        Cursor="Hand" BorderThickness="{DynamicResource Border.NoneThickness}" Style="{StaticResource SecondaryButtonStyle}">
                                    <Button.Template Style="{StaticResource SecondaryButtonStyle}">
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Padding="{TemplateBinding Padding}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowMergedTab}" Value="True">
                                                                <Setter Property="Background">
                                                                    <Setter.Value>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                                                            <GradientStop Color="{DynamicResource AccentLightColor}" Offset="1"/>
                                                                        </LinearGradientBrush>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShowMergedTab}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <Run Text="&#xE8A5;" FontFamily="{DynamicResource FontFamily.Icon}"/>
                                                        <Run Text="{DynamicResource Reports.StatementGenerator.Merged}"/>
                                                    </TextBlock>
                                                    <Border CornerRadius="{DynamicResource ControlCornerRadius}" Padding="6,1"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource SurfaceTertiaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShowMergedTab}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding MergedSectionCount}"
                                                                   FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource TextTertiaryBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ShowMergedTab}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Balance tab -->
                                <Button Command="{Binding SelectBalanceTabCommand}"
                                        Height="36" Padding="14,0" Margin="0,0,6,0"
                                        Cursor="Hand" BorderThickness="{DynamicResource Border.NoneThickness}" Style="{StaticResource SecondaryButtonStyle}">
                                    <Button.Template Style="{StaticResource SecondaryButtonStyle}">
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Padding="{TemplateBinding Padding}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowBalanceTab}" Value="True">
                                                                <Setter Property="Background">
                                                                    <Setter.Value>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                                                            <GradientStop Color="{DynamicResource AccentLightColor}" Offset="1"/>
                                                                        </LinearGradientBrush>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{DynamicResource Reports.StatementGenerator.Balance}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShowBalanceTab}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Border CornerRadius="{DynamicResource ControlCornerRadius}" Padding="6,1"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource SurfaceTertiaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShowBalanceTab}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding BalanceSectionCount}"
                                                                   FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource TextTertiaryBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ShowBalanceTab}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Alerts tab -->
                                <Button Command="{Binding SelectAlertsTabCommand}"
                                        Height="36" Padding="14,0"
                                        Cursor="Hand" BorderThickness="{DynamicResource Border.NoneThickness}" Style="{StaticResource SecondaryButtonStyle}">
                                    <Button.Template Style="{StaticResource SecondaryButtonStyle}">
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Padding="{TemplateBinding Padding}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowAlertsTab}" Value="True">
                                                                <Setter Property="Background">
                                                                    <Setter.Value>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                            <GradientStop Color="{DynamicResource WarningColor}" Offset="0"/>
                                                                            <GradientStop Color="{DynamicResource WarningColor}" Offset="1"/>
                                                                        </LinearGradientBrush>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{DynamicResource Reports.StatementGenerator.Alerts}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShowAlertsTab}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Border CornerRadius="{DynamicResource ControlCornerRadius}" Padding="6,1"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource SurfaceTertiaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShowAlertsTab}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding AlertsSectionCount}"
                                                                   FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource TextTertiaryBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ShowAlertsTab}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Section list (scrollable) -->
                        <ScrollViewer Grid.Row="2"
                                      Padding="16,12,16,16"
                                      MaxHeight="440"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      behaviors:SmoothScrollBehavior.IsEnabled="True">
                            <Grid>
                                <!-- Merged tab content -->
                                <ItemsControl ItemsSource="{Binding MergedPdfSections}"
                                              Visibility="{Binding ShowMergedTab,
                                                  Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfacePrimaryBrush}"
                                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                    BorderThickness="{DynamicResource CardBorderThickness}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Padding="14,12"
                                                    Margin="0,0,0,6" Style="{StaticResource SurfacePrimaryStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Width="34" Height="34"
                                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                                            Margin="0,0,14,0"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding IconBrushKey,
                                                                Converter={StaticResource BrushKeyConverter}}" Style="{StaticResource SurfacePrimaryStyle}">
                                                        <TextBlock Text="{Binding Icon}"
                                                                   FontFamily="{DynamicResource FontFamily.Icon}"
                                                                   FontSize="{DynamicResource FontSize.H3}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding PageInfo}"
                                                                   FontSize="{DynamicResource FontSize.Body}"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2"
                                                            CornerRadius="{DynamicResource ControlCornerRadius}" Padding="8,3"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding HasStatus,
                                                                Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Background="{Binding StatusBrushKey,
                                                                Converter={StaticResource BrushKeyConverter}}" Style="{StaticResource SurfacePrimaryStyle}">
                                                        <TextBlock Text="{Binding StatusLabel}"
                                                                   FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                                                   Foreground="{Binding StatusForegroundBrushKey,
                                                                   Converter={StaticResource BrushKeyConverter}}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Balance tab content -->
                                <ItemsControl ItemsSource="{Binding BalancePdfSections}"
                                              Visibility="{Binding ShowBalanceTab,
                                                  Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfacePrimaryBrush}"
                                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                    BorderThickness="{DynamicResource CardBorderThickness}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Padding="14,12"
                                                    Margin="0,0,0,6" Style="{StaticResource SurfacePrimaryStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Width="34" Height="34"
                                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                                            Margin="0,0,14,0"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding IconBrushKey,
                                                                Converter={StaticResource BrushKeyConverter}}" Style="{StaticResource SurfacePrimaryStyle}">
                                                        <TextBlock Text="{Binding Icon}"
                                                                   FontFamily="{DynamicResource FontFamily.Icon}"
                                                                   FontSize="{DynamicResource FontSize.H3}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding PageInfo}"
                                                                   FontSize="{DynamicResource FontSize.Body}"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2"
                                                            CornerRadius="{DynamicResource ControlCornerRadius}" Padding="8,3"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding HasStatus,
                                                                Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Background="{Binding StatusBrushKey,
                                                                Converter={StaticResource BrushKeyConverter}}" Style="{StaticResource SurfacePrimaryStyle}">
                                                        <TextBlock Text="{Binding StatusLabel}"
                                                                   FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                                                   Foreground="{Binding StatusForegroundBrushKey,
                                                                   Converter={StaticResource BrushKeyConverter}}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Alerts tab content -->
                                <ItemsControl ItemsSource="{Binding AlertsPdfSections}"
                                              Visibility="{Binding ShowAlertsTab,
                                                  Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfacePrimaryBrush}"
                                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                    BorderThickness="{DynamicResource CardBorderThickness}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Padding="14,12"
                                                    Margin="0,0,0,6" Style="{StaticResource SurfacePrimaryStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Width="34" Height="34"
                                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                                            Margin="0,0,14,0"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding IconBrushKey,
                                                                Converter={StaticResource BrushKeyConverter}}" Style="{StaticResource SurfacePrimaryStyle}">
                                                        <TextBlock Text="{Binding Icon}"
                                                                   FontFamily="{DynamicResource FontFamily.Icon}"
                                                                   FontSize="{DynamicResource FontSize.H3}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding PageInfo}"
                                                                   FontSize="{DynamicResource FontSize.Body}"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2"
                                                            CornerRadius="{DynamicResource ControlCornerRadius}" Padding="8,3"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding HasStatus,
                                                                Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Background="{Binding StatusBrushKey,
                                                                Converter={StaticResource BrushKeyConverter}}" Style="{StaticResource SurfacePrimaryStyle}">
                                                        <TextBlock Text="{Binding StatusLabel}"
                                                                   FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                                                   Foreground="{Binding StatusForegroundBrushKey,
                                                                   Converter={StaticResource BrushKeyConverter}}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ STATISTICS FOOTER ═══ -->
            <Border Grid.Row="11"
                    Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="20,14" Style="{StaticResource SurfacePrimaryStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="&#xE9D9;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.H3}"
                                   Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   VerticalAlignment="Center">
                            <Run Text="{DynamicResource Reports.StatementGenerator.ReportIncludes}"/>
                            <Run Text="{Binding MergedSectionCount, Mode=OneWay}"
                                 FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Run Text="{DynamicResource Reports.StatementGenerator.SectionS}"/>
                            <Run Text="{Binding ErrorCount, Mode=OneWay}"
                                 FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource DangerBrush}"/>
                            <Run Text="{DynamicResource Reports.StatementGenerator.ErrorS}"/>
                            <Run Text="{Binding WarningCount, Mode=OneWay}"
                                 FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource WarningBrush}"/>
                            <Run Text="{DynamicResource Reports.StatementGenerator.WarningS}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Reports.StatementGenerator.ProcessingComplete}"
                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>