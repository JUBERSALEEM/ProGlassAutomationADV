                                                    VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.Body}"
                                                       VerticalAlignment="Center"/>
