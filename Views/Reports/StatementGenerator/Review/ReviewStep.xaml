                                <TextBlock Grid.Column="2" Text="{DynamicResource Reports.StatementGenerator.DimensionsW1H1W2H2}" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextTertiaryBrush}"/>
