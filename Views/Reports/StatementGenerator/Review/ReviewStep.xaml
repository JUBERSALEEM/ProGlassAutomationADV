                                                                <TextBlock Grid.Column="2" Text="{Binding RawDimsDisplay}" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
