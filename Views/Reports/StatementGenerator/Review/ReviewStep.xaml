                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header with green gradient -->
                        <Border Grid.Row="0"
                                CornerRadius="{DynamicResource Radius.Top.Medium}"
                                Padding="24,20">
