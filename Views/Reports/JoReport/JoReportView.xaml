<UserControl x:Class="ProGlassAutomation.Views.Reports.JoReport.JoReportView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loading="clr-namespace:ProGlassAutomation.Controls.LoadingState"
             xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState"
             xmlns:reporting="clr-namespace:ProGlassAutomation.Controls.Reporting"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="{DynamicResource Ov.Canvas}"
             Foreground="{DynamicResource Ov.Ink}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Shared/Lists/StudioListResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Reclaimed vertical space: module title/subtitle lives in shell header -->
        <StackPanel Grid.Row="0" Visibility="Collapsed"/>

        <!-- Main Shell Card -->
        <Border Grid.Row="1" Style="{StaticResource Sl.Shell}" Margin="16,6,16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ══════════════════════════════════════════════════════════
                     1. KPI STRIP
                ══════════════════════════════════════════════════════════════ -->
                <Border Grid.Row="0" Style="{StaticResource ModuleListKpiStripStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Total JO -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{DynamicResource Reports.JoReport.TotalFactoryJobOrdersSystem}">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}" Background="{DynamicResource TintBlueBrush}">
                                <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.H3}" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Reports.JoReport.TotalJO}" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <Viewbox MaxHeight="24" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Summary.TotalJo}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                                </Viewbox>
                                <TextBlock Text="{Binding Summary.TotalValue, Mode=OneWay, StringFormat={}AED {0:N0}}" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <!-- Awaiting JO -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{DynamicResource Reports.JoReport.ApprovedProformaInvoicesYetConvertedJob}">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}" Background="{DynamicResource TintAmberBrush}">
                                <TextBlock Text="&#xE81C;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.H3}" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Reports.JoReport.AwaitingJO}" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <Viewbox MaxHeight="24" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Summary.AwaitingJo}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                                </Viewbox>
                                <TextBlock Text="{DynamicResource Reports.JoReport.PIAwaitingConversion}" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="3" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <!-- Quantity -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{DynamicResource Reports.JoReport.TotalGlassPieceCountSurfaceAreaProduction}">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}" Background="{DynamicResource TintGreenBrush}">
                                <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.H3}" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Common.Quantity}" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <Viewbox MaxHeight="24" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Summary.TotalQty, StringFormat={}{0:N0} pcs}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                                </Viewbox>
                                <TextBlock Text="{Binding Summary.TotalSqm, Mode=OneWay, Converter={StaticResource CurrencyConverter}, ConverterParameter=area}" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="5" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <!-- Quoted Value -->
                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{DynamicResource Reports.JoReport.TotalQuotedValueActiveJobOrders}">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}" Background="{DynamicResource TintIndigoBrush}">
                                <TextBlock Text="&#xE913;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.H3}" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Reports.JoReport.QuotedValue}" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <Viewbox MaxHeight="24" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Summary.TotalValue, StringFormat={}AED {0:N0}}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                                </Viewbox>
                                <TextBlock Text="{DynamicResource Reports.JoReport.ActiveJobValue}" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════════════════
                     2. FILTER BAR
                ══════════════════════════════════════════════════════════════ -->
                <Border Grid.Row="1" Style="{StaticResource ReportFilterCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                            <!-- Date From -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="{DynamicResource Common.FromDate}" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <DatePicker Width="135" Style="{StaticResource ModuleListFilterDatePickerStyle}" SelectedDate="{Binding DateFrom}" ToolTip="{DynamicResource Reports.JoReport.FilterDeliveryDateStart}"/>
                            </StackPanel>

                            <!-- Date To -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="{DynamicResource Common.ToDate}" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <DatePicker Width="135" Style="{StaticResource ModuleListFilterDatePickerStyle}" SelectedDate="{Binding DateTo}" ToolTip="{DynamicResource Reports.JoReport.FilterDeliveryDateEnd}"/>
                            </StackPanel>

                            <!-- Source PI -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="{DynamicResource Reports.JoReport.SourcePI}" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox Width="140" Style="{StaticResource ModernComboBoxStyle}" ItemsSource="{Binding SourcePiOptions}" SelectedItem="{Binding SourcePiFilter}" ToolTip="{DynamicResource Reports.JoReport.FilterSourceProformaInvoice}"/>
                            </StackPanel>

                            <!-- Customer -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="{DynamicResource Common.Customer}" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox Width="140" Style="{StaticResource ModernComboBoxStyle}" ItemsSource="{Binding CustomerOptions}" SelectedItem="{Binding SelectedCustomer}" ToolTip="{DynamicResource Reports.DeliveryReport.FilterCustomer}"/>
                            </StackPanel>

                            <!-- Project -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="{DynamicResource Common.Project}" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox Width="140" Style="{StaticResource ModernComboBoxStyle}" ItemsSource="{Binding ProjectOptions}" SelectedItem="{Binding SelectedProject}" ToolTip="{DynamicResource Reports.DeliveryReport.FilterProject}"/>
                            </StackPanel>

                            <!-- Status -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="{DynamicResource Common.Status}" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox Width="120" Style="{StaticResource ModernComboBoxStyle}" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" ToolTip="{DynamicResource Reports.JoReport.FilterProductionStatus}"/>
                            </StackPanel>

                            <!-- Sort by + direction -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="{DynamicResource Reports.Common.SortBy}" Style="{StaticResource ModuleFieldLabelStyle}" Foreground="{DynamicResource AccentBrush}"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Width="120" Style="{StaticResource ModernComboBoxStyle}" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" DisplayMemberPath="Display" ToolTip="{DynamicResource Reports.Common.SortByTip}"/>
                                    <Button Command="{Binding ToggleSortDirectionCommand}" Style="{StaticResource ReportToolbarOutlinedButton}" Margin="6,0,0,0" ToolTip="{Binding SortDirectionTooltip}" Content="{Binding SortDirectionGlyph}" FontFamily="{DynamicResource FontFamily.Icon}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,6,6">
                                <Button Content="{DynamicResource Action.Clear}" Tag="&#xE711;" Command="{Binding ClearFilterCommand}" Style="{StaticResource OutlinedPillButton}" MinWidth="110" ToolTip="{DynamicResource Action.ClearFilters}"/>
                            </StackPanel>
                        </WrapPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" VerticalAlignment="Bottom" Margin="8,0,0,6">
                            <TextBlock Text="{DynamicResource Action.Export}" Style="{StaticResource ModuleFieldLabelStyle}" HorizontalAlignment="Right"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource ReportExportOutlinedButton}" ToolTip="{DynamicResource Reports.JoReport.ExportCSV}"/>
                                <Button Content="{DynamicResource JobOrder.Excel}" Command="{Binding ExportExcelCommand}" Style="{StaticResource ReportExportOutlinedButton}" ToolTip="{DynamicResource Reports.JoReport.ExportExcelXlsx}"/>
                                <Button Content="PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource ReportExportPrimaryButton}" ToolTip="{DynamicResource Reports.JoReport.ExportPDFReport}"/>
                                <Button Content="&#xE72D;" FontFamily="{DynamicResource FontFamily.Icon}" Command="{Binding ShareCommand}" Style="{StaticResource ReportExportOutlinedButton}" ToolTip="{DynamicResource Sharing.Share}"/>
                            </StackPanel>
                        </StackPanel>
                    
                        <!-- Full-width search band — inventory-style accent
                             magnifier + borderless input (2026-09-10). -->
                        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource ReportSearchBandStyle}" Margin="0,12,0,0">
                            <DockPanel>
                                <TextBlock Text="&#xE721;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.H3}"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Style="{StaticResource ReportSearchInputStyle}"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                         ToolTip="JO # / PI #..."/>
                            </DockPanel>
                        </Border>
</Grid>
                </Border>

                                <!-- ══════════════════════════════════════════════════════════
                     3. SINGLE TABLE (header + rows, inline job details)
                ══════════════════════════════════════════════════════════ -->
                <!-- ══════════════════════════════════════════════════════════
                     2b. MIX ANALYTICS  (slice 2)
                     Layer 3 of the standard industrial report structure:
                     the breakdowns that EXPLAIN the KPI band above.
                     "47 job orders" is volume; "6mm Clear FT is 63% of it"
                     is what changes purchasing behaviour.
                     Computed from the same filtered set as the grid below,
                     so the analysis always reconciles to the rows.
                ══════════════════════════════════════════════════════════════ -->
                <Border Grid.Row="2"
                        Margin="10,0,10,10"
                        Visibility="{Binding HasAnalytics, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                    <Expander IsExpanded="False"
                              Foreground="{DynamicResource TextPrimaryBrush}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Reports.MixAnalysis}"
                                           FontSize="{DynamicResource FontSize.Body}"
                                           FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding Analytics.DominantSpecification}"
                                           FontSize="{DynamicResource FontSize.Body}"
                                           Margin="12,0,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="280"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{Binding Analytics.DominantColour}"
                                           FontSize="{DynamicResource FontSize.Body}"
                                           Margin="12,0,0,0"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </StackPanel>
                        </Expander.Header>

                        <UniformGrid Columns="3" Margin="0,8,0,0">
                            <reporting:MixPanel
                                Title="{DynamicResource Reports.TopSpecifications}"
                                Subtitle="{DynamicResource Reports.BySqm}"
                                Rows="{Binding Analytics.TopSpecifications}"
                                Margin="0,0,8,0"/>
                            <reporting:MixPanel
                                Title="{DynamicResource Reports.TopColours}"
                                Subtitle="{DynamicResource Reports.BySqm}"
                                Rows="{Binding Analytics.TopColours}"
                                Margin="4,0,4,0"/>
                            <reporting:MixPanel
                                Title="{DynamicResource Reports.TopCustomers}"
                                Subtitle="{DynamicResource Reports.ByValue}"
                                Rows="{Binding Analytics.TopCustomers}"
                                Margin="8,0,0,0"/>
                        </UniformGrid>
                    </Expander>
                </Border>

                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ReportTableHeaderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="0.7*"/>
                                <ColumnDefinition Width="0.7*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ReportHeaderTextStyle}" Grid.Column="0" Text="{DynamicResource Reports.JoReport.JO}"/>
                            <TextBlock Style="{StaticResource ReportHeaderTextStyle}" Grid.Column="1" Text="{DynamicResource Reports.DeliveryReport.PI}"/>
                            <TextBlock Style="{StaticResource ReportHeaderTextStyle}" Grid.Column="2" Text="{DynamicResource Common.Company}"/>
                            <TextBlock Style="{StaticResource ReportHeaderTextStyle}" Grid.Column="3" Text="{DynamicResource Reports.JoReport.CustomerProject}"/>
                            <TextBlock Style="{StaticResource ReportHeaderTextStyle}" Grid.Column="4" Text="{DynamicResource Common.Salesman}"/>
                            <TextBlock Style="{StaticResource ReportHeaderTextStyle}" Grid.Column="5" Text="{DynamicResource Inquiry.Prepared2}"/>
                            <TextBlock Style="{StaticResource ReportHeaderTextStyle}" Grid.Column="6" Text="{DynamicResource Common.Status}" HorizontalAlignment="Center"/>
                            <TextBlock Style="{StaticResource ReportHeaderTextStyle}" Grid.Column="7" Text="TOTAL" HorizontalAlignment="Right" Margin="0,0,14,0"/>
                            <TextBlock Style="{StaticResource ReportHeaderTextStyle}" Grid.Column="8" Text="{DynamicResource Reports.JoReport.QTYSQM}" HorizontalAlignment="Right" Margin="0,0,14,0"/>
                            <TextBlock Style="{StaticResource ReportHeaderTextStyle}" Grid.Column="9" Text="{DynamicResource Reports.JoReport.DelivBAL}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <loading:LoadingStateControl Grid.Row="1" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" Message="Loading Job Order records…"/>
                    <emptyState:EmptyStateControl Grid.Row="1" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" Title="{DynamicResource Reports.JoReport.NoJobOrdersFound}" Message="Adjust your filters or convert a Proforma Invoice to a Job Order." Icon="&#xE8B7;"/>

                    <Border Grid.Row="1" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="{DynamicResource TintRedBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}"
                            CornerRadius="{DynamicResource CardCornerRadius}" Margin="16" Padding="20">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE783;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.Display}" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Reports.DeliveryReport.UnableLoadRecords}" FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,4,0,12" MaxWidth="500" TextAlignment="Center"/>
                            <Button Content="{DynamicResource Action.Retry}" Command="{Binding RefreshCommand}" Style="{StaticResource ReportRetryButton}" HorizontalAlignment="Center" ToolTip="{DynamicResource Reports.DeliveryReport.RetryLoadingRecords}"/>
                        </StackPanel>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Rows}"
                             Style="{StaticResource ModuleReportListBoxStyle}"
                             Visibility="{Binding IsContentVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <!-- Row -->
                                    <Border Style="{StaticResource ModuleListRowStyle}" Padding="14,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="88"/>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="0.7*"/>
                                                <ColumnDefinition Width="0.7*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding SerialNumber}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Serial number on this page"/>
                                                <TextBlock Text="{Binding JobOrderId}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SourceProformaId}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding CompanyName}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding CustomerName}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ProjectName}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="4" Text="{Binding Salesman}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                            <TextBlock Grid.Column="5" Text="{Binding PreparedBy}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>

                                            <Border Grid.Column="6" CornerRadius="{DynamicResource Radius.Small}" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource TintBlueBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="InProduction"><Setter Property="Background" Value="{DynamicResource TintAmberBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="In Production"><Setter Property="Background" Value="{DynamicResource TintAmberBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Completed"><Setter Property="Background" Value="{DynamicResource TintGreenBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Delivered"><Setter Property="Background" Value="{DynamicResource TintIndigoBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Draft"><Setter Property="Background" Value="{DynamicResource TintGrayBrush}"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding Status}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="InProduction">
                                                                    <Setter Property="Text" Value="In Production"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="In Production">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Delivered">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Draft">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <TextBlock Grid.Column="7" Text="{Binding GrandTotal, StringFormat={}AED {0:N0}}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            <TextBlock Grid.Column="8" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0">
                                                <Run Text="{Binding TotalQty, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding TotalSqm, Mode=OneWay, StringFormat={}{0:N1}}"/>
                                            </TextBlock>
                                            <TextBlock Grid.Column="9" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="{DynamicResource FontSize.Body}">
                                                <Run Text="{Binding DeliveredQty, Mode=OneWay}" Foreground="{DynamicResource SuccessBrush}"/><Run Text=" / "/><Run Text="{Binding BalanceQty, Mode=OneWay}" Foreground="{DynamicResource WarningBrush}"/>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <!-- Inline job details (single grid — no side panel) -->
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,2,0,6">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource Reports.JoReport.JobOrderDetails}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">
                                            <Button Content="{DynamicResource Inquiry.OpenJobOrder}"
                                                    Command="{Binding DataContext.OpenDocumentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource PrimaryPillButton}"
                                                    Height="36" Margin="0,0,0,10"
                                                    HorizontalAlignment="Left"
                                                    ToolTip="{DynamicResource Reports.JoReport.OpenOriginalJobOrderWorkspace}"/>

                                            <Border Background="{DynamicResource SurfacePrimaryBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}" CornerRadius="{DynamicResource Radius.Small}" Padding="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="108"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Common.JobOrder}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding JobOrderId}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource AccentBrush}" Margin="0,2"/>

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Reports.DeliveryReport.PINumber}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SourceProformaId}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Common.Company}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CompanyName}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2" TextWrapping="Wrap"/>

                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Common.Customer}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CustomerName}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2" TextWrapping="Wrap"/>

                                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Common.Project}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2"/>
                                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProjectName}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2" TextWrapping="Wrap"/>

                                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource Common.Salesman}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2"/>
                                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Salesman}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>

                                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource Inquiry.Prepared2}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2"/>
                                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding PreparedBy}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>

                                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="{DynamicResource Common.Status}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2"/>
                                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Status}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>

                                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="{DynamicResource Nav.Delivery}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2"/>
                                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding DeliveryDate, StringFormat={}{0:dd MMM yyyy}}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>

                                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="{DynamicResource Reports.JoReport.TotalValue}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2"/>
                                                    <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding GrandTotal, Converter={StaticResource CurrencyConverter}, ConverterParameter=prefix}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource AccentBrush}" Margin="0,2"/>
                                                </Grid>
                                            </Border>

                                            <Border Background="{DynamicResource SurfacePrimaryBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}" CornerRadius="{DynamicResource Radius.Small}" Padding="12,10" Margin="0,8,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{DynamicResource Reports.DeliveryReport.TotalQTY}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                        <TextBlock Text="{Binding TotalQty}" FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{DynamicResource Common.Delivered}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                        <TextBlock Text="{Binding DeliveredQty}" FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource SuccessBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{DynamicResource Common.Balance}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                        <TextBlock Text="{Binding BalanceQty}" FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource WarningBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Audit timestamps: aligned label/value grid so the
                                                 date never touches its label and both rows line up. -->
                                            <Border Background="{DynamicResource SurfacePrimaryBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}" CornerRadius="{DynamicResource Radius.Small}" Padding="12,10" Margin="0,8,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource Reports.JoReport.Audit}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,8"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="108"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Reports.JoReport.Created}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2"/>
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CreatedAt, Mode=OneWay, StringFormat={}{0:dd MMM yyyy  HH:mm}}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Reports.JoReport.LastUpdated}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UpdatedAt, Mode=OneWay, StringFormat={}{0:dd MMM yyyy  HH:mm}}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>


                <!-- ══════════════════════════════════════════════════════════
                     5. PAGINATION FOOTER
                ══════════════════════════════════════════════════════════════ -->
                <Border Grid.Row="4" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="{DynamicResource Border.TopHairlineThickness}" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding PageDisplay}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{DynamicResource Reports.DeliveryReport.Prev}" Command="{Binding PrevPageCommand}" Style="{StaticResource ReportPaginationButton}" ToolTip="{DynamicResource Reports.DeliveryReport.GoPreviousPage}"/>
                            <Button Content="{DynamicResource Reports.DeliveryReport.Next}" Command="{Binding NextPageCommand}" Style="{StaticResource ReportPaginationButton}" ToolTip="{DynamicResource Reports.DeliveryReport.GoNextPage}"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>