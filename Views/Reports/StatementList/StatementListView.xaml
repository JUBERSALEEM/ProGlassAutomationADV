<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Reports/StatementList/StatementListView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Statement Generator — saved statements list

     2026-09-14 REBUILD (owner: "recents / statement / new statement
     section is ugly — upgrade it"): the page used the pre-design-system
     look — solid rainbow KPI blocks, an accent-on-accent header with
     four decorative dots, and row cards full of solid colour blocks
     whose amount columns did not line up with the header row.

     Now the standard module-list language (Tax Invoice / Delivery Note /
     Saved Job Orders parity):
       • surface page header + accent icon tile + PrimaryPillButton
       • tinted KPI cards (12px gutters, coloured value, hairline border)
       • standard search bar (surface card, ghost clear, outlined refresh)
       • ModuleListTableHeaderStyle header band with the SAME column
         grid as the rows — labels and data align per column
       • rows = surface cards: tinted status pill, coloured amount text
         (no solid blocks), ghost icon action buttons
     Every binding, command and localization key from the previous
     revision is preserved verbatim.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl
    x:Class="ProGlassAutomation.Views.Reports.StatementList.StatementListView"
             TextOptions.TextHintingMode="Fixed"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
    FontFamily="{DynamicResource AppFontFamily}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- Ghost icon action button for the row actions (PDF / SHARE /
             EDIT / DELETE). Hover fills with the button's own tint. -->
        <Style x:Key="StatementGhostActionStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                BorderThickness="{DynamicResource Border.HairlineThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tinted KPI card — one card shape, colour by state. -->
        <Style x:Key="StatementKpiCardStyle" TargetType="Border"
               BasedOn="{StaticResource SurfacePrimaryStyle}">
            <Setter Property="BorderThickness" Value="{DynamicResource Border.HairlineThickness}"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ ROW 0 — PAGE HEADER (surface card + accent icon tile) ══ -->
        <Border Grid.Row="0"
                Margin="24,16,24,0"
                Style="{StaticResource SurfacePrimaryStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="52" Height="52"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SurfaceDetailStyle}"
                        Background="{DynamicResource TintIndigoBrush}">
                    <TextBlock Text="&#xE8A5;"
                               FontFamily="{DynamicResource FontFamily.Icon}"
                               FontSize="{DynamicResource FontSize.H1}"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Nav.StatementGenerator}"
                               FontSize="{DynamicResource FontSize.BodySmall}"
                               FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Text="{DynamicResource Reports.AccountStatements}"
                               FontSize="{DynamicResource FontSize.H1}"
                               FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="{DynamicResource FontSize.Body}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Command="{Binding NewStatementCommand}"
                        Style="{StaticResource PrimaryPillButton}"
                        Tag="&#xE710;"
                        Content="{DynamicResource Reports.NewStatement}"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══ ROW 1 — KPI STRIP (tinted cards, 12px gutters) ══ -->
        <Grid Grid.Row="1" Margin="24,14,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource StatementKpiCardStyle}"
                    Background="{DynamicResource TintBlueBrush}"
                    BorderBrush="{DynamicResource AccentBrush}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Dashboard.Statements}"
                               Style="{StaticResource ModuleListKpiLabelStyle}"/>
                    <TextBlock Text="{Binding TotalStatements}"
                               Style="{StaticResource ModuleListKpiValueStyle}"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{DynamicResource Reports.TotalSaved}"
                               Style="{StaticResource ModuleListKpiHintStyle}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource StatementKpiCardStyle}"
                    Background="{DynamicResource TintGreenBrush}"
                    BorderBrush="{DynamicResource SuccessBrush}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Reports.TotalInvoiced}"
                               Style="{StaticResource ModuleListKpiLabelStyle}"/>
                    <TextBlock Text="{Binding TotalInvoicedDisplay}"
                               Style="{StaticResource ModuleListKpiValueStyle}"
                               Foreground="{DynamicResource SuccessBrush}"/>
                    <TextBlock Text="{DynamicResource Reports.Statements}"
                               Style="{StaticResource ModuleListKpiHintStyle}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4"
                    Style="{StaticResource StatementKpiCardStyle}"
                    Background="{DynamicResource TintAmberBrush}"
                    BorderBrush="{DynamicResource WarningBrush}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Common.Outstanding}"
                               Style="{StaticResource ModuleListKpiLabelStyle}"/>
                    <TextBlock Text="{Binding TotalOutstandingDisplay}"
                               Style="{StaticResource ModuleListKpiValueStyle}"
                               Foreground="{DynamicResource WarningBrush}"/>
                    <TextBlock Text="{DynamicResource Reports.TotalBalanceDue}"
                               Style="{StaticResource ModuleListKpiHintStyle}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="6">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StatementKpiCardStyle}">
                        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TintRedBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Common.Overdue}"
                               Style="{StaticResource ModuleListKpiLabelStyle}"/>
                    <TextBlock Text="{Binding TotalOverdueDisplay}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ModuleListKpiValueStyle}">
                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{DynamicResource Reports.PastDueDate}"
                               Style="{StaticResource ModuleListKpiHintStyle}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ ROW 2 — SEARCH BAR ══ -->
        <Border Grid.Row="2"
                Margin="24,14,24,0"
                Padding="10,8"
                Style="{StaticResource SurfacePrimaryStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Height="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="&#xE721;"
                               FontFamily="{DynamicResource FontFamily.Icon}"
                               FontSize="{DynamicResource FontSize.Body}"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0,8,0"
                               IsHitTestVisible="False"/>

                    <Grid Grid.Column="1">
                        <TextBlock Text="{DynamicResource Reports.SearchNumberCustomerProject}"
                                   FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding HasSearchText,
                                      Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <TextBox Text="{Binding SearchText,
                                     UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="{DynamicResource FontSize.Body}"
                                 Background="Transparent"
                                 BorderThickness="{DynamicResource Border.NoneThickness}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 VerticalContentAlignment="Center"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 SelectionBrush="{DynamicResource AccentBrush}"
                                 Style="{StaticResource TextBoxStyle}"/>
                    </Grid>

                    <Button Grid.Column="2"
                            Style="{StaticResource RowDangerButton}"
                            Tag="&#xE711;"
                            ToolTip="{DynamicResource Reports.ClearSearch}"
                            Command="{Binding ClearSearchCommand}"
                            Width="28" Height="28" MinWidth="28" Padding="0"
                            FontSize="{DynamicResource FontSize.Body}"
                            Cursor="Hand"
                            Foreground="{DynamicResource TextTertiaryBrush}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="6,0,2,0"
                            Visibility="{Binding HasSearchText,
                                Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>

                <Button Grid.Column="2"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource OutlinedPillButton}"
                        Tag="&#xE72C;"
                        Content="{DynamicResource Action.Refresh}"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══ ROW 3 — COLUMN HEADERS (module standard band; the SAME
             column grid the rows use, so labels and data align) ══ -->
        <Border Grid.Row="3"
                Margin="24,12,24,0"
                Style="{StaticResource ModuleListTableHeaderStyle}"
                Visibility="{Binding IsListVisible,
                    Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1"
                           Text="{DynamicResource Reports.StatementCustomer}"
                           Style="{StaticResource ModuleListHeaderTextStyle}"
                           Margin="14,0"/>
                <TextBlock Grid.Column="2"
                           Text="{DynamicResource Common.Invoiced}"
                           Style="{StaticResource ModuleListHeaderTextStyle}"
                           HorizontalAlignment="Right" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="3"
                           Text="{DynamicResource Common.Outstanding}"
                           Style="{StaticResource ModuleListHeaderTextStyle}"
                           HorizontalAlignment="Right" Margin="0,0,16,0"/>
                    <TextBlock Grid.Column="4"
                               Text="{DynamicResource Common.Status}"
                               Style="{StaticResource ModuleListHeaderTextStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="5"
                               Text="{DynamicResource Common.Actions}"
                               Style="{StaticResource ModuleListHeaderTextStyle}"
                               HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══ ROW 4 — CONTENT ══ -->
        <Grid Grid.Row="4" Margin="24,4,24,8">

            <!-- Loading -->
            <Border Style="{StaticResource SurfacePrimaryStyle}"
                    Visibility="{Binding IsLoading,
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,48,0,48">
                    <Border Width="64" Height="64"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Background="{DynamicResource TintIndigoBrush}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8A5;"
                                   FontFamily="{DynamicResource FontFamily.Icon}"
                                   FontSize="{DynamicResource FontSize.Kpi}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{DynamicResource Dashboard.LoadingStatements}"
                               FontSize="{DynamicResource FontSize.H3}"
                               FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"/>
                    <TextBlock Text="{DynamicResource Reports.PreparingDataTotals}"
                               FontSize="{DynamicResource FontSize.Body}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Empty -->
            <Border Style="{StaticResource SurfacePrimaryStyle}"
                    Visibility="{Binding IsEmpty,
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="440"
                            Margin="0,48,0,48">
                    <Border Width="64" Height="64"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Background="{DynamicResource TintIndigoBrush}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,18">
                        <TextBlock Text="&#xE7C3;"
                                   FontFamily="{DynamicResource FontFamily.Icon}"
                                   FontSize="{DynamicResource FontSize.Kpi}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="{DynamicResource Dashboard.NoStatementsYet}"
                               FontSize="{DynamicResource FontSize.H2}"
                               FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Reports.CreateFirstAccountStatementTrackInvoices}"
                               FontSize="{DynamicResource FontSize.Body}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Margin="0,0,0,20"/>

                    <Button Content="{DynamicResource Reports.NewStatement}"
                            Command="{Binding NewStatementCommand}"
                            Style="{StaticResource PrimaryPillButton}"
                            Tag="&#xE710;"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- List -->
            <ListView ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow}"
                      Background="Transparent"
                      BorderThickness="{DynamicResource Border.NoneThickness}"
                      HorizontalContentAlignment="Stretch"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      VirtualizingPanel.CacheLength="400,800"
                      VirtualizingPanel.CacheLengthUnit="Pixel"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.IsDeferredScrollingEnabled="False"
                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                      Visibility="{Binding IsListVisible,
                          Converter={StaticResource BoolToVisibilityConverter}}">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border ClipToBounds="True">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <!-- SAME column grid as the header band -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="170"/>
                                </Grid.ColumnDefinitions>

                                <!-- Accent rail (red when overdue) -->
                                <Border Grid.Column="0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- COL 1: Statement info -->
                                <StackPanel Grid.Column="1" Margin="14,12,8,12">
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,6">
                                        <TextBlock Text="{Binding StatementNumber, Mode=OneWay}"
                                                   FontSize="{DynamicResource FontSize.Title}"
                                                   FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="  /  "
                                                   FontSize="{DynamicResource FontSize.Title}"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        <TextBlock Text="{Binding SubTitle, Mode=OneWay}"
                                                   FontSize="{DynamicResource FontSize.Title}"
                                                   FontWeight="{DynamicResource Weight.SemiBold}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{DynamicResource TintIndigoBrush}"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Padding="8,3"
                                                Margin="0,0,8,0">
                                            <TextBlock FontSize="{DynamicResource FontSize.BodySmall}"
                                                       FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource AccentBrush}">
                                                <Run Text="{Binding InvoiceCount, Mode=OneWay}"/>
                                                <Run Text="{DynamicResource Reports.Inv}"/>
                                            </TextBlock>
                                        </Border>

                                        <TextBlock Text="{Binding CreatedAtDisplay, Mode=OneWay}"
                                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>

                                        <Border Background="{DynamicResource TintGreenBrush}"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Padding="8,3"
                                                Visibility="{Binding HasAttachments,
                                                    Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{DynamicResource DeliveryNote.Attachments}"
                                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                                       FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource SuccessBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- COL 2: Invoiced (coloured text, right-aligned) -->
                                <StackPanel Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            Margin="0,12,16,12"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalInvoicedDisplay, Mode=OneWay}"
                                               FontSize="{DynamicResource FontSize.Title}"
                                               FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                </StackPanel>

                                <!-- COL 3: Outstanding (coloured text, right-aligned) -->
                                <StackPanel Grid.Column="3"
                                            HorizontalAlignment="Right"
                                            Margin="0,12,16,12"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalOutstandingDisplay, Mode=OneWay}"
                                               FontSize="{DynamicResource FontSize.Title}"
                                               FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource WarningBrush}"/>
                                    <TextBlock Visibility="{Binding HasOverdue,
                                                   Converter={StaticResource BoolToVisibilityConverter}}"
                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                               FontWeight="{DynamicResource Weight.SemiBold}"
                                               Foreground="{DynamicResource DangerBrush}"
                                               Margin="0,3,0,0">
                                        <Run Text="{DynamicResource Common.Overdue}"/>
                                        <Run Text="{Binding OverdueAmountDisplay, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- COL 4: Status pill (tinted, not solid) -->
                                <Border Grid.Column="4"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Padding="12,5"
                                        Background="{DynamicResource TintGreenBrush}"
                                        BorderBrush="{DynamicResource SuccessBrush}"
                                        BorderThickness="{DynamicResource Border.HairlineThickness}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource TintGreenBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                            <Setter Property="BorderThickness" Value="{DynamicResource Border.HairlineThickness}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource TintRedBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="{DynamicResource FontSize.BodySmall}"
                                               FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource SuccessBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Current"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                                        <Setter Property="Text" Value="Overdue"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- COL 5: Actions (ghost icon buttons) -->
                                <StackPanel Grid.Column="5"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center">

                                    <Button Style="{StaticResource StatementGhostActionStyle}"
                                            Background="{DynamicResource TintIndigoBrush}"
                                            Foreground="{DynamicResource AccentBrush}"
                                            ToolTip="PDF"
                                            Command="{Binding DataContext.OpenPdfCommand,
                                                RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding HasPdf}">
                                        <TextBlock Text="PDF"
                                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                                   FontWeight="{DynamicResource Weight.Bold}"/>
                                    </Button>

                                    <Button Style="{StaticResource StatementGhostActionStyle}"
                                            Background="{DynamicResource TintGreenBrush}"
                                            Foreground="{DynamicResource SuccessBrush}"
                                            ToolTip="{DynamicResource Sharing.Share}"
                                            Command="{Binding DataContext.ShareStatementCommand,
                                                RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding HasPdf}">
                                        <TextBlock Text="&#xE72D;"
                                                   FontFamily="{DynamicResource FontFamily.Icon}"
                                                   FontSize="{DynamicResource FontSize.Body}"/>
                                    </Button>

                                    <Button Style="{StaticResource StatementGhostActionStyle}"
                                            Background="{DynamicResource TintAmberBrush}"
                                            Foreground="{DynamicResource WarningBrush}"
                                            Command="{Binding DataContext.EditStatementCommand,
                                                RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="&#xE70F;"
                                                   FontFamily="{DynamicResource FontFamily.Icon}"
                                                   FontSize="{DynamicResource FontSize.Body}"/>
                                    </Button>

                                    <Button Style="{StaticResource StatementGhostActionStyle}"
                                            Background="{DynamicResource TintRedBrush}"
                                            Foreground="{DynamicResource DangerBrush}"
                                            Command="{Binding DataContext.DeleteStatementCommand,
                                                RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="&#xE74D;"
                                                   FontFamily="{DynamicResource FontFamily.Icon}"
                                                   FontSize="{DynamicResource FontSize.Body}"/>
                                    </Button>
                                </StackPanel>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </Grid>
    </Grid>
</UserControl>
