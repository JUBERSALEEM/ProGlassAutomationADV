<!-- Studio Bento list: original collections, workflows and data contexts retained. -->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors" xmlns:layout="clr-namespace:ProGlassAutomation.Views.Dashboard" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ProGlassAutomation.Views.Reports.StatementList.StatementListView" TextOptions.TextHintingMode="Fixed" FontFamily="{DynamicResource AppFontFamily}" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True" SnapsToDevicePixels="True" Background="{DynamicResource Ov.Canvas}" Foreground="{DynamicResource Ov.Ink}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Shared/Lists/StudioListResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="StatementGhostActionStyle" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="{DynamicResource ControlCornerRadius}" Background="Transparent" BorderBrush="{DynamicResource Ov.Line}" BorderThickness="{DynamicResource Border.HairlineThickness}" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter
                                        TargetName="bd"
                                        Property="Background"
                                        Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.75" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Ov.Accent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Reclaimed vertical space: module title/subtitle lives in shell header; StatusMessage preserved -->
        <Grid Grid.Row="0" Margin="16,4,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource Reports.AccountStatements}" Style="{StaticResource Sl.Title}" Visibility="Collapsed" />
                <TextBlock Text="{DynamicResource Nav.StatementGenerator}" Style="{StaticResource Sl.Subtitle}" Visibility="Collapsed" />
                <TextBlock
                    Text="{Binding StatusMessage}"
                    Style="{StaticResource Sl.Subtitle}"
                    Margin="0"
                    Typography.NumeralAlignment="Tabular" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Sl.Shell}" Margin="16,0,16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource Sl.ToolbarHeight}}" Grid.Row="0" x:Name="ToolbarViewport">
                    <StackPanel Margin="0,0,0,8">
                        <layout:IndigoDashboardPanel MaxColumns="3" MinimumColumnWidth="270" Gap="14">
                            <Border Style="{StaticResource Sl.Hero}">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0">
                                        <StackPanel Margin="0" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{DynamicResource Common.Outstanding}"
                                                Style="{StaticResource Sl.Label}"
                                                TextWrapping="Wrap"
                                                Foreground="{DynamicResource Ov.OnAccent}" />
                                            <Viewbox MaxHeight="30" HorizontalAlignment="Left">
                                                <TextBlock
                                                    Text="{Binding TotalOutstandingDisplay}"
                                                    Style="{StaticResource Sl.Value}"
                                                    Foreground="{DynamicResource Ov.OnAccent}"
                                                    TextWrapping="Wrap"
                                                    FontSize="30"
                                                    Typography.NumeralAlignment="Tabular"
                                                    ToolTip="{Binding TotalOutstandingDisplay}" />
                                            </Viewbox>
                                            <TextBlock
                                                Text="{DynamicResource Reports.TotalBalanceDue}"
                                                Style="{StaticResource Sl.Subtitle}"
                                                TextWrapping="Wrap"
                                                Foreground="{DynamicResource Ov.OnAccent}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock
                                        Text="Saved statement snapshots may overlap. Overdue is included in outstanding."
                                        Style="{StaticResource Sl.Subtitle}"
                                        Foreground="{DynamicResource Ov.OnAccentMuted}"
                                        Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                            <layout:IndigoDashboardPanel MaxColumns="2" MinimumColumnWidth="110" Gap="10">
                                <Border Style="{StaticResource Sl.Card}" Padding="14,10">
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0">
                                        <StackPanel Margin="0" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{DynamicResource Dashboard.Statements}"
                                                Style="{StaticResource Sl.Label}"
                                                TextWrapping="Wrap" />
                                            <Viewbox MaxHeight="24" HorizontalAlignment="Left">
                                                <TextBlock
                                                    Text="{Binding TotalStatements, StringFormat=N0}"
                                                    Style="{StaticResource Sl.Value}"
                                                    TextWrapping="Wrap"
                                                    Typography.NumeralAlignment="Tabular" />
                                            </Viewbox>
                                            <TextBlock
                                                Text="{DynamicResource Reports.TotalSaved}"
                                                Style="{StaticResource Sl.Subtitle}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Sl.Card}" Padding="14,10">
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0">
                                        <StackPanel Margin="0" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{DynamicResource Reports.TotalInvoiced}"
                                                Style="{StaticResource Sl.Label}"
                                                TextWrapping="Wrap" />
                                            <Viewbox MaxHeight="24" HorizontalAlignment="Left">
                                                <TextBlock
                                                    Text="{Binding TotalInvoicedDisplay}"
                                                    Style="{StaticResource Sl.Value}"
                                                    Foreground="{DynamicResource Ov.Success}"
                                                    TextWrapping="Wrap"
                                                    Typography.NumeralAlignment="Tabular"
                                                    ToolTip="{Binding TotalInvoicedDisplay}" />
                                            </Viewbox>
                                            <TextBlock
                                                Text="{DynamicResource Reports.Statements}"
                                                Style="{StaticResource Sl.Subtitle}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Sl.Card}" Padding="14,10">
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0">
                                        <StackPanel Margin="0" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{DynamicResource Common.Overdue}"
                                                Style="{StaticResource Sl.Label}"
                                                TextWrapping="Wrap" />
                                            <Viewbox MaxHeight="24" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding TotalOverdueDisplay}" TextWrapping="Wrap" Typography.NumeralAlignment="Tabular">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Sl.Value}">
                                                            <Setter Property="Foreground" Value="{DynamicResource Ov.Muted}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Ov.Danger}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Viewbox>
                                            <TextBlock
                                                Text="{DynamicResource Reports.PastDueDate}"
                                                Style="{StaticResource Sl.Subtitle}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </layout:IndigoDashboardPanel>
                            <Border Style="{StaticResource Sl.Card}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Common.Actions}" Style="{StaticResource Sl.Label}" />
                                    <Button
                                        Command="{Binding NewStatementCommand}"
                                        Style="{StaticResource Sl.PrimaryButton}"
                                        Tag="&#xE710;"
                                        Content="{DynamicResource Reports.NewStatement}"
                                        VerticalAlignment="Center"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Stretch" />
                                    <Button
                                        Command="{Binding RefreshCommand}"
                                        Style="{StaticResource Sl.Button}"
                                        Tag="&#xE72C;"
                                        Content="{DynamicResource Action.Refresh}"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Stretch" />
                                    <Border Style="{StaticResource Sl.Error}" Margin="0,8,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Sl.Subtitle}" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </layout:IndigoDashboardPanel>
                        <Border Style="{StaticResource Sl.FilterBar}">
                            <WrapPanel>
                                <StackPanel>
                                    <TextBlock Text="Search" Style="{StaticResource Sl.Label}" Margin="0,0,0,5" />
                                    <Grid Margin="0,0,10,8" Width="280">
                                        <TextBox
                                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                            Style="{StaticResource Sl.Input}"
                                            ToolTip="{DynamicResource Reports.SearchNumberCustomerProject}" />
                                        <TextBlock
                                            Text="{DynamicResource Reports.SearchNumberCustomerProject}"
                                            FontSize="{DynamicResource FontSize.Body}"
                                            Foreground="{DynamicResource Ov.Muted}"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding HasSearchText, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                    </Grid>
                                </StackPanel>
                                <Button
                                    Style="{StaticResource Sl.DangerButton}"
                                    Tag="&#xE711;"
                                    ToolTip="{DynamicResource Reports.ClearSearch}"
                                    Command="{Binding ClearSearchCommand}"
                                    Width="32"
                                    Height="32"
                                    MinWidth="32"
                                    Padding="2"
                                    Margin="0,0,10,8"
                                    Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVisibilityConverter}}"
                                    VerticalAlignment="Bottom" />
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Border Style="{StaticResource Sl.Card}" Padding="0" Grid.Row="1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False" x:Name="RegisterViewport">
                        <Grid MinWidth="1120" Width="{Binding ViewportWidth, ElementName=RegisterViewport, Converter={StaticResource Sl.Extent}}" Height="{Binding ViewportHeight, ElementName=RegisterViewport, Converter={StaticResource Sl.Extent}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource Sl.TableHeader}" Visibility="{Binding IsListVisible,                             Converter={StaticResource BoolToVisibilityConverter}}" Margin="{Binding Source={x:Static SystemParameters.VerticalScrollBarWidth}, Converter={StaticResource Sl.Gutter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="1.5*" MinWidth="140" />
                                        <ColumnDefinition Width="0.9*" MinWidth="95" />
                                        <ColumnDefinition Width="0.9*" MinWidth="95" />
                                        <ColumnDefinition Width="0.8*" MinWidth="85" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{DynamicResource Reports.StatementCustomer}"
                                        Style="{StaticResource Sl.ColumnLabel}"
                                        Margin="12,0" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{DynamicResource Common.Invoiced}"
                                        Style="{StaticResource Sl.ColumnLabel}"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,12,0" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{DynamicResource Common.Outstanding}"
                                        Style="{StaticResource Sl.ColumnLabel}"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,12,0" />
                                    <TextBlock
                                        Grid.Column="4"
                                        Text="{DynamicResource Common.Status}"
                                        Style="{StaticResource Sl.ColumnLabel}"
                                        HorizontalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="5"
                                        Text="{DynamicResource Common.Actions}"
                                        Style="{StaticResource Sl.ColumnLabel}"
                                        HorizontalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1" Style="{StaticResource Sl.DataArea}">
                                <Border Panel.ZIndex="2" Visibility="{Binding IsLoading,                                 Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,48,0,48">
                                        <Border Width="64" Height="64" CornerRadius="{DynamicResource CardCornerRadius}" Background="{DynamicResource Ov.Soft}" HorizontalAlignment="Center">
                                            <TextBlock
                                                Text="&#xE8A5;"
                                                FontFamily="{DynamicResource FontFamily.Icon}"
                                                FontSize="{DynamicResource FontSize.Kpi}"
                                                Foreground="{DynamicResource Ov.Accent}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock
                                            Text="{DynamicResource Dashboard.LoadingStatements}"
                                            FontSize="{DynamicResource FontSize.H3}"
                                            FontWeight="{DynamicResource Weight.Bold}"
                                            Foreground="{DynamicResource Ov.Ink}"
                                            HorizontalAlignment="Center"
                                            Margin="0,16,0,0" />
                                        <TextBlock
                                            Text="{DynamicResource Reports.PreparingDataTotals}"
                                            FontSize="{DynamicResource FontSize.Body}"
                                            Foreground="{DynamicResource Ov.Muted}"
                                            HorizontalAlignment="Center"
                                            Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Panel.ZIndex="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty,                                 Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Margin="0,48,0,48">
                                        <Border Width="64" Height="64" CornerRadius="{DynamicResource CardCornerRadius}" Background="{DynamicResource Ov.Soft}" HorizontalAlignment="Center" Margin="0,0,0,16">
                                            <TextBlock
                                                Text="&#xE7C3;"
                                                FontFamily="{DynamicResource FontFamily.Icon}"
                                                FontSize="{DynamicResource FontSize.Kpi}"
                                                Foreground="{DynamicResource Ov.Accent}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock
                                            Text="{DynamicResource Dashboard.NoStatementsYet}"
                                            FontSize="{DynamicResource FontSize.H2}"
                                            FontWeight="{DynamicResource Weight.Bold}"
                                            Foreground="{DynamicResource Ov.Ink}"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,8" />
                                        <TextBlock
                                            Text="{DynamicResource Reports.CreateFirstAccountStatementTrackInvoices}"
                                            FontSize="{DynamicResource FontSize.Body}"
                                            TextWrapping="Wrap"
                                            TextAlignment="Center"
                                            Foreground="{DynamicResource Ov.Muted}"
                                            Margin="0,0,0,20" />
                                        <Button
                                            Content="{DynamicResource Reports.NewStatement}"
                                            Command="{Binding NewStatementCommand}"
                                            Style="{StaticResource Sl.PrimaryButton}"
                                            Tag="&#xE710;"
                                            HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ListView Panel.ZIndex="0" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" Background="Transparent" BorderThickness="{DynamicResource Border.NoneThickness}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="400,800" VirtualizingPanel.CacheLengthUnit="Pixel" ScrollViewer.CanContentScroll="True" ScrollViewer.IsDeferredScrollingEnabled="False" ScrollViewer.PanningMode="None" behaviors:SmoothScrollBehavior.IsEnabled="True" Visibility="{Binding IsListVisible,                                   Converter={StaticResource BoolToVisibilityConverter}}" Focusable="True" Padding="0" ItemContainerStyle="{StaticResource Sl.StatementItem}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Sl.Row}" MinHeight="56">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3" />
                                                        <ColumnDefinition Width="1.5*" MinWidth="140" />
                                                        <ColumnDefinition Width="0.9*" MinWidth="95" />
                                                        <ColumnDefinition Width="0.9*" MinWidth="95" />
                                                        <ColumnDefinition Width="0.8*" MinWidth="85" />
                                                        <ColumnDefinition Width="190" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource Ov.Accent}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource Ov.Danger}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,8,8,8" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Vertical" Margin="0,0,0,4">
                                                            <TextBlock
                                                                Text="{Binding StatementNumber, Mode=OneWay}"
                                                                FontSize="{DynamicResource FontSize.Title}"
                                                                FontWeight="{DynamicResource Weight.Bold}"
                                                                Foreground="{DynamicResource Ov.Accent}"
                                                                Typography.NumeralAlignment="Tabular" />
                                                            <TextBlock
                                                                Text=""
                                                                FontSize="{DynamicResource FontSize.Title}"
                                                                Foreground="{DynamicResource Ov.Muted}" />
                                                            <TextBlock
                                                                Text="{Binding SubTitle, Mode=OneWay}"
                                                                FontSize="{DynamicResource FontSize.Title}"
                                                                FontWeight="{DynamicResource Weight.SemiBold}"
                                                                ToolTip="{Binding SubTitle, Mode=OneWay}"
                                                                Foreground="{DynamicResource Ov.Ink}"
                                                                TextTrimming="CharacterEllipsis"
                                                                VerticalAlignment="Center"
                                                                Typography.NumeralAlignment="Tabular"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Background="{DynamicResource Ov.Soft}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="8,4" Margin="0,0,8,0">
                                                                <TextBlock FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.Accent}">
                                                                    <Run Text="{Binding InvoiceCount, Mode=OneWay}" />
                                                                    <Run Text="{DynamicResource Reports.Inv}" />
                                                                </TextBlock>
                                                            </Border>
                                                            <TextBlock
                                                                Text="{Binding CreatedAtDisplay, Mode=OneWay}"
                                                                FontSize="{DynamicResource FontSize.BodySmall}"
                                                                Foreground="{DynamicResource Ov.Muted}"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,8,0"
                                                                Typography.NumeralAlignment="Tabular" />
                                                            <Border Background="{DynamicResource Ov.SuccessSoft}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="8,4" Visibility="{Binding HasAttachments,                                                             Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock
                                                                    Text="{DynamicResource DeliveryNote.Attachments}"
                                                                    FontSize="{DynamicResource FontSize.BodySmall}"
                                                                    FontWeight="{DynamicResource Weight.Bold}"
                                                                    Foreground="{DynamicResource Ov.Success}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Text="{Binding TotalInvoicedDisplay, Mode=OneWay}"
                                                        FontSize="{DynamicResource FontSize.Title}"
                                                        FontWeight="{DynamicResource Weight.Bold}"
                                                        Foreground="{DynamicResource Ov.Success}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,12,0"
                                                        Typography.NumeralAlignment="Tabular"
                                                        TextWrapping="Wrap"
                                                        ToolTip="{Binding TotalInvoicedDisplay, Mode=OneWay}" />
                                                    <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,12,8">
                                                        <TextBlock
                                                            Text="{Binding TotalOutstandingDisplay, Mode=OneWay}"
                                                            FontSize="{DynamicResource FontSize.Title}"
                                                            FontWeight="{DynamicResource Weight.Bold}"
                                                            Foreground="{DynamicResource Ov.Warning}"
                                                            Typography.NumeralAlignment="Tabular"
                                                            TextWrapping="Wrap"
                                                            ToolTip="{Binding TotalOutstandingDisplay, Mode=OneWay}" />
                                                        <TextBlock Visibility="{Binding HasOverdue,                                                            Converter={StaticResource BoolToVisibilityConverter}}" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource Ov.Danger}" Margin="0,4,0,0">
                                                            <Run Text="{DynamicResource Common.Overdue}" />
                                                            <Run Text="{Binding OverdueAmountDisplay, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Border Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="8,4">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource Ov.SuccessSoft}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource Ov.Success}" />
                                                                <Setter
                                                                    Property="BorderThickness"
                                                                    Value="{DynamicResource Border.HairlineThickness}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource Ov.DangerSoft}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Ov.Danger}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Current" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource Ov.Success}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                                                            <Setter Property="Text" Value="Overdue" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource Ov.Danger}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <WrapPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,0,8,0">
                                                        <Button Style="{StaticResource StatementGhostActionStyle}" Background="{DynamicResource Ov.Soft}" Foreground="{DynamicResource Ov.Accent}" ToolTip="PDF" Command="{Binding DataContext.OpenPdfCommand,                                                         RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" IsEnabled="{Binding HasPdf}">
                                                            <TextBlock
                                                                Text="PDF"
                                                                FontSize="{DynamicResource FontSize.BodySmall}"
                                                                FontWeight="{DynamicResource Weight.Bold}" />
                                                        </Button>
                                                        <Button Style="{StaticResource StatementGhostActionStyle}" Background="{DynamicResource Ov.SuccessSoft}" Foreground="{DynamicResource Ov.Success}" ToolTip="{DynamicResource Sharing.Share}" Command="{Binding DataContext.ShareStatementCommand,                                                         RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" IsEnabled="{Binding HasPdf}">
                                                            <TextBlock
                                                                Text="&#xE72D;"
                                                                FontFamily="{DynamicResource FontFamily.Icon}"
                                                                FontSize="{DynamicResource FontSize.Body}" />
                                                        </Button>
                                                        <Button Style="{StaticResource StatementGhostActionStyle}" Background="{DynamicResource Ov.WarningSoft}" Foreground="{DynamicResource Ov.Warning}" Command="{Binding DataContext.EditStatementCommand,                                                         RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" ToolTip="Edit statement" AutomationProperties.Name="Edit statement">
                                                            <TextBlock
                                                                Text="&#xE70F;"
                                                                FontFamily="{DynamicResource FontFamily.Icon}"
                                                                FontSize="{DynamicResource FontSize.Body}" />
                                                        </Button>
                                                        <Button Style="{StaticResource StatementGhostActionStyle}" Background="{DynamicResource Ov.DangerSoft}" Foreground="{DynamicResource Ov.Danger}" Command="{Binding DataContext.DeleteStatementCommand,                                                         RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" ToolTip="Delete statement" AutomationProperties.Name="Delete statement">
                                                            <TextBlock
                                                                Text="&#xE74D;"
                                                                FontFamily="{DynamicResource FontFamily.Icon}"
                                                                FontSize="{DynamicResource FontSize.Body}" />
                                                        </Button>
                                                    </WrapPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
