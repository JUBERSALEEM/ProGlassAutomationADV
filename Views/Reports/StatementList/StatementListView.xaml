<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Reports/StatementList/StatementListView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Account Statement / Sales Report (Chat 16)

     FIX vs PREVIOUS VERSION:
       Clear search button visibility:
         OLD: Visibility="{Binding SearchText,
                  Converter={StaticResource BoolToVisibilityConverter}}"
              PROBLEM: BoolToVisibilityConverter expects bool.
                       SearchText is string → runtime converter exception.
         NEW: Visibility="{Binding HasSearchText,
                  Converter={StaticResource BoolToVisibilityConverter}}"
              HasSearchText is bool property on VM → correct.

       IsEmpty binding on ListView:
         OLD: Visibility="{Binding IsEmpty,
                  Converter={StaticResource InverseBoolToVisibilityConverter}}"
              PROBLEM: Shows list when IsEmpty=false which includes loading.
         NEW: Unchanged — IsEmpty VM fix (Fix 3) handles the logic.
              ListView uses InverseBoolToVisibility correctly.

     All other markup IDENTICAL to previous version.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl
    x:Class="ProGlassAutomation.Views.Reports.StatementList.StatementListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
    FontFamily="Segoe UI"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    TextOptions.TextHintingMode="Fixed"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ ROW 0 — HEADER ══ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SideMenuBackgroundBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush}"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="SALES REPORT"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,0,2"/>
                    <TextBlock Text="Account Statements"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="+ New Statement"
                        Command="{Binding NewStatementCommand}"
                        Height="40" Padding="20,0"
                        FontSize="13" FontWeight="SemiBold"
                        Cursor="Hand"
                        Foreground="White"
                        BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background"
                                    Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="10"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="bd"
                                                        Property="Opacity"
                                                        Value="0.88"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- ══ ROW 1 — KPI CARDS ══ -->
        <Grid Grid.Row="1" Margin="24,16,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SideMenuBackgroundBrush}"
                    CornerRadius="12" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="📋  STATEMENTS"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock Text="{Binding TotalStatements}"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="Total saved"
                               FontSize="11"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource SideMenuBackgroundBrush}"
                    CornerRadius="12" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="💰  TOTAL INVOICED"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock Text="{Binding TotalInvoicedDisplay}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TintIndigoBrush}"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="Across all statements"
                               FontSize="11"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4"
                    Background="{DynamicResource SideMenuBackgroundBrush}"
                    CornerRadius="12" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="⏳  OUTSTANDING"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock Text="{Binding TotalOutstandingDisplay}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TintAmberBrush}"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="Total balance due"
                               FontSize="11"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="6"
                    CornerRadius="12" Padding="16,14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background"
                                Value="{DynamicResource SideMenuBackgroundBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasOverdue}"
                                         Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource TintRedBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="🔴  OVERDUE"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock Text="{Binding TotalOverdueDisplay}"
                               FontSize="18" FontWeight="Bold"
                               Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource MutedForegroundBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOverdue}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="#B91C1C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="Past due date"
                               FontSize="11"
                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ ROW 2 — SEARCH BAR ══ -->
        <Border Grid.Row="2"
                Margin="24,16,24,0"
                Background="{DynamicResource SideMenuBackgroundBrush}"
                CornerRadius="10"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource ModuleBackgroundBrush}"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Padding="10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="🔍" FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="{DynamicResource MutedForegroundBrush}"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText,
                                     UpdateSourceTrigger=PropertyChanged}"
                                 Height="36" FontSize="13"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource PrimaryForegroundBrush}"
                                 VerticalContentAlignment="Center">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Resources>
                                        <VisualBrush
                                            x:Key="HintBrush"
                                            Stretch="None"
                                            AlignmentX="Left"
                                            AlignmentY="Center">
                                            <VisualBrush.Visual>
                                                <TextBlock
                                                    Text="Search by number, customer, project…"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Style.Resources>
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background"
                                                    Value="{StaticResource HintBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!--
                            FIX: Binding changed from SearchText (string)
                            to HasSearchText (bool).
                            BoolToVisibilityConverter requires bool input.
                            SearchText is string → caused runtime exception.
                        -->
                        <Button Grid.Column="2"
                                Content="✕"
                                Command="{Binding ClearSearchCommand}"
                                Width="24" Height="24"
                                FontSize="11"
                                Cursor="Hand"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource MutedForegroundBrush}"
                                Visibility="{Binding HasSearchText,
                                    Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <Button Grid.Column="1"
                        Content="↻  Refresh"
                        Command="{Binding RefreshCommand}"
                        Height="36" Padding="14,0"
                        Margin="8,0,0,0"
                        FontSize="12" FontWeight="SemiBold"
                        Cursor="Hand"
                        Foreground="{DynamicResource PrimaryForegroundBrush}"
                        Background="{DynamicResource ModuleBackgroundBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd"
                                            Property="BorderBrush"
                                            Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ══ ROW 3 — LIST ══ -->
        <Grid Grid.Row="3" Margin="24,12,24,16">

            <!-- Loading overlay -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    CornerRadius="12"
                    Visibility="{Binding IsLoading,
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="⏳" FontSize="32"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Loading statements…"
                               FontSize="14"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Empty state — only visible after load completes with 0 rows -->
            <Border Background="{DynamicResource SideMenuBackgroundBrush}"
                    CornerRadius="12"
                    Visibility="{Binding IsEmpty,
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="📊" FontSize="48"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="No Statements Yet"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,4"/>
                    <TextBlock
                        Text="Click '+ New Statement' to generate your first account statement."
                        FontSize="13"
                        Foreground="{DynamicResource MutedForegroundBrush}"
                        HorizontalAlignment="Center"
                        TextWrapping="Wrap"
                        MaxWidth="360"/>
                    <Button Content="+ New Statement"
                            Command="{Binding NewStatementCommand}"
                            Height="40" Padding="24,0"
                            Margin="0,20,0,0"
                            FontSize="13" FontWeight="SemiBold"
                            Cursor="Hand"
                            Foreground="White"
                            BorderThickness="0"
                            HorizontalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd"
                                        Background="{DynamicResource AccentBrush}"
                                        CornerRadius="10"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd"
                                                Property="Opacity" Value="0.88"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Statements ListView (virtualized) -->
            <ListView
                ItemsSource="{Binding Rows}"
                SelectedItem="{Binding SelectedRow}"
                Background="Transparent"
                BorderThickness="0"
                HorizontalContentAlignment="Stretch"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                VirtualizingPanel.ScrollUnit="Pixel"
                ScrollViewer.CanContentScroll="False"
                ScrollViewer.IsDeferredScrollingEnabled="False"
                behaviors:SmoothScrollBehavior.IsEnabled="True"
                Visibility="{Binding IsEmpty,
                    Converter={StaticResource InverseBoolToVisibilityConverter}}">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Background="{DynamicResource SideMenuBackgroundBrush}"
                            CornerRadius="12"
                            Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Orientation="Horizontal">
                                        <TextBlock
                                            Text="{Binding StatementNumber}"
                                            FontSize="13" FontWeight="Bold"
                                            Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text=" — " FontSize="13"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        <TextBlock
                                            Text="{Binding SubTitle}"
                                            FontSize="13" FontWeight="SemiBold"
                                            Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        <Border Margin="10,0,0,0"
                                                Background="{DynamicResource TintIndigoBrush}"
                                                CornerRadius="6" Padding="6,2"
                                                Visibility="{Binding HasAttachments,
                                                    Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="📎 Attachments"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                                Orientation="Horizontal"
                                                Margin="0,6,0,0">
                                        <TextBlock FontSize="12"
                                                   Foreground="{DynamicResource MutedForegroundBrush}">
                                            <Run Text="Invoiced: "/>
                                            <Run Text="{Binding TotalInvoicedDisplay}"
                                                 FontWeight="SemiBold"
                                                 Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        </TextBlock>
                                        <TextBlock Text="  ·  " FontSize="12"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        <TextBlock FontSize="12"
                                                   Foreground="{DynamicResource MutedForegroundBrush}">
                                            <Run Text="Outstanding: "/>
                                            <Run Text="{Binding TotalOutstandingDisplay}"
                                                 FontWeight="SemiBold"/>
                                        </TextBlock>
                                        <TextBlock Text="  ·  " FontSize="12"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   Visibility="{Binding HasOverdue,
                                                       Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBlock FontSize="12"
                                                   Visibility="{Binding HasOverdue,
                                                       Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Run Text="Overdue: "/>
                                            <Run Text="{Binding OverdueAmountDisplay}"
                                                 FontWeight="Bold"
                                                 Foreground="#B91C1C"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Orientation="Horizontal"
                                                Margin="0,4,0,0">
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource MutedForegroundBrush}">
                                            <Run Text="{Binding InvoiceCount}"/>
                                            <Run Text=" invoice(s)  ·  Generated "/>
                                            <Run Text="{Binding CreatedAtDisplay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0">

                                    <Button Content="📄 Open PDF"
                                            Command="{Binding DataContext.OpenPdfCommand,
                                                RelativeSource={RelativeSource
                                                    AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            Height="34" Padding="12,0"
                                            FontSize="12" FontWeight="SemiBold"
                                            Cursor="Hand" Margin="0,0,8,0"
                                            IsEnabled="{Binding HasPdf}"
                                            Foreground="{DynamicResource AccentBrush}"
                                            Background="{DynamicResource TintIndigoBrush}"
                                            BorderThickness="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger
                                                                    Binding="{Binding RelativeSource={RelativeSource
                                                                        TemplatedParent},
                                                                        Path=IsEnabled}"
                                                                    Value="False">
                                                                    <Setter Property="Opacity"
                                                                            Value="0.4"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <ContentPresenter
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter TargetName="bd"
                                                                Property="Opacity"
                                                                Value="0.8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button Content="✏ Edit"
                                            Command="{Binding DataContext.EditStatementCommand,
                                                RelativeSource={RelativeSource
                                                    AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            Height="34" Padding="12,0"
                                            FontSize="12" FontWeight="SemiBold"
                                            Cursor="Hand" Margin="0,0,8,0"
                                            Foreground="{DynamicResource PrimaryForegroundBrush}"
                                            Background="{DynamicResource ModuleBackgroundBrush}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource BorderBrush}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter TargetName="bd"
                                                                Property="BorderBrush"
                                                                Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button Content="🗑"
                                            Command="{Binding DataContext.DeleteStatementCommand,
                                                RelativeSource={RelativeSource
                                                    AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            Width="34" Height="34"
                                            FontSize="14" Cursor="Hand"
                                            Background="{DynamicResource TintRedBrush}"
                                            BorderThickness="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="8">
                                                    <ContentPresenter
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter TargetName="bd"
                                                                Property="Opacity"
                                                                Value="0.8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>