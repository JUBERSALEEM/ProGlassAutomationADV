<!-- Statement list — Archetype 1 (saved statements register).
     Bindings, commands, IsEmpty / IsListVisible / HasSearchText,
     InverseBoolToVisibilityConverter, ListView selection: unchanged. -->
<UserControl Style="{StaticResource ErpPageRootStyle}"
             x:Class="ProGlassAutomation.Views.Reports.StatementList.StatementListView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="StatementGhostActionStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                BorderThickness="{DynamicResource Border.HairlineThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,16,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource Reports.AccountStatements}"
                           Style="{StaticResource ModulePageTitleStyle}"/>
                <TextBlock Text="{DynamicResource Nav.StatementGenerator}"
                           Style="{StaticResource ModulePageSubtitleStyle}"/>
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource ModulePageSubtitleStyle}"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Command="{Binding NewStatementCommand}"
                    Style="{StaticResource PrimaryPillButton}"
                    Tag="&#xE710;"
                    Content="{DynamicResource Reports.NewStatement}"
                    MinWidth="192"
                    VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource ModuleListShellStyle}" Margin="16,0,16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource ModuleListKpiStripStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintBlueBrush}">
                                <TextBlock Text="&#xE8A5;"
                                           FontFamily="{DynamicResource FontFamily.Icon}"
                                           FontSize="{DynamicResource FontSize.H3}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Dashboard.Statements}"
                                           Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding TotalStatements, StringFormat=N0}"
                                           Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="{DynamicResource Reports.TotalSaved}"
                                           Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintGreenBrush}">
                                <TextBlock Text="&#xE8A3;"
                                           FontFamily="{DynamicResource FontFamily.Icon}"
                                           FontSize="{DynamicResource FontSize.H3}"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Reports.TotalInvoiced}"
                                           Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding TotalInvoicedDisplay}"
                                           Style="{StaticResource ModuleListKpiValueStyle}"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                                <TextBlock Text="{DynamicResource Reports.Statements}"
                                           Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="3" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintAmberBrush}">
                                <TextBlock Text="&#xE8C7;"
                                           FontFamily="{DynamicResource FontFamily.Icon}"
                                           FontSize="{DynamicResource FontSize.H3}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Common.Outstanding}"
                                           Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding TotalOutstandingDisplay}"
                                           Style="{StaticResource ModuleListKpiValueStyle}"
                                           Foreground="{DynamicResource WarningBrush}"/>
                                <TextBlock Text="{DynamicResource Reports.TotalBalanceDue}"
                                           Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="5" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintRedBrush}">
                                <TextBlock Text="&#xE7BA;"
                                           FontFamily="{DynamicResource FontFamily.Icon}"
                                           FontSize="{DynamicResource FontSize.H3}"
                                           Foreground="{DynamicResource DangerBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Common.Overdue}"
                                           Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding TotalOverdueDisplay}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ModuleListKpiValueStyle}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{DynamicResource Reports.PastDueDate}"
                                           Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource ModuleListFilterBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="160"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Margin="0,0,8,0">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                     Style="{StaticResource ModuleListFilterInputStyle}"
                                     ToolTip="{DynamicResource Reports.SearchNumberCustomerProject}"/>
                            <TextBlock Text="{DynamicResource Reports.SearchNumberCustomerProject}"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding HasSearchText,
                                          Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        </Grid>
                        <ScrollViewer Grid.Column="1"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollBarVisibility="Auto">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource RowDangerButton}"
                                        Tag="&#xE711;"
                                        ToolTip="{DynamicResource Reports.ClearSearch}"
                                        Command="{Binding ClearSearchCommand}"
                                        Width="32"
                                        Height="32"
                                        MinWidth="32"
                                        Padding="0"
                                        Margin="0,0,8,0"
                                        Visibility="{Binding HasSearchText,
                                            Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Button Command="{Binding RefreshCommand}"
                                        Style="{StaticResource OutlinedPillButton}"
                                        Tag="&#xE72C;"
                                        Content="{DynamicResource Action.Refresh}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Style="{StaticResource ModuleListTableHeaderStyle}"
                        Visibility="{Binding IsListVisible,
                            Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="1.5*" MinWidth="140"/>
                            <ColumnDefinition Width="0.9*" MinWidth="95"/>
                            <ColumnDefinition Width="0.9*" MinWidth="95"/>
                            <ColumnDefinition Width="0.8*" MinWidth="85"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1"
                                   Text="{DynamicResource Reports.StatementCustomer}"
                                   Style="{StaticResource ModuleListHeaderTextStyle}"
                                   Margin="12,0"/>
                        <TextBlock Grid.Column="2"
                                   Text="{DynamicResource Common.Invoiced}"
                                   Style="{StaticResource ModuleListHeaderTextStyle}"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="3"
                                   Text="{DynamicResource Common.Outstanding}"
                                   Style="{StaticResource ModuleListHeaderTextStyle}"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="4"
                                   Text="{DynamicResource Common.Status}"
                                   Style="{StaticResource ModuleListHeaderTextStyle}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="5"
                                   Text="{DynamicResource Common.Actions}"
                                   Style="{StaticResource ModuleListHeaderTextStyle}"
                                   HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="3">
                    <Border Panel.ZIndex="2"
                            Visibility="{Binding IsLoading,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,48,0,48">
                            <Border Width="64" Height="64"
                                    CornerRadius="{DynamicResource CardCornerRadius}"
                                    Background="{DynamicResource TintIndigoBrush}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8A5;"
                                           FontFamily="{DynamicResource FontFamily.Icon}"
                                           FontSize="{DynamicResource FontSize.Kpi}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{DynamicResource Dashboard.LoadingStatements}"
                                       FontSize="{DynamicResource FontSize.H3}"
                                       FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,16,0,0"/>
                            <TextBlock Text="{DynamicResource Reports.PreparingDataTotals}"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Panel.ZIndex="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsEmpty,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="440"
                                    Margin="0,48,0,48">
                            <Border Width="64" Height="64"
                                    CornerRadius="{DynamicResource CardCornerRadius}"
                                    Background="{DynamicResource TintIndigoBrush}"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,16">
                                <TextBlock Text="&#xE7C3;"
                                           FontFamily="{DynamicResource FontFamily.Icon}"
                                           FontSize="{DynamicResource FontSize.Kpi}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{DynamicResource Dashboard.NoStatementsYet}"
                                       FontSize="{DynamicResource FontSize.H2}"
                                       FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{DynamicResource Reports.CreateFirstAccountStatementTrackInvoices}"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,20"/>
                            <Button Content="{DynamicResource Reports.NewStatement}"
                                    Command="{Binding NewStatementCommand}"
                                    Style="{StaticResource PrimaryPillButton}"
                                    Tag="&#xE710;"
                                    HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ListView Panel.ZIndex="0"
                              ItemsSource="{Binding Rows}"
                              SelectedItem="{Binding SelectedRow}"
                              Background="Transparent"
                              BorderThickness="{DynamicResource Border.NoneThickness}"
                              HorizontalContentAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              VirtualizingPanel.CacheLength="400,800"
                              VirtualizingPanel.CacheLengthUnit="Pixel"
                              ScrollViewer.CanContentScroll="False"
                              ScrollViewer.IsDeferredScrollingEnabled="False"
                              ScrollViewer.PanningMode="None"
                              behaviors:SmoothScrollBehavior.IsEnabled="True"
                              Visibility="{Binding IsListVisible,
                                  Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ModuleListRowStyle}"
                                        MinHeight="56"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="1.5*" MinWidth="140"/>
                                            <ColumnDefinition Width="0.9*" MinWidth="95"/>
                                            <ColumnDefinition Width="0.9*" MinWidth="95"/>
                                            <ColumnDefinition Width="0.8*" MinWidth="85"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,8,8,8" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding StatementNumber, Mode=OneWay}"
                                                           FontSize="{DynamicResource FontSize.Title}"
                                                           FontWeight="{DynamicResource Weight.Bold}"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="  /  "
                                                           FontSize="{DynamicResource FontSize.Title}"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                <TextBlock Text="{Binding SubTitle, Mode=OneWay}"
                                                           FontSize="{DynamicResource FontSize.Title}"
                                                           FontWeight="{DynamicResource Weight.SemiBold}"
                                                           ToolTip="{Binding SubTitle, Mode=OneWay}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{DynamicResource TintIndigoBrush}"
                                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                                        Padding="8,4"
                                                        Margin="0,0,8,0">
                                                    <TextBlock FontSize="{DynamicResource FontSize.BodySmall}"
                                                               FontWeight="{DynamicResource Weight.Bold}"
                                                               Foreground="{DynamicResource AccentBrush}">
                                                        <Run Text="{Binding InvoiceCount, Mode=OneWay}"/>
                                                        <Run Text="{DynamicResource Reports.Inv}"/>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding CreatedAtDisplay, Mode=OneWay}"
                                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                                <Border Background="{DynamicResource TintGreenBrush}"
                                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                                        Padding="8,4"
                                                        Visibility="{Binding HasAttachments,
                                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{DynamicResource DeliveryNote.Attachments}"
                                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                                               FontWeight="{DynamicResource Weight.Bold}"
                                                               Foreground="{DynamicResource SuccessBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding TotalInvoicedDisplay, Mode=OneWay}"
                                                   FontSize="{DynamicResource FontSize.Title}"
                                                   FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>

                                        <StackPanel Grid.Column="3"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Margin="0,8,12,8">
                                            <TextBlock Text="{Binding TotalOutstandingDisplay, Mode=OneWay}"
                                                       FontSize="{DynamicResource FontSize.Title}"
                                                       FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource WarningBrush}"/>
                                            <TextBlock Visibility="{Binding HasOverdue,
                                                           Converter={StaticResource BoolToVisibilityConverter}}"
                                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                                       FontWeight="{DynamicResource Weight.SemiBold}"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       Margin="0,4,0,0">
                                                <Run Text="{DynamicResource Common.Overdue}"/>
                                                <Run Text="{Binding OverdueAmountDisplay, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <Border Grid.Column="4"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Padding="8,4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource TintGreenBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                                    <Setter Property="BorderThickness" Value="{DynamicResource Border.HairlineThickness}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource TintRedBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="{DynamicResource FontSize.BodySmall}"
                                                       FontWeight="{DynamicResource Weight.Bold}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Current"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                                                <Setter Property="Text" Value="Overdue"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <StackPanel Grid.Column="5"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Margin="4,0,8,0">
                                            <Button Style="{StaticResource StatementGhostActionStyle}"
                                                    Background="{DynamicResource TintIndigoBrush}"
                                                    Foreground="{DynamicResource AccentBrush}"
                                                    ToolTip="PDF"
                                                    Command="{Binding DataContext.OpenPdfCommand,
                                                        RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding HasPdf}">
                                                <TextBlock Text="PDF"
                                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                                           FontWeight="{DynamicResource Weight.Bold}"/>
                                            </Button>
                                            <Button Style="{StaticResource StatementGhostActionStyle}"
                                                    Background="{DynamicResource TintGreenBrush}"
                                                    Foreground="{DynamicResource SuccessBrush}"
                                                    ToolTip="{DynamicResource Sharing.Share}"
                                                    Command="{Binding DataContext.ShareStatementCommand,
                                                        RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding HasPdf}">
                                                <TextBlock Text="&#xE72D;"
                                                           FontFamily="{DynamicResource FontFamily.Icon}"
                                                           FontSize="{DynamicResource FontSize.Body}"/>
                                            </Button>
                                            <Button Style="{StaticResource StatementGhostActionStyle}"
                                                    Background="{DynamicResource TintAmberBrush}"
                                                    Foreground="{DynamicResource WarningBrush}"
                                                    Command="{Binding DataContext.EditStatementCommand,
                                                        RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE70F;"
                                                           FontFamily="{DynamicResource FontFamily.Icon}"
                                                           FontSize="{DynamicResource FontSize.Body}"/>
                                            </Button>
                                            <Button Style="{StaticResource StatementGhostActionStyle}"
                                                    Background="{DynamicResource TintRedBrush}"
                                                    Foreground="{DynamicResource DangerBrush}"
                                                    Command="{Binding DataContext.DeleteStatementCommand,
                                                        RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE74D;"
                                                           FontFamily="{DynamicResource FontFamily.Icon}"
                                                           FontSize="{DynamicResource FontSize.Body}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
