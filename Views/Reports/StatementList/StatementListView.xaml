<UserControl
    x:Class="ProGlassAutomation.Views.Reports.StatementList.StatementListView"
             TextOptions.TextHintingMode="Fixed"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
    FontFamily="{DynamicResource AppFontFamily}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ ROW 0 — RICH HEADER ══ -->
        <Border Grid.Row="0"
                Margin="24,16,24,0"
                CornerRadius="{DynamicResource CardCornerRadius}"
                ClipToBounds="True">
            <Border CornerRadius="{DynamicResource CardCornerRadius}" Background="{DynamicResource AccentBrush}" Padding="24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="56" Height="56"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Margin="0,0,18,0">
                        <TextBlock Text="≡"
                                   FontSize="{StaticResource TextDisplayLarge}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="STATEMENT GENERATOR"
                                   FontSize="{StaticResource TextCaption}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Account Statements"
                                   FontSize="{StaticResource TextHeadline}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,10">
                            <Border Width="10" Height="10" CornerRadius="5"
                                    Background="{DynamicResource AccentBrush}" Margin="0,0,5,0"/>
                            <Border Width="10" Height="10" CornerRadius="5"
                                    Background="{DynamicResource SuccessBrush}" Margin="0,0,5,0"/>
                            <Border Width="10" Height="10" CornerRadius="5"
                                    Background="{DynamicResource WarningBrush}" Margin="0,0,5,0"/>
                            <Border Width="10" Height="10" CornerRadius="5"
                                    Background="{DynamicResource DangerBrush}"/>
                        </StackPanel>
                        <Button Content="+ New Statement"
                                Command="{Binding NewStatementCommand}"
                                Height="40"
                                Padding="20,0"
                                FontSize="{StaticResource TextBodyLarge}"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Foreground="{DynamicResource AccentBrush}"
                                BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            Background="{DynamicResource ElevatedSurfaceBrush}"
                                            BorderBrush="{DynamicResource OutlineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- ══ ROW 1 — RICH KPI CARDS ══ -->
        <Grid Grid.Row="1" Margin="24,14,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource AccentBrush}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="16,14">
                <StackPanel>
                    <TextBlock Text="STATEMENTS"
                               FontSize="{StaticResource TextBody}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                    <TextBlock Text="{Binding TotalStatements}"
                               FontSize="{StaticResource TextDisplayLarge}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                               Margin="0,6,0,2"/>
                    <TextBlock Text="Total saved"
                               FontSize="{StaticResource TextBody}"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource SuccessBrush}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="16,14">
                <StackPanel>
                    <TextBlock Text="TOTAL INVOICED"
                               FontSize="{StaticResource TextBody}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                    <TextBlock Text="{Binding TotalInvoicedDisplay}"
                               FontSize="{StaticResource TextHeadline}"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,6,0,2"/>
                    <TextBlock Text="Across all statements"
                               FontSize="{StaticResource TextBody}"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4"
                    Background="{DynamicResource WarningBrush}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="16,14">
                <StackPanel>
                    <TextBlock Text="OUTSTANDING"
                               FontSize="{StaticResource TextBody}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                    <TextBlock Text="{Binding TotalOutstandingDisplay}"
                               FontSize="{StaticResource TextHeadline}"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,6,0,2"/>
                    <TextBlock Text="Total balance due"
                               FontSize="{StaticResource TextBody}"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="6" CornerRadius="{DynamicResource CardCornerRadius}" Padding="16,14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background"
                                Value="{DynamicResource SideMenuBackgroundBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="OVERDUE"
                               FontSize="{StaticResource TextBody}"
                               FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource MutedForegroundBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding TotalOverdueDisplay}"
                               FontSize="{StaticResource TextHeadline}"
                               FontWeight="Bold"
                               Margin="0,6,0,2">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource PrimaryForegroundBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="Past due date"
                               FontSize="{StaticResource TextBody}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource MutedForegroundBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ ROW 2 — SEARCH BAR ══ -->
        <Border Grid.Row="2"
                Margin="24,14,24,0"
                Background="{DynamicResource SideMenuBackgroundBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="{DynamicResource CardBorderThickness}"
                CornerRadius="{DynamicResource CardCornerRadius}"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource ModuleBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Height="38">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="10,0,0,10">
                            <TextBlock Text="⌕"
                                       FontSize="{StaticResource TextSubhead}"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Grid Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Search by number, customer, project..."
                                       FontSize="{StaticResource TextBody}"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding HasSearchText,
                                           Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            <TextBox Text="{Binding SearchText,
                                         UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="{StaticResource TextBodyLarge}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource PrimaryForegroundBrush}"
                                     VerticalContentAlignment="Center"
                                     CaretBrush="{DynamicResource AccentBrush}"
                                     SelectionBrush="{DynamicResource AccentBrush}"/>
                        </Grid>

                        <Button Grid.Column="2"
                                Style="{StaticResource RowDangerButton}"
                                Tag="&#xE711;"
                                ToolTip="Clear search"
                                Command="{Binding ClearSearchCommand}"
                                Width="28" Height="28" MinWidth="28" Padding="0"
                                FontSize="{StaticResource TextBody}"
                                Cursor="Hand"
                                Foreground="{DynamicResource MutedForegroundBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasSearchText,
                                    Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="{DynamicResource ControlCornerRadius}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd"
                                                    Property="Background"
                                                    Value="{DynamicResource MenuHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd"
                                                    Property="Opacity" Value="0.75"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <Button Grid.Column="2"
                        Command="{Binding RefreshCommand}"
                        Height="38"
                        Padding="16,0"
                        FontSize="{StaticResource TextBody}"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Foreground="{DynamicResource OnAccentForegroundBrush}"
                        BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↻"
                                               FontSize="{StaticResource TextSection}"
                                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <TextBlock Text="Refresh"
                                               FontSize="{StaticResource TextBody}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ══ ROW 3 — COLUMN HEADERS ══ -->
        <Border Grid.Row="3"
                Margin="24,10,24,0"
                Background="{DynamicResource SideMenuBackgroundBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="{DynamicResource CardBorderThickness}"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                Padding="16,8"
                Visibility="{Binding IsListVisible,
                    Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="148"/>
                    <ColumnDefinition Width="148"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="1"
                           Text="STATEMENT  /  CUSTOMER"
                           FontSize="{StaticResource TextCaption}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           Margin="14,0,0,0"/>
                <TextBlock Grid.Column="2"
                           Text="INVOICED"
                           FontSize="{StaticResource TextCaption}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SuccessBrush}"/>
                <TextBlock Grid.Column="3"
                           Text="OUTSTANDING"
                           FontSize="{StaticResource TextCaption}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource WarningBrush}"/>
                <TextBlock Grid.Column="4"
                           Text="STATUS"
                           FontSize="{StaticResource TextCaption}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                <TextBlock Grid.Column="5"
                           Text="ACTIONS"
                           FontSize="{StaticResource TextCaption}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- ══ ROW 4 — CONTENT ══ -->
        <Grid Grid.Row="4" Margin="12,4,12,8">

            <Border Background="{DynamicResource AccentBrush}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Visibility="{Binding IsLoading,
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,48,0,48">
                    <Border Width="72" Height="72"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="↻"
                                   FontSize="32"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Loading statements..."
                               FontSize="{StaticResource TextSubhead}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,0"/>
                    <TextBlock Text="Preparing data and totals"
                               FontSize="{StaticResource TextBody}"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SideMenuBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Visibility="{Binding IsEmpty,
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="420"
                            Margin="0,48,0,48">

                    <Border Width="80" Height="80"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            HorizontalAlignment="Center"
                            ClipToBounds="True"
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border CornerRadius="{DynamicResource CardCornerRadius}" Grid.Row="0" Grid.Column="0" Background="{DynamicResource AccentBrush}"/>
                            <Border CornerRadius="{DynamicResource CardCornerRadius}" Grid.Row="0" Grid.Column="1" Background="{DynamicResource SuccessBrush}"/>
                            <Border CornerRadius="{DynamicResource CardCornerRadius}" Grid.Row="1" Grid.Column="0" Background="{DynamicResource WarningBrush}"/>
                            <Border CornerRadius="{DynamicResource CardCornerRadius}" Grid.Row="1" Grid.Column="1" Background="{DynamicResource DangerBrush}"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="No Statements Yet"
                               FontSize="{StaticResource TextTitle}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Create your first account statement to track invoices, payments, and outstanding balances."
                               FontSize="{StaticResource TextBodyLarge}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Margin="0,0,0,24"/>

                    <Button Content="+ New Statement"
                            Command="{Binding NewStatementCommand}"
                            Height="40"
                            Padding="28,0"
                            FontSize="{StaticResource TextBodyLarge}"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Foreground="White"
                            BorderThickness="0"
                            HorizontalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd"
                                        Background="{DynamicResource AccentBrush}"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

            <ListView ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow}"
                      Background="Transparent"
                      BorderThickness="0"
                      HorizontalContentAlignment="Stretch"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.IsDeferredScrollingEnabled="False"
                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                      Visibility="{Binding IsListVisible,
                          Converter={StaticResource BoolToVisibilityConverter}}">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SideMenuBackgroundBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="{DynamicResource CardBorderThickness}"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                ClipToBounds="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="148"/>
                                    <ColumnDefinition Width="148"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" CornerRadius="12,0,0,12">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOverdue}"
                                                             Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- COL 1: Statement info -->
                                <Border Grid.Column="1" Padding="16,14,12,14">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,0,0,7">
                                            <TextBlock Text="{Binding StatementNumber, Mode=OneWay}"
                                                       FontSize="{StaticResource TextBodyLarge}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="  /  "
                                                       FontSize="{StaticResource TextBodyLarge}"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            <TextBlock Text="{Binding SubTitle, Mode=OneWay}"
                                                       FontSize="{StaticResource TextBodyLarge}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal">
                                            <!-- FIX: Invoice count badge Runs need Mode=OneWay -->
                                            <Border Background="{DynamicResource AccentBrush}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Padding="8,3"
                                                    Margin="0,0,8,0">
                                                <TextBlock FontSize="{StaticResource TextCaption}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource OnAccentForegroundBrush}">
                                                    <Run Text="{Binding InvoiceCount, Mode=OneWay}"/>
                                                    <Run Text=" inv"/>
                                                </TextBlock>
                                            </Border>

                                            <TextBlock Text="{Binding CreatedAtDisplay, Mode=OneWay}"
                                                       FontSize="{StaticResource TextBody}"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>

                                            <Border Background="{DynamicResource SuccessBrush}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Padding="8,3"
                                                    Visibility="{Binding HasAttachments,
                                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="Attachments"
                                                           FontSize="{StaticResource TextCaption}"
                                                           FontWeight="Bold"
                                                           Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- COL 2: Invoiced -->
                                <Border Grid.Column="2"
                                        Background="{DynamicResource SuccessBrush}"
                                        Margin="0,10,8,10"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Padding="12,10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="INVOICED"
                                                   FontSize="{StaticResource TextCaption}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding TotalInvoicedDisplay, Mode=OneWay}"
                                                   FontSize="{StaticResource TextBodyLarge}"
                                                   FontWeight="Bold"
                                                   Foreground="White"/>
                                    </StackPanel>
                                </Border>

                                <!-- COL 3: Outstanding -->
                                <Border Grid.Column="3"
                                        Background="{DynamicResource WarningBrush}"
                                        Margin="0,10,8,10"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Padding="12,10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="OUTSTANDING"
                                                   FontSize="{StaticResource TextCaption}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding TotalOutstandingDisplay, Mode=OneWay}"
                                                   FontSize="{StaticResource TextBodyLarge}"
                                                   FontWeight="Bold"
                                                   Foreground="White"/>
                                        <!-- FIX: Overdue Runs need Mode=OneWay -->
                                        <TextBlock Visibility="{Binding HasOverdue,
                                                       Converter={StaticResource BoolToVisibilityConverter}}"
                                                   FontSize="{StaticResource TextCaption}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                   Margin="0,4,0,0">
                                            <Run Text="Overdue "/>
                                            <Run Text="{Binding OverdueAmountDisplay, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- COL 4: Status pill -->
                                <Border Grid.Column="4"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Padding="12,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOverdue}"
                                                             Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="{StaticResource TextBody}"
                                               FontWeight="Bold"
                                               Foreground="White">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Current"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasOverdue}"
                                                                 Value="True">
                                                        <Setter Property="Text" Value="Overdue"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- COL 5: Actions -->
                                <Border Grid.Column="5" Padding="8,0,16,0">
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">

                                        <Button Command="{Binding DataContext.OpenPdfCommand,
                                                    RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"
                                                Height="34"
                                                Padding="12,0"
                                                Margin="0,0,6,0"
                                                FontSize="{StaticResource TextBody}"
                                                FontWeight="SemiBold"
                                                Cursor="Hand"
                                                IsEnabled="{Binding HasPdf}"
                                                Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                BorderThickness="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd"
                                                            Background="{DynamicResource AccentBrush}"
                                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <TextBlock Text="PDF"
                                                                   FontSize="{StaticResource TextBody}"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Opacity" Value="0.84"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="bd" Property="Opacity" Value="0.70"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Button Command="{Binding DataContext.EditStatementCommand,
                                                    RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"
                                                Height="34"
                                                Padding="12,0"
                                                Margin="0,0,6,0"
                                                FontSize="{StaticResource TextBody}"
                                                FontWeight="SemiBold"
                                                Cursor="Hand"
                                                Foreground="White"
                                                BorderThickness="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd"
                                                            Background="{DynamicResource WarningBrush}"
                                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <TextBlock Text="Edit"
                                                                   FontSize="{StaticResource TextBody}"
                                                                   FontWeight="Bold"
                                                                   Foreground="White"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Button Command="{Binding DataContext.DeleteStatementCommand,
                                                    RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"
                                                Width="34"
                                                Height="34"
                                                FontSize="{StaticResource TextBodyLarge}"
                                                Cursor="Hand"
                                                BorderThickness="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd"
                                                            Background="{DynamicResource DangerBrush}"
                                                            CornerRadius="{DynamicResource ControlCornerRadius}">
                                                        <TextBlock Text="✕"
                                                                   FontSize="{StaticResource TextBodyLarge}"
                                                                   FontWeight="Bold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Opacity" Value="0.84"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="bd" Property="Opacity" Value="0.70"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                    </StackPanel>
                                </Border>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </Grid>
    </Grid>
</UserControl>