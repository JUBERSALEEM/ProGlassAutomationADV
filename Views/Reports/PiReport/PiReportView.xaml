<UserControl x:Class="ProGlassAutomation.Views.Reports.PiReport.PiReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loading="clr-namespace:ProGlassAutomation.Controls.LoadingState"
             xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="16,12,16,10">
            <TextBlock Text="Proforma Invoice Report" Style="{StaticResource ModulePageTitleStyle}" FontSize="20"/>
            <TextBlock Text="Total · Draft · Released · Confirmed · Rejected · Pending · Converted · Not converted · Value · Company · Customer · Salesman · Project · PI date · Actual specification rows" Style="{StaticResource ModulePageSubtitleStyle}" TextWrapping="Wrap" MaxWidth="980" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- Shell -->
        <Border Grid.Row="1" Style="{StaticResource ModuleListShellStyle}" Margin="16,0,16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- KPI Strip -->
                <Border Grid.Row="0" Style="{StaticResource ModuleListKpiStripStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}" Background="{DynamicResource TintBlueBrush}"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="TOTAL PI" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding Summary.TotalPi}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Style="{StaticResource ModuleListKpiHintStyle}"><Run Text="AED"/><Run Text="{Binding Summary.TotalValue, StringFormat={}{0:N0}}"/></TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource ModuleListKpiDividerStyle}"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}" Background="{DynamicResource TintGreenBrush}"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="CONFIRMED" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding Summary.Confirmed}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="{Binding Summary.Pending, StringFormat={}{0} pending}" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="3" Style="{StaticResource ModuleListKpiDividerStyle}"/>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}" Background="{DynamicResource TintAmberBrush}"><TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="CONVERTED" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding Summary.Converted}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="{Binding Summary.NotConverted, StringFormat={}{0} not converted}" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="5" Style="{StaticResource ModuleListKpiDividerStyle}"/>
                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}" Background="{DynamicResource TintIndigoBrush}"><TextBlock Text="&#xE913;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="QUANTITY" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding Summary.TotalQty}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="{Binding Summary.TotalSqm, StringFormat={}{0:N2} SQM}" Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Filter Bar -->
                <Border Grid.Row="1" Style="{StaticResource ModuleListFilterBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Width="160" Margin="0,0,8,6" Style="{StaticResource ModuleListFilterInputStyle}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Search PI / Customer..."/>
                            <DatePicker Width="140" Margin="0,0,8,6" SelectedDate="{Binding DateFrom}" ToolTip="From date"/>
                            <DatePicker Width="140" Margin="0,0,8,6" SelectedDate="{Binding DateTo}" ToolTip="To date"/>
                            <ComboBox Width="140" Margin="0,0,8,6" IsEditable="True" Text="{Binding SelectedCompany, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding CompanyOptions}" ToolTip="Company"/>
                            <ComboBox Width="140" Margin="0,0,8,6" IsEditable="True" Text="{Binding SelectedCustomer, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding CustomerOptions}" ToolTip="Customer"/>
                            <ComboBox Width="120" Margin="0,0,8,6" IsEditable="True" Text="{Binding SelectedStatus, UpdateSourceTrigger=PropertyChanged}" ToolTip="Status">
                                <ComboBoxItem Content="Draft"/><ComboBoxItem Content="Sent"/><ComboBoxItem Content="Approved"/><ComboBoxItem Content="Rejected"/>
                            </ComboBox>
                            <Button Content="Apply" Command="{Binding ApplyFilterCommand}" Style="{StaticResource RowPrimaryButton}" Padding="14,0" Height="30" Margin="0,0,6,6"/>
                            <Button Content="Clear" Command="{Binding ClearFilterCommand}" Style="{StaticResource RowOutlinedButton}" Padding="14,0" Height="30" Margin="0,0,6,6"/>
                        </WrapPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Button Content="CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource RowOutlinedButton}" Tag="&#xE8A5;" Margin="0,0,6,0" ToolTip="Export CSV (respects filters)"/>
                            <Button Content="Excel" Command="{Binding ExportExcelCommand}" Style="{StaticResource RowOutlinedButton}" Tag="&#xE9F9;" Margin="0,0,6,0" ToolTip="Export Excel"/>
                            <Button Content="PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource PrimaryPillButton}" Tag="&#xE7C3;" ToolTip="Export PDF"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Table Header -->
                <Border Grid.Row="2" Style="{StaticResource ModuleListTableHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/><ColumnDefinition Width="90"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PI #" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="1" Text="STATUS" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="2" Text="CUSTOMER" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="3" Text="PROJECT / COMPANY" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="4" Text="GRAND TOTAL" Style="{StaticResource ModuleListHeaderTextStyle}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="5" Text="QTY / SQM" Style="{StaticResource ModuleListHeaderTextStyle}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="6" Text="TRACE" Style="{StaticResource ModuleListHeaderTextStyle}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="7" Text="DRILL" Style="{StaticResource ModuleListHeaderTextStyle}" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- Loading -->
                <loading:LoadingStateControl Grid.Row="4"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                    Message="Loading PI report…"/>

                <!-- Empty -->
                <emptyState:EmptyStateControl Grid.Row="4"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                    Title="No invoices match the filters"
                    Message="Try adjusting date range, company, or status. The report reads your real proformainvoices.db."
                    Icon="&#xE8A5;"/>

                <!-- Error -->
                <Border Grid.Row="4" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" Background="{DynamicResource DangerBrush}" Opacity="0.08" CornerRadius="8" Margin="16" Padding="16">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
                </Border>

                <!-- Data -->
                <ListBox Grid.Row="4" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource ModuleListBoxItemStyle}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding IsContentVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ModuleListRowStyle}" Padding="16,12" Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/><ColumnDefinition Width="90"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProformaId}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        <TextBlock Text="{Binding IssueDate, StringFormat={}{0:dd MMM yyyy}}" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource TintGrayBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Approved"><Setter Property="Background" Value="{DynamicResource TintGreenBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Sent"><Setter Property="Background" Value="{DynamicResource TintBlueBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Draft"><Setter Property="Background" Value="{DynamicResource TintGrayBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Rejected"><Setter Property="Background" Value="{DynamicResource TintRedBrush}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding CustomerName}" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock Text="{Binding ProjectName}" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CompanyName}" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="4" Text="{Binding GrandTotal, StringFormat={}AED {0:N2}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}" TextAlignment="Right"><Run Text="{Binding TotalQty}"/><Run Text=" pcs"/><LineBreak/><Run Text="{Binding TotalSqm, StringFormat={}{0:N2} SQM}" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}"/></TextBlock>
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="8" Height="8" CornerRadius="4" Margin="2" ToolTip="Has Job Order">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding HasJobOrder}" Value="True"><Setter Property="Background" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <Border Width="8" Height="8" CornerRadius="4" Margin="2" ToolTip="Has Delivery">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding HasDelivery}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <Border Width="8" Height="8" CornerRadius="4" Margin="2" ToolTip="Has Tax Invoice">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding HasTaxInvoice}" Value="True"><Setter Property="Background" Value="{DynamicResource WarningBrush}"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </StackPanel>
                                    <Button Grid.Column="7" Content="Rows" Command="{Binding DataContext.DrillDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Style="{StaticResource RowOutlinedButton}" FontSize="10" Padding="8,4" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Detail drawer: spec rows for selected PI -->
                <Border Grid.Row="3" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}" Background="{DynamicResource MenuHoverBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,1" Padding="16,10">
                    <StackPanel>
                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"><Run Text="Specification rows — "/><Run Text="{Binding SelectedRow.ProformaId}"/><Run Text=" ("/><Run Text="{Binding DetailRows.Count, Mode=OneWay}"/><Run Text=" rows)"/></TextBlock>
                        <ItemsControl ItemsSource="{Binding DetailRows}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="90"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding GlassRef}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SpecName}" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}" TextTrimming="CharacterEllipsis" Margin="8,0"/>
                                            <TextBlock Grid.Column="2" FontSize="10" HorizontalAlignment="Center"><Run Text="{Binding W1}"/><Run Text="×"/><Run Text="{Binding H1}"/></TextBlock>
                                            <TextBlock Grid.Column="3" Text="{Binding Qty, StringFormat={}{0} pcs}" FontSize="10" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="4" Text="{Binding TotalSqm, StringFormat={}{0:N3}}" FontSize="10" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Amount, StringFormat={}AED {0:N0}}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"><Run Text="Reconciliation: "/><Run Text="{Binding Reconciliation.OrderedQty}"/><Run Text=" ordered · "/><Run Text="{Binding Reconciliation.DeliveredQty}"/><Run Text=" delivered · "/><Run Text="{Binding Reconciliation.RemainingQty}"/><Run Text=" remaining"/></TextBlock>
                            <Border CornerRadius="6" Background="{DynamicResource TintBlueBrush}" Padding="8,3" Margin="12,0,0,0"><TextBlock Text="{Binding Reconciliation.DeliveryState}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/></Border>
                            <Border CornerRadius="6" Background="{DynamicResource TintAmberBrush}" Padding="8,3" Margin="6,0,0,0"><TextBlock Text="{Binding Reconciliation.InvoiceState}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/></Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Pagination -->
                <Border Grid.Row="5" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding PageDisplay}" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="‹ Prev" Command="{Binding PrevPageCommand}" Style="{StaticResource RowOutlinedButton}" Padding="12,0" Height="28" Margin="0,0,8,0"/>
                            <Button Content="Next ›" Command="{Binding NextPageCommand}" Style="{StaticResource RowOutlinedButton}" Padding="12,0" Height="28"/>
                            <Button Content="↻" Command="{Binding RefreshCommand}" Style="{StaticResource RowPrimaryButton}" Padding="10,0" Height="28" Margin="8,0,0,0" ToolTip="Refresh"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>
