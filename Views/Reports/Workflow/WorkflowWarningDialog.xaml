<Window
    x:Class="ProGlassAutomation.Views.Reports.Workflow.WorkflowWarningDialog"
             TextOptions.TextHintingMode="Fixed"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
    Title="{DynamicResource Reports.MissingInvoiceWarning}"
    Width="720" Height="580"
    MinWidth="560" MinHeight="440"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    Background="Transparent"
    AllowsTransparency="True"
    FontFamily="{DynamicResource AppFontFamily}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <Border Background="{DynamicResource ModuleBackgroundBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="{DynamicResource CardBorderThickness}"
            CornerRadius="{DynamicResource CardCornerRadiusLarge}"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0"
                              Opacity="0.22" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Summary stats -->
                <RowDefinition Height="*"/>
                <!-- Uninvoiced DN list -->
                <RowDefinition Height="Auto"/>
                <!-- Question -->
                <RowDefinition Height="Auto"/>
                <!-- Action buttons -->
            </Grid.RowDefinitions>

            <!-- ══ HEADER — amber warning bar ══ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource WarningBrush}"
                    CornerRadius="16,16,0,0"
                    Padding="28,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="{StaticResource TextBody}" VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock Text="{DynamicResource Reports.Warning}"
                                   FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Reports.MissingInvoiceDetected}"
                               FontSize="{StaticResource TextHeadline}" FontWeight="Bold"
                               Foreground="White"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="{DynamicResource Reports.SomeDeliveredItemsNoMatchingTaxInvoice}"
                               FontSize="{StaticResource TextBody}"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- ══ SUMMARY STATS ══ -->
            <Grid Grid.Row="1" Margin="20,16,20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Delivered -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SuccessBrush}"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Common.Delivered}"
                                   FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock FontSize="{StaticResource TextTitleLarge}" FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,4,0,0">
                            <Run Text="{Binding DeliveredQty, Mode=OneWay}"/>
                            <Run Text=" pcs"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Invoiced -->
                <Border Grid.Column="2"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Common.Invoiced}"
                                   FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock FontSize="{StaticResource TextTitleLarge}" FontWeight="Bold"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   Margin="0,4,0,0">
                            <Run Text="{Binding InvoicedQty, Mode=OneWay}"/>
                            <Run Text=" pcs"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Missing -->
                <Border Grid.Column="4"
                        Background="{DynamicResource DangerBrush}"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Reports.Missing}"
                                   FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock FontSize="{StaticResource TextTitleLarge}" FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,4,0,0">
                            <Run Text="{Binding UninvoicedDeliveredQty, Mode=OneWay}"/>
                            <Run Text=" pcs"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══ UNINVOICED DN LIST ══ -->
            <Border Grid.Row="2"
                    Margin="20,8,20,8"
                    Padding="14,12"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Background="{DynamicResource SideMenuBackgroundBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    BorderBrush="{DynamicResource OutlineBrush}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Reports.UninvoicedDeliveryNotes}"
                               FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Margin="0,0,0,8"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="200"
                                  behaviors:SmoothScrollBehavior.IsEnabled="True">
                        <ItemsControl ItemsSource="{Binding UninvoicedDeliveryNotes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ModuleBackgroundBrush}"
                                            BorderBrush="{DynamicResource OutlineBrush}"
                                            BorderThickness="{DynamicResource CardBorderThickness}"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Padding="12,10"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Left: DN identity -->
                                            <StackPanel Grid.Column="0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DeliveryNoteId, Mode=OneWay}"
                                                           FontSize="{StaticResource TextBodyLarge}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding DeliveryNoteType, Mode=OneWay}"
                                                               FontSize="{StaticResource TextCaption}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                    <TextBlock Text="  ·  "
                                                               FontSize="{StaticResource TextCaption}"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                    <TextBlock FontSize="{StaticResource TextCaption}"
                                                               Foreground="{DynamicResource MutedForegroundBrush}">
                                                        <Run Text="{DynamicResource Common.Delivered}"/>
                                                        <Run Text="{Binding DeliveryDate,
                                                                StringFormat=dd MMM yyyy, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Middle: Delivered qty -->
                                            <Border Grid.Column="1"
                                                    Background="{DynamicResource DangerBrush}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Padding="10,4"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock FontSize="{StaticResource TextBody}"
                                                           FontWeight="Bold"
                                                           Foreground="White">
                                                    <Run Text="{Binding DeliveredQty, Mode=OneWay}"/>
                                                    <Run Text=" pcs"/>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ══ QUESTION ══ -->
            <TextBlock Grid.Row="3"
                       Text="{DynamicResource Reports.WhatWouldLike}"
                       FontSize="{StaticResource TextSection}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                       HorizontalAlignment="Center"
                       Margin="20,8,20,12"/>

            <!-- ══ ACTION BUTTONS ══ -->
            <Border Grid.Row="4"
                    Background="{DynamicResource SideMenuBackgroundBrush}"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    CornerRadius="0,0,16,16"
                    Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CREATE INVOICE -->
                    <Button Grid.Column="0"
                            Command="{Binding CreateInvoiceCommand}"
                            Height="52"
                            Cursor="Hand"
                            BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd"
                                        Background="{DynamicResource AccentBrush}"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Padding="12,10">
                                    <StackPanel>
                                        <TextBlock FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                   HorizontalAlignment="Center">
                                            <Run Text="&#xE70F; " FontFamily="Segoe MDL2 Assets"/><Run Text="{DynamicResource Reports.CreateInvoice}"/>
                                        </TextBlock>
                                        <TextBlock Text="{DynamicResource Reports.FixMissingInvoiceNow}"
                                                   FontSize="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- SKIP -->
                    <Button Grid.Column="2"
                            Command="{Binding SkipCommand}"
                            Height="52"
                            Cursor="Hand"
                            BorderThickness="0"
                            IsDefault="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd"
                                        Background="{DynamicResource WarningBrush}"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Reports.SKIPContinue}"
                                                   FontSize="{StaticResource TextBody}"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Reports.GenerateWarning}"
                                                   FontSize="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- ABORT -->
                    <Button Grid.Column="4"
                            Command="{Binding AbortCommand}"
                            Height="52"
                            Cursor="Hand"
                            BorderThickness="0"
                            IsCancel="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd"
                                        Background="{DynamicResource DangerBrush}"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Padding="12,10">
                                    <StackPanel>
                                        <TextBlock FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center">
                                            <Run Text="&#xE711; " FontFamily="Segoe MDL2 Assets"/><Run Text="{DynamicResource Reports.Abort}"/>
                                        </TextBlock>
                                        <TextBlock Text="{DynamicResource Reports.CancelGeneration}"
                                                   FontSize="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>