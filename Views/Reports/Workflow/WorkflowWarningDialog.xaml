<Window
    x:Class="ProGlassAutomation.Views.Reports.Workflow.WorkflowWarningDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
    Title="Missing Invoice Warning"
    Width="640" Height="520"
    MinWidth="520" MinHeight="400"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    Background="Transparent"
    AllowsTransparency="True"
    FontFamily="Segoe UI"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    TextOptions.TextHintingMode="Fixed"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <Border Background="{DynamicResource ModuleBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Summary stats -->
                <RowDefinition Height="*"/>
                <!-- Uninvoiced DN list -->
                <RowDefinition Height="Auto"/>
                <!-- Question -->
                <RowDefinition Height="Auto"/>
                <!-- Action buttons -->
            </Grid.RowDefinitions>

            <!-- ══ HEADER — amber warning bar ══ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource WarningBrush}"
                    CornerRadius="12,12,0,0"
                    Padding="24,18">
                <StackPanel>
                    <TextBlock Text="⚠  WARNING"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                    <TextBlock Text="Missing Invoice Detected"
                               FontSize="22" FontWeight="Bold"
                               Foreground="White"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="Some delivered items have no matching tax invoice."
                               FontSize="12"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- ══ SUMMARY STATS ══ -->
            <Grid Grid.Row="1" Margin="20,16,20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Delivered -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SuccessBrush}"
                        CornerRadius="10"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="DELIVERED"
                                   FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock FontSize="20" FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,4,0,0">
                            <Run Text="{Binding DeliveredQty, Mode=OneWay}"/>
                            <Run Text=" pcs"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Invoiced -->
                <Border Grid.Column="2"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="10"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="INVOICED"
                                   FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock FontSize="20" FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,4,0,0">
                            <Run Text="{Binding InvoicedQty, Mode=OneWay}"/>
                            <Run Text=" pcs"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Missing -->
                <Border Grid.Column="4"
                        Background="{DynamicResource DangerBrush}"
                        CornerRadius="10"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="MISSING"
                                   FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock FontSize="20" FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,4,0,0">
                            <Run Text="{Binding UninvoicedDeliveredQty, Mode=OneWay}"/>
                            <Run Text=" pcs"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══ UNINVOICED DN LIST ══ -->
            <Border Grid.Row="2"
                    Margin="20,8,20,8"
                    Padding="14,12"
                    CornerRadius="10"
                    Background="{DynamicResource SideMenuBackgroundBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}">
                <StackPanel>
                    <TextBlock Text="UNINVOICED DELIVERY NOTES"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               Margin="0,0,0,8"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="200"
                                  behaviors:SmoothScrollBehavior.IsEnabled="True">
                        <ItemsControl ItemsSource="{Binding UninvoicedDeliveryNotes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ModuleBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,10"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Left: DN identity -->
                                            <StackPanel Grid.Column="0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DeliveryNoteId, Mode=OneWay}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding DeliveryNoteType, Mode=OneWay}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                    <TextBlock Text="  ·  "
                                                               FontSize="10"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                    <TextBlock FontSize="10"
                                                               Foreground="{DynamicResource MutedForegroundBrush}">
                                                        <Run Text="Delivered "/>
                                                        <Run Text="{Binding DeliveryDate,
                                                                StringFormat=dd MMM yyyy, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Middle: Delivered qty -->
                                            <Border Grid.Column="1"
                                                    Background="{DynamicResource DangerBrush}"
                                                    CornerRadius="6"
                                                    Padding="10,4"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="White">
                                                    <Run Text="{Binding DeliveredQty, Mode=OneWay}"/>
                                                    <Run Text=" pcs"/>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ══ QUESTION ══ -->
            <TextBlock Grid.Row="3"
                       Text="What would you like to do?"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                       HorizontalAlignment="Center"
                       Margin="20,8,20,12"/>

            <!-- ══ ACTION BUTTONS ══ -->
            <Border Grid.Row="4"
                    Background="{DynamicResource SideMenuBackgroundBrush}"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    CornerRadius="0,0,12,12"
                    Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CREATE INVOICE -->
                    <Button Grid.Column="0"
                            Click="CreateInvoice_Click"
                            Height="52"
                            Cursor="Hand"
                            BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd"
                                        Background="{DynamicResource AccentBrush}"
                                        CornerRadius="10"
                                        Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="✎  CREATE INVOICE"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Fix missing invoice now"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- SKIP -->
                    <Button Grid.Column="2"
                            Click="Skip_Click"
                            Height="52"
                            Cursor="Hand"
                            BorderThickness="0"
                            IsDefault="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd"
                                        Background="{DynamicResource WarningBrush}"
                                        CornerRadius="10"
                                        Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="→  SKIP &amp; CONTINUE"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Generate with warning"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- ABORT -->
                    <Button Grid.Column="4"
                            Click="Abort_Click"
                            Height="52"
                            Cursor="Hand"
                            BorderThickness="0"
                            IsCancel="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd"
                                        Background="{DynamicResource DangerBrush}"
                                        CornerRadius="10"
                                        Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="✕  ABORT"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Cancel generation"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>