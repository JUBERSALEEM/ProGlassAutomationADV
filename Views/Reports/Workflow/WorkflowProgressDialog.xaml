<Window
    x:Class="ProGlassAutomation.Views.Reports.Workflow.WorkflowProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
    Title="Statement Generation Progress"
    Width="720" Height="640"
    MinWidth="640" MinHeight="500"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    Background="Transparent"
    AllowsTransparency="True"
    FontFamily="Segoe UI"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    TextOptions.TextHintingMode="Fixed"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    Loaded="OnLoaded">

    <Border Background="{DynamicResource ModuleBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Progress bar -->
                <RowDefinition Height="*"/>
                <!-- Steps list -->
                <RowDefinition Height="Auto"/>
                <!-- Result summary -->
                <RowDefinition Height="Auto"/>
                <!-- Footer buttons -->
            </Grid.RowDefinitions>

            <!-- ══ HEADER — indigo bar with statement info ══ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource AccentBrush}"
                    CornerRadius="12,12,0,0"
                    Padding="24,18">
                <StackPanel>
                    <TextBlock Text="⚙  STATEMENT GENERATION"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                    <TextBlock Text="{Binding StatementNumber}"
                               FontSize="22" FontWeight="Bold"
                               Foreground="White"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding CustomerName}"
                               FontSize="13"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- ══ PROGRESS BAR ══ -->
            <Grid Grid.Row="1" Margin="24,16,24,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Height="10"
                        CornerRadius="5"
                        Background="{DynamicResource MenuHoverBrush}"
                        ClipToBounds="True">
                    <Border Height="10"
                            HorizontalAlignment="Left"
                            CornerRadius="5"
                            Background="{DynamicResource AccentBrush}">
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                <Binding Path="OverallProgress"/>
                                <Binding Path="ActualWidth"
                                         RelativeSource="{RelativeSource AncestorType=Border}"/>
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                </Border>

                <TextBlock Grid.Column="1"
                           Text="{Binding OverallProgressText}"
                           FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           MinWidth="40"
                           TextAlignment="Right"/>
            </Grid>

            <!-- ══ STEPS LIST ══ -->
            <ScrollViewer Grid.Row="2"
                          Margin="24,8,24,8"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          behaviors:SmoothScrollBehavior.IsEnabled="True">
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Step row card -->
                            <Border Margin="0,0,0,8"
                                    Padding="14,12"
                                    CornerRadius="10"
                                    BorderThickness="1"
                                    Background="{DynamicResource SideMenuBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <!-- Step icon -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Title + detail -->
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Status icon -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Step icon -->
                                    <Border Grid.Column="0"
                                            Width="32" Height="32"
                                            CornerRadius="8"
                                            Background="{DynamicResource ModuleBackgroundBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Icon}"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Title + description + message + detail rows -->
                                    <StackPanel Grid.Column="1"
                                                Margin="12,0,12,0">

                                        <!-- Title -->
                                        <TextBlock Text="{Binding Title, Mode=OneWay}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>

                                        <!-- Description (subtitle) -->
                                        <TextBlock Text="{Binding Description, Mode=OneWay}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   Margin="0,2,0,0"/>

                                        <!-- Current message (colored by status) -->
                                        <TextBlock Text="{Binding CurrentMessage, Mode=OneWay}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasMessage,
                                                       Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush
                                                    Color="{Binding StatusColor,
                                                        Converter={StaticResource ColorStringConverter}}"/>
                                            </TextBlock.Foreground>
                                        </TextBlock>

                                        <!-- Detail rows (expandable list) -->
                                        <ItemsControl ItemsSource="{Binding DetailRows}"
                                                      Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               Margin="0,1,0,1"
                                                               TextWrapping="Wrap"
                                                               FontFamily="Consolas"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Warning badge -->
                                        <Border Background="{DynamicResource WarningBrush}"
                                                CornerRadius="5"
                                                Padding="6,2"
                                                Margin="0,6,0,0"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding HasWarnings,
                                                    Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="White">
                                                <Run Text="⚠ "/>
                                                <Run Text="{Binding Warnings.Count, Mode=OneWay}"/>
                                                <Run Text=" warning(s)"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <!-- Status icon (large, colored) -->
                                    <Border Grid.Column="2"
                                            Width="32" Height="32"
                                            CornerRadius="16"
                                            VerticalAlignment="Top"
                                            HorizontalAlignment="Center">
                                        <Border.Background>
                                            <SolidColorBrush
                                                Color="{Binding StatusColor,
                                                    Converter={StaticResource ColorStringConverter}}"
                                                Opacity="0.15"/>
                                        </Border.Background>
                                        <TextBlock Text="{Binding StatusIcon, Mode=OneWay}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush
                                                    Color="{Binding StatusColor,
                                                        Converter={StaticResource ColorStringConverter}}"/>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ══ RESULT SUMMARY (shown when engine completes) ══ -->
            <Border Grid.Row="3"
                    Margin="24,4,24,12"
                    Padding="14,10"
                    CornerRadius="10"
                    BorderThickness="1"
                    Visibility="{Binding HasResult,
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <Border.Background>
                    <SolidColorBrush
                        Color="{Binding ResultOutcomeColor,
                            Converter={StaticResource ColorStringConverter}}"
                        Opacity="0.10"/>
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush
                        Color="{Binding ResultOutcomeColor,
                            Converter={StaticResource ColorStringConverter}}"/>
                </Border.BorderBrush>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ResultOutcomeIcon, Mode=OneWay}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0">
                        <TextBlock.Foreground>
                            <SolidColorBrush
                                Color="{Binding ResultOutcomeColor,
                                    Converter={StaticResource ColorStringConverter}}"/>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="{Binding ResultSummary, Mode=OneWay}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap">
                        <TextBlock.Foreground>
                            <SolidColorBrush
                                Color="{Binding ResultOutcomeColor,
                                    Converter={StaticResource ColorStringConverter}}"/>
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ══ FOOTER BUTTONS ══ -->
            <Border Grid.Row="4"
                    Background="{DynamicResource SideMenuBackgroundBrush}"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    CornerRadius="0,0,12,12"
                    Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- View warnings button -->
                    <Button Grid.Column="0"
                            Command="{Binding ViewWarningsCommand}"
                            Height="38" Padding="16,0"
                            Cursor="Hand" BorderThickness="0"
                            Visibility="{Binding HasWarnings,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd"
                                        Background="{DynamicResource WarningBrush}"
                                        CornerRadius="9"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="⚠ "
                                                   FontSize="14"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="VIEW WARNINGS"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Running indicator -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsRunning,
                                    Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="⏳" FontSize="14"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="Processing..."
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Close button -->
                    <Button Grid.Column="2"
                            Command="{Binding CloseCommand}"
                            Height="38" Padding="24,0"
                            Cursor="Hand" BorderThickness="0"
                            IsDefault="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd"
                                        Background="{DynamicResource AccentBrush}"
                                        CornerRadius="9"
                                        Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="CLOSE"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>