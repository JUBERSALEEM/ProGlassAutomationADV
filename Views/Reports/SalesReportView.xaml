<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Reports/SalesReportView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Central Reporting — Hub Shell & Overview Dashboard

     PURPOSE:
       Enterprise hub for module-based Reports system in ProGlass Automation.
       Left panel: Floating rounded navigation rail with 6 focused items:
         • DOCUMENTS: Overview, Proforma Invoice, Job Order, Delivery,
           Tax Invoice, Statement
       Right pane: Active report ViewModel rendered via DataTemplates.
       Overview screen: Global KPI summary, workflow guidance, and quick actions.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl Style="{StaticResource ErpPageRootStyle}"
    x:Class="ProGlassAutomation.Views.Reports.SalesReportView"
             TextOptions.TextHintingMode="Fixed"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vmPi="clr-namespace:ProGlassAutomation.ViewModels.Reports.PiReport"
    xmlns:vmCust="clr-namespace:ProGlassAutomation.ViewModels.Reports.CustomerReport"
    xmlns:vmSm="clr-namespace:ProGlassAutomation.ViewModels.Reports.SalesmanReport"
    xmlns:vmCo="clr-namespace:ProGlassAutomation.ViewModels.Reports.CompanyReport"
    xmlns:vmPr="clr-namespace:ProGlassAutomation.ViewModels.Reports.ProjectReport"
    xmlns:vmJo="clr-namespace:ProGlassAutomation.ViewModels.Reports.JoReport"
    xmlns:vmDn="clr-namespace:ProGlassAutomation.ViewModels.Reports.DeliveryReport"
    xmlns:vmTi="clr-namespace:ProGlassAutomation.ViewModels.Reports.TaxInvoiceReport"
    xmlns:vmGs="clr-namespace:ProGlassAutomation.ViewModels.Reports.GlassSpecReport"
    xmlns:vmPf="clr-namespace:ProGlassAutomation.ViewModels.Reports.ProfitabilityReport"
    xmlns:vmEx="clr-namespace:ProGlassAutomation.ViewModels.Reports.ExecutiveReport"
    xmlns:vmStRep="clr-namespace:ProGlassAutomation.ViewModels.Reports.StatementReport"
    xmlns:vPi="clr-namespace:ProGlassAutomation.Views.Reports.PiReport"
    xmlns:vCust="clr-namespace:ProGlassAutomation.Views.Reports.CustomerReport"
    xmlns:vSm="clr-namespace:ProGlassAutomation.Views.Reports.SalesmanReport"
    xmlns:vCo="clr-namespace:ProGlassAutomation.Views.Reports.CompanyReport"
    xmlns:vPr="clr-namespace:ProGlassAutomation.Views.Reports.ProjectReport"
    xmlns:vJo="clr-namespace:ProGlassAutomation.Views.Reports.JoReport"
    xmlns:vDn="clr-namespace:ProGlassAutomation.Views.Reports.DeliveryReport"
    xmlns:vTi="clr-namespace:ProGlassAutomation.Views.Reports.TaxInvoiceReport"
    xmlns:vGs="clr-namespace:ProGlassAutomation.Views.Reports.GlassSpecReport"
    xmlns:vPf="clr-namespace:ProGlassAutomation.Views.Reports.ProfitabilityReport"
    xmlns:vEx="clr-namespace:ProGlassAutomation.Views.Reports.ExecutiveReport"
    xmlns:vStRep="clr-namespace:ProGlassAutomation.Views.Reports.StatementReport"
    FontFamily="{DynamicResource AppFontFamily}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- VM → View Mappings -->
        <DataTemplate DataType="{x:Type vmPi:PiReportViewModel}"><vPi:PiReportView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmCust:CustomerReportViewModel}"><vCust:CustomerReportView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmSm:SalesmanReportViewModel}"><vSm:SalesmanReportView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmCo:CompanyReportViewModel}"><vCo:CompanyReportView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmPr:ProjectReportViewModel}"><vPr:ProjectReportView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmJo:JoReportViewModel}"><vJo:JoReportView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmDn:DeliveryReportViewModel}"><vDn:DeliveryReportView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmTi:TaxInvoiceReportViewModel}"><vTi:TaxInvoiceReportView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmGs:GlassSpecReportViewModel}"><vGs:GlassSpecReportView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmPf:ProfitabilityReportViewModel}"><vPf:ProfitabilityReportView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmEx:ExecutiveReportViewModel}"><vEx:ExecutiveReportView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmStRep:StatementReportViewModel}"><vStRep:StatementReportView/></DataTemplate>

        <!-- Report Navigation Button Style -->
        <Style x:Key="ReportNavButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Tag" Value="Inactive"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="{DynamicResource Radius.Medium}"
                                Padding="10,8"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{DynamicResource Border.HairlineThickness}"
                                BorderBrush="Transparent"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TintBlueBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
                                <!-- CONTRAST: the active pill fills with AccentBrush, so the
                                     content must flip to the on-accent foreground. The old
                                     hand-copied cards did this with a per-TextBlock DataTrigger
                                     in every block; doing it once here means the data-driven
                                     template cannot forget it and the label can never render
                                     dark-on-dark. TextElement.Foreground inherits into the
                                     ContentPresenter, covering title and subtitle together. -->
                                <Setter TargetName="Bd" Property="TextElement.Foreground"
                                        Value="{DynamicResource OnAccentForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hamburger (module header strip) — self-contained so the
             reports hub does not depend on MainWindow-local resources. -->
        <Style x:Key="ReportHamburgerButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <TextBlock Text="&#xE700;"
                                       FontFamily="{DynamicResource FontFamily.Icon}"
                                       FontSize="{DynamicResource FontSize.H3}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TintBlueBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <!-- The 268px width lives on the rail Border and the column is
                 Auto, so the rail shrinks to 0 when collapsed (IsRailOpen
                 drives the Visibility). The rail STAYS OPEN across report
                 switches; the hamburger (ToggleRailCommand) collapses it on
                 demand for a full-width view. -->
            <ColumnDefinition x:Name="RailColumn" Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             LEFT — NAVIGATION RAIL (stays open on report pick; the
             hamburger collapses/expands it on demand)
        ══════════════════════════════════════════════════════════════ -->
        <Border CornerRadius="{DynamicResource CardCornerRadius}"
                Grid.Column="0"
                Margin="14,14,6,14"
                Width="268"
                Visibility="{Binding IsRailOpen,
                    Converter={StaticResource BoolToVisibilityConverter}}"
                Background="{DynamicResource SurfaceSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{DynamicResource Border.HairlineThickness}"
                SnapsToDevicePixels="True">

            <Grid Margin="10,12,10,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <Border Grid.Row="0" Margin="4,2,4,10" Style="{StaticResource DocumentHeaderBandStyle}" Padding="12,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource ModuleListKpiIconStyle}" Grid.Column="0" Background="{DynamicResource TintIndigoBrush}">
                            <TextBlock Text="&#xE9D2;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.H2}" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Reports.ReportsHUB}" Style="{StaticResource ModulePageSubtitleStyle}"/>
                            <TextBlock Text="{DynamicResource Reports.IntelligenceCenter}" Style="{StaticResource ModulePageTitleStyle}" Margin="0,1,0,0"/>
                            <TextBlock Text="{DynamicResource Reports.RowLevelTraceability}" Style="{StaticResource ModulePageSubtitleStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <!-- Collapse rail button (hamburger style) -->
                        <Button Grid.Column="2"
                                Width="30" Height="30"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                BorderThickness="{DynamicResource Border.NoneThickness}"
                                Cursor="Hand"
                                ToolTip="{DynamicResource Reports.CollapseNavigationRail}"
                                Command="{Binding ToggleRailCommand}">
                            <TextBlock Text="&#xE76B;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.Title}" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Navigation List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="2,0,2,6">
                    <StackPanel>

                        <!-- ═══════════════════════════════════════════════
                             DATA-DRIVEN HUB RAIL (2026-09-02)
                             Was SIX hand-copied ~26-line <Button> blocks that
                             differed only by icon / title / subtitle / key.
                             They had already drifted from the view model's
                             NavItems list, which nothing was bound to: it
                             declares SEVEN reports, so "VAT Submission" was
                             implemented but unreachable. Now one template
                             renders every item, and adding a report means
                             adding one line to NavItems.

                             Titles bind through ResourceKeyToString so the
                             rail still translates on a live language switch.
                        ══════════════════════════════════════════════════ -->
                        <ItemsControl ItemsSource="{Binding NavItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <!-- Optional group heading, from data. -->
                                        <TextBlock Text="{Binding Group, Converter={StaticResource ResourceKeyToString}}"
                                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Margin="8,10,8,4">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Group}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Button Command="{Binding DataContext.NavigateReportCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Key}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ReportNavButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource StringEqualsMultiConverter}">
                                                                    <Binding Path="Key"/>
                                                                    <Binding Path="DataContext.ActiveKey"
                                                                             RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Tag" Value="Active"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="{DynamicResource Radius.Small}"
                                                        Background="{DynamicResource SurfaceTertiaryBrush}">
                                                    <TextBlock Text="{Binding Icon}"
                                                               FontFamily="{DynamicResource FontFamily.Icon}"
                                                               FontSize="{DynamicResource FontSize.Body}"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <!-- Foreground is set via a trigger, NOT as a local
                                                         value: a local Foreground would win over the
                                                         TextElement.Foreground the active-pill trigger
                                                         inherits down, leaving dark text on the accent
                                                         fill. Default here, flip when this item is the
                                                         active one. -->
                                                    <TextBlock Text="{Binding TitleKey, Converter={StaticResource ResourceKeyToString}}"
                                                               FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Value="True">
                                                                        <DataTrigger.Binding>
                                                                            <MultiBinding Converter="{StaticResource StringEqualsMultiConverter}">
                                                                                <Binding Path="Key"/>
                                                                                <Binding Path="DataContext.ActiveKey"
                                                                                         RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                            </MultiBinding>
                                                                        </DataTrigger.Binding>
                                                                        <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                                        <Setter Property="FontWeight" Value="{DynamicResource Weight.Bold}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding SubtitleKey, Converter={StaticResource ResourceKeyToString}}"
                                                               FontSize="{DynamicResource FontSize.Body}"
                                                               Margin="0,1,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Value="True">
                                                                        <DataTrigger.Binding>
                                                                            <MultiBinding Converter="{StaticResource StringEqualsMultiConverter}">
                                                                                <Binding Path="Key"/>
                                                                                <Binding Path="DataContext.ActiveKey"
                                                                                         RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                            </MultiBinding>
                                                                        </DataTrigger.Binding>
                                                                        <Setter Property="Foreground" Value="{DynamicResource OnAccentSecondaryForegroundBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer: Centralized Layer Status -->
                <Border Grid.Row="2" Margin="4,6,4,2" CornerRadius="{DynamicResource CardCornerRadius}" Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}" Padding="10,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="8" CornerRadius="{DynamicResource Radius.XSmall}" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Reports.CentralDataLayer}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Reports.LiveTotalsPIJODeliveryTaxInvoiceStatement}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             RIGHT — ACTIVE REPORT CONTENT
        ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Background="{DynamicResource SurfacePrimaryBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ MODULE HEADER STRIP — hamburger + active report title ═══ -->
            <Border Grid.Row="0" Style="{StaticResource ReportTableHeaderStyle}"
                    Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="{DynamicResource Border.BottomHairlineThickness}"
                    Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Hamburger — reopens the rail when collapsed -->
                    <Button Grid.Column="0"
                            Style="{StaticResource ReportHamburgerButton}"
                            Content="&#xE700;"
                            Command="{Binding ToggleRailCommand}"
                            ToolTip="{DynamicResource Reports.ToggleReportsNavigation}"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource ReportHeaderTextStyle}" Text="{Binding CurrentReportTitle}"
                                   FontSize="{DynamicResource FontSize.H2}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Style="{StaticResource ReportHeaderTextStyle}" Text="{DynamicResource Reports.CentralReporting}"
                                   FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- Data-layer live indicator -->
                    <Border Grid.Column="2"
                            CornerRadius="{DynamicResource Radius.Medium}"
                            Padding="10,5"
                            VerticalAlignment="Center"
                            Background="{DynamicResource TintGreenBrush}"
                            BorderBrush="{DynamicResource SuccessBrush}"
                            BorderThickness="{DynamicResource Border.HairlineThickness}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="7" Height="7" CornerRadius="{DynamicResource Radius.XSmall}"
                                    Background="{DynamicResource SuccessBrush}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource ReportHeaderTextStyle}" Text="{DynamicResource Reports.LIVEDATA}"
                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ ACTIVE CONTENT ═══ -->
            <Grid Grid.Row="1">

            <!-- Default: Overview Dashboard -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOverview}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel HorizontalAlignment="Stretch">

                    <!-- Overview Header Banner -->
                    <Border Style="{StaticResource DocumentHeaderBandStyle}" Padding="20,18" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Reports.ReportsOverview}" Style="{StaticResource ModulePageSubtitleStyle}"/>
                                <TextBlock Text="{DynamicResource Reports.DocumentsFulfillment}" Style="{StaticResource ModulePageTitleStyle}" Margin="0,6,0,0"/>
                                <TextBlock Text="{DynamicResource Reports.LiveTotalsProformaInvoicesJobOrdersDelivery}" Style="{StaticResource ModulePageSubtitleStyle}" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="680"/>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBlock FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource AccentBrush}">
                                        <Run Text="PI"/><Run Text="  →  "/><Run Text="JO"/><Run Text="  →  "/><Run Text="{DynamicResource Nav.Delivery}"/><Run Text="  →  "/><Run Text="{DynamicResource Module.TaxInvoice}"/><Run Text="  →  "/><Run Text="{DynamicResource Module.Statement}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="1" Width="72" Height="72" CornerRadius="{DynamicResource Radius.Large}" Background="{DynamicResource TintIndigoBrush}" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="&#xE9D2;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.Display}" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                                        <!-- ══════════════════════════════════════════════════════
                         KPI STRIP — one card per document in the real flow:
                         PI → Job Order → Delivery → Tax Invoice → Statement.
                         Every figure is bound to the live report summaries.
                    ══════════════════════════════════════════════════════ -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Proforma Invoice -->
                        <Button Grid.Column="0" Command="{Binding NavigateReportCommand}" CommandParameter="Pi" Background="Transparent" BorderThickness="{DynamicResource Border.NoneThickness}" Cursor="Hand" HorizontalContentAlignment="Stretch" ToolTip="{DynamicResource Reports.OpenProformaInvoiceReport}" Style="{StaticResource SecondaryButtonStyle}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Card" Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}" CornerRadius="{DynamicResource Radius.Large}" Padding="16,14" SnapsToDevicePixels="True">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="32" Height="32" CornerRadius="{DynamicResource Radius.Small}" Background="{DynamicResource TintBlueBrush}">
                                                    <TextBlock Text="&#xE8A5;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.H3}" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{DynamicResource JobProfitability.Proforma}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding PiReport.Summary.TotalPi}" FontSize="{DynamicResource FontSize.Display}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,12,0,0"/>
                                            <TextBlock FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0">
                                                <Run Text="AED "/><Run Text="{Binding PiReport.Summary.TotalValue, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                                <Run Text=" · "/><Run Text="{Binding PiReport.Summary.Converted, Mode=OneWay}"/><Run Text="{DynamicResource Reports.PiReport.Converted}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Job Order -->
                        <Button Grid.Column="2" Command="{Binding NavigateReportCommand}" CommandParameter="Jo" Background="Transparent" BorderThickness="{DynamicResource Border.NoneThickness}" Cursor="Hand" HorizontalContentAlignment="Stretch" ToolTip="{DynamicResource Reports.OpenJobOrderReport}" Style="{StaticResource SecondaryButtonStyle}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Card" Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}" CornerRadius="{DynamicResource Radius.Large}" Padding="16,14" SnapsToDevicePixels="True">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="32" Height="32" CornerRadius="{DynamicResource Radius.Small}" Background="{DynamicResource TintAmberBrush}">
