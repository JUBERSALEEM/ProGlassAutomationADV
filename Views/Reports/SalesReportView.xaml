                                                <Run Text="AED "/><Run Text="{Binding StatementReport.Summary.ClosingBalance, Mode=OneWay, StringFormat={}{0:N0}}"/><Run Text="{DynamicResource Common.Outstanding}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
