                                            <TextBlock Text="{Binding StatementReport.Summary.TotalCount}" FontSize="{DynamicResource FontSize.Display}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,12,0,0"/>
