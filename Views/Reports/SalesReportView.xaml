<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Reports/SalesReportView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Central Reporting — Hub Shell & Overview Dashboard

     PURPOSE:
       Enterprise hub for module-based Reports system in ProGlass Automation.
       Left panel: Floating rounded navigation rail with 11 categorized items:
         • DOCUMENTS: Overview, Proforma Invoice, Job Order, Delivery, Tax Invoice
         • MASTER DATA: Company / Customer, Salesman, Project
         • INTELLIGENCE: Glass / Specification, Statement, Profitability / P&L
       Right pane: Active report ViewModel rendered via DataTemplates.
       Overview screen: Global KPI summary, workflow guidance, and quick actions.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl
    x:Class="ProGlassAutomation.Views.Reports.SalesReportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vmPi="clr-namespace:ProGlassAutomation.ViewModels.Reports.PiReport"
    xmlns:vmJo="clr-namespace:ProGlassAutomation.ViewModels.Reports.JoReport"
    xmlns:vmDn="clr-namespace:ProGlassAutomation.ViewModels.Reports.DeliveryReport"
    xmlns:vmTi="clr-namespace:ProGlassAutomation.ViewModels.Reports.TaxInvoiceReport"
    xmlns:vmComp="clr-namespace:ProGlassAutomation.ViewModels.Reports.CompanyReport"
    xmlns:vmSales="clr-namespace:ProGlassAutomation.ViewModels.Reports.SalesmanReport"
    xmlns:vmProj="clr-namespace:ProGlassAutomation.ViewModels.Reports.ProjectReport"
    xmlns:vmGlass="clr-namespace:ProGlassAutomation.ViewModels.Reports.GlassSpecReport"
    xmlns:vmStRep="clr-namespace:ProGlassAutomation.ViewModels.Reports.StatementReport"
    xmlns:vmProf="clr-namespace:ProGlassAutomation.ViewModels.Reports.ProfitabilityReport"
    xmlns:vmList="clr-namespace:ProGlassAutomation.ViewModels.Reports.StatementList"
    xmlns:vmGen="clr-namespace:ProGlassAutomation.ViewModels.Reports.StatementGenerator"
    xmlns:vPi="clr-namespace:ProGlassAutomation.Views.Reports.PiReport"
    xmlns:vJo="clr-namespace:ProGlassAutomation.Views.Reports.JoReport"
    xmlns:vDn="clr-namespace:ProGlassAutomation.Views.Reports.DeliveryReport"
    xmlns:vTi="clr-namespace:ProGlassAutomation.Views.Reports.TaxInvoiceReport"
    xmlns:vComp="clr-namespace:ProGlassAutomation.Views.Reports.CompanyReport"
    xmlns:vSales="clr-namespace:ProGlassAutomation.Views.Reports.SalesmanReport"
    xmlns:vProj="clr-namespace:ProGlassAutomation.Views.Reports.ProjectReport"
    xmlns:vGlass="clr-namespace:ProGlassAutomation.Views.Reports.GlassSpecReport"
    xmlns:vStRep="clr-namespace:ProGlassAutomation.Views.Reports.StatementReport"
    xmlns:vProf="clr-namespace:ProGlassAutomation.Views.Reports.ProfitabilityReport"
    xmlns:vList="clr-namespace:ProGlassAutomation.Views.Reports.StatementList"
    xmlns:vGen="clr-namespace:ProGlassAutomation.Views.Reports.StatementGenerator.Shell"
    FontFamily="Segoe UI"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- VM → View Mappings -->
        <DataTemplate DataType="{x:Type vmPi:PiReportViewModel}"><vPi:PiReportView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmJo:JoReportViewModel}"><vJo:JoReportView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmDn:DeliveryReportViewModel}"><vDn:DeliveryReportView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmTi:TaxInvoiceReportViewModel}"><vTi:TaxInvoiceReportView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmComp:CompanyReportViewModel}"><vComp:CompanyReportView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmSales:SalesmanReportViewModel}"><vSales:SalesmanReportView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmProj:ProjectReportViewModel}"><vProj:ProjectReportView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmGlass:GlassSpecReportViewModel}"><vGlass:GlassSpecReportView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmStRep:StatementReportViewModel}"><vStRep:StatementReportView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmProf:ProfitabilityReportViewModel}"><vProf:ProfitabilityReportView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmList:StatementListViewModel}"><vList:StatementListView/></DataTemplate>
        <DataTemplate DataType="{x:Type vmGen:StatementGeneratorViewModel}"><vGen:StatementGeneratorView/></DataTemplate>

        <!-- Report Navigation Button Style -->
        <Style x:Key="ReportNavButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Tag" Value="Inactive"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="10"
                                Padding="10,8"
                                Background="{TemplateBinding Background}"
                                BorderThickness="1"
                                BorderBrush="Transparent"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TintBlueBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="268"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             LEFT — NAVIGATION RAIL
        ══════════════════════════════════════════════════════════════ -->
        <Border CornerRadius="{DynamicResource CardCornerRadius}"
                Grid.Column="0"
                Margin="14,14,6,14"
                Background="{DynamicResource SideMenuBackgroundBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2"
                                  Direction="270" Opacity="0.10"
                                  Color="#000000"/>
            </Border.Effect>

            <Grid Margin="10,12,10,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <Border Grid.Row="0" Margin="4,2,4,10" CornerRadius="12" Background="{DynamicResource AccentBrush}" Padding="12,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="White" Opacity="0.92">
                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="REPORTS HUB" FontSize="10" FontWeight="Bold" Foreground="#DBEAFE" Opacity="0.95"/>
                            <TextBlock Text="Intelligence Center" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,1,0,0"/>
                            <TextBlock Text="Row-level traceability" FontSize="10.5" Foreground="#BFDBFE" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Navigation List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="2,0,2,6">
                    <StackPanel>

                        <!-- Overview -->
                        <Button Tag="Overview" Click="Nav_Click" ToolTip="Global overview dashboard showing combined ERP analytics">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ReportNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveKey}" Value="Overview"><Setter Property="Tag" Value="Active"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="7" Background="{DynamicResource MenuHoverBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveKey}" Value="Overview"><Setter Property="Background" Value="White"/><Setter Property="Opacity" Value="0.95"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Overview" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Overview"><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="KPI dashboard" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,1,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Overview"><Setter Property="Foreground" Value="#E0E7FF"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <TextBlock Text="DOCUMENTS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" Margin="8,10,8,4"/>

                        <!-- Proforma Invoice -->
                        <Button Tag="Pi" Click="Nav_Click" ToolTip="Proforma Invoices: quotes, conversion rates, and itemized rows">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ReportNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveKey}" Value="Pi"><Setter Property="Tag" Value="Active"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="7" Background="{DynamicResource MenuHoverBrush}">
                                    <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Pi"><Setter Property="Background" Value="White"/><Setter Property="Opacity" Value="0.95"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Proforma Invoice" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Pi"><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Quotes &amp; conversion" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,1,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Pi"><Setter Property="Foreground" Value="#E0E7FF"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Job Order -->
                        <Button Tag="Jo" Click="Nav_Click" ToolTip="Job Orders: factory production stages and delivered balance">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ReportNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveKey}" Value="Jo"><Setter Property="Tag" Value="Active"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="7" Background="{DynamicResource MenuHoverBrush}">
                                    <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Jo"><Setter Property="Background" Value="White"/><Setter Property="Opacity" Value="0.95"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Job Order" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Jo"><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Production &amp; status" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,1,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Jo"><Setter Property="Foreground" Value="#E0E7FF"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Delivery -->
                        <Button Tag="Delivery" Click="Nav_Click" ToolTip="Delivery Notes: dispatch tracking, fulfillment rate, and remaining items">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ReportNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveKey}" Value="Delivery"><Setter Property="Tag" Value="Active"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="7" Background="{DynamicResource MenuHoverBrush}">
                                    <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Delivery"><Setter Property="Background" Value="White"/><Setter Property="Opacity" Value="0.95"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <TextBlock Text="&#xE814;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Delivery" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Delivery"><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Dispatched / pending" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,1,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Delivery"><Setter Property="Foreground" Value="#E0E7FF"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Tax Invoice -->
                        <Button Tag="TaxInvoice" Click="Nav_Click" ToolTip="Tax Invoices: billing statuses, collections, and overdue aging">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ReportNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveKey}" Value="TaxInvoice"><Setter Property="Tag" Value="Active"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="7" Background="{DynamicResource MenuHoverBrush}">
                                    <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="TaxInvoice"><Setter Property="Background" Value="White"/><Setter Property="Opacity" Value="0.95"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Tax Invoice" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="TaxInvoice"><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Billed &amp; overdue" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,1,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="TaxInvoice"><Setter Property="Foreground" Value="#E0E7FF"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <TextBlock Text="MASTER DATA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" Margin="8,10,8,4"/>

                        <!-- Company / Customer -->
                        <Button Tag="Company" Click="Nav_Click" ToolTip="Client and operating company lifecycle from quotation to settlement">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ReportNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveKey}" Value="Company"><Setter Property="Tag" Value="Active"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="7" Background="{DynamicResource MenuHoverBrush}">
                                    <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Company"><Setter Property="Background" Value="White"/><Setter Property="Opacity" Value="0.95"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Company / Customer" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Company"><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Lifecycle per client" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,1,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Company"><Setter Property="Foreground" Value="#E0E7FF"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Salesman -->
                        <Button Tag="Salesman" Click="Nav_Click" ToolTip="Sales representative performance, confirmed values, and quote conversion">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ReportNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveKey}" Value="Salesman"><Setter Property="Tag" Value="Active"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="7" Background="{DynamicResource MenuHoverBrush}">
                                    <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Salesman"><Setter Property="Background" Value="White"/><Setter Property="Opacity" Value="0.95"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Salesman" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Salesman"><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Revenue per rep" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,1,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Salesman"><Setter Property="Foreground" Value="#E0E7FF"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Project -->
                        <Button Tag="Project" Click="Nav_Click" ToolTip="Project-based breakdown of quotations, job orders, and invoicing">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ReportNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveKey}" Value="Project"><Setter Property="Tag" Value="Active"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="7" Background="{DynamicResource MenuHoverBrush}">
                                    <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Project"><Setter Property="Background" Value="White"/><Setter Property="Opacity" Value="0.95"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Project" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Project"><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Project drill-down" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,1,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Project"><Setter Property="Foreground" Value="#E0E7FF"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <TextBlock Text="INTELLIGENCE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" Margin="8,10,8,4"/>

                        <!-- Glass / Specification -->
                        <Button Tag="Glass" Click="Nav_Click" ToolTip="Granular row-level glass specification matching, dimensions, and lifecycle trace">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ReportNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveKey}" Value="Glass"><Setter Property="Tag" Value="Active"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="7" Background="{DynamicResource MenuHoverBrush}">
                                    <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Glass"><Setter Property="Background" Value="White"/><Setter Property="Opacity" Value="0.95"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Glass / Specification" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Glass"><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Row-level intelligence" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,1,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Glass"><Setter Property="Foreground" Value="#E0E7FF"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Statement -->
                        <Button Tag="Statement" Click="Nav_Click" ToolTip="Customer statements, aging analysis, and statement generator wizard">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ReportNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveKey}" Value="Statement"><Setter Property="Tag" Value="Active"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="7" Background="{DynamicResource MenuHoverBrush}">
                                    <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Statement"><Setter Property="Background" Value="White"/><Setter Property="Opacity" Value="0.95"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <TextBlock Text="&#xE9F7;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Statement" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Statement"><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Customer statements" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,1,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Statement"><Setter Property="Foreground" Value="#E0E7FF"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Profitability -->
                        <Button Tag="Profitability" Click="Nav_Click" ToolTip="Profit &amp; Loss analysis: revenue, glass and production costs, and gross margins">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ReportNavButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveKey}" Value="Profitability"><Setter Property="Tag" Value="Active"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="7" Background="{DynamicResource MenuHoverBrush}">
                                    <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Profitability"><Setter Property="Background" Value="White"/><Setter Property="Opacity" Value="0.95"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <TextBlock Text="&#xE913;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Profitability / P&amp;L" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Profitability"><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Revenue, cost, margin" FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,1,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ActiveKey}" Value="Profitability"><Setter Property="Foreground" Value="#E0E7FF"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer: Centralized Layer Status -->
                <Border Grid.Row="2" Margin="4,6,4,2" CornerRadius="10" Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Central Data Layer" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Shared intelligence across PI → JO → Delivery → Tax Invoice → P&amp;L." FontSize="10.5" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             RIGHT — ACTIVE REPORT CONTENT
        ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Background="{DynamicResource ModuleBackgroundBrush}">

            <!-- Default: Overview Dashboard -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOverview}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel HorizontalAlignment="Stretch">

                    <!-- Overview Header Banner -->
                    <Border CornerRadius="16" Background="{DynamicResource AccentBrush}" Padding="20,18" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="REPORTS OVERVIEW" FontSize="10" FontWeight="Bold" Foreground="#DBEAFE"/>
                                <TextBlock Text="Module-Based ERP Intelligence" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,6,0,0"/>
                                <TextBlock Text="Every report uses one centralized data layer and your live database. Drill down from any aggregate to exact specification rows and document lifecycles." FontSize="12" Foreground="#BFDBFE" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="680"/>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Border CornerRadius="20" Background="White" Opacity="0.92" Padding="12,6" Margin="0,0,8,0"><TextBlock Text="ROW-LEVEL TRACEABILITY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/></Border>
                                    <Border CornerRadius="20" Background="White" Opacity="0.92" Padding="12,6" Margin="0,0,8,0"><TextBlock Text="EXACT SPEC MATCHING" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/></Border>
                                    <Border CornerRadius="20" Background="White" Opacity="0.92" Padding="12,6"><TextBlock Text="QTY RECONCILIATION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/></Border>
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="1" Width="120" Height="120" CornerRadius="16" Background="White" Opacity="0.10" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="52" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Quick stats from PI/JO/DN/TI -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,14" ToolTip="Total quotation volume and value from Proforma Invoices">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"><Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource TintBlueBrush}"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Proforma" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
                                <TextBlock Text="{Binding PiReport.Summary.TotalPi}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,12,0,0"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"><Run Text="AED"/><Run Text="{Binding PiReport.Summary.TotalValue, Mode=OneWay, StringFormat={}{0:N0}}"/></TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,14" ToolTip="Total active job orders and pending conversions">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"><Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource TintAmberBrush}"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Job Orders" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
                                <TextBlock Text="{Binding JoReport.Summary.TotalJo}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,12,0,0"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"><Run Text="{Binding JoReport.Summary.AwaitingJo, Mode=OneWay}"/><Run Text=" awaiting JO"/></TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,14" ToolTip="Dispatched delivery notes and fulfillment percentage">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"><Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource TintGreenBrush}"><TextBlock Text="&#xE814;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Deliveries" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
                                <TextBlock Text="{Binding DeliveryReport.Summary.TotalDn}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,12,0,0"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"><Run Text="{Binding DeliveryReport.Summary.CompletionPct, Mode=OneWay, StringFormat={}{0:0.#}}"/><Run Text="% delivered"/></TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,14" ToolTip="Total issued invoices and billed amounts">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"><Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource TintIndigoBrush}"><TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Tax Invoices" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
                                <TextBlock Text="{Binding TaxInvoiceReport.Summary.TotalInvoices}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,12,0,0"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"><Run Text="AED"/><Run Text="{Binding TaxInvoiceReport.Summary.TotalAmount, Mode=OneWay, StringFormat={}{0:N0}}"/></TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Workflow Guidance Banner -->
                    <Border Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="TRACE ANY GLASS ROW" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <TextBlock Text="PI → Row → Job Order → Delivery → Tax Invoice → Profitability — every aggregate is explainable and verifiable." FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Open PI Report" Tag="Pi" Click="Nav_Click" Style="{StaticResource PrimaryPillButton}" Height="32" Margin="0,0,8,0" ToolTip="Switch to Proforma Invoice report"/>
                                <Button Content="Inspect Glass Rows" Tag="Glass" Click="Nav_Click" Style="{StaticResource RowOutlinedButton}" Height="32" ToolTip="Switch to Glass / Specification row-level intelligence"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Shortcuts Grid -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                            <StackPanel>
                                <TextBlock Text="LIFECYCLE BY CUSTOMER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                <TextBlock Text="Open Company / Customer report to follow PI → JO → DN → TI → Statement for any client with quantities, specs, pending items, and profitability." FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <Button Content="Open →" Tag="Company" Click="Nav_Click" Style="{StaticResource RowPrimaryButton}" Height="32" Margin="0,12,0,0" HorizontalAlignment="Left" ToolTip="Open Company / Customer Report"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                            <StackPanel>
                                <TextBlock Text="ROW-LEVEL SPEC INTELLIGENCE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                <TextBlock Text="Glass / Specification report reads the real spec rows stored inside the PI JSON — exact matching by type-aware identity, dimensions, colour, thickness, PVB, and spacer." FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <Button Content="Inspect →" Tag="Glass" Click="Nav_Click" Style="{StaticResource RowPrimaryButton}" Height="32" Margin="0,12,0,0" HorizontalAlignment="Left" ToolTip="Open Glass / Specification Report"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- Active Report Container -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOverview}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- Statement Generator Overlay -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ActiveKey}" Value="Statement"/>
                                        <Condition Binding="{Binding ShowGenerator}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ContentControl Content="{Binding GeneratorVM}"/>
                </Grid>

                <!-- Regular Report Host -->
                <ContentControl Content="{Binding ActiveViewModel}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ActiveKey}" Value="Statement"/>
                                        <Condition Binding="{Binding ShowGenerator}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>

            </Grid>

        </Grid>
    </Grid>
</UserControl>