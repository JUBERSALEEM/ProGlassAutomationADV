<UserControl x:Class="ProGlassAutomation.Views.Reports.CompanyReport.CompanyReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loading="clr-namespace:ProGlassAutomation.Controls.LoadingState"
             xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="16,14,16,12">
            <TextBlock Text="Company / Customer Report" Style="{StaticResource ModulePageTitleStyle}" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Client and company lifecycles: Quotations → Job Orders → Deliveries → Invoices with amounts, volumes, and balances." Style="{StaticResource ModulePageSubtitleStyle}" TextWrapping="Wrap" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- Main Shell Card -->
        <Border Grid.Row="1" Style="{StaticResource ModuleListShellStyle}" Margin="16,0,16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- View Toggle -->
                    <RowDefinition Height="Auto"/> <!-- Filter Bar -->
                    <RowDefinition Height="*"/>    <!-- Data Tables / States -->
                    <RowDefinition Height="Auto"/> <!-- Lifecycle Detail Drawer -->
                    <RowDefinition Height="Auto"/> <!-- Pagination Footer -->
                </Grid.RowDefinitions>

                <!-- ══════════════════════════════════════════════════════════
                     1. VIEW TOGGLE STRIP
                ══════════════════════════════════════════════════════════════ -->
                <Border Grid.Row="0" Style="{StaticResource ModuleListKpiStripStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Customer View" Click="Customer_Click" Height="32" Padding="14,0" Margin="0,0,8,0" ToolTip="View aggregated quotes, job orders, and balances grouped by customer">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource RowPrimaryButton}">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowCustomers}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource TintGrayBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Company View" Click="Company_Click" Height="32" Padding="14,0" Margin="0,0,8,0" ToolTip="View summary volume and billing grouped by internal company profile">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource RowOutlinedButton}">
                                    <Setter Property="Background" Value="{DynamicResource TintGrayBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowCustomers}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Text="Select a customer row to view full document history." FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ══════════════════════════════════════════════════════════
                     2. FILTER BAR
                ══════════════════════════════════════════════════════════════ -->
                <Border Grid.Row="1" Style="{StaticResource ModuleListFilterBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <!-- Search -->
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="SEARCH" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <TextBox Width="200" Height="34" Style="{StaticResource ModuleListFilterInputStyle}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Customer / Company / Rep..." ToolTip="Search by customer, company, or sales representative"/>
                            </StackPanel>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,6,6">
                                <Button Content="Apply" Command="{Binding ApplyFilterCommand}" Style="{StaticResource ReportToolbarPrimaryButton}" ToolTip="Apply selected filters"/>
                                <Button Content="Clear" Command="{Binding ClearFilterCommand}" Style="{StaticResource ReportToolbarOutlinedButton}" ToolTip="Reset filters"/>
                            </StackPanel>
                        </WrapPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="8,0,0,6">
                            <TextBlock Text="EXPORT" Style="{StaticResource ModuleFieldLabelStyle}" HorizontalAlignment="Right"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource ReportExportOutlinedButton}" ToolTip="Export current table to CSV"/>
                                <Button Content="Excel" Command="{Binding ExportExcelCommand}" Style="{StaticResource ReportExportOutlinedButton}" ToolTip="Export current table to Excel (.xlsx)"/>
                                <Button Content="PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource ReportExportPrimaryButton}" ToolTip="Export to PDF report"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════════════════
                     3. DATA TABLES (Customer View & Company View)
                ══════════════════════════════════════════════════════════════ -->

                <!-- Customer Table Mode -->
                <Grid Grid.Row="2">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowCustomers}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ReportTableHeaderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CUSTOMER" Style="{StaticResource ReportHeaderTextStyle}"/>
                            <TextBlock Grid.Column="1" Text="SALESMAN" Style="{StaticResource ReportHeaderTextStyle}"/>
                            <TextBlock Grid.Column="2" Text="PIs" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="JOs" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="TIs" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="PI VALUE" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="6" Text="OUTSTANDING" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding CustomerRows}" SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                             Style="{StaticResource ModuleReportListBoxStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ModuleListRowStyle}" Padding="16,11" Cursor="Hand" ToolTip="Click to view full lifecycle and quote history for this customer">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding CustomerName}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Salesman}" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding PiCount}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding JoCount}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding TiCount}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding PiValue, StringFormat={}AED {0:N0}}" FontSize="12" HorizontalAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="{Binding Outstanding, StringFormat={}AED {0:N0}}" FontSize="12" HorizontalAlignment="Right" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Company Table Mode -->
                <Grid Grid.Row="2">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowCustomers}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ReportTableHeaderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="COMPANY" Style="{StaticResource ReportHeaderTextStyle}"/>
                            <TextBlock Grid.Column="1" Text="PIs" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="JOs" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="TIs" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="PI VALUE" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="5" Text="INVOICED" Style="{StaticResource ReportHeaderTextStyle}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding CompanyRows}"
                             Style="{StaticResource ModuleReportListBoxStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ModuleListRowStyle}" Padding="16,11" ToolTip="Operating company summary">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding CompanyName}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding PiCount}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding JobOrderCount}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding TaxInvoiceCount}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding PiValue, StringFormat={}AED {0:N0}}" FontSize="12" HorizontalAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding InvoicedValue, StringFormat={}AED {0:N0}}" FontSize="12" HorizontalAlignment="Right" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <loading:LoadingStateControl Grid.Row="2" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" Message="Loading company and customer analytics…"/>
                <emptyState:EmptyStateControl Grid.Row="2" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" Title="No records found" Message="No customer or company records match the current filters." Icon="&#xE77B;"/>

                <!-- Error State -->
                <Border Grid.Row="2" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="{DynamicResource TintRedBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                        CornerRadius="10" Margin="16" Padding="20">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Unable to load records" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,4,0,12" MaxWidth="500" TextAlignment="Center"/>
                        <Button Content="Retry" Command="{Binding RefreshCommand}" Style="{StaticResource ReportRetryButton}" HorizontalAlignment="Center" ToolTip="Retry loading records"/>
                    </StackPanel>
                </Border>

                <!-- ══════════════════════════════════════════════════════════
                     4. LIFECYCLE DETAIL DRAWER
                ══════════════════════════════════════════════════════════════ -->
                <Border Grid.Row="3" Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVisibilityConverter}}" Background="{DynamicResource MenuHoverBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="14,10">
                    <StackPanel>
                        <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}">
                            <Run Text="Lifecycle Trace — "/><Run Text="{Binding SelectedCustomer.CustomerName, Mode=OneWay}"/><Run Text=" ("/><Run Text="{Binding PiLifecycle.Count, Mode=OneWay}"/><Run Text=" quotes)"/>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding PiLifecycle}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ProformaId, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Status, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ProjectName, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="3" Text="{Binding GrandTotal, Mode=OneWay, StringFormat={}AED {0:N2}}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ══════════════════════════════════════════════════════════
                     5. PAGINATION FOOTER
                ══════════════════════════════════════════════════════════════ -->
                <Border Grid.Row="4" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding PageDisplay}" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="‹ Prev" Command="{Binding PrevPageCommand}" Style="{StaticResource ReportPaginationButton}" ToolTip="Go to previous page"/>
                            <Button Content="Next ›" Command="{Binding NextPageCommand}" Style="{StaticResource ReportPaginationButton}" ToolTip="Go to next page"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>