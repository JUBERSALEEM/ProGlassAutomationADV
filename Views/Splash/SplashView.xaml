<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Splash/SplashView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Splash Screen — "Studio Ivory & Glass" full rewrite (2026-10-06)

     Approved direction: splash concept #5 — warm ivory studio canvas with
     pastel-indigo floating glass panes and soft glass spheres; the brand
     isometric glass-cube emblem centered with wordmark, keyline divider,
     tagline and a quiet progress pill.

     FULL REWRITE (not a reskin): new composition, new vector artwork, new
     typography hierarchy. Behaviour contract with SplashView.xaml.cs is
     preserved 100%:
       • every x:Name the code-behind drives exists with the right type
         (blobs/droplets Ellipses + TranslateTransforms, FluidBlob Path +
         Scale/Translate, LogoBorder/LogoScale, AppNameText/AppNameTranslate,
         ProgressTrack/ProgressBorder/ProgressFill/ProgressRotate/
         ProgressIndicator/StatusLabel, GlassFacePath, BrandTitleText,
         DividerLabel/Rules/DiamondGlyph, SubtitleLabel, captions,
         PosterHost/LoginHost/SetupHost + gates, TermsPanel/TermsBar +
         Accept/Continue/Decline).
       • No Blur/DropShadow on anything that moves (perf rule from v4:
         live effects on a maximized topmost window stalled the driver).
         Depth is painted with gradients and opacity only.
       • SplashThemeManager can still re-tint: CanvasBg (window+root),
         GlassFacePath.Fill, title/subtitle/keyline/accent.
═══════════════════════════════════════════════════════════════════ -->
<Window x:Class="ProGlassAutomation.Views.Splash.SplashView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:updates="clr-namespace:ProGlassAutomation.Services.Updates"
        xmlns:login="clr-namespace:ProGlassAutomation.Views.Login"
        xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
        Title="{DynamicResource Shell.AppTitle}"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#FBF9F3"
        ShowInTaskbar="False"
        Topmost="True"
        behaviors:ViewportFitBehavior.DisableZoom="True"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- ══ Studio palette (concept #5) ═══════════════════════════ -->
        <SolidColorBrush x:Key="Sp.Canvas" Color="#FBF9F3"/>
        <SolidColorBrush x:Key="Sp.Ink" Color="#241B3A"/>
        <SolidColorBrush x:Key="Sp.Muted" Color="#6B6078"/>
        <SolidColorBrush x:Key="Sp.Keyline" Color="#D9D0EC"/>
        <SolidColorBrush x:Key="Sp.Accent" Color="#6546B5"/>
        <SolidColorBrush x:Key="Sp.AccentDeep" Color="#493080"/>
        <SolidColorBrush x:Key="Sp.White" Color="#FFFFFF"/>

        <RadialGradientBrush x:Key="Sp.Wash" Center="0.35,0.3" RadiusX="0.9" RadiusY="0.9">
            <GradientStop Color="#E7E0F6" Offset="0"/>
            <GradientStop Color="#E7E0F6" Offset="0.55"/>
            <GradientStop Color="#00E7E0F6" Offset="1"/>
        </RadialGradientBrush>

        <!-- Glass sphere (soft 3D ball like concept #5) -->
        <RadialGradientBrush x:Key="Sp.Sphere" Center="0.32,0.28" RadiusX="0.95" RadiusY="0.95">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#CDBCF0" Offset="0.35"/>
            <GradientStop Color="#8568CF" Offset="0.75"/>
            <GradientStop Color="#6546B5" Offset="1"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="Sp.SphereSoft" Center="0.32,0.28" RadiusX="0.95" RadiusY="0.95">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#E4DCF7" Offset="0.45"/>
            <GradientStop Color="#B4A1E1" Offset="1"/>
        </RadialGradientBrush>

        <!-- Floating pane glass -->
        <LinearGradientBrush x:Key="Sp.Pane" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B4A1E1" Offset="0"/>
            <GradientStop Color="#8568CF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Sp.PaneLight" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EFEAFB" Offset="0"/>
            <GradientStop Color="#CDBCF0" Offset="1"/>
        </LinearGradientBrush>

        <!-- Emblem faces -->
        <LinearGradientBrush x:Key="Sp.FaceTop" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EFEAFB" Offset="0"/>
            <GradientStop Color="#B4A1E1" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Sp.FaceLeft" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8568CF" Offset="0"/>
            <GradientStop Color="#5A3FA8" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Sp.FaceRight" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#A78BDA" Offset="0"/>
            <GradientStop Color="#6546B5" Offset="1"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="Sp.Glow" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#7C5FC7" Offset="0"/>
            <GradientStop Color="#46FFFFFF" Offset="0.6"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </RadialGradientBrush>

        <Style x:Key="TermsLead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#241B3A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="TermsBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="LineHeight" Value="24"/>
            <Setter Property="Foreground" Value="#5D5470"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainRootGrid" Background="{StaticResource Sp.Canvas}">

        <!-- ══════════ ATMOSPHERE — wash, panes, spheres, droplets ══════════ -->
        <Canvas ClipToBounds="True">
            <!-- Lavender wash top-left (concept #5) -->
            <Ellipse Width="1100" Height="800" Canvas.Left="-260" Canvas.Top="-300"
                     Fill="{StaticResource Sp.Wash}"/>
            <Ellipse Width="900" Height="700" Canvas.Left="900" Canvas.Top="420"
                     Fill="{StaticResource Sp.Wash}" Opacity="0.55"/>

            <!-- Floating glass panes — right cluster -->
            <Border Width="430" Height="300" Canvas.Left="1020" Canvas.Top="120"
                    Background="{StaticResource Sp.PaneLight}" Opacity="0.5"
                    CornerRadius="18" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><RotateTransform Angle="-14"/></Border.RenderTransform>
            </Border>
            <Border Width="360" Height="250" Canvas.Left="1150" Canvas.Top="260"
                    Background="{StaticResource Sp.Pane}" Opacity="0.35"
                    CornerRadius="16" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><RotateTransform Angle="-14"/></Border.RenderTransform>
            </Border>
            <!-- Floating glass panes — left cluster -->
            <Border Width="380" Height="270" Canvas.Left="-140" Canvas.Top="430"
                    Background="{StaticResource Sp.PaneLight}" Opacity="0.5"
                    CornerRadius="18" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><RotateTransform Angle="12"/></Border.RenderTransform>
            </Border>
            <Border Width="300" Height="210" Canvas.Left="-60" Canvas.Top="560"
                    Background="{StaticResource Sp.Pane}" Opacity="0.3"
                    CornerRadius="14" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><RotateTransform Angle="12"/></Border.RenderTransform>
            </Border>

            <!-- Large bouncy glass spheres (code animates these translates;
                 no blur — gradient depth only) -->
            <Ellipse x:Name="BgBlob1" Width="340" Height="340" Canvas.Left="-120" Canvas.Top="-110"
                     Fill="{StaticResource Sp.SphereSoft}" Opacity="0.5">
                <Ellipse.RenderTransform><TranslateTransform x:Name="BgBlob1Translate"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="BgBlob2" Width="260" Height="260" Canvas.Left="1210" Canvas.Top="560"
                     Fill="{StaticResource Sp.Sphere}" Opacity="0.38">
                <Ellipse.RenderTransform><TranslateTransform x:Name="BgBlob2Translate"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="BgBlob3" Width="180" Height="180" Canvas.Left="240" Canvas.Top="640"
                     Fill="{StaticResource Sp.Sphere}" Opacity="0.3">
                <Ellipse.RenderTransform><TranslateTransform x:Name="BgBlob3Translate"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="BgBlob4" Width="140" Height="140" Canvas.Left="1120" Canvas.Top="90"
                     Fill="{StaticResource Sp.SphereSoft}" Opacity="0.55">
                <Ellipse.RenderTransform><TranslateTransform x:Name="BgBlob4Translate"/></Ellipse.RenderTransform>
            </Ellipse>

            <!-- Small orbiting droplets (positioned by code at Loaded) -->
            <Ellipse x:Name="Droplet1" Width="9" Height="9" Fill="#FFFFFF" Opacity="0.85"><Ellipse.RenderTransform><TranslateTransform x:Name="Droplet1Translate"/></Ellipse.RenderTransform></Ellipse>
            <Ellipse x:Name="Droplet2" Width="7" Height="7" Fill="#B4A1E1" Opacity="0.7"><Ellipse.RenderTransform><TranslateTransform x:Name="Droplet2Translate"/></Ellipse.RenderTransform></Ellipse>
            <Ellipse x:Name="Droplet3" Width="6" Height="6" Fill="#8568CF" Opacity="0.55"><Ellipse.RenderTransform><TranslateTransform x:Name="Droplet3Translate"/></Ellipse.RenderTransform></Ellipse>
            <Ellipse x:Name="Droplet4" Width="7" Height="7" Fill="#FFFFFF" Opacity="0.65"><Ellipse.RenderTransform><TranslateTransform x:Name="Droplet4Translate"/></Ellipse.RenderTransform></Ellipse>
            <Ellipse x:Name="Droplet5" Width="8" Height="8" Fill="#CDBCF0" Opacity="0.8"><Ellipse.RenderTransform><TranslateTransform x:Name="Droplet5Translate"/></Ellipse.RenderTransform></Ellipse>
            <Ellipse x:Name="Droplet6" Width="6" Height="6" Fill="#FFFFFF" Opacity="0.7"><Ellipse.RenderTransform><TranslateTransform x:Name="Droplet6Translate"/></Ellipse.RenderTransform></Ellipse>
        </Canvas>

        <!-- ══════════ POSTER — emblem, wordmark, progress ══════════ -->
        <Grid x:Name="PosterHost" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="AppNameTranslate" Y="14"/>
                </StackPanel.RenderTransform>

                <!-- Fluid glow + blob behind the emblem (code bouncy-scales) -->
                <Grid Width="460" Height="380" HorizontalAlignment="Center">
                    <Path x:Name="FluidBlob"
                          Data="M230,26 C320,30 402,96 408,182 C414,268 342,344 236,352 C130,360 52,296 48,204 C44,112 140,22 230,26 Z"
                          Fill="{StaticResource Sp.Glow}" Opacity="0.5"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="FluidBlobScale" ScaleX="0.85" ScaleY="0.85"/>
                                <TranslateTransform x:Name="FluidBlobTranslate"/>
                            </TransformGroup>
                        </Path.RenderTransform>
                    </Path>
                    <Path x:Name="FluidEdge"
                          Data="M96,120 C140,64 210,40 268,52"
                          Stroke="#8568CF" StrokeThickness="2" Opacity="0.35"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Path x:Name="FluidHighlight"
                          Data="M120,96 C168,56 232,42 286,58"
                          Stroke="#FFFFFF" StrokeThickness="3" Opacity="0.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                    <!-- Isometric glass-cube emblem -->
                    <Border x:Name="LogoBorder" Width="240" Height="240"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="Transparent" Opacity="0"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="LogoScale" ScaleX="0.92" ScaleY="0.92"/>
                        </Border.RenderTransform>
                        <Viewbox Stretch="Uniform">
                            <Grid Width="160" Height="170">
                                <!-- top face -->
                                <Path Data="M80,6 L150,44 L80,82 L10,44 Z"
                                      Fill="{StaticResource Sp.FaceTop}" Stroke="#FFFFFF" StrokeThickness="2"/>
                                <!-- left face -->
                                <Path Data="M10,44 L10,122 L80,160 L80,82 Z"
                                      Fill="{StaticResource Sp.FaceLeft}" Stroke="#FFFFFF" StrokeThickness="2"/>
                                <!-- right face (theme-paintable plate) -->
                                <Path x:Name="GlassFacePath" Data="M150,44 L150,122 L80,160 L80,82 Z"
                                      Fill="{StaticResource Sp.FaceRight}" Stroke="#FFFFFF" StrokeThickness="2"/>
                                <!-- glass sheen on right face -->
                                <Path Data="M138,58 L138,112 L96,136"
                                      Stroke="#66FFFFFF" StrokeThickness="3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </Viewbox>
                    </Border>
                </Grid>

                <!-- Wordmark -->
                <TextBlock x:Name="BrandTitleText" Text="ProGlass ERP"
                           HorizontalAlignment="Center" Margin="0,6,0,0"
                           FontSize="46" FontWeight="SemiBold"
                           Foreground="{StaticResource Sp.Ink}"
                           FontFamily="Georgia, 'Times New Roman', Cambria, serif"
                           Opacity="{Binding Opacity, ElementName=AppNameText}"/>

                <!-- Keyline divider -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0"
                            Opacity="{Binding Opacity, ElementName=AppNameText}">
                    <Rectangle x:Name="DividerRuleLeft" Width="56" Height="1" Fill="{StaticResource Sp.Keyline}" VerticalAlignment="Center"/>
                    <Path x:Name="DiamondGlyph" Data="M 5,0 L 10,5 L 5,10 L 0,5 Z"
                          Fill="{StaticResource Sp.Muted}" Width="10" Height="10" Margin="14,0"/>
                    <TextBlock x:Name="DividerLabel" Text="GLASS CUTTING AUTOMATION SUITE"
                               FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource Sp.Muted}" VerticalAlignment="Center" Margin="0,0,0,1"/>
                    <Path Data="M 5,0 L 10,5 L 5,10 L 0,5 Z"
                          Fill="{StaticResource Sp.Muted}" Width="10" Height="10" Margin="14,0"/>
                    <Rectangle x:Name="DividerRuleRight" Width="56" Height="1" Fill="{StaticResource Sp.Keyline}" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="SubtitleLabel" Text="2D nesting · sheet yield · row-level traceability"
                           HorizontalAlignment="Center" Margin="0,10,0,0"
                           FontSize="15" Foreground="{StaticResource Sp.Muted}"
                           Opacity="{Binding Opacity, ElementName=AppNameText}"/>

                <!-- Progress pill -->
                <Grid x:Name="ProgressTrack" Width="300" HorizontalAlignment="Center"
                      Margin="0,30,0,0" Opacity="0">
                    <Border x:Name="ProgressBorder" CornerRadius="22"
                            Background="#B3FFFFFF" BorderThickness="1"
                            BorderBrush="{StaticResource Sp.Keyline}" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- spinner arc (rotated by code) -->
                            <Grid Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Ellipse Width="20" Height="20" Stroke="#266546B5" StrokeThickness="3"/>
                                <Path x:Name="ProgressFill" Data="M10,0 A10,10 0 0 1 20,10"
                                      Stroke="{StaticResource Sp.Accent}" StrokeThickness="3"
                                      StrokeStartLineCap="Round"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="ProgressRotate" Angle="0"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                            <ProgressBar x:Name="ProgressIndicator" Grid.Column="1"
                                         Height="4" Margin="14,0" VerticalAlignment="Center"
                                         Minimum="0" Maximum="100" Value="35"
                                         Foreground="{StaticResource Sp.Accent}"
                                         Background="#1A6546B5" BorderThickness="0">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Grid>
                                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                                            <Border x:Name="PART_Track" Background="Transparent"/>
                                            <Border x:Name="PART_Indicator" CornerRadius="2"
                                                    Background="{TemplateBinding Foreground}"
                                                    HorizontalAlignment="Left"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                            <TextBlock x:Name="StatusLabel" Grid.Column="2" Text="Preparing workspace…"
                                       FontSize="12.5" Foreground="{StaticResource Sp.Muted}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Hidden compat wordmark target (code animates opacity/slide) -->
                <TextBlock x:Name="AppNameText" Text="ProGlass Automation"
                           FontSize="1" Height="0" Opacity="0" Visibility="Hidden"/>
            </StackPanel>
        </Grid>

        <!-- ══════════ CAPTIONS ══════════ -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26">
            <TextBlock x:Name="CaptionMadeIn" Text="{DynamicResource Splash.MadeInIndia}"
                       FontSize="11.5" Foreground="{StaticResource Sp.Muted}"
                       HorizontalAlignment="Center" Opacity="0"/>
            <TextBlock x:Name="CaptionEnterprise" FontSize="11.5" Foreground="{StaticResource Sp.Muted}"
                       HorizontalAlignment="Center" Visibility="Collapsed" Opacity="0"/>
            <TextBlock x:Name="CaptionSecure" FontSize="11.5" Foreground="{StaticResource Sp.Muted}"
                       HorizontalAlignment="Center" Visibility="Collapsed" Opacity="0"/>
            <TextBlock Text="{x:Static updates:AppInfo.Version}" FontSize="10.5"
                       Foreground="#9A91AD" HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- ══════════ LOGIN / SETUP GATES (unchanged behaviour) ══════════ -->
        <Grid x:Name="LoginHost" Visibility="Collapsed" Opacity="0" Panel.ZIndex="11">
            <login:LoginPanel x:Name="LoginGate"/>
        </Grid>
        <Grid x:Name="SetupHost" Visibility="Collapsed" Opacity="0" Panel.ZIndex="12">
            <login:FirstRunSetupPanel x:Name="SetupGate"/>
        </Grid>

        <!-- ══════════ TERMS GATE — studio restyle, same contract ══════════ -->
        <Grid x:Name="TermsPanel" Background="#66FBF9F3" Visibility="Collapsed" Opacity="0" Panel.ZIndex="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,48,0,0">
                <TextBlock Text="{DynamicResource Splash.TermsTitle}" FontSize="32" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="{StaticResource Sp.Ink}"
                           FontFamily="Georgia, 'Times New Roman', Cambria, serif"/>
                <TextBlock Text="{DynamicResource Splash.UaeIntro}" FontSize="14.5"
                           HorizontalAlignment="Center" Margin="0,8,0,0"
                           Foreground="{StaticResource Sp.Muted}"/>
                <Rectangle Height="2" Width="52" Margin="0,16,0,0" RadiusX="1" RadiusY="1"
                           HorizontalAlignment="Center" Fill="{StaticResource Sp.Accent}"/>
            </StackPanel>

            <Border Grid.Row="1" MaxWidth="880" Margin="48,24,48,16" Padding="40,32"
                    CornerRadius="20" BorderBrush="{StaticResource Sp.Keyline}" BorderThickness="1"
                    Background="#F2FFFFFF">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,20"><TextBlock Style="{StaticResource TermsLead}" Text="{DynamicResource Splash.Term1}"/><TextBlock Style="{StaticResource TermsBody}" Text="{DynamicResource Splash.SoftwareAssistsPreparingTaxInvoicesRecords}"/></StackPanel>
                        <StackPanel Margin="0,0,0,20"><TextBlock Style="{StaticResource TermsLead}" Text="{DynamicResource Splash.Term2}"/><TextBlock Style="{StaticResource TermsBody}" Text="{DynamicResource Splash.UAETaxLawRequiresAccountingRecordsTax}"/></StackPanel>
                        <StackPanel Margin="0,0,0,20"><TextBlock Style="{StaticResource TermsLead}" Text="{DynamicResource Splash.Term3}"/><TextBlock Style="{StaticResource TermsBody}" Text="{DynamicResource Splash.FederalDecreeLawNo462021Electronic}"/></StackPanel>
                        <StackPanel Margin="0,0,0,20"><TextBlock Style="{StaticResource TermsLead}" Text="{DynamicResource Splash.Term4}"/><TextBlock Style="{StaticResource TermsBody}" Text="{DynamicResource Splash.FederalDecreeLawNo452021ProtectionPersonal}"/></StackPanel>
                        <StackPanel Margin="0,0,0,20"><TextBlock Style="{StaticResource TermsLead}" Text="{DynamicResource Splash.Term5}"/><TextBlock Style="{StaticResource TermsBody}" Text="{DynamicResource Splash.GrantedNonTransferableLicenceUseSoftware}"/></StackPanel>
                        <StackPanel Margin="0,0,0,20"><TextBlock Style="{StaticResource TermsLead}" Text="{DynamicResource Splash.Term6}"/><TextBlock Style="{StaticResource TermsBody}" Text="{DynamicResource Splash.AgreeUseSoftwareProduceFalseMisleading}"/></StackPanel>
                        <StackPanel Margin="0,0,0,20"><TextBlock Style="{StaticResource TermsLead}" Text="{DynamicResource Splash.Term7}"/><TextBlock Style="{StaticResource TermsBody}" Text="{DynamicResource Splash.SoftwareProvidedWithoutWarrantyKindExpress}"/></StackPanel>
                        <StackPanel Margin="0,0,0,20"><TextBlock Style="{StaticResource TermsLead}" Text="{DynamicResource Splash.Term8}"/><TextBlock Style="{StaticResource TermsBody}" Text="{DynamicResource Splash.UpdatesMayOfferedTimeTimeInstallingChoice}"/></StackPanel>
                        <StackPanel><TextBlock Style="{StaticResource TermsLead}" Text="{DynamicResource Splash.Term9}"/><TextBlock Style="{StaticResource TermsBody}" Text="{DynamicResource Splash.TermsGovernedLawsUnitedArabEmiratesEmirate}"/></StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="TermsBar" Grid.Row="2" BorderBrush="{StaticResource Sp.Keyline}"
                    BorderThickness="0,1,0,0" Background="#E6FFFFFF" Padding="48,18">
                <DockPanel LastChildFill="True" MaxWidth="880">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,8,0,0">
                        <Button x:Name="DeclineButton" Content="{DynamicResource Splash.DeclineExit}" MinWidth="150" Height="44" Margin="0,0,12,0" Style="{StaticResource Button.Secondary}" Command="{Binding DeclineCommand}"/>
                        <Button x:Name="ContinueButton" Content="{DynamicResource Splash.AcceptContinue}" MinWidth="190" Height="44" IsEnabled="{Binding IsContinueEnabled}" Style="{StaticResource Button.Primary}" Command="{Binding ContinueCommand}"/>
                    </StackPanel>
                    <CheckBox x:Name="AcceptTermsCheck" VerticalAlignment="Center" Foreground="{StaticResource Sp.Muted}" FontSize="14" Cursor="Hand" Margin="0,8,0,0" IsChecked="{Binding AcceptTerms, Mode=TwoWay}">
                        <TextBlock Text="{DynamicResource Splash.AcceptText}" TextWrapping="Wrap"/>
                    </CheckBox>
                </DockPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
