<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Splash/SplashView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Splash Screen — modern launch surface

     2026-09-05 redesign (owner directive): full professional rebuild
     on a deep-mesh cinematic stage:
       • layered dusk-navy gradient + soft accent orbs (atmosphere,
         not decoration-in-your-face)
       • slim glass trust chips (MADE IN INDIA / ENTERPRISE · vX /
         OFFLINE · SECURE)
       • hero brand block: crystal logo tile + halo + orbit ring,
         metallic-gradient wordmark, quiet tagline
       • uniform module chip strip (one clean 6-wide grid)
       • hairline luminous progress + subdued status line
       • slim translucent footer (product · version — location footer
         removed per owner request)

     PRESERVED (zero regression — public API of SplashView.xaml.cs):
       • Window flags (Maximized / None / Topmost / NoTaskbar)
       • FadeOutAndClose(Action), RunLoginAsync(), RunFirstRunSetupAsync(),
         ShowTermsGate()
       • TermsAccepted / TermsResolved / SignedIn / HasAcceptedCurrentTerms
       • Terms gate (UAE legal copy unchanged) + login + first-run gates
       • x:Name used by code-behind: PosterHost, LogoBorder, LogoScale,
         AppNameText, AppNameTranslate, TaglineText, ProgressTrack,
         ProgressFill, LoadingText, LoadingDots, LoadingStrip,
         TermsPanel, TermsBar, AcceptTermsCheck, DeclineButton,
         ContinueButton, LoginHost, LoginGate, SetupHost, SetupGate,
         TopLeftBadge, TopCenterPill, TopRightBadge, FeaturePanel
═══════════════════════════════════════════════════════════════════════ -->
<Window x:Class="ProGlassAutomation.Views.Splash.SplashView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:updates="clr-namespace:ProGlassAutomation.Services.Updates"
        xmlns:login="clr-namespace:ProGlassAutomation.Views.Login"
        xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
        Title="{DynamicResource Shell.AppTitle}"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        ShowInTaskbar="False"
        Topmost="True"
        behaviors:ViewportFitBehavior.DisableZoom="True"
        FontFamily="{DynamicResource AppFontFamily}"
        FontWeight="{DynamicResource AppFontWeight}"
        FontStyle="{DynamicResource AppFontStyle}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <BlurEffect x:Key="OrbBlur"  Radius="90" RenderingBias="Performance"/>
        <BlurEffect x:Key="HaloBlur" Radius="30" RenderingBias="Performance"/>

        <!-- ═══════════════════════════════════════════════════════════
             THEME-AWARE SPLASH PALETTE  (2026-09-10, owner directive:
             "match the app theme")
             The splash now follows the active Light/Dark theme, sharing
             the exact Liquid* design language used by the About page so
             the two screens finally have ONE identity. This is safe now
             because startup applies the saved theme (App.StartupCore
             ~L506) BEFORE the splash window is created (~L715), so there
             is no longer a mid-boot theme flip — the reason the palette
             was previously frozen.

             Colours vs brushes are still SEPARATE resources on purpose:
             GradientStop.Color / DropShadowEffect.Color demand a
             System.Windows.Media.Color, never a Brush (the XDG-0001
             "incompatible type" crash). Every theme provides these Color
             tokens in both Light and Dark. -->

        <!-- Local corner tokens (unchanged) -->
        <CornerRadius  x:Key="SplashCorner">10</CornerRadius>
        <CornerRadius  x:Key="SplashCornerLarge">16</CornerRadius>

        <!-- Brand-name / progress accents pulled from the live theme -->
        <SolidColorBrush x:Key="SplashCerulean"      Color="{DynamicResource AccentLightColor}"/>
        <SolidColorBrush x:Key="SplashCeruleanDark"  Color="{DynamicResource AccentColor}"/>
        <SolidColorBrush x:Key="SplashCeruleanLite"  Color="{DynamicResource AccentLightColor}"/>
        <SolidColorBrush x:Key="SplashCeruleanDeep"  Color="{DynamicResource AccentDarkColor}"/>
        <SolidColorBrush x:Key="SplashOutline"       Color="{DynamicResource BorderColor}"/>
        <!-- Translucent glass surfaces so the stage shows through -->
        <SolidColorBrush x:Key="SplashPillBg"        Color="#22808080"/>
        <SolidColorBrush x:Key="SplashTrackBg"       Color="#22808080"/>

        <!-- ═══ MODULE-TILE GLASS ═══ frosted, theme-aware, with a soft
             top sheen so each chip reads as a raised glass tile (matches
             the approved mockup's chunky frosted modules). ═══ -->
        <LinearGradientBrush x:Key="TileGlassBg" StartPoint="0,0" EndPoint="0.4,1">
            <GradientStop Color="#33FFFFFF" Offset="0.0"/>
            <GradientStop Color="#14808080" Offset="0.45"/>
            <GradientStop Color="#0D000000" Offset="1.0"/>
        </LinearGradientBrush>
        <!-- Icon-badge fill: accent-tinted frosted square behind each glyph -->
        <LinearGradientBrush x:Key="TileIconBadgeBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource AccentLightColor}" Offset="0.0"/>
            <GradientStop Color="{DynamicResource AccentDarkColor}"  Offset="1.0"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="SplashTextPrimary"   Color="{DynamicResource PrimaryForegroundColor}"/>
        <SolidColorBrush x:Key="SplashTextSecondary" Color="{DynamicResource SecondaryForegroundColor}"/>
        <SolidColorBrush x:Key="SplashOnAccent"      Color="#FFFFFF"/>

        <!-- ═══ STAGE — a rich theme-aware diagonal mesh built from the
             theme's own background + accent Color tokens ═══ -->
        <LinearGradientBrush x:Key="PageBg" StartPoint="0.05,0" EndPoint="0.85,1">
            <GradientStop Color="{DynamicResource WindowBackgroundColor}" Offset="0.0"/>
            <GradientStop Color="{DynamicResource ModuleBackgroundColor}" Offset="0.45"/>
            <GradientStop Color="{DynamicResource WindowBackgroundColor}" Offset="0.72"/>
            <GradientStop Color="{DynamicResource AccentDarkColor}"       Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Accent orbs — theme-aware with alpha falloff to transparent so
             they read as soft light, not solid discs. -->
        <RadialGradientBrush x:Key="OrbRight"
                             Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="{DynamicResource AccentLightColor}" Offset="0.0"/>
            <GradientStop Color="{DynamicResource AccentColor}"      Offset="0.55"/>
            <GradientStop Color="{DynamicResource Transparent}"                          Offset="1.0"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="OrbLeft"
                             Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="{DynamicResource AccentColor}"     Offset="0.0"/>
            <GradientStop Color="{DynamicResource AccentDarkColor}" Offset="0.55"/>
            <GradientStop Color="{DynamicResource Transparent}"                          Offset="1.0"/>
        </RadialGradientBrush>

        <!-- Soft spotlight behind the hero brand block (theme-aware, alpha
             falloff to transparent so it reads as light, not a disc). -->
        <RadialGradientBrush x:Key="HeroGlow"
                             Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="{DynamicResource AccentColor}"     Offset="0.0"/>
            <GradientStop Color="{DynamicResource AccentDarkColor}" Offset="0.5"/>
            <GradientStop Color="{DynamicResource Transparent}"                          Offset="1.0"/>
        </RadialGradientBrush>

        <!-- ═══ BRAND NAME — metallic gradient built from theme inks ═══ -->
        <LinearGradientBrush x:Key="NameGradient" StartPoint="0,0" EndPoint="1,0.15">
            <GradientStop Color="{DynamicResource PrimaryForegroundColor}" Offset="0.0"/>
            <GradientStop Color="{DynamicResource AccentLightColor}"       Offset="1.0"/>
        </LinearGradientBrush>

        <!-- ═══ LOGO TILE — theme surface plate + translucent top sheen ═══ -->
        <LinearGradientBrush x:Key="SplashPlate" StartPoint="0,0" EndPoint="0.85,1">
            <GradientStop Color="{DynamicResource ModuleBackgroundColor}" Offset="0.0"/>
            <GradientStop Color="{DynamicResource WindowBackgroundColor}" Offset="1.0"/>
        </LinearGradientBrush>
        <!-- Translucent white highlight fading to fully transparent by 55%
             so the app icon stays fully visible (the old version was OPAQUE
             on both stops and painted a solid slab over the logo). -->
        <LinearGradientBrush x:Key="TileSheen" StartPoint="0,0" EndPoint="0.35,1">
            <GradientStop Color="#4CFFFFFF" Offset="0.0"/>
            <GradientStop Color="#12FFFFFF" Offset="0.30"/>
            <GradientStop Color="#00FFFFFF" Offset="0.55"/>
        </LinearGradientBrush>

        <!-- ═══ PROGRESS — luminous accent sweep (theme-aware) ═══ -->
        <LinearGradientBrush x:Key="ProgressGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{DynamicResource AccentDarkColor}"  Offset="0.0"/>
            <GradientStop Color="{DynamicResource AccentColor}"      Offset="0.5"/>
            <GradientStop Color="{DynamicResource AccentLightColor}" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- ═══ CONSTELLATION TEXTURE — faint network dot/line mesh tiled
             across the stage (matches the mockup's backdrop). Theme-aware:
             it's drawn in the accent colour at very low opacity so it reads
             as a subtle premium texture in both Light and Dark. ═══ -->
        <DrawingBrush x:Key="ConstellationBrush"
                      TileMode="Tile" Viewport="0,0,340,300" ViewportUnits="Absolute"
                      Stretch="None" Opacity="0.5">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{DynamicResource SplashCerulean}">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <EllipseGeometry Center="30,40"   RadiusX="1.6" RadiusY="1.6"/>
                                <EllipseGeometry Center="150,30"  RadiusX="1.2" RadiusY="1.2"/>
                                <EllipseGeometry Center="250,90"  RadiusX="1.8" RadiusY="1.8"/>
                                <EllipseGeometry Center="90,140"  RadiusX="1.3" RadiusY="1.3"/>
                                <EllipseGeometry Center="200,180" RadiusX="1.5" RadiusY="1.5"/>
                                <EllipseGeometry Center="320,220" RadiusX="1.2" RadiusY="1.2"/>
                                <EllipseGeometry Center="40,250"  RadiusX="1.6" RadiusY="1.6"/>
                                <EllipseGeometry Center="140,270" RadiusX="1.3" RadiusY="1.3"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Thickness="0.6" Brush="{DynamicResource SplashCerulean}"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="30,40"   EndPoint="150,30"/>
                                <LineGeometry StartPoint="150,30"  EndPoint="250,90"/>
                                <LineGeometry StartPoint="90,140"  EndPoint="200,180"/>
                                <LineGeometry StartPoint="200,180" EndPoint="320,220"/>
                                <LineGeometry StartPoint="90,140"  EndPoint="30,40"/>
                                <LineGeometry StartPoint="40,250"  EndPoint="140,270"/>
                                <LineGeometry StartPoint="140,270" EndPoint="200,180"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- ═══ CRYSTAL SHADOWS (theme accent glow) ═══ -->
        <DropShadowEffect x:Key="IconShadow" Color="{DynamicResource AccentColor}"
                          BlurRadius="34" ShadowDepth="0" Opacity="0.45"/>
        <DropShadowEffect x:Key="SplashGlow" Color="{DynamicResource AccentColor}"
                          BlurRadius="18" ShadowDepth="0" Opacity="0.35"/>

        <!-- ═══ TRUST CHIP (top badges) — slim glass ═══ -->
        

        

        

        <!-- ═══ MODULE CHIP (feature strip) — quiet 6-wide grid ═══ -->
        <!-- Module GLASS TILE — taller frosted card with an accent icon
             badge above the label. Flows in a centered WrapPanel so all
             real modules read as a premium grid of glass tiles (matches
             the approved mockup's chunky frosted modules). -->
        <DataTemplate x:Key="FeatureBadgeTemplate">
            <Border Width="132" Height="88"
                    Margin="8"
                    CornerRadius="{DynamicResource Radius.XLarge}"
                    BorderBrush="{DynamicResource SplashOutline}"
                    BorderThickness="{DynamicResource Border.HairlineThickness}"
                    Background="{DynamicResource TileGlassBg}"
                    Effect="{StaticResource SplashGlow}"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True"
                    IsHitTestVisible="False" Style="{StaticResource SurfacePrimaryStyle}">
                <Grid>
                    <!-- top-edge crystal sheen -->
                    <Border CornerRadius="{DynamicResource Radius.XLarge}"
                            Background="{DynamicResource TileSheen}"
                            IsHitTestVisible="False" Style="{StaticResource SurfacePrimaryStyle}"/>
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <!-- accent icon badge -->
                        <Border Width="40" Height="40"
                                CornerRadius="{DynamicResource Radius.Card}"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource TileIconBadgeBg}"
                                SnapsToDevicePixels="True" Style="{StaticResource SurfacePrimaryStyle}">
                            <TextBlock Text="{Binding Icon}"
                                       FontFamily="{DynamicResource FontFamily.Icon}"
                                       FontSize="{DynamicResource FontSize.Title}"
                                       Foreground="{DynamicResource PaperBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Label}"
                                   FontSize="{DynamicResource FontSize.Body}"
                                   FontWeight="{DynamicResource Weight.SemiBold}"
                                   Foreground="{DynamicResource SplashTextPrimary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,9,0,0"
                                   TextWrapping="NoWrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ═══ TERMS — DECLINE (ghost) ═══ -->
        <Style x:Key="TermsDeclineButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource SplashTextSecondary}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="Transparent"
                                BorderBrush="{DynamicResource SplashOutline}"
                                BorderThickness="{DynamicResource Border.HairlineThickness}"
                                CornerRadius="{StaticResource SplashCorner}"
                                SnapsToDevicePixels="True" Style="{StaticResource SurfacePrimaryStyle}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SplashPillBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ TERMS — CONTINUE (accent) ═══ -->
        <Style x:Key="TermsContinueButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource SplashOnAccent}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
            <Setter Property="FontWeight" Value="{DynamicResource Weight.Bold}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{DynamicResource SplashCerulean}"
                                BorderThickness="{DynamicResource Border.NoneThickness}"
                                CornerRadius="{StaticResource SplashCorner}"
                                SnapsToDevicePixels="True" Style="{StaticResource SurfacePrimaryStyle}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{StaticResource SplashCeruleanLite}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{StaticResource SplashCeruleanDeep}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         AMBIENT MOTION — continuous, buttery-smooth stage life
         2026-09-10 upgrade. Runs on Loaded ALONGSIDE the code-behind
         entrance choreography (which animates Opacity / logo scale).
         These loops touch ONLY the decorative atmosphere transforms
         declared above (orbs, hero glow, orbit ring) — never layout,
         never a code-behind-owned property — so there is zero conflict
         and zero regression. Every loop is slow, eased and AutoReverse
         for a calm, premium, never-jarring feel.
    ═══════════════════════════════════════════════════════════════════ -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Hero glow: slow luminous breathing -->
                    <DoubleAnimation Storyboard.TargetName="HeroGlowScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="1" To="1.09" Duration="0:0:7"
                                     AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="HeroGlowScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="1" To="1.09" Duration="0:0:7"
                                     AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- Right orb: gentle drift + swell -->
                    <DoubleAnimation Storyboard.TargetName="OrbRightMove"
                                     Storyboard.TargetProperty="X"
                                     From="0" To="-34" Duration="0:0:19"
                                     AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="OrbRightMove"
                                     Storyboard.TargetProperty="Y"
                                     From="0" To="26" Duration="0:0:23"
                                     AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="OrbRightScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="1" To="1.08" Duration="0:0:16"
                                     AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="OrbRightScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="1" To="1.08" Duration="0:0:16"
                                     AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- Left orb: counter-drift + swell (different periods
                         so the two orbs never beat in lockstep) -->
                    <DoubleAnimation Storyboard.TargetName="OrbLeftMove"
                                     Storyboard.TargetProperty="X"
                                     From="0" To="30" Duration="0:0:26"
                                     AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="OrbLeftMove"
                                     Storyboard.TargetProperty="Y"
                                     From="0" To="-22" Duration="0:0:21"
                                     AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="OrbLeftScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="1.06" To="1" Duration="0:0:18"
                                     AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="OrbLeftScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="1.06" To="1" Duration="0:0:18"
                                     AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- Orbit ring: one slow, perfectly linear revolution -->
                    <DoubleAnimation Storyboard.TargetName="OrbitRingRotate"
                                     Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:48"
                                     RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid x:Name="SplashStageRoot" Background="{DynamicResource PageBg}">

        <!-- Constellation network texture (subtle, theme-aware) -->
        <Rectangle x:Name="ConstellationRect"
                   Fill="{DynamicResource ConstellationBrush}"
                   IsHitTestVisible="False"
                   Opacity="0.35"/>

        <!-- ── ATMOSPHERE — soft accent orbs + hero spotlight ──
             2026-09-10 upgrade: every atmosphere layer now carries a named
             render transform so the Window.Triggers storyboard can give the
             stage a continuous, gentle drift/breathe. Motion is slow (14-26s
             loops), sub-pixel-smooth (CubicEase, AutoReverse) and purely
             decorative — it never touches layout or the code-behind
             choreography. RenderTransformOrigin centres each scale. -->
        <Ellipse x:Name="OrbRightShape" Width="520" Height="520"
                 Fill="{DynamicResource OrbRight}"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-160,-160,0" IsHitTestVisible="False"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="OrbRightScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="OrbRightMove" X="0" Y="0"/>
                </TransformGroup>
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="OrbLeftShape" Width="440" Height="440"
                 Fill="{DynamicResource OrbLeft}"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-140,0,0,-140" IsHitTestVisible="False"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="OrbLeftScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="OrbLeftMove" X="0" Y="0"/>
                </TransformGroup>
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="HeroGlowOrb" Width="620" Height="620"
                 Fill="{DynamicResource HeroGlow}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Margin="0,-40,0,0" IsHitTestVisible="False"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="HeroGlowScale" ScaleX="1" ScaleY="1"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- ═══════════════════════════════════════════════════════════
             POSTER — brand block
        ═══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="PosterHost" Margin="24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Top trust chips -->
                <RowDefinition Height="*"/>
                <!-- Center brand -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ── TOP TRUST CHIPS ──────────────────────────────────── -->
            <Grid Grid.Row="0">
                <Border x:Name="TopLeftBadge" Style="{StaticResource Chip.Primary}"
                        HorizontalAlignment="Left" Opacity="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE774;" Style="{StaticResource Typography.Icon}"/>
                        <TextBlock Text="{DynamicResource Splash.MadeInIndia}" Style="{StaticResource Typography.Caption}"/>
                    </StackPanel>
                </Border>
                <Border x:Name="TopCenterPill" Style="{StaticResource Chip.Primary}"
                        HorizontalAlignment="Center" Opacity="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE735;" Style="{StaticResource Typography.Icon}"/>
                        <TextBlock Style="{StaticResource Typography.Caption}">
                            <Run Text="{DynamicResource Splash.Enterprise}"/>
                            <Run Text="{DynamicResource Splash.V}"/>
                            <Run Text="{x:Static updates:AppInfo.Version}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border x:Name="TopRightBadge" Style="{StaticResource Chip.Primary}"
                        HorizontalAlignment="Right" Opacity="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource Typography.Icon}"/>
                        <TextBlock Text="{DynamicResource Splash.OfflineSecure}" Style="{StaticResource Typography.Caption}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── CENTER BRAND ─────────────────────────────────────── -->
            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="880"
                        Margin="8,18">

                <!-- Logo — frosted crystal tile + cyan halo + elliptical
                     orbit ring + vector PGA monogram + glass sheen.
                     (Matches the approved brand-moment mockup.) -->
                <Border x:Name="LogoBorder" Width="168" Height="168"
                        HorizontalAlignment="Center"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        IsHitTestVisible="False"
                        Opacity="0">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="LogoScale" ScaleX="0.92" ScaleY="0.92"/>
                    </Border.RenderTransform>
                    <Grid>
                        <!-- Broad cyan halo bloom behind the tile -->
                        <Ellipse Width="168" Height="168"
                                 Fill="{DynamicResource SplashCerulean}"
                                 Opacity="0.30" Effect="{StaticResource HaloBlur}"/>

                        <!-- Elliptical dashed orbit ring (horizontal, like the
                             mockup): a circle squashed on Y, rotating slowly. -->
                        <Ellipse Width="176" Height="96"
                                 Stroke="{DynamicResource SplashCerulean}"
                                 Opacity="0.6" StrokeThickness="1.2"
                                 StrokeDashArray="2 6"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="OrbitRingRotate" Angle="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- Crystal glass tile -->
                        <Border Width="112" Height="112" CornerRadius="{DynamicResource Radius.Full}"
                                Effect="{StaticResource IconShadow}"
                                Background="{DynamicResource SplashPlate}"
                                BorderBrush="{DynamicResource SplashCerulean}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True" Style="{StaticResource SurfacePrimaryStyle}">
                            <Grid>
                                <!-- Vector PGA hexagon monogram -->
                                <Viewbox Width="66" Height="66">
                                    <Grid Width="72" Height="72">
                                        <!-- flat-top hexagon outline (matches
                                             the approved app-icon monogram) -->
                                        <Path Stroke="{DynamicResource SplashCerulean}"
                                              StrokeThickness="3"
                                              StrokeLineJoin="Round"
                                              Data="M20,5 L52,5 L68,36 L52,67 L20,67 L4,36 Z"/>
                                        <TextBlock Text="PGA"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="{DynamicResource FontSize.H1}" FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource SplashCeruleanLite}"/>
                                    </Grid>
                                </Viewbox>

                                <!-- Top-edge crystal sheen on the tile -->
                                <Border Width="112" Height="112" CornerRadius="{DynamicResource Radius.Full}"
                                        Background="{DynamicResource TileSheen}"
                                        IsHitTestVisible="False" Style="{StaticResource SurfacePrimaryStyle}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Wordmark — two-tone brand lockup: "ProGlass" in the
                     theme ink, "Automation" in the accent (matches the
                     approved mockup). The brand logotype is intentionally
                     the latin two-tone mark on the splash; every other
                     surface still uses the localized Shell.AppTitle. -->
                <TextBlock x:Name="AppNameText"
                           FontSize="{DynamicResource FontSize.Display}" FontWeight="{DynamicResource Weight.Bold}"
                           HorizontalAlignment="Center"
                           Margin="0,22,0,0"
                           Opacity="0">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="AppNameTranslate" Y="12"/>
                    </TextBlock.RenderTransform><Run Text="ProGlass " Foreground="{DynamicResource SplashTextPrimary}"/><Run Text="Automation" Foreground="{DynamicResource SplashCerulean}"/>
                </TextBlock>

                <TextBlock x:Name="TaglineText"
                           Text="{DynamicResource Splash.MadeInIndiaDesc}"
                           FontSize="{DynamicResource FontSize.Title}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource SplashCerulean}"
                           Opacity="0"/>

                <!-- Module pills — all real modules, flowing centered in a
                     WrapPanel so they read as one clean row band (matches
                     the approved mockup's pill styling). -->
                <ItemsControl x:Name="FeaturePanel"
                              ItemTemplate="{StaticResource FeatureBadgeTemplate}"
                              HorizontalAlignment="Center"
                              MaxWidth="1216"
                              Margin="0,26,0,0"
                              Opacity="0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"
                                       HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Progress — hairline luminous -->
                <Grid x:Name="ProgressTrack"
                      MaxWidth="320" Height="3"
                      Margin="0,26,0,0" HorizontalAlignment="Stretch">
                    <Border Height="3" CornerRadius="{DynamicResource Radius.XSmall}" Background="{DynamicResource SplashTrackBg}" Style="{StaticResource SurfacePrimaryStyle}"/>
                    <Border x:Name="ProgressFill"
                            Height="3" Width="0"
                            HorizontalAlignment="Left"
                            CornerRadius="{DynamicResource Radius.XSmall}"
                            Background="{DynamicResource ProgressGradient}" Style="{StaticResource SurfacePrimaryStyle}"/>
                </Grid>

                <!-- Status — quiet line (dots animated by code-behind) -->
                <Grid HorizontalAlignment="Center" Margin="0,14,0,0">
                    <StackPanel x:Name="LoadingStrip" Orientation="Horizontal">
                        <TextBlock x:Name="LoadingText"
                                   Text="{DynamicResource Splash.Starting}"
                                   FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{DynamicResource SplashTextSecondary}"/>
                        <TextBlock x:Name="LoadingDots"
                                   Text=""
                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource SplashCerulean}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ── FOOTER (slim translucent) — location run removed ── -->
            <Border Grid.Row="2"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10"
                    Padding="16,6"
                    CornerRadius="{DynamicResource Radius.Medium}"
                    BorderBrush="{DynamicResource SplashOutline}"
                    BorderThickness="{DynamicResource Border.HairlineThickness}"
                    Background="{DynamicResource SplashPillBg}" Style="{StaticResource SurfacePrimaryStyle}">
                <TextBlock FontSize="{DynamicResource FontSize.Body}"
                           Foreground="{DynamicResource SplashTextSecondary}"
                           Opacity="0.75"
                           HorizontalAlignment="Center">
                    <Run Text="{DynamicResource Splash.Copyright}"/>
                    <Run Text="{DynamicResource Splash.V}"/>
                    <Run Text="{x:Static updates:AppInfo.Version}"/>
                </TextBlock>
            </Border>
        </Grid>

        <!-- ═══ LOGIN GATE — same window as splash (no second window) ═══ -->
        <Grid x:Name="LoginHost"
              Visibility="Collapsed"
              Opacity="0"
              Panel.ZIndex="11">
            <login:LoginPanel x:Name="LoginGate"/>
        </Grid>

        <!-- ═══ FIRST-RUN SETUP GATE — shown when AuditService reports
             an empty Users table (fresh install). On successful create,
             the splash proceeds straight to the workspace. ═══ -->
        <Grid x:Name="SetupHost"
              Visibility="Collapsed"
              Opacity="0"
              Panel.ZIndex="12">
            <login:FirstRunSetupPanel x:Name="SetupGate"/>
        </Grid>

        <!-- ═══ TERMS GATE — FULL PAGE (defs unchanged, legal copy intact) ═══ -->
        <Grid x:Name="TermsPanel"
              Background="{DynamicResource PageBg}"
              Visibility="Collapsed"
              Opacity="0"
              Panel.ZIndex="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        Margin="0,46,0,0">
                <TextBlock Text="{DynamicResource Splash.TermsTitle}"
                           FontSize="{DynamicResource FontSize.Display}" FontWeight="{DynamicResource Weight.Bold}"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SplashTextPrimary}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="18"
                                          ShadowDepth="0" Opacity="0.35"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="{DynamicResource Splash.UaeIntro}"
                           FontSize="{DynamicResource FontSize.Title}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource SplashTextSecondary}"/>
                <Rectangle Height="1" Width="360" Margin="0,18,0,0"
                           Opacity="0.5" Fill="{DynamicResource SplashCerulean}"/>
            </StackPanel>

            <!-- Crystal terms card -->
            <Border Grid.Row="1"
                    MaxWidth="980"
                    Margin="60,26,60,10"
                    Padding="42,34"
                    CornerRadius="{StaticResource SplashCornerLarge}"
                    BorderBrush="{DynamicResource SplashOutline}"
                    BorderThickness="{DynamicResource Border.HairlineThickness}"
                    Background="{DynamicResource SplashPillBg}" Style="{StaticResource SurfacePrimaryStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <TextBlock Foreground="{DynamicResource SplashTextSecondary}"
                               FontSize="{DynamicResource FontSize.Title}"
                               LineHeight="25"
                               TextWrapping="Wrap">
                        <Run Text="{DynamicResource Splash.Term1}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource SplashTextPrimary}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Splash.SoftwareAssistsPreparingTaxInvoicesRecords}"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term2}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource SplashTextPrimary}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Splash.UAETaxLawRequiresAccountingRecordsTax}"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term3}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource SplashTextPrimary}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Splash.FederalDecreeLawNo462021Electronic}"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term4}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource SplashTextPrimary}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Splash.FederalDecreeLawNo452021ProtectionPersonal}"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term5}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource SplashTextPrimary}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Splash.GrantedNonTransferableLicenceUseSoftware}"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term6}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource SplashTextPrimary}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Splash.AgreeUseSoftwareProduceFalseMisleading}"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term7}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource SplashTextPrimary}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Splash.SoftwareProvidedWithoutWarrantyKindExpress}"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term8}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource SplashTextPrimary}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Splash.UpdatesMayOfferedTimeTimeInstallingChoice}"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term9}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource SplashTextPrimary}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Splash.TermsGovernedLawsUnitedArabEmiratesEmirate}"/>
                    </TextBlock>
                </ScrollViewer>
            </Border>

            <!-- Accept bar -->
            <Border x:Name="TermsBar"
                    CornerRadius="{StaticResource SplashCornerLarge}" Grid.Row="2"
                    BorderBrush="{DynamicResource SplashOutline}"
                    BorderThickness="{DynamicResource Border.TopHairlineThickness}"
                    Padding="60,20"
                    Background="{DynamicResource SplashPillBg}" Style="{StaticResource SurfacePrimaryStyle}">
                <DockPanel LastChildFill="True" MaxWidth="980">
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,8,0,0">
                        <Button x:Name="DeclineButton"
                                Content="{DynamicResource Splash.DeclineExit}"
                                MinWidth="150" Height="42"
                                Margin="0,0,12,0"
                                Style="{StaticResource Button.Secondary}"
                                Command="{Binding DeclineCommand}"/>
                        <Button x:Name="ContinueButton"
                                Content="{DynamicResource Splash.AcceptContinue}"
                                MinWidth="190" Height="42"
                                IsEnabled="{Binding IsContinueEnabled}"
                                Style="{StaticResource Button.Primary}"
                                Command="{Binding ContinueCommand}"/>
                    </StackPanel>
                    <CheckBox x:Name="AcceptTermsCheck"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource SplashTextSecondary}"
                              FontSize="{DynamicResource FontSize.Title}"
                              Cursor="Hand"
                              Margin="0,8,0,0"
                              IsChecked="{Binding AcceptTerms, Mode=TwoWay}">
                        <TextBlock Text="{DynamicResource Splash.AcceptText}"
                                   TextWrapping="Wrap"/>
                    </CheckBox>
                </DockPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
