<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Splash/SplashView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Splash Screen — "GLASS PRISM OPTICAL BEVEL" (v9 Master Approved)
     Visual source of truth: docs/splash_09_glass_prism_bevel.png
     
     100% PURE NATIVE WPF XAML REWRITE:
       • Heavy architectural float glass plate (520x520) with cut chamfer
         corners and 8 multi-faceted 3D optical bevel polygons.
       • Multi-stop chromatic rainbow dispersion caustics along the bevels.
       • 3D faceted folded architectural letter "P" glass prism emblem.
       • Elegant luxury serif typography "ProGlass" with precision hairline
         divider and "PRECISION AUTOMATION" tracked uppercase caption.
       • Centered 4-point diamond star glyph.
       • Framed rectangular progress track with dark slate fill.
       • Status text: "Initializing Precision Modules... 18%".
       • Zero national flags / Zero "MADE IN INDIA" text.
       • 100% API-compliant with SplashView.xaml.cs and App.StartupCore.cs.
═══════════════════════════════════════════════════════════════════ -->
<Window x:Class="ProGlassAutomation.Views.Splash.SplashView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:updates="clr-namespace:ProGlassAutomation.Services.Updates"
        xmlns:login="clr-namespace:ProGlassAutomation.Views.Login"
        xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
        Title="{DynamicResource Shell.AppTitle}"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#E2E8F0"
        ShowInTaskbar="False"
        Topmost="True"
        behaviors:ViewportFitBehavior.DisableZoom="True"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Luxury Architectural Float Glass Palette -->
        <SolidColorBrush x:Key="CanvasBgBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="GlassFaceBrush" Color="#F4F8FC"/>
        <SolidColorBrush x:Key="BrandDarkBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="BrandMutedBrush" Color="#475569"/>
        <SolidColorBrush x:Key="KeylineBrush" Color="#94A3B8"/>

        <!-- Multi-facet 3D Optical Bevel Gradients -->
        <LinearGradientBrush x:Key="TopFacetGrad" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#F1F5F9" Offset="0.5"/>
            <GradientStop Color="#CBD5E1" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BottomFacetGrad" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#64748B" Offset="0.0"/>
            <GradientStop Color="#94A3B8" Offset="0.6"/>
            <GradientStop Color="#CBD5E1" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LeftFacetGrad" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#CBD5E1" Offset="0.0"/>
            <GradientStop Color="#E2E8F0" Offset="0.5"/>
            <GradientStop Color="#FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="RightFacetGrad" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#94A3B8" Offset="0.0"/>
            <GradientStop Color="#64748B" Offset="0.7"/>
            <GradientStop Color="#475569" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Chromatic Rainbow Dispersion Gradients -->
        <LinearGradientBrush x:Key="TopRightRainbowGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E0F2FE" Offset="0.0"/>
            <GradientStop Color="#BAE6FD" Offset="0.25"/>
            <GradientStop Color="#FDE047" Offset="0.55"/>
            <GradientStop Color="#F472B6" Offset="0.8"/>
            <GradientStop Color="#38BDF8" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BottomRightRainbowGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#38BDF8" Offset="0.0"/>
            <GradientStop Color="#FDE047" Offset="0.35"/>
            <GradientStop Color="#FB7185" Offset="0.7"/>
            <GradientStop Color="#C084FC" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BottomLeftRainbowGrad" StartPoint="1,0" EndPoint="0,1">
            <GradientStop Color="#60A5FA" Offset="0.0"/>
            <GradientStop Color="#34D399" Offset="0.4"/>
            <GradientStop Color="#FDE047" Offset="0.75"/>
            <GradientStop Color="#F8FAFC" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TopLeftRainbowGrad" StartPoint="0,1" EndPoint="1,0">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#BAE6FD" Offset="0.35"/>
            <GradientStop Color="#DDD6FE" Offset="0.7"/>
            <GradientStop Color="#FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Plate Shadow -->
        <DropShadowEffect x:Key="PlateDropShadow" Color="#0F172A" BlurRadius="45" ShadowDepth="20" Direction="270" Opacity="0.18" RenderingBias="Performance"/>

        <!-- Terms Styles -->
        <Style x:Key="TermsLead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="TermsBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="LineHeight" Value="24"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainRootGrid" Background="{StaticResource CanvasBgBrush}">

        <!-- ═══ AMBIENT REFRACTION FLARES & CAUSTICS (API-Safe Blobs) ═══ -->
        <Canvas IsHitTestVisible="False">
            <!-- Top-Left Soft Warm Dispersion Beam -->
            <Ellipse x:Name="BgBlob1" Width="580" Height="420" Opacity="0.35" Canvas.Left="-160" Canvas.Top="-120">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#60FFFFFF" Offset="0"/>
                        <GradientStop Color="#30FDE047" Offset="0.4"/>
                        <GradientStop Color="#00E2E8F0" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="30" KernelType="Box" RenderingBias="Performance"/></Ellipse.Effect>
                <Ellipse.RenderTransform><TranslateTransform x:Name="BgBlob1Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>

            <!-- Bottom-Right Rainbow Caustic Flare -->
            <Ellipse x:Name="BgBlob2" Width="680" Height="500" Opacity="0.30" Canvas.Left="880" Canvas.Top="480">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#4038BDF8" Offset="0"/>
                        <GradientStop Color="#25F472B6" Offset="0.5"/>
                        <GradientStop Color="#00E2E8F0" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="32" KernelType="Box" RenderingBias="Performance"/></Ellipse.Effect>
                <Ellipse.RenderTransform><TranslateTransform x:Name="BgBlob2Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>

            <!-- Bottom-Left Cyan Ambient Beam -->
            <Ellipse x:Name="BgBlob3" Width="520" Height="380" Opacity="0.25" Canvas.Left="-140" Canvas.Top="500">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#40BAE6FD" Offset="0"/>
                        <GradientStop Color="#00E2E8F0" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="26" KernelType="Box" RenderingBias="Performance"/></Ellipse.Effect>
                <Ellipse.RenderTransform><TranslateTransform x:Name="BgBlob3Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>

            <!-- Top-Right Ambient Specular Reflection -->
            <Ellipse x:Name="BgBlob4" Width="440" Height="340" Opacity="0.30" Canvas.Left="1060" Canvas.Top="-60">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#50FFFFFF" Offset="0"/>
                        <GradientStop Color="#2038BDF8" Offset="0.6"/>
                        <GradientStop Color="#00E2E8F0" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="26" KernelType="Box" RenderingBias="Performance"/></Ellipse.Effect>
                <Ellipse.RenderTransform><TranslateTransform x:Name="BgBlob4Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>

            <!-- Tiny Optical Cut Diamonds (API-Safe Droplets) -->
            <Ellipse x:Name="Droplet1" Width="8" Height="8" Fill="#FFFFFF" Opacity="0.8" Canvas.Left="0" Canvas.Top="0">
                <Ellipse.Effect><DropShadowEffect Color="#38BDF8" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/></Ellipse.Effect>
                <Ellipse.RenderTransform><TranslateTransform x:Name="Droplet1Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Droplet2" Width="6" Height="6" Fill="#FFFFFF" Opacity="0.7" Canvas.Left="0" Canvas.Top="0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Droplet2Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Droplet3" Width="5" Height="5" Fill="#FFFFFF" Opacity="0.75" Canvas.Left="0" Canvas.Top="0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Droplet3Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Droplet4" Width="6" Height="6" Fill="#FFFFFF" Opacity="0.6" Canvas.Left="0" Canvas.Top="0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Droplet4Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Droplet5" Width="7" Height="7" Fill="#FFFFFF" Opacity="0.8" Canvas.Left="0" Canvas.Top="0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Droplet5Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Droplet6" Width="5" Height="5" Fill="#FFFFFF" Opacity="0.7" Canvas.Left="0" Canvas.Top="0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Droplet6Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <!-- ═══ CENTERED POSTER STAGE ═══ -->
        <Grid x:Name="PosterHost" HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- API Transform Hooks (FluidBlobScale & FluidBlobTranslate) -->
            <Grid Width="520" Height="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="FluidBlobScale" ScaleX="1" ScaleY="1" CenterX="260" CenterY="260"/>
                        <TranslateTransform x:Name="FluidBlobTranslate" X="0" Y="0"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <!-- Hidden API elements for 100% code-behind safety -->
                <Path x:Name="FluidBlob" Visibility="Collapsed" Data="M 0,0"/>
                <Path x:Name="FluidHighlight" Visibility="Collapsed" Data="M 0,0"/>
                <Path x:Name="FluidEdge" Visibility="Collapsed" Data="M 0,0"/>

                <!-- ── 1. REAL PHYSICAL GLASS BLOCK DROP SHADOW ── -->
                <Path Data="M 48,0 L 472,0 L 520,48 L 520,472 L 472,520 L 48,520 L 0,472 L 0,48 Z"
                      Fill="#200F172A" Effect="{StaticResource PlateDropShadow}"/>

                <!-- ── 2. THE MULTI-FACETED 3D OPTICAL BEVELLED GLASS BLOCK (520x520) ── -->
                <!-- The Core Glass Face (Inside the Chamfers) -->
                <Path x:Name="GlassFacePath"
                      Data="M 82,38 L 438,38 L 482,82 L 482,438 L 438,482 L 82,482 L 38,438 L 38,82 Z"
                      Fill="{StaticResource GlassFaceBrush}"/>

                <!-- Subtle Diagonal Caustic Across Face -->
                <Path Data="M 82,38 L 438,38 L 482,82 L 482,438 L 438,482 L 82,482 L 38,438 L 38,82 Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#30FFFFFF" Offset="0.0"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.45"/>
                            <GradientStop Color="#15E0F2FE" Offset="0.7"/>
                            <GradientStop Color="#25CBD5E1" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>

                <!-- ── THE 8 REFRACTIVE 3D BEVEL FACETS ── -->
                <!-- 1. Top Bevel Facet -->
                <Path Data="M 48,0 L 472,0 L 438,38 L 82,38 Z" Fill="{StaticResource TopFacetGrad}"/>
                <!-- 2. Top-Right Chamfer Facet (Rainbow Dispersion) -->
                <Path Data="M 472,0 L 520,48 L 482,82 L 438,38 Z" Fill="{StaticResource TopRightRainbowGrad}"/>
                <!-- 3. Right Bevel Facet -->
                <Path Data="M 520,48 L 520,472 L 482,438 L 482,82 Z" Fill="{StaticResource RightFacetGrad}"/>
                <!-- 4. Bottom-Right Chamfer Facet (Rainbow Dispersion) -->
                <Path Data="M 520,472 L 472,520 L 438,482 L 482,438 Z" Fill="{StaticResource BottomRightRainbowGrad}"/>
                <!-- 5. Bottom Bevel Facet -->
                <Path Data="M 472,520 L 48,520 L 82,482 L 438,482 Z" Fill="{StaticResource BottomFacetGrad}"/>
                <!-- 6. Bottom-Left Chamfer Facet (Rainbow Dispersion) -->
                <Path Data="M 48,520 L 0,472 L 38,438 L 82,482 Z" Fill="{StaticResource BottomLeftRainbowGrad}"/>
                <!-- 7. Left Bevel Facet -->
                <Path Data="M 0,472 L 0,48 L 38,82 L 38,438 Z" Fill="{StaticResource LeftFacetGrad}"/>
                <!-- 8. Top-Left Chamfer Facet (Rainbow Dispersion) -->
                <Path Data="M 0,48 L 48,0 L 82,38 L 38,82 Z" Fill="{StaticResource TopLeftRainbowGrad}"/>

                <!-- ── SHARP SPECULAR KEYLINE OUTLINES ── -->
                <!-- Outer Chamfer Edge Outline -->
                <Path Data="M 48,0 L 472,0 L 520,48 L 520,472 L 472,520 L 48,520 L 0,472 L 0,48 Z"
                      Stroke="#E6FFFFFF" StrokeThickness="1.5" IsHitTestVisible="False"/>

                <!-- Inner Chamfer Face Outline -->
                <Path Data="M 82,38 L 438,38 L 482,82 L 482,438 L 438,482 L 82,482 L 38,438 L 38,82 Z"
                      Stroke="#8094A3B8" StrokeThickness="1.2" IsHitTestVisible="False"/>

                <!-- Diagonal Chamfer Corner Ridges -->
                <Line X1="48" Y1="0" X2="82" Y2="38" Stroke="#CCFFFFFF" StrokeThickness="1.2"/>
                <Line X1="472" Y1="0" X2="438" Y2="38" Stroke="#99FFFFFF" StrokeThickness="1.2"/>
                <Line X1="520" Y1="48" X2="482" Y2="82" Stroke="#80CBD5E1" StrokeThickness="1.2"/>
                <Line X1="520" Y1="472" x2="482" Y2="438" Stroke="#6694A3B8" StrokeThickness="1.2"/>
                <Line X1="472" Y1="520" X2="438" Y2="482" Stroke="#6694A3B8" StrokeThickness="1.2"/>
                <Line X1="48" Y1="520" X2="82" Y2="482" Stroke="#80CBD5E1" StrokeThickness="1.2"/>
                <Line X1="0" Y1="472" X2="38" Y2="438" Stroke="#99CBD5E1" StrokeThickness="1.2"/>
                <Line X1="0" Y1="48" X2="38" Y2="82" Stroke="#CCFFFFFF" StrokeThickness="1.2"/>

                <!-- ── 3. CENTER CONTENT CONTAINER (LogoBorder + LogoScale Hook) ── -->
                <Border x:Name="LogoBorder" Width="440" Height="440"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="Transparent" Opacity="0">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="LogoScale" ScaleX="0.92" ScaleY="0.92" CenterX="220" CenterY="220"/>
                    </Border.RenderTransform>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                        <!-- ═══ GEOMETRIC 3D FACETED ARCHITECTURAL "P" LOGO ═══ -->
                        <Grid Width="72" Height="82" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <!-- Left Stem (Shadow Facet) -->
                            <Path Data="M 0,16 L 22,0 L 22,82 L 0,82 Z">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1E293B" Offset="0"/>
                                        <GradientStop Color="#0F172A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>

                            <!-- Top Diagonal Facet -->
                            <Path Data="M 22,0 L 52,0 L 72,20 L 42,20 Z">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#CBD5E1" Offset="0"/>
                                        <GradientStop Color="#94A3B8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>

                            <!-- Right Vertical Return Facet -->
                            <Path Data="M 72,20 L 72,50 L 52,68 L 52,38 Z">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#334155" Offset="0"/>
                                        <GradientStop Color="#1E293B" Offset="1"/>
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>

                            <!-- Bottom Loop Return Facet -->
                            <Path Data="M 52,68 L 22,68 L 22,46 L 52,38 Z">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#475569" Offset="0"/>
                                        <GradientStop Color="#1E293B" Offset="1"/>
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>

                            <!-- Inner Refraction Diamond Glint -->
                            <Path Data="M 22,18 L 40,18 L 40,46 L 22,46 Z" Fill="#E2E8F0" Opacity="0.5"/>
                            <Line X1="22" Y1="0" X2="22" Y2="82" Stroke="#FFFFFF" StrokeThickness="1" Opacity="0.8"/>
                        </Grid>

                        <!-- ═══ ELEGANT SERIF TITLE: ProGlass ═══ -->
                        <TextBlock x:Name="BrandTitleText"
                                   FontFamily="Georgia, 'Times New Roman', Cambria, serif"
                                   FontSize="48" FontWeight="Normal"
                                   Foreground="{StaticResource BrandDarkBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,0,0,4">
                            <Run Text="Pro" FontWeight="Bold"/><Run Text="Glass"/>
                        </TextBlock>

                        <!-- ═══ DIVIDER ROW: PRECISION AUTOMATION ═══ -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                            <Rectangle x:Name="DividerRuleLeft" Width="36" Height="1" Fill="{StaticResource KeylineBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock x:Name="DividerLabel" Text="PRECISION AUTOMATION"
                                       FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrandDarkBrush}"
                                       VerticalAlignment="Center"/>
                            <Rectangle x:Name="DividerRuleRight" Width="36" Height="1" Fill="{StaticResource KeylineBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>

                        <!-- ═══ CENTER 4-POINT DIAMOND STAR ═══ -->
                        <Path x:Name="DiamondGlyph" Data="M 4,0 L 8,4 L 4,8 L 0,4 Z" Fill="#475569" Width="7" Height="7"
                              HorizontalAlignment="Center" Margin="0,14,0,12"/>

                        <!-- ═══ SUBTITLE ═══ -->
                        <TextBlock x:Name="SubtitleLabel" Text="Splash 09: Glass Prism Optical Bevel"
                                   FontFamily="Segoe UI" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrandMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,18"/>

                        <!-- ═══ FRAMED RECTANGULAR PROGRESS TRACK ═══ -->
                        <Grid x:Name="ProgressTrack" Width="260" HorizontalAlignment="Center" Opacity="0">
                            <StackPanel>
                                <Border x:Name="ProgressBorder" Width="260" Height="8"
                                        BorderBrush="{StaticResource KeylineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="1"
                                        Background="#E2E8F0"
                                        Padding="1"
                                        HorizontalAlignment="Center">
                                    <ProgressBar x:Name="ProgressIndicator" IsIndeterminate="True"
                                                 Height="4"
                                                 Foreground="{StaticResource BrandDarkBrush}"
                                                 Background="Transparent"
                                                 BorderThickness="0"/>
                                </Border>

                                <TextBlock x:Name="StatusLabel" Text="Initializing Precision Modules... 18%"
                                           FontFamily="Segoe UI" FontSize="11"
                                           Foreground="{StaticResource BrandMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0"/>
                            </StackPanel>

                            <!-- Circular Arc Spinner for compatibility -->
                            <Path x:Name="ProgressFill" Stroke="{StaticResource BrandDarkBrush}" StrokeThickness="2"
                                  Data="M 10,2 A 8,8 0 1 1 9.9,2" Visibility="Collapsed">
                                <Path.RenderTransform><RotateTransform x:Name="ProgressRotate" Angle="0" CenterX="10" CenterY="10"/></Path.RenderTransform>
                            </Path>
                        </Grid>

                        <!-- Hidden AppNameText for 100% code-behind animation binding safety -->
                        <TextBlock x:Name="AppNameText" FontSize="1" Height="0" Opacity="0" Visibility="Hidden">
                            <TextBlock.RenderTransform><TranslateTransform x:Name="AppNameTranslate" Y="0"/></TextBlock.RenderTransform>
                        </TextBlock>

                    </StackPanel>
                </Border>

            </Grid>
        </Grid>

        <!-- ═══ CODE-BEHIND COMPATIBILITY HOOKS (Null-safe, Zero Visual Clutter) ═══ -->
        <StackPanel Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="CaptionMadeIn" Visibility="Collapsed" Opacity="0"/>
            <TextBlock x:Name="CaptionEnterprise" Visibility="Collapsed" Opacity="0"/>
            <TextBlock x:Name="CaptionSecure" Visibility="Collapsed" Opacity="0"/>
        </StackPanel>

        <!-- ═══ AUTHENTICATION & TERMS GATES ═══ -->
        <Grid x:Name="LoginHost" Visibility="Collapsed" Opacity="0" Panel.ZIndex="11">
            <login:LoginPanel x:Name="LoginGate"/>
        </Grid>

        <Grid x:Name="SetupHost" Visibility="Collapsed" Opacity="0" Panel.ZIndex="12">
            <login:FirstRunSetupPanel x:Name="SetupGate"/>
        </Grid>

        <Grid x:Name="TermsPanel" Background="Transparent" Visibility="Collapsed" Opacity="0" Panel.ZIndex="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,52,0,0">
                <TextBlock Text="{DynamicResource Splash.TermsTitle}" FontSize="34" FontWeight="{DynamicResource Weight.Bold}" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryForegroundBrush}">
                    <TextBlock.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.35"/></TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="{DynamicResource Splash.UaeIntro}" FontSize="{DynamicResource FontSize.Title}" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Rectangle Height="2" Width="48" Margin="0,18,0,0" RadiusX="1" RadiusY="1" HorizontalAlignment="Center" Fill="{DynamicResource AccentBrush}"/>
            </StackPanel>
            <Border Grid.Row="1" MaxWidth="860" Margin="48,26,48,16" Padding="40,32" CornerRadius="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}" Background="#CCFFFFFF">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,20"><TextBlock Style="{StaticResource TermsLead}" Text="{DynamicResource Splash.Term1}"/><TextBlock Style="{StaticResource TermsBody}" Text="{DynamicResource Splash.SoftwareAssistsPreparingTaxInvoicesRecords}"/></StackPanel>
