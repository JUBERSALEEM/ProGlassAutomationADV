<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Splash/SplashView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Splash Screen — "Aurora Glass" 2050 redesign

     Blueish glassmorphism / glass-panel pattern with a futuristic
     (2050) identity: deep-blue blurred aurora stage, frosted-glass
     chips and tiles, a layered glowing glass logo core with a dashed
     orbit ring and shimmer, luminous progress. Icons refreshed to a
     modern Segoe MDL2 set.

     PRESERVED (zero regression — every name animated by SplashView.xaml.cs):
       • Window flags (Maximized / None / Topmost / NoTaskbar)
       • TopLeftBadge, TopCenterPill, TopRightBadge, LogoBorder,
         LogoScale, ShimmerOverlay, ShimmerTranslate, AppNameText,
         AppNameTranslate, TaglineText, FeaturePanel, ProgressFill,
         LoadingText, LoadingDots
       • FeatureBadgeTemplate root StackPanel (x:Name FeatureItemPanel,
         Opacity=0, data-driven {Binding Icon/Label/BorderBrush})
       • TermsPanel / AcceptTermsCheck / DeclineButton / ContinueButton
       • FadeOutAndClose(Action) public API
═══════════════════════════════════════════════════════════════════════ -->
<Window x:Class="ProGlassAutomation.Views.Splash.SplashView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:updates="clr-namespace:ProGlassAutomation.Services.Updates"
        xmlns:login="clr-namespace:ProGlassAutomation.Views.Login"
        Title="ProGlass Automation"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- ═══ PALETTE (frozen once) — blueish glass spectrum ═══ -->
        <SolidColorBrush x:Key="Abyss"    Color="#050B18" po:Freeze="True"/>
        <SolidColorBrush x:Key="Navy"     Color="#16317A" po:Freeze="True"/>
        <SolidColorBrush x:Key="Royal"    Color="#1D4ED8" po:Freeze="True"/>
        <SolidColorBrush x:Key="Sapphire" Color="#3B82F6" po:Freeze="True"/>
        <SolidColorBrush x:Key="Azure"    Color="#60A5FA" po:Freeze="True"/>
        <SolidColorBrush x:Key="Cerulean" Color="#93C5FD" po:Freeze="True"/>
        <SolidColorBrush x:Key="Frost"    Color="#BFDBFE" po:Freeze="True"/>
        <SolidColorBrush x:Key="Ice"      Color="#DBEAFE" po:Freeze="True"/>
        <SolidColorBrush x:Key="Snow"     Color="#F8FAFC" po:Freeze="True"/>

        <!-- ═══ STAGE — deep blue aurora ═══ -->
        <LinearGradientBrush x:Key="PageBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#040B1C" Offset="0.0"/>
            <GradientStop Color="#0A1A44" Offset="0.42"/>
            <GradientStop Color="#0B2A6E" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Blurred aurora orbs (glass backdrop) -->
        <RadialGradientBrush x:Key="OrbRight"
                             Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#4D82F6FF" Offset="0.0"/>
            <GradientStop Color="#1D4ED84D" Offset="0.55"/>
            <GradientStop Color="#1D4ED800" Offset="1.0"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="OrbLeft"
                             Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#60A5FA66" Offset="0.0"/>
            <GradientStop Color="#3B82F633" Offset="0.55"/>
            <GradientStop Color="#3B82F600" Offset="1.0"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="OrbCore"
                             Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#93C5FD80" Offset="0.0"/>
            <GradientStop Color="#60A5FA33" Offset="0.6"/>
            <GradientStop Color="#60A5FA00" Offset="1.0"/>
        </RadialGradientBrush>

        <!-- ═══ BRAND NAME — metallic glass gradient + glow ═══ -->
        <LinearGradientBrush x:Key="NameGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#BFDBFE" Offset="0.45"/>
            <GradientStop Color="#93C5FD" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- ═══ ICON HALO + GLASS ═══ -->
        <RadialGradientBrush x:Key="IconHalo"
                             Center="0.5,0.5" GradientOrigin="0.5,0.5"
                             RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#4F8EF766" Offset="0.0"/>
            <GradientStop Color="#4F8EF71F" Offset="0.6"/>
            <GradientStop Color="#4F8EF700" Offset="1.0"/>
        </RadialGradientBrush>

        <LinearGradientBrush x:Key="GlassPlate" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F7FFFFFF" Offset="0.0"/>
            <GradientStop Color="#E8F1FAFF" Offset="0.5"/>
            <GradientStop Color="#D0E2F5FF" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassHighlight" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#80FFFFFF" Offset="0.0"/>
            <GradientStop Color="#00FFFFFF" Offset="0.5"/>
            <GradientStop Color="#33FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- ═══ SIDE-RAIL GLASS SURFACES ═══ -->
        <LinearGradientBrush x:Key="RailPanelBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1AFFFFFF" Offset="0.0"/>
            <GradientStop Color="#07FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RailItemBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#16FFFFFF" Offset="0.0"/>
            <GradientStop Color="#05FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="IconTileBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#26FFFFFF" Offset="0.0"/>
            <GradientStop Color="#0AFFFFFF" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RailBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#66FFFFFF" Offset="0.0"/>
            <GradientStop Color="#2EFFFFFF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- ═══ PROGRESS — luminous ═══ -->
        <LinearGradientBrush x:Key="ProgressGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{DynamicResource AccentColor}" Offset="0.0"/>
            <GradientStop Color="{DynamicResource AccentLightColor}" Offset="0.55"/>
            <GradientStop Color="#93C5FD" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- ═══ SHIMMER SWEEP ═══ -->
        <LinearGradientBrush x:Key="ShimmerGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFFFF00" Offset="0.0"/>
            <GradientStop Color="#FFFFFF66" Offset="0.5"/>
            <GradientStop Color="#FFFFFF00" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- ═══ GLASS SHADOWS ═══ -->
        <DropShadowEffect x:Key="IconShadow" Color="{DynamicResource AccentColor}"
                          BlurRadius="48" ShadowDepth="0" Opacity="0.7"/>
        <DropShadowEffect x:Key="GlassGlow" Color="{DynamicResource AccentColor}"
                          BlurRadius="20" ShadowDepth="0" Opacity="0.55"/>
        <DropShadowEffect x:Key="ChipShadow" Color="#000000"
                          BlurRadius="16" ShadowDepth="3" Opacity="0.4"/>

        <!-- ═══ GLASS TRUST CHIP (frosted capsule) ═══ -->
        <Style x:Key="TrustChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassHighlight}"/>
            <Setter Property="BorderBrush" Value="#66B8D8FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Effect" Value="{StaticResource GlassGlow}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <Style x:Key="ChipGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Ice}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="ChipTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Ice}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══ GLASS FEATURE BADGE TEMPLATE (data-driven, animated) ═══ -->
        <DataTemplate x:Key="FeatureBadgeTemplate">
            <StackPanel Opacity="0" x:Name="FeatureItemPanel">
                <Border Width="76" Height="76"
                        CornerRadius="20"
                        BorderThickness="1"
                        BorderBrush="{Binding BorderBrush}"
                        Margin="8,0"
                        Effect="{StaticResource GlassGlow}"
                        SnapsToDevicePixels="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#26FFFFFF" Offset="0.0"/>
                            <GradientStop Color="#0AFFFFFF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <!-- glass glint in the top of the tile -->
                        <Border Height="26" VerticalAlignment="Top"
                                CornerRadius="20,20,0,0"
                                Background="{StaticResource GlassHighlight}"
                                IsHitTestVisible="False"/>
                        <TextBlock Text="{Binding Icon}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="{StaticResource Ice}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Label}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Frost}"
                           HorizontalAlignment="Center"
                           Margin="0,7,0,0"
                           IsHitTestVisible="False"/>
            </StackPanel>
        </DataTemplate>

        <!-- ═══ SIDE-RAIL 2050 GLASS ITEM PRIMITIVES ═══ -->
        <Style x:Key="GlassRailPanelStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadiusLarge}"/>
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="Background" Value="{StaticResource RailPanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource RailBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{StaticResource GlassGlow}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <Style x:Key="GlassRailItemStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="{StaticResource RailItemBg}"/>
            <Setter Property="BorderBrush" Value="#2EFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="GlassIconTileStyle" TargetType="Border">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Background" Value="{StaticResource IconTileBg}"/>
            <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="RailIndexStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#6E93C5FD"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
        </Style>

        <Style x:Key="RailLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Frost}"/>
        </Style>

        <Style x:Key="RailSubStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Foreground" Value="#A0BFDBFE"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="TermsDeclineButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource Frost}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="Transparent"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TermsContinueButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{DynamicResource AccentBrush}"
                                BorderThickness="0"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource AccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource PageBg}">

        <!-- ═══ BLURRED AURORA ORBS (glass stage) ═══ -->
        <Ellipse Width="900" Height="900"
                 Fill="{StaticResource OrbRight}"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-320,-320,0" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="120"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="760" Height="760"
                 Fill="{StaticResource OrbLeft}"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-280,0,0,-280" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="110"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="620" Height="620"
                 Fill="{StaticResource OrbCore}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="100"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Thin luminous accent lines -->
        <Rectangle Height="1" VerticalAlignment="Top" Margin="60,88,60,0"
                   Opacity="0.16" Fill="{StaticResource Azure}"
                   IsHitTestVisible="False"/>
        <Rectangle Height="1" VerticalAlignment="Bottom" Margin="60,88,60,0"
                   Opacity="0.16" Fill="{StaticResource Azure}"
                   IsHitTestVisible="False"/>

        <!-- ═══ TOP GLASS TRUST CHIPS ═══ -->
        <Border x:Name="TopLeftBadge" Style="{StaticResource TrustChipStyle}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="36,32,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE774;" Style="{StaticResource ChipGlyphStyle}"/>
                <TextBlock Text="MADE FOR UAE" Style="{StaticResource ChipTextStyle}"/>
            </StackPanel>
        </Border>

        <Border x:Name="TopCenterPill" Style="{StaticResource TrustChipStyle}"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,32,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE735;" Style="{StaticResource ChipGlyphStyle}"/>
                <TextBlock Style="{StaticResource ChipTextStyle}">
                    <Run Text="ENTERPRISE EDITION"/>
                    <Run Text=" · v"/>
                    <Run Text="{x:Static updates:AppInfo.Version}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <Border x:Name="TopRightBadge" Style="{StaticResource TrustChipStyle}"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,32,36,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72E;" Style="{StaticResource ChipGlyphStyle}"/>
                <TextBlock Text="OFFLINE · SECURE" Style="{StaticResource ChipTextStyle}"/>
            </StackPanel>
        </Border>

        <!-- ═══ LEFT CAPABILITY RAIL — 2050 glass panel ═══ -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                Margin="48,0,0,0" Width="340"
                Style="{StaticResource GlassRailPanelStyle}"
                IsHitTestVisible="False">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5"
                               VerticalAlignment="Center"
                               Fill="{StaticResource Azure}" Margin="0,0,10,0"/>
                    <TextBlock Text="MODULES" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource Ice}"/>
                </StackPanel>

                <Border Style="{StaticResource GlassRailItemStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="01" Style="{StaticResource RailIndexStyle}"/>
                        <Border Style="{StaticResource GlassIconTileStyle}">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="17" Foreground="{StaticResource Ice}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Proforma Invoicing" Style="{StaticResource RailLabelStyle}"/>
                            <TextBlock Text="Quotes &amp; proposals" Style="{StaticResource RailSubStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassRailItemStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="02" Style="{StaticResource RailIndexStyle}"/>
                        <Border Style="{StaticResource GlassIconTileStyle}">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="17" Foreground="{StaticResource Ice}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Job Orders &amp; Production" Style="{StaticResource RailLabelStyle}"/>
                            <TextBlock Text="Plan &amp; execute" Style="{StaticResource RailSubStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassRailItemStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="03" Style="{StaticResource RailIndexStyle}"/>
                        <Border Style="{StaticResource GlassIconTileStyle}">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="17" Foreground="{StaticResource Ice}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Delivery Notes" Style="{StaticResource RailLabelStyle}"/>
                            <TextBlock Text="Dispatch &amp; track" Style="{StaticResource RailSubStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassRailItemStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="04" Style="{StaticResource RailIndexStyle}"/>
                        <Border Style="{StaticResource GlassIconTileStyle}">
                            <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="17" Foreground="{StaticResource Ice}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="VAT Tax Invoices" Style="{StaticResource RailLabelStyle}"/>
                            <TextBlock Text="Compliance ready" Style="{StaticResource RailSubStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassRailItemStyle}" Margin="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="05" Style="{StaticResource RailIndexStyle}"/>
                        <Border Style="{StaticResource GlassIconTileStyle}">
                            <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="17" Foreground="{StaticResource Ice}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Profit &amp; Loss Analysis" Style="{StaticResource RailLabelStyle}"/>
                            <TextBlock Text="Margin insights" Style="{StaticResource RailSubStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══ RIGHT CAPABILITY RAIL — 2050 glass panel (mirrored) ═══ -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,0,48,0" Width="340"
                Style="{StaticResource GlassRailPanelStyle}"
                IsHitTestVisible="False">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,0,0,14">
                    <TextBlock Text="BUILT FOR" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource Ice}"/>
                    <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5"
                               VerticalAlignment="Center"
                               Fill="{StaticResource Azure}" Margin="10,0,0,0"/>
                </StackPanel>

                <Border Style="{StaticResource GlassRailItemStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                            <TextBlock Text="Works Fully Offline" Style="{StaticResource RailLabelStyle}"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Text="No internet needed" Style="{StaticResource RailSubStyle}"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                        <Border Style="{StaticResource GlassIconTileStyle}">
                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="17" Foreground="{StaticResource Ice}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="01" Style="{StaticResource RailIndexStyle}"
                                   Margin="9,0,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassRailItemStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                            <TextBlock Text="FTA 5% VAT Ready" Style="{StaticResource RailLabelStyle}"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Text="UAE compliant" Style="{StaticResource RailSubStyle}"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                        <Border Style="{StaticResource GlassIconTileStyle}">
                            <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="17" Foreground="{StaticResource Ice}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="02" Style="{StaticResource RailIndexStyle}"
                                   Margin="9,0,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassRailItemStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                            <TextBlock Text="Data Stays On Your PC" Style="{StaticResource RailLabelStyle}"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Text="Private &amp; local" Style="{StaticResource RailSubStyle}"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                        <Border Style="{StaticResource GlassIconTileStyle}">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="17" Foreground="{StaticResource Ice}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="03" Style="{StaticResource RailIndexStyle}"
                                   Margin="9,0,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassRailItemStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                            <TextBlock Text="Full Audit Trail" Style="{StaticResource RailLabelStyle}"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Text="Every change logged" Style="{StaticResource RailSubStyle}"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                        <Border Style="{StaticResource GlassIconTileStyle}">
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="17" Foreground="{StaticResource Ice}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="04" Style="{StaticResource RailIndexStyle}"
                                   Margin="9,0,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassRailItemStyle}" Margin="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                            <TextBlock Text="Automatic Backups" Style="{StaticResource RailLabelStyle}"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Text="Always protected" Style="{StaticResource RailSubStyle}"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                        <Border Style="{StaticResource GlassIconTileStyle}">
                            <TextBlock Text="&#xE8F7;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="17" Foreground="{StaticResource Ice}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="05" Style="{StaticResource RailIndexStyle}"
                                   Margin="9,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══ CENTER STAGE ═══ -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- Glass logo core with halo, orbit ring + shimmer -->
            <Border x:Name="LogoBorder" Width="280" Height="280"
                    HorizontalAlignment="Center"
                    IsHitTestVisible="False">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="LogoScale" ScaleX="0" ScaleY="0"/>
                </Border.RenderTransform>
                <Grid>
                    <Ellipse Width="280" Height="280"
                             Fill="{StaticResource IconHalo}"
                             IsHitTestVisible="False"/>
                    <!-- dashed orbit ring (glass satellite) -->
                    <Ellipse Width="260" Height="260"
                             Stroke="#664F8EF7" StrokeThickness="2"
                             StrokeDashArray="6 12"
                             IsHitTestVisible="False"/>
                    <Ellipse Width="240" Height="240"
                             Stroke="#334F8EF7" StrokeThickness="1"
                             IsHitTestVisible="False"/>

                    <!-- frosted glass plate carrying the app icon -->
                    <Border Width="188" Height="188"
                            CornerRadius="42"
                            Effect="{StaticResource IconShadow}"
                            Background="{StaticResource GlassPlate}"
                            SnapsToDevicePixels="True">
                        <Border Width="172" Height="172"
                                CornerRadius="38"
                                BorderBrush="#66FFFFFF"
                                BorderThickness="1"
                                ClipToBounds="True"
                                SnapsToDevicePixels="True">
                            <Border.Background>
                                <ImageBrush ImageSource="pack://application:,,,/Resources/proglass_icon_256.png"
                                            Stretch="UniformToFill"/>
                            </Border.Background>
                            <!-- Shimmer sweep clipped to the icon -->
                            <Border x:Name="ShimmerOverlay"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FFFFFF00" Offset="0.0"/>
                                        <GradientStop Color="#FFFFFF59" Offset="0.5"/>
                                        <GradientStop Color="#FFFFFF00" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ShimmerTranslate" X="-200"/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </Border>
                </Grid>
            </Border>

            <!-- Brand name -->
            <TextBlock x:Name="AppNameText"
                       Text="ProGlass Automation"
                       FontSize="58"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,28,0,0"
                       Foreground="{StaticResource NameGradient}"
                       Opacity="0"
                       IsHitTestVisible="False">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#3B82F6" BlurRadius="18"
                                      ShadowDepth="0" Opacity="0.55"/>
                </TextBlock.Effect>
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="AppNameTranslate" Y="20"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <TextBlock x:Name="TaglineText"
                       Text="Industrial ERP for Glass Production Workflow"
                       FontSize="17"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"
                       Foreground="{StaticResource Cerulean}"
                       Opacity="0"
                       IsHitTestVisible="False"/>

            <!-- Feature glass tiles -->
            <ItemsControl x:Name="FeaturePanel"
                          ItemTemplate="{StaticResource FeatureBadgeTemplate}"
                          HorizontalAlignment="Center"
                          Margin="0,36,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Luminous progress -->
            <Grid Width="560" Margin="0,42,0,0">
                <Border Height="5" CornerRadius="2.5"
                        Background="#22FFFFFF"
                        SnapsToDevicePixels="True"/>
                <Border x:Name="ProgressFill"
                        Height="5" Width="0"
                        HorizontalAlignment="Left"
                        CornerRadius="2.5"
                        Background="{StaticResource ProgressGradient}"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect Color="#3B82F6" BlurRadius="10"
                                          ShadowDepth="0" Opacity="0.9"/>
                    </Border.Effect>
                </Border>
            </Grid>

            <!-- Glass loading pill -->
            <Border CornerRadius="{DynamicResource CardCornerRadius}" Padding="16,7"
                    HorizontalAlignment="Center"
                    Margin="0,14,0,0"
                    Background="{StaticResource IconTileBg}"
                    BorderBrush="#30FFFFFF"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
                <StackPanel x:Name="LoadingStrip" Orientation="Horizontal">
                    <TextBlock x:Name="LoadingText"
                               Text="Starting engines"
                               FontSize="11"
                               Foreground="{StaticResource Frost}"
                               IsHitTestVisible="False"/>
                    <TextBlock x:Name="LoadingDots"
                               Text=""
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource Azure}"
                               IsHitTestVisible="False"/>
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- ═══ LOGIN GATE — same window as splash (no second window) ═══ -->
        <Grid x:Name="LoginHost"
              Visibility="Collapsed"
              Opacity="0"
              Panel.ZIndex="11">
            <login:LoginPanel x:Name="LoginGate"/>
        </Grid>

        <!-- ═══ TERMS GATE — FULL PAGE (glass scrim) ═══ -->
        <Grid x:Name="TermsPanel"
              Background="#E60A1428"
              Visibility="Collapsed"
              Opacity="0"
              Panel.ZIndex="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        Margin="0,46,0,0">
                <TextBlock Text="TERMS OF USE"
                           FontSize="26" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="White">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#3B82F6" BlurRadius="14"
                                          ShadowDepth="0" Opacity="0.6"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="United Arab Emirates · Please read before continuing"
                           FontSize="12.5"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"
                           Foreground="{StaticResource Frost}"/>
                <Rectangle Height="1" Width="360" Margin="0,18,0,0"
                           Opacity="0.25" Fill="{StaticResource Azure}"/>
            </StackPanel>

            <!-- Glass terms card -->
            <Border Grid.Row="1"
                    MaxWidth="980"
                    Margin="60,26,60,10"
                    Padding="42,34"
                    CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#18FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#0AFFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <TextBlock Foreground="{StaticResource Frost}"
                               FontSize="13.5"
                               LineHeight="25"
                               TextWrapping="Wrap">
                        <Run Text="1. Tax compliance is yours, not the software's." FontWeight="Bold" Foreground="White"/>
                        <LineBreak/>
                        <Run Text="This software assists with preparing tax invoices and records. Federal Decree-Law No. 8 of 2017 on Value Added Tax and Federal Decree-Law No. 28 of 2022 on Tax Procedures place the obligation to issue correct tax invoices, apply the correct VAT treatment, and retain records for the periods required by the Federal Tax Authority on YOU, the taxable person. You must verify every figure before issuing, filing or relying on it."/>
                        <LineBreak/><LineBreak/>
                        <Run Text="2. Record retention." FontWeight="Bold" Foreground="White"/>
                        <LineBreak/>
                        <Run Text="UAE tax law requires accounting records and tax invoices to be retained for the statutory period — generally five years, and longer for real-estate records. All data is stored locally on this computer only. Maintaining backups sufficient to meet that obligation is your responsibility."/>
                        <LineBreak/><LineBreak/>
                        <Run Text="3. Electronic records and signatures." FontWeight="Bold" Foreground="White"/>
                        <LineBreak/>
                        <Run Text="Federal Decree-Law No. 46 of 2021 on Electronic Transactions and Trust Services governs electronic records in the UAE. Documents produced here are electronic records; you are responsible for their integrity, storage, and any signature requirements applicable to your business."/>
                        <LineBreak/><LineBreak/>
                        <Run Text="4. Personal data protection." FontWeight="Bold" Foreground="White"/>
                        <LineBreak/>
                        <Run Text="Federal Decree-Law No. 45 of 2021 on the Protection of Personal Data applies to personal data you enter, such as customer and contact details. You act as the data controller. If you enable the optional AI assistant with real business data, customer names, project names and amounts are transmitted to a third-party AI provider outside this device. That feature is optional and can be switched off at any time in Settings."/>
                        <LineBreak/><LineBreak/>
                        <Run Text="5. Intellectual property and licence." FontWeight="Bold" Foreground="White"/>
                        <LineBreak/>
                        <Run Text="You are granted a non-transferable licence to use this software for your business. The software, its design and its source remain the property of the author. You may not resell, sublicense, or redistribute it."/>
                        <LineBreak/><LineBreak/>
                        <Run Text="6. Acceptable use." FontWeight="Bold" Foreground="White"/>
                        <LineBreak/>
                        <Run Text="You agree not to use this software to produce false, misleading or fraudulent invoices or records, or for any purpose unlawful under UAE federal or emirate law."/>
                        <LineBreak/><LineBreak/>
                        <Run Text="7. No warranty and limitation of liability." FontWeight="Bold" Foreground="White"/>
                        <LineBreak/>
                        <Run Text="The software is provided 'as is', without warranty of any kind, express or implied. Pricing, costing, VAT and profit calculations are aids, not professional advice. To the maximum extent permitted by law, no liability is accepted for any direct, indirect or consequential loss arising from use of, or reliance on, its output. Consult a qualified tax adviser regarding your obligations."/>
                        <LineBreak/><LineBreak/>
                        <Run Text="8. Updates." FontWeight="Bold" Foreground="White"/>
                        <LineBreak/>
                        <Run Text="Updates may be offered from time to time. Installing them is your choice; continuing to use an outdated version may affect compliance with changing tax rules."/>
                        <LineBreak/><LineBreak/>
                        <Run Text="9. Governing law." FontWeight="Bold" Foreground="White"/>
                        <LineBreak/>
                        <Run Text="These terms are governed by the laws of the United Arab Emirates and of the Emirate in which you operate. Disputes are subject to the competent UAE courts."/>
                    </TextBlock>
                </ScrollViewer>
            </Border>

            <!-- Glass accept bar -->
            <Border CornerRadius="{DynamicResource CardCornerRadius}" Grid.Row="2"
                    BorderBrush="#30FFFFFF"
                    BorderThickness="0,1,0,0"
                    Padding="60,20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1EFFFFFF" Offset="0.0"/>
                        <GradientStop Color="#0AFFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid MaxWidth="980">
                    <CheckBox x:Name="AcceptTermsCheck"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource Frost}"
                              FontSize="12.5"
                              Cursor="Hand"
                              Checked="AcceptTerms_Changed"
                              Unchecked="AcceptTerms_Changed">
                        <TextBlock Text="I have read and accept these terms, and I accept responsibility for the accuracy of the records I produce."
                                   TextWrapping="Wrap"
                                   MaxWidth="620"/>
                    </CheckBox>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="DeclineButton"
                                Content="DECLINE AND EXIT"
                                Width="170" Height="42"
                                Margin="0,0,12,0"
                                Style="{StaticResource TermsDeclineButtonStyle}"
                                Click="DeclineTerms_Click"/>
                        <Button x:Name="ContinueButton"
                                Content="ACCEPT AND CONTINUE"
                                Width="220" Height="42"
                                IsEnabled="False"
                                Style="{StaticResource TermsContinueButtonStyle}"
                                Click="ContinueFromTerms_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ FOOTER — glass pill ═══ -->
        <Border CornerRadius="{DynamicResource CardCornerRadius}" Padding="22,10"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,30"
                Background="{StaticResource IconTileBg}"
                BorderBrush="#2EFFFFFF"
                BorderThickness="1"
                Effect="{StaticResource GlassGlow}"
                SnapsToDevicePixels="True">
            <StackPanel>
                <TextBlock FontSize="11"
                           Foreground="{StaticResource Cerulean}"
                           HorizontalAlignment="Center"
                           IsHitTestVisible="False">
                    <Run Text="Developed by"/>
                    <Run Text=" Juber Saleem" FontWeight="Bold"/>
                </TextBlock>
                <TextBlock FontSize="10"
                           Margin="0,4,0,0"
                           Foreground="#A0BFDBFE"
                           HorizontalAlignment="Center"
                           IsHitTestVisible="False">
                    <Run Text="© 2026 ProGlass Automation · Sharjah, UAE"/>
                </TextBlock>
            </StackPanel>
        </Border>

    </Grid>
</Window>
