<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Splash/SplashView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Splash Screen — Option 10: Glass Mural Chassis & Specular Bevels

     100% Complete Architectural Rewrite:
       • Luxurious architectural glass panel stage with realistic bevels
       • Deep specular light sheens and ambient refractive reflections
       • Central floating glass shield enclosing illuminated PGA vector monogram
       • High-contrast metallic wordmark: "ProGlass Automation"
       • 6-column grid of frosted glass tiles with vibrant colored badges for core ERP modules
       • Ultra-thin glowing progress bar with active step telemetry
       • Clean corporate copyright and version footer
═══════════════════════════════════════════════════════════════════ -->
<Window x:Class="ProGlassAutomation.Views.Splash.SplashView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:updates="clr-namespace:ProGlassAutomation.Services.Updates"
        xmlns:login="clr-namespace:ProGlassAutomation.Views.Login"
        xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
        Title="{DynamicResource Shell.AppTitle}"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#080C14"
        ShowInTaskbar="False"
        Topmost="True"
        behaviors:ViewportFitBehavior.DisableZoom="True"
        FontFamily="{DynamicResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Corner Tokens -->
        <CornerRadius x:Key="SplashCorner">10</CornerRadius>
        <CornerRadius x:Key="SplashCornerLarge">18</CornerRadius>
        <CornerRadius x:Key="GlassPanelCorner">24</CornerRadius>

        <!-- Brand & Glass Mural Palette -->
        <SolidColorBrush x:Key="StageDeepBg" Color="#070B12"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#A855F7"/>
        <SolidColorBrush x:Key="AccentEmerald" Color="#10B981"/>

        <!-- Required backward-compatibility aliases -->
        <SolidColorBrush x:Key="SplashCerulean" Color="#38BDF8"/>
        <SolidColorBrush x:Key="SplashCeruleanLite" Color="#7DD3FC"/>
        <SolidColorBrush x:Key="SplashCeruleanDark" Color="#0284C7"/>
        <SolidColorBrush x:Key="SplashOutline" Color="#1E293B"/>
        <SolidColorBrush x:Key="SplashPillBg" Color="#111827"/>
        <SolidColorBrush x:Key="SplashTrackBg" Color="#1E293B"/>
        <SolidColorBrush x:Key="SplashTextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="SplashTextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="SplashOnAccent" Color="#000000"/>

        <!-- ═══ GLASS MURAL CHASSIS GRADIENTS ═══ -->
        <!-- Deep architectural canvas backdrop -->
        <LinearGradientBrush x:Key="GlassStageGradient" StartPoint="0.1,0" EndPoint="0.9,1">
            <GradientStop Color="#070B14" Offset="0.0"/>
            <GradientStop Color="#0B1322" Offset="0.4"/>
            <GradientStop Color="#101B2E" Offset="0.75"/>
            <GradientStop Color="#080D18" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Multi-layer Specular Glass Chassis Slab -->
        <LinearGradientBrush x:Key="ChassisGlassFill" StartPoint="0,0" EndPoint="0.8,1">
            <GradientStop Color="#28FFFFFF" Offset="0.0"/>
            <GradientStop Color="#0F1E293B" Offset="0.25"/>
            <GradientStop Color="#0A0F172A" Offset="0.7"/>
            <GradientStop Color="#1438BDF8" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Specular Chamfered Bevel Edge -->
        <LinearGradientBrush x:Key="SpecularBevelBorder" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#99FFFFFF" Offset="0.0"/>
            <GradientStop Color="#3338BDF8" Offset="0.2"/>
            <GradientStop Color="#11FFFFFF" Offset="0.5"/>
            <GradientStop Color="#2238BDF8" Offset="0.85"/>
            <GradientStop Color="#66FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Glass Tile Surface Sheen -->
        <LinearGradientBrush x:Key="TileSpecularSheen" StartPoint="0,0" EndPoint="0.4,1">
            <GradientStop Color="#40FFFFFF" Offset="0.0"/>
            <GradientStop Color="#15FFFFFF" Offset="0.3"/>
            <GradientStop Color="#00FFFFFF" Offset="0.6"/>
        </LinearGradientBrush>

        <!-- Frosted Tile Base -->
        <LinearGradientBrush x:Key="TileFrostedBg" StartPoint="0,0" EndPoint="0.7,1">
            <GradientStop Color="#201E293B" Offset="0.0"/>
            <GradientStop Color="#2A0F172A" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Luminous Hairline Progress -->
        <LinearGradientBrush x:Key="LuminousProgressGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0284C7" Offset="0.0"/>
            <GradientStop Color="#38BDF8" Offset="0.5"/>
            <GradientStop Color="#A855F7" Offset="0.85"/>
            <GradientStop Color="#F472B6" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Specular Glow and Depth Dropshadows -->
        <DropShadowEffect x:Key="ChassisMuralShadow" Color="#000000" BlurRadius="60" ShadowDepth="18" Opacity="0.7"/>
        <DropShadowEffect x:Key="ShieldNeonGlow" Color="#38BDF8" BlurRadius="45" ShadowDepth="0" Opacity="0.45"/>
        <DropShadowEffect x:Key="TileShadow" Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.4"/>
        <DropShadowEffect x:Key="IconBadgeGlow" Color="#38BDF8" BlurRadius="12" ShadowDepth="0" Opacity="0.35"/>

        <!-- ═══ 6-COLUMN FROSTED GLASS TILE TEMPLATE ═══ -->
        <DataTemplate x:Key="MuralModuleTileTemplate">
            <Border Width="150" Height="96" Margin="7,6"
                    CornerRadius="14"
                    Background="{StaticResource TileFrostedBg}"
                    BorderBrush="{StaticResource SpecularBevelBorder}"
                    BorderThickness="1.2"
                    Effect="{StaticResource TileShadow}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <!-- Top-Edge Specular Glass Sheen -->
                    <Border CornerRadius="14" Background="{StaticResource TileSpecularSheen}" IsHitTestVisible="False"/>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Vibrant Accent Icon Badge -->
                        <Border Width="42" Height="42" CornerRadius="11"
                                Background="{Binding BorderBrush}"
                                Effect="{StaticResource IconBadgeGlow}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Icon}"
                                       FontFamily="{DynamicResource FontFamily.Icon}"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Tile Module Label -->
                        <TextBlock Text="{Binding Label}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#F8FAFC"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="SplashStageRoot" Background="{StaticResource GlassStageGradient}">

        <!-- Architectural Glass Wireframe Grid & Facet Reflections -->
        <Canvas IsHitTestVisible="False" Opacity="0.06">
            <Line X1="0" Y1="140" X2="2560" Y2="140" Stroke="#38BDF8" StrokeThickness="1"/>
            <Line X1="0" Y1="420" X2="2560" Y2="420" Stroke="#38BDF8" StrokeThickness="1" StrokeDashArray="3 9"/>
            <Line X1="0" Y1="700" X2="2560" Y2="700" Stroke="#38BDF8" StrokeThickness="1" StrokeDashArray="3 9"/>
            <Line X1="0" Y1="980" X2="2560" Y2="980" Stroke="#38BDF8" StrokeThickness="1"/>
            <Line X1="360" Y1="0" X2="360" Y2="1600" Stroke="#38BDF8" StrokeThickness="1"/>
            <Line X1="860" Y1="0" X2="860" Y2="1600" Stroke="#38BDF8" StrokeThickness="1" StrokeDashArray="3 9"/>
            <Line X1="1360" Y1="0" X2="1360" Y2="1600" Stroke="#38BDF8" StrokeThickness="1" StrokeDashArray="3 9"/>
            <Line X1="1860" Y1="0" X2="1860" Y2="1600" Stroke="#38BDF8" StrokeThickness="1"/>
            <!-- 45° Specular Facet Bevel Guidelines -->
            <Line X1="200" Y1="0" X2="1200" Y2="1000" Stroke="#FFFFFF" StrokeThickness="1" StrokeDashArray="6 12" Opacity="0.5"/>
            <Line X1="900" Y1="0" X2="1900" Y2="1000" Stroke="#FFFFFF" StrokeThickness="1" StrokeDashArray="6 12" Opacity="0.5"/>
        </Canvas>

        <!-- Ambient Refractive Optical Glow Orbs -->
        <Ellipse x:Name="OrbRightShape" Width="720" Height="720"
                 Fill="#1C38BDF8"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-220,-220,0" IsHitTestVisible="False">
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="OrbRightScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="OrbRightMove" X="0" Y="0"/>
                </TransformGroup>
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="OrbLeftShape" Width="640" Height="640"
                 Fill="#18A855F7"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-180,0,0,-180" IsHitTestVisible="False">
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="OrbLeftScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="OrbLeftMove" X="0" Y="0"/>
                </TransformGroup>
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="HeroGlowOrb" Width="820" Height="820"
                 Fill="#1A38BDF8"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="HeroGlowScale" ScaleX="1" ScaleY="1"/>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Retained elements for code-behind API compatibility -->
        <Rectangle x:Name="ConstellationRect" Visibility="Collapsed"/>
        <Ellipse x:Name="OrbitRingRotate" Visibility="Collapsed"/>

        <!-- ═══════════════════════════════════════════════════════════
             POSTER — GLASS MURAL CHASSIS & SPECULAR BEVELS
        ═══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="PosterHost" Margin="36,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Top Trust Badges -->
                <RowDefinition Height="*"/>
                <!-- Center Glass Mural Chassis -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ── TOP TRUST BADGES ─────────────────────────────────── -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: UAE Manufacturing Standard -->
                <Border x:Name="TopLeftBadge"
                        Background="#1E0F172A"
                        BorderBrush="{StaticResource SpecularBevelBorder}"
                        BorderThickness="1" CornerRadius="8"
                        Padding="14,7" HorizontalAlignment="Left" Opacity="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE774;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="12" Foreground="{StaticResource AccentCyan}" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource Splash.MadeInIndia}" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC"/>
                    </StackPanel>
                </Border>

                <!-- Center: Enterprise Edition -->
                <Border x:Name="TopCenterPill"
                        Background="#1E0F172A"
                        BorderBrush="{StaticResource SpecularBevelBorder}"
                        BorderThickness="1" CornerRadius="8"
                        Padding="18,7" HorizontalAlignment="Center" Opacity="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE735;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="12" Foreground="{StaticResource AccentCyan}" Margin="0,0,8,0"/>
                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyan}">
                            <Run Text="{DynamicResource Splash.Enterprise}"/>
                            <Run Text=" · "/>
                            <Run Text="{DynamicResource Splash.V}"/>
                            <Run Text="{x:Static updates:AppInfo.Version}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Right: Offline Secure Vault -->
                <Border x:Name="TopRightBadge"
                        Background="#1E0F172A"
                        BorderBrush="{StaticResource SpecularBevelBorder}"
                        BorderThickness="1" CornerRadius="8"
                        Padding="14,7" HorizontalAlignment="Right" Opacity="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE72E;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="12" Foreground="{StaticResource AccentEmerald}" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource Splash.OfflineSecure}" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── CENTER: ARCHITECTURAL GLASS MURAL CHASSIS ────────── -->
            <Border Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="1040"
                    Background="{StaticResource ChassisGlassFill}"
                    BorderBrush="{StaticResource SpecularBevelBorder}"
                    BorderThickness="1.5"
                    CornerRadius="{StaticResource GlassPanelCorner}"
                    Effect="{StaticResource ChassisMuralShadow}"
                    Padding="44,36">
                <StackPanel>

                    <!-- Top Glass Header: Floating Shield & Metallic Wordmark -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Central Floating Glass Shield with Glowing PGA Monogram -->
                        <Border x:Name="LogoBorder" Grid.Column="0"
                                Width="96" Height="96"
                                Background="#2A0F172A"
                                BorderBrush="{StaticResource SpecularBevelBorder}"
                                BorderThickness="2"
                                CornerRadius="20"
                                Effect="{StaticResource ShieldNeonGlow}"
                                VerticalAlignment="Center"
                                Opacity="0">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="LogoScale" ScaleX="0.92" ScaleY="0.92" CenterX="48" CenterY="48"/>
                            </Border.RenderTransform>
                            <Grid>
                                <!-- Top-edge specular highlight -->
                                <Border CornerRadius="20" Background="{StaticResource TileSpecularSheen}"/>

                                <!-- Vector PGA Hexagonal Architectural Prism -->
                                <Viewbox Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid Width="72" Height="72">
                                        <Path Stroke="{StaticResource AccentCyan}"
                                              StrokeThickness="3.5"
                                              StrokeLineJoin="Round"
                                              Data="M20,5 L52,5 L68,36 L52,67 L20,67 L4,36 Z"/>
                                        <TextBlock Text="PGA"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="20" FontWeight="Bold"
                                                   Foreground="#FFFFFF"/>
                                    </Grid>
                                </Viewbox>
                            </Grid>
                        </Border>

                        <!-- Wordmark & Architectural Subtitle -->
                        <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="AppNameText"
                                       FontSize="34" FontWeight="Bold"
                                       Opacity="0">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="AppNameTranslate" Y="12"/>
                                </TextBlock.RenderTransform>
                                <Run Text="ProGlass " Foreground="{StaticResource TextPrimary}"/>
                                <Run Text="Automation" Foreground="{StaticResource AccentCyan}"/>
                            </TextBlock>

                            <TextBlock x:Name="TaglineText"
                                       Text="{DynamicResource Splash.MadeInIndiaDesc}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,4,0,0"
                                       Opacity="0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Beveled Glass Divider -->
                    <Border Height="1" Background="{StaticResource SpecularBevelBorder}" Margin="0,0,0,22"/>

                    <!-- ═══ 6-COLUMN GRID OF FROSTED GLASS TILES (Mural Chassis Layout) ═══ -->
                    <ItemsControl x:Name="FeaturePanel"
                                  ItemTemplate="{StaticResource MuralModuleTileTemplate}"
                                  HorizontalAlignment="Center"
                                  Opacity="0"
                                  Margin="0,0,0,24">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Luminous Hairline Progress Bar & Diagnostic Telemetry Strip -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="LoadingStrip" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="LoadingText"
                                       Text="{DynamicResource Splash.Starting}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock x:Name="LoadingDots"
                                       Text=""
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource AccentCyan}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="PRECISION ARCHITECTURE · 100% OPERATIONAL"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource AccentCyan}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Grid x:Name="ProgressTrack" Height="3.5" HorizontalAlignment="Stretch">
                        <Border Height="3.5" CornerRadius="2" Background="#261E293B"/>
                        <Border x:Name="ProgressFill" Height="3.5" Width="0" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource LuminousProgressGradient}"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- ── FOOTER: Slim Translucent Beveled Badge ────────────── -->
            <Border Grid.Row="2"
                    HorizontalAlignment="Center"
                    Padding="18,7"
                    CornerRadius="8"
                    Background="#1E0F172A"
                    BorderBrush="{StaticResource SpecularBevelBorder}"
                    BorderThickness="1">
                <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center">
                    <Run Text="{DynamicResource Splash.Copyright}"/>
                    <Run Text=" · "/>
                    <Run Text="{DynamicResource Splash.V}"/>
                    <Run Text="{x:Static updates:AppInfo.Version}"/>
                    <Run Text=" · Architectural Glass Production &amp; Nesting Engine"/>
                </TextBlock>
            </Border>
        </Grid>

        <!-- ═══ LOGIN GATE ═══ -->
        <Grid x:Name="LoginHost" Visibility="Collapsed" Opacity="0" Panel.ZIndex="11">
            <login:LoginPanel x:Name="LoginGate"/>
        </Grid>

        <!-- ═══ FIRST-RUN SETUP GATE ═══ -->
        <Grid x:Name="SetupHost" Visibility="Collapsed" Opacity="0" Panel.ZIndex="12">
            <login:FirstRunSetupPanel x:Name="SetupGate"/>
        </Grid>

        <!-- ═══ TERMS GATE (UAE Legal Terms Intact) ═══ -->
        <Grid x:Name="TermsPanel" Background="{StaticResource GlassStageGradient}" Visibility="Collapsed" Opacity="0" Panel.ZIndex="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,46,0,0">
                <TextBlock Text="{DynamicResource Splash.TermsTitle}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimary}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#38BDF8" BlurRadius="18" ShadowDepth="0" Opacity="0.35"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="{DynamicResource Splash.UaeIntro}" FontSize="14" HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{StaticResource TextSecondary}"/>
                <Rectangle Height="1" Width="360" Margin="0,18,0,0" Opacity="0.5" Fill="{StaticResource AccentCyan}"/>
            </StackPanel>

            <Border Grid.Row="1" MaxWidth="980" Margin="60,26,60,10" Padding="42,34"
                    CornerRadius="{StaticResource SplashCornerLarge}"
                    BorderBrush="{StaticResource SpecularBevelBorder}" BorderThickness="1"
                    Background="#1E0F172A">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="13" LineHeight="24" TextWrapping="Wrap">
                        <Run Text="{DynamicResource Splash.Term1}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/><LineBreak/>
                        <Run Text="{DynamicResource Splash.SoftwareAssistsPreparingTaxInvoicesRecords}"/><LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term2}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/><LineBreak/>
                        <Run Text="{DynamicResource Splash.UAETaxLawRequiresAccountingRecordsTax}"/><LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term3}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/><LineBreak/>
                        <Run Text="{DynamicResource Splash.FederalDecreeLawNo462021Electronic}"/><LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term4}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/><LineBreak/>
                        <Run Text="{DynamicResource Splash.FederalDecreeLawNo452021ProtectionPersonal}"/><LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term5}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/><LineBreak/>
                        <Run Text="{DynamicResource Splash.GrantedNonTransferableLicenceUseSoftware}"/><LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term6}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/><LineBreak/>
                        <Run Text="{DynamicResource Splash.AgreeUseSoftwareProduceFalseMisleading}"/><LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term7}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/><LineBreak/>
                        <Run Text="{DynamicResource Splash.SoftwareProvidedWithoutWarrantyKindExpress}"/><LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term8}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/><LineBreak/>
                        <Run Text="{DynamicResource Splash.UpdatesMayOfferedTimeTimeInstallingChoice}"/><LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term9}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/><LineBreak/>
                        <Run Text="{DynamicResource Splash.TermsGovernedLawsUnitedArabEmiratesEmirate}"/>
                    </TextBlock>
                </ScrollViewer>
            </Border>

            <Border x:Name="TermsBar" CornerRadius="{StaticResource SplashCornerLarge}" Grid.Row="2"
                    BorderBrush="{StaticResource SpecularBevelBorder}" BorderThickness="0,1,0,0"
                    Padding="60,20" Background="#1E0F172A">
                <DockPanel LastChildFill="True" MaxWidth="980">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,8,0,0">
                        <Button x:Name="DeclineButton" Content="{DynamicResource Splash.DeclineExit}" MinWidth="150" Height="40" Margin="0,0,12,0"
                                Style="{StaticResource Button.Secondary}" Command="{Binding DeclineCommand}"/>
                        <Button x:Name="ContinueButton" Content="{DynamicResource Splash.AcceptContinue}" MinWidth="190" Height="40"
                                IsEnabled="{Binding IsContinueEnabled}" Style="{StaticResource Button.Primary}" Command="{Binding ContinueCommand}"/>
                    </StackPanel>
                    <CheckBox x:Name="AcceptTermsCheck" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"
                              FontSize="13" Cursor="Hand" Margin="0,8,0,0" IsChecked="{Binding AcceptTerms, Mode=TwoWay}">
                        <TextBlock Text="{DynamicResource Splash.AcceptText}" TextWrapping="Wrap"/>
                    </CheckBox>
                </DockPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
