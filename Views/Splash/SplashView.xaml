<Window x:Class="ProGlassAutomation.Views.Splash.SplashView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:updates="clr-namespace:ProGlassAutomation.Services.Updates"
        xmlns:login="clr-namespace:ProGlassAutomation.Views.Login"
        xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
        Title="{DynamicResource Shell.AppTitle}"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#FBFDFF"
        ShowInTaskbar="False"
        Topmost="True"
        behaviors:ViewportFitBehavior.DisableZoom="True"
        FontFamily="{DynamicResource AppFontFamily}"
        FontWeight="{DynamicResource AppFontWeight}"
        FontStyle="{DynamicResource AppFontStyle}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <SolidColorBrush x:Key="SplashBg" Color="#FBFDFF"/>
        <SolidColorBrush x:Key="SplashCaptionBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="SplashTrackBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="SplashGlassBg" Color="#66FFFFFF"/>
        <SolidColorBrush x:Key="SplashGlassBorder" Color="#99FFFFFF"/>

        <LinearGradientBrush x:Key="Blob1Grad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E0F2FE" Offset="0.0"/>
            <GradientStop Color="#DBEAFE" Offset="0.5"/>
            <GradientStop Color="#BFDBFE" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Blob2Grad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#A5F3FC" Offset="0.0"/>
            <GradientStop Color="#7DD3FC" Offset="0.55"/>
            <GradientStop Color="#BAE6FD" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Blob3Grad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F0F9FF" Offset="0.0"/>
            <GradientStop Color="#E0F2FE" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FluidGrad" StartPoint="0.18,0.12" EndPoint="0.82,0.88">
            <GradientStop Color="#F0F9FF" Offset="0.0"/>
            <GradientStop Color="#E0F2FE" Offset="0.22"/>
            <GradientStop Color="#BAE6FD" Offset="0.48"/>
            <GradientStop Color="#7DD3FC" Offset="0.72"/>
            <GradientStop Color="#A5F3FC" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="FluidEdgeGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#22D3EE" Offset="0.0"/>
            <GradientStop Color="#7DD3FC" Offset="0.5"/>
            <GradientStop Color="#0EA5E9" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ProgressGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#22D3EE" Offset="0.0"/>
            <GradientStop Color="#0EA5E9" Offset="0.55"/>
            <GradientStop Color="#0284C7" Offset="1.0"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="GlassShadow" Color="#0EA5E9" BlurRadius="28" ShadowDepth="0" Opacity="0.18"/>
        <DropShadowEffect x:Key="FluidGlow" Color="#7DD3FC" BlurRadius="36" ShadowDepth="0" Opacity="0.38"/>
        <DropShadowEffect x:Key="DropletShadow" Color="#0EA5E9" BlurRadius="14" ShadowDepth="0" Opacity="0.22"/>

        <RadialGradientBrush x:Key="DropletFill" GradientOrigin="0.32,0.28" Center="0.5,0.5" RadiusX="0.85" RadiusY="0.85">
            <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
            <GradientStop Color="#E6F0FDFF" Offset="0.28"/>
            <GradientStop Color="#CCDBEAFE" Offset="0.62"/>
            <GradientStop Color="#99BAE6FD" Offset="1.0"/>
        </RadialGradientBrush>

        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SplashCaptionBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style x:Key="TermsLead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="TermsBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="LineHeight" Value="24"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource SplashBg}">

        <!-- LARGE BLURRED BLOBS -->
        <Canvas IsHitTestVisible="False">
            <Ellipse x:Name="BgBlob1" Width="580" Height="440" Fill="{StaticResource Blob1Grad}" Opacity="0.48" Canvas.Left="-160" Canvas.Top="-100">
                <Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect>
                <Ellipse.RenderTransform><TranslateTransform x:Name="BgBlob1Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="BgBlob2" Width="720" Height="560" Fill="{StaticResource Blob2Grad}" Opacity="0.58" Canvas.Left="-200" Canvas.Top="420">
                <Ellipse.Effect><BlurEffect Radius="95"/></Ellipse.Effect>
                <Ellipse.RenderTransform><TranslateTransform x:Name="BgBlob2Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="BgBlob3" Width="560" Height="420" Fill="{StaticResource Blob3Grad}" Opacity="0.42" Canvas.Left="880" Canvas.Top="520">
                <Ellipse.Effect><BlurEffect Radius="75"/></Ellipse.Effect>
                <Ellipse.RenderTransform><TranslateTransform x:Name="BgBlob3Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="BgBlob4" Width="260" Height="260" Fill="#FFBFDBFE" Opacity="0.38" Canvas.Left="1080" Canvas.Top="-50">
                <Ellipse.Effect><BlurEffect Radius="55"/></Ellipse.Effect>
                <Ellipse.RenderTransform><TranslateTransform x:Name="BgBlob4Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <!-- SMALL GLASS DROPLETS -->
        <Canvas IsHitTestVisible="False">
            <Ellipse x:Name="Droplet1" Width="44" Height="44" Fill="{StaticResource DropletFill}" Stroke="#BFFFFFFF" StrokeThickness="1.2" Effect="{StaticResource DropletShadow}" Canvas.Left="0" Canvas.Top="0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Droplet1Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Droplet2" Width="28" Height="28" Fill="{StaticResource DropletFill}" Stroke="#BFFFFFFF" StrokeThickness="1" Effect="{StaticResource DropletShadow}" Canvas.Left="0" Canvas.Top="0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Droplet2Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Droplet3" Width="24" Height="24" Fill="{StaticResource DropletFill}" Stroke="#BFFFFFFF" StrokeThickness="1" Effect="{StaticResource DropletShadow}" Canvas.Left="0" Canvas.Top="0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Droplet3Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Droplet4" Width="22" Height="22" Fill="{StaticResource DropletFill}" Stroke="#BFFFFFFF" StrokeThickness="1" Effect="{StaticResource DropletShadow}" Canvas.Left="0" Canvas.Top="0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Droplet4Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Droplet5" Width="32" Height="26" Fill="{StaticResource DropletFill}" Stroke="#BFFFFFFF" StrokeThickness="1" Effect="{StaticResource DropletShadow}" Canvas.Left="0" Canvas.Top="0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Droplet5Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Droplet6" Width="26" Height="22" Fill="{StaticResource DropletFill}" Stroke="#BFFFFFFF" StrokeThickness="1" Effect="{StaticResource DropletShadow}" Canvas.Left="0" Canvas.Top="0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Droplet6Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <!-- CENTER POSTER -->
        <Grid x:Name="PosterHost" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <Grid Width="460" Height="460" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <!-- Fluid organic blob — traced 8-lobe shape from mockup -->
                    <Path x:Name="FluidBlob" Opacity="0.74" Fill="{StaticResource FluidGrad}" Effect="{StaticResource FluidGlow}" Stretch="Fill"
                          Data="M 140,22 C 195,8 265,14 318,62 C 375,108 398,188 358,258 C 322,328 232,378 152,342 C 72,306 18,222 32,148 C 46,74 85,36 140,22 Z
                                M 88,88 C 108,68 142,58 172,78 C 202,98 212,138 192,168 C 172,198 128,208 98,188 C 68,168 58,128 88,88 Z">
                        <Path.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="FluidBlobScale" ScaleX="1" ScaleY="1" CenterX="210" CenterY="210"/>
                                <TranslateTransform x:Name="FluidBlobTranslate" X="0" Y="0"/>
                            </TransformGroup>
                        </Path.RenderTransform>
                    </Path>
                    <!-- Glossy edge highlight -->
                    <Path Opacity="0.85" Stroke="{StaticResource FluidEdgeGrad}" StrokeThickness="1.8" Fill="Transparent"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Stretch="Fill"
                          Data="M 140,22 C 195,8 265,14 318,62 C 375,108 398,188 358,258 C 322,328 232,378 152,342 C 72,306 18,222 32,148 C 46,74 85,36 140,22 Z">
                        <Path.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1" ScaleY="1" CenterX="210" CenterY="210"/>
                                <TranslateTransform X="0" Y="0"/>
                            </TransformGroup>
                        </Path.RenderTransform>
                        <Path.Effect><BlurEffect Radius="1.2"/></Path.Effect>
                    </Path>

                    <!-- Frosted hexagon 300x300 40% opacity 24px radius — rounded hexagon clip -->
                    <Border x:Name="LogoBorder" Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{StaticResource SplashGlassBg}" BorderBrush="{StaticResource SplashGlassBorder}" BorderThickness="1.5" CornerRadius="24"
                            Effect="{StaticResource GlassShadow}" Opacity="0">
                        <Border.Clip>
                            <PathGeometry>
                                <PathFigure StartPoint="150,18" IsClosed="True">
                                    <LineSegment Point="260,82"/>
                                    <LineSegment Point="260,218"/>
                                    <LineSegment Point="150,282"/>
                                    <LineSegment Point="40,218"/>
                                    <LineSegment Point="40,82"/>
                                </PathFigure>
                            </PathGeometry>
                        </Border.Clip>
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="LogoScale" ScaleX="0.92" ScaleY="0.92" CenterX="150" CenterY="150"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Border CornerRadius="24" Background="#26FFFFFF" Margin="10" Opacity="0.65" IsHitTestVisible="False"/>
                            <Border CornerRadius="24" Background="#12FFFFFF" Margin="0" Opacity="0.5" IsHitTestVisible="False">
                                <Border.Clip>
                                    <PathGeometry>
                                        <PathFigure StartPoint="150,18" IsClosed="True">
                                            <LineSegment Point="260,82"/>
                                            <LineSegment Point="260,218"/>
                                            <LineSegment Point="150,282"/>
                                            <LineSegment Point="40,218"/>
                                            <LineSegment Point="40,82"/>
                                        </PathFigure>
                                    </PathGeometry>
                                </Border.Clip>
                            </Border>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock FontSize="60" FontWeight="Bold" FontFamily="{DynamicResource AppFontFamily}">
                                    <Run Text="P" Foreground="#1E293B"/><Run Text="G" Foreground="#0EA5E9"/><Run Text="A" Foreground="#1E293B"/>
                                </TextBlock>
                                <Ellipse Width="10" Height="10" Fill="#0EA5E9" VerticalAlignment="Center" Margin="3,20,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>

                <TextBlock x:Name="AppNameText" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,32,0,0" Opacity="0" TextAlignment="Center">
                    <TextBlock.RenderTransform><TranslateTransform x:Name="AppNameTranslate" Y="14"/></TextBlock.RenderTransform>
                    <Run Text="ProGlass" Foreground="#1E293B"/><Run Text=" Automation" Foreground="#0EA5E9"/>
                </TextBlock>

                <Grid x:Name="ProgressTrack" Width="40" Height="40" HorizontalAlignment="Center" Margin="0,28,0,0" Opacity="0">
                    <Ellipse Stroke="{StaticResource SplashTrackBrush}" StrokeThickness="2.5" Opacity="0.75"/>
                    <Path x:Name="ProgressFill" Stroke="{StaticResource ProgressGrad}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M 20,2.5 A 17.5,17.5 0 1 1 19.9,2.5" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform><RotateTransform x:Name="ProgressRotate" Angle="0" CenterX="20" CenterY="20"/></Path.RenderTransform>
                    </Path>
                </Grid>

            </StackPanel>
        </Grid>

        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,36,28" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Border Width="3" Height="14" CornerRadius="1" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF9933" Offset="0.0"/>
                            <GradientStop Color="#FFFFFF" Offset="0.5"/>
                            <GradientStop Color="#138808" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <TextBlock x:Name="CaptionMadeIn" Text="MADE IN INDIA" Style="{StaticResource CaptionStyle}" Opacity="0"/>
            </StackPanel>
            <TextBlock x:Name="CaptionEnterprise" Opacity="0" Visibility="Collapsed" Text="ENTERPRISE"/>
            <TextBlock x:Name="CaptionSecure" Opacity="0" Visibility="Collapsed" Text="OFFLINE · SECURE"/>
        </StackPanel>

        <Grid x:Name="LoginHost" Visibility="Collapsed" Opacity="0" Panel.ZIndex="11">
            <login:LoginPanel x:Name="LoginGate"/>
        </Grid>

        <Grid x:Name="SetupHost" Visibility="Collapsed" Opacity="0" Panel.ZIndex="12">
            <login:FirstRunSetupPanel x:Name="SetupGate"/>
        </Grid>

        <Grid x:Name="TermsPanel" Background="Transparent" Visibility="Collapsed" Opacity="0" Panel.ZIndex="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,52,0,0">
                <TextBlock Text="{DynamicResource Splash.TermsTitle}" FontSize="34" FontWeight="{DynamicResource Weight.Bold}" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryForegroundBrush}">
                    <TextBlock.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.35"/></TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="{DynamicResource Splash.UaeIntro}" FontSize="{DynamicResource FontSize.Title}" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <Rectangle Height="2" Width="48" Margin="0,18,0,0" RadiusX="1" RadiusY="1" HorizontalAlignment="Center" Fill="{DynamicResource AccentBrush}"/>
            </StackPanel>
            <Border Grid.Row="1" MaxWidth="860" Margin="48,26,48,16" Padding="40,32" CornerRadius="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}" Background="#CCFFFFFF">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,20"><TextBlock Style="{StaticResource TermsLead}" Text="{DynamicResource Splash.Term1}"/><TextBlock Style="{StaticResource TermsBody}" Text="{DynamicResource Splash.SoftwareAssistsPreparingTaxInvoicesRecords}"/></StackPanel>
                        <StackPanel Margin="0,0,0,20"><TextBlock Style="{StaticResource TermsLead}" Text="{DynamicResource Splash.Term2}"/><TextBlock Style="{StaticResource TermsBody}" Text="{DynamicResource Splash.UAETaxLawRequiresAccountingRecordsTax}"/></StackPanel>
                        <StackPanel Margin="0,0,0,20"><TextBlock Style="{StaticResource TermsLead}" Text="{DynamicResource Splash.Term3}"/><TextBlock Style="{StaticResource TermsBody}" Text="{DynamicResource Splash.FederalDecreeLawNo462021Electronic}"/></StackPanel>
                        <StackPanel Margin="0,0,0,20"><TextBlock Style="{StaticResource TermsLead}" Text="{DynamicResource Splash.Term4}"/><TextBlock Style="{StaticResource TermsBody}" Text="{DynamicResource Splash.FederalDecreeLawNo452021ProtectionPersonal}"/></StackPanel>
                        <StackPanel Margin="0,0,0,20"><TextBlock Style="{StaticResource TermsLead}" Text="{DynamicResource Splash.Term5}"/><TextBlock Style="{StaticResource TermsBody}" Text="{DynamicResource Splash.GrantedNonTransferableLicenceUseSoftware}"/></StackPanel>
                        <StackPanel Margin="0,0,0,20"><TextBlock Style="{StaticResource TermsLead}" Text="{DynamicResource Splash.Term6}"/><TextBlock Style="{StaticResource TermsBody}" Text="{DynamicResource Splash.AgreeUseSoftwareProduceFalseMisleading}"/></StackPanel>
                        <StackPanel Margin="0,0,0,20"><TextBlock Style="{StaticResource TermsLead}" Text="{DynamicResource Splash.Term7}"/><TextBlock Style="{StaticResource TermsBody}" Text="{DynamicResource Splash.SoftwareProvidedWithoutWarrantyKindExpress}"/></StackPanel>
                        <StackPanel Margin="0,0,0,20"><TextBlock Style="{StaticResource TermsLead}" Text="{DynamicResource Splash.Term8}"/><TextBlock Style="{StaticResource TermsBody}" Text="{DynamicResource Splash.UpdatesMayOfferedTimeTimeInstallingChoice}"/></StackPanel>
                        <StackPanel><TextBlock Style="{StaticResource TermsLead}" Text="{DynamicResource Splash.Term9}"/><TextBlock Style="{StaticResource TermsBody}" Text="{DynamicResource Splash.TermsGovernedLawsUnitedArabEmiratesEmirate}"/></StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border x:Name="TermsBar" Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="#CCFFFFFF" Padding="48,18">
                <DockPanel LastChildFill="True" MaxWidth="860">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,8,0,0">
                        <Button x:Name="DeclineButton" Content="{DynamicResource Splash.DeclineExit}" MinWidth="150" Height="44" Margin="0,0,12,0" Style="{StaticResource Button.Secondary}" Command="{Binding DeclineCommand}"/>
                        <Button x:Name="ContinueButton" Content="{DynamicResource Splash.AcceptContinue}" MinWidth="190" Height="44" IsEnabled="{Binding IsContinueEnabled}" Style="{StaticResource Button.Primary}" Command="{Binding ContinueCommand}"/>
                    </StackPanel>
                    <CheckBox x:Name="AcceptTermsCheck" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="{DynamicResource FontSize.Title}" Cursor="Hand" Margin="0,8,0,0" IsChecked="{Binding AcceptTerms, Mode=TwoWay}">
                        <TextBlock Text="{DynamicResource Splash.AcceptText}" TextWrapping="Wrap"/>
                    </CheckBox>
                </DockPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
