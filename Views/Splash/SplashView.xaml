<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Splash/SplashView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Splash Screen — modern launch surface

     2026-09-05 redesign (owner directive): full professional rebuild
     on a deep-mesh cinematic stage:
       • layered dusk-navy gradient + soft accent orbs (atmosphere,
         not decoration-in-your-face)
       • slim glass trust chips (MADE IN INDIA / ENTERPRISE · vX /
         OFFLINE · SECURE)
       • hero brand block: crystal logo tile + halo + orbit ring,
         metallic-gradient wordmark, quiet tagline
       • uniform module chip strip (one clean 6-wide grid)
       • hairline luminous progress + subdued status line
       • slim translucent footer (product · version — location footer
         removed per owner request)

     PRESERVED (zero regression — public API of SplashView.xaml.cs):
       • Window flags (Maximized / None / Topmost / NoTaskbar)
       • FadeOutAndClose(Action), RunLoginAsync(), RunFirstRunSetupAsync(),
         ShowTermsGate()
       • TermsAccepted / TermsResolved / SignedIn / HasAcceptedCurrentTerms
       • Terms gate (UAE legal copy unchanged) + login + first-run gates
       • x:Name used by code-behind: PosterHost, LogoBorder, LogoScale,
         AppNameText, AppNameTranslate, TaglineText, ProgressTrack,
         ProgressFill, LoadingText, LoadingDots, LoadingStrip,
         TermsPanel, TermsBar, AcceptTermsCheck, DeclineButton,
         ContinueButton, LoginHost, LoginGate, SetupHost, SetupGate,
         TopLeftBadge, TopCenterPill, TopRightBadge, FeaturePanel
═══════════════════════════════════════════════════════════════════════ -->
<Window x:Class="ProGlassAutomation.Views.Splash.SplashView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:updates="clr-namespace:ProGlassAutomation.Services.Updates"
        xmlns:login="clr-namespace:ProGlassAutomation.Views.Login"
        xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
        Title="{DynamicResource Shell.AppTitle}"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#040B1C"
        ShowInTaskbar="False"
        Topmost="True"
        behaviors:ViewportFitBehavior.DisableZoom="True"
        FontFamily="{DynamicResource AppFontFamily}"
        FontWeight="{DynamicResource AppFontWeight}"
        FontStyle="{DynamicResource AppFontStyle}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <BlurEffect x:Key="OrbBlur"  Radius="90" RenderingBias="Performance"/>
        <BlurEffect x:Key="HaloBlur" Radius="30" RenderingBias="Performance"/>

        <!-- Colors and brushes are SEPARATE resources: GradientStop.Color
             and DropShadowEffect.Color demand a System.Windows.Media.Color
             — feeding them a SolidColorBrush is the XDG-0001
             "incompatible type" class of crash. Colors first, brushes reuse
             them so the palette stays single-source. -->
        <Color x:Key="FrostColor">#BFDBFE</Color>
        <Color x:Key="SplashCeruleanDarkColor">#2563EB</Color>

        <SolidColorBrush x:Key="Cerulean" Color="#93C5FD" po:Freeze="True"/>
        <SolidColorBrush x:Key="Frost"    Color="{StaticResource FrostColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="Ice"      Color="#DBEAFE" po:Freeze="True"/>

        <!-- ═══════════════════════════════════════════════════════════
             FROZEN SPLASH PALETTE
             The splash is a BRAND MOMENT, not a theme consumer: binding
             theme brushes here booted the app under the startup-merged
             theme and visibly flip-flopped mid-boot when the saved
             theme engaged. Every color below is frozen at design time;
             NOTHING inside the splash can morph anymore.
        ═══════════════════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="SplashCerulean"      Color="#60A5FA" po:Freeze="True"/>
        <SolidColorBrush x:Key="SplashCeruleanDark"  Color="{StaticResource SplashCeruleanDarkColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="SplashCeruleanLite"  Color="#93C5FD" po:Freeze="True"/>
        <SolidColorBrush x:Key="SplashCeruleanDeep"  Color="#1D4ED8" po:Freeze="True"/>
        <SolidColorBrush x:Key="SplashOutline"       Color="#1F99C8FF" po:Freeze="True"/>
        <SolidColorBrush x:Key="SplashPillBg"        Color="#0FFFFFFF" po:Freeze="True"/>
        <SolidColorBrush x:Key="SplashTrackBg"       Color="#14FFFFFF" po:Freeze="True"/>
        <SolidColorBrush x:Key="SplashTextPrimary"   Color="#F8FAFC" po:Freeze="True"/>
        <SolidColorBrush x:Key="SplashTextSecondary" Color="#8FA3C8" po:Freeze="True"/>
        <SolidColorBrush x:Key="SplashOnAccent"      Color="#FFFFFF" po:Freeze="True"/>
        <CornerRadius  x:Key="SplashCorner">10</CornerRadius>
        <CornerRadius  x:Key="SplashCornerLarge">16</CornerRadius>

        <!-- ═══ STAGE — dusk-navy mesh ═══ -->
        <LinearGradientBrush x:Key="PageBg" StartPoint="0,0" EndPoint="0.65,1">
            <GradientStop Color="#04080F" Offset="0.0"/>
            <GradientStop Color="#071226" Offset="0.45"/>
            <GradientStop Color="#0A1A3A" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Soft spotlight behind the hero brand block -->
        <RadialGradientBrush x:Key="HeroGlow"
                             Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#383B82F6" Offset="0.0"/>
            <GradientStop Color="#172563EB" Offset="0.6"/>
            <GradientStop Color="#001D4ED8" Offset="1.0"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="OrbRight"
                             Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#325EA5FF" Offset="0.0"/>
            <GradientStop Color="#143B82F6" Offset="0.55"/>
            <GradientStop Color="#003B82F6" Offset="1.0"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="OrbLeft"
                             Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#4060A5FA" Offset="0.0"/>
            <GradientStop Color="#1D3B82F6" Offset="0.55"/>
            <GradientStop Color="#003B82F6" Offset="1.0"/>
        </RadialGradientBrush>

        <!-- ═══ BRAND NAME — metallic crystal gradient + glow ═══ -->
        <LinearGradientBrush x:Key="NameGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#DBEAFE" Offset="0.5"/>
            <GradientStop Color="{StaticResource FrostColor}" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- ═══ LOGO TILE — crystal plate + sheen ═══ -->
        <LinearGradientBrush x:Key="SplashPlate" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FAFFFFFF" Offset="0.0"/>
            <GradientStop Color="#EDF3FCFF" Offset="0.5"/>
            <GradientStop Color="#D6E5F7FF" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TileSheen" StartPoint="0,0" EndPoint="0.6,1">
            <GradientStop Color="#B3FFFFFF" Offset="0.0"/>
            <GradientStop Color="#00FFFFFF" Offset="0.55"/>
        </LinearGradientBrush>

        <!-- ═══ PROGRESS — luminous ═══ -->
        <LinearGradientBrush x:Key="ProgressGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{StaticResource SplashCeruleanDarkColor}" Offset="0.0"/>
            <GradientStop Color="{StaticResource FrostColor}" Offset="0.55"/>
            <GradientStop Color="{StaticResource FrostColor}" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- ═══ CRYSTAL SHADOWS ═══ -->
        <DropShadowEffect x:Key="IconShadow" Color="{StaticResource SplashCeruleanDarkColor}"
                          BlurRadius="52" ShadowDepth="0" Opacity="0.55"/>
        <DropShadowEffect x:Key="SplashGlow" Color="{StaticResource SplashCeruleanDarkColor}"
                          BlurRadius="18" ShadowDepth="0" Opacity="0.35"/>

        <!-- ═══ TRUST CHIP (top badges) — slim glass ═══ -->
        <Style x:Key="TrustChipStyle" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1AFFFFFF" Offset="0.0"/>
                        <GradientStop Color="#0AFFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{StaticResource SplashOutline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <Style x:Key="ChipGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="Foreground" Value="{StaticResource SplashCerulean}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
        </Style>

        <Style x:Key="ChipTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SplashTextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══ MODULE CHIP (feature strip) — quiet 6-wide grid ═══ -->
        <DataTemplate x:Key="FeatureBadgeTemplate">
            <Border Height="38"
                    Margin="6,4"
                    Padding="14,0"
                    CornerRadius="10"
                    HorizontalAlignment="Stretch"
                    BorderBrush="{StaticResource SplashOutline}"
                    BorderThickness="1"
                    Background="{StaticResource SplashPillBg}"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True"
                    IsHitTestVisible="False">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Icon}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="{StaticResource TextBody}"
                               Foreground="{Binding BorderBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,9,0"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Label}"
                               FontSize="{StaticResource TextBody}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SplashTextPrimary}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ═══ TERMS — DECLINE (ghost) ═══ -->
        <Style x:Key="TermsDeclineButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource SplashTextSecondary}"/>
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="Transparent"
                                BorderBrush="{StaticResource SplashOutline}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource SplashCorner}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SplashPillBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ TERMS — CONTINUE (accent) ═══ -->
        <Style x:Key="TermsContinueButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource SplashOnAccent}"/>
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{StaticResource SplashCerulean}"
                                BorderThickness="0"
                                CornerRadius="{StaticResource SplashCorner}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{StaticResource SplashCeruleanLite}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{StaticResource SplashCeruleanDeep}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource PageBg}">

        <!-- ── ATMOSPHERE — soft accent orbs + hero spotlight ── -->
        <Ellipse Width="520" Height="520"
                 Fill="{StaticResource OrbRight}"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-160,-160,0" IsHitTestVisible="False"/>
        <Ellipse Width="440" Height="440"
                 Fill="{StaticResource OrbLeft}"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-140,0,0,-140" IsHitTestVisible="False"/>
        <Ellipse Width="620" Height="620"
                 Fill="{StaticResource HeroGlow}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Margin="0,-40,0,0" IsHitTestVisible="False"/>

        <!-- ═══════════════════════════════════════════════════════════
             POSTER — brand block
        ═══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="PosterHost" Margin="24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Top trust chips -->
                <RowDefinition Height="*"/>
                <!-- Center brand -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ── TOP TRUST CHIPS ──────────────────────────────────── -->
            <Grid Grid.Row="0">
                <Border x:Name="TopLeftBadge" Style="{StaticResource TrustChipStyle}"
                        HorizontalAlignment="Left" Opacity="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE774;" Style="{StaticResource ChipGlyphStyle}"/>
                        <TextBlock Text="{DynamicResource Splash.MadeInIndia}" Style="{StaticResource ChipTextStyle}"/>
                    </StackPanel>
                </Border>
                <Border x:Name="TopCenterPill" Style="{StaticResource TrustChipStyle}"
                        HorizontalAlignment="Center" Opacity="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE735;" Style="{StaticResource ChipGlyphStyle}"/>
                        <TextBlock Style="{StaticResource ChipTextStyle}">
                            <Run Text="{DynamicResource Splash.Enterprise}"/>
                            <Run Text="{DynamicResource Splash.V}"/>
                            <Run Text="{x:Static updates:AppInfo.Version}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border x:Name="TopRightBadge" Style="{StaticResource TrustChipStyle}"
                        HorizontalAlignment="Right" Opacity="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource ChipGlyphStyle}"/>
                        <TextBlock Text="{DynamicResource Splash.OfflineSecure}" Style="{StaticResource ChipTextStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── CENTER BRAND ─────────────────────────────────────── -->
            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="880"
                        Margin="8,18">

                <!-- Logo — crystal tile + halo + orbit ring + sheen -->
                <Border x:Name="LogoBorder" Width="152" Height="152"
                        HorizontalAlignment="Center"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        IsHitTestVisible="False"
                        Opacity="0">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="LogoScale" ScaleX="0.92" ScaleY="0.92"/>
                    </Border.RenderTransform>
                    <Grid>
                        <Ellipse Width="152" Height="152" Fill="{StaticResource SplashCerulean}" Opacity="0.22" Effect="{StaticResource HaloBlur}"/>
                        <Ellipse Width="142" Height="142"
                                 Stroke="{StaticResource SplashCerulean}" Opacity="0.5" StrokeThickness="1"
                                 StrokeDashArray="2 6"/>
                        <Ellipse Width="120" Height="120"
                                 Stroke="{StaticResource SplashOutline}" StrokeThickness="1"/>
                        <Border Width="104" Height="104" CornerRadius="26"
                                Effect="{StaticResource IconShadow}"
                                Background="{StaticResource SplashPlate}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border Width="96" Height="96" CornerRadius="22"
                                        BorderBrush="#88FFFFFF" BorderThickness="1"
                                        ClipToBounds="True">
                                    <Border.Background>
                                        <ImageBrush ImageSource="pack://application:,,,/Resources/proglass_icon_256.png"
                                                    Stretch="UniformToFill"
                                                    RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border.Background>
                                </Border>
                                <!-- Top-edge crystal sheen on the tile -->
                                <Border Width="96" Height="96" CornerRadius="22"
                                        Background="{StaticResource TileSheen}"
                                        IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Wordmark — metallic gradient (NameGradient was defined
                     but never wired; now the brand gets its glow) -->
                <TextBlock x:Name="AppNameText"
                           Text="{DynamicResource Shell.AppTitle}"
                           FontSize="{StaticResource TextDisplayLarge}" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"
                           Foreground="{StaticResource NameGradient}"
                           Opacity="0">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="AppNameTranslate" Y="12"/>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <TextBlock x:Name="TaglineText"
                           Text="{DynamicResource Splash.MadeInIndiaDesc}"
                           FontSize="{StaticResource TextBodyLarge}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"
                           Foreground="{StaticResource SplashCerulean}"
                           Opacity="0"/>

                <!-- Module chips — 6-wide uniform grid, one clean block -->
                <ItemsControl x:Name="FeaturePanel"
                              ItemTemplate="{StaticResource FeatureBadgeTemplate}"
                              HorizontalAlignment="Stretch"
                              MaxWidth="1180"
                              Margin="0,24,0,0"
                              Opacity="0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6"
                                         HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Progress — hairline luminous -->
                <Grid x:Name="ProgressTrack"
                      MaxWidth="320" Height="3"
                      Margin="0,26,0,0" HorizontalAlignment="Stretch">
                    <Border Height="3" CornerRadius="1.5" Background="{StaticResource SplashTrackBg}"/>
                    <Border x:Name="ProgressFill"
                            Height="3" Width="0"
                            HorizontalAlignment="Left"
                            CornerRadius="1.5"
                            Background="{StaticResource ProgressGradient}"/>
                </Grid>

                <!-- Status — quiet line (dots animated by code-behind) -->
                <Grid HorizontalAlignment="Center" Margin="0,14,0,0">
                    <StackPanel x:Name="LoadingStrip" Orientation="Horizontal">
                        <TextBlock x:Name="LoadingText"
                                   Text="{DynamicResource Splash.Starting}"
                                   FontSize="{StaticResource TextBody}"
                                   Foreground="{StaticResource SplashTextSecondary}"/>
                        <TextBlock x:Name="LoadingDots"
                                   Text=""
                                   FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{StaticResource SplashCerulean}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ── FOOTER (slim translucent) — location run removed ── -->
            <Border Grid.Row="2"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10"
                    Padding="16,6"
                    CornerRadius="10"
                    BorderBrush="{StaticResource SplashOutline}"
                    BorderThickness="1"
                    Background="{StaticResource SplashPillBg}">
                <TextBlock FontSize="{StaticResource TextBody}"
                           Foreground="{StaticResource SplashTextSecondary}"
                           Opacity="0.75"
                           HorizontalAlignment="Center">
                    <Run Text="{DynamicResource Splash.Copyright}"/>
                    <Run Text="{DynamicResource Splash.V}"/>
                    <Run Text="{x:Static updates:AppInfo.Version}"/>
                </TextBlock>
            </Border>
        </Grid>

        <!-- ═══ LOGIN GATE — same window as splash (no second window) ═══ -->
        <Grid x:Name="LoginHost"
              Visibility="Collapsed"
              Opacity="0"
              Panel.ZIndex="11">
            <login:LoginPanel x:Name="LoginGate"/>
        </Grid>

        <!-- ═══ FIRST-RUN SETUP GATE — shown when AuditService reports
             an empty Users table (fresh install). On successful create,
             the splash proceeds straight to the workspace. ═══ -->
        <Grid x:Name="SetupHost"
              Visibility="Collapsed"
              Opacity="0"
              Panel.ZIndex="12">
            <login:FirstRunSetupPanel x:Name="SetupGate"/>
        </Grid>

        <!-- ═══ TERMS GATE — FULL PAGE (defs unchanged, legal copy intact) ═══ -->
        <Grid x:Name="TermsPanel"
              Background="{StaticResource PageBg}"
              Visibility="Collapsed"
              Opacity="0"
              Panel.ZIndex="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        Margin="0,46,0,0">
                <TextBlock Text="{DynamicResource Splash.TermsTitle}"
                           FontSize="{StaticResource TextDisplayLarge}" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource SplashTextPrimary}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{StaticResource SplashCeruleanDarkColor}" BlurRadius="14"
                                          ShadowDepth="0" Opacity="0.6"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="{DynamicResource Splash.UaeIntro}"
                           FontSize="{StaticResource TextBodyLarge}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"
                           Foreground="{StaticResource SplashTextSecondary}"/>
                <Rectangle Height="1" Width="360" Margin="0,18,0,0"
                           Opacity="0.5" Fill="{StaticResource SplashCerulean}"/>
            </StackPanel>

            <!-- Crystal terms card -->
            <Border Grid.Row="1"
                    MaxWidth="980"
                    Margin="60,26,60,10"
                    Padding="42,34"
                    CornerRadius="{StaticResource SplashCornerLarge}"
                    BorderBrush="{StaticResource SplashOutline}"
                    BorderThickness="1"
                    Background="{StaticResource SplashPillBg}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <TextBlock Foreground="{StaticResource SplashTextSecondary}"
                               FontSize="{StaticResource TextBodyLarge}"
                               LineHeight="25"
                               TextWrapping="Wrap">
                        <Run Text="{DynamicResource Splash.Term1}" FontWeight="Bold" Foreground="{StaticResource SplashTextPrimary}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Splash.SoftwareAssistsPreparingTaxInvoicesRecords}"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term2}" FontWeight="Bold" Foreground="{StaticResource SplashTextPrimary}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Splash.UAETaxLawRequiresAccountingRecordsTax}"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term3}" FontWeight="Bold" Foreground="{StaticResource SplashTextPrimary}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Splash.FederalDecreeLawNo462021Electronic}"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term4}" FontWeight="Bold" Foreground="{StaticResource SplashTextPrimary}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Splash.FederalDecreeLawNo452021ProtectionPersonal}"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term5}" FontWeight="Bold" Foreground="{StaticResource SplashTextPrimary}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Splash.GrantedNonTransferableLicenceUseSoftware}"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term6}" FontWeight="Bold" Foreground="{StaticResource SplashTextPrimary}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Splash.AgreeUseSoftwareProduceFalseMisleading}"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term7}" FontWeight="Bold" Foreground="{StaticResource SplashTextPrimary}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Splash.SoftwareProvidedWithoutWarrantyKindExpress}"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term8}" FontWeight="Bold" Foreground="{StaticResource SplashTextPrimary}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Splash.UpdatesMayOfferedTimeTimeInstallingChoice}"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term9}" FontWeight="Bold" Foreground="{StaticResource SplashTextPrimary}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Splash.TermsGovernedLawsUnitedArabEmiratesEmirate}"/>
                    </TextBlock>
                </ScrollViewer>
            </Border>

            <!-- Accept bar -->
            <Border x:Name="TermsBar"
                    CornerRadius="{StaticResource SplashCornerLarge}" Grid.Row="2"
                    BorderBrush="{StaticResource SplashOutline}"
                    BorderThickness="0,1,0,0"
                    Padding="60,20"
                    Background="{StaticResource SplashPillBg}">
                <DockPanel LastChildFill="True" MaxWidth="980">
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,8,0,0">
                        <Button x:Name="DeclineButton"
                                Content="{DynamicResource Splash.DeclineExit}"
                                MinWidth="150" Height="42"
                                Margin="0,0,12,0"
                                Style="{StaticResource TermsDeclineButtonStyle}"
                                Command="{Binding DeclineCommand}"/>
                        <Button x:Name="ContinueButton"
                                Content="{DynamicResource Splash.AcceptContinue}"
                                MinWidth="190" Height="42"
                                IsEnabled="{Binding IsContinueEnabled}"
                                Style="{StaticResource TermsContinueButtonStyle}"
                                Command="{Binding ContinueCommand}"/>
                    </StackPanel>
                    <CheckBox x:Name="AcceptTermsCheck"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource SplashTextSecondary}"
                              FontSize="{StaticResource TextBodyLarge}"
                              Cursor="Hand"
                              Margin="0,8,0,0"
                              IsChecked="{Binding AcceptTerms, Mode=TwoWay}">
                        <TextBlock Text="{DynamicResource Splash.AcceptText}"
                                   TextWrapping="Wrap"/>
                    </CheckBox>
                </DockPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
