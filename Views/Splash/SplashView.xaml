<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Splash/SplashView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Splash Screen — v4 industrial redesign

     Full redesign: deep-navy industrial stage, real app icon with
     glass glow + shimmer sweep, gradient brand name, trust chips,
     feature glyph strip, luminous progress bar.

     PRESERVED (zero regression):
       • Window flags (Maximized / None / Topmost / NoTaskbar)
       • Every x:Name animated by SplashView.xaml.cs:
         TopLeftBadge, TopCenterPill, TopRightBadge, LogoBorder,
         LogoScale, ShimmerOverlay, ShimmerTranslate, AppNameText,
         AppNameTranslate, TaglineText, FeaturePanel, ProgressFill,
         LoadingText, LoadingDots
       • FeatureBadgeTemplate root StackPanel (Opacity=0, data-driven)
       • FadeOutAndClose(Action) public API
═══════════════════════════════════════════════════════════════════════ -->
<Window x:Class="ProGlassAutomation.Views.Splash.SplashView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:updates="clr-namespace:ProGlassAutomation.Services.Updates"
        Title="ProGlass Automation"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- ═══ PALETTE (frozen once) ═══ -->
        <SolidColorBrush x:Key="Abyss"    Color="#070F22" po:Freeze="True"/>
        <SolidColorBrush x:Key="Navy"     Color="#1E3A8A" po:Freeze="True"/>
        <SolidColorBrush x:Key="Royal"    Color="#1D4ED8" po:Freeze="True"/>
        <SolidColorBrush x:Key="Sapphire" Color="#3B82F6" po:Freeze="True"/>
        <SolidColorBrush x:Key="Azure"    Color="#60A5FA" po:Freeze="True"/>
        <SolidColorBrush x:Key="Cerulean" Color="#93C5FD" po:Freeze="True"/>
        <SolidColorBrush x:Key="Frost"    Color="#BFDBFE" po:Freeze="True"/>
        <SolidColorBrush x:Key="Ice"      Color="#DBEAFE" po:Freeze="True"/>
        <SolidColorBrush x:Key="Snow"     Color="#F8FAFC" po:Freeze="True"/>

        <!-- ═══ STAGE BACKGROUND — deep industrial navy ═══ -->
        <LinearGradientBrush x:Key="PageBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#060D1F" Offset="0.0"/>
            <GradientStop Color="#0B1B3F" Offset="0.5"/>
            <GradientStop Color="#081228" Offset="1.0"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="GlowRight"
                             Center="0.82,0.20" GradientOrigin="0.82,0.20"
                             RadiusX="0.45" RadiusY="0.45">
            <GradientStop Color="#3B82F62E" Offset="0.0"/>
            <GradientStop Color="#3B82F600" Offset="1.0"/>
        </RadialGradientBrush>

        <RadialGradientBrush x:Key="GlowLeft"
                             Center="0.14,0.85" GradientOrigin="0.14,0.85"
                             RadiusX="0.40" RadiusY="0.40">
            <GradientStop Color="#1D4ED826" Offset="0.0"/>
            <GradientStop Color="#1D4ED800" Offset="1.0"/>
        </RadialGradientBrush>

        <!-- ═══ BRAND NAME GRADIENT ═══ -->
        <LinearGradientBrush x:Key="NameGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#DBEAFE" Offset="0.0"/>
            <GradientStop Color="#93C5FD" Offset="0.45"/>
            <GradientStop Color="#60A5FA" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- ═══ ICON HALO ═══ -->
        <RadialGradientBrush x:Key="IconHalo"
                             Center="0.5,0.5" GradientOrigin="0.5,0.5"
                             RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#3B82F655" Offset="0.0"/>
            <GradientStop Color="#3B82F618" Offset="0.6"/>
            <GradientStop Color="#3B82F600" Offset="1.0"/>
        </RadialGradientBrush>

        <!-- ═══ PROGRESS ═══ -->
        <LinearGradientBrush x:Key="ProgressGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1D4ED8" Offset="0.0"/>
            <GradientStop Color="#3B82F6" Offset="0.6"/>
            <GradientStop Color="#93C5FD" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- ═══ SHIMMER SWEEP ═══ -->
        <LinearGradientBrush x:Key="ShimmerGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFFFF00" Offset="0.0"/>
            <GradientStop Color="#FFFFFF55" Offset="0.5"/>
            <GradientStop Color="#FFFFFF00" Offset="1.0"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="IconShadow" Color="#1D4ED8"
                          BlurRadius="42" ShadowDepth="0" Opacity="0.65"/>
        <DropShadowEffect x:Key="ChipShadow" Color="#000000"
                          BlurRadius="14" ShadowDepth="2" Opacity="0.35"/>

        <!-- ═══ TRUST CHIP — global pill geometry (H34 / R17 / 1.5) ═══ -->
        <Style x:Key="TrustChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A60A5FA"/>
            <Setter Property="BorderBrush" Value="#6660A5FA"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Effect" Value="{StaticResource ChipShadow}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <Style x:Key="ChipGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Azure}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="ChipTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Ice}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══ FEATURE BADGE TEMPLATE (data-driven, animated) ═══ -->
        <DataTemplate x:Key="FeatureBadgeTemplate">
            <StackPanel Opacity="0"
                        x:Name="FeatureItemPanel">
                <Border Width="62" Height="62"
                        CornerRadius="18"
                        Background="#10FFFFFF"
                        BorderThickness="{StaticResource CardBorderThickness}"
                        BorderBrush="{Binding BorderBrush}"
                        Margin="8,0"
                        SnapsToDevicePixels="True">
                    <TextBlock Text="{Binding Icon}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="24"
                               Foreground="{StaticResource Cerulean}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Border>
                <TextBlock Text="{Binding Label}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Frost}"
                           HorizontalAlignment="Center"
                           Margin="0,7,0,0"
                           IsHitTestVisible="False"/>
            </StackPanel>
        </DataTemplate>

    </Window.Resources>

    <Grid Background="{StaticResource PageBg}">

        <!-- ═══ AMBIENT GLOWS ═══ -->
        <Rectangle Fill="{StaticResource GlowRight}" IsHitTestVisible="False"/>
        <Rectangle Fill="{StaticResource GlowLeft}" IsHitTestVisible="False"/>

        <!-- Thin industrial accent lines -->
        <Rectangle Height="1" VerticalAlignment="Top" Margin="60,86,60,0"
                   Opacity="0.10" Fill="{StaticResource Azure}"
                   IsHitTestVisible="False"/>
        <Rectangle Height="1" VerticalAlignment="Bottom" Margin="60,86,60,0"
                   Opacity="0.10" Fill="{StaticResource Azure}"
                   IsHitTestVisible="False"/>

        <!-- ═══ TOP TRUST CHIPS ═══ -->
        <Border x:Name="TopLeftBadge" Style="{StaticResource TrustChipStyle}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="36,32,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE822;" Style="{StaticResource ChipGlyphStyle}"/>
                <TextBlock Text="MADE FOR UAE" Style="{StaticResource ChipTextStyle}"/>
            </StackPanel>
        </Border>

        <Border x:Name="TopCenterPill" Style="{StaticResource TrustChipStyle}"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,32,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE735;" Style="{StaticResource ChipGlyphStyle}"/>
                <TextBlock Style="{StaticResource ChipTextStyle}">
                    <Run Text="ENTERPRISE EDITION"/>
                    <Run Text=" · v"/>
                    <Run Text="{x:Static updates:AppInfo.Version}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <Border x:Name="TopRightBadge" Style="{StaticResource TrustChipStyle}"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,32,36,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72E;" Style="{StaticResource ChipGlyphStyle}"/>
                <TextBlock Text="OFFLINE · SECURE" Style="{StaticResource ChipTextStyle}"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             SIDE CAPABILITY RAILS
             The stage previously had one centred column with large empty
             margins left and right. These rails use that space to say what
             the product actually does, which is what a professional splash
             is for. Purely decorative: IsHitTestVisible=False everywhere so
             they can never intercept a click meant for the terms gate.
        ═══════════════════════════════════════════════════════════ -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="56,0,0,0" Width="230"
                    IsHitTestVisible="False">
            <TextBlock Text="MODULES"
                       FontSize="10" FontWeight="Bold"
                       Opacity="0.55"
                       Foreground="{StaticResource Azure}"
                       Margin="2,0,0,14"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets"
                           FontSize="15" Foreground="{StaticResource Azure}"
                           Opacity="0.75" VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <TextBlock Text="Proforma Invoicing" FontSize="12.5"
                           Foreground="{StaticResource Frost}" Opacity="0.85"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets"
                           FontSize="15" Foreground="{StaticResource Azure}"
                           Opacity="0.75" VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <TextBlock Text="Job Orders &amp; Production" FontSize="12.5"
                           Foreground="{StaticResource Frost}" Opacity="0.85"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets"
                           FontSize="15" Foreground="{StaticResource Azure}"
                           Opacity="0.75" VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <TextBlock Text="Delivery Notes" FontSize="12.5"
                           Foreground="{StaticResource Frost}" Opacity="0.85"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets"
                           FontSize="15" Foreground="{StaticResource Azure}"
                           Opacity="0.75" VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <TextBlock Text="VAT Tax Invoices" FontSize="12.5"
                           Foreground="{StaticResource Frost}" Opacity="0.85"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                           FontSize="15" Foreground="{StaticResource Azure}"
                           Opacity="0.75" VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <TextBlock Text="Profit &amp; Loss Analysis" FontSize="12.5"
                           Foreground="{StaticResource Frost}" Opacity="0.85"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,56,0" Width="230"
                    IsHitTestVisible="False">
            <TextBlock Text="BUILT FOR"
                       FontSize="10" FontWeight="Bold"
                       Opacity="0.55"
                       HorizontalAlignment="Right"
                       Foreground="{StaticResource Azure}"
                       Margin="0,0,2,14"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,13">
                <TextBlock Text="Works Fully Offline" FontSize="12.5"
                           Foreground="{StaticResource Frost}" Opacity="0.85"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets"
                           FontSize="15" Foreground="{StaticResource Azure}"
                           Opacity="0.75" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,13">
                <TextBlock Text="FTA 5% VAT Ready" FontSize="12.5"
                           Foreground="{StaticResource Frost}" Opacity="0.85"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                           FontSize="15" Foreground="{StaticResource Azure}"
                           Opacity="0.75" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,13">
                <TextBlock Text="Data Stays On Your PC" FontSize="12.5"
                           Foreground="{StaticResource Frost}" Opacity="0.85"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                           FontSize="15" Foreground="{StaticResource Azure}"
                           Opacity="0.75" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,13">
                <TextBlock Text="Full Audit Trail" FontSize="12.5"
                           Foreground="{StaticResource Frost}" Opacity="0.85"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets"
                           FontSize="15" Foreground="{StaticResource Azure}"
                           Opacity="0.75" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Automatic Backups" FontSize="12.5"
                           Foreground="{StaticResource Frost}" Opacity="0.85"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="&#xE8F7;" FontFamily="Segoe MDL2 Assets"
                           FontSize="15" Foreground="{StaticResource Azure}"
                           Opacity="0.75" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- ═══ CENTER STAGE ═══ -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- App icon with halo + shimmer -->
            <Border x:Name="LogoBorder" Width="220" Height="220"
                    HorizontalAlignment="Center"
                    IsHitTestVisible="False">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="LogoScale" ScaleX="0" ScaleY="0"/>
                </Border.RenderTransform>
                <Grid>
                    <Ellipse Width="220" Height="220"
                             Fill="{StaticResource IconHalo}"
                             IsHitTestVisible="False"/>
                    <!-- The app icon is a blue glass pane on a blue field, so
                         on the deep-navy stage it was blue-on-blue and read as
                         a dark smudge. A frosted light plate sits behind it to
                         give the icon a surface to contrast against, matching
                         the bluish-glass identity rather than fighting it. -->
                    <Border Width="164" Height="164"
                            CornerRadius="38"
                            Effect="{StaticResource IconShadow}"
                            SnapsToDevicePixels="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F2FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#D9E8F2FF" Offset="0.55"/>
                                <GradientStop Color="#BFD3E8FF" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Border Width="150" Height="150"
                                CornerRadius="34"
                                BorderBrush="#66FFFFFF"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Resources/proglass_icon_256.png"
                                        Stretch="UniformToFill"/>
                        </Border.Background>
                        <!-- Shimmer sweep clipped to the icon -->
                        <Border CornerRadius="34" ClipToBounds="True">
                            <Border x:Name="ShimmerOverlay"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FFFFFF00" Offset="0.0"/>
                                        <GradientStop Color="#FFFFFF4D" Offset="0.5"/>
                                        <GradientStop Color="#FFFFFF00" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ShimmerTranslate" X="-200"/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        </Border>
                    </Border>
                </Grid>
            </Border>

            <!-- Brand name -->
            <TextBlock x:Name="AppNameText"
                       Text="ProGlass Automation"
                       FontSize="46"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,26,0,0"
                       Foreground="{StaticResource NameGradient}"
                       Opacity="0"
                       IsHitTestVisible="False">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="AppNameTranslate" Y="20"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <TextBlock x:Name="TaglineText"
                       Text="Industrial ERP for Glass Production Workflow"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"
                       Foreground="{StaticResource Cerulean}"
                       Opacity="0"
                       IsHitTestVisible="False"/>

            <!-- Feature glyph strip -->
            <ItemsControl x:Name="FeaturePanel"
                          ItemTemplate="{StaticResource FeatureBadgeTemplate}"
                          HorizontalAlignment="Center"
                          Margin="0,34,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Progress -->
            <Grid Width="420" Margin="0,36,0,0">
                <Border Height="4" CornerRadius="2"
                        Background="#1FFFFFFF"
                        SnapsToDevicePixels="True"/>
                <Border x:Name="ProgressFill"
                        Height="4" Width="0"
                        HorizontalAlignment="Left"
                        CornerRadius="2"
                        Background="{StaticResource ProgressGradient}"
                        SnapsToDevicePixels="True"/>
            </Grid>

            <StackPanel x:Name="LoadingStrip"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,0">
                <TextBlock x:Name="LoadingText"
                           Text="Starting engines"
                           FontSize="11"
                           Foreground="{StaticResource Frost}"
                           IsHitTestVisible="False"/>
                <TextBlock x:Name="LoadingDots"
                           Text=""
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{StaticResource Azure}"
                           IsHitTestVisible="False"/>
            </StackPanel>

        </StackPanel>

        <!-- ═══════════════════════════════════════════════════════════
             TERMS GATE — FULL PAGE
             A sibling of the centre stage, not a child of it, so it can
             occupy the entire window. Terms are long-form legal text: a
             cramped 620px box made them unreadable, and a user who cannot
             comfortably read them cannot meaningfully accept them.
             Sits above the stage with a scrim so the branding stays
             visible behind but recedes.
        ═══════════════════════════════════════════════════════════ -->
        <Grid x:Name="TermsPanel"
              Background="#E60A1428"
              Visibility="Collapsed"
              Opacity="0"
              Panel.ZIndex="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        Margin="0,46,0,0">
                <TextBlock Text="TERMS OF USE"
                           FontSize="26" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="White"/>
                <TextBlock Text="United Arab Emirates · Please read before continuing"
                           FontSize="12.5"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"
                           Foreground="{StaticResource Frost}"/>
                <Rectangle Height="1" Width="360" Margin="0,18,0,0"
                           Opacity="0.25" Fill="{StaticResource Azure}"/>
            </StackPanel>

            <!-- Body: readable measure, generous line height -->
            <Border Grid.Row="1"
                    MaxWidth="980"
                    Margin="60,26,60,10"
                    Padding="42,34"
                    CornerRadius="18"
                    Background="#14FFFFFF"
                    BorderBrush="#2EFFFFFF"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <TextBlock Foreground="{StaticResource Frost}"
                               FontSize="13.5"
                               LineHeight="25"
                               TextWrapping="Wrap">
                        <Run Text="1. Tax compliance is yours, not the software's." FontWeight="Bold" Foreground="White"/>
                        <LineBreak/>
                        <Run Text="This software assists with preparing tax invoices and records. Federal Decree-Law No. 8 of 2017 on Value Added Tax and Federal Decree-Law No. 28 of 2022 on Tax Procedures place the obligation to issue correct tax invoices, apply the correct VAT treatment, and retain records for the periods required by the Federal Tax Authority on YOU, the taxable person. You must verify every figure before issuing, filing or relying on it."/>
                        <LineBreak/><LineBreak/>
                        <Run Text="2. Record retention." FontWeight="Bold" Foreground="White"/>
                        <LineBreak/>
                        <Run Text="UAE tax law requires accounting records and tax invoices to be retained for the statutory period — generally five years, and longer for real-estate records. All data is stored locally on this computer only. Maintaining backups sufficient to meet that obligation is your responsibility."/>
                        <LineBreak/><LineBreak/>
                        <Run Text="3. Electronic records and signatures." FontWeight="Bold" Foreground="White"/>
                        <LineBreak/>
                        <Run Text="Federal Decree-Law No. 46 of 2021 on Electronic Transactions and Trust Services governs electronic records in the UAE. Documents produced here are electronic records; you are responsible for their integrity, storage, and any signature requirements applicable to your business."/>
                        <LineBreak/><LineBreak/>
                        <Run Text="4. Personal data protection." FontWeight="Bold" Foreground="White"/>
                        <LineBreak/>
                        <Run Text="Federal Decree-Law No. 45 of 2021 on the Protection of Personal Data applies to personal data you enter, such as customer and contact details. You act as the data controller. If you enable the optional AI assistant with real business data, customer names, project names and amounts are transmitted to a third-party AI provider outside this device. That feature is optional and can be switched off at any time in Settings."/>
                        <LineBreak/><LineBreak/>
                        <Run Text="5. Intellectual property and licence." FontWeight="Bold" Foreground="White"/>
                        <LineBreak/>
                        <Run Text="You are granted a non-transferable licence to use this software for your business. The software, its design and its source remain the property of the author. You may not resell, sublicense, or redistribute it."/>
                        <LineBreak/><LineBreak/>
                        <Run Text="6. Acceptable use." FontWeight="Bold" Foreground="White"/>
                        <LineBreak/>
                        <Run Text="You agree not to use this software to produce false, misleading or fraudulent invoices or records, or for any purpose unlawful under UAE federal or emirate law."/>
                        <LineBreak/><LineBreak/>
                        <Run Text="7. No warranty and limitation of liability." FontWeight="Bold" Foreground="White"/>
                        <LineBreak/>
                        <Run Text="The software is provided 'as is', without warranty of any kind, express or implied. Pricing, costing, VAT and profit calculations are aids, not professional advice. To the maximum extent permitted by law, no liability is accepted for any direct, indirect or consequential loss arising from use of, or reliance on, its output. Consult a qualified tax adviser regarding your obligations."/>
                        <LineBreak/><LineBreak/>
                        <Run Text="8. Updates." FontWeight="Bold" Foreground="White"/>
                        <LineBreak/>
                        <Run Text="Updates may be offered from time to time. Installing them is your choice; continuing to use an outdated version may affect compliance with changing tax rules."/>
                        <LineBreak/><LineBreak/>
                        <Run Text="9. Governing law." FontWeight="Bold" Foreground="White"/>
                        <LineBreak/>
                        <Run Text="These terms are governed by the laws of the United Arab Emirates and of the Emirate in which you operate. Disputes are subject to the competent UAE courts."/>
                    </TextBlock>
                </ScrollViewer>
            </Border>

            <!-- Accept bar -->
            <Border CornerRadius="{DynamicResource CardCornerRadius}" Grid.Row="2"
                    Background="#1AFFFFFF"
                    BorderBrush="#26FFFFFF"
                    BorderThickness="0,1,0,0"
                    Padding="60,20">
                <Grid MaxWidth="980">
                    <CheckBox x:Name="AcceptTermsCheck"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource Frost}"
                              FontSize="12.5"
                              Cursor="Hand"
                              Checked="AcceptTerms_Changed"
                              Unchecked="AcceptTerms_Changed">
                        <TextBlock Text="I have read and accept these terms, and I accept responsibility for the accuracy of the records I produce."
                                   TextWrapping="Wrap"
                                   MaxWidth="620"/>
                    </CheckBox>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="DeclineButton"
                                Content="DECLINE AND EXIT"
                                Width="170" Height="42"
                                Margin="0,0,12,0"
                                FontSize="11"
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}"
                                Foreground="{StaticResource Frost}"
                                Background="Transparent"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1"
                                Click="DeclineTerms_Click"/>
                        <Button x:Name="ContinueButton"
                                Content="ACCEPT AND CONTINUE"
                                Width="220" Height="42"
                                FontSize="12" FontWeight="Bold"
                                Cursor="Hand"
                                IsEnabled="False"
                                FocusVisualStyle="{x:Null}"
                                Foreground="White"
                                Background="{StaticResource Royal}"
                                BorderThickness="0"
                                Click="ContinueFromTerms_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ FOOTER ═══ -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="0,0,0,34">
            <TextBlock FontSize="11"
                       Foreground="{StaticResource Cerulean}"
                       IsHitTestVisible="False">
                <Run Text="Developed by"/>
                <Run Text=" Juber Saleem" FontWeight="Bold"/>
            </TextBlock>
            <TextBlock FontSize="10"
                       Margin="0,4,0,0"
                       Foreground="#8093C5FD"
                       IsHitTestVisible="False">
                <Run Text="© 2026 ProGlass Automation · Sharjah, UAE"/>
            </TextBlock>
        </StackPanel>

    </Grid>
</Window>
