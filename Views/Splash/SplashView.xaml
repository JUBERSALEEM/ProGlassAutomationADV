<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Splash/SplashView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Splash Screen — "GLASS PRISM OPTICAL BEVEL" (v7 Full Rewrite)
            Sophisticated soft light grey background (#E2E8F0).
            Thick architectural float glass plate with 3D optical bevels,
            multi-faceted refractive keylines reflecting subtle chromatic
            light dispersions, clean dark slate typography
            "ProGlass Precision Automation", and a crisp progress track.

     100% PURE WPF XAML ARCHITECTURE:
       • Float Glass Plate: Layered bevelled glass chassis with specular
         rim, refractive prism facets, and optical dispersion hairlines.
       • Prism Emblem: Geometric faceted glass cutter diamond in dark
         slate (#0F172A) and sapphire glass (#2563EB).
       • Typography: Crisp Swiss dark slate hierarchy with letter-spaced
         subtitle and version token.
       • Progress Indicator: Razor-thin 1px circular arc and linear
         precision progress track with GPU hardware acceleration.
       • Full API Compatibility: Preserves all code-behind hooks,
         animation targets, TermsBar, and Login/Setup gates.
═══════════════════════════════════════════════════════════════════ -->
<Window x:Class="ProGlassAutomation.Views.Splash.SplashView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:updates="clr-namespace:ProGlassAutomation.Services.Updates"
        xmlns:login="clr-namespace:ProGlassAutomation.Views.Login"
        xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
        Title="{DynamicResource Shell.AppTitle}"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#E2E8F0"
        ShowInTaskbar="False"
        Topmost="True"
        behaviors:ViewportFitBehavior.DisableZoom="True"
        FontFamily="{DynamicResource AppFontFamily}"
        FontWeight="{DynamicResource AppFontWeight}"
        FontStyle="{DynamicResource AppFontStyle}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- ═══ LUXURY GLASS PRISM PALETTE ═══ -->
        <SolidColorBrush x:Key="SplashBg" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="DarkSlateBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="SlateTextBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="MutedSlateBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="TrackBaseBrush" Color="#CBD5E1"/>

        <!-- 3D Optical Bevel Edge Brushes -->
        <LinearGradientBrush x:Key="GlassBevelRimBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
            <GradientStop Color="#E2E8F0" Offset="0.35"/>
            <GradientStop Color="#CBD5E1" Offset="0.7"/>
            <GradientStop Color="#94A3B8" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassPlateFaceBrush" StartPoint="0.1,0.0" EndPoint="0.9,1.0">
            <GradientStop Color="#F8FAFC" Offset="0.0"/>
            <GradientStop Color="#F1F5F9" Offset="0.45"/>
            <GradientStop Color="#E2E8F0" Offset="0.85"/>
            <GradientStop Color="#DFE6EE" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Chromatic Prism Dispersion Highlights -->
        <LinearGradientBrush x:Key="PrismDispersionBrush" StartPoint="0,0" EndPoint="1,0.8">
            <GradientStop Color="#3038BDF8" Offset="0.0"/>
            <GradientStop Color="#256366F1" Offset="0.35"/>
            <GradientStop Color="#20F43F5E" Offset="0.65"/>
            <GradientStop Color="#2010B981" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Ambient Refractive Light Caustics (replacing old heavy blobs) -->
        <LinearGradientBrush x:Key="Blob1Grad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F1F5F9" Offset="0.0"/>
            <GradientStop Color="#E2E8F0" Offset="0.6"/>
            <GradientStop Color="#CBD5E1" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="Blob2Grad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E0F2FE" Offset="0.0"/>
            <GradientStop Color="#EDE9FE" Offset="0.5"/>
            <GradientStop Color="#F1F5F9" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="Blob3Grad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F8FAFC" Offset="0.0"/>
            <GradientStop Color="#E2E8F0" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Droplet Crystal Facet Brush -->
        <RadialGradientBrush x:Key="DropletFill" GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
            <GradientStop Color="#CCF1F5F9" Offset="0.4"/>
            <GradientStop Color="#99CBD5E1" Offset="1.0"/>
        </RadialGradientBrush>

        <!-- Core Precision Progress Gradient -->
        <LinearGradientBrush x:Key="ProgressGrad" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0F172A" Offset="0.0"/>
            <GradientStop Color="#4338CA" Offset="0.5"/>
            <GradientStop Color="#0EA5E9" Offset="1.0"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="PlateShadow" Color="#0F172A" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.10" RenderingBias="Performance"/>
        <DropShadowEffect x:Key="DropletShadow" Color="#64748B" BlurRadius="6" ShadowDepth="2" Direction="270" Opacity="0.14" RenderingBias="Performance"/>
        <DropShadowEffect x:Key="BevelGlow" Color="#38BDF8" BlurRadius="12" ShadowDepth="0" Opacity="0.18" RenderingBias="Performance"/>

        <!-- Rounded Hexagon Clip for Optical Glass Core -->
        <PathGeometry x:Key="RoundedHexClip">
            <PathFigure StartPoint="138.00,24.93" IsClosed="True">
                <ArcSegment Point="162.00,24.93" Size="24,24" RotationAngle="0" IsLargeArc="False" SweepDirection="Clockwise"/>
                <LineSegment Point="252.32,77.07"/>
                <ArcSegment Point="264.32,97.86" Size="24,24" RotationAngle="0" IsLargeArc="False" SweepDirection="Clockwise"/>
                <LineSegment Point="264.32,202.14"/>
                <ArcSegment Point="252.32,222.93" Size="24,24" RotationAngle="0" IsLargeArc="False" SweepDirection="Clockwise"/>
                <LineSegment Point="162.00,275.07"/>
                <ArcSegment Point="138.00,275.07" Size="24,24" RotationAngle="0" IsLargeArc="False" SweepDirection="Clockwise"/>
                <LineSegment Point="47.68,222.93"/>
                <ArcSegment Point="35.68,202.14" Size="24,24" RotationAngle="0" IsLargeArc="False" SweepDirection="Clockwise"/>
                <LineSegment Point="35.68,97.86"/>
                <ArcSegment Point="47.68,77.07" Size="24,24" RotationAngle="0" IsLargeArc="False" SweepDirection="Clockwise"/>
                <LineSegment Point="138.00,24.93"/>
            </PathFigure>
        </PathGeometry>

        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style x:Key="TermsLead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="TermsBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="LineHeight" Value="24"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource SplashBg}">

        <!-- ═══ AMBIENT OPTICAL LIGHT GLINTS & REFRACTION ═══ -->
        <Canvas IsHitTestVisible="False">
            <Ellipse x:Name="BgBlob1" Width="520" Height="400" Fill="{StaticResource Blob1Grad}" Opacity="0.25" Canvas.Left="-120" Canvas.Top="-80">
                <Ellipse.Effect><BlurEffect Radius="24" KernelType="Box" RenderingBias="Performance"/></Ellipse.Effect>
                <Ellipse.RenderTransform><TranslateTransform x:Name="BgBlob1Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="BgBlob2" Width="640" Height="480" Fill="{StaticResource Blob2Grad}" Opacity="0.20" Canvas.Left="-160" Canvas.Top="460">
                <Ellipse.Effect><BlurEffect Radius="24" KernelType="Box" RenderingBias="Performance"/></Ellipse.Effect>
                <Ellipse.RenderTransform><TranslateTransform x:Name="BgBlob2Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="BgBlob3" Width="480" Height="360" Fill="{StaticResource Blob3Grad}" Opacity="0.22" Canvas.Left="920" Canvas.Top="500">
                <Ellipse.Effect><BlurEffect Radius="24" KernelType="Box" RenderingBias="Performance"/></Ellipse.Effect>
                <Ellipse.RenderTransform><TranslateTransform x:Name="BgBlob3Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="BgBlob4" Width="240" Height="240" Fill="#20CBD5E1" Opacity="0.25" Canvas.Left="1100" Canvas.Top="-30">
                <Ellipse.Effect><BlurEffect Radius="20" KernelType="Box" RenderingBias="Performance"/></Ellipse.Effect>
                <Ellipse.RenderTransform><TranslateTransform x:Name="BgBlob4Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>

            <!-- Subtle Crystal Specks / Optical Glints -->
            <Ellipse x:Name="Droplet1" Width="36" Height="36" Fill="{StaticResource DropletFill}" Stroke="#FFFFFF" StrokeThickness="1" Effect="{StaticResource DropletShadow}" Canvas.Left="0" Canvas.Top="0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Droplet1Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Droplet2" Width="24" Height="24" Fill="{StaticResource DropletFill}" Stroke="#FFFFFF" StrokeThickness="1" Effect="{StaticResource DropletShadow}" Canvas.Left="0" Canvas.Top="0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Droplet2Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Droplet3" Width="20" Height="20" Fill="{StaticResource DropletFill}" Stroke="#FFFFFF" StrokeThickness="0.8" Effect="{StaticResource DropletShadow}" Canvas.Left="0" Canvas.Top="0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Droplet3Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Droplet4" Width="18" Height="18" Fill="{StaticResource DropletFill}" Stroke="#FFFFFF" StrokeThickness="0.8" Effect="{StaticResource DropletShadow}" Canvas.Left="0" Canvas.Top="0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Droplet4Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Droplet5" Width="26" Height="22" Fill="{StaticResource DropletFill}" Stroke="#FFFFFF" StrokeThickness="1" Effect="{StaticResource DropletShadow}" Canvas.Left="0" Canvas.Top="0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Droplet5Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Droplet6" Width="22" Height="18" Fill="{StaticResource DropletFill}" Stroke="#FFFFFF" StrokeThickness="0.8" Effect="{StaticResource DropletShadow}" Canvas.Left="0" Canvas.Top="0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Droplet6Translate" X="0" Y="0"/></Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <!-- ═══ MAIN STAGE — THICK ARCHITECTURAL FLOAT GLASS PLATE ═══ -->
        <Grid x:Name="PosterHost" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- The Glass Prism Stage Assembly -->
                <Grid Width="500" Height="340" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <!-- Outer 3D Optical Bevel Shadow Plate -->
                    <Border CornerRadius="28" Background="#080F172A" Margin="-8" Effect="{StaticResource PlateShadow}"/>

                    <!-- Fluid Prism Aura Layer (preserved API element) -->
                    <Path x:Name="FluidBlob" Opacity="0.4" Fill="{StaticResource PrismDispersionBrush}" Stretch="Fill"
                          Data="M 40,0 L 460,0 C 480,0 500,20 500,40 L 500,300 C 500,320 480,340 460,340 L 40,340 C 20,340 0,320 0,300 L 0,40 C 0,20 20,0 40,0 Z">
                        <Path.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="FluidBlobScale" ScaleX="1" ScaleY="1" CenterX="250" CenterY="170"/>
                                <TranslateTransform x:Name="FluidBlobTranslate" X="0" Y="0"/>
                            </TransformGroup>
                        </Path.RenderTransform>
                    </Path>

                    <!-- Hidden highlight and edge paths for API compatibility -->
                    <Path x:Name="FluidHighlight" Opacity="0.1" Fill="#FFFFFFFF" Stretch="Fill"
                          Data="M 0,0 L 500,0 L 500,10 L 0,10 Z" Visibility="Collapsed"/>
                    <Path x:Name="FluidEdge" Opacity="0.6" Stroke="{StaticResource GlassBevelRimBrush}" StrokeThickness="1"
                          Data="M 0,0 L 500,0" Visibility="Collapsed"/>

                    <!-- Architectural Float Glass Plate (Core Container) -->
                    <Border x:Name="LogoBorder" Width="480" Height="320" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{StaticResource GlassPlateFaceBrush}"
                            BorderBrush="{StaticResource GlassBevelRimBrush}"
                            BorderThickness="2"
                            CornerRadius="24"
                            Effect="{StaticResource PlateShadow}"
                            Opacity="0">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="LogoScale" ScaleX="0.92" ScaleY="0.92" CenterX="240" CenterY="160"/>
                        </Border.RenderTransform>

                        <Grid>
                            <!-- Inner 3D Optical Bevel Recess Line -->
                            <Border CornerRadius="22" Margin="3" BorderBrush="#80FFFFFF" BorderThickness="1.5" IsHitTestVisible="False"/>

                            <!-- Subtle Spectral Dispersion Line across the glass facet -->
                            <Border CornerRadius="20" Margin="10" BorderBrush="{StaticResource PrismDispersionBrush}" BorderThickness="1" IsHitTestVisible="False"/>

                            <!-- Center Prism Content Assembly -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                <!-- Geometric Precision Glass Diamond Prism Emblem -->
                                <Grid Width="88" Height="88" HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <!-- Beveled Outer Diamond -->
                                    <Border Width="84" Height="84" CornerRadius="22" Background="#F8FAFC"
                                            BorderBrush="{StaticResource GlassBevelRimBrush}" BorderThickness="2"
                                            Effect="{StaticResource PlateShadow}">
                                        <Grid>
                                            <!-- Diamond Facet Grid Lines -->
                                            <Path Stroke="#CBD5E1" StrokeThickness="1"
                                                  Data="M 42,6 L 78,42 L 42,78 L 6,42 Z"/>
                                            <Path Stroke="{StaticResource PrismDispersionBrush}" StrokeThickness="1.5"
                                                  Data="M 22,22 L 62,62 M 62,22 L 22,62"/>
                                            <!-- Core Monogram -->
                                            <TextBlock Text="PG" FontWeight="Bold" FontSize="30" FontFamily="{DynamicResource AppFontFamily}"
                                                       Foreground="{StaticResource DarkSlateBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,0,0,2"/>
                                            <!-- Optical Glass Cut Sparkle -->
                                            <Ellipse Width="6" Height="6" Fill="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Title: ProGlass Precision Automation -->
                                <TextBlock FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" FontFamily="{DynamicResource AppFontFamily}">
                                    <Run Text="ProGlass" Foreground="{StaticResource DarkSlateBrush}"/>
                                    <Run Text=" Precision Automation" Foreground="#334155" FontWeight="SemiBold"/>
                                </TextBlock>

                                <!-- Architectural Glass Subtitle -->
                                <TextBlock Text="ARCHITECTURAL FLOAT GLASS &amp; CNC ENGINEERING SUITE"
                                           FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource MutedSlateBrush}"
                                           HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center"/>

                                <!-- Crisp Precision 1px Progress Track -->
                                <Grid x:Name="ProgressTrack" Width="260" Height="20" HorizontalAlignment="Center" Margin="0,22,0,0" Opacity="0">
                                    <!-- Track Bed -->
                                    <Border Height="3" CornerRadius="1.5" Background="{StaticResource TrackBaseBrush}" VerticalAlignment="Center"/>
                                    <!-- Progress Fill (Razor-thin 3px Precision Indeterminate Meter) -->
                                    <ProgressBar IsIndeterminate="True" Height="3" Width="260"
                                                 Foreground="{StaticResource ProgressGrad}" Background="Transparent"
                                                 BorderThickness="0" VerticalAlignment="Center"/>
                                    <!-- Circular Arc Spinner for compatibility -->
                                    <Path x:Name="ProgressFill" Stroke="{StaticResource ProgressGrad}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 10,2 A 8,8 0 1 1 9.9,2" Visibility="Collapsed">
                                        <Path.RenderTransform><RotateTransform x:Name="ProgressRotate" Angle="0" CenterX="10" CenterY="10"/></Path.RenderTransform>
                                    </Path>
                                </Grid>

                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Hidden AppNameText for 100% code-behind animation binding safety -->
                <TextBlock x:Name="AppNameText" FontSize="1" Height="0" Opacity="0" Visibility="Hidden">
                    <TextBlock.RenderTransform><TranslateTransform x:Name="AppNameTranslate" Y="0"/></TextBlock.RenderTransform>
                </TextBlock>

            </StackPanel>
        </Grid>

        <!-- ═══ LUXURY FOOTER CAPTIONS ═══ -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,32" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Tricolor Accent Bar -->
                <Border Width="3" Height="14" CornerRadius="1" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF9933" Offset="0.0"/>
                            <GradientStop Color="#FFFFFF" Offset="0.5"/>
                            <GradientStop Color="#138808" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <TextBlock x:Name="CaptionMadeIn" Text="MADE IN INDIA" Style="{StaticResource CaptionStyle}" Opacity="0"/>
            </StackPanel>
            <TextBlock x:Name="CaptionEnterprise" Opacity="0" Visibility="Collapsed" Text="ENTERPRISE"/>
            <TextBlock x:Name="CaptionSecure" Opacity="0" Visibility="Collapsed" Text="OFFLINE · SECURE"/>
        </StackPanel>

        <!-- ═══ AUTHENTICATION & TERMS GATES ═══ -->
        <Grid x:Name="LoginHost" Visibility="Collapsed" Opacity="0" Panel.ZIndex="11">
            <login:LoginPanel x:Name="LoginGate"/>
        </Grid>

        <Grid x:Name="SetupHost" Visibility="Collapsed" Opacity="0" Panel.ZIndex="12">
            <login:FirstRunSetupPanel x:Name="SetupGate"/>
        </Grid>

        <Grid x:Name="TermsPanel" Background="Transparent" Visibility="Collapsed" Opacity="0" Panel.ZIndex="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,52,0,0">
                <TextBlock Text="{DynamicResource Splash.TermsTitle}" FontSize="34" FontWeight="{DynamicResource Weight.Bold}" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryForegroundBrush}">
                    <TextBlock.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.35"/></TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="{DynamicResource Splash.UaeIntro}" FontSize="{DynamicResource FontSize.Title}" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Rectangle Height="2" Width="48" Margin="0,18,0,0" RadiusX="1" RadiusY="1" HorizontalAlignment="Center" Fill="{DynamicResource AccentBrush}"/>
            </StackPanel>
            <Border Grid.Row="1" MaxWidth="860" Margin="48,26,48,16" Padding="40,32" CornerRadius="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}" Background="#CCFFFFFF">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,20"><TextBlock Style="{StaticResource TermsLead}" Text="{DynamicResource Splash.Term1}"/><TextBlock Style="{StaticResource TermsBody}" Text="{DynamicResource Splash.SoftwareAssistsPreparingTaxInvoicesRecords}"/></StackPanel>
                        <StackPanel Margin="0,0,0,20"><TextBlock Style="{StaticResource TermsLead}" Text="{DynamicResource Splash.Term2}"/><TextBlock Style="{StaticResource TermsBody}" Text="{DynamicResource Splash.UAETaxLawRequiresAccountingRecordsTax}"/></StackPanel>
                        <StackPanel Margin="0,0,0,20"><TextBlock Style="{StaticResource TermsLead}" Text="{DynamicResource Splash.Term3}"/><TextBlock Style="{StaticResource TermsBody}" Text="{DynamicResource Splash.FederalDecreeLawNo462021Electronic}"/></StackPanel>
                        <StackPanel Margin="0,0,0,20"><TextBlock Style="{StaticResource TermsLead}" Text="{DynamicResource Splash.Term4}"/><TextBlock Style="{StaticResource TermsBody}" Text="{DynamicResource Splash.FederalDecreeLawNo452021ProtectionPersonal}"/></StackPanel>
                        <StackPanel Margin="0,0,0,20"><TextBlock Style="{StaticResource TermsLead}" Text="{DynamicResource Splash.Term5}"/><TextBlock Style="{StaticResource TermsBody}" Text="{DynamicResource Splash.GrantedNonTransferableLicenceUseSoftware}"/></StackPanel>
                        <StackPanel Margin="0,0,0,20"><TextBlock Style="{StaticResource TermsLead}" Text="{DynamicResource Splash.Term6}"/><TextBlock Style="{StaticResource TermsBody}" Text="{DynamicResource Splash.AgreeUseSoftwareProduceFalseMisleading}"/></StackPanel>
                        <StackPanel Margin="0,0,0,20"><TextBlock Style="{StaticResource TermsLead}" Text="{DynamicResource Splash.Term7}"/><TextBlock Style="{StaticResource TermsBody}" Text="{DynamicResource Splash.SoftwareProvidedWithoutWarrantyKindExpress}"/></StackPanel>
                        <StackPanel Margin="0,0,0,20"><TextBlock Style="{StaticResource TermsLead}" Text="{DynamicResource Splash.Term8}"/><TextBlock Style="{StaticResource TermsBody}" Text="{DynamicResource Splash.UpdatesMayOfferedTimeTimeInstallingChoice}"/></StackPanel>
                        <StackPanel><TextBlock Style="{StaticResource TermsLead}" Text="{DynamicResource Splash.Term9}"/><TextBlock Style="{StaticResource TermsBody}" Text="{DynamicResource Splash.TermsGovernedLawsUnitedArabEmiratesEmirate}"/></StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border x:Name="TermsBar" Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="#CCFFFFFF" Padding="48,18">
                <DockPanel LastChildFill="True" MaxWidth="860">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,8,0,0">
                        <Button x:Name="DeclineButton" Content="{DynamicResource Splash.DeclineExit}" MinWidth="150" Height="44" Margin="0,0,12,0" Style="{StaticResource Button.Secondary}" Command="{Binding DeclineCommand}"/>
                        <Button x:Name="ContinueButton" Content="{DynamicResource Splash.AcceptContinue}" MinWidth="190" Height="44" IsEnabled="{Binding IsContinueEnabled}" Style="{StaticResource Button.Primary}" Command="{Binding ContinueCommand}"/>
                    </StackPanel>
                    <CheckBox x:Name="AcceptTermsCheck" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSize.Title}" Cursor="Hand" Margin="0,8,0,0" IsChecked="{Binding AcceptTerms, Mode=TwoWay}">
                        <TextBlock Text="{DynamicResource Splash.AcceptText}" TextWrapping="Wrap"/>
                    </CheckBox>
                </DockPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
