<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Splash/SplashView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Splash Screen — 100% Faithful Architectural Rebuild
     
     FAITHFUL TO APPROVED MOCKUP (docs/splash_redesign_dark.png):
       • Cinematic deep-navy atmospheric canvas with luminous cyan orbs
       • Network constellation nodes and fine vector telemetry lines
       • Central floating beveled glass shield with tilted dashed orbit ring
       • Luminous cyan hexagon enclosing dark PGA monogram
       • Brand wordmark: "ProGlass" (pure white) + "Automation" (vivid cyan)
       • Centered subtitle: "── MODERN GLASS FABRICATION ERP ──"
       • Complete 16-card grid (2 rows of 8 frosted glass cards) with
         vibrant cyan-teal squircles and clean white typography
       • Wide glowing cyan pill progress bar with seamless progress fill
       • Dedicated non-overlapping loading status line
       • Zero regressions: all public methods, flags, and login/terms gates preserved
═══════════════════════════════════════════════════════════════════ -->
<Window x:Class="ProGlassAutomation.Views.Splash.SplashView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:updates="clr-namespace:ProGlassAutomation.Services.Updates"
        xmlns:login="clr-namespace:ProGlassAutomation.Views.Login"
        xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
        Title="{DynamicResource Shell.AppTitle}"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#060C18"
        ShowInTaskbar="False"
        Topmost="True"
        behaviors:ViewportFitBehavior.DisableZoom="True"
        FontFamily="{DynamicResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Corner Tokens -->
        <CornerRadius x:Key="SplashCorner">10</CornerRadius>
        <CornerRadius x:Key="SplashCornerLarge">16</CornerRadius>
        <CornerRadius x:Key="TileCorner">16</CornerRadius>

        <!-- Mockup Accurate Palette -->
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#00E5FF"/>
        <SolidColorBrush x:Key="AccentTeal" Color="#00D2EE"/>
        <SolidColorBrush x:Key="DarkNavyBg" Color="#060C18"/>

        <!-- Required backward-compatibility aliases -->
        <SolidColorBrush x:Key="SplashCerulean" Color="#00E5FF"/>
        <SolidColorBrush x:Key="SplashCeruleanLite" Color="#7DD3FC"/>
        <SolidColorBrush x:Key="SplashCeruleanDark" Color="#0284C7"/>
        <SolidColorBrush x:Key="SplashOutline" Color="#1E293B"/>
        <SolidColorBrush x:Key="SplashPillBg" Color="#111827"/>
        <SolidColorBrush x:Key="SplashTrackBg" Color="#1E293B"/>
        <SolidColorBrush x:Key="SplashTextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="SplashTextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="SplashOnAccent" Color="#000000"/>

        <!-- Deep Cinematic Stage Gradient -->
        <LinearGradientBrush x:Key="GlassStageGradient" StartPoint="0.1,0" EndPoint="0.9,1">
            <GradientStop Color="#050B16" Offset="0.0"/>
            <GradientStop Color="#071020" Offset="0.5"/>
            <GradientStop Color="#050914" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Specular Chamfered Bevel Border -->
        <LinearGradientBrush x:Key="SpecularBevelBorder" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#66FFFFFF" Offset="0.0"/>
            <GradientStop Color="#3300E5FF" Offset="0.3"/>
            <GradientStop Color="#10FFFFFF" Offset="0.7"/>
            <GradientStop Color="#4400E5FF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Specular Tile Sheen Highlight -->
        <LinearGradientBrush x:Key="TileSpecularSheen" StartPoint="0,0" EndPoint="0.6,0.8">
            <GradientStop Color="#35FFFFFF" Offset="0.0"/>
            <GradientStop Color="#10FFFFFF" Offset="0.35"/>
            <GradientStop Color="#00FFFFFF" Offset="0.7"/>
        </LinearGradientBrush>

        <!-- Frosted Tile Base Fill -->
        <LinearGradientBrush x:Key="TileFrostedBg" StartPoint="0,0" EndPoint="0.5,1">
            <GradientStop Color="#281C2B3F" Offset="0.0"/>
            <GradientStop Color="#1F132032" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Neon Progress Bar Gradient Fill -->
        <LinearGradientBrush x:Key="LuminousProgressGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00B4D8" Offset="0.0"/>
            <GradientStop Color="#00E5FF" Offset="0.5"/>
            <GradientStop Color="#38BDF8" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Glow DropShadows -->
        <DropShadowEffect x:Key="NeonCyanGlow" Color="#00E5FF" BlurRadius="35" ShadowDepth="0" Opacity="0.55"/>
        <DropShadowEffect x:Key="PillBarGlow" Color="#00E5FF" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
        <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="16" ShadowDepth="6" Opacity="0.5"/>

        <!-- ═══ FROSTED GLASS TILE TEMPLATE (8-COLUMN GRID) ═══ -->
        <DataTemplate x:Key="MockupModuleTileTemplate">
            <Border Width="124" Height="128" Margin="7,6"
                    CornerRadius="{StaticResource TileCorner}"
                    Background="{StaticResource TileFrostedBg}"
                    BorderBrush="{StaticResource SpecularBevelBorder}"
                    BorderThickness="1.2"
                    Effect="{StaticResource CardShadow}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <!-- Top-Right Diagonal Specular Sheen Reflection -->
                    <Border CornerRadius="{StaticResource TileCorner}" Background="{StaticResource TileSpecularSheen}" IsHitTestVisible="False"/>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Vibrant Cyan Squircle Badge -->
                        <Border Width="48" Height="48" CornerRadius="13"
                                Background="#00E5FF"
                                HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#00E5FF" BlurRadius="12" ShadowDepth="0" Opacity="0.45"/>
                            </Border.Effect>
                            <!-- Line-Art Icon or Text Badge -->
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Icon}"
                                           FontFamily="{DynamicResource FontFamily.Icon}"
                                           FontSize="22" FontWeight="Normal"
                                           Foreground="#061224"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding IsTextBadge, Converter={StaticResource BoolToVisibilityReverseConverter}, FallbackValue=Visible}"/>
                                <TextBlock Text="{Binding LabelTextBadge}"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="#061224"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding IsTextBadge, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}"/>
                            </Grid>
                        </Border>

                        <!-- Module Label Underneath -->
                        <TextBlock Text="{Binding Label}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#F8FAFC"
                                   HorizontalAlignment="Center"
                                   Margin="0,11,0,0"
                                   MaxWidth="116"
                                   TextTrimming="CharacterEllipsis"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- ═══ ROOT STAGE ═══ -->
    <Grid x:Name="SplashStageRoot" Background="{StaticResource GlassStageGradient}">

        <!-- Atmospheric Mesh: Luminous Glow Orbs (Left, Right, Bottom-Left, Center) -->
        <Canvas IsHitTestVisible="False">
            <!-- Top-Center Ambient Glow Behind PGA -->
            <Ellipse Width="650" Height="400" Canvas.Left="363" Canvas.Top="-50" Fill="#1E00E5FF" IsHitTestVisible="False">
                <Ellipse.Effect>
                    <BlurEffect Radius="140" RenderingBias="Performance"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- Top-Right Atmospheric Glow Orb -->
            <Ellipse x:Name="OrbRightShape" Width="700" Height="700" Canvas.Right="-200" Canvas.Top="-200" Fill="#1A00E5FF" IsHitTestVisible="False">
                <Ellipse.Effect>
                    <BlurEffect Radius="160" RenderingBias="Performance"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- Bottom-Left Atmospheric Glow Orb -->
            <Ellipse x:Name="OrbLeftShape" Width="700" Height="700" Canvas.Left="-220" Canvas.Bottom="-220" Fill="#1800B4D8" IsHitTestVisible="False">
                <Ellipse.Effect>
                    <BlurEffect Radius="160" RenderingBias="Performance"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- Constellation Network Graphic (Left & Right Vectors) -->
            <Canvas Canvas.Left="0" Canvas.Top="0" Width="400" Height="768" Opacity="0.32" IsHitTestVisible="False">
                <Path Stroke="#00E5FF" StrokeThickness="0.8"
                      Data="M-40,250 L120,380 L60,540 L160,620 L30,720 M120,380 L220,440 L160,620 M60,540 L-20,680 M220,440 L310,510"/>
                <Ellipse Width="6" Height="6" Fill="#00E5FF" Canvas.Left="117" Canvas.Top="377"/>
                <Ellipse Width="5" Height="5" Fill="#00E5FF" Canvas.Left="58" Canvas.Top="538"/>
                <Ellipse Width="7" Height="7" Fill="#00E5FF" Canvas.Left="157" Canvas.Top="617"/>
                <Ellipse Width="5" Height="5" Fill="#00E5FF" Canvas.Left="218" Canvas.Top="438"/>
                <Ellipse Width="6" Height="6" Fill="#00E5FF" Canvas.Left="307" Canvas.Top="507"/>
            </Canvas>

            <Canvas Canvas.Right="0" Canvas.Top="0" Width="450" Height="768" Opacity="0.32" IsHitTestVisible="False">
                <Path Stroke="#00E5FF" StrokeThickness="0.8"
                      Data="M480,80 L350,160 L240,110 L160,240 L280,310 M350,160 L380,300 L280,310 M280,310 L390,440"/>
                <Ellipse Width="6" Height="6" Fill="#00E5FF" Canvas.Left="347" Canvas.Top="157"/>
                <Ellipse Width="5" Height="5" Fill="#00E5FF" Canvas.Left="238" Canvas.Top="108"/>
                <Ellipse Width="6" Height="6" Fill="#00E5FF" Canvas.Left="157" Canvas.Top="237"/>
                <Ellipse Width="7" Height="7" Fill="#00E5FF" Canvas.Left="277" Canvas.Top="307"/>
                <Ellipse Width="5" Height="5" Fill="#00E5FF" Canvas.Left="377" Canvas.Top="297"/>
                <Ellipse Width="6" Height="6" Fill="#00E5FF" Canvas.Left="387" Canvas.Top="437"/>
            </Canvas>
        </Canvas>

        <!-- Backward-compatibility hooks (Hidden, zero layout cost) -->
        <Rectangle x:Name="ConstellationRect" Visibility="Collapsed"/>
        <Ellipse x:Name="OrbitRingRotate" Visibility="Collapsed"/>
        <Border x:Name="TopLeftBadge" Visibility="Collapsed"/>
        <Border x:Name="TopCenterPill" Visibility="Collapsed"/>
        <Border x:Name="TopRightBadge" Visibility="Collapsed"/>

        <!-- ═══ MAIN HERO POSTER HOST ═══ -->
        <Grid x:Name="PosterHost" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
            <StackPanel HorizontalAlignment="Center">

                <!-- ── 1. CENTRAL FLOATING GLASS SHIELD & TILTED DOTTED ORBIT RING ── -->
                <Grid HorizontalAlignment="Center" Margin="0,0,0,22">
                    <!-- Tilted Dashed Orbit Ring Around Shield -->
                    <Path Stroke="#00E5FF" StrokeThickness="1.5" StrokeDashArray="4 4" Opacity="0.55"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-60,-15,-60,-15"
                          Data="M 0,35 A 130,42 0 1 1 260,35 A 130,42 0 1 1 0,35">
                        <Path.RenderTransform>
                            <RotateTransform Angle="-14" CenterX="130" CenterY="35"/>
                        </Path.RenderTransform>
                    </Path>

                    <!-- Central Floating Glass Shield -->
                    <Border x:Name="LogoBorder"
                            Width="116" Height="116"
                            CornerRadius="24"
                            Background="#26102138"
                            BorderBrush="{StaticResource SpecularBevelBorder}"
                            BorderThickness="1.6"
                            Effect="{StaticResource NeonCyanGlow}"
                            Opacity="0">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="LogoScale" ScaleX="0.92" ScaleY="0.92" CenterX="58" CenterY="58"/>
                        </Border.RenderTransform>
                        <Grid>
                            <!-- Top Specular Highlight Sheen -->
                            <Border CornerRadius="24" Background="{StaticResource TileSpecularSheen}" IsHitTestVisible="False"/>

                            <!-- Inner Cyan Hexagonal Badge with Dark Navy PGA Monogram -->
                            <Grid Width="74" Height="78" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Polygon Points="37,0 74,21 74,57 37,78 0,57 0,21"
                                         Fill="#00E5FF"
                                         Stroke="{StaticResource SpecularBevelBorder}"
                                         StrokeThickness="1"/>
                                <TextBlock Text="PGA"
                                           FontSize="22" FontWeight="Black"
                                           Foreground="#061224"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,1,0,0"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ── 2. WORDMARK & TAGLINE ── -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,28">
                    <!-- High-Contrast Title: ProGlass (White) + Automation (Electric Cyan) -->
                    <TextBlock x:Name="AppNameText"
                               FontSize="38" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Opacity="0">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="AppNameTranslate" Y="12"/>
                        </TextBlock.RenderTransform>
                        <Run Text="ProGlass " Foreground="{StaticResource TextPrimary}"/>
                        <Run Text="Automation" Foreground="{StaticResource AccentCyan}"/>
                    </TextBlock>

                    <!-- Subtitle with Flanking Thin Accent Lines: ── MODERN GLASS FABRICATION ERP ── -->
                    <Grid HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Width="46" Height="1" Fill="#475569" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock x:Name="TaglineText" Grid.Column="1"
                                   Text="MODERN GLASS FABRICATION ERP"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#94A3B8"
                                   Opacity="0"
                                   VerticalAlignment="Center"/>
                        <Rectangle Grid.Column="2" Width="46" Height="1" Fill="#475569" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- ── 3. 16 FROSTED GLASS MODULE CARDS (8 COLUMNS × 2 ROWS) ── -->
                <ItemsControl x:Name="FeaturePanel"
                              ItemTemplate="{StaticResource MockupModuleTileTemplate}"
                              HorizontalAlignment="Center"
                              Opacity="0"
                              Margin="0,0,0,32">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- ── 4. GLOWING CYAN NEON PILL PROGRESS BAR ── -->
                <Grid Width="640" Height="20" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <!-- Dark Translucent Track -->
                    <Border Height="20" CornerRadius="10"
                            Background="#18152538"
                            BorderBrush="#2800E5FF"
                            BorderThickness="1"/>

                    <!-- Luminous Neon Cyan Fill Pill -->
                    <Grid x:Name="ProgressTrack" Height="20" HorizontalAlignment="Stretch">
                        <Border x:Name="ProgressFill"
                                Height="20" Width="0"
                                HorizontalAlignment="Left"
                                CornerRadius="10"
                                Background="{StaticResource LuminousProgressGradient}"
                                Effect="{StaticResource PillBarGlow}"/>
                    </Grid>
                </Grid>

                <!-- ── 5. NON-OVERLAPPING STATUS & TELEMETRY FOOTER ── -->
                <StackPanel x:Name="LoadingStrip" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="LoadingText"
                               Text="{DynamicResource Splash.Starting}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="#94A3B8"/>
                    <TextBlock x:Name="LoadingDots"
                               Text=""
                               FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource AccentCyan}"/>
                </StackPanel>

            </StackPanel>
        </Grid>

        <!-- ═══ MODAL LOGIN & SETUP GATES ═══ -->
        <Grid x:Name="LoginHost" Visibility="Collapsed" Opacity="0" Panel.ZIndex="11">
            <login:LoginPanel x:Name="LoginGate"/>
        </Grid>

        <Grid x:Name="SetupHost" Visibility="Collapsed" Opacity="0" Panel.ZIndex="12">
            <login:FirstRunSetupPanel x:Name="SetupGate"/>
        </Grid>

        <!-- ═══ TERMS GATE ═══ -->
        <Grid x:Name="TermsPanel" Background="{StaticResource GlassStageGradient}" Visibility="Collapsed" Opacity="0" Panel.ZIndex="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,46,0,0">
                <TextBlock Text="{DynamicResource Splash.TermsTitle}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimary}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#00E5FF" BlurRadius="18" ShadowDepth="0" Opacity="0.35"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="{DynamicResource Splash.UaeIntro}" FontSize="14" HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{StaticResource TextSecondary}"/>
                <Rectangle Height="1" Width="360" Margin="0,18,0,0" Opacity="0.5" Fill="{StaticResource AccentCyan}"/>
            </StackPanel>

            <Border Grid.Row="1" MaxWidth="980" Margin="60,26,60,10" Padding="42,34"
                    CornerRadius="{StaticResource SplashCornerLarge}"
                    BorderBrush="{StaticResource SpecularBevelBorder}" BorderThickness="1"
                    Background="#1E0F172A">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="13" LineHeight="24" TextWrapping="Wrap">
                        <Run Text="{DynamicResource Splash.Term1}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/><LineBreak/>
                        <Run Text="{DynamicResource Splash.SoftwareAssistsPreparingTaxInvoicesRecords}"/><LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term2}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/><LineBreak/>
                        <Run Text="{DynamicResource Splash.UAETaxLawRequiresAccountingRecordsTax}"/><LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term3}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/><LineBreak/>
                        <Run Text="{DynamicResource Splash.FederalDecreeLawNo462021Electronic}"/><LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term4}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/><LineBreak/>
                        <Run Text="{DynamicResource Splash.FederalDecreeLawNo452021ProtectionPersonal}"/><LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term5}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/><LineBreak/>
                        <Run Text="{DynamicResource Splash.GrantedNonTransferableLicenceUseSoftware}"/><LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term6}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/><LineBreak/>
                        <Run Text="{DynamicResource Splash.AgreeUseSoftwareProduceFalseMisleading}"/><LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term7}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/><LineBreak/>
                        <Run Text="{DynamicResource Splash.SoftwareProvidedWithoutWarrantyKindExpress}"/><LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term8}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/><LineBreak/>
                        <Run Text="{DynamicResource Splash.UpdatesMayOfferedTimeTimeInstallingChoice}"/><LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term9}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/><LineBreak/>
                        <Run Text="{DynamicResource Splash.TermsGovernedLawsUnitedArabEmiratesEmirate}"/>
                    </TextBlock>
                </ScrollViewer>
            </Border>

            <Border x:Name="TermsBar" CornerRadius="{StaticResource SplashCornerLarge}" Grid.Row="2"
                    BorderBrush="{StaticResource SpecularBevelBorder}" BorderThickness="0,1,0,0"
                    Padding="60,20" Background="#1E0F172A">
                <DockPanel LastChildFill="True" MaxWidth="980">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,8,0,0">
                        <Button x:Name="DeclineButton" Content="{DynamicResource Splash.DeclineExit}" MinWidth="150" Height="40" Margin="0,0,12,0"
                                Style="{StaticResource Button.Secondary}" Command="{Binding DeclineCommand}"/>
                        <Button x:Name="ContinueButton" Content="{DynamicResource Splash.AcceptContinue}" MinWidth="190" Height="40"
                                IsEnabled="{Binding IsContinueEnabled}" Style="{StaticResource Button.Primary}" Command="{Binding ContinueCommand}"/>
                    </StackPanel>
                    <CheckBox x:Name="AcceptTermsCheck" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"
                              FontSize="13" Cursor="Hand" Margin="0,8,0,0" IsChecked="{Binding AcceptTerms, Mode=TwoWay}">
                        <TextBlock Text="{DynamicResource Splash.AcceptText}" TextWrapping="Wrap"/>
                    </CheckBox>
                </DockPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
