<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Splash/SplashView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Splash Screen — "SPLIT DIAGONAL" (v3, 2026-09-19)
            Owner-approved mockup: /home/user/splash_designs/01-split-diagonal.png
            ("i want this first mockup approved. splash redesign to this one.")

     DESIGN (faithful to the approved image):
       • sharp diagonal split, top-left → bottom-right: LEFT ~40% deep
         navy panel (fixed #102244 — design identity, both themes) with
         a 2px accent edge along the split; RIGHT side soft theme
         off-white → pale gray diagonal
       • navy panel, top-left: hexagon logo outline (3px, accent light)
         + PGA, then the 30px two-line wordmark — "ProGlass" light ink /
         "Automation" sky blue (fixed colours: they sit on fixed navy)
       • thin 2px VERTICAL progress track on the split edge (lower
         third), fills bottom→top with a cyan glow over ~1.9s
       • light side: three quiet uppercase captions bottom-right
         (MADE IN INDIA / ENTERPRISE · v2.0.1 / OFFLINE · SECURE)
       • very faint 64px engineering grid texture on the stage
       • no header row, no module chips, no status line — clean, as
         approved

     PRESERVED (public API of SplashView.xaml.cs + App.StartupCore.cs):
       • Window flags (Maximized / None / Topmost / NoTaskbar)
       • FadeOutAndClose(Action), RunLoginAsync(), RunFirstRunSetupAsync(),
         ShowTermsGate(), TermsAccepted / TermsResolved / SignedIn /
         HasAcceptedCurrentTerms / TermsVersion
       • Terms gate (UAE legal copy unchanged, all 9 clauses) + login +
         first-run gates (shared LoginPanel / FirstRunSetupPanel views)
       • x:Name used by code-behind: PosterHost, LogoBorder, LogoScale,
         AppNameText, AppNameTranslate, ProgressTrack, ProgressFill,
         CaptionMadeIn, CaptionEnterprise, CaptionSecure, TermsPanel,
         TermsBar, AcceptTermsCheck, DeclineButton, ContinueButton,
         LoginHost, LoginGate, SetupHost, SetupGate

     BUILD-GATE NOTES (2026-09-19, from owner's real build):
       • DashStyle has NO Interval property (MC3072) — Dashes only.
       • Style.Triggers must come AFTER all Setters (MC3088).
       • A style's TargetType must match the element (sibling types
         like Button vs ToggleButton throw at startup — ERR-AF067B).
═══════════════════════════════════════════════════════════════════════ -->
<Window x:Class="ProGlassAutomation.Views.Splash.SplashView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:updates="clr-namespace:ProGlassAutomation.Services.Updates"
        xmlns:login="clr-namespace:ProGlassAutomation.Views.Login"
        xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
        Title="{DynamicResource Shell.AppTitle}"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        ShowInTaskbar="False"
        Topmost="True"
        behaviors:ViewportFitBehavior.DisableZoom="True"
        FontFamily="{DynamicResource AppFontFamily}"
        FontWeight="{DynamicResource AppFontWeight}"
        FontStyle="{DynamicResource AppFontStyle}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- ═══ SPLIT DIAGONAL PALETTE ═══ -->
        <!-- Right side: theme diagonal (light: warm off-white → pale;
             dark: deep navy → blue-black). -->
        <LinearGradientBrush x:Key="SideBg" StartPoint="0.05,0" EndPoint="0.85,1">
            <GradientStop Color="{DynamicResource WindowBackgroundColor}" Offset="0.0"/>
            <GradientStop Color="{DynamicResource ModuleBackgroundColor}" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Navy panel: FIXED #102244 in both themes — it is the
             approved design's identity, not a theme surface. -->
        <SolidColorBrush x:Key="SplashNavy" Color="#102244"/>
        <!-- Wordmark on fixed navy: fixed colours (contrast contract). -->
        <SolidColorBrush x:Key="SplashWordInk"    Color="#E5E7EB"/>
        <SolidColorBrush x:Key="SplashWordAccent" Color="#7DD3FC"/>
        <SolidColorBrush x:Key="SplashCerulean"   Color="{StaticResource AccentLightColor}"/>
        <!-- Caption brush — use the theme's secondary foreground brush directly
             (Color vs Brush mismatch: SecondaryForegroundColor is Color,
             but Foreground expects Brush; using Brush avoids XDG-0001). -->
        <SolidColorBrush x:Key="SplashCaption" Color="{StaticResource SecondaryForegroundColor}"/>

        <!-- Engineering grid texture — 1px dotted accent hairlines on a
             64px tile, rendered at 4% on the stage (faint, both themes).
             NOTE: DashStyle exposes only Dashes — no Interval. -->
        <DrawingBrush x:Key="GridTextureBrush"
                      TileMode="Tile" Viewport="0,0,64,64" ViewportUnits="Absolute"
                      Stretch="None">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Thickness="1" Brush="{DynamicResource SplashCerulean}">
                            <Pen.DashStyle>
                                <DashStyle Dashes="1 3"/>
                            </Pen.DashStyle>
                        </Pen>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0" EndPoint="64,0"/>
                            <LineGeometry StartPoint="0,0" EndPoint="0,64"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Progress fill — vertical, bottom→top luminous accent -->
        <LinearGradientBrush x:Key="ProgressGradient" StartPoint="0,1" EndPoint="0,0">
            <GradientStop Color="{DynamicResource AccentDarkColor}"  Offset="0.0"/>
            <GradientStop Color="{DynamicResource AccentColor}"      Offset="0.5"/>
            <GradientStop Color="{DynamicResource AccentLightColor}" Offset="1.0"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="TrackGlow" Color="{DynamicResource AccentLightColor}"
                          BlurRadius="9" ShadowDepth="0" Opacity="0.55"/>
        <DropShadowEffect x:Key="LogoGlow" Color="{DynamicResource AccentColor}"
                          BlurRadius="22" ShadowDepth="0" Opacity="0.45"/>

        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SplashCaption}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <!-- Terms card typography (same contract as v2) -->
        <Style x:Key="TermsLead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="TermsBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="LineHeight" Value="24"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

    </Window.Resources>

    <Grid Background="{DynamicResource SideBg}">

        <!-- Faint engineering grid over the whole stage (barely visible) -->
        <Rectangle Fill="{DynamicResource GridTextureBrush}"
                   IsHitTestVisible="False"
                   Opacity="0.04"/>

        <!-- ── NAVY PANEL — skewed so its right edge is the diagonal ──
             Width = 40% of the window; SkewAngleY=15° about the
             top-left origin shifts the bottom edge ~27% of the height
             to the right → split runs top-left → bottom-right, left
             region ≈ 40% top / ≈ 55% bottom (approved mockup shape).
             The 2px right border rides the split as the accent edge. -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Stretch"
                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window},
                              Converter={StaticResource ScaleLengthConverter}, ConverterParameter=0.40}"
                Background="{StaticResource SplashNavy}"
                BorderBrush="{DynamicResource SplashCerulean}"
                BorderThickness="0,0,2,0"
                Opacity="0.85"
                RenderTransformOrigin="0,0"
                IsHitTestVisible="False">
            <Border.RenderTransform>
                <SkewTransform AngleY="15"/>
            </Border.RenderTransform>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             POSTER — logo + wordmark (navy panel) · progress (split
             edge) · captions (light side)
        ═══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="PosterHost">

            <!-- NAVY PANEL CONTENT — top-left brand moment -->
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="56,0,0,0" IsHitTestVisible="False">

                <!-- Hexagon logo outline + PGA -->
                <Border x:Name="LogoBorder" Width="64" Height="64"
                        Opacity="0"
                        Effect="{StaticResource LogoGlow}">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="LogoScale" ScaleX="0.92" ScaleY="0.92"/>
                    </Border.RenderTransform>
                    <Viewbox Width="56" Height="56">
                        <Grid Width="72" Height="72">
                            <Path Stroke="{DynamicResource SplashCerulean}"
                                  StrokeThickness="3"
                                  StrokeLineJoin="Round"
                                  Data="M20,5 L52,5 L68,36 L52,67 L20,67 L4,36 Z"/>
                            <TextBlock Text="PGA"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SplashCerulean}"/>
                        </Grid>
                    </Viewbox>
                </Border>

                <!-- Wordmark — 30px, two lines, fixed on-navy colours -->
                <TextBlock x:Name="AppNameText"
                           FontSize="30"
                           FontWeight="{DynamicResource Weight.Bold}"
                           LineHeight="37"
                           HorizontalAlignment="Left"
                           Margin="0,22,0,0"
                           Opacity="0">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="AppNameTranslate" Y="14"/>
                    </TextBlock.RenderTransform>
                    <Run Text="ProGlass" Foreground="{StaticResource SplashWordInk}"/><LineBreak/><Run Text="Automation" Foreground="{StaticResource SplashWordAccent}"/>
                </TextBlock>
            </StackPanel>

            <!-- VERTICAL PROGRESS — on the split edge, lower third.
                 A left-anchored wrapper takes 47% of the window width
                 (double → Width, NOT Margin — a single double would
                 fan out to all four margin sides); the 2px track sits
                 at the wrapper's right edge, 110px above the bottom.
                 At common 16:9 sizes that x lands on the diagonal in
                 the lower third (approved mockup position). -->
            <Grid HorizontalAlignment="Left" VerticalAlignment="Stretch"
                  Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window},
                                Converter={StaticResource ScaleLengthConverter}, ConverterParameter=0.47}"
                  IsHitTestVisible="False">
                <Grid x:Name="ProgressTrack"
                      Width="2" Height="200"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,0,110"
                      Opacity="0">
                    <Border Width="2" CornerRadius="1"
                            Background="{DynamicResource SplashCerulean}"
                            Opacity="0.18"/>
                    <Border x:Name="ProgressFill"
                            Width="2" Height="0"
                            VerticalAlignment="Bottom"
                            CornerRadius="1"
                            Background="{StaticResource ProgressGradient}"
                            Effect="{StaticResource TrackGlow}"/>
                </Grid>
            </Grid>

            <!-- LIGHT-SIDE CAPTIONS — quiet chrome, bottom-right -->
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,56,40" IsHitTestVisible="False">
                <TextBlock x:Name="CaptionMadeIn"
                           Text="{DynamicResource Splash.MadeInIndia}"
                           Style="{StaticResource CaptionStyle}"
                           Opacity="0"/>
                <TextBlock x:Name="CaptionEnterprise"
                           Style="{StaticResource CaptionStyle}"
                           Opacity="0">
                    <Run Text="{DynamicResource Splash.Enterprise}"/>
                    <Run Text="{DynamicResource Splash.V}"/>
                    <Run Text="{x:Static updates:AppInfo.Version}"/>
                </TextBlock>
                <TextBlock x:Name="CaptionSecure"
                           Text="{DynamicResource Splash.OfflineSecure}"
                           Style="{StaticResource CaptionStyle}"
                           Margin="0"
                           Opacity="0"/>
            </StackPanel>
        </Grid>

        <!-- ═══ LOGIN GATE — same window as splash (no second window) ═══ -->
        <Grid x:Name="LoginHost"
              Visibility="Collapsed"
              Opacity="0"
              Panel.ZIndex="11">
            <login:LoginPanel x:Name="LoginGate"/>
        </Grid>

        <!-- ═══ FIRST-RUN SETUP GATE ═══ -->
        <Grid x:Name="SetupHost"
              Visibility="Collapsed"
              Opacity="0"
              Panel.ZIndex="12">
            <login:FirstRunSetupPanel x:Name="SetupGate"/>
        </Grid>

        <!-- ═══ TERMS GATE — transparent: the split stage shows through
             behind the glass card (legal copy intact, all 9 clauses) ═══ -->
        <Grid x:Name="TermsPanel"
              Background="Transparent"
              Visibility="Collapsed"
              Opacity="0"
              Panel.ZIndex="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        Margin="0,52,0,0">
                <TextBlock Text="{DynamicResource Splash.TermsTitle}"
                           FontSize="34" FontWeight="{DynamicResource Weight.Bold}"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource PrimaryForegroundBrush}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{DynamicResource AccentColor}"
                                          BlurRadius="18" ShadowDepth="0" Opacity="0.35"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="{DynamicResource Splash.UaeIntro}"
                           FontSize="{DynamicResource FontSize.Title}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <Rectangle Height="2" Width="48" Margin="0,18,0,0"
                           RadiusX="1" RadiusY="1"
                           HorizontalAlignment="Center"
                           Fill="{DynamicResource SplashCerulean}"/>
            </StackPanel>

            <!-- Glass terms card — per-clause layout -->
            <Border Grid.Row="1"
                    MaxWidth="860"
                    Margin="48,26,48,16"
                    Padding="40,32"
                    CornerRadius="16"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="{DynamicResource Border.HairlineThickness}"
                    Background="#1A808080">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Style="{StaticResource TermsLead}"
                                       Text="{DynamicResource Splash.Term1}"/>
                            <TextBlock Style="{StaticResource TermsBody}"
                                       Text="{DynamicResource Splash.SoftwareAssistsPreparingTaxInvoicesRecords}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Style="{StaticResource TermsLead}"
                                       Text="{DynamicResource Splash.Term2}"/>
                            <TextBlock Style="{StaticResource TermsBody}"
                                       Text="{DynamicResource Splash.UAETaxLawRequiresAccountingRecordsTax}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Style="{StaticResource TermsLead}"
                                       Text="{DynamicResource Splash.Term3}"/>
                            <TextBlock Style="{StaticResource TermsBody}"
                                       Text="{DynamicResource Splash.FederalDecreeLawNo462021Electronic}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Style="{StaticResource TermsLead}"
                                       Text="{DynamicResource Splash.Term4}"/>
                            <TextBlock Style="{StaticResource TermsBody}"
                                       Text="{DynamicResource Splash.FederalDecreeLawNo452021ProtectionPersonal}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Style="{StaticResource TermsLead}"
                                       Text="{DynamicResource Splash.Term5}"/>
                            <TextBlock Style="{StaticResource TermsBody}"
                                       Text="{DynamicResource Splash.GrantedNonTransferableLicenceUseSoftware}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Style="{StaticResource TermsLead}"
                                       Text="{DynamicResource Splash.Term6}"/>
                            <TextBlock Style="{StaticResource TermsBody}"
                                       Text="{DynamicResource Splash.AgreeUseSoftwareProduceFalseMisleading}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Style="{StaticResource TermsLead}"
                                       Text="{DynamicResource Splash.Term7}"/>
                            <TextBlock Style="{StaticResource TermsBody}"
                                       Text="{DynamicResource Splash.SoftwareProvidedWithoutWarrantyKindExpress}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Style="{StaticResource TermsLead}"
                                       Text="{DynamicResource Splash.Term8}"/>
                            <TextBlock Style="{StaticResource TermsBody}"
                                       Text="{DynamicResource Splash.UpdatesMayOfferedTimeTimeInstallingChoice}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource TermsLead}"
                                       Text="{DynamicResource Splash.Term9}"/>
                            <TextBlock Style="{StaticResource TermsBody}"
                                       Text="{DynamicResource Splash.TermsGovernedLawsUnitedArabEmiratesEmirate}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Flush action bar -->
            <Border x:Name="TermsBar"
                    Grid.Row="2"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Background="#1A808080"
                    Padding="48,18">
                <DockPanel LastChildFill="True" MaxWidth="860">
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,8,0,0">
                        <Button x:Name="DeclineButton"
                                Content="{DynamicResource Splash.DeclineExit}"
                                MinWidth="150" Height="44"
                                Margin="0,0,12,0"
                                Style="{StaticResource Button.Secondary}"
                                Command="{Binding DeclineCommand}"/>
                        <Button x:Name="ContinueButton"
                                Content="{DynamicResource Splash.AcceptContinue}"
                                MinWidth="190" Height="44"
                                IsEnabled="{Binding IsContinueEnabled}"
                                Style="{StaticResource Button.Primary}"
                                Command="{Binding ContinueCommand}"/>
                    </StackPanel>
                    <CheckBox x:Name="AcceptTermsCheck"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource SecondaryForegroundBrush}"
                              FontSize="{DynamicResource FontSize.Title}"
                              Cursor="Hand"
                              Margin="0,8,0,0"
                              IsChecked="{Binding AcceptTerms, Mode=TwoWay}">
                        <TextBlock Text="{DynamicResource Splash.AcceptText}"
                                   TextWrapping="Wrap"/>
                    </CheckBox>
                </DockPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
