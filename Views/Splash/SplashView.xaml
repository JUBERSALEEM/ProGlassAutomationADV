<Window x:Class="ProGlassAutomation.Views.Splash.SplashView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProGlass Automation"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- ═══════════ Glass card (light) ═══════════ -->
        <Style x:Key="GlassCardStyle" TargetType="Border">
            <Setter Property="CornerRadius"    Value="16"/>
            <Setter Property="Padding"         Value="20,14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#E5E7EB"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0"
                                      Color="#0F4C3A" Opacity="0.10"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
        </Style>

        <!-- Feature badge style -->
        <Style x:Key="FeatureBadgeStyle" TargetType="Border">
            <Setter Property="Width"           Value="58"/>
            <Setter Property="Height"          Value="58"/>
            <Setter Property="CornerRadius"    Value="16"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin"          Value="8,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="0"
                                      Color="#0F4C3A" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FeatureLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"           Value="10"/>
            <Setter Property="FontWeight"         Value="SemiBold"/>
            <Setter Property="Foreground"         Value="#6B7280"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin"             Value="0,8,0,0"/>
        </Style>

    </Window.Resources>

    <Grid>
        <!-- Light background with subtle green tint -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F9FAFB" Offset="0"/>
                <GradientStop Color="#FFFFFF" Offset="0.5"/>
                <GradientStop Color="#F0FDF4" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- ═══════════ Decorative soft green orbs ═══════════ -->
        <Ellipse Width="700" Height="700"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-250,-250,0" Opacity="0.35">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#A7F3D0" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="600" Height="600"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-200,0,0,-200" Opacity="0.28">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#BBF7D0" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="450" Height="450"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Opacity="0.12">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#22C55E" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- ═══════════ Center content ═══════════ -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- ═══════════ LOGO — Custom glass panel stack ═══════════ -->
            <Border x:Name="LogoBorder"
                    Width="160" Height="160"
                    CornerRadius="40"
                    HorizontalAlignment="Center"
                    ClipToBounds="True"
                    RenderTransformOrigin="0.5,0.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0F4C3A" Offset="0"/>
                        <GradientStop Color="#22C55E" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="55" ShadowDepth="0"
                                      Color="#0F4C3A" Opacity="0.55"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <ScaleTransform x:Name="LogoScale" ScaleX="0" ScaleY="0"/>
                </Border.RenderTransform>

                <Grid>
                    <!-- Back glass sheet (rotated + offset) -->
                    <Border Width="60" Height="82"
                            CornerRadius="6"
                            Background="#22C55E"
                            Opacity="0.35"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="20,-14,0,0"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <RotateTransform Angle="-10"/>
                        </Border.RenderTransform>
                    </Border>

                    <!-- Middle glass sheet -->
                    <Border Width="60" Height="82"
                            CornerRadius="6"
                            Background="#4ADE80"
                            Opacity="0.65"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="10,-7,0,0"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <RotateTransform Angle="-5"/>
                        </Border.RenderTransform>
                    </Border>

                    <!-- Front glass sheet (white with monogram) -->
                    <Border Width="60" Height="82"
                            CornerRadius="6"
                            Background="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2"
                                              Color="Black" Opacity="0.25"/>
                        </Border.Effect>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PG"
                                       Foreground="#0F4C3A"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <Border Width="20" Height="2"
                                    Background="#22C55E"
                                    CornerRadius="1"
                                    HorizontalAlignment="Center"
                                    Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Shimmer overlay (animated by code-behind) -->
                    <Border x:Name="ShimmerOverlay"
                            Width="60" Height="300"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#80FFFFFF" Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform>
                            <TransformGroup>
                                <RotateTransform Angle="20"/>
                                <TranslateTransform x:Name="ShimmerTranslate" X="-200"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </Border>

            <!-- App Name -->
            <TextBlock x:Name="AppNameText"
                       Text="ProGlass Automation"
                       FontSize="46"
                       FontWeight="Bold"
                       Foreground="#0F172A"
                       HorizontalAlignment="Center"
                       Margin="0,44,0,0"
                       Opacity="0">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="AppNameTranslate" Y="20"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <!-- Tagline -->
            <TextBlock x:Name="TaglineText"
                       Text="Complete Glass Production Workflow · UAE Edition"
                       FontSize="15"
                       FontWeight="Medium"
                       Foreground="#6B7280"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"
                       Opacity="0"/>

            <!-- ═══════════ FEATURE PREVIEW ROW ═══════════ -->
            <StackPanel x:Name="FeaturePanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,44,0,0"
                        Opacity="0">

                <!-- Dashboard -->
                <StackPanel x:Name="Feature1" Opacity="0">
                    <Border Style="{StaticResource FeatureBadgeStyle}">
                        <TextBlock Text="&#127968;" FontSize="26"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Dashboard" Style="{StaticResource FeatureLabelStyle}"/>
                </StackPanel>

                <!-- Proforma Invoice -->
                <StackPanel x:Name="Feature2" Opacity="0">
                    <Border Style="{StaticResource FeatureBadgeStyle}">
                        <TextBlock Text="&#128196;" FontSize="26"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Invoices" Style="{StaticResource FeatureLabelStyle}"/>
                </StackPanel>

                <!-- Sheet Store -->
                <StackPanel x:Name="Feature3" Opacity="0">
                    <Border Style="{StaticResource FeatureBadgeStyle}">
                        <TextBlock Text="&#128230;" FontSize="26"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Sheet Store" Style="{StaticResource FeatureLabelStyle}"/>
                </StackPanel>

                <!-- Job Orders -->
                <StackPanel x:Name="Feature4" Opacity="0">
                    <Border Style="{StaticResource FeatureBadgeStyle}">
                        <TextBlock Text="&#128295;" FontSize="26"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Job Orders" Style="{StaticResource FeatureLabelStyle}"/>
                </StackPanel>

                <!-- Production -->
                <StackPanel x:Name="Feature5" Opacity="0">
                    <Border Style="{StaticResource FeatureBadgeStyle}">
                        <TextBlock Text="&#9986;" FontSize="24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Production" Style="{StaticResource FeatureLabelStyle}"/>
                </StackPanel>

                <!-- Reports -->
                <StackPanel x:Name="Feature6" Opacity="0">
                    <Border Style="{StaticResource FeatureBadgeStyle}">
                        <TextBlock Text="&#128202;" FontSize="26"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Reports" Style="{StaticResource FeatureLabelStyle}"/>
                </StackPanel>

                <!-- AI Assistant -->
                <StackPanel x:Name="Feature7" Opacity="0">
                    <Border Style="{StaticResource FeatureBadgeStyle}">
                        <TextBlock Text="&#129302;" FontSize="26"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="AI Assistant" Style="{StaticResource FeatureLabelStyle}"/>
                </StackPanel>

            </StackPanel>

            <!-- ═══════════ PROGRESS SECTION ═══════════ -->
            <StackPanel HorizontalAlignment="Center" Margin="0,44,0,0">

                <!-- Progress bar -->
                <Border Width="360" Height="6"
                        CornerRadius="3"
                        Background="#E5E7EB">
                    <Border x:Name="ProgressFill"
                            Width="0"
                            HorizontalAlignment="Left"
                            CornerRadius="3">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0F4C3A" Offset="0"/>
                                <GradientStop Color="#22C55E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Border>

                <!-- Loading text with rotating messages -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,0">
                    <Ellipse Width="8" Height="8"
                             VerticalAlignment="Center"
                             Margin="0,0,10,0">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#22C55E" Offset="0"/>
                                <GradientStop Color="#0F4C3A" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock x:Name="LoadingText"
                               Text="Initializing workspace…"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="#6B7280"
                               VerticalAlignment="Center"
                               Opacity="0"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>

        <!-- ═══════════ Bottom-Left: Developer Card ═══════════ -->
        <Border Style="{StaticResource GlassCardStyle}"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="40,0,0,40">
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="12"
                        VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F4C3A" Offset="0"/>
                            <GradientStop Color="#22C55E" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="JS"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Margin="14,0,4,0" VerticalAlignment="Center">
                    <TextBlock Text="DEVELOPER" Style="{StaticResource CardLabelStyle}"/>
                    <TextBlock Text="Juber Saleem"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               Margin="0,3,0,0"/>
                    <TextBlock Text="India"
                               FontSize="11"
                               Foreground="#6B7280"
                               Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══════════ Bottom-Center: Copyright Card ═══════════ -->
        <Border Style="{StaticResource GlassCardStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,40">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="©"
                           FontSize="18"
                           Foreground="#0F4C3A"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="COPYRIGHT" Style="{StaticResource CardLabelStyle}"/>
                    <TextBlock Text="2026 ProGlass Automation"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══════════ Bottom-Right: Version Card ═══════════ -->
        <Border Style="{StaticResource GlassCardStyle}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,40,40">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#22C55E" Offset="0"/>
                            <GradientStop Color="#10B981" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <StackPanel Margin="12,0,4,0" VerticalAlignment="Center">
                    <TextBlock Text="VERSION" Style="{StaticResource CardLabelStyle}"/>
                    <TextBlock Text="v1.0.0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
</Window>