<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Splash/SplashView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Splash Screen — industrial glass identity

     Professional crystal composition on the deep-navy stage:
       • aurora backdrop (layered soft orbs)
       • top frosted trust chips (MADE IN INDIA / ENTERPRISE · vX /
         OFFLINE · SECURE)
       • centered crystal logo tile with halo + orbit ring + sheen
       • product name (metallic gradient) + tagline
       • circular module orbs (static, one uniform fade — no marketing
         flash, no stagger)
       • luminous progress bar + frosted status pill with animated dots
       • frosted footer bar (product · version · city)

     PRESERVED (zero regression — public API of SplashView.xaml.cs):
       • Window flags (Maximized / None / Topmost / NoTaskbar)
       • FadeOutAndClose(Action), RunLoginAsync(), ShowTermsGate()
       • TermsAccepted / TermsResolved / SignedIn / HasAcceptedCurrentTerms
       • Terms gate (UAE legal copy unchanged) + login gate (LoginPanel)
       • x:Name used by code-behind: PosterHost, LogoBorder, LogoScale,
         AppNameText, AppNameTranslate, TaglineText, ProgressTrack,
         ProgressFill, LoadingText, LoadingDots, LoadingStrip,
         TermsPanel, AcceptTermsCheck, DeclineButton, ContinueButton,
         LoginHost, LoginGate
       • NEW x:Name animated by code-behind: TopLeftBadge, TopCenterPill,
         TopRightBadge, FeaturePanel
═══════════════════════════════════════════════════════════════════════ -->
<Window x:Class="ProGlassAutomation.Views.Splash.SplashView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:updates="clr-namespace:ProGlassAutomation.Services.Updates"
        xmlns:login="clr-namespace:ProGlassAutomation.Views.Login"
        xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
        Title="{DynamicResource Shell.AppTitle}"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        ShowInTaskbar="False"
        Topmost="True"
        behaviors:ViewportFitBehavior.DisableZoom="True"
        FontFamily="{DynamicResource AppFontFamily}"
        FontWeight="{DynamicResource AppFontWeight}"
        FontStyle="{DynamicResource AppFontStyle}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- 2026-08-25 redesign: aurora orbs + logo halo are filled with the
         ACTIVE AccentBrush (theme/accent adaptive), softened by these
         blurs — no more hard-coded blue radial gradients. -->
        <BlurEffect x:Key="OrbBlur"  Radius="80" RenderingBias="Performance"/>
        <BlurEffect x:Key="HaloBlur" Radius="26" RenderingBias="Performance"/>

        <!-- ═══ PALETTE (frozen once) — blueish crystal spectrum ═══ -->
        <SolidColorBrush x:Key="Azure"    Color="#60A5FA" po:Freeze="True"/>
        <SolidColorBrush x:Key="Cerulean" Color="#93C5FD" po:Freeze="True"/>
        <SolidColorBrush x:Key="Frost"    Color="#BFDBFE" po:Freeze="True"/>
        <SolidColorBrush x:Key="Ice"      Color="#DBEAFE" po:Freeze="True"/>

        <!-- ═══ STAGE — deep blue aurora ═══ -->
        <LinearGradientBrush x:Key="PageBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#040B1C" Offset="0.0"/>
            <GradientStop Color="#0A1A44" Offset="0.42"/>
            <GradientStop Color="#0B2A6E" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Blurred aurora orbs (frost backdrop) -->
        <RadialGradientBrush x:Key="OrbRight"
                             Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#4D82F6FF" Offset="0.0"/>
            <GradientStop Color="#1D4ED84D" Offset="0.55"/>
            <GradientStop Color="#1D4ED800" Offset="1.0"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="OrbLeft"
                             Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#60A5FA66" Offset="0.0"/>
            <GradientStop Color="#3B82F633" Offset="0.55"/>
            <GradientStop Color="#3B82F600" Offset="1.0"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="OrbCore"
                             Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#93C5FD40" Offset="0.0"/>
            <GradientStop Color="#60A5FA1F" Offset="0.6"/>
            <GradientStop Color="#60A5FA00" Offset="1.0"/>
        </RadialGradientBrush>

        <!-- ═══ BRAND NAME — metallic crystal gradient + glow ═══ -->
        <LinearGradientBrush x:Key="NameGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#BFDBFE" Offset="0.45"/>
            <GradientStop Color="{DynamicResource AccentLightColor}" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- ═══ ICON HALO + CRYSTAL ═══ -->
        <RadialGradientBrush x:Key="IconHalo"
                             Center="0.5,0.5" GradientOrigin="0.5,0.5"
                             RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#4F8EF766" Offset="0.0"/>
            <GradientStop Color="#4F8EF71F" Offset="0.6"/>
            <GradientStop Color="#4F8EF700" Offset="1.0"/>
        </RadialGradientBrush>

        <LinearGradientBrush x:Key="SplashPlate" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F7FFFFFF" Offset="0.0"/>
            <GradientStop Color="#E8F1FAFF" Offset="0.5"/>
            <GradientStop Color="#D0E2F5FF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Top-edge highlight on the logo tile (crystal sheen). -->
        <LinearGradientBrush x:Key="TileSheen" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#99FFFFFF" Offset="0.0"/>
            <GradientStop Color="#00FFFFFF" Offset="0.45"/>
        </LinearGradientBrush>

        <!-- ═══ PROGRESS — luminous ═══ -->
        <LinearGradientBrush x:Key="ProgressGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{DynamicResource AccentColor}" Offset="0.0"/>
            <GradientStop Color="{DynamicResource AccentLightColor}" Offset="0.55"/>
            <GradientStop Color="{DynamicResource AccentLightColor}" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- ═══ CRYSTAL SHADOWS ═══ -->
        <DropShadowEffect x:Key="IconShadow" Color="{DynamicResource AccentColor}"
                          BlurRadius="48" ShadowDepth="0" Opacity="0.7"/>
        <DropShadowEffect x:Key="SplashGlow" Color="{DynamicResource AccentColor}"
                          BlurRadius="20" ShadowDepth="0" Opacity="0.45"/>

        <!-- ═══ FROSTED TRUST CHIP (top badges) ═══ -->
        <Style x:Key="TrustChipStyle" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#24FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#0AFFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Effect" Value="{StaticResource SplashGlow}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>

        <Style x:Key="ChipGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="ChipTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══ MODULE CHIP (feature strip) — industrial single-line grid ═══
             Each module renders as one compact industrial cell: a tinted glyph
             beside a single-line label (no wrapping). The strip is laid out by
             a UniformGrid (see FeaturePanel below) so every chip is the SAME
             width and sits on ONE clean row — no ragged two-row wrap. -->
        <DataTemplate x:Key="FeatureBadgeTemplate">
            <Border Height="40"
                    Margin="6,4"
                    Padding="12,0"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource MenuHoverBrush}"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True"
                    IsHitTestVisible="False">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Icon}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="{StaticResource TextBodyLarge}"
                               Foreground="{Binding BorderBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Label}"
                               FontSize="{StaticResource TextBody}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ═══ TERMS — DECLINE (ghost) ═══ -->
        <Style x:Key="TermsDeclineButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="Transparent"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ TERMS — CONTINUE (accent) ═══ -->
        <Style x:Key="TermsContinueButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{DynamicResource AccentBrush}"
                                BorderThickness="0"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource AccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">

        <Ellipse Width="420" Height="420"
                 Fill="{DynamicResource AccentBrush}" Opacity="0.20" Effect="{StaticResource OrbBlur}"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-140,-120,0" IsHitTestVisible="False"/>
        <Ellipse Width="340" Height="340"
                 Fill="{DynamicResource AccentBrush}" Opacity="0.15" Effect="{StaticResource OrbBlur}"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-100,0,0,-100" IsHitTestVisible="False"/>
        <Ellipse Width="480" Height="480"
                 Fill="{DynamicResource AccentBrush}" Opacity="0.10" Effect="{StaticResource OrbBlur}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Margin="0,-60,0,0" IsHitTestVisible="False"/>

        <!-- ═══════════════════════════════════════════════════════════
             POSTER — glass identity block
        ═══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="PosterHost" Margin="24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Top trust chips -->
                <RowDefinition Height="*"/>
                <!-- Center brand -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ── TOP TRUST CHIPS ──────────────────────────────────── -->
            <Grid Grid.Row="0">
                <Border x:Name="TopLeftBadge" Style="{StaticResource TrustChipStyle}"
                        HorizontalAlignment="Left" Opacity="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE774;" Style="{StaticResource ChipGlyphStyle}"/>
                        <TextBlock Text="{DynamicResource Splash.MadeInIndia}" Style="{StaticResource ChipTextStyle}"/>
                    </StackPanel>
                </Border>
                <Border x:Name="TopCenterPill" Style="{StaticResource TrustChipStyle}"
                        HorizontalAlignment="Center" Opacity="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE735;" Style="{StaticResource ChipGlyphStyle}"/>
                        <TextBlock Style="{StaticResource ChipTextStyle}">
                            <Run Text="{DynamicResource Splash.Enterprise}"/>
                            <Run Text="{DynamicResource Splash.V}"/>
                            <Run Text="{x:Static updates:AppInfo.Version}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border x:Name="TopRightBadge" Style="{StaticResource TrustChipStyle}"
                        HorizontalAlignment="Right" Opacity="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource ChipGlyphStyle}"/>
                        <TextBlock Text="{DynamicResource Splash.OfflineSecure}" Style="{StaticResource ChipTextStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── CENTER BRAND ─────────────────────────────────────── -->
            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="860"
                        Margin="8,18">

                <!-- Logo — crystal tile + halo + orbit ring + sheen -->
                <Border x:Name="LogoBorder" Width="136" Height="136"
                        HorizontalAlignment="Center"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        IsHitTestVisible="False"
                        Opacity="0">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="LogoScale" ScaleX="0.92" ScaleY="0.92"/>
                    </Border.RenderTransform>
                    <Grid>
                        <Ellipse Width="136" Height="136" Fill="{DynamicResource AccentBrush}" Opacity="0.28" Effect="{StaticResource HaloBlur}"/>
                        <Ellipse Width="126" Height="126"
                                 Stroke="{DynamicResource AccentBrush}" Opacity="0.6" StrokeThickness="1.5"
                                 StrokeDashArray="4 8"/>
                        <Border Width="96" Height="96" CornerRadius="22"
                                Effect="{StaticResource IconShadow}"
                                Background="{StaticResource SplashPlate}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border Width="88" Height="88" CornerRadius="18"
                                        BorderBrush="#88FFFFFF" BorderThickness="1"
                                        ClipToBounds="True">
                                    <Border.Background>
                                        <ImageBrush ImageSource="pack://application:,,,/Resources/proglass_icon_256.png"
                                                    Stretch="UniformToFill"
                                                    RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border.Background>
                                </Border>
                                <!-- Top-edge crystal sheen on the tile -->
                                <Border Width="88" Height="88" CornerRadius="18"
                                        Background="{StaticResource TileSheen}"
                                        IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <TextBlock x:Name="AppNameText"
                           Text="{DynamicResource Shell.AppTitle}"
                           FontSize="{StaticResource TextDisplayLarge}" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                           Opacity="0">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="AppNameTranslate" Y="12"/>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <TextBlock x:Name="TaglineText"
                           Text="{DynamicResource Splash.MadeInIndiaDesc}"
                           FontSize="{StaticResource TextBodyLarge}"
                           HorizontalAlignment="Center"
                           Margin="0,7,0,0"
                           Foreground="{DynamicResource AccentBrush}"
                           Opacity="0"/>

                <!-- Module chips — one clean industrial row, uniform widths -->
                <ItemsControl x:Name="FeaturePanel"
                              ItemTemplate="{StaticResource FeatureBadgeTemplate}"
                              HorizontalAlignment="Stretch"
                              MaxWidth="1160"
                              Margin="0,20,0,0"
                              Opacity="0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6"
                                         HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Progress -->
                <Grid x:Name="ProgressTrack"
                      MaxWidth="340" Height="4"
                      Margin="0,22,0,0" HorizontalAlignment="Stretch">
                    <Border Height="4" CornerRadius="2" Background="{DynamicResource BorderBrush}"/>
                    <Border x:Name="ProgressFill"
                            Height="4" Width="0"
                            HorizontalAlignment="Left"
                            CornerRadius="2"
                            Background="{StaticResource ProgressGradient}"/>
                </Grid>

                <!-- Status pill (frosted) -->
                <Border CornerRadius="10" Padding="14,7"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,0"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="1"
                        Background="{DynamicResource MenuHoverBrush}">
                    <StackPanel x:Name="LoadingStrip" Orientation="Horizontal">
                        <TextBlock x:Name="LoadingText"
                                   Text="{DynamicResource Splash.Starting}"
                                   FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock x:Name="LoadingDots"
                                   Text=""
                                   FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ── FOOTER (frosted bar) ─────────────────────────────── -->
            <Border Grid.Row="2"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,8"
                    Padding="18,8"
                    CornerRadius="10"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource MenuHoverBrush}">
                <TextBlock FontSize="{StaticResource TextBody}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Opacity="0.8"
                           HorizontalAlignment="Center">
                    <Run Text="{DynamicResource Splash.Copyright}"/>
                    <Run Text="{DynamicResource Splash.V}"/>
                    <Run Text="{x:Static updates:AppInfo.Version}"/>
                    <Run Text="{DynamicResource Splash.BarautUttarPradeshIndia}"/>
                </TextBlock>
            </Border>
        </Grid>

        <!-- ═══ LOGIN GATE — same window as splash (no second window) ═══ -->
        <Grid x:Name="LoginHost"
              Visibility="Collapsed"
              Opacity="0"
              Panel.ZIndex="11">
            <login:LoginPanel x:Name="LoginGate"/>
        </Grid>

        <!-- ═══ FIRST-RUN SETUP GATE — Commit 5 of the licensing ═══
             refactor. Replaces the pre-login Welcome and the
             admin/admin seed. Shown when AuditService reports
             an empty Users table (fresh install). On a
             successful create, the splash swaps the
             LoginPanel in via the SetupHost's Created event. -->
        <Grid x:Name="SetupHost"
              Visibility="Collapsed"
              Opacity="0"
              Panel.ZIndex="12">
            <login:FirstRunSetupPanel x:Name="SetupGate"/>
        </Grid>

        <!-- ═══ TERMS GATE — FULL PAGE (crystal scrim) ═══ -->
        <Grid x:Name="TermsPanel"
              Background="{DynamicResource WindowBackgroundBrush}"
              Visibility="Collapsed"
              Opacity="0"
              Panel.ZIndex="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        Margin="0,46,0,0">
                <TextBlock Text="{DynamicResource Splash.TermsTitle}"
                           FontSize="{StaticResource TextDisplayLarge}" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource PrimaryForegroundBrush}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="14"
                                          ShadowDepth="0" Opacity="0.6"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="{DynamicResource Splash.UaeIntro}"
                           FontSize="{StaticResource TextBodyLarge}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <Rectangle Height="1" Width="360" Margin="0,18,0,0"
                           Opacity="0.5" Fill="{DynamicResource AccentBrush}"/>
            </StackPanel>

            <!-- Crystal terms card -->
            <Border Grid.Row="1"
                    MaxWidth="980"
                    Margin="60,26,60,10"
                    Padding="42,34"
                    CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource ElevatedSurfaceBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <TextBlock Foreground="{DynamicResource SecondaryForegroundBrush}"
                               FontSize="{StaticResource TextBodyLarge}"
                               LineHeight="25"
                               TextWrapping="Wrap">
                        <Run Text="{DynamicResource Splash.Term1}" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Splash.SoftwareAssistsPreparingTaxInvoicesRecords}"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term2}" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Splash.UAETaxLawRequiresAccountingRecordsTax}"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term3}" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Splash.FederalDecreeLawNo462021Electronic}"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term4}" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Splash.FederalDecreeLawNo452021ProtectionPersonal}"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term5}" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Splash.GrantedNonTransferableLicenceUseSoftware}"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term6}" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Splash.AgreeUseSoftwareProduceFalseMisleading}"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term7}" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Splash.SoftwareProvidedWithoutWarrantyKindExpress}"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term8}" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Splash.UpdatesMayOfferedTimeTimeInstallingChoice}"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="{DynamicResource Splash.Term9}" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Splash.TermsGovernedLawsUnitedArabEmiratesEmirate}"/>
                    </TextBlock>
                </ScrollViewer>
            </Border>

            <!-- Crystal accept bar -->
            <Border CornerRadius="{DynamicResource CardCornerRadius}" Grid.Row="2"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="60,20"
                    Background="{DynamicResource MenuHoverBrush}">
                <DockPanel LastChildFill="True" MaxWidth="980">
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,8,0,0">
                        <Button x:Name="DeclineButton"
                                Content="{DynamicResource Splash.DeclineExit}"
                                MinWidth="150" Height="42"
                                Margin="0,0,12,0"
                                Style="{StaticResource TermsDeclineButtonStyle}"
                                Click="DeclineTerms_Click"/>
                        <Button x:Name="ContinueButton"
                                Content="{DynamicResource Splash.AcceptContinue}"
                                MinWidth="190" Height="42"
                                IsEnabled="False"
                                Style="{StaticResource TermsContinueButtonStyle}"
                                Click="ContinueFromTerms_Click"/>
                    </StackPanel>
                    <CheckBox x:Name="AcceptTermsCheck"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource SecondaryForegroundBrush}"
                              FontSize="{StaticResource TextBodyLarge}"
                              Cursor="Hand"
                              Margin="0,8,0,0"
                              Checked="AcceptTerms_Changed"
                              Unchecked="AcceptTerms_Changed">
                        <TextBlock Text="{DynamicResource Splash.AcceptText}"
                                   TextWrapping="Wrap"/>
                    </CheckBox>
                </DockPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
