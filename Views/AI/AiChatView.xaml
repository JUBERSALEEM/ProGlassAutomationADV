<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/AI/AiChatView.xaml
     PROJECT: ProGlassAutomation
     MODULE: AI Chat (Chat 25 v4.0 — StatusMessage visibility fix)

     CHANGES vs Chat 25 v3.0:
       ✓ FIX CRITICAL: StatusMessage Border had default Visibility=Collapsed
         and the only trigger also set Collapsed on empty string. Nothing
         could ever make it Visible — user never saw voice status feedback.
         FIX: Default Visible, collapse ONLY when StatusMessage is null
         or empty string. Now shows "Listening...", "Processing speech...",
         "Voice recognized — press Enter" etc.
       ✓ ALL other XAML preserved exactly.
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.AI.AiChatView"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Focusable="False">

    <UserControl.Resources>

        <LinearGradientBrush x:Key="ChatBrand"
                             StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource AccentDarkColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource AccentColor}" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="PanelShadow"
                          BlurRadius="24" ShadowDepth="4"
                          Opacity="0.35" Color="Black"
                          po:Freeze="True"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="20" ShadowDepth="4"
                          Color="{DynamicResource AccentColor}" Opacity="0.5"/>

        <Style x:Key="ChatIconBtn" TargetType="Button">
            <Setter Property="FontFamily"      Value="Segoe MDL2 Assets"/>
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd"
                                        Property="Background"
                                        Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SendBtn" TargetType="Button">
            <Setter Property="Width"           Value="42"/>
            <Setter Property="Height"          Value="42"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                Background="{StaticResource ChatBrand}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <TextBlock Text="&#xE724;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="White"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd"
                                        Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd"
                                        Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UserBubble" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MaxWidth"            Value="380"/>
            <Setter Property="CornerRadius"        Value="16,16,4,16"/>
            <Setter Property="Padding"             Value="14,10"/>
            <Setter Property="Margin"              Value="60,4,0,4"/>
            <Setter Property="Background"          Value="{StaticResource ChatBrand}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding"   Value="True"/>
            <Setter Property="Visibility"          Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AiBubble" TargetType="Border">
        <Setter Property="BorderBrush"     Value="{DynamicResource OutlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MaxWidth"            Value="380"/>
            <Setter Property="CornerRadius"        Value="16,16,16,4"/>
            <Setter Property="Padding"             Value="14,10"/>
            <Setter Property="Margin"              Value="0,4,60,4"/>
            <Setter Property="Background"
                    Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding"   Value="True"/>
            <Setter Property="Visibility"          Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAiResponse}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ErrBubble" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MaxWidth"            Value="380"/>
            <Setter Property="CornerRadius"        Value="16,16,16,4"/>
            <Setter Property="Padding"             Value="14,10"/>
            <Setter Property="Margin"              Value="0,4,60,4"/>
            <Setter Property="Background"          Value="{DynamicResource TintRedBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding"   Value="True"/>
            <Setter Property="Visibility"          Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuggChip" TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="CornerRadius"        Value="12"/>
            <Setter Property="Padding"             Value="14,9"/>
            <Setter Property="Margin"              Value="0,3"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding"   Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource OutlineBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>

        <Rectangle Fill="Black" Opacity="0.3"
                   MouseLeftButtonDown="DimOverlay_MouseLeftButtonDown">
            <Rectangle.Style>
                <Style TargetType="Rectangle">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Rectangle.Style>
        </Rectangle>

        <!--
            VOICE-FIX: The panel keeps its 600 px design height, but
            MaxHeight is clamped to (window height − 130) so on short
            windows the panel SHRINKS instead of overflowing past the
            top edge. Previously the header and the voice-assistant
            input row were clipped off-screen ("voice assistant gets
            hidden"). The messages row (*) absorbs the shrink; the
            mic/speaker/status rows always stay visible.
        -->
        <!-- Draggable AI service window. Its position is set in code
             (AiChatView.xaml.cs) so the user can drag it out of the way. -->
        <Canvas x:Name="ChatCanvas">
        <Border x:Name="ChatPanel"
                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Width="420" Height="600"
                MaxHeight="{Binding ActualHeight,
                            RelativeSource={RelativeSource AncestorType=Window},
                            Converter={StaticResource WindowInsetConverter},
                            ConverterParameter=130}"
                CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                Background="{DynamicResource SideMenuBackgroundBrush}"
                Effect="{StaticResource PanelShadow}"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header — drag handle for the whole AI window -->
                <Border x:Name="ChatHeader"
                        Grid.Row="0"
                        CornerRadius="12,12,0,0"
                        Padding="16,12"
                        Background="{StaticResource ChatBrand}"
                        Cursor="SizeAll"
                        SnapsToDevicePixels="True"
                        MouseLeftButtonDown="ChatHeader_MouseLeftButtonDown"
                        MouseMove="ChatHeader_MouseMove"
                        MouseLeftButtonUp="ChatHeader_MouseLeftButtonUp">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="38" Height="38"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                Background="#33FFFFFF"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <TextBlock Text="&#xE99A;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="ProGlass AI"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="White"
                                       IsHitTestVisible="False"/>
                            <TextBlock Text="{Binding ActiveProviderSubtitle}"
                                       FontSize="10"
                                       Foreground="#E0E0FF"
                                       Opacity="0.9"
                                       IsHitTestVisible="False"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Style="{StaticResource ChatIconBtn}"
                                Content="&#xE74D;"
                                ToolTip="Clear chat"
                                Command="{Binding ClearChatCommand}"/>

                        <Button Grid.Column="3"
                                Style="{StaticResource ChatIconBtn}"
                                Content="&#xE711;"
                                ToolTip="Close"
                                Margin="6,0,0,0"
                                Command="{Binding CloseChatCommand}"/>
                    </Grid>
                </Border>

                <!-- Messages area -->
                <Grid Grid.Row="1">

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="30">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMessages}"
                                                 Value="False">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Border Width="72" Height="72"
                                CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                                HorizontalAlignment="Center"
                                Background="{StaticResource ChatBrand}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Border>

                        <TextBlock Text="Hello! I'm ProGlass AI"
                                   FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,4"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   IsHitTestVisible="False"/>

                        <TextBlock Text="Ask me about glass production, invoices, job orders, or your business data."
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="300"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   IsHitTestVisible="False"/>

                        <TextBlock Text="TRY ASKING"
                                   FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,8"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Opacity="0.7"
                                   IsHitTestVisible="False"/>

                        <ItemsControl ItemsSource="{Binding Suggestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SuggChip}"
                                            Tag="{Binding}"
                                            MouseLeftButtonDown="Suggestion_MouseLeftButtonDown">
                                        <TextBlock Text="{Binding}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   IsHitTestVisible="False"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ScrollViewer x:Name="MessagesScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  IsDeferredScrollingEnabled="False"
                                  PanningMode="VerticalOnly"
                                  Focusable="False"
                                  behaviors:SmoothScrollBehavior.IsEnabled="True"
                                  Padding="16,12">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMessages}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Border Style="{StaticResource UserBubble}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Text}"
                                                           Foreground="White"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding TimeLabel}"
                                                           Foreground="#FFFFFFAA"
                                                           FontSize="10"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,4,0,0"
                                                           IsHitTestVisible="False"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource AiBubble}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Text}"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,6,0,0">
                                                    <TextBlock FontSize="10"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               IsHitTestVisible="False">
                                                        <Run Text="{Binding ProviderIcon, Mode=OneWay}"/>
                                                        <Run Text=" via "/>
                                                        <Run Text="{Binding ProviderName, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding TimeLabel, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource ErrBubble}">
                                            <TextBlock Text="{Binding Text}"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- ═══════════════════════════════════════════════
                         v3 THINKING INDICATOR — ANIMATED
                         Previous: three static dots — the user could not
                         tell whether the AI was working at all.
                         Now: staggered bouncing dots while IsBusy, plus
                         a ✕ Stop button bound to StopGenerationCommand.
                         Hidden while streaming (the live bubble below
                         takes over once tokens arrive).
                    ════════════════════════════════════════════════ -->
                    <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource MenuHoverBrush}"
                            CornerRadius="12,12,12,4"
                            Padding="14,10"
                            Margin="16,0,0,8"
                            SnapsToDevicePixels="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasActiveStream}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.Resources>
                            <!-- Bounce animation, staggered per dot -->
                            <!-- MC3072-safe: DoubleAnimation has no Values
                                 property — keyframes are the proven pattern
                                 in this file (commit 08e6187). -->
                            <Storyboard x:Key="DotBounce1"
                                        RepeatBehavior="Forever">
                                <DoubleAnimationUsingKeyFrames
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                    BeginTime="0:0:0">
                                    <LinearDoubleKeyFrame Value="0"
                                                          KeyTime="0:0:0"/>
                                    <LinearDoubleKeyFrame Value="-4"
                                                          KeyTime="0:0:0.45"/>
                                    <LinearDoubleKeyFrame Value="0"
                                                          KeyTime="0:0:0.9"/>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                            <!-- MC3072-safe: DoubleAnimation has no Values
                                 property — keyframes are the proven pattern
                                 in this file (commit 08e6187). -->
                            <Storyboard x:Key="DotBounce2"
                                        RepeatBehavior="Forever">
                                <DoubleAnimationUsingKeyFrames
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                    BeginTime="0:0:0.15">
                                    <LinearDoubleKeyFrame Value="0"
                                                          KeyTime="0:0:0"/>
                                    <LinearDoubleKeyFrame Value="-4"
                                                          KeyTime="0:0:0.45"/>
                                    <LinearDoubleKeyFrame Value="0"
                                                          KeyTime="0:0:0.9"/>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                            <!-- MC3072-safe: DoubleAnimation has no Values
                                 property — keyframes are the proven pattern
                                 in this file (commit 08e6187). -->
                            <Storyboard x:Key="DotBounce3"
                                        RepeatBehavior="Forever">
                                <DoubleAnimationUsingKeyFrames
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                    BeginTime="0:0:0.3">
                                    <LinearDoubleKeyFrame Value="0"
                                                          KeyTime="0:0:0"/>
                                    <LinearDoubleKeyFrame Value="-4"
                                                          KeyTime="0:0:0.45"/>
                                    <LinearDoubleKeyFrame Value="0"
                                                          KeyTime="0:0:0.9"/>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </Border.Resources>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource SecondaryForegroundBrush}"
                                     Margin="2,0"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}"
                                                         Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard Storyboard="{StaticResource DotBounce1}"/>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource SecondaryForegroundBrush}"
                                     Margin="2,0" Opacity="0.75"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}"
                                                         Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard Storyboard="{StaticResource DotBounce2}"/>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource SecondaryForegroundBrush}"
                                     Margin="2,0" Opacity="0.5"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}"
                                                         Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard Storyboard="{StaticResource DotBounce3}"/>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Button Command="{Binding StopGenerationCommand}"
                                    Width="18" Height="18"
                                    Margin="10,0,0,0"
                                    Content="&#xE711;" FontSize="9"
                                    Background="Transparent"
                                    BorderThickness="0" Cursor="Hand"
                                    Foreground="{DynamicResource MutedForegroundBrush}"
                                    ToolTip="Stop generating"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══════════════════════════════════════════════
                         v3 LIVE STREAMING BUBBLE — shows the answer
                         token-by-token while Gemini streams it.
                         Bound to ActiveStream (StreamingChatMessage).
                    ════════════════════════════════════════════════ -->
                    <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource MenuHoverBrush}"
                            CornerRadius="12,12,12,4"
                            Padding="14,10"
                            Margin="16,0,0,8"
                            MaxWidth="430"
                            SnapsToDevicePixels="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActiveStream}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ActiveStream.Text}"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>

                <!--
                     ═══════════════════════════════════════════════════
                     STATUS MESSAGE ROW — FIXED VISIBILITY
                     
                     Previous: Default Visibility=Collapsed, and only
                     trigger also set Collapsed on empty. Nothing could
                     ever make it Visible. User never saw voice feedback.
                     
                     Fixed: Default Visible, collapse ONLY when
                     StatusMessage is null OR empty string.
                     
                     Shows messages like:
                       "🎤 Listening — click again to stop"
                       "Processing speech..."
                       "✓ Recognized: what is my balance"
                       "✓ Voice recognized — press Enter to send"
                       "Recording too short — speak for at least 1 second"
                       "⚠ Whisper unavailable: Model file corrupted..."
                     ═══════════════════════════════════════════════════
                -->
                <Border Grid.Row="2" Padding="16,4,16,2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusMessage}"
                                             Value="">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusMessage}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               TextWrapping="Wrap"
                               IsHitTestVisible="False"/>
                </Border>

                <!-- Input area -->
                <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Grid.Row="3"
                        Background="{DynamicResource SideMenuBackgroundBrush}"
                        CornerRadius="0,0,12,12"
                        Padding="12"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Speaker toggle -->
                        <Button Grid.Column="0"
                                Command="{Binding ToggleSpeakerCommand}"
                                ToolTip="Toggle voice responses"
                                Width="36" Height="36"
                                Cursor="Hand"
                                BorderThickness="0"
                                Margin="0,0,4,0"
                                SnapsToDevicePixels="True">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            CornerRadius="{DynamicResource CardCornerRadius}"
                                            SnapsToDevicePixels="True"
                                            UseLayoutRounding="True">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource MenuHoverBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSpeakerOn}"
                                                                 Value="True">
                                                        <Setter Property="Background"
                                                                Value="{StaticResource ChatBrand}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE74F;"/>
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSpeakerOn}"
                                                                     Value="True">
                                                            <Setter Property="Text" Value="&#xE767;"/>
                                                            <Setter Property="Foreground"
                                                                    Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd"
                                                    Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Mic button with audio level pulse -->
                        <Grid Grid.Column="1" Margin="0,0,6,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVoiceAvailable}"
                                                     Value="False">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Ellipse Width="44" Height="44"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="#22EF4444"
                                     Opacity="{Binding MicAudioLevel}"
                                     IsHitTestVisible="False"/>

                            <!-- v2: continuous LISTENING pulse ring.
                                 Pulses while IsListening=True so the user
                                 always knows the mic is live, even in
                                 silence (MicAudioLevel alone stays 0). -->
                            <Ellipse Width="44" Height="44"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     StrokeThickness="2.5"
                                     Stroke="{DynamicResource DangerBrush}"
                                     Fill="Transparent"
                                     RenderTransformOrigin="0.5,0.5"
                                     IsHitTestVisible="False">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="PulseScale"
                                                    ScaleX="0.8" ScaleY="0.8"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Opacity" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="ListenPulse">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity"
                                                                                           Duration="0:0:1.2">
                                                                <LinearDoubleKeyFrame Value="0.85" KeyTime="0:0:0"/>
                                                                <LinearDoubleKeyFrame Value="0.15" KeyTime="0:0:0.6"/>
                                                                <LinearDoubleKeyFrame Value="0.85" KeyTime="0:0:1.2"/>
                                                            </DoubleAnimationUsingKeyFrames>
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Ellipse.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                           Duration="0:0:1.2">
                                                                <LinearDoubleKeyFrame Value="0.8" KeyTime="0:0:0"/>
                                                                <LinearDoubleKeyFrame Value="1.35" KeyTime="0:0:0.6"/>
                                                                <LinearDoubleKeyFrame Value="0.8" KeyTime="0:0:1.2"/>
                                                            </DoubleAnimationUsingKeyFrames>
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Ellipse.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                           Duration="0:0:1.2">
                                                                <LinearDoubleKeyFrame Value="0.8" KeyTime="0:0:0"/>
                                                                <LinearDoubleKeyFrame Value="1.35" KeyTime="0:0:0.6"/>
                                                                <LinearDoubleKeyFrame Value="0.8" KeyTime="0:0:1.2"/>
                                                            </DoubleAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="ListenPulse"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <Button Command="{Binding VoiceInputCommand}"
                                    ToolTip="Voice input (click to speak, click again to stop)"
                                    Width="36" Height="36"
                                    Cursor="Hand"
                                    BorderThickness="0"
                                    SnapsToDevicePixels="True">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd"
                                                CornerRadius="{DynamicResource CardCornerRadius}"
                                                SnapsToDevicePixels="True"
                                                UseLayoutRounding="True">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource MenuHoverBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsListening}"
                                                                     Value="True">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsProcessingVoice}"
                                                                     Value="True">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                       FontSize="16"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE720;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsListening}"
                                                                         Value="True">
                                                                <Setter Property="Text" Value="&#xE71A;"/>
                                                                <Setter Property="Foreground"
                                                                        Value="White"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsProcessingVoice}"
                                                                         Value="True">
                                                                <Setter Property="Text" Value="&#xE895;"/>
                                                                <Setter Property="Foreground"
                                                                        Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd"
                                                        Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Text input -->
                        <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" Grid.Column="2"
                                Background="{DynamicResource MenuHoverBrush}"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                Padding="14,0"
                                Height="42"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <TextBox x:Name="InputBox"
                                     Text="{Binding CurrentInput,
                                         UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="13"
                                     Foreground="{DynamicResource PrimaryForegroundBrush}"
                                     VerticalAlignment="Center"
                                     KeyDown="InputBox_KeyDown"/>
                        </Border>

                        <Button Grid.Column="3"
                                Style="{StaticResource SendBtn}"
                                Command="{Binding SendCommand}"
                                ToolTip="Send (Enter)"/>
                    </Grid>
                </Border>

            </Grid>
        </Border>
        </Canvas>

        <!-- 2026-08-25: the bottom-right FloatingBot was REMOVED. Its
             custom mouse-capture drag code crashed the app for some
             users and the transform clamp made it look immovable. The
             AI bot now lives in the top panel (AiBotButton in
             MainWindow.xaml, before the AI AGENT pill) and toggles the
             exact same chat via AiChatVM.ToggleChatCommand. -->

    </Grid>
</UserControl>