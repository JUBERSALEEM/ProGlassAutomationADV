<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/AI/AiChatView.xaml
     PROJECT: ProGlassAutomation
     MODULE: AI Chat (Chat 25 v4.0 — StatusMessage visibility fix)

     CHANGES vs Chat 25 v3.0:
       ✓ FIX CRITICAL: StatusMessage Border had default Visibility=Collapsed
         and the only trigger also set Collapsed on empty string. Nothing
         could ever make it Visible — user never saw voice status feedback.
         FIX: Default Visible, collapse ONLY when StatusMessage is null
         or empty string. Now shows "Listening...", "Processing speech...",
         "Voice recognized — press Enter" etc.
       ✓ ALL other XAML preserved exactly.
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.AI.AiChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Focusable="False">

    <UserControl.Resources>

        <LinearGradientBrush x:Key="ChatBrand"
                             StartPoint="0,0" EndPoint="1,1"
                             po:Freeze="True">
            <GradientStop Color="#1E3A8A" Offset="0"/>
            <GradientStop Color="#1D4ED8" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="PanelShadow"
                          BlurRadius="24" ShadowDepth="4"
                          Opacity="0.35" Color="Black"
                          po:Freeze="True"/>

        <DropShadowEffect x:Key="BtnShadow"
                          BlurRadius="20" ShadowDepth="4"
                          Color="#1D4ED8" Opacity="0.5"
                          po:Freeze="True"/>

        <Style x:Key="ChatIconBtn" TargetType="Button">
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd"
                                        Property="Background"
                                        Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SendBtn" TargetType="Button">
            <Setter Property="Width"           Value="42"/>
            <Setter Property="Height"          Value="42"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                CornerRadius="21"
                                Background="{StaticResource ChatBrand}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <TextBlock Text="➤"
                                       Foreground="White"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd"
                                        Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd"
                                        Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UserBubble" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MaxWidth"            Value="380"/>
            <Setter Property="CornerRadius"        Value="16,16,4,16"/>
            <Setter Property="Padding"             Value="14,10"/>
            <Setter Property="Margin"              Value="60,4,0,4"/>
            <Setter Property="Background"          Value="{StaticResource ChatBrand}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding"   Value="True"/>
            <Setter Property="Visibility"          Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AiBubble" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MaxWidth"            Value="380"/>
            <Setter Property="CornerRadius"        Value="16,16,16,4"/>
            <Setter Property="Padding"             Value="14,10"/>
            <Setter Property="Margin"              Value="0,4,60,4"/>
            <Setter Property="Background"
                    Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding"   Value="True"/>
            <Setter Property="Visibility"          Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAiResponse}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ErrBubble" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MaxWidth"            Value="380"/>
            <Setter Property="CornerRadius"        Value="16,16,16,4"/>
            <Setter Property="Padding"             Value="14,10"/>
            <Setter Property="Margin"              Value="0,4,60,4"/>
            <Setter Property="Background"          Value="#FEE2E2"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding"   Value="True"/>
            <Setter Property="Visibility"          Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuggChip" TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="CornerRadius"        Value="12"/>
            <Setter Property="Padding"             Value="14,9"/>
            <Setter Property="Margin"              Value="0,3"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding"   Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource BorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>

        <Rectangle Fill="Black" Opacity="0.3"
                   MouseLeftButtonDown="DimOverlay_MouseLeftButtonDown">
            <Rectangle.Style>
                <Style TargetType="Rectangle">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Rectangle.Style>
        </Rectangle>

        <!--
            VOICE-FIX: The panel keeps its 600 px design height, but
            MaxHeight is clamped to (window height − 130) so on short
            windows the panel SHRINKS instead of overflowing past the
            top edge. Previously the header and the voice-assistant
            input row were clipped off-screen ("voice assistant gets
            hidden"). The messages row (*) absorbs the shrink; the
            mic/speaker/status rows always stay visible.
        -->
        <Border Width="420" Height="600"
                MaxHeight="{Binding ActualHeight,
                            RelativeSource={RelativeSource AncestorType=Window},
                            Converter={StaticResource WindowInsetConverter},
                            ConverterParameter=130}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,25,95"
                CornerRadius="20"
                Background="{DynamicResource SideMenuBackgroundBrush}"
                Effect="{StaticResource PanelShadow}"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        CornerRadius="20,20,0,0"
                        Padding="16,12"
                        Background="{StaticResource ChatBrand}"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="38" Height="38"
                                CornerRadius="19"
                                Background="#33FFFFFF"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <TextBlock Text="🤖" FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="ProGlass AI"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="White"
                                       IsHitTestVisible="False"/>
                            <TextBlock Text="{Binding ActiveProviderSubtitle}"
                                       FontSize="10"
                                       Foreground="#E0E0FF"
                                       Opacity="0.9"
                                       IsHitTestVisible="False"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Style="{StaticResource ChatIconBtn}"
                                Content="🗑"
                                ToolTip="Clear chat"
                                Command="{Binding ClearChatCommand}"/>

                        <Button Grid.Column="3"
                                Style="{StaticResource ChatIconBtn}"
                                Content="✕"
                                ToolTip="Close"
                                Margin="6,0,0,0"
                                Command="{Binding CloseChatCommand}"/>
                    </Grid>
                </Border>

                <!-- Messages area -->
                <Grid Grid.Row="1">

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="30">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMessages}"
                                                 Value="False">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Border Width="72" Height="72"
                                CornerRadius="20"
                                HorizontalAlignment="Center"
                                Background="{StaticResource ChatBrand}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <TextBlock Text="💬" FontSize="36"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Border>

                        <TextBlock Text="Hello! I'm ProGlass AI"
                                   FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,4"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   IsHitTestVisible="False"/>

                        <TextBlock Text="Ask me about glass production, invoices, job orders, or your business data."
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="300"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   IsHitTestVisible="False"/>

                        <TextBlock Text="TRY ASKING"
                                   FontSize="9" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,8"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Opacity="0.7"
                                   IsHitTestVisible="False"/>

                        <ItemsControl ItemsSource="{Binding Suggestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SuggChip}"
                                            Tag="{Binding}"
                                            MouseLeftButtonDown="Suggestion_MouseLeftButtonDown">
                                        <TextBlock Text="{Binding}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   IsHitTestVisible="False"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ScrollViewer x:Name="MessagesScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  IsDeferredScrollingEnabled="False"
                                  PanningMode="VerticalOnly"
                                  Focusable="False"
                                  behaviors:SmoothScrollBehavior.IsEnabled="True"
                                  Padding="16,12">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMessages}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Border Style="{StaticResource UserBubble}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Text}"
                                                           Foreground="White"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding TimeLabel}"
                                                           Foreground="#FFFFFFAA"
                                                           FontSize="9"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,4,0,0"
                                                           IsHitTestVisible="False"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource AiBubble}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Text}"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,6,0,0">
                                                    <TextBlock FontSize="9"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               IsHitTestVisible="False">
                                                        <Run Text="{Binding ProviderIcon, Mode=OneWay}"/>
                                                        <Run Text=" via "/>
                                                        <Run Text="{Binding ProviderName, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding TimeLabel, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource ErrBubble}">
                                            <TextBlock Text="{Binding Text}"
                                                       Foreground="#991B1B"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource MenuHoverBrush}"
                            CornerRadius="16,16,16,4"
                            Padding="14,10"
                            Margin="16,0,0,8"
                            SnapsToDevicePixels="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource SecondaryForegroundBrush}"
                                     Margin="2,0"/>
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource SecondaryForegroundBrush}"
                                     Margin="2,0" Opacity="0.6"/>
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource SecondaryForegroundBrush}"
                                     Margin="2,0" Opacity="0.3"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!--
                     ═══════════════════════════════════════════════════
                     STATUS MESSAGE ROW — FIXED VISIBILITY
                     
                     Previous: Default Visibility=Collapsed, and only
                     trigger also set Collapsed on empty. Nothing could
                     ever make it Visible. User never saw voice feedback.
                     
                     Fixed: Default Visible, collapse ONLY when
                     StatusMessage is null OR empty string.
                     
                     Shows messages like:
                       "🎤 Listening — click again to stop"
                       "Processing speech..."
                       "✓ Recognized: what is my balance"
                       "✓ Voice recognized — press Enter to send"
                       "Recording too short — speak for at least 1 second"
                       "⚠ Whisper unavailable: Model file corrupted..."
                     ═══════════════════════════════════════════════════
                -->
                <Border Grid.Row="2" Padding="16,4,16,2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusMessage}"
                                             Value="">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusMessage}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               TextWrapping="Wrap"
                               IsHitTestVisible="False"/>
                </Border>

                <!-- Input area -->
                <Border Grid.Row="3"
                        Background="{DynamicResource SideMenuBackgroundBrush}"
                        CornerRadius="0,0,20,20"
                        Padding="12"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Speaker toggle -->
                        <Button Grid.Column="0"
                                Command="{Binding ToggleSpeakerCommand}"
                                ToolTip="Toggle voice responses"
                                Width="36" Height="36"
                                Cursor="Hand"
                                BorderThickness="0"
                                Margin="0,0,4,0"
                                SnapsToDevicePixels="True">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            CornerRadius="18"
                                            SnapsToDevicePixels="True"
                                            UseLayoutRounding="True">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource MenuHoverBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSpeakerOn}"
                                                                 Value="True">
                                                        <Setter Property="Background"
                                                                Value="{StaticResource ChatBrand}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="🔇"/>
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSpeakerOn}"
                                                                     Value="True">
                                                            <Setter Property="Text" Value="🔊"/>
                                                            <Setter Property="Foreground"
                                                                    Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd"
                                                    Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Mic button with audio level pulse -->
                        <Grid Grid.Column="1" Margin="0,0,6,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVoiceAvailable}"
                                                     Value="False">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Ellipse Width="44" Height="44"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="#22EF4444"
                                     Opacity="{Binding MicAudioLevel}"
                                     IsHitTestVisible="False"/>

                            <Button Command="{Binding VoiceInputCommand}"
                                    ToolTip="Voice input (click to speak, click again to stop)"
                                    Width="36" Height="36"
                                    Cursor="Hand"
                                    BorderThickness="0"
                                    SnapsToDevicePixels="True">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd"
                                                CornerRadius="18"
                                                SnapsToDevicePixels="True"
                                                UseLayoutRounding="True">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource MenuHoverBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsListening}"
                                                                     Value="True">
                                                            <Setter Property="Background"
                                                                    Value="#EF4444"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsProcessingVoice}"
                                                                     Value="True">
                                                            <Setter Property="Background"
                                                                    Value="#F59E0B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="16"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="🎤"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsListening}"
                                                                         Value="True">
                                                                <Setter Property="Text" Value="⏹"/>
                                                                <Setter Property="Foreground"
                                                                        Value="White"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsProcessingVoice}"
                                                                         Value="True">
                                                                <Setter Property="Text" Value="⏳"/>
                                                                <Setter Property="Foreground"
                                                                        Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd"
                                                        Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Text input -->
                        <Border Grid.Column="2"
                                Background="{DynamicResource MenuHoverBrush}"
                                CornerRadius="21"
                                Padding="14,0"
                                Height="42"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <TextBox x:Name="InputBox"
                                     Text="{Binding CurrentInput,
                                         UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="13"
                                     Foreground="{DynamicResource PrimaryForegroundBrush}"
                                     VerticalAlignment="Center"
                                     KeyDown="InputBox_KeyDown"/>
                        </Border>

                        <Button Grid.Column="3"
                                Style="{StaticResource SendBtn}"
                                Command="{Binding SendCommand}"
                                ToolTip="Send (Enter)"/>
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- Floating toggle button -->
        <Button HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,25,25"
                Width="60" Height="60"
                Cursor="Hand"
                BorderThickness="0"
                Command="{Binding ToggleChatCommand}"
                ToolTip="AI Assistant">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            CornerRadius="30"
                            Background="{StaticResource ChatBrand}"
                            Effect="{StaticResource BtnShadow}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <TextBlock x:Name="icon"
                                   Text="🤖"
                                   FontSize="26"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd"
                                    Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                            <Setter TargetName="icon" Property="Text" Value="✕"/>
                            <Setter TargetName="icon" Property="FontSize" Value="20"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

    </Grid>
</UserControl>