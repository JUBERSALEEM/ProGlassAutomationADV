<UserControl x:Class="ProGlassAutomation.Views.AI.AiChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             Focusable="False">

    <UserControl.Resources>
        <!-- Icon button style -->
        <Style x:Key="ChatIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Send button style -->
        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="21">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                    <GradientStop Color="#EC4899" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#10148;"
                                       Foreground="White"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- User bubble style -->
        <Style x:Key="UserBubbleStyle" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MaxWidth" Value="320"/>
            <Setter Property="CornerRadius" Value="16,16,4,16"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="60,4,0,4"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#8B5CF6" Offset="0"/>
                        <GradientStop Color="#EC4899" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- AI bubble style -->
        <Style x:Key="AiBubbleStyle" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MaxWidth" Value="320"/>
            <Setter Property="CornerRadius" Value="16,16,16,4"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,4,60,4"/>
            <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsUser}" Value="False"/>
                        <Condition Binding="{Binding IsError}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Error bubble style -->
        <Style x:Key="ErrorBubbleStyle" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MaxWidth" Value="320"/>
            <Setter Property="CornerRadius" Value="16,16,16,4"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,4,60,4"/>
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Dim overlay when chat is open -->
        <Rectangle Fill="Black" Opacity="0.3"
                   MouseLeftButtonDown="DimOverlay_MouseLeftButtonDown">
            <Rectangle.Style>
                <Style TargetType="Rectangle">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Rectangle.Style>
        </Rectangle>

        <!-- =============== CHAT PANEL =============== -->
        <Border Width="400" Height="560"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,25,95"
                CornerRadius="20"
                Background="{DynamicResource SideMenuBackgroundBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Color="Black"/>
            </Border.Effect>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER (gradient) -->
                <Border Grid.Row="0" CornerRadius="20,20,0,0" Padding="16,12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#8B5CF6" Offset="0"/>
                            <GradientStop Color="#EC4899" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar -->
                        <Border Grid.Column="0"
                                Width="38" Height="38"
                                CornerRadius="19"
                                Background="#33FFFFFF"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#129302;" FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ProGlass AI"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="Powered by Gemini"
                                       FontSize="10"
                                       Foreground="#E0E0FF"
                                       Opacity="0.9"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Style="{StaticResource ChatIconButtonStyle}"
                                Content="&#128465;"
                                ToolTip="Clear chat"
                                Command="{Binding ClearChatCommand}"/>

                        <Button Grid.Column="3"
                                Style="{StaticResource ChatIconButtonStyle}"
                                Content="&#10005;"
                                ToolTip="Close"
                                Margin="6,0,0,0"
                                Command="{Binding CloseChatCommand}"/>
                    </Grid>
                </Border>

                <!-- MESSAGES AREA -->
                <Grid Grid.Row="1">

                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="30">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMessages}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Border Width="72" Height="72"
                                CornerRadius="20"
                                HorizontalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                    <GradientStop Color="#EC4899" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#128172;"
                                       FontSize="36"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Hello! I'm ProGlass AI"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,4"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="Ask me about glass production, invoices, or how to use ProGlass Automation."
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="280"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                        <TextBlock Text="TRY ASKING"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,8"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Opacity="0.7"/>
                        <Border Background="{DynamicResource MenuHoverBrush}"
                                CornerRadius="10" Padding="12,8" Margin="0,3">
                            <TextBlock Text="What's the best glass for a shower door?"
                                       FontSize="12"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </Border>
                        <Border Background="{DynamicResource MenuHoverBrush}"
                                CornerRadius="10" Padding="12,8" Margin="0,3">
                            <TextBlock Text="How do I create a proforma invoice?"
                                       FontSize="12"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </Border>
                        <Border Background="{DynamicResource MenuHoverBrush}"
                                CornerRadius="10" Padding="12,8" Margin="0,3">
                            <TextBlock Text="Explain the tempering process"
                                       FontSize="12"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Messages list -->
                    <ScrollViewer x:Name="MessagesScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="16,12">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMessages}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <!-- USER bubble -->
                                        <Border Style="{StaticResource UserBubbleStyle}">
                                            <TextBlock Text="{Binding Text}"
                                                       Foreground="White"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"/>
                                        </Border>

                                        <!-- AI bubble (normal) -->
                                        <Border Style="{StaticResource AiBubbleStyle}">
                                            <TextBlock Text="{Binding Text}"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"/>
                                        </Border>

                                        <!-- Error bubble -->
                                        <Border Style="{StaticResource ErrorBubbleStyle}">
                                            <TextBlock Text="{Binding Text}"
                                                       Foreground="#991B1B"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Typing indicator -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Background="{DynamicResource MenuHoverBrush}"
                            CornerRadius="16,16,16,4"
                            Padding="14,10"
                            Margin="16,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource SecondaryForegroundBrush}" Margin="2,0"/>
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource SecondaryForegroundBrush}" Margin="2,0" Opacity="0.6"/>
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource SecondaryForegroundBrush}" Margin="2,0" Opacity="0.3"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- INPUT AREA -->
                <Border Grid.Row="2"
                        Background="{DynamicResource SideMenuBackgroundBrush}"
                        CornerRadius="0,0,20,20"
                        Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource MenuHoverBrush}"
                                CornerRadius="21"
                                Padding="14,0"
                                Height="42"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                            <TextBox x:Name="InputBox"
                                     Text="{Binding CurrentInput, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="13"
                                     Foreground="{DynamicResource PrimaryForegroundBrush}"
                                     VerticalAlignment="Center"
                                     KeyDown="InputBox_KeyDown"/>
                        </Border>

                        <Button Grid.Column="1"
                                Style="{StaticResource SendButtonStyle}"
                                Command="{Binding SendCommand}"
                                ToolTip="Send (Enter)"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- =============== FLOATING CHAT BUTTON =============== -->
        <Button HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,25,25"
                Width="60" Height="60"
                Cursor="Hand"
                BorderThickness="0"
                Command="{Binding ToggleChatCommand}"
                ToolTip="AI Assistant">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" CornerRadius="30">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#8B5CF6" Offset="0"/>
                                <GradientStop Color="#EC4899" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4"
                                              Color="#8B5CF6" Opacity="0.5"/>
                        </Border.Effect>
                        <TextBlock x:Name="icon"
                                   Text="&#129302;"
                                   FontSize="26"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                            <Setter TargetName="icon" Property="Text" Value="&#10005;"/>
                            <Setter TargetName="icon" Property="FontSize" Value="20"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>