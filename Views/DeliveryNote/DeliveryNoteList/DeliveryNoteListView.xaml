<!-- Delivery Note list — industrial table chrome. Tab names, click handlers, group/row commands unchanged. -->
<UserControl x:Class="ProGlassAutomation.Views.DeliveryNote.DeliveryNoteList.DeliveryNoteListView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState"
             xmlns:loading="clr-namespace:ProGlassAutomation.Controls.LoadingState"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
>

    <UserControl.Resources>

        

        <DataTemplate x:Key="JoGroupRowTemplate">
            <Border
                    Cursor="Hand"
                    MinHeight="64"
                    MouseLeftButtonUp="OnGroupRowLeftClick"
                    MouseRightButtonUp="OnGroupRowRightClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AllDelivered}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,8,8,8">
                        <TextBlock Text="{Binding JobOrderId}"
                                   FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock FontSize="{DynamicResource FontSize.BodySmall}" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{DynamicResource DeliveryNote.Latest}"/><Run Text="{Binding LatestDeliveryDateDisplay, Mode=OneWay}"/>
                            <Run Text="  ·  "/><Run Text="{Binding LatestDriverName, Mode=OneWay}"/>
                            <Run Text="  ·  "/><Run Text="{Binding LatestDnId, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,8">
                        <TextBlock Text="{Binding CustomerName}"
                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ProjectName}"
                                   FontSize="{DynamicResource FontSize.Body}" Margin="0,2,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0">
                        <TextBlock HorizontalAlignment="Left" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4">
                            <Run Text="{Binding ProgressPercent, Mode=OneWay, StringFormat={}{0:0.#}}"/>
                            <Run Text="{DynamicResource God.Percent}"/>
                        </TextBlock>
                        <Border x:Name="ProgressTrack"
                                CornerRadius="{DynamicResource Radius.XSmall}" Height="6"
                                Background="{DynamicResource BorderBrush}">
                            <Border CornerRadius="{DynamicResource Radius.XSmall}" HorizontalAlignment="Left">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AllDelivered}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                        <Binding Path="ProgressPercent"/>
                                        <Binding Path="ActualWidth" ElementName="ProgressTrack"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="8,0"
                               FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource SecondaryForegroundBrush}">
                        <Run Text="{Binding TotalOrdered, Mode=OneWay}" FontWeight="{DynamicResource Weight.SemiBold}"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding TotalDelivered, Mode=OneWay}" FontWeight="{DynamicResource Weight.SemiBold}"
                             Foreground="{DynamicResource SuccessBrush}"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding TotalBalance, Mode=OneWay}" FontWeight="{DynamicResource Weight.SemiBold}"
                             Foreground="{DynamicResource WarningBrush}"/>
                    </TextBlock>

                    <TextBlock Grid.Column="5" VerticalAlignment="Center" Margin="8,0"
                               FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource SecondaryForegroundBrush}">
                        <Run Text="{Binding TotalOrderedSqm, Mode=OneWay, StringFormat={}{0:0.000}}" FontWeight="{DynamicResource Weight.SemiBold}"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding TotalDeliveredSqm, Mode=OneWay, StringFormat={}{0:0.000}}" FontWeight="{DynamicResource Weight.SemiBold}"
                             Foreground="{DynamicResource SuccessBrush}"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding TotalBalanceSqm, Mode=OneWay, StringFormat={}{0:0.000}}" FontWeight="{DynamicResource Weight.SemiBold}"
                             Foreground="{DynamicResource WarningBrush}"/>
                    </TextBlock>

                    <StackPanel Grid.Column="6" VerticalAlignment="Center" Margin="8,6">
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="{DynamicResource ControlCornerRadius}" Padding="7,2" Margin="0,0,4,0"
                                    Background="{Binding StatusTintKey,
                                                 Converter={StaticResource BrushKeyConverter}}" Style="{StaticResource SurfacePrimaryStyle}">
                                <TextBlock Text="{Binding StatusLabel}" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{Binding StatusForegroundKey,
                                                        Converter={StaticResource BrushKeyConverter}}"/>
                            </Border>
                            <Border Background="{DynamicResource TintIndigoBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="7,2" Style="{StaticResource SurfacePrimaryStyle}">
                                <TextBlock FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="{Binding DnCount, Mode=OneWay}"/><Run Text="{DynamicResource DeliveryNote.Dns}"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <WrapPanel Margin="0,4,0,0">
                            <Border Background="{DynamicResource TintAmberBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="7,2" Margin="0,0,4,2"
                                    Visibility="{Binding HasFoc,
                                                 Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource SurfacePrimaryStyle}">
                                <TextBlock Text="{DynamicResource Dnl.Foc}" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource WarningBrush}"/>
                            </Border>
                            <Border Background="{DynamicResource TintAmberBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="7,2" Margin="0,0,4,2"
                                    Visibility="{Binding HasRework,
                                                 Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource SurfacePrimaryStyle}">
                                <TextBlock Text="{DynamicResource God.Rework}" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource WarningBrush}"/>
                            </Border>
                            <Border Background="{DynamicResource TintRedBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="7,2" Margin="0,0,4,2"
                                    Visibility="{Binding HasReturn,
                                                 Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource SurfacePrimaryStyle}">
                                <TextBlock Text="{DynamicResource Dnl.Return}" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource DangerBrush}"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="7"
                                VerticalAlignment="Center"
                                Margin="8,6,10,6">
                        <Button Style="{StaticResource RowPrimaryButton}"
                                Tag="&#xE710;" Content="{DynamicResource Dnl.NewDn}"
                                ToolTip="{DynamicResource Dnl.NewDnHint}"
                                Command="{Binding DataContext.CreateDnForJobOrderCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding JobOrderId}"/>
                        <Button Style="{StaticResource RowSuccessButton}"
                                Tag="&#xE8A5;" Content="{DynamicResource Dnl.Invoice}"
                                Margin="0,6,0,0"
                                ToolTip="{DynamicResource Dnl.InvoiceHint}"
                                Command="{Binding DataContext.GenerateMasterInvoiceCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        

    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,4,4,12">
            <Grid Margin="4,0,4,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Dnl.Title}" Style="{StaticResource ModulePageTitleStyle}"/>
                    <TextBlock Text="{DynamicResource Dnl.Subtitle}"
                               Style="{StaticResource ModulePageSubtitleStyle}"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource PrimaryPillButton}"
                        Tag="&#xE7F4;" Content="{DynamicResource Dnl.CreateDn}"
                        Command="{Binding CreateDnCommand}"
                        VerticalAlignment="Center"
                        ToolTip="{DynamicResource Dnl.CreateDnHint}"/>
            </Grid>

            <loading:LoadingStateControl
                    Visibility="{Binding IsLoading,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Message="Loading delivery notes…"
                    Margin="4,0,4,10"/>

            <Border Visibility="{Binding HasError,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                   
                    Padding="14" Margin="4,0,4,10">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="{DynamicResource FontSize.Body}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Margin="4,0,4,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource TintBlueBrush}">
                                <TextBlock Text="&#xE7B8;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.H3}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HeroCard1Label}" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding HeroCard1Value}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource TintAmberBrush}">
                                <TextBlock Text="&#xE81C;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.H3}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HeroCard2Label}" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding HeroCard2Value}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="3"/>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource TintAmberBrush}">
                                <TextBlock Text="&#xE713;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.H3}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HeroCard3Label}" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding HeroCard3Value}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="5"/>
                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource TintRedBrush}">
                                <TextBlock Text="&#xE72C;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.H3}"
                                           Foreground="{DynamicResource DangerBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HeroCard4Label}" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding HeroCard4Value}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="7"/>
                        <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource TintGreenBrush}">
                                <TextBlock Text="{Binding HeroCard5Icon}" FontSize="{DynamicResource FontSize.H3}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HeroCard5Label}" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding HeroCard5Value}" Style="{StaticResource ModuleListKpiValueStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="{DynamicResource TintIndigoBrush}"
                        Padding="12,8"
                        Visibility="{Binding HasSelection,
                                     Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Dnl.Selected}"
                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedDnMetaLine}"
                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Button Grid.Column="2" Style="{StaticResource RowOutlinedButton}"
                                Tag="&#xE711;" Content="{DynamicResource God.Clear}"
                                ToolTip="{DynamicResource Dnl.ClearSelection}"
                                Command="{Binding ClearSelectionCommand}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource ModuleListFilterBarStyle}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                 Style="{StaticResource ModuleListFilterInputStyle}"
                                 Margin="0,0,8,0"
                                 ToolTip="{DynamicResource Dnl.Search}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding StatusFilterOptions}"
                                  SelectedItem="{Binding SelectedStatusFilter}"
                                  Style="{StaticResource ModuleListFilterComboStyle}"
                                  Margin="0,0,8,0"/>
                        <CheckBox Grid.Column="2"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"
                                  IsChecked="{Binding ShowVoided}"
                                  Content="{DynamicResource Void.ShowVoided}"
                                  ToolTip="{DynamicResource Void.ShowVoidedTip}"/>
                        <Button Grid.Column="3" Style="{StaticResource OutlinedPillButton}"
                                Tag="&#xE711;" Content="{DynamicResource God.Clear}"
                                Margin="0,0,8,0"
                                ToolTip="{DynamicResource Dnl.ClearFilters}"
                                Command="{Binding ClearFiltersCommand}"/>
                        <Button Grid.Column="4" Style="{StaticResource PrimaryPillButton}"
                                Tag="&#xE72C;" Content="{DynamicResource God.Refresh}"
                                ToolTip="{DynamicResource Dnl.RefreshList}"
                                Command="{Binding RefreshCommand}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="8,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0" GroupName="DnStatusTabs" Tag="&#xE7B8;" Content="{DynamicResource Dnl.All}"
                            CommandParameter="{Binding AllGroupedCount}"
                            IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=0}"
                            Style="{StaticResource Tab.Inactive}"/>
                    <RadioButton Grid.Column="1" GroupName="DnStatusTabs" Tag="&#xE70F;" Content="{DynamicResource Dnl.Prepared}"
                            CommandParameter="{Binding PreparedGroupedCount}"
                            IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=1}"
                            Style="{StaticResource Tab.Inactive}"/>
                    <RadioButton Grid.Column="2" GroupName="DnStatusTabs" Tag="&#xE73E;" Content="{DynamicResource Dnl.Delivered}"
                            CommandParameter="{Binding DeliveredGroupedCount}"
                            IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=2}"
                            Style="{StaticResource Tab.Inactive}"/>
                    <RadioButton Grid.Column="3" GroupName="DnStatusTabs" Tag="&#xE81C;" Content="{DynamicResource Dnl.Pending}"
                            CommandParameter="{Binding PendingItems.Count}"
                            IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=3}"
                            Style="{StaticResource Tab.Inactive}"/>
                    <RadioButton Grid.Column="4" GroupName="DnStatusTabs" Tag="&#xE713;" Content="{DynamicResource God.Rework}"
                            CommandParameter="{Binding ReworkGroupedCount}"
                            IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=4}"
                            Style="{StaticResource Tab.Inactive}"/>
                    <RadioButton Grid.Column="5" GroupName="DnStatusTabs" Tag="&#xE7A7;" Content="{DynamicResource Dnl.Returned}"
                            CommandParameter="{Binding ReturnedGroupedCount}"
                            IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=5}"
                            Style="{StaticResource Tab.Inactive}"/>
                </Grid>

                <Border Grid.Row="4">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource ModuleListTableHeaderStyle}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Dnl.JobOrder}" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="2" Text="{DynamicResource Dnl.CustomerProject}" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="3" Text="{DynamicResource Dnl.Progress}" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="4" Text="{DynamicResource Dnl.QtyOrdDelBal}" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="5" Text="{DynamicResource God.Sqm}" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="6" Text="{DynamicResource Dnl.Status}" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="5">

                    <!-- TAB 0: ALL -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ListBox ItemsSource="{Binding AllItemsGrouped}"
                                 ItemTemplate="{StaticResource JoGroupRowTemplate}"
                                 ItemContainerStyle="{StaticResource SurfaceDetailStyle}"
                                 BorderThickness="{DynamicResource Border.NoneThickness}" Background="Transparent"
                                 Focusable="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingStackPanel.ScrollUnit="Pixel"
                                 VirtualizingStackPanel.CacheLength="200,400"
                                 VirtualizingStackPanel.CacheLengthUnit="Pixel"
                                 behaviors:SmoothScrollBehavior.IsEnabled="True">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding AllItems.Count}" Value="0"/>
                                                <Condition Binding="{Binding IsLoading}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <emptyState:EmptyStateControl
                                Icon="&#xE7F4;"
                                Title="{DynamicResource Dnl.EmptyAll}"
                                Message="Delivery notes record what leaves the factory — quantities, driver, vehicle and status. NEW DN opens remaining balance only. Dispatched notes are opened from God View."/>
                        </StackPanel>
                    </Grid>

                    <!-- TAB 1: PREPARED -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ListBox ItemsSource="{Binding PreparedItemsGrouped}"
                                 ItemTemplate="{StaticResource JoGroupRowTemplate}"
                                 ItemContainerStyle="{StaticResource SurfaceDetailStyle}"
                                 BorderThickness="{DynamicResource Border.NoneThickness}" Background="Transparent"
                                 Focusable="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingStackPanel.CacheLength="200,400"
                                 VirtualizingStackPanel.CacheLengthUnit="Pixel"
                                 VirtualizingStackPanel.ScrollUnit="Pixel"
                                 behaviors:SmoothScrollBehavior.IsEnabled="True">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreparedItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <emptyState:EmptyStateControl
                                Icon="&#xE70F;"
                                Title="{DynamicResource Dnl.EmptyPrepared}"
                                Message="Notes you prepare (not dispatched yet) wait in this tab until they go out."/>
                        </StackPanel>
                    </Grid>

                    <!-- TAB 2: DELIVERED -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ListBox ItemsSource="{Binding DeliveredItemsGrouped}"
                                 ItemTemplate="{StaticResource JoGroupRowTemplate}"
                                 ItemContainerStyle="{StaticResource SurfaceDetailStyle}"
                                 BorderThickness="{DynamicResource Border.NoneThickness}" Background="Transparent"
                                 Focusable="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingStackPanel.CacheLength="200,400"
                                 VirtualizingStackPanel.CacheLengthUnit="Pixel"
                                 VirtualizingStackPanel.ScrollUnit="Pixel"
                                 behaviors:SmoothScrollBehavior.IsEnabled="True">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DeliveredItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <emptyState:EmptyStateControl
                                Icon="&#xE73E;"
                                Title="{DynamicResource Dnl.EmptyDelivered}"
                                Message="Notes move to this tab once their status becomes Delivered / Signed / Received."/>
                        </StackPanel>
                    </Grid>

                    <!-- TAB 3: PENDING -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ListBox ItemsSource="{Binding PendingItems}"
                                 ItemContainerStyle="{StaticResource SurfaceDetailStyle}"
                                 BorderThickness="{DynamicResource Border.NoneThickness}" Background="Transparent"
                                 Focusable="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingStackPanel.CacheLength="200,400"
                                 VirtualizingStackPanel.CacheLengthUnit="Pixel"
                                 VirtualizingStackPanel.ScrollUnit="Pixel"
                                 behaviors:SmoothScrollBehavior.IsEnabled="True">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SurfaceSecondaryStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="200"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding JobOrderId}"
                                                           FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.Bold}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock FontSize="{DynamicResource FontSize.Body}" Margin="0,4,0,0"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}">
                                                    <Run Text="{Binding CustomerName, Mode=OneWay}"/>
                                                    <Run Text="  ·  "/>
                                                    <Run Text="{Binding ProjectName, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="{DynamicResource FontSize.Body}" Margin="0,5,0,0"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}">
                                                    <Run Text="{Binding ProgressDisplay, Mode=OneWay}" FontWeight="{DynamicResource Weight.SemiBold}"/>
                                                    <Run Text="{DynamicResource DeliveryNote.Balance}"/>
                                                    <Run Text="{Binding TotalBalance, Mode=OneWay}" FontWeight="{DynamicResource Weight.Bold}"/>
                                                    <Run Text=" pcs"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <TextBlock HorizontalAlignment="Right" Margin="0,0,0,4"
                                                           FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                                    <Run Text="{Binding ProgressPercent, Mode=OneWay, StringFormat={}{0:0.#}}"/>
                                                    <Run Text="{DynamicResource God.Percent}"/>
                                                </TextBlock>
                                                <Border x:Name="PendingTrack"
                                                        CornerRadius="{DynamicResource Radius.XSmall}" Height="6"
                                                        Background="{DynamicResource BorderBrush}" Style="{StaticResource SurfacePrimaryStyle}">
                                                    <Border CornerRadius="{DynamicResource Radius.XSmall}"
                                                            HorizontalAlignment="Left"
                                                            Background="{DynamicResource AccentBrush}" Style="{StaticResource SurfacePrimaryStyle}">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                                                <Binding Path="ProgressPercent"/>
                                                                <Binding Path="ActualWidth" ElementName="PendingTrack"/>
                                                            </MultiBinding>
                                                        </Border.Width>
                                                    </Border>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PendingItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <emptyState:EmptyStateControl
                                Icon="&#xE81C;"
                                Title="{DynamicResource Dnl.NoPending}"
                                Message="This tab lists job orders that still have undelivered pieces. When everything is delivered, it stays empty."/>
                        </StackPanel>
                    </Grid>

                    <!-- TAB 4: REWORK -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="4">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ListBox ItemsSource="{Binding ReworkItemsGrouped}"
                                 ItemTemplate="{StaticResource JoGroupRowTemplate}"
                                 ItemContainerStyle="{StaticResource SurfaceDetailStyle}"
                                 BorderThickness="{DynamicResource Border.NoneThickness}" Background="Transparent"
                                 Focusable="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingStackPanel.CacheLength="200,400"
                                 VirtualizingStackPanel.CacheLengthUnit="Pixel"
                                 VirtualizingStackPanel.ScrollUnit="Pixel"
                                 behaviors:SmoothScrollBehavior.IsEnabled="True">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ReworkItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <emptyState:EmptyStateControl
                                Icon="&#xE713;"
                                Title="{DynamicResource Dnl.NoRework}"
                                Message="Delivery notes of type Rework — glass coming back for reprocessing — are listed here."/>
                        </StackPanel>
                    </Grid>

                    <!-- TAB 5: RETURNED -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="5">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ListBox ItemsSource="{Binding ReturnedItemsGrouped}"
                                 ItemTemplate="{StaticResource JoGroupRowTemplate}"
                                 ItemContainerStyle="{StaticResource SurfaceDetailStyle}"
                                 BorderThickness="{DynamicResource Border.NoneThickness}" Background="Transparent"
                                 Focusable="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingStackPanel.CacheLength="200,400"
                                 VirtualizingStackPanel.CacheLengthUnit="Pixel"
                                 VirtualizingStackPanel.ScrollUnit="Pixel"
                                 behaviors:SmoothScrollBehavior.IsEnabled="True">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ReturnedItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <emptyState:EmptyStateControl
                                Icon="&#xE7A7;"
                                Title="{DynamicResource Dnl.NoReturned}"
                                Message="Delivery notes of type Return — glass sent back by the customer — are listed here."/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
