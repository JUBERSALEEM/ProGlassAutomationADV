<UserControl x:Class="ProGlassAutomation.Views.DeliveryNote.DeliveryNoteList.DeliveryNoteListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hero="clr-namespace:ProGlassAutomation.Controls.GradientHeroCard"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="OnLoaded">

    <UserControl.Resources>

        <!-- ══════════════════════════════════════════════════════════════
             DN ROW CARD — type-colored left accent bar
        ══════════════════════════════════════════════════════════════ -->
        <Style x:Key="DnRowCardStyle" TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{Binding TypeBrushKey,
                            Converter={StaticResource BrushKeyConverter}}"/>
            <Setter Property="BorderThickness" Value="4,1,1,1"/>
            <Setter Property="CornerRadius"    Value="14"/>
            <Setter Property="Padding"         Value="18,14"/>
            <Setter Property="Margin"          Value="0,0,0,10"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="0"
                                              Opacity="0.10" Color="#0F4C3A"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4338CA" Offset="0"/>
                                <GradientStop Color="#6366F1" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="0"
                                              Opacity="0.30" Color="#4338CA"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ── Pending row card ──────────────────────────────────────── -->
        <Style x:Key="PendingRowCardStyle" TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource TintAmberBrush}"/>
            <Setter Property="BorderThickness" Value="4,1,1,1"/>
            <Setter Property="CornerRadius"    Value="14"/>
            <Setter Property="Padding"         Value="18,14"/>
            <Setter Property="Margin"          Value="0,0,0,10"/>
        </Style>

        <!-- ── Tab card button — inactive ───────────────────────────── -->
        <Style x:Key="TabCardInactiveStyle" TargetType="Button">
            <Setter Property="Background"
                    Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="16,12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="Icon"
                                           Text="{TemplateBinding Tag}"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           Opacity="0.6"/>
                                <TextBlock x:Name="Count"
                                           Text="{TemplateBinding CommandParameter}"
                                           FontSize="22" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                           Opacity="0.7"/>
                                <TextBlock x:Name="Label"
                                           Text="{TemplateBinding Content}"
                                           FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card"
                                        Property="Background"
                                        Value="{DynamicResource MenuHoverBrush}"/>
                                <Setter TargetName="Card"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Tab card button — active ─────────────────────────────── -->
        <Style x:Key="TabCardActiveStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="16,12">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4338CA" Offset="0"/>
                                    <GradientStop Color="#6366F1" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#EEF2FF" Offset="0"/>
                                    <GradientStop Color="#E0E7FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="0"
                                                  Opacity="0.15" Color="#4338CA"/>
                            </Border.Effect>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontSize="20"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{TemplateBinding CommandParameter}"
                                           FontSize="22" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0">
                                    <TextBlock.Foreground>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#4338CA" Offset="0"/>
                                            <GradientStop Color="#6366F1" Offset="1"/>
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0">
                                    <TextBlock.Foreground>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#4338CA" Offset="0"/>
                                            <GradientStop Color="#6366F1" Offset="1"/>
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Open button ───────────────────────────────────────────── -->
        <Style x:Key="OpenButtonStyle" TargetType="Button">
            <Setter Property="Background"
                    Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource OnAccentForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="16,6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="OPEN"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Header action button — Phase 10.7a Create DN ──────────── -->
        <Style x:Key="HeaderActionButtonStyle" TargetType="Button">
            <Setter Property="Background"
                    Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource OnAccentForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg"
                                        Property="Background"
                                        Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,30">

            <!-- ── PAGE HEADER ─────────────────────────────────────────── -->
            <Grid Margin="8,0,8,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Delivery Notes"
                               FontSize="30" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="Track glass deliveries, partial shipments and balance quantities"
                               FontSize="13" Margin="0,4,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="🚚  Create DN"
                        Command="{Binding CreateDnCommand}"
                        Style="{StaticResource HeaderActionButtonStyle}"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0"
                        ToolTip="Pick a Job Order and create a Draft Delivery Note"/>
            </Grid>

            <!-- ── LOADING / ERROR ─────────────────────────────────────── -->
            <Border Visibility="{Binding IsLoading,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Padding="12" Margin="8,0,8,12">
                <TextBlock Text="⏳  Loading delivery notes…"
                           FontSize="13" HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </Border>

            <Border Visibility="{Binding HasError,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{DynamicResource TintRedBrush}"
                    CornerRadius="12" Padding="16" Margin="8,0,8,12">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="13" TextWrapping="Wrap"/>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 KPI HERO CARDS
            ══════════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <hero:GradientHeroCard Grid.Column="0"
                           Icon="📦"
                           Value="{Binding HeroCard1Value}"
                           Label="{Binding HeroCard1Label}"
                           GradientStartColor="#4338CA"
                           GradientEndColor="#6366F1"
                           Margin="6" MinHeight="130"/>

                <hero:GradientHeroCard Grid.Column="1"
                           Icon="⏳"
                           Value="{Binding HeroCard2Value}"
                           Label="{Binding HeroCard2Label}"
                           GradientStartColor="#B45309"
                           GradientEndColor="#F59E0B"
                           Margin="6" MinHeight="130"/>

                <Border Grid.Column="2"
            Background="{DynamicResource TintAmberBrush}"
            CornerRadius="16" Padding="18" Margin="6">
                    <StackPanel>
                        <Border Width="42" Height="42" CornerRadius="11"
                    Background="{DynamicResource WarningBrush}"
                    HorizontalAlignment="Left">
                            <TextBlock Text="🔧" FontSize="20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding HeroCard3Value}"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                       Margin="0,12,0,0"
                       TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding HeroCard3Label}"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       Margin="0,4,0,0"
                       TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3"
            Background="{DynamicResource TintRedBrush}"
            CornerRadius="16" Padding="18" Margin="6">
                    <StackPanel>
                        <Border Width="42" Height="42" CornerRadius="11"
                    Background="{DynamicResource DangerBrush}"
                    HorizontalAlignment="Left">
                            <TextBlock Text="↩️" FontSize="20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding HeroCard4Value}"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                       Margin="0,12,0,0"
                       TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding HeroCard4Label}"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       Margin="0,4,0,0"
                       TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4"
            Background="{DynamicResource TintGreenBrush}"
            CornerRadius="16" Padding="18" Margin="6">
                    <StackPanel>
                        <Border Width="42" Height="42" CornerRadius="11"
                    Background="{DynamicResource SuccessBrush}"
                    HorizontalAlignment="Left">
                            <TextBlock Text="{Binding HeroCard5Icon}"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding HeroCard5Value}"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                       Margin="0,12,0,0"
                       TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding HeroCard5Label}"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       Margin="0,4,0,0"
                       TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── SELECTED DN META LINE ──────────────────────────────── -->
            <Border Margin="8,0,8,16"
                    Padding="14,10"
                    CornerRadius="10"
                    Background="{DynamicResource TintIndigoBrush}"
                    Visibility="{Binding HasSelection,
                                 Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="🔍  Selected:"
                               FontSize="12" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding SelectedDnMetaLine}"
                               FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>

                    <Button Grid.Column="2"
                            Content="✕ Clear"
                            Command="{Binding ClearSelectionCommand}"
                            FontSize="10" FontWeight="Bold"
                            Padding="10,4"
                            Cursor="Hand"
                            Background="{DynamicResource ModuleBackgroundBrush}"
                            Foreground="{DynamicResource PrimaryForegroundBrush}"
                            BorderThickness="0"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 CARD TAB HEADERS
            ══════════════════════════════════════════════════════════ -->
            <Grid Margin="8,0,8,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Tag="📦"
                        Content="ALL"
                        CommandParameter="{Binding TotalCount}"
                        Margin="0,0,3,0"
                        Click="OnTabCardClick"
                        x:Name="TabAll">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource TabCardActiveStyle}"/>
                    </Button.Style>
                </Button>

                <Button Grid.Column="1"
                        Tag="📝"
                        Content="PREPARED"
                        CommandParameter="{Binding PreparedItems.Count}"
                        Margin="3,0,3,0"
                        Click="OnTabCardClick"
                        x:Name="TabPrepared"
                        Style="{StaticResource TabCardInactiveStyle}"/>

                <Button Grid.Column="2"
                        Tag="✅"
                        Content="DELIVERED"
                        CommandParameter="{Binding DeliveredItems.Count}"
                        Margin="3,0,3,0"
                        Click="OnTabCardClick"
                        x:Name="TabDelivered"
                        Style="{StaticResource TabCardInactiveStyle}"/>

                <Button Grid.Column="3"
                        Tag="⏳"
                        Content="PENDING QTY"
                        CommandParameter="{Binding PendingItems.Count}"
                        Margin="3,0,3,0"
                        Click="OnTabCardClick"
                        x:Name="TabPending"
                        Style="{StaticResource TabCardInactiveStyle}"/>

                <Button Grid.Column="4"
                        Tag="🔧"
                        Content="REWORK"
                        CommandParameter="{Binding ReworkItems.Count}"
                        Margin="3,0,3,0"
                        Click="OnTabCardClick"
                        x:Name="TabRework"
                        Style="{StaticResource TabCardInactiveStyle}"/>

                <Button Grid.Column="5"
                        Tag="↩️"
                        Content="RETURNED"
                        CommandParameter="{Binding ReturnedItems.Count}"
                        Margin="3,0,0,0"
                        Click="OnTabCardClick"
                        x:Name="TabReturned"
                        Style="{StaticResource TabCardInactiveStyle}"/>

            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 TAB CONTENT PANELS
            ══════════════════════════════════════════════════════════ -->

            <!-- ── TAB 0: ALL ───────────────────────────────────────────── -->
            <StackPanel Margin="0,4,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- Filter bar -->
                <Border Background="{DynamicResource ModuleBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="14"
                        Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchText,
                                        UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="12" Padding="10,8"
                                 Margin="0,0,8,0"
                                 VerticalContentAlignment="Center"/>

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding StatusFilterOptions}"
                                  SelectedItem="{Binding SelectedStatusFilter}"
                                  FontSize="12" Margin="0,0,8,0"
                                  VerticalContentAlignment="Center"/>

                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding TypeFilterOptions}"
                                  SelectedItem="{Binding SelectedTypeFilter}"
                                  FontSize="12" Margin="0,0,8,0"
                                  VerticalContentAlignment="Center"/>

                        <Button Grid.Column="3"
                                Content="Clear"
                                Command="{Binding ClearFiltersCommand}"
                                FontSize="11" FontWeight="SemiBold"
                                Padding="14,8" Margin="0,0,8,0"
                                Cursor="Hand"
                                Background="{DynamicResource MenuHoverBrush}"
                                Foreground="{DynamicResource PrimaryForegroundBrush}"
                                BorderThickness="0"/>

                        <Button Grid.Column="4"
                                Content="🔄"
                                Command="{Binding RefreshCommand}"
                                FontSize="14" Padding="10,6"
                                Cursor="Hand"
                                Background="{DynamicResource MenuHoverBrush}"
                                Foreground="{DynamicResource PrimaryForegroundBrush}"
                                BorderThickness="0"
                                ToolTip="Refresh list"/>
                    </Grid>
                </Border>

                <!-- DN rows -->
                <ItemsControl ItemsSource="{Binding AllItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DnRowCardStyle}"
                                    MouseRightButtonUp="OnRowRightClick"
                                    MouseLeftButtonUp="OnRowLeftClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left info -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DeliveryNoteId}"
                                                       FontSize="15" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                            <Border CornerRadius="6" Padding="6,2"
                                                    Margin="8,0,0,0"
                                                    Background="{DynamicResource TintAmberBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFoc}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="FOC" FontSize="9" FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                            </Border>
                                            <Border CornerRadius="6" Padding="6,2"
                                                    Margin="6,0,0,0"
                                                    Background="{DynamicResource TintGrayBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDummy}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="DUMMY" FontSize="9" FontWeight="Bold"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="📋" FontSize="11"
                                                       Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding JobOrderId}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="  ·  📅 " FontSize="11"
                                                       Margin="6,0,0,0"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DeliveryDateDisplay}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="  ·  🕐 " FontSize="11"
                                                       Margin="6,0,0,0"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DeliveryTime}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border Background="{DynamicResource TintGrayBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12" Padding="10,3"
                                                    Margin="0,0,6,0">
                                                <TextBlock Text="{Binding CustomerName}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                            </Border>
                                            <Border Background="{DynamicResource TintBlueBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12" Padding="10,3"
                                                    Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🚚 " FontSize="10"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DriverName}"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource TintIndigoBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12" Padding="10,3">
                                                <TextBlock Text="{Binding QtySummary}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Status pill — Phase 10.7a: dark text on light tint -->
                                    <Border Grid.Column="1"
                                            CornerRadius="10" Padding="10,4"
                                            VerticalAlignment="Center" Margin="0,0,8,0"
                                            Background="{Binding StatusBrushKey,
                                                         Converter={StaticResource BrushKeyConverter}}">
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    </Border>

                                    <!-- Type pill — Phase 10.7a: dark text on light tint -->
                                    <Border Grid.Column="2"
                                            CornerRadius="10" Padding="10,4"
                                            VerticalAlignment="Center" Margin="0,0,12,0"
                                            Background="{Binding TypeBrushKey,
                                                         Converter={StaticResource BrushKeyConverter}}">
                                        <TextBlock Text="{Binding TypeLabel}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    </Border>

                                    <Button Grid.Column="3"
                                            Style="{StaticResource OpenButtonStyle}"
                                            Command="{Binding DataContext.OpenCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel HorizontalAlignment="Center" Margin="0,50">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding AllItems.Count}" Value="0"/>
                                        <Condition Binding="{Binding IsLoading}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="📦" FontSize="48"
                               HorizontalAlignment="Center" Opacity="0.4"/>
                    <TextBlock Text="No delivery notes yet"
                               FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,4"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="Open a Job Order and create a delivery note from it."
                               FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- ── TAB 1: PREPARED ──────────────────────────────────────── -->
            <StackPanel Margin="0,4,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <ItemsControl ItemsSource="{Binding PreparedItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DnRowCardStyle}"
                                    MouseRightButtonUp="OnRowRightClick"
                                    MouseLeftButtonUp="OnRowLeftClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DeliveryNoteId}"
                                                       FontSize="15" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                            <Border CornerRadius="6" Padding="6,2"
                                                    Margin="8,0,0,0"
                                                    Background="{DynamicResource TintGrayBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDummy}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="DUMMY" FontSize="9" FontWeight="Bold"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock FontSize="12" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}">
                                            <Run Text="{Binding JobOrderId, Mode=OneWay}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding CustomerName, Mode=OneWay}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding QtySummary, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <!-- Type pill — Phase 10.7a: dark text -->
                                    <Border Grid.Column="1"
                                            CornerRadius="10" Padding="10,4"
                                            VerticalAlignment="Center" Margin="0,0,12,0"
                                            Background="{Binding TypeBrushKey,
                                                         Converter={StaticResource BrushKeyConverter}}">
                                        <TextBlock Text="{Binding TypeLabel}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    </Border>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource OpenButtonStyle}"
                                            Command="{Binding DataContext.OpenCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel HorizontalAlignment="Center" Margin="0,40">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PreparedItems.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="📝" FontSize="40" HorizontalAlignment="Center" Opacity="0.4"/>
                    <TextBlock Text="No prepared delivery notes"
                               FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,8,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- ── TAB 2: DELIVERED ─────────────────────────────────────── -->
            <StackPanel Margin="0,4,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <ItemsControl ItemsSource="{Binding DeliveredItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DnRowCardStyle}"
                                    MouseRightButtonUp="OnRowRightClick"
                                    MouseLeftButtonUp="OnRowLeftClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DeliveryNoteId}"
                                                   FontSize="15" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        <TextBlock FontSize="12" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}">
                                            <Run Text="{Binding JobOrderId, Mode=OneWay}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding CustomerName, Mode=OneWay}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding QtySummary, Mode=OneWay}"/>
                                            <Run Text="  ·  🚚 "/>
                                            <Run Text="{Binding DriverName, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <!-- Status pill — Phase 10.7a: dark text -->
                                    <Border Grid.Column="1"
                                            CornerRadius="10" Padding="10,4"
                                            VerticalAlignment="Center" Margin="0,0,12,0"
                                            Background="{Binding StatusBrushKey,
                                                         Converter={StaticResource BrushKeyConverter}}">
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    </Border>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource OpenButtonStyle}"
                                            Command="{Binding DataContext.OpenCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel HorizontalAlignment="Center" Margin="0,40">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DeliveredItems.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="✅" FontSize="40" HorizontalAlignment="Center" Opacity="0.4"/>
                    <TextBlock Text="No delivered notes yet"
                               FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,8,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- ── TAB 3: PENDING QTY ───────────────────────────────────── -->
            <StackPanel Margin="0,4,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <ItemsControl ItemsSource="{Binding PendingItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PendingRowCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding JobOrderId}"
                                                   FontSize="15" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        <TextBlock FontSize="12" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}">
                                            <Run Text="{Binding CustomerName, Mode=OneWay}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding ProjectName, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}">
                                            <Run Text="{Binding ProgressDisplay, Mode=OneWay}"
                                                 FontWeight="SemiBold"/>
                                            <Run Text="  ·  Balance: "/>
                                            <Run Text="{Binding TotalBalance, Mode=OneWay}"
                                                 FontWeight="Bold"/>
                                            <Run Text=" pcs"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="16,0,0,0">
                                        <TextBlock HorizontalAlignment="Right"
                                                   Margin="0,0,0,4"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}">
                                            <Run Text="{Binding ProgressPercent,
                                                        Mode=OneWay,
                                                        StringFormat={}{0:0.#}}"/>
                                            <Run Text="%"/>
                                        </TextBlock>
                                        <Border x:Name="ProgressTrack"
                                                CornerRadius="4" Height="8"
                                                Background="{DynamicResource BorderBrush}">
                                            <Border CornerRadius="4"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource AccentBrush}">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                                        <Binding Path="ProgressPercent"/>
                                                        <Binding Path="ActualWidth"
                                                                 ElementName="ProgressTrack"/>
                                                    </MultiBinding>
                                                </Border.Width>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel HorizontalAlignment="Center" Margin="0,40">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PendingItems.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="⏳" FontSize="40" HorizontalAlignment="Center" Opacity="0.4"/>
                    <TextBlock Text="No pending quantities — all delivered!"
                               FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,8,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- ── TAB 4: REWORK ────────────────────────────────────────── -->
            <StackPanel Margin="0,4,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="4">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <ItemsControl ItemsSource="{Binding ReworkItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DnRowCardStyle}"
                                    MouseRightButtonUp="OnRowRightClick"
                                    MouseLeftButtonUp="OnRowLeftClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DeliveryNoteId}"
                                                   FontSize="15" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        <TextBlock FontSize="12" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}">
                                            <Run Text="{Binding JobOrderId, Mode=OneWay}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding CustomerName, Mode=OneWay}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding QtySummary, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <!-- Status pill — Phase 10.7a: dark text -->
                                    <Border Grid.Column="1"
                                            CornerRadius="10" Padding="10,4"
                                            VerticalAlignment="Center" Margin="0,0,12,0"
                                            Background="{Binding StatusBrushKey,
                                                         Converter={StaticResource BrushKeyConverter}}">
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    </Border>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource OpenButtonStyle}"
                                            Command="{Binding DataContext.OpenCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel HorizontalAlignment="Center" Margin="0,40">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ReworkItems.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="🔧" FontSize="40" HorizontalAlignment="Center" Opacity="0.4"/>
                    <TextBlock Text="No rework delivery notes"
                               FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,8,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- ── TAB 5: RETURNED ──────────────────────────────────────── -->
            <StackPanel Margin="0,4,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="5">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <ItemsControl ItemsSource="{Binding ReturnedItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DnRowCardStyle}"
                                    MouseRightButtonUp="OnRowRightClick"
                                    MouseLeftButtonUp="OnRowLeftClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DeliveryNoteId}"
                                                   FontSize="15" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        <TextBlock FontSize="12" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}">
                                            <Run Text="{Binding JobOrderId, Mode=OneWay}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding CustomerName, Mode=OneWay}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding QtySummary, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <!-- Status pill — Phase 10.7a: dark text -->
                                    <Border Grid.Column="1"
                                            CornerRadius="10" Padding="10,4"
                                            VerticalAlignment="Center" Margin="0,0,12,0"
                                            Background="{Binding StatusBrushKey,
                                                         Converter={StaticResource BrushKeyConverter}}">
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    </Border>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource OpenButtonStyle}"
                                            Command="{Binding DataContext.OpenCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel HorizontalAlignment="Center" Margin="0,40">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ReturnedItems.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="↩️" FontSize="40" HorizontalAlignment="Center" Opacity="0.4"/>
                    <TextBlock Text="No returned delivery notes"
                               FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,8,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>