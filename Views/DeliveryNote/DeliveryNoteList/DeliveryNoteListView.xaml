<!-- MIGRATION LOG — Button Standardization (master prompt v1.0)
     Date: 2026-08-15 — DN/TI/JO batch 4a
     • Shell tabs (Workspace/God View/Activity) -> STEP D two-button
       visibility pattern with MDL2 glyphs (E8B7/E774/E81C)
     • List toolbars: Clear/Refresh/Create -> Row*/Primary pills
     • Row actions (Open/Master Invoice) -> Row* variants
     • Tab-card filter icons: emoji Tags -> MDL2 glyphs + MDL2 font
       on the template icon TextBlocks
     • Hero/Empty-state icon slots -> MDL2 glyphs (controls render
       glyph-or-emoji via IconFontFamilyConverter)
     • Decorative inline meta-text emoji (dates, runs) intentionally
       left for the visual polish pass (not buttons/tabs/badges)
     Commands/bindings/code-behind preserved; no VM changes.
═══════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.DeliveryNote.DeliveryNoteList.DeliveryNoteListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:hero="clr-namespace:ProGlassAutomation.Controls.GradientHeroCard"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="OnLoaded">

    <UserControl.Resources>

        <!-- ══ JO GROUP ROW TEMPLATE ══ -->
        <DataTemplate x:Key="JoGroupRowTemplate">
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12"
                    Margin="0,0,0,8"
                    Cursor="Hand"
                    SnapsToDevicePixels="True"
                    MouseLeftButtonUp="OnGroupRowLeftClick"
                    MouseRightButtonUp="OnGroupRowRightClick">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource MenuHoverBrush}"/>
                                <Setter Property="BorderBrush" Value="#4338CA"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding AllDelivered}" Value="True">
                                <Setter Property="BorderBrush" Value="#047857"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: JO info + badges -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Opacity="0.7"/>
                            <TextBlock Text="{Binding JobOrderId}"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       VerticalAlignment="Center"/>

                            <Border CornerRadius="6" Padding="7,2"
                                    Margin="10,0,0,0" VerticalAlignment="Center"
                                    Background="{DynamicResource TintIndigoBrush}">
                                <TextBlock FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}">
                                    <Run Text="{Binding DnCount, Mode=OneWay}"/>
                                    <Run Text=" DNs"/>
                                </TextBlock>
                            </Border>

                            <Border CornerRadius="6" Padding="7,2"
                                    Margin="6,0,0,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background"
                                                Value="{DynamicResource TintAmberBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AllDelivered}" Value="True">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource TintGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StatusLabel}"
                                           FontSize="9" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#B45309"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AllDelivered}" Value="True">
                                                    <Setter Property="Foreground" Value="#047857"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <Border CornerRadius="6" Padding="7,2"
                                    Margin="6,0,0,0" VerticalAlignment="Center"
                                    Background="{DynamicResource TintAmberBrush}"
                                    Visibility="{Binding HasFoc,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="FOC" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource WarningBrush}"/>
                            </Border>

                            <Border CornerRadius="6" Padding="7,2"
                                    Margin="6,0,0,0" VerticalAlignment="Center"
                                    Background="{DynamicResource TintAmberBrush}"
                                    Visibility="{Binding HasRework,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBlock Text="REWORK" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource WarningBrush}"/></StackPanel>
                            </Border>

                            <Border CornerRadius="6" Padding="7,2"
        Margin="6,0,0,0" VerticalAlignment="Center"
        Background="{DynamicResource TintRedBrush}"
        Visibility="{Binding HasReturn,
                     Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="↩ RETURN" FontSize="9" FontWeight="Bold"
               Foreground="{DynamicResource DangerBrush}"/>
                            </Border>

                            <!-- CHAT 19 INVOICED: Fully Invoiced badge — green -->
                            <Border CornerRadius="6" Padding="7,2"
        Margin="6,0,0,0" VerticalAlignment="Center"
        Background="{DynamicResource TintGreenBrush}"
        Visibility="{Binding IsFullyInvoiced,
                     Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding InvoicedBadgeText}"
               FontSize="9" FontWeight="Bold"
               Foreground="{DynamicResource SuccessBrush}"/>
                            </Border>

                            <!-- CHAT 19 INVOICED: Partial Invoice badge — indigo
     Shown only when HasAnyInvoiced=true AND IsFullyInvoiced=false -->
                            <Border CornerRadius="6" Padding="7,2"
        Margin="6,0,0,0" VerticalAlignment="Center"
        Background="{DynamicResource TintIndigoBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasAnyInvoiced}" Value="True"/>
                                                    <Condition Binding="{Binding IsFullyInvoiced}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding InvoicedBadgeText}"
               FontSize="9" FontWeight="Bold"
               Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="{Binding CustomerName}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="240"/>
                            <TextBlock Text=" · " FontSize="12"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       VerticalAlignment="Center" Margin="4,0"/>
                            <TextBlock Text="{Binding ProjectName}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="280"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="📅 Latest: " FontSize="10"
                                       VerticalAlignment="Center" Opacity="0.7"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <TextBlock Text="{Binding LatestDeliveryDateDisplay}"
                                       FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text=" · 🚚 " FontSize="10"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="6,0,0,0"/>
                            <TextBlock Text="{Binding LatestDriverName}"
                                       FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="140"/>
                            <TextBlock Text=" · Latest DN: " FontSize="10"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="6,0,0,0"/>
                            <TextBlock Text="{Binding LatestDnId}"
                                       FontSize="10" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="200"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- MIDDLE: progress + qty + SQM -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="16,0,16,0">
                        <TextBlock HorizontalAlignment="Right"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   Margin="0,0,0,4">
                            <Run Text="{Binding ProgressPercent,
                                        Mode=OneWay,
                                        StringFormat={}{0:0.#}}"/>
                            <Run Text="%"/>
                        </TextBlock>
                        <Border x:Name="ProgressTrack"
                                CornerRadius="4" Height="8"
                                Background="{DynamicResource BorderBrush}">
                            <Border CornerRadius="4" HorizontalAlignment="Left">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#4338CA"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AllDelivered}" Value="True">
                                                <Setter Property="Background" Value="#047857"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                        <Binding Path="ProgressPercent"/>
                                        <Binding Path="ActualWidth"
                                                 ElementName="ProgressTrack"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Border>

                        <TextBlock HorizontalAlignment="Right"
                                   FontSize="10" Margin="0,5,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}">
                            <Run Text="QTY: " FontWeight="Bold"
                                 Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <Run Text="{Binding TotalOrdered, Mode=OneWay}"
                                 FontWeight="SemiBold"/>
                            <Run Text=" ord · "/>
                            <Run Text="{Binding TotalDelivered, Mode=OneWay}"
                                 FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                            <Run Text=" del · "/>
                            <Run Text="{Binding TotalBalance, Mode=OneWay}"
                                 FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                            <Run Text=" bal"/>
                        </TextBlock>

                        <TextBlock HorizontalAlignment="Right"
           FontSize="10" Margin="0,3,0,0"
           Foreground="{DynamicResource SecondaryForegroundBrush}">
    <Run Text="SQM: " FontWeight="Bold"
         Foreground="{DynamicResource MutedForegroundBrush}"/>
    <Run Text="{Binding TotalOrderedSqm, Mode=OneWay,
                StringFormat={}{0:0.000}}"
         FontWeight="SemiBold"/>
    <Run Text=" ord · "/>
    <Run Text="{Binding TotalDeliveredSqm, Mode=OneWay,
                StringFormat={}{0:0.000}}"
         FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
    <Run Text=" del · "/>
    <Run Text="{Binding TotalBalanceSqm, Mode=OneWay,
                StringFormat={}{0:0.000}}"
         FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
    <Run Text=" bal"/>
                        </TextBlock>

                        <!-- CHAT 19 INVOICED: invoice count line
     Shows "2 of 3 invoiced" when at least one DN is invoiced.
     Hidden when no invoices exist (InvoicedCountDisplay = ""). -->
                        <TextBlock HorizontalAlignment="Right"
           FontSize="10" Margin="0,3,0,0"
           FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAnyInvoiced}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
    <Run Text="🧾 "
         Foreground="{DynamicResource MutedForegroundBrush}"/>
    <Run Text="{Binding InvoicedCountDisplay, Mode=OneWay}">
        <Run.Style>
            <Style TargetType="Run">
                <Setter Property="Foreground" Value="#4338CA"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFullyInvoiced}" Value="True">
                        <Setter Property="Foreground" Value="#047857"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Run.Style>
    </Run>
                        </TextBlock>
                    </StackPanel>

                    <!-- RIGHT: action buttons -->
                    <StackPanel Grid.Column="2"
                                Orientation="Vertical"
                                VerticalAlignment="Center"
                                Width="150">

                        <Button Style="{StaticResource RowPrimaryButton}"
                                Tag="&#xE8B7;" Content="OPEN"
                                ToolTip="Open this delivery note group"
                                Command="{Binding DataContext.OpenGroupCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>

                        <Button Style="{StaticResource RowSuccessButton}"
                                Tag="&#xE8A5;" Content="MASTER INVOICE"
                                ToolTip="Generate Master Tax Invoice for this order."
                                Command="{Binding DataContext.GenerateMasterInvoiceCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ══ LEGACY DN ROW TEMPLATE ══ -->
        <DataTemplate x:Key="DnRowTemplate">
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderThickness="3,1,1,1"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,0,0,6"
                    Cursor="Hand"
                    SnapsToDevicePixels="True"
                    MouseLeftButtonUp="OnRowLeftClick"
                    MouseRightButtonUp="OnRowRightClick">
                <Border.BorderBrush>
                    <Binding Path="TypeBrushKey"
                             Converter="{StaticResource BrushKeyConverter}"/>
                </Border.BorderBrush>
                <Grid>
                    <TextBlock Text="{Binding DeliveryNoteId}"
                               FontSize="12" FontWeight="Bold"/>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="PendingRowCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TintAmberBrush}"/>
            <Setter Property="BorderThickness" Value="3,1,1,1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="DnListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabCardInactiveStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="12,0"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                                           FontSize="15" VerticalAlignment="Center"
                                           Opacity="0.7" Margin="0,0,8,0"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontSize="11" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <Border CornerRadius="10" Padding="7,2"
                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                        Background="{DynamicResource MenuHoverBrush}">
                                    <TextBlock Text="{TemplateBinding CommandParameter}"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background"
                                        Value="{DynamicResource MenuHoverBrush}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="#4338CA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabCardActiveStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="12,0"
                                SnapsToDevicePixels="True">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4338CA" Offset="0"/>
                                    <GradientStop Color="#6366F1" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#EEF2FF" Offset="0"/>
                                    <GradientStop Color="#E0E7FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                                           FontSize="15" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontSize="11" FontWeight="Bold"
                                           VerticalAlignment="Center">
                                    <TextBlock.Foreground>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#4338CA" Offset="0"/>
                                            <GradientStop Color="#6366F1" Offset="1"/>
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <Border CornerRadius="10" Padding="7,2"
                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                        Background="{DynamicResource AccentBrush}">
                                    <TextBlock Text="{TemplateBinding CommandParameter}"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3730A3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ STICKY HEADER ═══ -->
        <StackPanel Grid.Row="0" Margin="24,16,24,0">

            <Grid Margin="4,0,4,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Delivery Notes"
                               Style="{StaticResource ModulePageTitleStyle}"/>
                    <TextBlock Text="One row per Job Order. Click to open the latest split."
                               Style="{StaticResource ModulePageSubtitleStyle}"
                               Margin="0,3,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource PrimaryPillButton}"
                        Tag="&#xE7F4;" Content="CREATE DN"
                        ToolTip="Create a new delivery note"
                        Command="{Binding CreateDnCommand}"/>

                <Button Grid.Column="1" Tag="&#xE70F;" Content="PREPARED"
                        CommandParameter="{Binding PreparedGroupedCount}"
                        Margin="3,0,3,0" Click="OnTabCardClick"
                        x:Name="TabPrepared"
                        Style="{StaticResource TabCardInactiveStyle}"/>

                <Button Grid.Column="2" Tag="&#xE73E;" Content="DELIVERED"
                        CommandParameter="{Binding DeliveredGroupedCount}"
                        Margin="3,0,3,0" Click="OnTabCardClick"
                        x:Name="TabDelivered"
                        Style="{StaticResource TabCardInactiveStyle}"/>

                <Button Grid.Column="3" Tag="&#xE81C;" Content="PENDING"
                        CommandParameter="{Binding PendingItems.Count}"
                        Margin="3,0,3,0" Click="OnTabCardClick"
                        x:Name="TabPending"
                        Style="{StaticResource TabCardInactiveStyle}"/>

                <Button Grid.Column="4" Tag="&#xE713;" Content="REWORK"
                        CommandParameter="{Binding ReworkGroupedCount}"
                        Margin="3,0,3,0" Click="OnTabCardClick"
                        x:Name="TabRework"
                        Style="{StaticResource TabCardInactiveStyle}"/>

                <Button Grid.Column="5" Tag="&#xE7A7;" Content="RETURNED"
                        CommandParameter="{Binding ReturnedGroupedCount}"
                        Margin="3,0,0,0" Click="OnTabCardClick"
                        x:Name="TabReturned"
                        Style="{StaticResource TabCardInactiveStyle}"/>
            </Grid>
        </StackPanel>

        <!-- ═══ TAB CONTENT — 6 tabs only ═══ -->
        <Grid Grid.Row="1" Margin="30,0,30,16">

            <!-- TAB 0: ALL -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- v2: column headings (match the card columns below) -->
                <Border Grid.Row="0"
                        Background="{DynamicResource AccentBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="14,14,0,0"
                        Padding="16,9"
                        Margin="0,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="JOB ORDER  ·  CUSTOMER  ·  PROJECT"
                                   Style="{StaticResource ModuleColumnHeaderStyle}" Foreground="White"/>
                        <TextBlock Grid.Column="1"
                                   Text="DELIVERY PROGRESS"
                                   Style="{StaticResource ModuleColumnHeaderStyle}" Foreground="White"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="2"
                                   Text="QUANTITIES"
                                   Style="{StaticResource ModuleColumnHeaderStyle}" Foreground="White"
                                   Margin="8,0,6,0"/>
                    </Grid>
                </Border>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding AllItemsGrouped}"
                         ItemTemplate="{StaticResource JoGroupRowTemplate}"
                         ItemContainerStyle="{StaticResource DnListBoxItemStyle}"
                         BorderThickness="0" Background="Transparent"
                         Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingStackPanel.ScrollUnit="Pixel"
                         VirtualizingStackPanel.CacheLength="200,400"
                         VirtualizingStackPanel.CacheLengthUnit="Pixel"
                         behaviors:SmoothScrollBehavior.IsEnabled="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding AllItems.Count}" Value="0"/>
                                        <Condition Binding="{Binding IsLoading}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <emptyState:EmptyStateControl
                        Icon="&#xE7F4;"
                        Title="No delivery notes yet"
                        Message="Delivery notes record what leaves the factory — quantities, driver, vehicle and status. Create one from a Job Order ('🚚 Create DN' above) and every shipment will be tracked here."/>
                </StackPanel>
            </Grid>

            <!-- TAB 1: PREPARED -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ListBox ItemsSource="{Binding PreparedItemsGrouped}"
                         ItemTemplate="{StaticResource JoGroupRowTemplate}"
                         ItemContainerStyle="{StaticResource DnListBoxItemStyle}"
                         BorderThickness="0" Background="Transparent"
                         Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingStackPanel.ScrollUnit="Pixel"
                         behaviors:SmoothScrollBehavior.IsEnabled="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PreparedItems.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <emptyState:EmptyStateControl
                        Icon="&#xE70F;"
                        Title="No prepared delivery notes"
                        Message="Notes you prepare (not dispatched yet) wait in this tab until they go out."/>
                </StackPanel>
            </Grid>

            <!-- TAB 2: DELIVERED -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ListBox ItemsSource="{Binding DeliveredItemsGrouped}"
                         ItemTemplate="{StaticResource JoGroupRowTemplate}"
                         ItemContainerStyle="{StaticResource DnListBoxItemStyle}"
                         BorderThickness="0" Background="Transparent"
                         Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingStackPanel.ScrollUnit="Pixel"
                         behaviors:SmoothScrollBehavior.IsEnabled="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DeliveredItems.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <emptyState:EmptyStateControl
                        Icon="&#xE73E;"
                        Title="No delivered notes yet"
                        Message="Notes move to this tab once their status becomes Delivered / Signed / Received."/>
                </StackPanel>
            </Grid>

            <!-- TAB 3: PENDING QTY -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ListBox ItemsSource="{Binding PendingItems}"
                         ItemContainerStyle="{StaticResource DnListBoxItemStyle}"
                         BorderThickness="0" Background="Transparent"
                         Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingStackPanel.ScrollUnit="Pixel"
                         behaviors:SmoothScrollBehavior.IsEnabled="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PendingRowCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding JobOrderId}"
                                                   FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        <TextBlock FontSize="11" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}">
                                            <Run Text="{Binding CustomerName, Mode=OneWay}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding ProjectName, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Margin="0,5,0,0"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}">
                                            <Run Text="{Binding ProgressDisplay, Mode=OneWay}"
                                                 FontWeight="SemiBold"/>
                                            <Run Text="  ·  Balance: "/>
                                            <Run Text="{Binding TotalBalance, Mode=OneWay}"
                                                 FontWeight="Bold"/>
                                            <Run Text=" pcs"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                Margin="16,0,0,0">
                                        <TextBlock HorizontalAlignment="Right"
                                                   Margin="0,0,0,4"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}">
                                            <Run Text="{Binding ProgressPercent,
                                                        Mode=OneWay,
                                                        StringFormat={}{0:0.#}}"/>
                                            <Run Text="%"/>
                                        </TextBlock>
                                        <Border x:Name="PendingTrack"
                                                CornerRadius="4" Height="8"
                                                Background="{DynamicResource BorderBrush}">
                                            <Border CornerRadius="4"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource AccentBrush}">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                                        <Binding Path="ProgressPercent"/>
                                                        <Binding Path="ActualWidth"
                                                                 ElementName="PendingTrack"/>
                                                    </MultiBinding>
                                                </Border.Width>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PendingItems.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <emptyState:EmptyStateControl
                        Icon="⏳"
                        Title="No pending quantities — all delivered!"
                        Message="This tab lists job orders that still have undelivered pieces. When everything is delivered, it stays empty."/>
                </StackPanel>
            </Grid>

            <!-- TAB 4: REWORK -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="4">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ListBox ItemsSource="{Binding ReworkItemsGrouped}"
                         ItemTemplate="{StaticResource JoGroupRowTemplate}"
                         ItemContainerStyle="{StaticResource DnListBoxItemStyle}"
                         BorderThickness="0" Background="Transparent"
                         Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingStackPanel.ScrollUnit="Pixel"
                         behaviors:SmoothScrollBehavior.IsEnabled="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ReworkItems.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <emptyState:EmptyStateControl
                        Icon="&#xE713;"
                        Title="No rework delivery notes"
                        Message="Delivery notes of type Rework — glass coming back for reprocessing — are listed here."/>
                </StackPanel>
            </Grid>

            <!-- TAB 5: RETURNED -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="5">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ListBox ItemsSource="{Binding ReturnedItemsGrouped}"
                         ItemTemplate="{StaticResource JoGroupRowTemplate}"
                         ItemContainerStyle="{StaticResource DnListBoxItemStyle}"
                         BorderThickness="0" Background="Transparent"
                         Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingStackPanel.ScrollUnit="Pixel"
                         behaviors:SmoothScrollBehavior.IsEnabled="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ReturnedItems.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <emptyState:EmptyStateControl
                        Icon="↩️"
                        Title="No returned delivery notes"
                        Message="Delivery notes of type Return — glass sent back by the customer — are listed here."/>
                </StackPanel>
            </Grid>

        </Grid>
    </Grid>
</UserControl>