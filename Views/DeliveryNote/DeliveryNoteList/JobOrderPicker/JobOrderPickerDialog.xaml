<Window x:Class="ProGlassAutomation.Views.DeliveryNote.DeliveryNoteList.JobOrderPicker.JobOrderPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Job Order"
        Width="680" Height="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Border CornerRadius="16"
            Background="{DynamicResource ModuleBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0"
                              Opacity="0.25" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── HEADER ──────────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{DynamicResource AccentBrush}"
                    CornerRadius="16,16,0,0"
                    Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="📋  Select Job Order"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Choose a Job Order to create a Delivery Note from"
                                   FontSize="11" Foreground="White"
                                   Opacity="0.85" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="✕"
                            Click="OnCancelClick"
                            FontSize="14" FontWeight="Bold"
                            Padding="10,4"
                            Cursor="Hand"
                            Background="#22FFFFFF"
                            Foreground="White"
                            BorderThickness="0"/>
                </Grid>
            </Border>

            <!-- ── SEARCH BAR ───────────────────────────────────────────── -->
            <Border Grid.Row="1"
                    Padding="20,14,20,8">
                <TextBox x:Name="SearchBox"
                         Text=""
                         FontSize="13"
                         Padding="10,8"
                         BorderThickness="1"
                         BorderBrush="{DynamicResource BorderBrush}"
                         Background="{DynamicResource ModuleBackgroundBrush}"
                         Foreground="{DynamicResource PrimaryForegroundBrush}"
                         TextChanged="OnSearchChanged"/>
            </Border>

            <!-- ── JO LIST ──────────────────────────────────────────────── -->
            <ScrollViewer Grid.Row="2"
                          Margin="20,0,20,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="JobOrderList"/>
            </ScrollViewer>

            <!-- ── FOOTER ───────────────────────────────────────────────── -->
            <Border Grid.Row="3"
                    Padding="20,12"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               x:Name="SelectedLabel"
                               Text="No job order selected"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                    <Button Grid.Column="1"
                            Content="Cancel"
                            Click="OnCancelClick"
                            FontSize="12" FontWeight="SemiBold"
                            Padding="18,8" Margin="0,0,8,0"
                            Cursor="Hand"
                            Background="{DynamicResource MenuHoverBrush}"
                            Foreground="{DynamicResource PrimaryForegroundBrush}"
                            BorderThickness="0"/>

                    <Button Grid.Column="2"
                            x:Name="ConfirmButton"
                            Content="✅  Create Delivery Note"
                            Click="OnConfirmClick"
                            IsEnabled="False"
                            FontSize="12" FontWeight="Bold"
                            Padding="18,8"
                            Cursor="Hand"
                            BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}"
                                                    Opacity="{TemplateBinding Opacity}">
                                                <ContentPresenter
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>