<Window x:Class="ProGlassAutomation.Views.DeliveryNote.DeliveryNoteList.JobOrderPicker.JobOrderPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Job Order"
        Width="680" Height="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Border CornerRadius="16"
            Background="{DynamicResource ModuleBackgroundBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0"
                              Opacity="0.25" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── HEADER ──────────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{DynamicResource AccentBrush}"
                    CornerRadius="16,16,0,0"
                    Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Select Job Order"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Choose a Job Order to create a Delivery Note from"
                                   FontSize="11" Foreground="White"
                                   Opacity="0.85" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource RowOutlinedButton}"
                            Tag="&#xE711;" MinWidth="40"
                            Click="OnCancelClick"
                            ToolTip="Close (Esc)"/>
                </Grid>
            </Border>

            <!-- ── SEARCH BAR ───────────────────────────────────────────── -->
            <Border Grid.Row="1"
                    Padding="20,14,20,8">
                <TextBox x:Name="SearchBox"
                         Text=""
                         FontSize="13"
                         Padding="10,8"
                         BorderThickness="1"
                         BorderBrush="{DynamicResource BorderBrush}"
                         Background="{DynamicResource ModuleBackgroundBrush}"
                         Foreground="{DynamicResource PrimaryForegroundBrush}"
                         TextChanged="OnSearchChanged"/>
            </Border>

            <!-- ── JO LIST ──────────────────────────────────────────────── -->
            <ScrollViewer Grid.Row="2"
                          Margin="20,0,20,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="JobOrderList"/>
            </ScrollViewer>

            <!-- ── FOOTER ───────────────────────────────────────────────── -->
            <Border CornerRadius="{DynamicResource CardCornerRadius}" Grid.Row="3"
                    Padding="20,12"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               x:Name="SelectedLabel"
                               Text="No job order selected"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                    <Button Grid.Column="1" Style="{StaticResource OutlinedPillButton}"
                            Tag="&#xE711;" Content="CANCEL"
                            ToolTip="Close without creating"
                            Click="OnCancelClick"/>

                    <Button Grid.Column="2"
                            x:Name="ConfirmButton"
                            Style="{StaticResource SuccessPillButton}"
                            Tag="&#xE73E;" Content="CREATE DELIVERY NOTE"
                            ToolTip="Create the delivery note from this job order"
                            Click="OnConfirmClick"
                            IsEnabled="False"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>