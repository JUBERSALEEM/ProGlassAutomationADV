<Window x:Class="ProGlassAutomation.Views.DeliveryNote.DeliveryNoteList.JobOrderPicker.JobOrderPickerDialog"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Job Order"
        Width="780" Height="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}">

    <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
            Background="{DynamicResource ModuleBackgroundBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="{DynamicResource CardBorderThickness}"
            Margin="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0"
                              Opacity="0.25" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── HEADER ──────────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{DynamicResource AccentBrush}"
                    CornerRadius="16,16,0,0"
                    Padding="28,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Select Job Order"
                                   FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock Text="Choose a Job Order to create a Delivery Note from"
                                   FontSize="{StaticResource TextBody}" Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   Opacity="0.85" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource RowOutlinedButton}"
                            Tag="&#xE711;" MinWidth="40"
                            Click="OnCancelClick"
                            ToolTip="Close (Esc)"/>
                </Grid>
            </Border>

            <!-- ── SEARCH BAR ───────────────────────────────────────────── -->
            <Border Grid.Row="1"
                    Padding="24,16,24,10">
                <Grid>
                    <TextBox x:Name="SearchBox"
                             FontSize="{StaticResource TextBodyLarge}"
                             Padding="10,8"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource OutlineBrush}"
                             Background="{DynamicResource ElevatedSurfaceBrush}"
                             Foreground="{DynamicResource PrimaryForegroundBrush}"
                             TextChanged="OnSearchChanged"/>
                    <TextBlock Text="Search job order, customer, project, PI or delivery note…"
                               FontSize="{StaticResource TextBody}"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource MutedForegroundBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- ── JO LIST ──────────────────────────────────────────────── -->
            <ScrollViewer Grid.Row="2"
                          Margin="24,0,24,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="JobOrderList"/>
            </ScrollViewer>

            <!-- ── FOOTER ───────────────────────────────────────────────── -->
            <Border CornerRadius="0,0,16,16" Grid.Row="3"
                    Padding="24,14"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               x:Name="SelectedLabel"
                               Text="No job order selected"
                               FontSize="{StaticResource TextBody}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                    <Button Grid.Column="1" Style="{StaticResource OutlinedPillButton}"
                            Tag="&#xE711;" Content="CANCEL"
                            ToolTip="Close without creating"
                            Click="OnCancelClick"/>

                    <Button Grid.Column="2"
                            x:Name="ConfirmButton"
                            Style="{StaticResource SuccessPillButton}"
                            Tag="&#xE73E;" Content="CREATE DELIVERY NOTE"
                            ToolTip="Create the delivery note from this job order"
                            Click="OnConfirmClick"
                            IsEnabled="False"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>