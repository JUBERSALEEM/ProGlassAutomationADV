<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/DeliveryNote/GodView/DeliveryNoteGodView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Delivery Note — God View tab

     Full-system overview: KPI tiles + searchable table of every
     delivery note. Read-only; double-click (or Open) hands off to
     the normal detail view via the shell VM.
═══════════════════════════════════════════════════════════════════════ -->

<!-- MIGRATION LOG — Button Standardization batch 4b (2026-08-15)
     • Grey oval ModuleTabStripStyle container removed from shells —
       pills now sit directly on the page (reference look)
     • JO saved list: CLEAR/REFRESH -> Row pills; row OPEN/HISTORY ->
       RowPrimary/RowOutlined; OpenButtonStyle/HistoryButtonStyle removed
     • God Views: header Refresh -> PrimaryPillButton; row Open ->
       RowPrimaryButton; hero/empty icon slots -> MDL2 glyphs
     Commands/bindings/code-behind preserved; no VM changes.
═══════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.DeliveryNote.GodView.DeliveryNoteGodView"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Margin="20">

        <!-- Fade-in uses the hardware-scaled motion token: snappier on
             120/144/165 Hz panels, calmer on 60 Hz (PerformanceProfileService). -->
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1"
                                         Duration="{DynamicResource MotionDurationNorm}"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ HEADER ═════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Delivery Notes — God View"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                <TextBlock Text="Every delivery note in the system, at a glance"
                           FontSize="12" Margin="0,2,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </StackPanel>

            <!-- Search -->
            <Border Grid.Column="1"
                    MaxWidth="340"
                    Margin="24,0"
                    Background="{DynamicResource MenuHoverBrush}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="14,0"
                    Height="38"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="13"
                         VerticalAlignment="Center"
                         ToolTip="Search DN / JO / customer / project / status"/>
            </Border>

            <!-- LAYOUT FIX: Grid.Column="2" was missing, so this button
                 rendered in column 0 stacked on top of the title text. -->
            <Button Grid.Column="2"
                    Style="{StaticResource PrimaryPillButton}"
                    Tag="&#xE72C;" Content="REFRESH"
                    ToolTip="Refresh overview"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}"/>
        </Grid>

        <!-- ══ KPI TILES ══════════════════════════════════════════════ -->
        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding Kpis}"
                      ItemTemplate="{StaticResource GodKpiCardTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- ══ FULL TABLE ═════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Margin="0,4,0,0"
                CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="{DynamicResource CardBorderThickness}"
                ClipToBounds="True">
                <Grid>
            <DataGrid Style="{StaticResource GodViewGridStyle}"
                      ColumnHeaderStyle="{StaticResource GodViewHeaderStyle}"
                      ItemsSource="{Binding Rows}"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick"
                                  Command="{Binding OpenCommand}"
                                  CommandParameter="{Binding SelectedItem,
                                      RelativeSource={RelativeSource
                                          AncestorType=DataGrid}}"/>
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="DN #"
                                        Binding="{Binding DeliveryNoteId}"
                                        Width="150"/>
                    <DataGridTextColumn Header="Job Order"
                                        Binding="{Binding JobOrderId}"
                                        Width="130"/>
                    <DataGridTextColumn Header="Customer"
                                        Binding="{Binding CustomerName}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Project"
                                        Binding="{Binding ProjectName}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="100"/>
                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding DeliveryType}"
                                        Width="90"/>
                    <DataGridTextColumn Header="Ordered"
                                        Binding="{Binding TotalOrderedQty}"
                                        Width="75"/>
                    <DataGridTextColumn Header="Delivered"
                                        Binding="{Binding TotalDeliveredQty}"
                                        Width="80"/>
                    <DataGridTextColumn Header="Balance"
                                        Binding="{Binding TotalBalanceQty}"
                                        Width="75"/>
                    <DataGridTextColumn Header="Delivery Date"
                                        Binding="{Binding DeliveryDate,
                                            StringFormat='dd MMM yyyy'}"
                                        Width="110"/>

                    <!-- Open → normal detail view (via shell VM) -->
                    <DataGridTemplateColumn Header="" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Open"
                                        Cursor="Hand"
                                        FontSize="11"
                                        Padding="10,3"
                                        BorderThickness="0"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="{DynamicResource OnAccentForegroundBrush}"
                                        Command="{Binding DataContext.OpenCommand,
                                                    RelativeSource={RelativeSource
                                                        AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

                <!-- v2 empty / no-search-result state -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Rows.Count}" Value="0"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <emptyState:EmptyStateControl
                        Icon="&#xE7F4;"
                        Title="No delivery notes found"
                        Message="Every delivery note in the system appears in this God View — search by DN, job order, customer, project, driver or status. Create delivery notes in the Workspace tab and they show up here instantly. If nothing matches, try a different search or press Refresh."/>
                </StackPanel>
                </Grid>
        </Border>
    </Grid>
</UserControl>
