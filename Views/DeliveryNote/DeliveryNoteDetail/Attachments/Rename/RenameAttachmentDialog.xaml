<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/DeliveryNote/DeliveryNoteDetail/Attachments/Rename/RenameAttachmentDialog.xaml
     PROJECT: ProGlassAutomation
     MODULE: Delivery Note — attachment rename on upload (Phase 10.6a)

     2026-09 dialog audit: rebuilt on the shared ThemedDialogWindow chrome
     (drag header, close button, icon badge and footer now come from the
     one template). Keeps the by-design pieces: filename TextBox with
     select-all + indigo focus glow, attached extension pill, and the
     fixed-height validation strip (reserved with Visibility=Hidden so the
     footer never jumps when an error appears).
     ═══════════════════════════════════════════════════════════════════ -->

<dialogs:ThemedDialogWindow x:Class="ProGlassAutomation.Views.DeliveryNote.DeliveryNoteDetail.Attachments.Rename.RenameAttachmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
        xmlns:dialogs="clr-namespace:ProGlassAutomation.Views.Shared.Dialogs"
        Title="{DynamicResource DeliveryNote.SaveAttachment}"
        Width="560"
        DialogIcon="&#xE8E5;"
             FontFamily="{DynamicResource AppFontFamily}">

    <Window.Resources>
        <!-- ── FILENAME TEXTBOX — rounded, indigo focus glow ───────────── -->
        <Style x:Key="FileNameTextBoxStyle" TargetType="TextBox">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.H3}"/>
            <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Br"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                BorderThickness="{DynamicResource CardBorderThickness}"
                                CornerRadius="{DynamicResource Radius.Left.Medium}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Br" Property="BorderBrush">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                            <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel>
        <!-- ── FILENAME INPUT ROW ──────────────────────────────────────── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     x:Name="FileNameTextBox"
                     Style="{StaticResource Input.TextBox}"
                     Text="{Binding FileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Extension pill — right-attached to textbox -->
            <Border Grid.Column="1"
                    Background="{DynamicResource TintIndigoBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="{DynamicResource Border.BoxNoLeftThickness}"
                    CornerRadius="{DynamicResource Radius.Right.Medium}"
                    Padding="12,6"
                    VerticalAlignment="Stretch">
                <TextBlock Text="{Binding Extension}"
                           FontSize="{DynamicResource FontSize.H3}"
                           FontWeight="{DynamicResource Weight.Bold}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Border>
        </Grid>

        <!-- ── VALIDATION STRIP — always reserved at a fixed height;
             Visibility toggles Hidden/Visible only, so the window and
             footer never move when an error appears ─────────────────── -->
        <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="{DynamicResource CardBorderThickness}"
                Height="32"
                Margin="0,8,0,0"
                Padding="10,4"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                Background="{DynamicResource TintRedBrush}"
                VerticalAlignment="Top"
                Visibility="{Binding ValidationVisibility}">
            <TextBlock Text="{Binding ValidationMessage}"
                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DangerBrush}"/>
        </Border>
    </StackPanel>

    <dialogs:ThemedDialogWindow.FooterContent>
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource OutlinedPillButton}"
                    Tag="&#xE711;" Content="{DynamicResource Action.Cancel}"
                    Margin="0,0,10,0"
                    ToolTip="{DynamicResource DeliveryNote.CloseWithoutSaving}"
                    IsCancel="True"/>
            <Button Style="{StaticResource PrimaryPillButton}"
                    Tag="&#xE74E;" Content="{DynamicResource Action.Save}"
                    ToolTip="{DynamicResource DeliveryNote.SaveNewFileName}"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"/>
        </StackPanel>
    </dialogs:ThemedDialogWindow.FooterContent>
</dialogs:ThemedDialogWindow>
