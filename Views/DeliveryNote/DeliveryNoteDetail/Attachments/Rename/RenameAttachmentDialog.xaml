<Window x:Class="ProGlassAutomation.Views.DeliveryNote.DeliveryNoteDetail.Attachments.Rename.RenameAttachmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Attachment As"
        Width="520" Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- ── PRIMARY BUTTON (Save) — indigo gradient ──────────────────── -->

        <!-- ── SECONDARY BUTTON (Cancel) — soft grey ────────────────────── -->

        <!-- ── CLOSE (X) button — subtle circle top-right ──────────────── -->

        <!-- ── FILENAME TEXTBOX — rounded, indigo focus glow ───────────── -->
        <Style x:Key="FileNameTextBoxStyle" TargetType="TextBox">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Br"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="10,0,0,10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Br" Property="BorderBrush">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#4338CA" Offset="0"/>
                                            <GradientStop Color="#6366F1" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════════════════
         GLASSY CARD — rounded 20px, drop shadow, subtle border
    ═══════════════════════════════════════════════════════════════════ -->
    <Border CornerRadius="20"
            Background="{DynamicResource ModuleBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0"
                              Opacity="0.25" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header bar (drag + close) -->
                <RowDefinition Height="Auto"/>
                <!-- Icon + title area -->
                <RowDefinition Height="Auto"/>
                <!-- Filename input -->
                <RowDefinition Height="*"/>
                <!-- Validation area -->
                <RowDefinition Height="Auto"/>
                <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- ── DRAG HEADER + CLOSE BUTTON ─────────────────────────── -->
            <Grid Grid.Row="0"
                  Height="44"
                  MouseLeftButtonDown="OnHeaderMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left area is draggable — no visible content -->
                <Border Grid.Column="0" Background="Transparent"/>

                <Button Grid.Column="1"
                        Style="{StaticResource RowOutlinedButton}"
                        Tag="&#xE711;" MinWidth="40"
                        Margin="0,8,10,0"
                        VerticalAlignment="Top"
                        Click="OnCancelClick"
                        ToolTip="Close (Esc)"/>
            </Grid>

            <!-- ── HEADER (icon + title + subtitle) ───────────────────── -->
            <StackPanel Grid.Row="1"
                        Margin="28,0,28,20">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <!-- Icon pill -->
                    <Border Width="44" Height="44"
                            CornerRadius="12"
                            Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4338CA" Offset="0"/>
                                <GradientStop Color="#6366F1" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Save Attachment As"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="Give it a meaningful name — extension stays the same."
                                   FontSize="11"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- ── FILENAME INPUT ROW ──────────────────────────────────── -->
            <Grid Grid.Row="2" Margin="28,0,28,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         x:Name="FileNameTextBox"
                         Style="{StaticResource FileNameTextBoxStyle}"
                         KeyDown="OnFileNameKeyDown"/>

                <!-- Extension pill — right-attached to textbox -->
                <Border Grid.Column="1"
                        Background="{DynamicResource TintIndigoBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1.5,1.5,1.5"
                        CornerRadius="0,10,10,0"
                        Padding="16,10"
                        VerticalAlignment="Stretch">
                    <TextBlock x:Name="ExtensionLabel"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                </Border>
            </Grid>

            <!-- ── VALIDATION AREA ─────────────────────────────────────── -->
            <Border Grid.Row="3"
                    x:Name="ValidationBorder"
                    Margin="28,4,28,0"
                    Padding="12,8"
                    CornerRadius="8"
                    Background="{DynamicResource TintRedBrush}"
                    VerticalAlignment="Top"
                    Visibility="Collapsed">
                <TextBlock x:Name="ValidationText"
                           FontSize="11" FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}"/>
            </Border>

            <!-- ── ACTION BUTTONS ──────────────────────────────────────── -->
            <Border Grid.Row="4"
                    Background="{DynamicResource MenuHoverBrush}"
                    CornerRadius="0,0,20,20"
                    Padding="20,14">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Style="{StaticResource OutlinedPillButton}"
                            Tag="&#xE711;" Content="CANCEL"
                            Margin="0,0,10,0"
                            ToolTip="Close without saving"
                            Click="OnCancelClick"
                            IsCancel="True"/>
                    <Button Style="{StaticResource PrimaryPillButton}"
                            Tag="&#xE74E;" Content="SAVE"
                            ToolTip="Save the new file name"
                            Click="OnSaveClick"
                            IsDefault="True"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>