<Window x:Class="ProGlassAutomation.Views.DeliveryNote.DeliveryNoteDetail.Attachments.Rename.RenameAttachmentDialog"
             TextOptions.TextHintingMode="Fixed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource DeliveryNote.SaveAttachment}"
        Width="560"
        Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- ── CLOSE (X) button — 36px circle, subtle hover, right of the
             drag header. Larger than the 26px row buttons so the dialog's
             only dismiss affordance is a comfortable hit target. ──────── -->
        <Style x:Key="DialogCloseButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="Transparent"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource TextBody}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource MenuHoverBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource DangerBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource TintRedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── FILENAME TEXTBOX — rounded, indigo focus glow ───────────── -->
        <Style x:Key="FileNameTextBoxStyle" TargetType="TextBox">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="FontSize" Value="{StaticResource TextSection}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Br"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="{DynamicResource CardBorderThickness}"
                                CornerRadius="10,0,0,10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Br" Property="BorderBrush">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                            <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════════════════
         GLASSY CARD — rounded 12px, drop shadow, subtle border.
         FIXED window height (no SizeToContent): the dialog never
         re-measures when the validation banner appears, so it can never
         jump or collapse. The validation strip is ALWAYS laid out
         (Visibility=Hidden when clean) at a fixed height, so showing an
         error changes nothing in the layout. No '*' rows — the card is
         exactly as tall as its content. Margin is large enough for the
         drop shadow to render fully (no square clipping at the edges).
    ═══════════════════════════════════════════════════════════════════ -->
    <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
            Background="{DynamicResource ModuleBackgroundBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="{DynamicResource CardBorderThickness}"
            Margin="24,20,24,28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0"
                              Opacity="0.25" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header bar (drag + close) -->
                <RowDefinition Height="Auto"/>
                <!-- Icon + title area -->
                <RowDefinition Height="Auto"/>
                <!-- Filename input -->
                <RowDefinition Height="Auto"/>
                <!-- Validation strip (fixed height, hidden when clean) -->
                <RowDefinition Height="Auto"/>
                <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- ── DRAG HEADER + CLOSE BUTTON ─────────────────────────── -->
            <Grid Grid.Row="0"
                  Height="44"
                  MouseLeftButtonDown="OnHeaderMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left area is draggable — no visible content -->
                <Border Grid.Column="0" Background="Transparent"/>

                <Button Grid.Column="1"
                        Style="{StaticResource DialogCloseButtonStyle}"
                        Margin="0,4,4,0"
                        VerticalAlignment="Top"
                        Click="OnCancelClick"
                        ToolTip="{DynamicResource DeliveryNote.CloseEsc}"/>
            </Grid>

            <!-- ── HEADER (icon + title + subtitle) ───────────────────── -->
            <StackPanel Grid.Row="1"
                        Margin="28,4,28,20">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                    <!-- Icon pill -->
                    <Border Width="44" Height="44"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="{StaticResource TextHeadline}"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource DeliveryNote.SaveAttachment}"
                                   FontSize="{StaticResource TextTitleLarge}" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="{DynamicResource DeliveryNote.GiveMeaningfulNameExtensionStays}"
                                   FontSize="{StaticResource TextBody}"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- ── FILENAME INPUT ROW ──────────────────────────────────── -->
            <Grid Grid.Row="2" Margin="28,0,28,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         x:Name="FileNameTextBox"
                         Style="{StaticResource FileNameTextBoxStyle}"
                         KeyDown="OnFileNameKeyDown"/>

                <!-- Extension pill — right-attached to textbox -->
                <Border Grid.Column="1"
                        Background="{DynamicResource TintIndigoBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="0,1.5,1.5,1.5"
                        CornerRadius="0,10,10,0"
                        Padding="16,10"
                        VerticalAlignment="Stretch">
                    <TextBlock x:Name="ExtensionLabel"
                               FontSize="{StaticResource TextSection}"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                </Border>
            </Grid>

            <!-- ── VALIDATION STRIP — always reserved at a fixed height;
                 Visibility toggles Hidden/Visible only, so the window and
                 footer never move when an error appears ─────────────── -->
            <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Grid.Row="3"
                    x:Name="ValidationBorder"
                    Height="36"
                    Margin="28,14,28,0"
                    Padding="14,8"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Background="{DynamicResource TintRedBrush}"
                    VerticalAlignment="Top"
                    Visibility="Hidden">
                <TextBlock x:Name="ValidationText"
                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}"/>
            </Border>

            <!-- ── ACTION BUTTONS ──────────────────────────────────────── -->
            <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Grid.Row="4"
                    Background="{DynamicResource MenuHoverBrush}"
                    CornerRadius="0,0,16,16"
                    Padding="24,16"
                    Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Style="{StaticResource OutlinedPillButton}"
                            Tag="&#xE711;" Content="{DynamicResource Action.Cancel}"
                            Margin="0,0,10,0"
                            ToolTip="{DynamicResource DeliveryNote.CloseWithoutSaving}"
                            
                            IsCancel="True"/>
                    <Button Style="{StaticResource PrimaryPillButton}"
                            Tag="&#xE74E;" Content="{DynamicResource Action.Save}"
                            ToolTip="{DynamicResource DeliveryNote.SaveNewFileName}"
                            Click="OnSaveClick"
                            IsDefault="True"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
