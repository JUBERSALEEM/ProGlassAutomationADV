<UserControl x:Class="ProGlassAutomation.Views.DeliveryNote.DeliveryNoteDetail.DeliveryNoteDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:sections="clr-namespace:ProGlassAutomation.Views.DeliveryNote.DeliveryNoteDetail.Sections"
             xmlns:loading="clr-namespace:ProGlassAutomation.Controls.LoadingState"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding BackCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Sections/DnSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>





        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExportButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderUploadButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="#22FFFFFF"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>








        <Style x:Key="HistoryRowButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Margin="12,4,12,4"
                                Background="Transparent"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



















        <!-- ═══════════════════════════════════════════════
             NAMED STYLES — prevent Style double-set errors
        ═══════════════════════════════════════════════ -->

        <!-- SELECT ALL REMAINING button -->
        <Style x:Key="FillRemainingButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMasterDn}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- RESET QTY button — muted grey, companion to FillRemaining -->
        <Style x:Key="ResetQtyButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMasterDn}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Create from Master button -->
        <Style x:Key="CreateFromMasterButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#047857"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMasterDn}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Real DN actions panel -->
        <Style x:Key="RealDnActionsStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMasterDn}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- THIS DN / DELIVERED column header -->

        <!-- DeliveredQty TextBox — hidden on Master DN -->

        <!-- DeliveredQty TextBlock — shown on Master DN only -->

        <!-- PREV DELIVERED / TOTAL DELIVERED label -->

        <!-- THIS DN / IN PROGRESS label -->

        <!-- Hero strip label -->

        <!-- Items section title -->

        <!-- Items section subtitle -->

        <!-- Details form visibility -->

        <!-- Master DN banner -->
        <Style x:Key="MasterDnBannerStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMasterDn}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Master DN badge in action bar -->
        <Style x:Key="MasterDnBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMasterDn}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- FOC badge -->
        <Style x:Key="FocBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource TintAmberBrush}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFoc}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Viewing-different-DN warning -->

    
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- ROOT GRID
         Row 0: Action bar
         Row 1: Master DN banner
         Row 2: Loading/Error
         Row 3: Stats + Attachments
         Row 4: Items + History
    -->
    <Grid Margin="24,16,24,16"
          Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ ROW 0 — ACTION BAR ═══ -->
        <Border Grid.Row="0"
                Style="{StaticResource ModuleDetailActionBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource OutlinedPillButton}"
                        Tag="&#xE72B;" Content="BACK"
                        Command="{Binding BackCommand}"
                        Margin="0,0,12,0"
                        ToolTip="Back to list (Esc)"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding DeliveryNoteId}"
                               Style="{StaticResource ModuleDetailTitleStyle}"/>
                    <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" CornerRadius="8" Padding="10,3"
                            Margin="10,0,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource TintIndigoBrush}">
                        <TextBlock Text="{Binding DeliveryType}"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Border>
                    <Border Style="{StaticResource MasterDnBadgeStyle}">
<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="10" Foreground="White"
                                       VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="MASTER DN — READ ONLY"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="White"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FocBadgeStyle}">
                        <TextBlock Text="FREE OF CHARGE"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Border>
                    <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" CornerRadius="8" Padding="10,3"
                            Margin="6,0,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource TintGreenBrush}">
                        <TextBlock Text="{Binding Status}"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- Real DN actions -->
                    <StackPanel Style="{StaticResource RealDnActionsStyle}">
                        <!-- v2 §24: version history -->
                        <Button Style="{StaticResource RowOutlinedButton}"
                                Tag="&#xE81C;" Content="HISTORY"
                                Command="{Binding ShowVersionsCommand}"
                                Margin="0,0,6,0"
                                ToolTip="Version history — every save is preserved"/>
                        <Button Style="{StaticResource PrimaryPillButton}"
                                Tag="&#xE74E;" Content="SAVE"
                                Command="{Binding SaveCommand}"
                                Margin="0,0,6,0"
                                ToolTip="Save (Ctrl+S)"/>
                        <Button Style="{StaticResource SuccessPillButton}"
                                Tag="&#xE7F4;" Content="MAKE DN"
                                Command="{Binding MakeDnCommand}"
                                Margin="0,0,12,0"
                                ToolTip="Create a split delivery note"/>
                        <Border Width="1" Margin="0,4,12,4"
                                Background="{DynamicResource BorderBrush}"/>
                        <Button Style="{StaticResource SuccessPillButton}"
                                Tag="&#xE8A5;" Content="PDF"
                                Command="{Binding ExportPdfCommand}"
                                Margin="0,0,6,0"
                                ToolTip="Export PDF"/>
                        <Button Style="{StaticResource SuccessPillButton}"
                                Tag="&#xE9F9;" Content="EXCEL"
                                Command="{Binding ExportExcelCommand}"
                                Margin="0,0,6,0"
                                ToolTip="Export Excel"/>
                        <Button Style="{StaticResource SuccessPillButton}"
                                Tag="&#xE72D;" Content="CSV"
                                Command="{Binding ExportCsvCommand}"
                                Margin="0,0,12,0"
                                ToolTip="Export CSV"/>
                        <Border Width="1" Margin="0,4,12,4"
                                Background="{DynamicResource BorderBrush}"/>
                        <Button Style="{StaticResource DangerButton}"
                                Tag="&#xE74D;" Content="DELETE"
                                Command="{Binding DeleteDnCommand}"
                                ToolTip="Delete this delivery note"/>
                    </StackPanel>

                    <!-- Master DN button -->
                    <Button Style="{StaticResource PrimaryPillButton}"
                            Tag="&#xE7B8;" Content="CREATE NEW DN FROM BALANCE"
                            Command="{Binding CreateNewDnFromMasterCommand}"
                            ToolTip="Create a new DN pre-filled with balance quantities"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ ROW 1 — MASTER DN BANNER ═══ -->
        <Border Grid.Row="1" Style="{StaticResource MasterDnBannerStyle}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                    <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE718;" FontFamily="Segoe MDL2 Assets"
                           FontSize="28" VerticalAlignment="Center"
                           Margin="0,0,14,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="MASTER DELIVERY NOTE — REFERENCE TRACKER"
                               FontSize="13" FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock FontSize="11" Foreground="#CCFFFFFF"
                               Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run Text="Auto-created from Job Order. Read-only."/>
                        <Run Text=" Updates automatically after each dispatch."/>
                        <Run Text=" Only items with remaining balance are shown."/>
                        <Run Text=" Click 'Create New DN from Balance' to deliver."/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Margin="20,0,0,0" MinWidth="140">
                    <TextBlock HorizontalAlignment="Right"
                               FontSize="13" FontWeight="Bold"
                               Foreground="White" Margin="0,0,0,4">
                        <Run Text="{Binding DeliveryProgressPercent,
                                    Mode=OneWay, StringFormat={}{0:0.#}}"/>
                        <Run Text="% delivered"/>
                    </TextBlock>
                    <Border x:Name="BannerProgressTrack"
                            CornerRadius="4" Height="8"
                            Background="#33FFFFFF">
                        <Border CornerRadius="4" HorizontalAlignment="Left"
                                Background="White">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                    <Binding Path="DeliveryProgressPercent"/>
                                    <Binding Path="ActualWidth"
                                             ElementName="BannerProgressTrack"/>
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Border>
                    <TextBlock HorizontalAlignment="Right"
                               FontSize="10" Foreground="#CCFFFFFF"
                               Margin="0,4,0,0">
                        <Run Text="{Binding TotalBalanceQty, Mode=OneWay}"
                             FontWeight="Bold"/>
                        <Run Text=" pcs remaining"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ ROW 2 — LOADING / ERROR ═══ -->
        <StackPanel Grid.Row="2">
            <loading:LoadingStateControl
                    Visibility="{Binding IsLoading,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Message="Loading delivery note…"
                    Margin="0,8,0,12"/>
            <Border Visibility="{Binding HasError,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource ModuleErrorBannerStyle}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="13" FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- ═══ ROW 3 — STATS | ATTACHMENTS ═══ -->
        <!-- ══ DETAIL TABS — Overview / Attachments / History ════════ -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="OVERVIEW" Tag="&#xE8A5;" Margin="0,0,8,0"
                    ToolTip="Stats and delivered items"
                    Command="{Binding SwitchDetailTabCommand}" CommandParameter="Overview">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RowOutlinedButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOverviewTab}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="ATTACHMENTS" Tag="&#xE723;" Margin="0,0,8,0"
                    ToolTip="Attached photos and signed copies"
                    Command="{Binding SwitchDetailTabCommand}" CommandParameter="Attachments">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RowOutlinedButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAttachmentsTab}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="HISTORY" Tag="&#xE81C;"
                    ToolTip="Delivery history timeline"
                    Command="{Binding SwitchDetailTabCommand}" CommandParameter="History">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RowOutlinedButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHistoryTab}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- ══ TAB CONTENT — each section its own UserControl ════════ -->
        <Grid Grid.Row="4">
            <sections:DnOverviewSection
                Visibility="{Binding IsOverviewTab, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <sections:DnAttachmentsSection
                Visibility="{Binding IsAttachmentsTab, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <sections:DnHistorySection
                Visibility="{Binding IsHistoryTab, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</UserControl>