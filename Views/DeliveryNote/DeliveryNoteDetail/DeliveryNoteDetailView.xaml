<UserControl x:Class="ProGlassAutomation.Views.DeliveryNote.DeliveryNoteDetail.DeliveryNoteDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding BackCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>

        <!-- ══════════════════════════════════════════════════════════════
             ALL STYLES PRESERVED FROM PREVIOUS SHIPS
        ══════════════════════════════════════════════════════════════ -->

        <Style x:Key="OptionalDimStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,8,10,8"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12,12,0,0"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExportButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderUploadButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="#22FFFFFF"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SpecGroupCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="SpecGroupHeaderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12,12,0,0"/>
            <Setter Property="Padding" Value="16,10"/>
        </Style>

        <Style x:Key="GridHeaderCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin" Value="6,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridDataCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="6,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        </Style>

        <Style x:Key="GridNumericCell" TargetType="TextBlock" BasedOn="{StaticResource GridDataCell}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="6,8,10,8"/>
        </Style>

        <Style x:Key="BalanceCellStyle" TargetType="TextBlock" BasedOn="{StaticResource GridNumericCell}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasBalance}" Value="True">
                    <Setter Property="Foreground" Value="#B45309"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ColumnSeparatorStyle" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Opacity" Value="0.4"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style x:Key="HistoryRowButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Margin="12,4,12,4"
                                Background="Transparent"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryRowContentBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                    <Setter Property="BorderBrush" Value="#4338CA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrentDn}" Value="True">
                    <Setter Property="BorderThickness" Value="4,2,2,2"/>
                    <Setter Property="Background" Value="{DynamicResource TintGreenBrush}"/>
                    <Setter Property="BorderBrush" Value="#047857"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HistoryRowOuterButtonStyle" TargetType="Button"
               BasedOn="{StaticResource HistoryRowButtonStyle}">
            <Setter Property="Opacity" Value="0.90"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1.0"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsCurrentDn}" Value="True">
                    <Setter Property="Opacity" Value="1.0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TaxInvoiceRowButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#1E40AF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource MutedForegroundBrush}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CumulativeLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5,0,2"/>
        </Style>

        <Style x:Key="CumulativeValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="CumulativeSeparatorStyle" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Opacity" Value="0.5"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style x:Key="HistoryContextMenuItemStyle" TargetType="MenuItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="HistoryRowDnIdStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrentDn}" Value="True">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Foreground" Value="#047857"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ══════════════════════════════════════════════════════════════
             COMPACT STAT TILE (2×2 grid)
        ══════════════════════════════════════════════════════════════ -->

        <Style x:Key="CompactStatTileStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="MinHeight" Value="70"/>
        </Style>

        <Style x:Key="CompactStatNumberStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        </Style>

        <Style x:Key="CompactStatUnitStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="3,0,0,3"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
        </Style>

        <Style x:Key="CompactStatLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
        </Style>

        <!-- ══════════════════════════════════════════════════════════════
             MASTER DN HERO STRIP (compact)
        ══════════════════════════════════════════════════════════════ -->

        <Style x:Key="MasterHeroStripStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12,12,0,0"/>
            <Setter Property="Padding" Value="18,12"/>
        </Style>

        <Style x:Key="MasterHeroTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="MasterHeroSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#EAFFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MasterHeroMetaLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
        </Style>

        <Style x:Key="MasterHeroMetaValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MasterHeroDividerStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="  ·  "/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#77FFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <!-- ══════════════════════════════════════════════════════════════════
         ROOT GRID — 4 rows, NO outer ScrollViewer.
         Row 0: Action bar        (Auto — fixed)
         Row 1: Loading/Error     (Auto — fixed)
         Row 2: Stats + Attach    (Auto — fixed)
         Row 3: Master DN + Hist  ( *   — fills, both internally scroll)
    ══════════════════════════════════════════════════════════════════ -->
    <Grid Margin="24,16,24,16"
          Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════
             ROW 0 — ACTION BAR (FIXED)
        ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource ModuleBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,12"
                Margin="0,0,0,12"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="← Back"
                        Command="{Binding BackCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="{DynamicResource MenuHoverBrush}"
                        Foreground="{DynamicResource PrimaryForegroundBrush}"
                        Margin="0,0,12,0"
                        ToolTip="Back to list (Esc)"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding DeliveryNoteId}"
                               FontSize="20" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <Border CornerRadius="8" Padding="10,3"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource TintIndigoBrush}">
                        <TextBlock Text="{Binding DeliveryType}"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Border>
                    <Border CornerRadius="8" Padding="10,3"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource TintAmberBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFoc}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="FREE OF CHARGE"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Border>
                    <Border CornerRadius="8" Padding="10,3"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource TintGreenBrush}">
                        <TextBlock Text="{Binding Status}"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="#047857"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Content="💾  Save"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="0,0,6,0"
                            ToolTip="Save changes (Ctrl+S)"/>

                    <Button Content="🚚  Make DN"
                            Command="{Binding MakeDnCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#047857"
                            Margin="0,0,12,0"/>

                    <Border Width="1" Margin="0,4,12,4"
                            Background="{DynamicResource BorderBrush}"/>

                    <Button Content="📄  PDF"
                            Command="{Binding ExportPdfCommand}"
                            Style="{StaticResource ExportButtonStyle}"
                            Background="#FEF2F2"
                            BorderBrush="#B91C1C"
                            Foreground="#B91C1C"
                            Margin="0,0,6,0"
                            ToolTip="Export current DN as PDF"/>

                    <Button Content="📊  Excel"
                            Command="{Binding ExportExcelCommand}"
                            Style="{StaticResource ExportButtonStyle}"
                            Background="#ECFDF5"
                            BorderBrush="#047857"
                            Foreground="#047857"
                            Margin="0,0,6,0"
                            ToolTip="Export current DN as Excel"/>

                    <Button Content="📋  CSV"
                            Command="{Binding ExportCsvCommand}"
                            Style="{StaticResource ExportButtonStyle}"
                            Background="#EEF2FF"
                            BorderBrush="#4338CA"
                            Foreground="#4338CA"
                            Margin="0,0,12,0"
                            ToolTip="Export current DN as CSV"/>

                    <Border Width="1" Margin="0,4,12,4"
                            Background="{DynamicResource BorderBrush}"/>

                    <Button Content="🗑️  Delete"
                            Command="{Binding DeleteDnCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#B91C1C"
                            Foreground="White"
                            ToolTip="Permanently delete this delivery note"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             ROW 1 — LOADING / ERROR banners (FIXED, auto-height)
        ══════════════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="1">
            <Border Visibility="{Binding IsLoading,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Padding="20">
                <TextBlock Text="⏳  Loading delivery note…"
                           FontSize="14" HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </Border>

            <Border Visibility="{Binding HasError,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#FEF2F2"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    CornerRadius="12" Padding="16" Margin="0,0,0,12"
                    SnapsToDevicePixels="True">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#B91C1C"
                           FontSize="13" FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- ══════════════════════════════════════════════════════════════
             ROW 2 — STATS  |  ATTACHMENTS (FIXED, side-by-side)
             Left = Stats 2×2 (2fr)
             Right = Attachments (3fr)
             NOTE: attachments are typically small, but if many files exist,
             the internal attachment list has its own scroll below.
        ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- ── STATS CARD (left, 2×2) ──────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    SnapsToDevicePixels="True">
                <StackPanel>
                    <Border Style="{StaticResource SectionHeaderStyle}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#4338CA" Offset="0"/>
                                <GradientStop Color="#6366F1" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="📊  QUICK STATS"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="Delivery numbers at a glance"
                                       FontSize="10" Foreground="#CCFFFFFF"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="12,12,12,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0"
                                Style="{StaticResource CompactStatTileStyle}">
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding TotalOrderedQty}"
                                               Style="{StaticResource CompactStatNumberStyle}"/>
                                    <TextBlock Text=" pcs" Style="{StaticResource CompactStatUnitStyle}"/>
                                </StackPanel>
                                <TextBlock Text="ORDERED" Style="{StaticResource CompactStatLabelStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="2"
                                Style="{StaticResource CompactStatTileStyle}">
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding TotalPreviouslyDeliveredQty}"
                                               Style="{StaticResource CompactStatNumberStyle}"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <TextBlock Text=" pcs" Style="{StaticResource CompactStatUnitStyle}"/>
                                </StackPanel>
                                <TextBlock Text="PREV DELIVERED"
                                           Style="{StaticResource CompactStatLabelStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0"
                                Style="{StaticResource CompactStatTileStyle}"
                                Background="{DynamicResource TintGreenBrush}">
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding TotalDeliveredQty}"
                                               Style="{StaticResource CompactStatNumberStyle}"
                                               Foreground="#047857"/>
                                    <TextBlock Text=" pcs"
                                               Style="{StaticResource CompactStatUnitStyle}"
                                               Foreground="#047857"
                                               Opacity="0.75"/>
                                </StackPanel>
                                <TextBlock Text="THIS DN"
                                           Style="{StaticResource CompactStatLabelStyle}"
                                           Foreground="#047857"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="2"
                                Style="{StaticResource CompactStatTileStyle}"
                                Background="{DynamicResource TintAmberBrush}">
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding TotalBalanceQty}"
                                               Style="{StaticResource CompactStatNumberStyle}"
                                               Foreground="#B45309"/>
                                    <TextBlock Text=" pcs"
                                               Style="{StaticResource CompactStatUnitStyle}"
                                               Foreground="#B45309"
                                               Opacity="0.75"/>
                                </StackPanel>
                                <TextBlock Text="BALANCE"
                                           Style="{StaticResource CompactStatLabelStyle}"
                                           Foreground="#B45309"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── ATTACHMENTS CARD (right, top) ───────────────────── -->
            <Border Grid.Column="2"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    SnapsToDevicePixels="True"
                    MaxHeight="260">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SectionHeaderStyle}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#4338CA" Offset="0"/>
                                <GradientStop Color="#6366F1" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding SelectedDnHeaderText}"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="White"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Photos + signed copies · updates when you pick a history row"
                                           FontSize="10" Foreground="#CCFFFFFF"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="+ Image"
                                    Command="{Binding UploadImageCommand}"
                                    Style="{StaticResource HeaderUploadButtonStyle}"
                                    Margin="0,0,6,0"
                                    ToolTip="Upload image (max 10 MB)"/>
                            <Button Grid.Column="2"
                                    Content="+ PDF"
                                    Command="{Binding UploadPdfCommand}"
                                    Style="{StaticResource HeaderUploadButtonStyle}"
                                    ToolTip="Upload PDF (max 10 MB)"/>
                        </Grid>
                    </Border>

                    <!-- Viewing-different-DN warning -->
                    <Border Grid.Row="1"
                            Padding="12,8" Margin="10,10,10,0"
                            CornerRadius="10"
                            Background="{DynamicResource TintAmberBrush}"
                            SnapsToDevicePixels="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelectedDnCurrent}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   TextWrapping="Wrap">
                            <Run Text="👁  Viewing attachments for a different DN."/>
                        </TextBlock>
                    </Border>

                    <!-- ══════════════════════════════════════════════
                         ATTACHMENTS INTERNAL SCROLL — free-scrolling
                    ══════════════════════════════════════════════ -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  IsDeferredScrollingEnabled="False"
                                  PanningMode="None"
                                  Focusable="True"
                                  FocusVisualStyle="{x:Null}"
                                  behaviors:SmoothScrollBehavior.IsEnabled="True">
                        <StackPanel>
                            <Border Padding="16,20"
                                    Visibility="{Binding HasNoAttachments,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📎" FontSize="32"
                                               HorizontalAlignment="Center"
                                               Opacity="0.4"/>
                                    <TextBlock Text="No attachments yet"
                                               FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,4"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Text="Upload photos or signed delivery copies."
                                               FontSize="11" HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Attachments}"
                                          Margin="10,6,10,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,4" Padding="12,10"
                                                CornerRadius="10"
                                                Background="{DynamicResource MenuHoverBrush}"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="40" Height="40"
                                                        CornerRadius="6"
                                                        Background="{DynamicResource ModuleBackgroundBrush}"
                                                        ClipToBounds="True"
                                                        VerticalAlignment="Center">
                                                    <Grid>
                                                        <Image Source="{Binding Preview}"
                                                               Stretch="UniformToFill"
                                                               Visibility="{Binding IsImage,
                                                                   Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <TextBlock Text="{Binding TypeIcon}"
                                                                   FontSize="22"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding IsPdf,
                                                                       Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Margin="10,0,10,0">
                                                    <TextBlock Text="{Binding FileName}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                    <TextBlock FontSize="11" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}">
                                                        <Run Text="{Binding FileSizeDisplay, Mode=OneWay}"/>
                                                        <Run Text="  ·  "/>
                                                        <Run Text="{Binding UploadedAtDisplay, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <Button Grid.Column="2"
                                                        Content="Open"
                                                        Command="{Binding DataContext.OpenAttachmentCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        FontSize="10" FontWeight="Bold"
                                                        Padding="10,4" Margin="0,0,6,0"
                                                        Cursor="Hand"
                                                        Background="{DynamicResource AccentBrush}"
                                                        Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                        BorderThickness="0"/>

                                                <Button Grid.Column="3"
                                                        Content="✕"
                                                        Command="{Binding DataContext.DeleteAttachmentCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        FontSize="12" FontWeight="Bold"
                                                        Padding="8,4"
                                                        Cursor="Hand"
                                                        Background="#B91C1C"
                                                        Foreground="White"
                                                        BorderThickness="0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             ROW 3 — MASTER DN (large left, scrolls internally)
                   | HISTORY (right sidebar, scrolls internally)
             This row FILLS remaining vertical space (Height="*").
        ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- ══════════════════════════════════════════════════════════
                 MASTER DN CARD (left, fills height, table scrolls inside)
            ══════════════════════════════════════════════════════════ -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- hero strip -->
                        <RowDefinition Height="Auto"/>
                        <!-- details form -->
                        <RowDefinition Height="*"/>
                        <!-- items table scrolls -->
                    </Grid.RowDefinitions>

                    <!-- ── COMPACT HERO STRIP (fixed) ──────────────── -->
                    <Border Grid.Row="0" Style="{StaticResource MasterHeroStripStyle}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#047857" Offset="0"/>
                                <GradientStop Color="#10B981" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✏️  MASTER DELIVERY NOTE  ·  "
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="#CCFFFFFF"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CustomerName}"
                                               Style="{StaticResource MasterHeroTitleStyle}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ProjectName}"
                                           Style="{StaticResource MasterHeroSubtitleStyle}"
                                           MaxWidth="500"
                                           Margin="0,4,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="JO:" Style="{StaticResource MasterHeroMetaLabelStyle}"/>
                                    <TextBlock Text="{Binding JobOrderId}" Style="{StaticResource MasterHeroMetaValueStyle}"/>
                                    <TextBlock Style="{StaticResource MasterHeroDividerStyle}"/>
                                    <TextBlock Text="PI:" Style="{StaticResource MasterHeroMetaLabelStyle}"/>
                                    <TextBlock Text="{Binding ProformaId}" Style="{StaticResource MasterHeroMetaValueStyle}"/>
                                    <TextBlock Style="{StaticResource MasterHeroDividerStyle}"/>
                                    <TextBlock Text="SEQ:" Style="{StaticResource MasterHeroMetaLabelStyle}"/>
                                    <TextBlock Text="{Binding SequenceNumber}" Style="{StaticResource MasterHeroMetaValueStyle}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding DeliveryDateDisplay}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding DeliveryTime}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="#EAFFFFFF"
                                           HorizontalAlignment="Right"
                                           Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding CompanyName}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="#CCFFFFFF"
                                           HorizontalAlignment="Right"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="240"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ── DELIVERY DETAILS FORM (fixed) ───────────── -->
                    <Border Grid.Row="1"
                            Padding="18,14,18,14"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="STATUS"/>
                                <ComboBox ItemsSource="{Binding StatusOptions}"
                                          SelectedItem="{Binding Status}"
                                          FontSize="12" Height="38"
                                          VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="DRIVER NAME"/>
                                <TextBox Text="{Binding DriverName, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12" Padding="10,6"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="4">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="VEHICLE NUMBER"/>
                                <TextBox Text="{Binding VehicleNumber, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12" Padding="10,6"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="6" VerticalAlignment="Bottom">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="FOC"/>
                                <CheckBox IsChecked="{Binding IsFoc}"
                                          Content="Free"
                                          FontSize="12"
                                          Foreground="{DynamicResource PrimaryForegroundBrush}"
                                          VerticalAlignment="Center"
                                          Height="38"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="RECEIVER NAME"/>
                                <TextBox Text="{Binding ReceiverName, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12" Padding="10,6"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="3">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="NOTES"/>
                                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                         behaviors:TextBoxBehaviors.SelectAllOnFocus="False"
                                         FontSize="12" Padding="10,6"
                                         Height="38"
                                         TextWrapping="NoWrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ══════════════════════════════════════════════════
                         DELIVERY ITEMS TABLE — INTERNAL FREE SCROLL
                         SmoothScrollBehavior = pixel-precise smooth scroll,
                         no 1-line/3-line snap, no under-scroller section.
                    ══════════════════════════════════════════════════ -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  CanContentScroll="False"
                                  IsDeferredScrollingEnabled="False"
                                  PanningMode="None"
                                  Focusable="True"
                                  FocusVisualStyle="{x:Null}"
                                  behaviors:SmoothScrollBehavior.IsEnabled="True">
                        <StackPanel Margin="14,12,14,14">
                            <Grid Margin="4,0,4,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="📦  DELIVERY ITEMS"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Text="Enter qty in THIS DN then Save. Prev auto-updates from sibling DNs."
                                               FontSize="10"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding GroupedItemsView}">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="GroupItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="GroupItem">
                                                            <Border Style="{StaticResource SpecGroupCardStyle}">
                                                                <StackPanel>
                                                                    <Border Style="{StaticResource SpecGroupHeaderStyle}">
                                                                        <Border.Background>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                                <GradientStop Color="#4338CA" Offset="0"/>
                                                                                <GradientStop Color="#6366F1" Offset="1"/>
                                                                            </LinearGradientBrush>
                                                                        </Border.Background>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Border Width="4" CornerRadius="2"
                                                                                    Background="White"
                                                                                    Margin="0,0,10,0"/>
                                                                            <TextBlock Text="SPEC:  "
                                                                                       FontSize="12" FontWeight="Bold"
                                                                                       Foreground="#CCFFFFFF"
                                                                                       VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding Name}"
                                                                                       FontSize="14" FontWeight="Bold"
                                                                                       Foreground="White"
                                                                                       VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>

                                                                    <Border Background="{DynamicResource MenuHoverBrush}"
                                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                                            BorderThickness="0,0,0,1">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="40"/>
                                                                                <ColumnDefinition Width="*" MinWidth="200"/>
                                                                                <ColumnDefinition Width="60"/>
                                                                                <ColumnDefinition Width="60"/>
                                                                                <ColumnDefinition Width="60"/>
                                                                                <ColumnDefinition Width="60"/>
                                                                                <ColumnDefinition Width="55"/>
                                                                                <ColumnDefinition Width="70"/>
                                                                                <ColumnDefinition Width="80"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="65"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="95"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="70"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="#"
                                                                                       Style="{StaticResource GridHeaderCell}"
                                                                                       HorizontalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="1" Text="GLASS REF"
                                                                                       Style="{StaticResource GridHeaderCell}"/>
                                                                            <TextBlock Grid.Column="2" Text="W1"
                                                                                       Style="{StaticResource GridHeaderCell}"
                                                                                       HorizontalAlignment="Right" Margin="6,8,10,8"/>
                                                                            <TextBlock Grid.Column="3" Text="H1"
                                                                                       Style="{StaticResource GridHeaderCell}"
                                                                                       HorizontalAlignment="Right" Margin="6,8,10,8"/>
                                                                            <TextBlock Grid.Column="4" Text="W2"
                                                                                       Style="{StaticResource GridHeaderCell}"
                                                                                       HorizontalAlignment="Right" Margin="6,8,10,8"/>
                                                                            <TextBlock Grid.Column="5" Text="H2"
                                                                                       Style="{StaticResource GridHeaderCell}"
                                                                                       HorizontalAlignment="Right" Margin="6,8,10,8"/>
                                                                            <TextBlock Grid.Column="6" Text="QTY"
                                                                                       Style="{StaticResource GridHeaderCell}"
                                                                                       HorizontalAlignment="Right" Margin="6,8,10,8"/>
                                                                            <TextBlock Grid.Column="7" Text="SQM"
                                                                                       Style="{StaticResource GridHeaderCell}"
                                                                                       HorizontalAlignment="Right" Margin="6,8,10,8"/>
                                                                            <TextBlock Grid.Column="8" Text="TOTAL SQM"
                                                                                       Style="{StaticResource GridHeaderCell}"
                                                                                       HorizontalAlignment="Right" Margin="6,8,10,8"/>
                                                                            <Border Grid.Column="9" Style="{StaticResource ColumnSeparatorStyle}"/>
                                                                            <TextBlock Grid.Column="10" Text="PREV"
                                                                                       Style="{StaticResource GridHeaderCell}"
                                                                                       HorizontalAlignment="Right" Margin="6,8,10,8"/>
                                                                            <Border Grid.Column="11" Style="{StaticResource ColumnSeparatorStyle}"/>
                                                                            <TextBlock Grid.Column="12" Text="THIS DN"
                                                                                       Style="{StaticResource GridHeaderCell}"
                                                                                       Foreground="#4338CA"
                                                                                       HorizontalAlignment="Center"/>
                                                                            <Border Grid.Column="13" Style="{StaticResource ColumnSeparatorStyle}"/>
                                                                            <TextBlock Grid.Column="14" Text="BALANCE"
                                                                                       Style="{StaticResource GridHeaderCell}"
                                                                                       HorizontalAlignment="Right" Margin="6,8,10,8"/>
                                                                        </Grid>
                                                                    </Border>

                                                                    <ItemsPresenter/>

                                                                    <Border Background="{DynamicResource TintIndigoBrush}"
                                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                                            BorderThickness="0,1,0,0"
                                                                            Padding="16,10"
                                                                            CornerRadius="0,0,12,12">
                                                                        <StackPanel Orientation="Horizontal"
                                                                                    HorizontalAlignment="Right">
                                                                            <TextBlock Text="SPEC TOTAL: "
                                                                                       FontSize="11" FontWeight="Bold"
                                                                                       Foreground="#4338CA"
                                                                                       VerticalAlignment="Center"/>
                                                                            <TextBlock FontSize="11"
                                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                                       VerticalAlignment="Center"
                                                                                       Margin="8,0,0,0">
                                                                                <Run Text="{Binding ItemCount, Mode=OneWay}" FontWeight="SemiBold"/>
                                                                                <Run Text=" items"/>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasBalance}" Value="True">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource TintAmberBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*" MinWidth="200"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="55"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="95"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding SerialNumber}"
                                                           Style="{StaticResource GridDataCell}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding GlassRef}"
                                                           Style="{StaticResource GridDataCell}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding GlassRef}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding W1}"
                                                           Style="{StaticResource GridNumericCell}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding H1}"
                                                           Style="{StaticResource GridNumericCell}"/>

                                                <TextBlock Grid.Column="4">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource OptionalDimStyle}">
                                                            <Setter Property="Text" Value="{Binding W2}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding W2}" Value="0">
                                                                    <Setter Property="Text" Value="—"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Grid.Column="5">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource OptionalDimStyle}">
                                                            <Setter Property="Text" Value="{Binding H2}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding H2}" Value="0">
                                                                    <Setter Property="Text" Value="—"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Grid.Column="6" Text="{Binding OrderedQty}"
                                                           Style="{StaticResource GridNumericCell}"/>
                                                <TextBlock Grid.Column="7" Text="{Binding Sqm, StringFormat={}{0:0.000}}"
                                                           Style="{StaticResource GridNumericCell}"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                <TextBlock Grid.Column="8" Text="{Binding TotalSqm, StringFormat={}{0:0.000}}"
                                                           Style="{StaticResource GridNumericCell}"
                                                           FontWeight="Bold"/>
                                                <Border Grid.Column="9" Style="{StaticResource ColumnSeparatorStyle}"/>
                                                <TextBlock Grid.Column="10" Text="{Binding PreviouslyDeliveredQty}"
                                                           Style="{StaticResource GridNumericCell}"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                <Border Grid.Column="11" Style="{StaticResource ColumnSeparatorStyle}"/>
                                                <TextBox Grid.Column="12"
                                                         Text="{Binding DeliveredQty, UpdateSourceTrigger=PropertyChanged}"
                                                         behaviors:TextBoxBehaviors.AcceptIntegersOnly="True"
                                                         FontSize="13" FontWeight="Bold"
                                                         TextAlignment="Right"
                                                         VerticalContentAlignment="Center"
                                                         Padding="8,4,10,4" Margin="6,3"
                                                         BorderThickness="1.5"
                                                         BorderBrush="#4338CA"
                                                         Background="#EEF2FF"
                                                         Foreground="#3730A3"/>
                                                <Border Grid.Column="13" Style="{StaticResource ColumnSeparatorStyle}"/>
                                                <TextBlock Grid.Column="14" Text="{Binding BalanceQty}"
                                                           Style="{StaticResource BalanceCellStyle}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 HISTORY CARD (right sidebar, fills height, list scrolls)
            ══════════════════════════════════════════════════════════ -->
            <Border Grid.Column="2"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- header fixed -->
                        <RowDefinition Height="*"/>
                        <!-- list scrolls -->
                        <RowDefinition Height="Auto"/>
                        <!-- totals fixed -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SectionHeaderStyle}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#4338CA" Offset="0"/>
                                <GradientStop Color="#6366F1" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="📋  DELIVERY HISTORY"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="White"/>
                                <TextBlock Text="Click to open · Right-click for options · Green = active"
                                           FontSize="10" Foreground="#CCFFFFFF"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    CornerRadius="8" Padding="8,3"
                                    Background="#22FFFFFF"
                                    VerticalAlignment="Center">
                                <TextBlock FontSize="10" FontWeight="Bold" Foreground="White">
                                    <Run Text="{Binding HistoryTotalDelivered, Mode=OneWay}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding HistoryTotalOrdered, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ══════════════════════════════════════════════
                         HISTORY LIST — INTERNAL FREE SCROLL
                    ══════════════════════════════════════════════ -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  IsDeferredScrollingEnabled="False"
                                  PanningMode="None"
                                  Focusable="True"
                                  FocusVisualStyle="{x:Null}"
                                  behaviors:SmoothScrollBehavior.IsEnabled="True">
                        <ItemsControl ItemsSource="{Binding HistoryEntries}"
                                      Margin="0,8,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource HistoryRowOuterButtonStyle}"
                                            Command="{Binding DataContext.SelectHistoryEntryCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Border Style="{StaticResource HistoryRowContentBorderStyle}"
                                                Tag="{Binding DataContext,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="📂  Open this DN"
                                                              Style="{StaticResource HistoryContextMenuItemStyle}"
                                                              Command="{Binding PlacementTarget.Tag.SelectHistoryEntryCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}"
                                                              ToolTip="Load this delivery note into the editor"/>
                                                    <Separator/>
                                                    <MenuItem Header="🧾  Convert to Tax Invoice"
                                                              Style="{StaticResource HistoryContextMenuItemStyle}"
                                                              Command="{Binding PlacementTarget.Tag.ConvertToTaxInvoiceCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}"
                                                              ToolTip="Create a Tax Invoice from this DN (Phase 19)"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>

                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding TypeIcon}"
                                                               FontSize="18"
                                                               VerticalAlignment="Top"
                                                               Margin="0,1,10,0"/>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding DeliveryNoteId}"
                                                                       Style="{StaticResource HistoryRowDnIdStyle}"/>
                                                            <Border CornerRadius="4" Padding="5,1"
                                                                    Margin="5,0,0,0"
                                                                    Background="{DynamicResource MenuHoverBrush}"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock FontSize="9" FontWeight="Bold"
                                                                           Foreground="{DynamicResource SecondaryForegroundBrush}">
                                                                    <Run Text="#"/>
                                                                    <Run Text="{Binding SequenceNumber, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </Border>
                                                            <Border CornerRadius="4" Padding="7,2"
                                                                    Margin="6,0,0,0"
                                                                    Background="#047857"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding IsCurrentDn,
                                                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="✏️  EDITING"
                                                                           FontSize="10" FontWeight="Bold"
                                                                           Foreground="White"/>
                                                            </Border>
                                                            <Border CornerRadius="4" Padding="5,1"
                                                                    Margin="5,0,0,0"
                                                                    Background="{DynamicResource TintIndigoBrush}"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding HasAttachments,
                                                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock FontSize="9" FontWeight="Bold"
                                                                           Foreground="{DynamicResource PrimaryForegroundBrush}">
                                                                    <Run Text="📎 "/>
                                                                    <Run Text="{Binding AttachmentCount, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock FontSize="11"
                                                                   Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}">
                                                            <Run Text="{Binding DeliveryDate, Mode=OneWay}"/>
                                                            <Run Text="  ·  🚚 "/>
                                                            <Run Text="{Binding DriverName, Mode=OneWay}"/>
                                                        </TextBlock>

                                                        <TextBlock Text="You are editing this delivery note"
                                                                   FontSize="10" FontStyle="Italic"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#047857"
                                                                   Margin="0,4,0,0"
                                                                   Visibility="{Binding IsCurrentDn,
                                                                       Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2"
                                                                VerticalAlignment="Top"
                                                                HorizontalAlignment="Right">
                                                        <TextBlock HorizontalAlignment="Right"
                                                                   FontSize="13" FontWeight="Bold"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}">
                                                            <Run Text="{Binding DeliveredQty, Mode=OneWay}"/>
                                                            <Run Text=" pcs"/>
                                                        </TextBlock>
                                                        <Border CornerRadius="6" Padding="7,3"
                                                                Margin="0,4,0,0"
                                                                HorizontalAlignment="Right"
                                                                Background="{Binding StatusBrushKey,
                                                                             Converter={StaticResource BrushKeyConverter}}">
                                                            <TextBlock Text="{Binding Status}"
                                                                       FontSize="9" FontWeight="Bold"
                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                        </Border>

                                                        <Button Content="🧾  Tax Invoice"
                                                                Command="{Binding DataContext.ConvertToTaxInvoiceCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource TaxInvoiceRowButtonStyle}"
                                                                Margin="0,6,0,0"
                                                                HorizontalAlignment="Right"
                                                                ToolTip="Convert this DN to Tax Invoice (Phase 19)"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Border Margin="0,8,0,0"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource ModuleBackgroundBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        SnapsToDevicePixels="True">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                            <TextBlock Text="ORDERED" Style="{StaticResource CumulativeLabelStyle}"/>
                                                            <TextBlock Text="{Binding OrderedQty, Mode=OneWay}"
                                                                       Style="{StaticResource CumulativeValueStyle}"
                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Style="{StaticResource CumulativeSeparatorStyle}"/>
                                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                            <TextBlock Text="PREV" Style="{StaticResource CumulativeLabelStyle}"/>
                                                            <TextBlock Text="{Binding CumulativePrevQty, Mode=OneWay}"
                                                                       Style="{StaticResource CumulativeValueStyle}"
                                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="3" Style="{StaticResource CumulativeSeparatorStyle}"/>
                                                        <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                                            <TextBlock Text="THIS DN"
                                                                       Style="{StaticResource CumulativeLabelStyle}"
                                                                       Foreground="#047857"/>
                                                            <TextBlock Text="{Binding DeliveredQty, Mode=OneWay}"
                                                                       Style="{StaticResource CumulativeValueStyle}"
                                                                       Foreground="#047857"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="5" Style="{StaticResource CumulativeSeparatorStyle}"/>
                                                        <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                                                            <TextBlock Text="BALANCE"
                                                                       Style="{StaticResource CumulativeLabelStyle}"
                                                                       Foreground="#B45309"/>
                                                            <TextBlock Text="{Binding CumulativeBalanceQty, Mode=OneWay}"
                                                                       Style="{StaticResource CumulativeValueStyle}"
                                                                       Foreground="#B45309"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- History totals (fixed at bottom) -->
                    <Border Grid.Row="2"
                            Margin="12,0,12,12"
                            Padding="12,10"
                            CornerRadius="10"
                            Background="{DynamicResource TintIndigoBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding HistoryTotalOrdered}"
                                           FontSize="18" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                <TextBlock Text="Ordered"
                                           FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding HistoryTotalDelivered}"
                                           FontSize="18" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Foreground="#047857"/>
                                <TextBlock Text="Delivered"
                                           FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding HistoryTotalBalance}"
                                           FontSize="18" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Foreground="#B45309"/>
                                <TextBlock Text="Balance"
                                           FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

        </Grid>

    </Grid>
</UserControl>