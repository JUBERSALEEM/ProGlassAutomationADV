<UserControl Style="{StaticResource ErpPageRootStyle}" x:Class="ProGlassAutomation.Views.DeliveryNote.DeliveryNoteDetail.DeliveryNoteDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:sections="clr-namespace:ProGlassAutomation.Views.DeliveryNote.DeliveryNoteDetail.Sections"
             xmlns:loading="clr-namespace:ProGlassAutomation.Controls.LoadingState"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding BackCommand}"/>
    </UserControl.InputBindings>

        <UserControl.Resources>
        <!-- Migrated FocBadgeStyle to global Badge.Primary -->
    </UserControl.Resources>


    <!-- ROOT GRID
         Row 0: Action bar
         Row 1: Master DN banner
         Row 2: Loading/Error
         Row 3: Stats + Attachments
         Row 4: Items + History
    -->
    <!-- 2026-09-10: page-level scroller — Master DN (and tall detail
         pages generally) could clip the balance stats below the fold with
         no way to reach them. Star rows size to content under the
         ScrollViewer's infinite measure, so nothing else changes. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="{DynamicResource DensityPageMargin}"
          Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ ROW 0 — ACTION BAR ═══ -->
        <Border Grid.Row="0"
                Style="{StaticResource ModuleDetailActionBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource OutlinedPillButton}"
                        Tag="&#xE72B;" Content="{DynamicResource Action.Back}"
                        Command="{Binding BackCommand}"
                        Margin="0,0,12,0"
                        ToolTip="{DynamicResource DeliveryNote.BackListEsc}"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding DeliveryNoteId}"
                               Style="{StaticResource ModuleDetailTitleStyle}"/>
                    <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource CardBorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="10,3"
                            Margin="10,0,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource TintIndigoBrush}">
                        <TextBlock Text="{Binding DeliveryType}"
                                   FontSize="{StaticResource TextCaption}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Border>
                    <Border Style="{StaticResource Badge.Primary}">
                        <TextBlock Text="{DynamicResource DeliveryNote.FREECharge}"
                                   FontSize="{StaticResource TextCaption}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Border>
                    <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource CardBorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="10,3"
                            Margin="6,0,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource TintGreenBrush}">
                        <TextBlock Text="{Binding Status}"
                                   FontSize="{StaticResource TextCaption}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource SuccessBrush}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button
                        Style="{StaticResource PrimaryPillButton}"
                            Tag="&#xE74E;" Content="{DynamicResource Action.Save}"
                            Command="{Binding SaveCommand}"
                            Margin="0,0,8,0"
                            ToolTip="{DynamicResource DeliveryNote.SaveDispatchingDNDispatchedRemainingQtyStays}"
                            Visibility="{Binding IsNotMasterDn,
                                         Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <Button
                        Style="{StaticResource OutlinedPillButton}"
                            Tag="&#xE7B8;" Content="{DynamicResource DeliveryNote.CreateBalance}"
                            Command="{Binding CreateNewDnFromMasterCommand}"
                            Margin="0,0,8,0"
                            ToolTip="{DynamicResource DeliveryNote.CreateNewDispatchingDNRemainingBalance}"/>

                    <Button Style="{StaticResource OutlinedPillButton}" x:Name="ActionsMenuButton"
                           
                            Tag="&#xE712;" Content="{DynamicResource Common.Actions}"
                            ToolTip="{DynamicResource DeliveryNote.SaveDispatchExportMore}"
                            behaviors:DropdownButtonBehavior.Popup="{Binding ElementName=ActionsMenuPopup}"/>

                    <Popup x:Name="ActionsMenuPopup"
                           PlacementTarget="{Binding ElementName=ActionsMenuButton}"
                           Placement="Bottom"
                           HorizontalAlignment="Right"
                           VerticalOffset="4"
                           AllowsTransparency="True"
                           StaysOpen="True"
                           PopupAnimation="Fade">
                        <Border Background="{DynamicResource PopupSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                BorderThickness="{DynamicResource Border.HairlineThickness}"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                Padding="6"
                                MinWidth="220"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4"
                                                  Direction="270" Opacity="0.25"
                                                  Color="{DynamicResource LiquidShadowColor}"/>
                            </Border.Effect>
                            <StackPanel>
                                <Button
                                    Style="{StaticResource PrimaryPillButton}"
                                        Tag="&#xE74E;" Content="{DynamicResource DeliveryNote.SaveDispatch}"
                                        Command="{Binding SaveCommand}"
                                        behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                                <Button
                                    Style="{StaticResource OutlinedPillButton}"
                                        Tag="&#xE81C;" Content="{DynamicResource Common.VersionHistory}"
                                        Command="{Binding ShowVersionsCommand}"
                                        behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                                <Border Height="1" Margin="10,4"
                                        Background="{DynamicResource BorderDefaultBrush}"/>
                                <Button
                                    Style="{StaticResource OutlinedPillButton}"
                                        Tag="&#xE8A5;" Content="{DynamicResource DeliveryNote.ExportPDF}"
                                        Command="{Binding ExportPdfCommand}"
                                        behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                                <Button
                                    Style="{StaticResource OutlinedPillButton}"
                                        Tag="&#xE9F9;" Content="{DynamicResource DeliveryNote.ExportExcel}"
                                        Command="{Binding ExportExcelCommand}"
                                        behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                                <Button
                                    Style="{StaticResource OutlinedPillButton}"
                                        Tag="&#xE72D;" Content="{DynamicResource DeliveryNote.ExportCSV}"
                                        Command="{Binding ExportCsvCommand}"
                                        behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                                <Button
                                    Style="{StaticResource OutlinedPillButton}"
                                        Tag="&#xE72D;" Content="{DynamicResource Sharing.Share}"
                                        Command="{Binding ShareCommand}"
                                        behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                                <Border Height="1" Margin="10,4"
                                        Background="{DynamicResource BorderDefaultBrush}"/>
                                <Button
                                    Style="{StaticResource DangerButton}"
                                        Tag="&#xE74D;" Content="{DynamicResource DeliveryNote.DeleteDeliveryNote}"
                                        Command="{Binding DeleteDnCommand}"
                                        behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1 removed — Master DN banner no longer needed -->

        <!-- ═══ ROW 2 — LOADING / ERROR ═══ -->
        <StackPanel Grid.Row="2">
            <loading:LoadingStateControl
                    Visibility="{Binding IsLoading,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Message="Loading delivery note…"
                    Margin="0,8,0,12"/>
            <Border Visibility="{Binding HasError,
                                 Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource ModuleErrorBannerStyle}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="{StaticResource TextBodyLarge}" FontWeight="{DynamicResource Weight.SemiBold}"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- ERP hardening (Phase 2): once a delivery note is Dispatched
                 (goods have left) its body is locked. -->
            <Border Style="{StaticResource ModuleWarningBannerStyle}"
                    Visibility="{Binding BodyLockBannerVisibility}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                               FontSize="{StaticResource TextBodyLarge}"
                               Foreground="{DynamicResource WarningBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{DynamicResource Lock.PostedBodyLocked}"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource TextBody}" FontWeight="{DynamicResource Weight.SemiBold}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ═══ ROW 3 — STATS | ATTACHMENTS ═══ -->
        <!-- ══ DETAIL TABS — Overview / Attachments / History ════════ -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="{DynamicResource Nav.Overview}" Tag="&#xE8A5;" Margin="0,0,8,0"
                    ToolTip="{DynamicResource DeliveryNote.StatsDeliveredItems}"
                    Command="{Binding SwitchDetailTabCommand}" CommandParameter="Overview">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RowOutlinedButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOverviewTab}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="{DynamicResource DeliveryNote.Attachments}" Tag="&#xE723;" Margin="0,0,8,0"
                    ToolTip="{DynamicResource DeliveryNote.AttachedPhotosSignedCopies}"
                    Command="{Binding SwitchDetailTabCommand}" CommandParameter="Attachments">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RowOutlinedButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAttachmentsTab}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="{DynamicResource DeliveryNote.History}" Tag="&#xE81C;"
                    ToolTip="{DynamicResource DeliveryNote.DeliveryHistoryTimeline}"
                    Command="{Binding SwitchDetailTabCommand}" CommandParameter="History">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RowOutlinedButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHistoryTab}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- ══ TAB CONTENT — each section its own UserControl ════════ -->
        <Grid Grid.Row="4">
            <!-- ERP hardening (Phase 2): the body (Overview) form freezes once
                 the DN is Dispatched; attachments and history stay usable. -->
            <sections:DnOverviewSection
                IsEnabled="{Binding IsBodyEditable}"
                Visibility="{Binding IsOverviewTab, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <sections:DnAttachmentsSection
                Visibility="{Binding IsAttachmentsTab, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <sections:DnHistorySection
                Visibility="{Binding IsHistoryTab, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>