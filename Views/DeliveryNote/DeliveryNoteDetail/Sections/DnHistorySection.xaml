<!-- DN history — document-section card.
     SelectHistoryEntryCommand, ConvertToTaxInvoiceCommand, context menu
     Tag wiring, CanInvoice / IsInvoiced, HistoryRowOuterButtonStyle: unchanged. -->
<UserControl x:Class="ProGlassAutomation.Views.DeliveryNote.DeliveryNoteDetail.Sections.DnHistorySection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DnSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
            BorderThickness="{DynamicResource CardBorderThickness}"
            CornerRadius="{DynamicResource CardCornerRadius}"
            Background="{DynamicResource SurfacePrimaryBrush}"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource SectionHeaderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="{DynamicResource FontSize.Body}"
                                   FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="&#xE8C8;" FontFamily="{DynamicResource FontFamily.Icon}"/><Run Text="{DynamicResource DeliveryNote.DeliveryHistory}"/>
                        </TextBlock>
                        <TextBlock Text="{DynamicResource DeliveryNote.ClickOpenRightClickOptions}"
                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="8,4"
                            Background="{DynamicResource TintIndigoBrush}"
                            VerticalAlignment="Center">
                        <TextBlock FontSize="{DynamicResource FontSize.BodySmall}"
                                   FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource AccentBrush}">
                            <Run Text="{Binding HistoryTotalDelivered, Mode=OneWay}"/>
                            <Run Text=" / "/>
                            <Run Text="{Binding HistoryTotalOrdered, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          Focusable="True"
                          FocusVisualStyle="{x:Null}"
                          behaviors:SmoothScrollBehavior.IsEnabled="True">
                <ItemsControl ItemsSource="{Binding HistoryEntries}"
                              Margin="0,8,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource HistoryRowOuterButtonStyle}"
                                    Command="{Binding DataContext.SelectHistoryEntryCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Border Style="{StaticResource SurfaceDetailStyle}"
                                        Tag="{Binding DataContext,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{DynamicResource DeliveryNote.OpenDN}"
                                                      FontSize="{DynamicResource FontSize.Body}"
                                                      FontWeight="{DynamicResource Weight.Regular}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      Command="{Binding PlacementTarget.Tag.SelectHistoryEntryCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"/>
                                            <Separator/>
                                            <MenuItem Header="{DynamicResource DeliveryNote.ConvertTaxInvoice}"
                                                      FontSize="{DynamicResource FontSize.Body}"
                                                      FontWeight="{DynamicResource Weight.Regular}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      Command="{Binding PlacementTarget.Tag.ConvertToTaxInvoiceCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding TypeIcon}"
                                                       FontSize="{DynamicResource FontSize.H2}"
                                                       VerticalAlignment="Top"
                                                       Margin="0,4,12,0"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DeliveryNoteId}"
                                                               Style="{StaticResource Typography.Body}"/>
                                                    <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                                                            CornerRadius="{DynamicResource Radius.XSmall}"
                                                            Padding="8,4"
                                                            Margin="8,0,0,0"
                                                            Background="{DynamicResource SurfaceTertiaryBrush}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock FontSize="{DynamicResource FontSize.BodySmall}"
                                                                   FontWeight="{DynamicResource Weight.Bold}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}">
                                                            <Run Text="#"/>
                                                            <Run Text="{Binding SequenceNumber, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <Border CornerRadius="{DynamicResource Radius.XSmall}"
                                                            Padding="8,4"
                                                            Margin="8,0,0,0"
                                                            Background="{DynamicResource SuccessBrush}"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsCurrentDn,
                                                                Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock FontSize="{DynamicResource FontSize.BodySmall}"
                                                                   FontWeight="{DynamicResource Weight.Bold}"
                                                                   Foreground="{DynamicResource OnAccentForegroundBrush}">
                                                            <Run Text="&#xE8E5;" FontFamily="{DynamicResource FontFamily.Icon}"/><Run Text="{DynamicResource DeliveryNote.Editing}"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                                                            CornerRadius="{DynamicResource Radius.XSmall}"
                                                            Padding="8,4"
                                                            Margin="8,0,0,0"
                                                            Background="{DynamicResource TintIndigoBrush}"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding HasAttachments,
                                                                Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock FontSize="{DynamicResource FontSize.BodySmall}"
                                                                   FontWeight="{DynamicResource Weight.Bold}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}">
                                                            <Run Text="&#xE723;" FontFamily="{DynamicResource FontFamily.Icon}"/><Run Text=" "/>
                                                            <Run Text="{Binding AttachmentCount, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                                                            CornerRadius="{DynamicResource Radius.XSmall}"
                                                            Padding="8,4"
                                                            Margin="8,0,0,0"
                                                            Background="{DynamicResource TintGreenBrush}"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsInvoiced,
                                                                Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding InvoicedBadgeText, Mode=OneWay}"
                                                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                                                   FontWeight="{DynamicResource Weight.Bold}"
                                                                   Foreground="{DynamicResource SuccessBrush}"/>
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock FontSize="{DynamicResource FontSize.Body}"
                                                           Margin="0,4,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="{Binding DeliveryDate, Mode=OneWay}"/>
                                                    <Run Text="  ·  "/><Run Text="&#xE7F4;" FontFamily="{DynamicResource FontFamily.Icon}"/><Run Text=" "/>
                                                    <Run Text="{Binding DriverName, Mode=OneWay}"/>
                                                </TextBlock>

                                                <TextBlock Text="{DynamicResource DeliveryNote.EditingDeliveryNote}"
                                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                                           FontStyle="Italic"
                                                           FontWeight="{DynamicResource Weight.SemiBold}"
                                                           Foreground="{DynamicResource SuccessBrush}"
                                                           Margin="0,4,0,0"
                                                           Visibility="{Binding IsCurrentDn,
                                                               Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Top"
                                                        HorizontalAlignment="Right">
                                                <TextBlock HorizontalAlignment="Right"
                                                           FontSize="{DynamicResource FontSize.Title}"
                                                           FontWeight="{DynamicResource Weight.Bold}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                                    <Run Text="{Binding DeliveredQty, Mode=OneWay}"/>
                                                    <Run Text=" pcs"/>
                                                </TextBlock>
                                                <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                                                        Padding="8,4"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Right"
                                                        Background="{Binding StatusBrushKey,
                                                                     Converter={StaticResource BrushKeyConverter}}">
                                                    <TextBlock Text="{Binding Status}"
                                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                                               FontWeight="{DynamicResource Weight.Bold}"
                                                               Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                                </Border>
                                                <Button Command="{Binding DataContext.ConvertToTaxInvoiceCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding CanInvoice}"
                                                        Margin="0,8,0,0"
                                                        HorizontalAlignment="Right">
                                                    <Button.Style>
                                                        <Style TargetType="Button"
                                                               BasedOn="{StaticResource TaxInvoiceRowButtonStyle}">
                                                            <Setter Property="Content" Value="TAX INVOICE"/>
                                                            <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInvoiced}" Value="True">
                                                                    <Setter Property="Content" Value="INVOICED"/>
                                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                                    <Setter Property="Cursor" Value="Arrow"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <Border Margin="0,8,0,0"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Background="{DynamicResource SurfacePrimaryBrush}"
                                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                BorderThickness="{DynamicResource Border.HairlineThickness}"
                                                Padding="8,8"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource Common.Ordered}"
                                                               Style="{StaticResource Typography.Caption}"/>
                                                    <TextBlock Text="{Binding OrderedQty, Mode=OneWay}"
                                                               Style="{StaticResource Typography.Title}"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Style="{StaticResource SurfaceDetailStyle}"/>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource DeliveryNote.PREV}"
                                                               Style="{StaticResource Typography.Caption}"/>
                                                    <TextBlock Text="{Binding CumulativePrevQty, Mode=OneWay}"
                                                               Style="{StaticResource Typography.Title}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <Border Grid.Column="3" Style="{StaticResource SurfaceDetailStyle}"/>
                                                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource DeliveryNote.DN}"
                                                               Style="{StaticResource Typography.Caption}"
                                                               Foreground="{DynamicResource SuccessBrush}"/>
                                                    <TextBlock Text="{Binding DeliveredQty, Mode=OneWay}"
                                                               Style="{StaticResource Typography.Title}"
                                                               Foreground="{DynamicResource SuccessBrush}"/>
                                                </StackPanel>
                                                <Border Grid.Column="5" Style="{StaticResource SurfaceDetailStyle}"/>
                                                <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource Common.Balance}"
                                                               Style="{StaticResource Typography.Caption}"
                                                               Foreground="{DynamicResource WarningBrush}"/>
                                                    <TextBlock Text="{Binding CumulativeBalanceQty, Mode=OneWay}"
                                                               Style="{StaticResource Typography.Title}"
                                                               Foreground="{DynamicResource WarningBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Margin="12,0,12,12"
                    Padding="12,8"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Background="{DynamicResource TintIndigoBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="{DynamicResource Border.HairlineThickness}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <Viewbox MaxHeight="28" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding HistoryTotalOrdered}"
                                       FontSize="{DynamicResource FontSize.H2}"
                                       FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Viewbox>
                        <TextBlock Text="{DynamicResource Common.Ordered}"
                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <Viewbox MaxHeight="28" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding HistoryTotalDelivered}"
                                       FontSize="{DynamicResource FontSize.H2}"
                                       FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                        </Viewbox>
                        <TextBlock Text="{DynamicResource Common.Delivered}"
                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <Viewbox MaxHeight="28" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding HistoryTotalBalance}"
                                       FontSize="{DynamicResource FontSize.H2}"
                                       FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource WarningBrush}"/>
                        </Viewbox>
                        <TextBlock Text="{DynamicResource Common.Balance}"
                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
