<!-- DN attachments — document-section card.
     Bindings, upload/open/delete commands, HasNoAttachments: unchanged. -->
<UserControl x:Class="ProGlassAutomation.Views.DeliveryNote.DeliveryNoteDetail.Sections.DnAttachmentsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DnSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
            BorderThickness="{DynamicResource CardBorderThickness}"
            CornerRadius="{DynamicResource CardCornerRadius}"
            Background="{DynamicResource SurfacePrimaryBrush}"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource SectionHeaderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedDnHeaderText}"
                                   FontSize="{DynamicResource FontSize.Body}"
                                   FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{DynamicResource DeliveryNote.PhotosSignedCopies}"
                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource RowOutlinedButton}"
                                Tag="&#xE728;"
                                Content="{DynamicResource DeliveryNote.Image}"
                                Command="{Binding UploadImageCommand}"
                                ToolTip="{DynamicResource DeliveryNote.AttachPhoto}"
                                Margin="0,0,8,0"/>
                        <Button Style="{StaticResource RowOutlinedButton}"
                                Tag="&#xE8A5;"
                                Content="PDF"
                                Command="{Binding UploadPdfCommand}"
                                ToolTip="{DynamicResource DeliveryNote.AttachSignedPDF}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Style="{StaticResource SurfaceSecondaryStyle}"
                    Padding="12,8">
                <TextBlock FontSize="{DynamicResource FontSize.Body}"
                           FontWeight="{DynamicResource Weight.SemiBold}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap">
                    <Run Text="{DynamicResource DeliveryNote.ViewingAttachmentsDifferentDN}"/>
                </TextBlock>
            </Border>

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          Focusable="True"
                          FocusVisualStyle="{x:Null}"
                          behaviors:SmoothScrollBehavior.IsEnabled="True">
                <StackPanel>
                    <Border Padding="12,10"
                            Visibility="{Binding HasNoAttachments,
                                         Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE723;"
                                       FontFamily="{DynamicResource FontFamily.Icon}"
                                       FontSize="24"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <TextBlock Text="{DynamicResource DeliveryNote.NoAttachmentsYet}"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       FontWeight="{DynamicResource Weight.SemiBold}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,2"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource DeliveryNote.UploadPhotosSignedDeliveryCopies}"
                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Attachments}"
                                  Margin="8,4,8,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ModuleListRowStyle}"
                                        Margin="0,0,0,4"
                                        Padding="8,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="40"
                                                Height="40"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Background="{DynamicResource SurfacePrimaryBrush}"
                                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                BorderThickness="{DynamicResource Border.HairlineThickness}"
                                                ClipToBounds="True"
                                                VerticalAlignment="Center">
                                            <Grid>
                                                <Image Source="{Binding Preview}"
                                                       Stretch="UniformToFill"
                                                       Visibility="{Binding IsImage,
                                                           Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <TextBlock Text="{Binding TypeIcon}"
                                                           FontSize="{DynamicResource FontSize.H1}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsPdf,
                                                               Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Margin="12,0,12,0">
                                            <TextBlock Text="{Binding FileName}"
                                                       FontSize="{DynamicResource FontSize.Body}"
                                                       FontWeight="{DynamicResource Weight.SemiBold}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock FontSize="{DynamicResource FontSize.Body}"
                                                       Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run Text="{Binding FileSizeDisplay, Mode=OneWay}"/>
                                                <Run Text="  ·  "/>
                                                <Run Text="{Binding UploadedAtDisplay, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Style="{StaticResource RowPrimaryButton}"
                                                Tag="&#xE8B7;"
                                                Content="{DynamicResource Action.Open}"
                                                ToolTip="{DynamicResource DeliveryNote.OpenAttachment}"
                                                Command="{Binding DataContext.OpenAttachmentCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,8,0"/>
                                        <Button Grid.Column="3"
                                                Style="{StaticResource RowDangerButton}"
                                                Tag="&#xE74D;"
                                                MinWidth="40"
                                                ToolTip="{DynamicResource DeliveryNote.DeleteAttachment}"
                                                Command="{Binding DataContext.DeleteAttachmentCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
