<UserControl x:Class="ProGlassAutomation.Views.DeliveryNote.DeliveryNoteDetail.Sections.DnAttachmentsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DnSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
<!-- ATTACHMENTS CARD -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}" CornerRadius="{DynamicResource CardCornerRadius}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SectionHeaderStyle}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding SelectedDnHeaderText}"
                                           FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{DynamicResource DeliveryNote.PhotosSignedCopies}"
                                           FontSize="{StaticResource TextCaption}" Foreground="{DynamicResource OnAccentForegroundBrush}" Opacity="0.80"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource RowOutlinedButton}"
                                    Tag="&#xE728;" Content="{DynamicResource DeliveryNote.Image}"
                                    Command="{Binding UploadImageCommand}"
                                    ToolTip="{DynamicResource DeliveryNote.AttachPhoto}"
                                    Margin="0,0,6,0"/>
                            <Button Grid.Column="2"
                                    Style="{StaticResource RowOutlinedButton}"
                                    Tag="&#xE8A5;" Content="PDF"
                                    Command="{Binding UploadPdfCommand}"
                                    ToolTip="{DynamicResource DeliveryNote.AttachSignedPDF}"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Style="{StaticResource DifferentDnWarningStyle}">
                        <TextBlock FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap">
                            <Run Text="{DynamicResource DeliveryNote.ViewingAttachmentsDifferentDN}"/>
                        </TextBlock>
                    </Border>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  Focusable="True"
                                  FocusVisualStyle="{x:Null}"
                                  behaviors:SmoothScrollBehavior.IsEnabled="True">
                        <StackPanel>
                            <Border Padding="16,20"
                                    Visibility="{Binding HasNoAttachments,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE723;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextDisplay}"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    <TextBlock Text="{DynamicResource DeliveryNote.NoAttachmentsYet}"
                                               FontSize="{StaticResource TextBodyLarge}" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,4"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{DynamicResource DeliveryNote.UploadPhotosSignedDeliveryCopies}"
                                               FontSize="{StaticResource TextBody}" HorizontalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Attachments}"
                                          Margin="10,6,10,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Margin="0,4" Padding="12,10"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Background="{DynamicResource SurfaceTertiaryBrush}"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}" Grid.Column="0"
                                                        Width="40" Height="40"
                                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                                        Background="{DynamicResource SurfacePrimaryBrush}"
                                                        ClipToBounds="True"
                                                        VerticalAlignment="Center">
                                                    <Grid>
                                                        <Image Source="{Binding Preview}"
                                                               Stretch="UniformToFill"
                                                               Visibility="{Binding IsImage,
                                                                   Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <TextBlock Text="{Binding TypeIcon}"
                                                                   FontSize="{StaticResource TextHeadline}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding IsPdf,
                                                                       Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Margin="10,0,10,0">
                                                    <TextBlock Text="{Binding FileName}"
                                                               FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock FontSize="{StaticResource TextBody}" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}">
                                                        <Run Text="{Binding FileSizeDisplay, Mode=OneWay}"/>
                                                        <Run Text="  ·  "/>
                                                        <Run Text="{Binding UploadedAtDisplay, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource RowPrimaryButton}"
                                                        Tag="&#xE8B7;" Content="{DynamicResource Action.Open}"
                                                        ToolTip="{DynamicResource DeliveryNote.OpenAttachment}"
                                                        Command="{Binding DataContext.OpenAttachmentCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="0,0,6,0"/>
                                                <Button Grid.Column="3"
                                                        Style="{StaticResource RowDangerButton}"
                                                        Tag="&#xE74D;" MinWidth="40"
                                                        ToolTip="{DynamicResource DeliveryNote.DeleteAttachment}"
                                                        Command="{Binding DataContext.DeleteAttachmentCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
    </Grid>
</UserControl>
