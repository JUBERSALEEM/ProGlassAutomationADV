<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors">
    <!-- ═══════════════════════════════════════════════════════════════
         FILE: Views/DeliveryNote/DeliveryNoteDetail/Sections/DnSectionStyles.xaml
         MODULE: Delivery Note Detail — Overview Dashboard (Indigo Studio Bento) Edition
         Merges IndigoStudioResources and maps all module primitives into
         the Ov.* token family for 100% visual unification.
         ═══════════════════════════════════════════════════════════════ -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../../Dashboard/Overview/IndigoStudioResources.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Scoped Overview Dashboard / Indigo Studio palette aliases -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{Binding Color, Source={StaticResource Ov.Ink}}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{Binding Color, Source={StaticResource Ov.Muted}}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{Binding Color, Source={StaticResource Ov.Muted}}"/>
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="{Binding Color, Source={StaticResource Ov.Ink}}"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="{Binding Color, Source={StaticResource Ov.Muted}}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{Binding Color, Source={StaticResource Ov.Accent}}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{Binding Color, Source={StaticResource Ov.AccentHover}}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{Binding Color, Source={StaticResource Ov.AccentHover}}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{Binding Color, Source={StaticResource Ov.Success}}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{Binding Color, Source={StaticResource Ov.Warning}}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{Binding Color, Source={StaticResource Ov.Danger}}"/>
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="{Binding Color, Source={StaticResource Ov.Line}}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{Binding Color, Source={StaticResource Ov.Line}}"/>
    <SolidColorBrush x:Key="SurfacePrimaryBrush" Color="{Binding Color, Source={StaticResource Ov.Surface}}"/>
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{Binding Color, Source={StaticResource Ov.Surface}}"/>
    <SolidColorBrush x:Key="SurfaceTertiaryBrush" Color="{Binding Color, Source={StaticResource Ov.Soft}}"/>
    <SolidColorBrush x:Key="PopupSurfaceBrush" Color="{Binding Color, Source={StaticResource Ov.Surface}}"/>
    <SolidColorBrush x:Key="OnAccentForegroundBrush" Color="{Binding Color, Source={StaticResource Ov.OnAccent}}"/>
    <SolidColorBrush x:Key="TintIndigoBrush" Color="{Binding Color, Source={StaticResource Ov.Soft}}"/>
    <SolidColorBrush x:Key="TintBlueBrush" Color="{Binding Color, Source={StaticResource Ov.Soft}}"/>
    <SolidColorBrush x:Key="TintGrayBrush" Color="{Binding Color, Source={StaticResource Ov.Soft}}"/>
    <SolidColorBrush x:Key="TintRedBrush" Color="{Binding Color, Source={StaticResource Ov.DangerSoft}}"/>
    <SolidColorBrush x:Key="TintAmberBrush" Color="{Binding Color, Source={StaticResource Ov.WarningSoft}}"/>
    <SolidColorBrush x:Key="TintGreenBrush" Color="{Binding Color, Source={StaticResource Ov.SuccessSoft}}"/>
    <SolidColorBrush x:Key="Surface.Primary.BackgroundBrush" Color="{Binding Color, Source={StaticResource Ov.Surface}}"/>
    <SolidColorBrush x:Key="Surface.Secondary.BackgroundBrush" Color="{Binding Color, Source={StaticResource Ov.Surface}}"/>

    <!-- Bento Card Styles for Delivery Note -->
    <Style x:Key="CompactStatTileStyle" TargetType="Border" BasedOn="{StaticResource Ov.CardMicro}">
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Background" Value="{DynamicResource Ov.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ov.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <Style x:Key="MasterHeroStripStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ov.Hero}"/>
        <Setter Property="CornerRadius" Value="18,18,0,0"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="SpecGroupCardStyle" TargetType="Border" BasedOn="{StaticResource Ov.Card}">
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ov.Soft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ov.Line}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="CornerRadius" Value="18,18,0,0"/>
    </Style>

    <Style x:Key="HistoryRowButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Margin="12,4,12,4"
                            Background="Transparent"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DeliveredQtyReadOnlyStyle" TargetType="TextBlock"
           BasedOn="{StaticResource GridNumericCell}">
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.Bold}"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsMasterDn,
                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DeliveredQtyTextBoxStyle" TargetType="TextBox">
        <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Title}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.Bold}"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="8,4,10,4"/>
        <Setter Property="Margin" Value="6,3"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}"/>
        <Setter Property="Visibility" Value="Visible"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsMasterDn,
                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HistoryRowOuterButtonStyle" TargetType="Button"
           BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Opacity" Value="0.90"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1.0"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsCurrentDn}" Value="True">
                <Setter Property="Opacity" Value="1.0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ItemsSectionSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.BodySmall}"/>
        <Setter Property="Foreground"
                Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="Text"
                Value="Enter qty in THIS DN then Save. Prev auto-updates."/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMasterDn}" Value="True">
                <Setter Property="Text"
                        Value="Showing only items with remaining balance. Fully delivered items hidden."/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsMasterDn}" Value="True"/>
                    <Condition Binding="{Binding ShowFullMaster}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Text"
                        Value="Full original Master as created from the Job Order. Delivered lines stay for reference."/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ItemsSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.Bold}"/>
        <Setter Property="Foreground"
                Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Text" Value="DELIVERY ITEMS"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMasterDn}" Value="True">
                <Setter Property="Text" Value="BALANCE ITEMS — PENDING DELIVERY"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsMasterDn}" Value="True"/>
                    <Condition Binding="{Binding ShowFullMaster}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Text" Value="MASTER ITEMS — ORIGINAL FROM JOB ORDER"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrevDeliveredLabelStyle" TargetType="TextBlock"
           BasedOn="{StaticResource Typography.Label}">
        <Setter Property="Text" Value="PREV DELIVERED"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMasterDn}" Value="True">
                <Setter Property="Text" Value="TOTAL DELIVERED"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TaxInvoiceRowButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.BodySmall}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.Bold}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.70"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background"
                                    Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextTertiaryBrush}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThisDnLabelStyle" TargetType="TextBlock"
           BasedOn="{StaticResource Typography.Label}">
        <Setter Property="Text" Value="THIS DN"/>
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMasterDn}" Value="True">
                <Setter Property="Text" Value="IN PROGRESS"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
