<UserControl x:Class="ProGlassAutomation.Views.DeliveryNote.DeliveryNoteDetail.Sections.DnOverviewSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DnSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
<!-- STATS CARD -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12"
                    SnapsToDevicePixels="True">
                <StackPanel>
                    <Border Style="{StaticResource SectionHeaderStyle}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#4338CA" Offset="0"/>
                                <GradientStop Color="#6366F1" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock FontSize="11" FontWeight="Bold"
                                       Foreground="White"><Run Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets"/><Run Text="  QUICK STATS"/></TextBlock>
                            <TextBlock Text="Delivery numbers at a glance"
                                       FontSize="10" Foreground="#CCFFFFFF"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="12,12,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Style="{StaticResource CompactStatTileStyle}">
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding TotalOrderedQty}"
                                               Style="{StaticResource CompactStatNumberStyle}"/>
                                    <TextBlock Text=" pcs"
                                               Style="{StaticResource CompactStatUnitStyle}"/>
                                </StackPanel>
                                <TextBlock Text="ORDERED"
                                           Style="{StaticResource CompactStatLabelStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0"
                                Style="{StaticResource CompactStatTileStyle}"
                                Background="{DynamicResource TintIndigoBrush}">
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding TotalPreviouslyDeliveredQty}"
                                               Style="{StaticResource CompactStatNumberStyle}"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text=" pcs"
                                               Style="{StaticResource CompactStatUnitStyle}"
                                               Foreground="{DynamicResource AccentBrush}" Opacity="0.75"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource PrevDeliveredLabelStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0"
                                Style="{StaticResource CompactStatTileStyle}"
                                Background="{DynamicResource TintGreenBrush}">
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding TotalDeliveredQty}"
                                               Style="{StaticResource CompactStatNumberStyle}"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                    <TextBlock Text=" pcs"
                                               Style="{StaticResource CompactStatUnitStyle}"
                                               Foreground="{DynamicResource SuccessBrush}" Opacity="0.75"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource ThisDnLabelStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="2"
                                Style="{StaticResource CompactStatTileStyle}"
                                Background="{DynamicResource TintAmberBrush}">
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding TotalBalanceQty}"
                                               Style="{StaticResource CompactStatNumberStyle}"
                                               Foreground="{DynamicResource WarningBrush}"/>
                                    <TextBlock Text=" pcs"
                                               Style="{StaticResource CompactStatUnitStyle}"
                                               Foreground="{DynamicResource WarningBrush}" Opacity="0.75"/>
                                </StackPanel>
                                <TextBlock Text="BALANCE"
                                           Style="{StaticResource CompactStatLabelStyle}"
                                           Foreground="{DynamicResource WarningBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Progress bar -->
                    <Border Margin="12,0,12,12" CornerRadius="8"
                            Padding="12,8"
                            Background="{DynamicResource MenuHoverBrush}">
                        <StackPanel>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="OVERALL DELIVERY PROGRESS"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           FontSize="11" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}">
                                    <Run Text="{Binding DeliveryProgressPercent,
                                                Mode=OneWay,
                                                StringFormat={}{0:0.#}}"/>
                                    <Run Text="%"/>
                                </TextBlock>
                            </Grid>
                            <Border x:Name="StatsProgressTrack"
                                    CornerRadius="4" Height="8"
                                    Background="{DynamicResource BorderBrush}">
                                <Border CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource AccentBrush}">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                            <Binding Path="DeliveryProgressPercent"/>
                                            <Binding Path="ActualWidth"
                                                     ElementName="StatsProgressTrack"/>
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
<!-- ITEMS CARD -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Hero strip -->
                    <Border Grid.Row="0" Style="{StaticResource MasterHeroStripStyle}"
                        Background="{DynamicResource AccentBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource HeroStripLabelStyle}"/>
                                    <TextBlock Text="{Binding CustomerName}"
                                               Style="{StaticResource MasterHeroTitleStyle}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ProjectName}"
                                           Style="{StaticResource MasterHeroSubtitleStyle}"
                                           MaxWidth="500" Margin="0,4,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="JO:"
                                               Style="{StaticResource MasterHeroMetaLabelStyle}"/>
                                    <TextBlock Text="{Binding JobOrderId}"
                                               Style="{StaticResource MasterHeroMetaValueStyle}"/>
                                    <TextBlock Style="{StaticResource MasterHeroDividerStyle}"/>
                                    <TextBlock Text="PI:"
                                               Style="{StaticResource MasterHeroMetaLabelStyle}"/>
                                    <TextBlock Text="{Binding ProformaId}"
                                               Style="{StaticResource MasterHeroMetaValueStyle}"/>
                                    <TextBlock Style="{StaticResource MasterHeroDividerStyle}"/>
                                    <TextBlock Text="SEQ:"
                                               Style="{StaticResource MasterHeroMetaLabelStyle}"/>
                                    <TextBlock Text="{Binding SequenceNumber}"
                                               Style="{StaticResource MasterHeroMetaValueStyle}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding DeliveryDateDisplay}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding DeliveryTime}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="#EAFFFFFF"
                                           HorizontalAlignment="Right"
                                           Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding CompanyName}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="#CCFFFFFF"
                                           HorizontalAlignment="Right"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="240"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Details form -->
                    <Border Grid.Row="1" Style="{StaticResource DetailFormStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="STATUS"/>
                                <ComboBox ItemsSource="{Binding StatusOptions}"
                                          SelectedItem="{Binding Status}"
                                          FontSize="12" Height="38"
                                          VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="DRIVER NAME"/>
                                <TextBox Text="{Binding DriverName,
                                                UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12" Padding="10,6"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="4">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="VEHICLE NUMBER"/>
                                <TextBox Text="{Binding VehicleNumber,
                                                UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12" Padding="10,6"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="6"
                                        VerticalAlignment="Bottom">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="FOC"/>
                                <CheckBox IsChecked="{Binding IsFoc}"
                                          Content="Free" FontSize="12"
                                          Foreground="{DynamicResource PrimaryForegroundBrush}"
                                          VerticalAlignment="Center" Height="38"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0"
                                        Grid.ColumnSpan="3">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="RECEIVER NAME"/>
                                <TextBox Text="{Binding ReceiverName,
                                                UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12" Padding="10,6"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="4"
                                        Grid.ColumnSpan="3">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="NOTES"/>
                                <TextBox Text="{Binding Notes,
                                                UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12" Padding="10,6"
                                         Height="38" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ITEMS TABLE -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  CanContentScroll="False"
                                  Focusable="True"
                                  FocusVisualStyle="{x:Null}"
                                  behaviors:SmoothScrollBehavior.IsEnabled="True">
                        <StackPanel Margin="14,12,14,14">

                            <!-- Items header + action buttons -->
                            <Grid Margin="4,0,4,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource ItemsSectionTitleStyle}"/>
                                    <TextBlock Style="{StaticResource ItemsSectionSubtitleStyle}"/>
                                </StackPanel>

                                <!-- SELECT ALL REMAINING -->
                                <Button Grid.Column="1"
                                        Style="{StaticResource RowPrimaryButton}"
                                        Tag="&#xE73E;" Content="SELECT ALL REMAINING"
                                        Command="{Binding FillRemainingCommand}"
                                        ToolTip="Fill ALL balance quantities into Delivered column."/>

                                <!-- RESET QTY — NEW CHAT 19 -->
                                <Button Grid.Column="3"
                                        Style="{StaticResource RowOutlinedButton}"
                                        Tag="&#xE72C;" Content="RESET QTY"
                                        Command="{Binding ResetQtyCommand}"
                                        ToolTip="Reset all Delivered quantities back to 0."/>
                            </Grid>

                            <!-- Items grouped by spec -->
                            <ItemsControl ItemsSource="{Binding GroupedItemsView}">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="GroupItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="GroupItem">
                                                            <Border Style="{StaticResource SpecGroupCardStyle}">
                                                                <StackPanel>
                                                                    <Border Style="{StaticResource SpecGroupHeaderStyle}">
                                                                        <Border.Background>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                                <GradientStop Color="#4338CA" Offset="0"/>
                                                                                <GradientStop Color="#6366F1" Offset="1"/>
                                                                            </LinearGradientBrush>
                                                                        </Border.Background>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Border Width="4" CornerRadius="2"
                                                                                    Background="White"
                                                                                    Margin="0,0,10,0"/>
                                                                            <TextBlock Text="SPEC:  "
                                                                                       FontSize="12" FontWeight="Bold"
                                                                                       Foreground="#CCFFFFFF"
                                                                                       VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding Name}"
                                                                                       FontSize="14" FontWeight="Bold"
                                                                                       Foreground="White"
                                                                                       VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>

                                                                    <!-- Column headers -->
                                                                    <Border Background="{DynamicResource MenuHoverBrush}"
                                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                                            BorderThickness="0,0,0,1">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="40"/>
                                                                                <ColumnDefinition Width="*" MinWidth="200"/>
                                                                                <ColumnDefinition Width="60"/>
                                                                                <ColumnDefinition Width="60"/>
                                                                                <ColumnDefinition Width="60"/>
                                                                                <ColumnDefinition Width="60"/>
                                                                                <ColumnDefinition Width="55"/>
                                                                                <ColumnDefinition Width="70"/>
                                                                                <ColumnDefinition Width="80"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="65"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="95"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="70"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="#"
                                                                                       Style="{StaticResource GridHeaderCell}"
                                                                                       HorizontalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="1" Text="GLASS REF"
                                                                                       Style="{StaticResource GridHeaderCell}"/>
                                                                            <TextBlock Grid.Column="2" Text="W1"
                                                                                       Style="{StaticResource GridHeaderCell}"
                                                                                       HorizontalAlignment="Right"
                                                                                       Margin="6,8,10,8"/>
                                                                            <TextBlock Grid.Column="3" Text="H1"
                                                                                       Style="{StaticResource GridHeaderCell}"
                                                                                       HorizontalAlignment="Right"
                                                                                       Margin="6,8,10,8"/>
                                                                            <TextBlock Grid.Column="4" Text="W2"
                                                                                       Style="{StaticResource GridHeaderCell}"
                                                                                       HorizontalAlignment="Right"
                                                                                       Margin="6,8,10,8"/>
                                                                            <TextBlock Grid.Column="5" Text="H2"
                                                                                       Style="{StaticResource GridHeaderCell}"
                                                                                       HorizontalAlignment="Right"
                                                                                       Margin="6,8,10,8"/>
                                                                            <TextBlock Grid.Column="6" Text="QTY"
                                                                                       Style="{StaticResource GridHeaderCell}"
                                                                                       HorizontalAlignment="Right"
                                                                                       Margin="6,8,10,8"/>
                                                                            <TextBlock Grid.Column="7" Text="SQM"
                                                                                       Style="{StaticResource GridHeaderCell}"
                                                                                       HorizontalAlignment="Right"
                                                                                       Margin="6,8,10,8"/>
                                                                            <TextBlock Grid.Column="8" Text="TOTAL SQM"
                                                                                       Style="{StaticResource GridHeaderCell}"
                                                                                       HorizontalAlignment="Right"
                                                                                       Margin="6,8,10,8"/>
                                                                            <Border Grid.Column="9"
                                                                                    Style="{StaticResource ColumnSeparatorStyle}"/>
                                                                            <TextBlock Grid.Column="10" Text="PREV"
                                                                                       Style="{StaticResource GridHeaderCell}"
                                                                                       HorizontalAlignment="Right"
                                                                                       Margin="6,8,10,8"/>
                                                                            <Border Grid.Column="11"
                                                                                    Style="{StaticResource ColumnSeparatorStyle}"/>
                                                                            <TextBlock Grid.Column="12"
                                                                                       Style="{StaticResource ThisDnHeaderStyle}"/>
                                                                            <Border Grid.Column="13"
                                                                                    Style="{StaticResource ColumnSeparatorStyle}"/>
                                                                            <TextBlock Grid.Column="14" Text="BALANCE"
                                                                                       Style="{StaticResource GridHeaderCell}"
                                                                                       HorizontalAlignment="Right"
                                                                                       Margin="6,8,10,8"/>
                                                                        </Grid>
                                                                    </Border>

                                                                    <ItemsPresenter/>

                                                                    <Border Background="{DynamicResource TintIndigoBrush}"
                                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                                            BorderThickness="0,1,0,0"
                                                                            Padding="16,10"
                                                                            CornerRadius="0,0,12,12">
                                                                        <StackPanel Orientation="Horizontal"
                                                                                    HorizontalAlignment="Right">
                                                                            <TextBlock Text="SPEC TOTAL: "
                                                                                       FontSize="11" FontWeight="Bold"
                                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                                       VerticalAlignment="Center"/>
                                                                            <TextBlock FontSize="11"
                                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                                       VerticalAlignment="Center"
                                                                                       Margin="8,0,0,0">
                                                                                <Run Text="{Binding ItemCount, Mode=OneWay}"
                                                                                     FontWeight="SemiBold"/>
                                                                                <Run Text=" items"/>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasBalance}"
                                                                     Value="True">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource TintAmberBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*" MinWidth="200"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="55"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="95"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding SerialNumber}"
                                                           Style="{StaticResource GridDataCell}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding GlassRef}"
                                                           Style="{StaticResource GridDataCell}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding GlassRef}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding W1}"
                                                           Style="{StaticResource GridNumericCell}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding H1}"
                                                           Style="{StaticResource GridNumericCell}"/>
                                                <TextBlock Grid.Column="4">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock"
                                                               BasedOn="{StaticResource OptionalDimStyle}">
                                                            <Setter Property="Text" Value="{Binding W2}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding W2}" Value="0">
                                                                    <Setter Property="Text" Value="—"/>
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource MutedForegroundBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="5">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock"
                                                               BasedOn="{StaticResource OptionalDimStyle}">
                                                            <Setter Property="Text" Value="{Binding H2}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding H2}" Value="0">
                                                                    <Setter Property="Text" Value="—"/>
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource MutedForegroundBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="6"
                                                           Text="{Binding OrderedQty}"
                                                           Style="{StaticResource GridNumericCell}"/>
                                                <TextBlock Grid.Column="7"
                                                           Text="{Binding Sqm, StringFormat={}{0:0.000}}"
                                                           Style="{StaticResource GridNumericCell}"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                <TextBlock Grid.Column="8"
                                                           Text="{Binding TotalSqm, StringFormat={}{0:0.000}}"
                                                           Style="{StaticResource GridNumericCell}"
                                                           FontWeight="Bold"/>
                                                <Border Grid.Column="9"
                                                        Style="{StaticResource ColumnSeparatorStyle}"/>
                                                <TextBlock Grid.Column="10"
                                                           Text="{Binding PreviouslyDeliveredQty}"
                                                           Style="{StaticResource GridNumericCell}"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                <Border Grid.Column="11"
                                                        Style="{StaticResource ColumnSeparatorStyle}"/>

                                                <!-- TextBox on real DN -->
                                                <TextBox Grid.Column="12"
                                                         Text="{Binding DeliveredQty,
                                                                UpdateSourceTrigger=PropertyChanged}"
                                                         behaviors:TextBoxBehaviors.AcceptIntegersOnly="True"
                                                         Style="{StaticResource DeliveredQtyTextBoxStyle}"/>

                                                <!-- TextBlock on Master DN -->
                                                <TextBlock Grid.Column="12"
                                                           Text="{Binding DeliveredQty}"
                                                           Style="{StaticResource DeliveredQtyReadOnlyStyle}"/>

                                                <Border Grid.Column="13"
                                                        Style="{StaticResource ColumnSeparatorStyle}"/>
                                                <TextBlock Grid.Column="14"
                                                           Text="{Binding BalanceQty}"
                                                           Style="{StaticResource BalanceCellStyle}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
    </Grid>
</UserControl>
