<UserControl x:Class="ProGlassAutomation.Views.DeliveryNote.DeliveryNoteDetail.Sections.DnOverviewSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:features="clr-namespace:ProGlassAutomation.Services.Features"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DnSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="180"/>
        </Grid.RowDefinitions>

        <!-- One-row KPI strip — was a 2×2 card that ate the laptop viewport -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfacePrimaryBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="{DynamicResource CardBorderThickness}"
                CornerRadius="{DynamicResource CardCornerRadius}"
                Padding="8,6"
                Margin="0,0,0,8"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CompactStatTileStyle}"
                        ToolTip="{DynamicResource DeliveryNote.KpiOrderedTip}">
                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalOrderedQty}"
                                       Style="{StaticResource CompactStatNumberStyle}"/>
                            <TextBlock Text=" pcs" Style="{StaticResource CompactStatUnitStyle}"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Common.Ordered}" Style="{StaticResource CompactStatLabelStyle}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource CompactStatTileStyle}"
                        Background="{DynamicResource TintIndigoBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        ToolTip="{DynamicResource DeliveryNote.KpiPrevTip}">
                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalPreviouslyDeliveredQty}"
                                       Style="{StaticResource CompactStatNumberStyle}"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text=" pcs" Style="{StaticResource CompactStatUnitStyle}"
                                       Foreground="{DynamicResource AccentBrush}" Opacity="0.75"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource PrevDeliveredLabelStyle}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4"
                        Style="{StaticResource CompactStatTileStyle}"
                        Background="{DynamicResource TintGreenBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        ToolTip="{DynamicResource DeliveryNote.KpiThisDnTip}">
                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalDeliveredQty}"
                                       Style="{StaticResource CompactStatNumberStyle}"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                            <TextBlock Text=" pcs" Style="{StaticResource CompactStatUnitStyle}"
                                       Foreground="{DynamicResource SuccessBrush}" Opacity="0.75"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource ThisDnLabelStyle}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="6"
                        Style="{StaticResource CompactStatTileStyle}"
                        Background="{DynamicResource TintAmberBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        ToolTip="{DynamicResource DeliveryNote.KpiBalanceTip}">
                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalBalanceQty}"
                                       Style="{StaticResource CompactStatNumberStyle}"
                                       Foreground="{DynamicResource WarningBrush}"/>
                            <TextBlock Text=" pcs" Style="{StaticResource CompactStatUnitStyle}"
                                       Foreground="{DynamicResource WarningBrush}" Opacity="0.75"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Common.Balance}"
                                   Style="{StaticResource CompactStatLabelStyle}"
                                   Foreground="{DynamicResource WarningBrush}"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="8" VerticalAlignment="Center">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource DeliveryNote.Progress}"
                                   FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="{Binding DeliveryProgressPercent,
                                        Mode=OneWay,
                                        StringFormat={}{0:0.#}}"/>
                            <Run Text="%"/>
                        </TextBlock>
                    </Grid>
                    <Border x:Name="StatsProgressTrack"
                            CornerRadius="{DynamicResource Radius.XSmall}" Height="6"
                            Background="{DynamicResource BorderBrush}">
                        <Border CornerRadius="{DynamicResource Radius.XSmall}"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource AccentBrush}">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                    <Binding Path="DeliveryProgressPercent"/>
                                    <Binding Path="ActualWidth"
                                             ElementName="StatsProgressTrack"/>
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="DetailColumn" Width="Auto"/>
            </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                    Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="180"/>
                    </Grid.RowDefinitions>

                    <!-- Hero strip -->
                    <Border Grid.Row="0" Style="{StaticResource MasterHeroStripStyle}"
                        Background="{DynamicResource AccentBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource HeroStripLabelStyle}"/>
                                    <TextBlock Text="{Binding CustomerName}"
                                               Style="{StaticResource MasterHeroTitleStyle}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ProjectName}"
                                           Style="{StaticResource MasterHeroSubtitleStyle}"
                                           MaxWidth="500" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding ProjectReference}"
                                           FontSize="{StaticResource TextBody}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}" Opacity="0.80"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="500" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ProjectReference}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{DynamicResource DeliveryNote.JO}"
                                               Style="{StaticResource MasterHeroMetaLabelStyle}"/>
                                    <TextBlock Text="{Binding JobOrderId}"
                                               Style="{StaticResource MasterHeroMetaValueStyle}"/>
                                    <TextBlock Style="{StaticResource MasterHeroDividerStyle}"/>
                                    <TextBlock Text="{DynamicResource DeliveryNote.PI}"
                                               Style="{StaticResource MasterHeroMetaLabelStyle}"/>
                                    <TextBlock Text="{Binding ProformaId}"
                                               Style="{StaticResource MasterHeroMetaValueStyle}"/>
                                    <TextBlock Style="{StaticResource MasterHeroDividerStyle}"/>
                                    <TextBlock Text="{DynamicResource DeliveryNote.SEQ}"
                                               Style="{StaticResource MasterHeroMetaLabelStyle}"/>
                                    <TextBlock Text="{Binding SequenceNumber}"
                                               Style="{StaticResource MasterHeroMetaValueStyle}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding DeliveryDateDisplay}"
                                           FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding DeliveryTime}"
                                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}" Opacity="0.92"
                                           HorizontalAlignment="Right"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Expander Grid.Row="1"
                              IsExpanded="True"
                              Margin="10,4,10,2"
                              Background="Transparent">
                        <Expander.Style>
                            <Style TargetType="Expander">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMasterDn}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Expander.Style>
                        <Expander.Header>
                            <TextBlock Text="{DynamicResource DeliveryNote.DeliveryDetailsStatusDriverVehicleReceiver}"
                                       FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </Expander.Header>
                    <Border Padding="4,8,4,4">
                        <!-- Auto-compact WrapPanel: a field turned OFF in
                             Settings ► Features ► Delivery Note COLLAPSES
                             and the remaining fields re-flow to fill the row,
                             so there is no blank spacer. Status always shows. -->
                        <WrapPanel>
                            <StackPanel MinWidth="180" MaxWidth="260"
                                        Margin="0,0,12,12">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{DynamicResource Common.Status}"/>
                                <ComboBox ItemsSource="{Binding StatusOptions}"
                                          SelectedItem="{Binding Status}"/>
                            </StackPanel>

                            <StackPanel MinWidth="180" MaxWidth="260"
                                        Margin="0,0,12,12"
                                        Visibility="{Binding Path=ShowDriverName,
                                            Source={x:Static features:DeliveryNoteFieldVisibility.Instance},
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{DynamicResource DeliveryNote.DriverNAME}"/>
                                <TextBox Text="{Binding DriverName,
                                                UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel MinWidth="180" MaxWidth="260"
                                        Margin="0,0,12,12"
                                        Visibility="{Binding Path=ShowVehicleNumber,
                                            Source={x:Static features:DeliveryNoteFieldVisibility.Instance},
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{DynamicResource DeliveryNote.VehicleNumber}"/>
                                <TextBox Text="{Binding VehicleNumber,
                                                UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel MinWidth="150" MaxWidth="220"
                                        Margin="0,0,12,12"
                                        VerticalAlignment="Bottom"
                                        Visibility="{Binding Path=ShowIsFoc,
                                            Source={x:Static features:DeliveryNoteFieldVisibility.Instance},
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{DynamicResource DeliveryNote.FOC}"/>
                                <CheckBox IsChecked="{Binding IsFoc}"
                                          Content="{DynamicResource DeliveryNote.Free}"/>
                            </StackPanel>

                            <StackPanel MinWidth="180" MaxWidth="300"
                                        Margin="0,0,12,12"
                                        Visibility="{Binding Path=ShowReceiverName,
                                            Source={x:Static features:DeliveryNoteFieldVisibility.Instance},
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{DynamicResource DeliveryNote.ReceiverNAME}"/>
                                <TextBox Text="{Binding ReceiverName,
                                                UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel MinWidth="180" MaxWidth="300"
                                        Margin="0,0,12,12"
                                        Visibility="{Binding Path=ShowNotes,
                                            Source={x:Static features:DeliveryNoteFieldVisibility.Instance},
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{DynamicResource Common.Notes}"/>
                                <TextBox Text="{Binding Notes,
                                                UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                    </Expander>

                    <Grid Grid.Row="2" Margin="10,6,10,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                            <Grid Margin="4,0,4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource ItemsSectionTitleStyle}"/>
                                    <TextBlock Style="{StaticResource ItemsSectionSubtitleStyle}"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Style="{StaticResource RowPrimaryButton}"
                                        Tag="&#xE73E;" Content="{DynamicResource DeliveryNote.FILLBalance}"
                                        Command="{Binding FillRemainingCommand}"
                                        ToolTip="{DynamicResource DeliveryNote.FillBalanceQuantitiesDeliveredColumn}"/>

                                <Button Grid.Column="3"
                                        Style="{StaticResource RowOutlinedButton}"
                                        Tag="&#xE72C;" Content="{DynamicResource DeliveryNote.ResetQTY}"
                                        Command="{Binding ResetQtyCommand}"
                                        ToolTip="{DynamicResource DeliveryNote.ResetDeliveredQuantitiesBack0}"/>
                            </Grid>

                            <Border Margin="4,8,4,8" Padding="16,20"
                                    Visibility="{Binding HasNoPendingBalanceItems,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="{StaticResource TextDisplayLarge}" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               Opacity="0.7"/>
                                    <TextBlock Text="{DynamicResource DeliveryNote.ItemsFullyDelivered}"
                                               FontSize="{StaticResource TextBodyLarge}" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,8,0,4"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{DynamicResource DeliveryNote.NoRemainingBalanceDeliver}"
                                               FontSize="{StaticResource TextBody}" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Master: some fully-delivered lines are hidden. Explain + let user reveal them. -->
                            <Border Margin="4,4,4,6" Padding="12,8"
                                    Background="{DynamicResource TintIndigoBrush}"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    BorderThickness="{DynamicResource CardBorderThickness}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Visibility="{Binding HasFullyDeliveredLines,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE7BA;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="{StaticResource TextBodyLarge}"
                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding MasterScopeBannerText}"
                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                               FontSize="{StaticResource TextBody}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource RowOutlinedButton}"
                                            Tag="&#xE7B3;"
                                            Content="{Binding MasterScopeButtonText}"
                                            Command="{Binding ToggleFullMasterCommand}"
                                            VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </Border>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="False"
                                          PanningMode="VerticalOnly"
                                          Focusable="True"
                                          FocusVisualStyle="{x:Null}"
                                          behaviors:SmoothScrollBehavior.IsEnabled="True">
                            <ItemsControl ItemsSource="{Binding VisibleGroups}"
                                          HorizontalAlignment="Stretch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SpecGroupCardStyle}">
                                            <StackPanel>
                                                <Border Style="{StaticResource SpecGroupHeaderStyle}">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                                            <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="4" CornerRadius="{DynamicResource Radius.XSmall}"
                                                                Background="{DynamicResource SurfacePrimaryBrush}"
                                                                Margin="0,0,10,0"/>
                                                        <TextBlock Text="{DynamicResource DeliveryNote.SPEC}"
                                                                   FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                                                   Foreground="{DynamicResource OnAccentForegroundBrush}" Opacity="0.80"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding SpecGroupName}"
                                                                   FontSize="{StaticResource TextSection}" FontWeight="Bold"
                                                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Style="{StaticResource LineItemsHeaderStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="30"/>
                                                            <ColumnDefinition Width="1.5*"/>
                                                            <ColumnDefinition Width="0.6*"/>
                                                            <ColumnDefinition Width="0.6*"/>
                                                            <ColumnDefinition Width="0.6*"/>
                                                            <ColumnDefinition Width="0.6*"/>
                                                            <ColumnDefinition Width="0.5*"/>
                                                            <ColumnDefinition Width="0.6*"/>
                                                            <ColumnDefinition Width="0.7*"/>
                                                            <ColumnDefinition Width="0.8*"/>
                                                            <ColumnDefinition Width="0.7*"/>
                                                            <ColumnDefinition Width="0.8*"/>
                                                            <ColumnDefinition Width="0.8*"/>
                                                            <ColumnDefinition Width="0.6*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="#"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{DynamicResource DeliveryNote.GlassRef}"
                                                                   Style="{StaticResource GridHeaderCell}"/>
                                                        <TextBlock Grid.Column="2" Text="W1"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <TextBlock Grid.Column="3" Text="H1"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <TextBlock Grid.Column="4" Text="W2"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <TextBlock Grid.Column="5" Text="H2"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <TextBlock Grid.Column="6" Text="QTY"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <TextBlock Grid.Column="7" Text="{DynamicResource DeliveryNote.PREV}"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"
                                                                   ToolTip="{DynamicResource DeliveryNote.PreviouslyDeliveredOtherDns}"/>
                                                        <TextBlock Grid.Column="8" Text="SQM"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <TextBlock Grid.Column="9" Text="{DynamicResource DeliveryNote.TotalSQM}"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <TextBlock Grid.Column="10" Text="{DynamicResource DeliveryNote.WTPC}"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"
                                                                   ToolTip="{DynamicResource DeliveryNote.WeightPieceKg}"/>
                                                        <TextBlock Grid.Column="11" Text="{DynamicResource DeliveryNote.TotalWT}"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"
                                                                   ToolTip="{DynamicResource DeliveryNote.TotalWeightKg}"/>
                                                        <TextBlock Grid.Column="12" Text="{DynamicResource Common.Delivered}"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="6,8,10,8"/>
                                                        <TextBlock Grid.Column="13" Text="{DynamicResource Common.Balance}"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                    </Grid>
                                                </Border>

                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="{DynamicResource CardCornerRadius}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                                    BorderThickness="{DynamicResource Border.BottomHairlineThickness}"
                                                                    Padding="0,2"
                                                                    Cursor="Hand"
                                                                    behaviors:ClickToCommandBehavior.Command="{Binding DataContext.ToggleItemSelectionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                    behaviors:ClickToCommandBehavior.CommandParameter="{Binding}"
                                                                    behaviors:ClickToCommandBehavior.ExcludeAncestorTypes="TextBox">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}"
                                                                                         Value="True">
                                                                                <Setter Property="Background"
                                                                                        Value="{DynamicResource TintBlueBrush}"/>
                                                                                <Setter Property="BorderBrush"
                                                                                        Value="{DynamicResource AccentBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding HasBalance}"
                                                                                         Value="True">
                                                                                <Setter Property="Background"
                                                                                        Value="{DynamicResource TintAmberBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsFullyDeliveredLine}"
                                                                                         Value="True">
                                                                                <Setter Property="Background"
                                                                                        Value="{DynamicResource TintGreenBrush}"/>
                                                                                <Setter Property="Opacity" Value="0.72"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="30"/>
                                                                        <ColumnDefinition Width="1.5*"/>
                                                                        <ColumnDefinition Width="0.6*"/>
                                                                        <ColumnDefinition Width="0.6*"/>
                                                                        <ColumnDefinition Width="0.6*"/>
                                                                        <ColumnDefinition Width="0.6*"/>
                                                                        <ColumnDefinition Width="0.5*"/>
                                                                        <ColumnDefinition Width="0.6*"/>
                                                                        <ColumnDefinition Width="0.7*"/>
                                                                        <ColumnDefinition Width="0.8*"/>
                                                                        <ColumnDefinition Width="0.7*"/>
                                                                        <ColumnDefinition Width="0.8*"/>
                                                                        <ColumnDefinition Width="0.8*"/>
                                                                        <ColumnDefinition Width="0.6*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding SerialNumber}"
                                                                               Style="{StaticResource GridDataCell}"
                                                                               HorizontalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding GlassRef}"
                                                                               Style="{StaticResource GridDataCell}"
                                                                               FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding GlassRef}"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding W1}"
                                                                               Style="{StaticResource GridNumericCell}"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding H1}"
                                                                               Style="{StaticResource GridNumericCell}"/>
                                                                    <TextBlock Grid.Column="4">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock"
                                                                                   BasedOn="{StaticResource OptionalDimStyle}">
                                                                                <Setter Property="Text" Value="{Binding W2}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding W2}" Value="0">
                                                                                        <Setter Property="Text" Value="—"/>
                                                                                        <Setter Property="Foreground"
                                                                                                Value="{DynamicResource TextTertiaryBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Grid.Column="5">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock"
                                                                                   BasedOn="{StaticResource OptionalDimStyle}">
                                                                                <Setter Property="Text" Value="{Binding H2}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding H2}" Value="0">
                                                                                        <Setter Property="Text" Value="—"/>
                                                                                        <Setter Property="Foreground"
                                                                                                Value="{DynamicResource TextTertiaryBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Grid.Column="6"
                                                                               Text="{Binding OrderedQty}"
                                                                               Style="{StaticResource GridNumericCell}"/>
                                                                    <TextBlock Grid.Column="7"
                                                                               Text="{Binding PreviouslyDeliveredQty}"
                                                                               Style="{StaticResource GridNumericCell}"
                                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                               Opacity="0.7"
                                                                               ToolTip="{DynamicResource DeliveryNote.PreviouslyDeliveredOtherDns}"/>
                                                                    <TextBlock Grid.Column="8"
                                                                               Text="{Binding Sqm, StringFormat={}{0:0.000}}"
                                                                               Style="{StaticResource GridNumericCell}"
                                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                                    <TextBlock Grid.Column="9"
                                                                               Text="{Binding TotalSqm, StringFormat={}{0:0.000}}"
                                                                               Style="{StaticResource GridNumericCell}"
                                                                               FontWeight="Bold"/>
                                                                    <TextBlock Grid.Column="10"
                                                                               Text="{Binding WeightPerPiece, StringFormat={}{0:0.0}}"
                                                                               Style="{StaticResource GridNumericCell}"
                                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                               ToolTip="{DynamicResource DeliveryNote.WeightPieceKg}"/>
                                                                    <TextBlock Grid.Column="11"
                                                                               Text="{Binding TotalWeight, StringFormat={}{0:0.0}}"
                                                                               Style="{StaticResource GridNumericCell}"
                                                                               FontWeight="Bold"
                                                                               ToolTip="{DynamicResource DeliveryNote.TotalWeightWeightPieceDeliveredQty}"/>
                                                                    <TextBox Grid.Column="12"
                                                                             Text="{Binding DeliveredQty,
                                                                                    UpdateSourceTrigger=PropertyChanged}"
                                                                             behaviors:TextBoxBehaviors.AcceptIntegersOnly="True"
                                                                             Style="{StaticResource DeliveredQtyTextBoxStyle}"
                                                                             ToolTip="{Binding ProductionHint}"/>
                                                                    <TextBlock Grid.Column="12"
                                                                               Text="{Binding DeliveredQty}"
                                                                               Style="{StaticResource DeliveredQtyReadOnlyStyle}"/>
                                                                    <TextBlock Grid.Column="13"
                                                                               Text="{Binding BalanceQty}"
                                                                               Style="{StaticResource BalanceCellStyle}"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Border Background="{DynamicResource TintIndigoBrush}"
                                                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                        BorderThickness="{DynamicResource Border.TopHairlineThickness}"
                                                        Padding="16,10"
                                                        CornerRadius="{DynamicResource Radius.Bottom.Medium}">
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Right">
                                                        <TextBlock Text="{DynamicResource DeliveryNote.SPECTotal}"
                                                                   FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock FontSize="{StaticResource TextBody}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="8,0,0,0">
                                                            <Run Text="{Binding ItemCount, Mode=OneWay}"
                                                                 FontWeight="SemiBold"/>
                                                            <Run Text="{DynamicResource DeliveryNote.Items}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- ══ RIGHT SLIDE-IN ROW STATS PANEL (Sheet Store pattern) ══
                 Collapsed by default so the items grid is full-width. Slides
                 in when a row is clicked; shows THAT row's stats. When no
                 row is selected the top KPI strip keeps showing totals. -->
            <Grid x:Name="DetailPanel" Grid.Column="1" Margin="10,0,0,0"
                  Visibility="Collapsed">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="PanelSlide" X="0"/>
                </Grid.RenderTransform>

                <Border Width="360"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource SurfacePrimaryBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="20"
                        SnapsToDevicePixels="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Panel header + close -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40"
                                        CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                                        Grid.Column="0"
                                        Background="{DynamicResource AccentBrush}">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="{StaticResource TextTitle}" Foreground="{DynamicResource OnAccentForegroundBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0">
                                    <TextBlock Text="{DynamicResource DeliveryNote.ROWDetails}"
                                               FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding SelectionLabel}"
                                               FontSize="{StaticResource TextBodyLarge}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Style="{StaticResource RowOutlinedButton}"
                                        Tag="&#xE711;" Content=""
                                        VerticalAlignment="Top"
                                        ToolTip="{DynamicResource DeliveryNote.CloseClickRowAgain}"
                                        Command="{Binding ClearSelectionCommand}"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource BorderDefaultBrush}" Margin="0,16,0,16"/>

                            <!-- Selected row identity -->
                            <TextBlock Text="{DynamicResource Common.Specification}"
                                       FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="4,0,0,8"/>
                            <Border CornerRadius="{DynamicResource CardCornerRadius}" Padding="12,10"
                                    Margin="0,0,0,12"
                                    Background="{DynamicResource TintBlueBrush}"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    BorderThickness="{DynamicResource Border.HairlineThickness}">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedItemRow.SpecGroupName}"
                                               FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock FontSize="{StaticResource TextBody}"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Margin="0,4,0,0">
                                        <Run Text="{DynamicResource DeliveryNote.GlassRef}"/><Run Text="{Binding SelectedItemRow.GlassRef, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <TextBlock FontSize="{StaticResource TextBody}"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Margin="0,2,0,0">
                                        <Run Text="{DynamicResource DeliveryNote.Dimensions}"/><Run Text="{Binding SelectedItemRow.DimensionDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <TextBlock FontSize="{StaticResource TextBody}"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Margin="0,2,0,0">
                                        <Run Text="{DynamicResource DeliveryNote.SQM}"/><Run Text="{Binding SelectedItemRow.Sqm, Mode=OneWay, StringFormat={}{0:0.000}}" FontWeight="SemiBold"/>
                                        <Run Text="{DynamicResource DeliveryNote.TSQM}"/><Run Text="{Binding SelectedItemRow.TotalSqm, Mode=OneWay, StringFormat={}{0:0.000}}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <TextBlock FontSize="{StaticResource TextBody}"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Margin="0,2,0,0">
                                        <Run Text="{DynamicResource DeliveryNote.WeightPc}"/><Run Text="{Binding SelectedItemRow.WeightPerPiece, Mode=OneWay, StringFormat={}{0:0.0} kg}" FontWeight="SemiBold"/>
                                        <Run Text="{DynamicResource DeliveryNote.Total}"/><Run Text="{Binding SelectedItemRow.TotalWeight, Mode=OneWay, StringFormat={}{0:0.0} kg}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Selected row quantities -->
                            <TextBlock Text="{DynamicResource DeliveryNote.Quantities}"
                                       FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="4,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Column="0" Grid.Row="0" CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="12,10"
                                        Margin="0,0,4,10"
                                        Background="{DynamicResource TintBlueBrush}"
                                        BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Common.Ordered}" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="{Binding SelectedItemRow.OrderedQty}" FontSize="{StaticResource TextTitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Grid.Row="0" CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="12,10"
                                        Margin="4,0,0,10"
                                        Background="{DynamicResource TintIndigoBrush}"
                                        BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource DeliveryNote.PREVDelivered}" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="{Binding SelectedItemRow.PreviouslyDeliveredQty}" FontSize="{StaticResource TextTitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="0" Grid.Row="1" CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="12,10"
                                        Margin="0,0,4,10"
                                        Background="{DynamicResource TintGreenBrush}"
                                        BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource DeliveryNote.DN}" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                        <TextBlock Text="{Binding SelectedItemRow.DeliveredQty}" FontSize="{StaticResource TextTitle}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Grid.Row="1" CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="12,10"
                                        Margin="4,0,0,10"
                                        Background="{DynamicResource TintAmberBrush}"
                                        BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Common.Balance}" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                        <TextBlock Text="{Binding SelectedItemRow.BalanceQty}" FontSize="{StaticResource TextTitle}" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
