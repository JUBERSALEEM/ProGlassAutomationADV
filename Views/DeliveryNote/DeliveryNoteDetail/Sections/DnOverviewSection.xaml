<UserControl x:Class="ProGlassAutomation.Views.DeliveryNote.DeliveryNoteDetail.Sections.DnOverviewSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DnSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="180"/>
        </Grid.RowDefinitions>

        <!-- One-row KPI strip — was a 2×2 card that ate the laptop viewport -->
        <Border Grid.Row="0"
                Background="{DynamicResource ModuleBackgroundBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="{DynamicResource CardBorderThickness}"
                CornerRadius="{DynamicResource CardCornerRadius}"
                Padding="8,6"
                Margin="0,0,0,8"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CompactStatTileStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalOrderedQty}"
                                       Style="{StaticResource CompactStatNumberStyle}"/>
                            <TextBlock Text=" pcs" Style="{StaticResource CompactStatUnitStyle}"/>
                        </StackPanel>
                        <TextBlock Text="ORDERED" Style="{StaticResource CompactStatLabelStyle}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource CompactStatTileStyle}"
                        Background="{DynamicResource TintIndigoBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}">
                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalPreviouslyDeliveredQty}"
                                       Style="{StaticResource CompactStatNumberStyle}"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text=" pcs" Style="{StaticResource CompactStatUnitStyle}"
                                       Foreground="{DynamicResource AccentBrush}" Opacity="0.75"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource PrevDeliveredLabelStyle}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4"
                        Style="{StaticResource CompactStatTileStyle}"
                        Background="{DynamicResource TintGreenBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}">
                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalDeliveredQty}"
                                       Style="{StaticResource CompactStatNumberStyle}"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                            <TextBlock Text=" pcs" Style="{StaticResource CompactStatUnitStyle}"
                                       Foreground="{DynamicResource SuccessBrush}" Opacity="0.75"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource ThisDnLabelStyle}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="6"
                        Style="{StaticResource CompactStatTileStyle}"
                        Background="{DynamicResource TintAmberBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}">
                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalBalanceQty}"
                                       Style="{StaticResource CompactStatNumberStyle}"
                                       Foreground="{DynamicResource WarningBrush}"/>
                            <TextBlock Text=" pcs" Style="{StaticResource CompactStatUnitStyle}"
                                       Foreground="{DynamicResource WarningBrush}" Opacity="0.75"/>
                        </StackPanel>
                        <TextBlock Text="BALANCE"
                                   Style="{StaticResource CompactStatLabelStyle}"
                                   Foreground="{DynamicResource WarningBrush}"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="8" VerticalAlignment="Center">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="PROGRESS"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}">
                            <Run Text="{Binding DeliveryProgressPercent,
                                        Mode=OneWay,
                                        StringFormat={}{0:0.#}}"/>
                            <Run Text="%"/>
                        </TextBlock>
                    </Grid>
                    <Border x:Name="StatsProgressTrack"
                            CornerRadius="4" Height="6"
                            Background="{DynamicResource BorderBrush}">
                        <Border CornerRadius="4"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource AccentBrush}">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                    <Binding Path="DeliveryProgressPercent"/>
                                    <Binding Path="ActualWidth"
                                             ElementName="StatsProgressTrack"/>
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="DetailColumn" Width="Auto"/>
            </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="180"/>
                    </Grid.RowDefinitions>

                    <!-- Hero strip -->
                    <Border Grid.Row="0" Style="{StaticResource MasterHeroStripStyle}"
                        Background="{DynamicResource AccentBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource HeroStripLabelStyle}"/>
                                    <TextBlock Text="{Binding CustomerName}"
                                               Style="{StaticResource MasterHeroTitleStyle}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ProjectName}"
                                           Style="{StaticResource MasterHeroSubtitleStyle}"
                                           MaxWidth="500" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding ProjectReference}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}" Opacity="0.80"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="500" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ProjectReference}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="JO:"
                                               Style="{StaticResource MasterHeroMetaLabelStyle}"/>
                                    <TextBlock Text="{Binding JobOrderId}"
                                               Style="{StaticResource MasterHeroMetaValueStyle}"/>
                                    <TextBlock Style="{StaticResource MasterHeroDividerStyle}"/>
                                    <TextBlock Text="PI:"
                                               Style="{StaticResource MasterHeroMetaLabelStyle}"/>
                                    <TextBlock Text="{Binding ProformaId}"
                                               Style="{StaticResource MasterHeroMetaValueStyle}"/>
                                    <TextBlock Style="{StaticResource MasterHeroDividerStyle}"/>
                                    <TextBlock Text="SEQ:"
                                               Style="{StaticResource MasterHeroMetaLabelStyle}"/>
                                    <TextBlock Text="{Binding SequenceNumber}"
                                               Style="{StaticResource MasterHeroMetaValueStyle}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding DeliveryDateDisplay}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding DeliveryTime}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}" Opacity="0.92"
                                           HorizontalAlignment="Right"
                                           Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding CompanyName}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}" Opacity="0.80"
                                           HorizontalAlignment="Right"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="240"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Expander Grid.Row="1"
                              IsExpanded="False"
                              Margin="10,4,10,2"
                              Background="Transparent">
                        <Expander.Style>
                            <Style TargetType="Expander">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMasterDn}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Expander.Style>
                        <Expander.Header>
                            <TextBlock Text="DELIVERY DETAILS — status, driver, vehicle, receiver"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </Expander.Header>
                    <Border Padding="4,8,4,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="STATUS"/>
                                <ComboBox ItemsSource="{Binding StatusOptions}"
                                          SelectedItem="{Binding Status}"
                                          FontSize="12"
                                          Height="{DynamicResource DensityInputHeight}"
                                          VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="DRIVER NAME"/>
                                <TextBox Text="{Binding DriverName,
                                                UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12" Padding="10,6"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="4">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="VEHICLE NUMBER"/>
                                <TextBox Text="{Binding VehicleNumber,
                                                UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12" Padding="10,6"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="6"
                                        VerticalAlignment="Bottom">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="FOC"/>
                                <CheckBox IsChecked="{Binding IsFoc}"
                                          Content="Free" FontSize="12"
                                          Foreground="{DynamicResource PrimaryForegroundBrush}"
                                          VerticalAlignment="Center"
                                          Height="{DynamicResource DensityInputHeight}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0"
                                        Grid.ColumnSpan="3">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="RECEIVER NAME"/>
                                <TextBox Text="{Binding ReceiverName,
                                                UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12" Padding="10,6"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="4"
                                        Grid.ColumnSpan="3">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="NOTES"/>
                                <TextBox Text="{Binding Notes,
                                                UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12" Padding="8,4"
                                         Height="{DynamicResource DensityInputHeight}"
                                         TextWrapping="NoWrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    </Expander>

                    <Grid Grid.Row="2" Margin="10,6,10,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                            <Grid Margin="4,0,4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource ItemsSectionTitleStyle}"/>
                                    <TextBlock Style="{StaticResource ItemsSectionSubtitleStyle}"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Style="{StaticResource MasterScopeButtonStyle}"
                                        Tag="&#xE8A5;"
                                        Content="{Binding MasterScopeButtonText}"
                                        Command="{Binding ToggleFullMasterCommand}"
                                        ToolTip="Remaining balance only, or the original Job Order Master."/>

                                <!-- SELECT ALL REMAINING -->
                                <Button Grid.Column="3"
                                        Style="{StaticResource RowPrimaryButton}"
                                        Tag="&#xE73E;" Content="SELECT ALL REMAINING"
                                        Command="{Binding FillRemainingCommand}"
                                        ToolTip="Fill ALL balance quantities into Delivered column."/>

                                <!-- RESET QTY — NEW CHAT 19 -->
                                <Button Grid.Column="5"
                                        Style="{StaticResource RowOutlinedButton}"
                                        Tag="&#xE72C;" Content="RESET QTY"
                                        Command="{Binding ResetQtyCommand}"
                                        ToolTip="Reset all Delivered quantities back to 0."/>
                            </Grid>

                            <Border Margin="4,0,4,8" Padding="10,6"
                                    Background="{DynamicResource TintIndigoBrush}"
                                    BorderBrush="{DynamicResource OutlineBrush}"
                                    BorderThickness="{DynamicResource CardBorderThickness}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Visibility="{Binding HasHiddenFullyDeliveredRows,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding HiddenFullyDeliveredSummary}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <Border Margin="4,8,4,8" Padding="16,20"
                                    Visibility="{Binding HasNoPendingBalanceItems,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="28" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               Opacity="0.7"/>
                                    <TextBlock Text="All items fully delivered"
                                               FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,8,0,4"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Text="No remaining balance on this Master DN."
                                               FontSize="11" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                </StackPanel>
                            </Border>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          CanContentScroll="False"
                                          PanningMode="Both"
                                          Focusable="True"
                                          FocusVisualStyle="{x:Null}"
                                          behaviors:SmoothScrollBehavior.IsEnabled="True">
                            <ItemsControl ItemsSource="{Binding VisibleGroups}"
                                          MinWidth="980">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SpecGroupCardStyle}">
                                            <StackPanel>
                                                <Border Style="{StaticResource SpecGroupHeaderStyle}">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                                            <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="4" CornerRadius="2"
                                                                Background="White"
                                                                Margin="0,0,10,0"/>
                                                        <TextBlock Text="SPEC:  "
                                                                   FontSize="12" FontWeight="Bold"
                                                                   Foreground="{DynamicResource OnAccentForegroundBrush}" Opacity="0.80"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding SpecGroupName}"
                                                                   FontSize="14" FontWeight="Bold"
                                                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Style="{StaticResource LineItemsHeaderStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40"/>
                                                            <ColumnDefinition Width="*" MinWidth="200"/>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="55"/>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="65"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="95"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="70"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="#"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="GLASS REF"
                                                                   Style="{StaticResource GridHeaderCell}"/>
                                                        <TextBlock Grid.Column="2" Text="W1"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <TextBlock Grid.Column="3" Text="H1"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <TextBlock Grid.Column="4" Text="W2"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <TextBlock Grid.Column="5" Text="H2"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <TextBlock Grid.Column="6" Text="QTY"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <TextBlock Grid.Column="7" Text="SQM"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <TextBlock Grid.Column="8" Text="TOTAL SQM"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <Border Grid.Column="9"
                                                                Style="{StaticResource ColumnSeparatorStyle}"/>
                                                        <TextBlock Grid.Column="10" Text="PREV"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                        <Border Grid.Column="11"
                                                                Style="{StaticResource ColumnSeparatorStyle}"/>
                                                        <TextBlock Grid.Column="12"
                                                                   Style="{StaticResource ThisDnHeaderStyle}"/>
                                                        <Border Grid.Column="13"
                                                                Style="{StaticResource ColumnSeparatorStyle}"/>
                                                        <TextBlock Grid.Column="14" Text="BALANCE"
                                                                   Style="{StaticResource GridHeaderCell}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="6,8,10,8"/>
                                                    </Grid>
                                                </Border>

                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="{DynamicResource CardCornerRadius}" BorderBrush="{DynamicResource OutlineBrush}"
                                                                    BorderThickness="0,0,0,1"
                                                                    Padding="0,2"
                                                                    Cursor="Hand"
                                                                    MouseLeftButtonDown="Row_Click"
                                                                    Tag="{Binding}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}"
                                                                                         Value="True">
                                                                                <Setter Property="Background"
                                                                                        Value="{DynamicResource TintBlueBrush}"/>
                                                                                <Setter Property="BorderBrush"
                                                                                        Value="{DynamicResource AccentBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding HasBalance}"
                                                                                         Value="True">
                                                                                <Setter Property="Background"
                                                                                        Value="{DynamicResource TintAmberBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsFullyDeliveredLine}"
                                                                                         Value="True">
                                                                                <Setter Property="Background"
                                                                                        Value="{DynamicResource TintGreenBrush}"/>
                                                                                <Setter Property="Opacity" Value="0.72"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="40"/>
                                                                        <ColumnDefinition Width="*" MinWidth="200"/>
                                                                        <ColumnDefinition Width="60"/>
                                                                        <ColumnDefinition Width="60"/>
                                                                        <ColumnDefinition Width="60"/>
                                                                        <ColumnDefinition Width="60"/>
                                                                        <ColumnDefinition Width="55"/>
                                                                        <ColumnDefinition Width="70"/>
                                                                        <ColumnDefinition Width="80"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="65"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="95"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="70"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding SerialNumber}"
                                                                               Style="{StaticResource GridDataCell}"
                                                                               HorizontalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding GlassRef}"
                                                                               Style="{StaticResource GridDataCell}"
                                                                               FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding GlassRef}"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding W1}"
                                                                               Style="{StaticResource GridNumericCell}"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding H1}"
                                                                               Style="{StaticResource GridNumericCell}"/>
                                                                    <TextBlock Grid.Column="4">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock"
                                                                                   BasedOn="{StaticResource OptionalDimStyle}">
                                                                                <Setter Property="Text" Value="{Binding W2}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding W2}" Value="0">
                                                                                        <Setter Property="Text" Value="—"/>
                                                                                        <Setter Property="Foreground"
                                                                                                Value="{DynamicResource MutedForegroundBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Grid.Column="5">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock"
                                                                                   BasedOn="{StaticResource OptionalDimStyle}">
                                                                                <Setter Property="Text" Value="{Binding H2}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding H2}" Value="0">
                                                                                        <Setter Property="Text" Value="—"/>
                                                                                        <Setter Property="Foreground"
                                                                                                Value="{DynamicResource MutedForegroundBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Grid.Column="6"
                                                                               Text="{Binding OrderedQty}"
                                                                               Style="{StaticResource GridNumericCell}"/>
                                                                    <TextBlock Grid.Column="7"
                                                                               Text="{Binding Sqm, StringFormat={}{0:0.000}}"
                                                                               Style="{StaticResource GridNumericCell}"
                                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                                    <TextBlock Grid.Column="8"
                                                                               Text="{Binding TotalSqm, StringFormat={}{0:0.000}}"
                                                                               Style="{StaticResource GridNumericCell}"
                                                                               FontWeight="Bold"/>
                                                                    <Border Grid.Column="9"
                                                                            Style="{StaticResource ColumnSeparatorStyle}"/>
                                                                    <TextBlock Grid.Column="10"
                                                                               Text="{Binding PreviouslyDeliveredQty}"
                                                                               Style="{StaticResource GridNumericCell}"
                                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                                    <Border Grid.Column="11"
                                                                            Style="{StaticResource ColumnSeparatorStyle}"/>
                                                                    <TextBox Grid.Column="12"
                                                                             Text="{Binding DeliveredQty,
                                                                                    UpdateSourceTrigger=PropertyChanged}"
                                                                             behaviors:TextBoxBehaviors.AcceptIntegersOnly="True"
                                                                             Style="{StaticResource DeliveredQtyTextBoxStyle}"/>
                                                                    <TextBlock Grid.Column="12"
                                                                               Text="{Binding DeliveredQty}"
                                                                               Style="{StaticResource DeliveredQtyReadOnlyStyle}"/>
                                                                    <Border Grid.Column="13"
                                                                            Style="{StaticResource ColumnSeparatorStyle}"/>
                                                                    <TextBlock Grid.Column="14"
                                                                               Text="{Binding BalanceQty}"
                                                                               Style="{StaticResource BalanceCellStyle}"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Border Background="{DynamicResource TintIndigoBrush}"
                                                        BorderBrush="{DynamicResource OutlineBrush}"
                                                        BorderThickness="0,1,0,0"
                                                        Padding="16,10"
                                                        CornerRadius="0,0,12,12">
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Right">
                                                        <TextBlock Text="SPEC TOTAL: "
                                                                   FontSize="11" FontWeight="Bold"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock FontSize="11"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="8,0,0,0">
                                                            <Run Text="{Binding ItemCount, Mode=OneWay}"
                                                                 FontWeight="SemiBold"/>
                                                            <Run Text=" items"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- ══ RIGHT SLIDE-IN ROW STATS PANEL (Sheet Store pattern) ══
                 Collapsed by default so the items grid is full-width. Slides
                 in when a row is clicked; shows THAT row's stats. When no
                 row is selected the top KPI strip keeps showing totals. -->
            <Grid x:Name="DetailPanel" Grid.Column="1" Margin="10,0,0,0"
                  Visibility="Collapsed">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="PanelSlide" X="0"/>
                </Grid.RenderTransform>

                <Border Width="360"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource ModuleBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="20"
                        SnapsToDevicePixels="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Panel header + close -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40"
                                        CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                                        Grid.Column="0"
                                        Background="{DynamicResource AccentBrush}">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="17" Foreground="{DynamicResource OnAccentForegroundBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0">
                                    <TextBlock Text="ROW DETAILS"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding SelectionLabel}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Style="{StaticResource RowOutlinedButton}"
                                        Tag="&#xE711;" Content=""
                                        VerticalAlignment="Top"
                                        ToolTip="Close (click the row again)"
                                        Command="{Binding ClearSelectionCommand}"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource OutlineBrush}" Margin="0,16,0,16"/>

                            <!-- Selected row identity -->
                            <TextBlock Text="SPECIFICATION"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="4,0,0,8"/>
                            <Border CornerRadius="{DynamicResource CardCornerRadius}" Padding="12,10"
                                    Margin="0,0,0,12"
                                    Background="{DynamicResource TintBlueBrush}"
                                    BorderBrush="{DynamicResource OutlineBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedItemRow.SpecGroupName}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               Margin="0,4,0,0">
                                        <Run Text="Glass ref: "/><Run Text="{Binding SelectedItemRow.GlassRef, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               Margin="0,2,0,0">
                                        <Run Text="Dimensions: "/><Run Text="{Binding SelectedItemRow.DimensionDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                               Margin="0,2,0,0">
                                        <Run Text="SQM: "/><Run Text="{Binding SelectedItemRow.Sqm, Mode=OneWay, StringFormat={}{0:0.000}}" FontWeight="SemiBold"/>
                                        <Run Text="  ·  T.SQM: "/><Run Text="{Binding SelectedItemRow.TotalSqm, Mode=OneWay, StringFormat={}{0:0.000}}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Selected row quantities -->
                            <TextBlock Text="QUANTITIES"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="4,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Column="0" Grid.Row="0" CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="12,10"
                                        Margin="0,0,4,10"
                                        Background="{DynamicResource TintBlueBrush}"
                                        BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="ORDERED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="{Binding SelectedItemRow.OrderedQty}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Grid.Row="0" CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="12,10"
                                        Margin="4,0,0,10"
                                        Background="{DynamicResource TintIndigoBrush}"
                                        BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="PREV DELIVERED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="{Binding SelectedItemRow.PreviouslyDeliveredQty}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="0" Grid.Row="1" CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="12,10"
                                        Margin="0,0,4,10"
                                        Background="{DynamicResource TintGreenBrush}"
                                        BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="THIS DN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                        <TextBlock Text="{Binding SelectedItemRow.DeliveredQty}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Grid.Row="1" CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="12,10"
                                        Margin="4,0,0,10"
                                        Background="{DynamicResource TintAmberBrush}"
                                        BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="BALANCE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                        <TextBlock Text="{Binding SelectedItemRow.BalanceQty}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
