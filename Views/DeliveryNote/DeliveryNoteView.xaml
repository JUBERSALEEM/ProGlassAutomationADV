<UserControl x:Class="ProGlassAutomation.Views.DeliveryNote.DeliveryNoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:list="clr-namespace:ProGlassAutomation.Views.DeliveryNote.DeliveryNoteList"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Background="{DynamicResource WindowBackgroundBrush}"
          Margin="0,60,0,0">

        <!-- LIST VIEW -->
        <Border Margin="14,8,14,14">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsListView}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <ContentControl Content="{Binding ListVM}">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <list:DeliveryNoteListView/>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>

        <!-- DETAIL VIEW — wired in Phase 10.4 -->
        <Border Margin="14,8,14,14">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDetailView}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <!-- Detail ContentControl added in Phase 10.4 -->
            <TextBlock Text="Detail view coming in Phase 10.4"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
        </Border>

    </Grid>
</UserControl>