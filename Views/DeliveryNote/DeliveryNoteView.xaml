<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/DeliveryNote/DeliveryNoteView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Delivery Note shell

     TAB STRIP UPGRADE:
       [ Workspace ]   [ God View ]   [ Activity ]
       • Workspace — the original list ↔ detail flow (preserved 1:1)
       • God View  — separate all-records overview (DeliveryNoteGodView)
       • Activity  — live per-section audit feed

     The Workspace content keeps the exact ContentControl/DataTrigger
     pattern from previous versions — nothing removed.
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.DeliveryNote.DeliveryNoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:list="clr-namespace:ProGlassAutomation.Views.DeliveryNote.DeliveryNoteList"
             xmlns:detail="clr-namespace:ProGlassAutomation.Views.DeliveryNote.DeliveryNoteDetail"
             xmlns:detailVm="clr-namespace:ProGlassAutomation.ViewModels.DeliveryNote.DeliveryNoteDetail"
             xmlns:godview="clr-namespace:ProGlassAutomation.Views.DeliveryNote.GodView"
             xmlns:sharedViews="clr-namespace:ProGlassAutomation.Views.Shared"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!--
            DataTemplate tells WPF: "when Content is a DeliveryNoteDetailViewModel,
            render it using DeliveryNoteDetailView."
            The DataContext of the view is automatically set to the VM instance.
            This is instantiated LAZILY — only when DetailVM becomes non-null.
        -->
        <DataTemplate DataType="{x:Type detailVm:DeliveryNoteDetailViewModel}">
            <detail:DeliveryNoteDetailView/>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ TAB STRIP ══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Style="{StaticResource ModuleTabStripStyle}"
                Margin="20,14,20,0">
            <StackPanel Orientation="Horizontal">

                <Button Style="{StaticResource ModuleTabButtonStyle}"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="Workspace">
                    <TextBlock Text="🗂  Workspace">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource SecondaryForegroundBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWorkspaceTab}" Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <Button Style="{StaticResource ModuleTabButtonStyle}"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="GodView">
                    <TextBlock Text="🌐  God View">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource SecondaryForegroundBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGodViewTab}" Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <Button Style="{StaticResource ModuleTabButtonStyle}"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="Activity">
                    <TextBlock Text="📜  Activity">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource SecondaryForegroundBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActivityTab}" Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </StackPanel>
        </Border>

        <!-- ══ TAB CONTENT ════════════════════════════════════════════ -->
        <Grid Grid.Row="1">

            <!-- ═══ WORKSPACE — original list ↔ detail flow ═══ -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWorkspaceTab}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- ══ LIST VIEW ════════════════════════════════════════
                     Shown when IsListView = True.
                     DataContext explicitly set to ListVM (always non-null).

                     NOTE: DataContext of this DeliveryNoteListView is ListVM,
                     so we must walk up to the parent UserControl to get
                     IsListView from DeliveryNoteViewModel. This is correct
                     and intentional — do not simplify this binding.
                ═══════════════════════════════════════════════════════ -->
                <list:DeliveryNoteListView DataContext="{Binding ListVM}">
                    <list:DeliveryNoteListView.Style>
                        <Style TargetType="list:DeliveryNoteListView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsListView,
                                                               RelativeSource={RelativeSource
                                                                   AncestorType=UserControl}}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </list:DeliveryNoteListView.Style>
                </list:DeliveryNoteListView>

                <!-- ══ DETAIL VIEW ═══════════════════════════════════════
                     ContentControl pattern — identical to JobOrderView.xaml.

                     HOW IT WORKS:
                     - Content="{Binding DetailVM}" watches DetailVM on the shell VM
                     - When DetailVM is null  → ContentControl renders nothing
                     - When DetailVM is set   → WPF finds the DataTemplate above
                                                and instantiates DeliveryNoteDetailView
                                                with DataContext = DetailVM automatically
                     - No direct instantiation → no frozen-null-DataContext problem
                ═══════════════════════════════════════════════════════ -->
                <ContentControl Content="{Binding DetailVM}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDetailView}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>

            <!-- ═══ GOD VIEW TAB ═══ -->
            <godview:DeliveryNoteGodView DataContext="{Binding GodViewVM}">
                <godview:DeliveryNoteGodView.Style>
                    <Style TargetType="godview:DeliveryNoteGodView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsGodViewTab,
                                                     RelativeSource={RelativeSource
                                                         AncestorType=UserControl}}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </godview:DeliveryNoteGodView.Style>
            </godview:DeliveryNoteGodView>

            <!-- ═══ ACTIVITY TAB (live per-section audit feed) ═══ -->
            <sharedViews:SectionActivityView DataContext="{Binding ActivityVM}">
                <sharedViews:SectionActivityView.Style>
                    <Style TargetType="sharedViews:SectionActivityView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsActivityTab,
                                                     RelativeSource={RelativeSource
                                                         AncestorType=UserControl}}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </sharedViews:SectionActivityView.Style>
            </sharedViews:SectionActivityView>
        </Grid>
    </Grid>
</UserControl>
