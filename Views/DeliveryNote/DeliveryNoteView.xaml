<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/DeliveryNote/DeliveryNoteView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Delivery Note shell

     TAB STRIP UPGRADE:
       [ Workspace ]   [ God View ]   [ Activity ]
       • Workspace — the original list ↔ detail flow (preserved 1:1)
       • God View  — separate all-records overview (DeliveryNoteGodView)
       • Activity  — live per-section audit feed

     The Workspace content keeps the exact ContentControl/DataTrigger
     pattern from previous versions — nothing removed.
═══════════════════════════════════════════════════════════════════════ -->

<!-- MIGRATION LOG — Button Standardization (master prompt v1.0)
     Date: 2026-08-15 — DN/TI/JO batch 4a
     • Shell tabs (Workspace/God View/Activity) -> STEP D two-button
       visibility pattern with MDL2 glyphs (E8B7/E774/E81C)
     • List toolbars: Clear/Refresh/Create -> Row*/Primary pills
     • Row actions (Open/Master Invoice) -> Row* variants
     • Tab-card filter icons: emoji Tags -> MDL2 glyphs + MDL2 font
       on the template icon TextBlocks
     • Hero/Empty-state icon slots -> MDL2 glyphs (controls render
       glyph-or-emoji via IconFontFamilyConverter)
     • Decorative inline meta-text emoji (dates, runs) intentionally
       left for the visual polish pass (not buttons/tabs/badges)
     Commands/bindings/code-behind preserved; no VM changes.
═══════════════════════════════════════════════════════════════ -->
<!-- MIGRATION LOG — Button Standardization batch 4b (2026-08-15)
     • Grey oval ModuleTabStripStyle container removed from shells —
       pills now sit directly on the page (reference look)
     • JO saved list: CLEAR/REFRESH -> Row pills; row OPEN/HISTORY ->
       RowPrimary/RowOutlined; OpenButtonStyle/HistoryButtonStyle removed
     • God Views: header Refresh -> PrimaryPillButton; row Open ->
       RowPrimaryButton; hero/empty icon slots -> MDL2 glyphs
     Commands/bindings/code-behind preserved; no VM changes.
═══════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.DeliveryNote.DeliveryNoteView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:list="clr-namespace:ProGlassAutomation.Views.DeliveryNote.DeliveryNoteList"
             xmlns:detail="clr-namespace:ProGlassAutomation.Views.DeliveryNote.DeliveryNoteDetail"
             xmlns:detailVm="clr-namespace:ProGlassAutomation.ViewModels.DeliveryNote.DeliveryNoteDetail"
             xmlns:godview="clr-namespace:ProGlassAutomation.Views.DeliveryNote.GodView"
             xmlns:sharedViews="clr-namespace:ProGlassAutomation.Views.Shared"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!--
            DataTemplate tells WPF: "when Content is a DeliveryNoteDetailViewModel,
            render it using DeliveryNoteDetailView."
            The DataContext of the view is automatically set to the VM instance.
            This is instantiated LAZILY — only when DetailVM becomes non-null.
        -->
        <DataTemplate DataType="{x:Type detailVm:DeliveryNoteDetailViewModel}">
            <detail:DeliveryNoteDetailView/>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ TAB STRIP ══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Margin="20,14,20,0">
            <StackPanel Orientation="Horizontal">

                <!-- TAB WORKSPACE — STEP D two-button visibility pattern -->
                <Button Command="{Binding SwitchTabCommand}"
                        CommandParameter="Workspace"
                        Tag="&#xE8B7;" Content="{DynamicResource Common.Workspace}"
                        ToolTip="{DynamicResource DeliveryNote.OpenDocumentWorkspace}" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource OutlinedPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWorkspaceTab}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding SwitchTabCommand}"
                        CommandParameter="Workspace"
                        Tag="&#xE8B7;" Content="{DynamicResource Common.Workspace}"
                        ToolTip="{DynamicResource DeliveryNote.OpenDocumentWorkspace}" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWorkspaceTab}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- TAB GOD VIEW — STEP D two-button visibility pattern -->
                <Button Command="{Binding SwitchTabCommand}"
                        CommandParameter="GodView"
                        Tag="&#xE774;" Content="{DynamicResource DeliveryNote.GODVIEW}"
                        ToolTip="{DynamicResource DeliveryNote.CrossDocumentOverview}" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource OutlinedPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGodViewTab}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding SwitchTabCommand}"
                        CommandParameter="GodView"
                        Tag="&#xE774;" Content="{DynamicResource DeliveryNote.GODVIEW}"
                        ToolTip="{DynamicResource DeliveryNote.CrossDocumentOverview}" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGodViewTab}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- TAB ACTIVITY — STEP D two-button visibility pattern -->
                <Button Command="{Binding SwitchTabCommand}"
                        CommandParameter="Activity"
                        Tag="&#xE81C;" Content="{DynamicResource Common.Activity}"
                        ToolTip="{DynamicResource DeliveryNote.ActivityTrailModule}" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource OutlinedPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActivityTab}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Command="{Binding SwitchTabCommand}"
                        CommandParameter="Activity"
                        Tag="&#xE81C;" Content="{DynamicResource Common.Activity}"
                        ToolTip="{DynamicResource DeliveryNote.ActivityTrailModule}" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActivityTab}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- ══ TAB CONTENT ════════════════════════════════════════════ -->
        <Grid Grid.Row="1">

            <!-- ═══ WORKSPACE — original list ↔ detail flow ═══ -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWorkspaceTab}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- ══ LIST VIEW ════════════════════════════════════════
                     Shown when IsListView = True.
                     DataContext explicitly set to ListVM (always non-null).

                     NOTE: DataContext of this DeliveryNoteListView is ListVM,
                     so we must walk up to the parent UserControl to get
                     IsListView from DeliveryNoteViewModel. This is correct
                     and intentional — do not simplify this binding.
                ═══════════════════════════════════════════════════════ -->
                <list:DeliveryNoteListView DataContext="{Binding ListVM}">
                    <list:DeliveryNoteListView.Style>
                        <Style TargetType="list:DeliveryNoteListView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsListView,
                                                               RelativeSource={RelativeSource
                                                                   AncestorType=UserControl}}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </list:DeliveryNoteListView.Style>
                </list:DeliveryNoteListView>

                <!-- ══ DETAIL VIEW ═══════════════════════════════════════
                     ContentControl pattern — identical to JobOrderView.xaml.

                     HOW IT WORKS:
                     - Content="{Binding DetailVM}" watches DetailVM on the shell VM
                     - When DetailVM is null  → ContentControl renders nothing
                     - When DetailVM is set   → WPF finds the DataTemplate above
                                                and instantiates DeliveryNoteDetailView
                                                with DataContext = DetailVM automatically
                     - No direct instantiation → no frozen-null-DataContext problem
                ═══════════════════════════════════════════════════════ -->
                <ContentControl Content="{Binding DetailVM}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDetailView}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>

            <!-- ═══ GOD VIEW TAB ═══ -->
            <godview:DeliveryNoteGodView DataContext="{Binding GodViewVM}">
                <godview:DeliveryNoteGodView.Style>
                    <Style TargetType="godview:DeliveryNoteGodView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsGodViewTab,
                                                     RelativeSource={RelativeSource
                                                         AncestorType=UserControl}}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </godview:DeliveryNoteGodView.Style>
            </godview:DeliveryNoteGodView>

            <!-- ═══ ACTIVITY TAB (live per-section audit feed) ═══ -->
            <sharedViews:SectionActivityView DataContext="{Binding ActivityVM}">
                <sharedViews:SectionActivityView.Style>
                    <Style TargetType="sharedViews:SectionActivityView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsActivityTab,
                                                     RelativeSource={RelativeSource
                                                         AncestorType=UserControl}}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </sharedViews:SectionActivityView.Style>
            </sharedViews:SectionActivityView>
        </Grid>
    </Grid>
</UserControl>
