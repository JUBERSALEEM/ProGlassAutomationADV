<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/SheetStore/SheetDetailWindow.xaml
     MODULE: Inventory — full-screen detail workspace

     Opened by DOUBLE-CLICKING a row. Maximized, not a 480px dialog:
     this is a workspace, and the previous attempt at it was a cloned
     Buy dialog that offered nothing the list did not already show.

     Composition:
       header — identity (category / thickness / colour / size) + the
                row's actions (BUY · USE) + close
       tabs   — Overview · Edit · Movements · Analysis
       body   — one panel per tab, swapped on ActiveKey
       footer — SAVE, gated on validity

     Delete is deliberately ABSENT. See the view-model header.
═══════════════════════════════════════════════════════════════════ -->
<Window x:Class="ProGlassAutomation.Views.SheetStore.SheetDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
        Title="{Binding HeaderTitle}"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        MinWidth="980" MinHeight="640"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextDisplay}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DialogInsetBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource StatCard}">
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Editable entry. Red outline while the field is rejected: the
             inline message alone is easy to miss on a 3-column form. -->
        <Style x:Key="DetailEntry" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="Background" Value="{DynamicResource DialogInsetBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        </Style>

        <Style x:Key="ReadValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>   <!-- tab strip -->
            <RowDefinition Height="*"/>      <!-- body -->
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding HeaderTitle}"
                           FontSize="{StaticResource TextDisplayLarge}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                <TextBlock Text="{Binding HeaderSubtitle}"
                           FontSize="{StaticResource TextBody}"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </StackPanel>

            <!-- Row actions travel with the row, as asked. BUY/USE are
                 here AND in the list: considered work happens here,
                 fast repetitive receiving happens in the list. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource PrimaryPillButton}"
                        Content="BUY" MinWidth="110" Margin="0,0,10,0"
                        Command="{Binding BuyCommand}"
                        CommandParameter="{Binding Sheet}"/>
                <Button Style="{StaticResource OutlinedPillButton}"
                        Content="USE" MinWidth="110" Margin="0,0,10,0"
                        Command="{Binding UseCommand}"
                        CommandParameter="{Binding Sheet}"/>
                <Button Style="{StaticResource OutlinedPillButton}"
                        Content="CLOSE" MinWidth="110"
                        Command="{Binding CloseCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ═══ TAB STRIP ════════════════════════════════════════════
             A single click switches tab — that is all it does. There is
             no edit mode to enter, so the tabs never gate the fields.
        ═════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{DynamicResource DialogInsetBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="{DynamicResource CardBorderThickness}"
                CornerRadius="{DynamicResource CardCornerRadius}"
                Padding="6" Margin="0,0,0,18"
                HorizontalAlignment="Left"
                SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource TabPillButton}" Content="OVERVIEW"
                        Command="{Binding SelectTabCommand}" CommandParameter="Overview"
                        behaviors:TabState.IsActive="{Binding IsOverview, Mode=OneWay}"/>
                <Button Style="{StaticResource TabPillButton}" Content="EDIT"
                        Command="{Binding SelectTabCommand}" CommandParameter="Edit"
                        behaviors:TabState.IsActive="{Binding IsEdit, Mode=OneWay}"/>
                <Button Style="{StaticResource TabPillButton}" Content="MOVEMENTS"
                        Command="{Binding SelectTabCommand}" CommandParameter="Movements"
                        behaviors:TabState.IsActive="{Binding IsMovements, Mode=OneWay}"/>
                <Button Style="{StaticResource TabPillButton}" Content="ANALYSIS"
                        Command="{Binding SelectTabCommand}" CommandParameter="Analysis"
                        behaviors:TabState.IsActive="{Binding IsAnalysis, Mode=OneWay}"/>
            </StackPanel>
        </Border>

        <!-- ═══ BODY ═════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">

            <!-- ─── OVERVIEW ─── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          behaviors:SmoothScrollBehavior.IsEnabled="True">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOverview}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel>
                    <UniformGrid Columns="4" Margin="0,0,0,18">
                        <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="STOCK" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Sheet.Stock}" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="USED" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Sheet.Used}" Style="{StaticResource StatValue}"
                                           Foreground="{DynamicResource DangerBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="BALANCE" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Sheet.Balance}" Style="{StaticResource StatValue}"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="SQM AVAILABLE" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding Sheet.TotalSqmBalance, StringFormat={}{0:N2}}"
                                           Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="SPECIFICATION" Style="{StaticResource StatLabel}" Margin="0,0,0,14"/>
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding Sheet.Category}" Style="{StaticResource ReadValue}"/>
                                    <TextBlock Text="Thickness" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding Sheet.ThicknessDisplay}" Style="{StaticResource ReadValue}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Colour" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding Sheet.Color}" Style="{StaticResource ReadValue}"/>
                                    <TextBlock Text="Size (mm)" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding Sheet.SizeDisplay}" Style="{StaticResource ReadValue}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="SQM per sheet" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding Sheet.SqmPerSheet, StringFormat={}{0:N4}}"
                                               Style="{StaticResource ReadValue}"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ─── EDIT ───
                 Hosts the existing AddEditSheetView content region via
                 the shared editor VM, so the validated form is not
                 re-implemented here and cannot drift from the dialog. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          behaviors:SmoothScrollBehavior.IsEnabled="True">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEdit}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="EDIT SHEET" Style="{StaticResource StatLabel}" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap"
                                   FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Text="Fields are always editable — there is no edit mode to enter. Save stays disabled until every entry is valid."/>
                        <!-- Bound to the DIALOG's view-model (Editor), so the
                             validation rules live in one place. Every box is
                             live on load — no edit mode. -->
                        <UniformGrid Columns="3" Margin="0,18,0,0"
                                     DataContext="{Binding Editor}">
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="CATEGORY" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DetailEntry}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding CategoryError}"
                                           Style="{StaticResource FieldError}"
                                           Visibility="{Binding HasCategoryError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <TextBlock Text="THICKNESS (mm)" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                                <TextBox Text="{Binding ThicknessText, UpdateSourceTrigger=PropertyChanged}"
                                         behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                         Style="{StaticResource DetailEntry}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding ThicknessError}"
                                           Style="{StaticResource FieldError}"
                                           Visibility="{Binding HasThicknessError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <TextBlock Text="COLOUR" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                                <TextBox Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DetailEntry}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding ColorError}"
                                           Style="{StaticResource FieldError}"
                                           Visibility="{Binding HasColorError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="WIDTH (mm)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}"
                                         behaviors:TextBoxBehaviors.AcceptIntegersOnly="True"
                                         Style="{StaticResource DetailEntry}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding WidthError}"
                                           Style="{StaticResource FieldError}"
                                           Visibility="{Binding HasWidthError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <TextBlock Text="HEIGHT (mm)" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                                <TextBox Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}"
                                         behaviors:TextBoxBehaviors.AcceptIntegersOnly="True"
                                         Style="{StaticResource DetailEntry}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding HeightError}"
                                           Style="{StaticResource FieldError}"
                                           Visibility="{Binding HasHeightError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <TextBlock Text="SUPPLIER" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                                <TextBox Text="{Binding Supplier, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DetailEntry}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SupplierError}"
                                           Style="{StaticResource FieldError}"
                                           Visibility="{Binding HasSupplierError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="PURCHASE PRICE / SQM" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding PurchasePriceText, UpdateSourceTrigger=PropertyChanged}"
                                         behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                         Style="{StaticResource DetailEntry}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding PurchasePriceError}"
                                           Style="{StaticResource FieldError}"
                                           Visibility="{Binding HasPurchasePriceError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <TextBlock Text="SELL PRICE / SQM" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                                <TextBox Text="{Binding SellPriceText, UpdateSourceTrigger=PropertyChanged}"
                                         behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                         Style="{StaticResource DetailEntry}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SellPriceError}"
                                           Style="{StaticResource FieldError}"
                                           Visibility="{Binding HasSellPriceError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <TextBlock Text="STOCK (sheets)" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                                <TextBox Text="{Binding StockText, UpdateSourceTrigger=PropertyChanged}"
                                         behaviors:TextBoxBehaviors.AcceptIntegersOnly="True"
                                         Style="{StaticResource DetailEntry}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding StockError}"
                                           Style="{StaticResource FieldError}"
                                           Visibility="{Binding HasStockError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </UniformGrid>

                        <!-- SAVE is the only primary action on this form.
                             Delete is not a peer of Save — see the
                             view-model header. -->
                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0"
                                    HorizontalAlignment="Right"
                                    DataContext="{Binding Editor}">
                            <TextBlock Text="{Binding ValidationSummary}"
                                       VerticalAlignment="Center" Margin="0,0,16,0"
                                       TextWrapping="Wrap" MaxWidth="460"
                                       FontSize="{StaticResource TextCaption}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Visibility="{Binding HasValidationSummary, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <Button Style="{StaticResource PrimaryPillButton}"
                                    Content="SAVE CHANGES" MinWidth="170"
                                    Command="{Binding SaveCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- ─── MOVEMENTS ─── -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMovements}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <TextBlock Text="Loading movements…"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="{StaticResource TextBody}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoadingHistory}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="No movements recorded for this sheet yet."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="{StaticResource TextBody}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNoMovements}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <DataGrid ItemsSource="{Binding Movements}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Background="Transparent"
                          BorderThickness="{DynamicResource CardBorderThickness}"
                          BorderBrush="{DynamicResource OutlineBrush}"
                          RowBackground="Transparent"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNoMovements}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLoadingHistory}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="When" Width="170"
                                            Binding="{Binding Timestamp, StringFormat={}{0:dd MMM yyyy HH:mm}}"/>
                        <DataGridTextColumn Header="Action" Width="110"
                                            Binding="{Binding Action}"/>
                        <DataGridTextColumn Header="Qty" Width="80"
                                            Binding="{Binding QuantityChanged}"/>
                        <DataGridTextColumn Header="Value" Width="120"
                                            Binding="{Binding ValueChanged, StringFormat={}{0:N2}}"/>
                        <DataGridTextColumn Header="Details" Width="*"
                                            Binding="{Binding Details}"/>
                        <DataGridTextColumn Header="User" Width="140"
                                            Binding="{Binding UserName}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ─── ANALYSIS ─── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          behaviors:SmoothScrollBehavior.IsEnabled="True">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAnalysis}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel>
                    <UniformGrid Columns="3" Margin="0,0,0,18">
                        <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="BALANCE AT COST" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding BalanceValueAtCost, StringFormat={}{0:N2} AED}"
                                           Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="BALANCE AT SELL" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding BalanceValueAtSell, StringFormat={}{0:N2} AED}"
                                           Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="POTENTIAL PROFIT" Style="{StaticResource StatLabel}"/>
                                <TextBlock Text="{Binding PotentialProfit, StringFormat={}{0:N2} AED}"
                                           Style="{StaticResource StatValue}"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="MARGIN" Style="{StaticResource StatLabel}" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding MarginDisplay}"
                                       FontSize="{StaticResource TextDisplayLarge}" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <!-- "No cost basis" rather than a fake 0%: sheets
                                 are routinely entered before a purchase price
                                 is known, and 0% would read as a real loss. -->
                            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                                       FontSize="{StaticResource TextCaption}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Text="Margin on the remaining balance, measured against its purchase cost.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMarginBasis}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="CONSUMPTION" Style="{StaticResource StatLabel}" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding ConsumptionPercent, StringFormat={}{0:N1}% of stock used}"
                                       FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="{Binding UsedValueAtCost, StringFormat=Used stock at cost: {0:N2} AED}"
                                       FontSize="{StaticResource TextBody}" Margin="0,8,0,0"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
