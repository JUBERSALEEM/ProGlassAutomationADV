<!-- ═══════════════════════════════════════════════════════════════
     MIGRATION LOG — Button Standardization (master prompt v1.0)
     Date: 2026-08-15 — SheetStore module batch
     • All buttons -> centralized PrimaryPill/SuccessPill/OutlinedPill/
       DangerButton styles with MDL2 Tag glyphs + UPPERCASE content
     • Removed legacy local styles (ActionBtn, HeaderActionBtn,
       QtyButtonStyle, Cancel/Save/ConfirmButtonStyle,
       FilterActionButtonStyle, CancelImportBtn)
     • Decorative emojis (search/clock/empty/mailbox) -> MDL2 glyphs
     Commands/bindings preserved; no ViewModel changes.
═══════════════════════════════════════════════════════════════ -->
<Window x:Class="ProGlassAutomation.Views.SheetStore.AddEditSheetView"
             TextOptions.TextHintingMode="Fixed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
        Title="{Binding DialogTitle}"
        Width="640"
        MinWidth="600"
        Height="720"
        MinHeight="640"
        MaxHeight="860"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource Surface.Secondary.BackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- ═══════════════════════════════════════════════════════════════
         KEYBOARD SHORTCUTS
         Enter → Save · Esc → Cancel
    ═══════════════════════════════════════════════════════════════ -->
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <Window.Resources>

        <!-- Field label — 11 SemiBold UPPERCASE per spec -->
        

        <!-- Base text input — industrial chrome. Height 40 so glyphs
             are not clipped the way 38 + Padding 10,6 was. -->
        

        <!-- Integer-only input (Width, Height, Stock) -->
        <!-- Migrated IntInputStyle to global SurfacePrimaryStyle / Typography -->

        <!-- Decimal input (prices) -->
        <!-- Migrated DecimalInputStyle to global SurfacePrimaryStyle / Typography -->

        <!-- Editable combo. Without BasedOn this keyed style dropped the
             industrial template and SizeToContent+* made the form collapse. -->
        <!-- Migrated ComboStyle to global SurfacePrimaryStyle / Typography -->

        <!-- Cancel button — subtle secondary -->

        <!-- Save button — primary indigo -->

    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding DialogTitle}"
                       FontSize="{DynamicResource FontSize.H1}" FontWeight="{DynamicResource Weight.Bold}"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{DynamicResource SheetStore.EnterGlassSheetInventoryDetails}"
                       FontSize="{DynamicResource FontSize.Body}" Margin="0,4,0,0"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
        </StackPanel>

        <!-- Form (smooth scroll) -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      IsDeferredScrollingEnabled="False"
                      PanningMode="None"
                      Focusable="True"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">
            <StackPanel Style="{StaticResource Field.Panel}">

                <TextBlock Text="{DynamicResource SheetStore.Category}" Style="{StaticResource Field.Label}"/>
                <ComboBox Style="{StaticResource Input.ComboBox}"
                          ItemsSource="{Binding CategoryOptions}"
                          Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="{DynamicResource SheetStore.EGClearFloatGuardianClimaguard70}"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          behaviors:EditableComboBoxTypingBehavior.IsEnabled="True"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Style="{StaticResource Field.Panel}" Grid.Column="0">
                        <TextBlock Text="{DynamicResource SheetStore.ThicknessMm}" Style="{StaticResource Field.Label}"/>
                        <ComboBox Style="{StaticResource Input.ComboBox}"
                                  ItemsSource="{Binding ThicknessOptions}"
                                  Text="{Binding ThicknessText, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  behaviors:EditableComboBoxTypingBehavior.IsEnabled="True"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Field.Panel}" Grid.Column="2">
                        <TextBlock Text="{DynamicResource ProformaInvoice.Color}" Style="{StaticResource Field.Label}"/>
                        <ComboBox Style="{StaticResource Input.ComboBox}"
                                  ItemsSource="{Binding ColorOptions}"
                                  Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  behaviors:EditableComboBoxTypingBehavior.IsEnabled="True"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Style="{StaticResource Field.Panel}" Grid.Column="0">
                        <TextBlock Text="{DynamicResource SheetStore.WidthMm}" Style="{StaticResource Field.Label}"/>
                        <ComboBox Style="{StaticResource Input.ComboBox}"
                                  ItemsSource="{Binding WidthOptions}"
                                  Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  behaviors:EditableComboBoxTypingBehavior.IsEnabled="True"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Field.Panel}" Grid.Column="2">
                        <TextBlock Text="{DynamicResource SheetStore.HeightMm}" Style="{StaticResource Field.Label}"/>
                        <ComboBox Style="{StaticResource Input.ComboBox}"
                                  ItemsSource="{Binding HeightOptions}"
                                  Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  behaviors:EditableComboBoxTypingBehavior.IsEnabled="True"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{DynamicResource SheetStore.Supplier}" Style="{StaticResource Field.Label}"/>
                <ComboBox Style="{StaticResource Input.ComboBox}"
                          ItemsSource="{Binding SupplierOptions}"
                          Text="{Binding Supplier, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          behaviors:EditableComboBoxTypingBehavior.IsEnabled="True"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Style="{StaticResource Field.Panel}" Grid.Column="0">
                        <TextBlock Text="{DynamicResource SheetStore.PurchasePriceSQM}" Style="{StaticResource Field.Label}"/>
                        <TextBox Style="{StaticResource Input.TextBox}"
                                 behaviors:TextBoxBehaviors.SelectAllOnFocus="True"
                                 Text="{Binding PurchasePriceText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Field.Panel}" Grid.Column="2">
                        <TextBlock Text="{DynamicResource SheetStore.SELLPriceSQM}" Style="{StaticResource Field.Label}"/>
                        <TextBox Style="{StaticResource Input.TextBox}"
                                 behaviors:TextBoxBehaviors.SelectAllOnFocus="True"
                                 Text="{Binding SellPriceText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{DynamicResource SheetStore.StockQuantity}" Style="{StaticResource Field.Label}"/>
                <TextBox Style="{StaticResource Input.TextBox}"
                         behaviors:TextBoxBehaviors.SelectAllOnFocus="True"
                         Text="{Binding StockText, UpdateSourceTrigger=PropertyChanged}"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Error message — palette-aligned crimson -->
        <Border Grid.Row="2"
                Background="{DynamicResource TintRedBrush}"
                BorderBrush="{DynamicResource DangerBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                Padding="14,12"
                Margin="0,16,0,0"
                SnapsToDevicePixels="True"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource SurfacePrimaryStyle}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource FontFamily.Icon}"
                           FontSize="{DynamicResource FontSize.H3}"
                           FontWeight="{DynamicResource Weight.Bold}"
                           Foreground="{DynamicResource DangerBrush}"
                           VerticalAlignment="Top"
                           Margin="0,0,10,0"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="{DynamicResource FontSize.Body}"
                           FontWeight="{DynamicResource Weight.SemiBold}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Style="{StaticResource OutlinedPillButton}"
                    Tag="&#xE711;" Content="{DynamicResource Action.Cancel}"
                    Margin="0,0,12,0"
                    ToolTip="{DynamicResource SheetStore.DiscardChangesClose}"
                    Command="{Binding CancelCommand}"/>
            <Button Style="{StaticResource PrimaryPillButton}"
                    Tag="&#xE74E;" Content="{Binding SaveButtonText}"
                    ToolTip="{DynamicResource SheetStore.SaveSheet}"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>