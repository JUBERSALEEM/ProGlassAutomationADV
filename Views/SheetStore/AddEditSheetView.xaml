<!-- ═══════════════════════════════════════════════════════════════
     SHEET STORE — Add / Edit Glass Sheet Dialog
     Bento Design System: Compact structured fieldsets, standardized
     36px button rhythm, zero concentric cards, full token alignment.
═══════════════════════════════════════════════════════════════ -->
<Window x:Class="ProGlassAutomation.Views.SheetStore.AddEditSheetView"
        TextOptions.TextHintingMode="Fixed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
        Title="{Binding DialogTitle}"
        Width="660"
        MinWidth="600"
        Height="740"
        MinHeight="640"
        MaxHeight="880"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource Ov.Canvas}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Dashboard/Overview/IndigoStudioResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Bento Form ScrollViewer -->
            <RowDefinition Height="Auto"/> <!-- Error banner -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Border Style="{StaticResource Ov.IconBox}" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock Text="&#xE7B8;" Style="{StaticResource Ov.Glyph}"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding DialogTitle}" Style="{StaticResource Ov.CardTitle}"/>
                <TextBlock Text="{DynamicResource SheetStore.EnterGlassSheetInventoryDetails}"
                           Style="{StaticResource Ov.Meta}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Bento Form -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="None"
                      Focusable="False"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">
            <StackPanel>
                <!-- Bento Fieldset 1: Physical Specification -->
                <Border Style="{StaticResource Ov.CardCompact}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="GLASS SPECIFICATION" Style="{StaticResource Ov.Meta}"
                                   FontWeight="{DynamicResource Weight.Bold}" Margin="0,0,0,12"/>

                        <!-- Category -->
                        <TextBlock Text="{DynamicResource SheetStore.Category}" Style="{StaticResource Field.Label}"/>
                        <ComboBox Style="{StaticResource Input.ComboBox}"
                                  ItemsSource="{Binding CategoryOptions}"
                                  Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="{DynamicResource SheetStore.EGClearFloatGuardianClimaguard70}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  behaviors:EditableComboBoxTypingBehavior.IsEnabled="True"
                                  Margin="0,0,0,12"/>

                        <!-- Thickness & Color -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource SheetStore.ThicknessMm}" Style="{StaticResource Field.Label}"/>
                                <ComboBox Style="{StaticResource Input.ComboBox}"
                                          ItemsSource="{Binding ThicknessOptions}"
                                          Text="{Binding ThicknessText, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          behaviors:EditableComboBoxTypingBehavior.IsEnabled="True"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource ProformaInvoice.Color}" Style="{StaticResource Field.Label}"/>
                                <ComboBox Style="{StaticResource Input.ComboBox}"
                                          ItemsSource="{Binding ColorOptions}"
                                          Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          behaviors:EditableComboBoxTypingBehavior.IsEnabled="True"/>
                            </StackPanel>
                        </Grid>

                        <!-- Width & Height -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource SheetStore.WidthMm}" Style="{StaticResource Field.Label}"/>
                                <ComboBox Style="{StaticResource Input.ComboBox}"
                                          ItemsSource="{Binding WidthOptions}"
                                          Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          behaviors:EditableComboBoxTypingBehavior.IsEnabled="True"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource SheetStore.HeightMm}" Style="{StaticResource Field.Label}"/>
                                <ComboBox Style="{StaticResource Input.ComboBox}"
                                          ItemsSource="{Binding HeightOptions}"
                                          Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          behaviors:EditableComboBoxTypingBehavior.IsEnabled="True"/>
                            </StackPanel>
                        </Grid>

                        <!-- Supplier -->
                        <TextBlock Text="{DynamicResource SheetStore.Supplier}" Style="{StaticResource Field.Label}"/>
                        <ComboBox Style="{StaticResource Input.ComboBox}"
                                  ItemsSource="{Binding SupplierOptions}"
                                  Text="{Binding Supplier, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  behaviors:EditableComboBoxTypingBehavior.IsEnabled="True"/>
                    </StackPanel>
                </Border>

                <!-- Bento Fieldset 2: Pricing & Stock Inventory -->
                <Border Style="{StaticResource Ov.CardCompact}">
                    <StackPanel>
                        <TextBlock Text="PRICING &amp; WAREHOUSE STOCK" Style="{StaticResource Ov.Meta}"
                                   FontWeight="{DynamicResource Weight.Bold}" Margin="0,0,0,12"/>

                        <!-- Purchase & Sell Rates -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource SheetStore.PurchasePriceSQM}" Style="{StaticResource Field.Label}"/>
                                <TextBox Style="{StaticResource Input.TextBox}"
                                         behaviors:TextBoxBehaviors.SelectAllOnFocus="True"
                                         Text="{Binding PurchasePriceText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource SheetStore.SELLPriceSQM}" Style="{StaticResource Field.Label}"/>
                                <TextBox Style="{StaticResource Input.TextBox}"
                                         behaviors:TextBoxBehaviors.SelectAllOnFocus="True"
                                         Text="{Binding SellPriceText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Opening Stock Quantity -->
                        <TextBlock Text="{DynamicResource SheetStore.StockQuantity}" Style="{StaticResource Field.Label}"/>
                        <TextBox Style="{StaticResource Input.TextBox}"
                                 behaviors:TextBoxBehaviors.SelectAllOnFocus="True"
                                 Text="{Binding StockText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Error Message Banner -->
        <Border Grid.Row="2"
                Background="{DynamicResource Ov.DangerSoft}"
                BorderBrush="{DynamicResource Ov.Danger}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,12,0,0"
                SnapsToDevicePixels="True"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource FontFamily.Icon}"
                           FontSize="{DynamicResource FontSize.H3}"
                           Foreground="{DynamicResource Ov.Danger}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource Ov.Danger}"
                           FontSize="{DynamicResource FontSize.BodySmall}"
                           FontWeight="{DynamicResource Weight.SemiBold}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Standardized 36px Action Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Style="{StaticResource OutlinedPillButton}"
                    Height="36" Padding="18,0"
                    Tag="&#xE711;" Content="{DynamicResource Action.Cancel}"
                    Margin="0,0,12,0"
                    ToolTip="{DynamicResource SheetStore.DiscardChangesClose}"
                    Command="{Binding CancelCommand}"/>
            <Button Style="{StaticResource PrimaryPillButton}"
                    Height="36" Padding="20,0"
                    Tag="&#xE74E;" Content="{Binding SaveButtonText}"
                    ToolTip="{DynamicResource SheetStore.SaveSheet}"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
