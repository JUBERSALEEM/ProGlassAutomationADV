<!-- ═══════════════════════════════════════════════════════════════
     MIGRATION LOG — Button Standardization (master prompt v1.0)
     Date: 2026-08-15 — SheetStore module batch
     • All buttons -> centralized PrimaryPill/SuccessPill/OutlinedPill/
       DangerButton styles with MDL2 Tag glyphs + UPPERCASE content
     • Removed legacy local styles (ActionBtn, HeaderActionBtn,
       QtyButtonStyle, Cancel/Save/ConfirmButtonStyle,
       FilterActionButtonStyle, CancelImportBtn)
     • Decorative emojis (search/clock/empty/mailbox) -> MDL2 glyphs
     Commands/bindings preserved; no ViewModel changes.
═══════════════════════════════════════════════════════════════ -->
<Window x:Class="ProGlassAutomation.Views.SheetStore.AddEditSheetView"
             TextOptions.TextHintingMode="Fixed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
        Title="{Binding DialogTitle}"
        Width="520" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- ═══════════════════════════════════════════════════════════════
         KEYBOARD SHORTCUTS
         Enter → Save · Esc → Cancel
    ═══════════════════════════════════════════════════════════════ -->
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <Window.Resources>

        <!-- Field label — 11 SemiBold UPPERCASE per spec -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>

        <!-- Base text input (uses global TextBox focus glow from App.xaml) -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>

        <!-- Integer-only input (Width, Height, Stock) -->
        <Style x:Key="IntInputStyle" TargetType="TextBox"
               BasedOn="{StaticResource InputStyle}">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="behaviors:TextBoxBehaviors.AcceptIntegersOnly" Value="True"/>
        </Style>

        <!-- Decimal input (prices) -->
        <Style x:Key="DecimalInputStyle" TargetType="TextBox"
               BasedOn="{StaticResource InputStyle}">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="behaviors:TextBoxBehaviors.AcceptDecimals" Value="True"/>
        </Style>

        <!-- ComboBox -->
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Cancel button — subtle secondary -->

        <!-- Save button — primary indigo -->

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding DialogTitle}"
                       FontSize="{StaticResource TextHeadline}" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
            <TextBlock Text="{DynamicResource SheetStore.EnterGlassSheetInventoryDetails}"
                       FontSize="{StaticResource TextBody}" Margin="0,4,0,0"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
        </StackPanel>

        <!-- Form (smooth scroll) -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      IsDeferredScrollingEnabled="False"
                      PanningMode="None"
                      Focusable="True"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">
            <StackPanel>

                <TextBlock Text="{DynamicResource SheetStore.Category}" Style="{StaticResource LabelStyle}"/>
                <TextBox Style="{StaticResource InputStyle}"
                         Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{DynamicResource SheetStore.EGClearFloatGuardianClimaguard70}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource SheetStore.ThicknessMm}" Style="{StaticResource LabelStyle}"/>
                        <ComboBox Style="{StaticResource ComboStyle}"
                                  Text="{Binding ThicknessMm, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/>
                            <ComboBoxItem Content="6"/>
                            <ComboBoxItem Content="8"/>
                            <ComboBoxItem Content="10"/>
                            <ComboBoxItem Content="12"/>
                            <ComboBoxItem Content="15"/>
                            <ComboBoxItem Content="19"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource ProformaInvoice.Color}" Style="{StaticResource LabelStyle}"/>
                        <ComboBox Style="{StaticResource ComboStyle}"
                                  Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content="{DynamicResource Action.Clear}"/>
                            <ComboBoxItem Content="{DynamicResource SheetStore.HDGrey}"/>
                            <ComboBoxItem Content="{DynamicResource SheetStore.Bronze}"/>
                            <ComboBoxItem Content="{DynamicResource SheetStore.Green}"/>
                            <ComboBoxItem Content="{DynamicResource SheetStore.Blue}"/>
                            <ComboBoxItem Content="{DynamicResource SheetStore.Silver}"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource SheetStore.WidthMm}" Style="{StaticResource LabelStyle}"/>
                        <TextBox Style="{StaticResource IntInputStyle}"
                                 Text="{Binding WidthMm, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource SheetStore.HeightMm}" Style="{StaticResource LabelStyle}"/>
                        <TextBox Style="{StaticResource IntInputStyle}"
                                 Text="{Binding HeightMm, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{DynamicResource SheetStore.Supplier}" Style="{StaticResource LabelStyle}"/>
                <TextBox Style="{StaticResource InputStyle}"
                         Text="{Binding Supplier, UpdateSourceTrigger=PropertyChanged}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource SheetStore.PurchasePriceSQM}" Style="{StaticResource LabelStyle}"/>
                        <TextBox Style="{StaticResource DecimalInputStyle}"
                                 Text="{Binding PurchasePricePerSqm, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.##}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource SheetStore.SELLPriceSQM}" Style="{StaticResource LabelStyle}"/>
                        <TextBox Style="{StaticResource DecimalInputStyle}"
                                 Text="{Binding SellPricePerSqm, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.##}}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{DynamicResource SheetStore.StockQuantity}" Style="{StaticResource LabelStyle}"/>
                <TextBox Style="{StaticResource IntInputStyle}"
                         Text="{Binding Stock, UpdateSourceTrigger=PropertyChanged}"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Error message — palette-aligned crimson -->
        <Border Grid.Row="2"
                Background="{DynamicResource TintRedBrush}"
                BorderBrush="{DynamicResource DangerBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                Padding="14,12"
                Margin="0,16,0,0"
                SnapsToDevicePixels="True"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                           FontSize="{StaticResource TextSection}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource DangerBrush}"
                           VerticalAlignment="Top"
                           Margin="0,0,10,0"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="{StaticResource TextBody}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Style="{StaticResource OutlinedPillButton}"
                    Tag="&#xE711;" Content="{DynamicResource Action.Cancel}"
                    Margin="0,0,12,0"
                    ToolTip="{DynamicResource SheetStore.DiscardChangesClose}"
                    Command="{Binding CancelCommand}"/>
            <Button Style="{StaticResource PrimaryPillButton}"
                    Tag="&#xE74E;" Content="{Binding SaveButtonText}"
                    ToolTip="{DynamicResource SheetStore.SaveSheet}"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>