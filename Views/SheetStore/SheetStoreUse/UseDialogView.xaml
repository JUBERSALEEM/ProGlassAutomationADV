<!-- ═══════════════════════════════════════════════════════════════
     MIGRATION LOG — Button Standardization (master prompt v1.0)
     Date: 2026-08-15 — SheetStore module batch
     • All buttons -> centralized PrimaryPill/SuccessPill/OutlinedPill/
       DangerButton styles with MDL2 Tag glyphs + UPPERCASE content
     • Removed legacy local styles (ActionBtn, HeaderActionBtn,
       QtyButtonStyle, Cancel/Save/ConfirmButtonStyle,
       FilterActionButtonStyle, CancelImportBtn)
     • Decorative emojis (search/clock/empty/mailbox) -> MDL2 glyphs
     Commands/bindings preserved; no ViewModel changes.
═══════════════════════════════════════════════════════════════ -->
<dialogs:ThemedDialogWindow x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreUse.UseDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:dialogs="clr-namespace:ProGlassAutomation.Views.Shared.Dialogs"
             Title="{DynamicResource SheetStore.USEStock}"
             Width="520"
             DialogIcon="&#xE713;"
             DialogSubtitle="{DynamicResource SheetStore.ConsumeSheetsInventoryProduction}"
             FontFamily="{DynamicResource AppFontFamily}">

    <!-- 2026-09 dialog audit: chrome (card/header/footer) comes from
         ThemedDialogWindow; this file keeps only the form body. -->
    <StackPanel>

            <!-- Sheet info card -->
            <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Background="{DynamicResource DialogInsetBrush}"
                    CornerRadius="{DynamicResource ControlCornerRadius}" Padding="16,12" Margin="0,0,0,16" Style="{StaticResource SurfacePrimaryStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding Sheet.Category}" FontSize="{DynamicResource FontSize.H2}" FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding Sheet.ThicknessDisplay}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Sheet.Color}" FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Sheet.SizeDisplay}" FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{DynamicResource SheetStore.Available}" FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding Sheet.Balance}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock Text="{DynamicResource SheetStore.Sheets}" FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding Sheet.TotalSqmBalance, Converter={StaticResource CurrencyConverter}}"
                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text=" SQM" FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Job Order Reference -->
            <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Background="{DynamicResource DialogInsetBrush}"
                    CornerRadius="{DynamicResource CardCornerRadius}" Padding="20,16" Margin="0,0,0,16" Style="{StaticResource SurfacePrimaryStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SheetStore.JOBOrderReferenceOptional}" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,6"/>
                    <TextBox behaviors:TextBoxBehaviors.SelectAllOnFocus="True" Text="{Binding JobOrderReference, UpdateSourceTrigger=PropertyChanged}"
                             Height="40" FontSize="{DynamicResource FontSize.Title}" Padding="12,6"
                             VerticalContentAlignment="Center"
                             Background="{DynamicResource DialogInsetBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource SurfaceTertiaryBrush}"
                             ToolTip="{DynamicResource SheetStore.EGJO2025001CustomerName}"/>
                    <TextBlock Text="{DynamicResource SheetStore.TrackWhichJobOrderCustomerConsumingSheets}"
                               FontSize="{DynamicResource FontSize.BodySmall}" FontStyle="Italic" Margin="4,4,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                    <!--
                        CONSUMPTION TRACEABILITY.
                        Pre-filled from the invoice being worked on, but
                        editable: stock is also issued for samples and
                        remakes that have no live document. These land on
                        the history row so a Sheet Store report can answer
                        "which salesman's customer's project consumed how
                        many sheets".
                    -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{DynamicResource SheetStore.Customer}"
                                   FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="{DynamicResource SheetStore.Project}"
                                   FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,4"/>

                        <TextBox behaviors:TextBoxBehaviors.SelectAllOnFocus="True" Grid.Row="1" Grid.Column="0"
                                 Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="40" Padding="10,4" VerticalContentAlignment="Center"
                                 Background="{DynamicResource DialogInsetBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderThickness="1" BorderBrush="{DynamicResource SurfaceTertiaryBrush}"/>
                        <TextBox behaviors:TextBoxBehaviors.SelectAllOnFocus="True" Grid.Row="1" Grid.Column="2"
                                 Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="40" Padding="10,4" VerticalContentAlignment="Center"
                                 Background="{DynamicResource DialogInsetBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderThickness="1" BorderBrush="{DynamicResource SurfaceTertiaryBrush}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="{DynamicResource SheetStore.Salesman}"
                                   FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,10,0,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="2"
                                   Text="{DynamicResource SheetStore.Pane}"
                                   FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,10,0,4"/>

                        <TextBox behaviors:TextBoxBehaviors.SelectAllOnFocus="True" Grid.Row="3" Grid.Column="0"
                                 Text="{Binding Salesman, UpdateSourceTrigger=PropertyChanged}"
                                 Height="40" Padding="10,4" VerticalContentAlignment="Center"
                                 Background="{DynamicResource DialogInsetBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderThickness="1" BorderBrush="{DynamicResource SurfaceTertiaryBrush}"/>
                        <ComboBox Grid.Row="3" Grid.Column="2"
                                  Text="{Binding PanePosition, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource ModernEditableComboBoxStyle}"
                                  behaviors:EditableComboBoxTypingBehavior.IsEnabled="True"
                                  Height="40" MinHeight="40"
                                  Padding="12,0"
                                  MaxDropDownHeight="320">
                            <ComboBoxItem Content="Outer"/>
                            <ComboBoxItem Content="Inner"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Quantity selector -->
            <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Background="{DynamicResource DialogInsetBrush}"
                    CornerRadius="{DynamicResource CardCornerRadius}" Padding="20,16" Margin="0,0,0,16" Style="{StaticResource SurfacePrimaryStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SheetStore.QuantityUSESheets}" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource OutlinedPillButton}"
                                Content="−" MinWidth="50"
                                ToolTip="{DynamicResource SheetStore.DecreaseQuantity}"
                                Command="{Binding DecreaseCommand}"/>
                        <!-- Raw text binding: an int binding cannot observe
                             an empty box (conversion fails, setter never
                             runs). AcceptIntegersOnly was also missing here,
                             so letters reached the field. -->
                        <TextBox Grid.Column="1"
                                 Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:TextBoxBehaviors.SelectAllOnFocus="True"
                                 behaviors:TextBoxBehaviors.AcceptIntegersOnly="True"
                                 FontSize="{DynamicResource FontSize.Display}" FontWeight="{DynamicResource Weight.Bold}" TextAlignment="Center"
                                 VerticalContentAlignment="Center" Height="44"
                                 Background="{DynamicResource DialogInsetBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Margin="8,0">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasQuantityError}" Value="True">
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Grid.Column="2" Style="{StaticResource OutlinedPillButton}"
                                Content="+" MinWidth="50"
                                ToolTip="{DynamicResource SheetStore.IncreaseQuantity}"
                                Command="{Binding IncreaseCommand}"/>
                    </Grid>

                    <!-- Inline field error, attached to the offending box. -->
                    <TextBlock Text="{Binding QuantityError}"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="{DynamicResource FontSize.BodySmall}"
                               FontWeight="{DynamicResource Weight.SemiBold}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="{Binding HasQuantityError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Border>

            <!-- Preview -->
            <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Background="{DynamicResource DialogInsetBrush}"
                    CornerRadius="{DynamicResource CardCornerRadius}" Padding="20,16" Margin="0,0,0,16" Style="{StaticResource SurfacePrimaryStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SheetStore.UsagePreview}" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,10"/>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource SheetStore.SQMUsed}" FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding TotalSqm, Converter={StaticResource CurrencyConverter}}"
                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource SheetStore.RemainingBalance}" FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding RemainingBalance}"
                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Separator Opacity="0.3" Margin="0,6"/>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="{DynamicResource SheetStore.ValueConsumed}" FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.SemiBold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding TotalValue, Converter={StaticResource CurrencyConverter}, ConverterParameter=suffix}"
                                   FontSize="{DynamicResource FontSize.H2}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Error -->
            <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Background="{DynamicResource TintRedBrush}" CornerRadius="{DynamicResource ControlCornerRadius}"
                    Padding="12,8" Margin="0,0,0,10"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource SurfacePrimaryStyle}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="{DynamicResource FontSize.Body}"/>
            </Border>

            <!-- Buttons -->
                </StackPanel>

    <dialogs:ThemedDialogWindow.FooterContent>
<Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource OutlinedPillButton}"
                        Tag="&#xE711;" Content="{DynamicResource Action.Cancel}"
                        ToolTip="{DynamicResource SheetStore.CloseWithoutUsingStock}"
                        Command="{Binding CancelCommand}"/>
                <Button Grid.Column="2" Style="{StaticResource SuccessPillButton}"
                        Tag="&#xE73E;" Content="{DynamicResource SheetStore.ConfirmUSE}"
                        ToolTip="{DynamicResource SheetStore.ConfirmStockUsage}"
                        Command="{Binding ConfirmCommand}"/>
            </Grid>
    </dialogs:ThemedDialogWindow.FooterContent>
</dialogs:ThemedDialogWindow>
