<Window x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreUse.UseDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Use Stock"
        Width="480" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="{DynamicResource WindowBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">

            <!-- Header -->
            <StackPanel Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔧" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock Text="USE STOCK" FontSize="22" FontWeight="Bold" Margin="12,0,0,0"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                </StackPanel>
                <TextBlock Text="Consume sheets from inventory for production"
                           FontSize="12" Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </StackPanel>

            <!-- Sheet info card -->
            <Border Background="{DynamicResource MenuHoverBrush}"
                    CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding Sheet.Category}" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding Sheet.ThicknessDisplay}" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Sheet.Color}" FontSize="12"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Sheet.SizeDisplay}" FontSize="12"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Available: " FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding Sheet.Balance}" FontSize="11" FontWeight="Bold"
                                   Foreground="#F59E0B"/>
                        <TextBlock Text=" sheets  •  " FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding Sheet.TotalSqmBalance, StringFormat={}{0:N2}}"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text=" SQM" FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Quantity selector -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    CornerRadius="12" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="QUANTITY TO USE (sheets)" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="−" FontSize="22" FontWeight="Bold"
                                Height="44" Background="#EF4444" Foreground="White"
                                BorderThickness="0" Cursor="Hand"
                                Command="{Binding DecreaseCommand}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="28" FontWeight="Bold" TextAlignment="Center"
                                 VerticalContentAlignment="Center" Height="44"
                                 Background="{DynamicResource MenuHoverBrush}"
                                 Foreground="{DynamicResource PrimaryForegroundBrush}"
                                 BorderThickness="0" Margin="8,0"/>
                        <Button Grid.Column="2" Content="+" FontSize="22" FontWeight="Bold"
                                Height="44" Background="#10B981" Foreground="White"
                                BorderThickness="0" Cursor="Hand"
                                Command="{Binding IncreaseCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Preview -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    CornerRadius="12" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="USAGE PREVIEW" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,10"/>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="SQM being used" FontSize="12"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding TotalSqm, StringFormat={}{0:N2}}"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Remaining balance" FontSize="12"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding RemainingBalance}"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="#F59E0B" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Separator Opacity="0.3" Margin="0,6"/>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="Value consumed" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="{Binding TotalValue, StringFormat={}{0:N2} AED}"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#3B82F6" HorizontalAlignment="Right"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Error -->
            <Border Background="#FEE2E2" CornerRadius="8"
                    Padding="12,8" Margin="0,0,0,10"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" FontSize="12"/>
            </Border>

            <!-- Buttons -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Height="42"
                        Background="{DynamicResource MenuHoverBrush}"
                        Foreground="{DynamicResource PrimaryForegroundBrush}"
                        BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="14"
                        Command="{Binding CancelCommand}"/>
                <Button Grid.Column="2" Content="✓ Confirm Use" Height="42"
                        Background="#3B82F6" Foreground="White"
                        BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="14"
                        Command="{Binding ConfirmCommand}"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Window>