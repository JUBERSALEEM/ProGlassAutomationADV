<!-- ═══════════════════════════════════════════════════════════════
     SHEET STORE — Consume / Use Stock Dialog
     Bento Design System: Clean metric cards, consumption trace
     fieldsets, balance preview, and standardized 36px action buttons.
═══════════════════════════════════════════════════════════════ -->
<dialogs:ThemedDialogWindow x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreUse.UseDialogView"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
                            xmlns:dialogs="clr-namespace:ProGlassAutomation.Views.Shared.Dialogs"
                            Title="{DynamicResource SheetStore.USEStock}"
                            Width="540"
                            DialogIcon="&#xE713;"
                            DialogSubtitle="{DynamicResource SheetStore.ConsumeSheetsInventoryProduction}"
                            FontFamily="{DynamicResource AppFontFamily}">

    <dialogs:ThemedDialogWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Dashboard/Overview/IndigoStudioResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </dialogs:ThemedDialogWindow.Resources>

    <StackPanel>
        <!-- 1. Sheet Info Bento Card -->
        <Border Style="{StaticResource Ov.CardCompact}" Margin="0,0,0,12" Background="{DynamicResource Ov.Soft}">
            <StackPanel>
                <TextBlock Text="{Binding Sheet.Category}" Style="{StaticResource Ov.CardTitle}"
                           Foreground="{DynamicResource Ov.Accent}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding Sheet.ThicknessDisplay}" Style="{StaticResource Ov.Meta}" FontWeight="{DynamicResource Weight.Bold}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Sheet.Color}" Style="{StaticResource Ov.Meta}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Sheet.SizeDisplay}" Style="{StaticResource Ov.Meta}"/>
                </StackPanel>

                <!-- Inner tint groups (zero concentric card styles) -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource Ov.WarningSoft}" CornerRadius="8" Padding="10,8" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SheetStore.Available}" Style="{StaticResource Ov.Meta}" Foreground="{DynamicResource Ov.Warning}"/>
                            <TextBlock Text="{Binding Sheet.Balance, StringFormat={}{0} Sheets}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.Warning}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{DynamicResource Ov.Surface}" CornerRadius="8" Padding="10,8" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Total Area Available" Style="{StaticResource Ov.Meta}"/>
                            <TextBlock Text="{Binding Sheet.TotalSqmBalance, StringFormat={}{0:N2} m²}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 2. Consumption Traceability Bento Card -->
        <Border Style="{StaticResource Ov.CardCompact}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{DynamicResource SheetStore.JOBOrderReferenceOptional}" Style="{StaticResource Ov.Meta}" FontWeight="{DynamicResource Weight.Bold}" Margin="0,0,0,6"/>
                <TextBox behaviors:TextBoxBehaviors.SelectAllOnFocus="True"
                         Text="{Binding JobOrderReference, UpdateSourceTrigger=PropertyChanged}"
                         Height="34" Padding="10,0"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource Ov.Soft}"
                         Foreground="{DynamicResource Ov.Ink}"
                         BorderThickness="0"
                         ToolTip="{DynamicResource SheetStore.EGJO2025001CustomerName}"/>
                <TextBlock Text="{DynamicResource SheetStore.TrackWhichJobOrderCustomerConsumingSheets}"
                           Style="{StaticResource Ov.Meta}" FontStyle="Italic" Margin="2,4,0,10"/>

                <!-- 2-column Trace Details -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource SheetStore.Customer}" Style="{StaticResource Ov.Meta}" Margin="2,0,0,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource SheetStore.Project}" Style="{StaticResource Ov.Meta}" Margin="2,0,0,4"/>

                    <TextBox Grid.Row="1" Grid.Column="0" behaviors:TextBoxBehaviors.SelectAllOnFocus="True"
                             Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                             Height="34" Padding="10,0" VerticalContentAlignment="Center"
                             Background="{DynamicResource Ov.Soft}" BorderThickness="0"/>
                    <TextBox Grid.Row="1" Grid.Column="2" behaviors:TextBoxBehaviors.SelectAllOnFocus="True"
                             Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                             Height="34" Padding="10,0" VerticalContentAlignment="Center"
                             Background="{DynamicResource Ov.Soft}" BorderThickness="0"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource SheetStore.Salesman}" Style="{StaticResource Ov.Meta}" Margin="2,8,0,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{DynamicResource SheetStore.Pane}" Style="{StaticResource Ov.Meta}" Margin="2,8,0,4"/>

                    <TextBox Grid.Row="3" Grid.Column="0" behaviors:TextBoxBehaviors.SelectAllOnFocus="True"
                             Text="{Binding Salesman, UpdateSourceTrigger=PropertyChanged}"
                             Height="34" Padding="10,0" VerticalContentAlignment="Center"
                             Background="{DynamicResource Ov.Soft}" BorderThickness="0"/>
                    <ComboBox Grid.Row="3" Grid.Column="2"
                              Text="{Binding PanePosition, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource ModernEditableComboBoxStyle}"
                              behaviors:EditableComboBoxTypingBehavior.IsEnabled="True"
                              Height="34" MaxDropDownHeight="320">
                        <ComboBoxItem Content="Outer"/>
                        <ComboBoxItem Content="Inner"/>
                    </ComboBox>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. Quantity Selector Bento Card -->
        <Border Style="{StaticResource Ov.CardCompact}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{DynamicResource SheetStore.QuantityUSESheets}"
                           Style="{StaticResource Ov.Meta}" FontWeight="{DynamicResource Weight.Bold}"
                           Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="54"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource OutlinedPillButton}"
                            Height="44" Padding="0" Content="−" FontSize="18"
                            ToolTip="{DynamicResource SheetStore.DecreaseQuantity}"
                            Command="{Binding DecreaseCommand}"/>

                    <TextBox Grid.Column="1"
                             Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                             behaviors:TextBoxBehaviors.SelectAllOnFocus="True"
                             behaviors:TextBoxBehaviors.AcceptIntegersOnly="True"
                             FontSize="22" FontWeight="{DynamicResource Weight.Bold}" TextAlignment="Center"
                             VerticalContentAlignment="Center" Height="44"
                             Background="{DynamicResource Ov.Soft}"
                             Foreground="{DynamicResource Ov.Ink}"
                             Margin="8,0">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasQuantityError}" Value="True">
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Ov.Danger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Button Grid.Column="2" Style="{StaticResource OutlinedPillButton}"
                            Height="44" Padding="0" Content="+" FontSize="18"
                            ToolTip="{DynamicResource SheetStore.IncreaseQuantity}"
                            Command="{Binding IncreaseCommand}"/>
                </Grid>

                <TextBlock Text="{Binding QuantityError}"
                           Foreground="{DynamicResource Ov.Danger}"
                           FontSize="{DynamicResource FontSize.BodySmall}"
                           FontWeight="{DynamicResource Weight.SemiBold}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           Visibility="{Binding HasQuantityError, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <!-- 4. Usage Preview Bento Card -->
        <Border Style="{StaticResource Ov.CardCompact}" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="{DynamicResource SheetStore.UsagePreview}"
                           Style="{StaticResource Ov.Meta}" FontWeight="{DynamicResource Weight.Bold}"
                           Margin="0,0,0,10"/>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="{DynamicResource SheetStore.SQMUsed}" Style="{StaticResource Ov.Meta}"/>
                    <TextBlock Text="{Binding TotalSqm, Converter={StaticResource CurrencyConverter}, ConverterParameter=area}"
                               Style="{StaticResource Ov.Meta}" FontWeight="{DynamicResource Weight.Bold}"
                               HorizontalAlignment="Right"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="{DynamicResource SheetStore.RemainingBalance}" Style="{StaticResource Ov.Meta}"/>
                    <TextBlock Text="{Binding RemainingBalance, StringFormat={}{0} Sheets}"
                               Style="{StaticResource Ov.Meta}" FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource Ov.Warning}" HorizontalAlignment="Right"/>
                </DockPanel>
                <Border Height="1" Background="{DynamicResource Ov.Line}" Margin="0,2,0,10"/>
                <DockPanel>
                    <TextBlock Text="{DynamicResource SheetStore.ValueConsumed}"
                               Style="{StaticResource Ov.CardTitle}" VerticalAlignment="Center"/>
                    <Viewbox MaxHeight="28" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding TotalValue, Converter={StaticResource CurrencyConverter}, ConverterParameter=suffix}"
                                   Style="{StaticResource Ov.Value}"
                                   Foreground="{DynamicResource Ov.Accent}"/>
                    </Viewbox>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Error Banner -->
        <Border Background="{DynamicResource Ov.DangerSoft}"
                BorderBrush="{DynamicResource Ov.Danger}"
                BorderThickness="1" CornerRadius="8"
                Padding="12,8" Margin="0,0,0,8"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Ov.Danger}" Style="{StaticResource Ov.Meta}"/>
        </Border>
    </StackPanel>

    <!-- Standardized 36px Footer Action Buttons -->
    <dialogs:ThemedDialogWindow.FooterContent>
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource OutlinedPillButton}"
                    Height="36" Padding="16,0"
                    Tag="&#xE711;" Content="{DynamicResource Action.Cancel}"
                    ToolTip="{DynamicResource SheetStore.CloseWithoutUsingStock}"
                    Command="{Binding CancelCommand}"/>
            <Button Grid.Column="2" Style="{StaticResource SuccessPillButton}"
                    Height="36" Padding="16,0"
                    Tag="&#xE73E;" Content="{DynamicResource SheetStore.ConfirmUSE}"
                    ToolTip="{DynamicResource SheetStore.ConfirmStockUsage}"
                    Command="{Binding ConfirmCommand}"/>
        </Grid>
    </dialogs:ThemedDialogWindow.FooterContent>
</dialogs:ThemedDialogWindow>
