<!-- ═══════════════════════════════════════════════════════════════
     MIGRATION LOG — Button Standardization (master prompt v1.0)
     Date: 2026-08-15 — SheetStore module batch
     • All buttons -> centralized PrimaryPill/SuccessPill/OutlinedPill/
       DangerButton styles with MDL2 Tag glyphs + UPPERCASE content
     • Removed legacy local styles (ActionBtn, HeaderActionBtn,
       QtyButtonStyle, Cancel/Save/ConfirmButtonStyle,
       FilterActionButtonStyle, CancelImportBtn)
     • Decorative emojis (search/clock/empty/mailbox) -> MDL2 glyphs
     Commands/bindings preserved; no ViewModel changes.
═══════════════════════════════════════════════════════════════ -->
<Window x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreUse.UseDialogView"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SheetStore.USEStock}"
        Width="480" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource WindowBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">

            <!-- Header -->
            <StackPanel Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextDisplay}" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource SheetStore.USEStock}" FontSize="{StaticResource TextHeadline}" FontWeight="Bold" Margin="12,0,0,0"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                </StackPanel>
                <TextBlock Text="{DynamicResource SheetStore.ConsumeSheetsInventoryProduction}"
                           FontSize="{StaticResource TextBody}" Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </StackPanel>

            <!-- Sheet info card -->
            <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Background="{DynamicResource MenuHoverBrush}"
                    CornerRadius="{DynamicResource ControlCornerRadius}" Padding="16,12" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding Sheet.Category}" FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding Sheet.ThicknessDisplay}" FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Sheet.Color}" FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Sheet.SizeDisplay}" FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{DynamicResource SheetStore.Available}" FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding Sheet.Balance}" FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock Text="{DynamicResource SheetStore.Sheets}" FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding Sheet.TotalSqmBalance, Converter={StaticResource CurrencyConverter}}"
                                   FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text=" SQM" FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Job Order Reference -->
            <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Background="{DynamicResource ModuleBackgroundBrush}"
                    CornerRadius="{DynamicResource CardCornerRadius}" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SheetStore.JOBOrderReferenceOptional}" FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding JobOrderReference, UpdateSourceTrigger=PropertyChanged}"
                             Height="36" FontSize="{StaticResource TextBodyLarge}" Padding="12,6"
                             VerticalContentAlignment="Center"
                             Background="{DynamicResource MenuHoverBrush}"
                             Foreground="{DynamicResource PrimaryForegroundBrush}"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource MenuHoverBrush}"
                             ToolTip="{DynamicResource SheetStore.EGJO2025001CustomerName}"/>
                    <TextBlock Text="{DynamicResource SheetStore.TrackWhichJobOrderCustomerConsumingSheets}"
                               FontSize="{StaticResource TextCaption}" FontStyle="Italic" Margin="4,4,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>
            </Border>

            <!-- Quantity selector -->
            <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Background="{DynamicResource ModuleBackgroundBrush}"
                    CornerRadius="{DynamicResource CardCornerRadius}" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SheetStore.QuantityUSESheets}" FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource OutlinedPillButton}"
                                Content="−" MinWidth="50"
                                ToolTip="{DynamicResource SheetStore.DecreaseQuantity}"
                                Command="{Binding DecreaseCommand}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="{StaticResource TextDisplayLarge}" FontWeight="Bold" TextAlignment="Center"
                                 VerticalContentAlignment="Center" Height="44"
                                 Background="{DynamicResource MenuHoverBrush}"
                                 Foreground="{DynamicResource PrimaryForegroundBrush}"
                                 BorderThickness="0" Margin="8,0"/>
                        <Button Grid.Column="2" Style="{StaticResource OutlinedPillButton}"
                                Content="+" MinWidth="50"
                                ToolTip="{DynamicResource SheetStore.IncreaseQuantity}"
                                Command="{Binding IncreaseCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Preview -->
            <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Background="{DynamicResource ModuleBackgroundBrush}"
                    CornerRadius="{DynamicResource CardCornerRadius}" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SheetStore.UsagePreview}" FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,10"/>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource SheetStore.SQMUsed}" FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding TotalSqm, Converter={StaticResource CurrencyConverter}}"
                                   FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource SheetStore.RemainingBalance}" FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding RemainingBalance}"
                                   FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Separator Opacity="0.3" Margin="0,6"/>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="{DynamicResource SheetStore.ValueConsumed}" FontSize="{StaticResource TextSection}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="{Binding TotalValue, Converter={StaticResource CurrencyConverter}, ConverterParameter=suffix}"
                                   FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Error -->
            <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Background="{DynamicResource TintRedBrush}" CornerRadius="{DynamicResource ControlCornerRadius}"
                    Padding="12,8" Margin="0,0,0,10"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource TextBody}"/>
            </Border>

            <!-- Buttons -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource OutlinedPillButton}"
                        Tag="&#xE711;" Content="{DynamicResource Action.Cancel}"
                        ToolTip="{DynamicResource SheetStore.CloseWithoutUsingStock}"
                        Command="{Binding CancelCommand}"/>
                <Button Grid.Column="2" Style="{StaticResource SuccessPillButton}"
                        Tag="&#xE73E;" Content="{DynamicResource SheetStore.ConfirmUSE}"
                        ToolTip="{DynamicResource SheetStore.ConfirmStockUsage}"
                        Command="{Binding ConfirmCommand}"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Window>