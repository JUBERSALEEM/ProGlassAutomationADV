<!-- ═══════════════════════════════════════════════════════════════
     USE STOCK DIALOG — Indigo Studio Bento Redesign
     Clean Bento fieldsets, traceability cards, standardized 36px controls.
═══════════════════════════════════════════════════════════════ -->
<dialogs:ThemedDialogWindow x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreUse.UseDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:dialogs="clr-namespace:ProGlassAutomation.Views.Shared.Dialogs"
             Title="{DynamicResource SheetStore.USEStock}"
             Width="540"
             DialogIcon="&#xE713;"
             DialogSubtitle="{DynamicResource SheetStore.ConsumeSheetsInventoryProduction}"
             FontFamily="{DynamicResource AppFontFamily}">

    <StackPanel>
        <!-- Card 1: Sheet Identity & Available Balance -->
        <Border Style="{StaticResource Ov.CardCompact}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{Binding Sheet.Category}"
                           Style="{StaticResource Ov.CardTitle}"
                           Foreground="{DynamicResource AccentBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding Sheet.ThicknessDisplay}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Sheet.Color}" FontSize="{DynamicResource FontSize.Body}"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Sheet.SizeDisplay}" FontSize="{DynamicResource FontSize.Body}"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource Ov.WarningSoft}" CornerRadius="8" Padding="8,6" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SheetStore.Available}" Style="{StaticResource Ov.Meta}" Foreground="{DynamicResource WarningBrush}"/>
                            <TextBlock Text="{Binding Sheet.Balance, StringFormat={}{0} Sheets}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource WarningBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource Ov.Soft}" CornerRadius="8" Padding="8,6" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Total Area Available" Style="{StaticResource Ov.Meta}"/>
                            <TextBlock Text="{Binding Sheet.TotalSqmBalance, StringFormat={}{0:N2} SQM}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Card 2: Job Order Allocation & Traceability -->
        <Border Style="{StaticResource Ov.CardCompact}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{DynamicResource SheetStore.JOBOrderReferenceOptional}"
                           Style="{StaticResource Ov.Meta}" FontWeight="{DynamicResource Weight.Bold}"
                           Margin="0,0,0,4"/>
                <TextBox behaviors:TextBoxBehaviors.SelectAllOnFocus="True"
                         Text="{Binding JobOrderReference, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="36" FontSize="{DynamicResource FontSize.Body}" Padding="10,6"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource Ov.Soft}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderThickness="0"
                         ToolTip="{DynamicResource SheetStore.EGJO2025001CustomerName}"/>

                <!-- 2-Column Traceability Grid -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource SheetStore.Customer}"
                               Style="{StaticResource Ov.Meta}" Margin="0,0,0,3"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource SheetStore.Project}"
                               Style="{StaticResource Ov.Meta}" Margin="0,0,0,3"/>

                    <TextBox Grid.Row="1" Grid.Column="0" behaviors:TextBoxBehaviors.SelectAllOnFocus="True"
                             Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="34" Padding="8,4" VerticalContentAlignment="Center"
                             Background="{DynamicResource Ov.Soft}" BorderThickness="0"/>
                    <TextBox Grid.Row="1" Grid.Column="2" behaviors:TextBoxBehaviors.SelectAllOnFocus="True"
                             Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="34" Padding="8,4" VerticalContentAlignment="Center"
                             Background="{DynamicResource Ov.Soft}" BorderThickness="0"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource SheetStore.Salesman}"
                               Style="{StaticResource Ov.Meta}" Margin="0,8,0,3"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{DynamicResource SheetStore.Pane}"
                               Style="{StaticResource Ov.Meta}" Margin="0,8,0,3"/>

                    <TextBox Grid.Row="3" Grid.Column="0" behaviors:TextBoxBehaviors.SelectAllOnFocus="True"
                             Text="{Binding Salesman, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="34" Padding="8,4" VerticalContentAlignment="Center"
                             Background="{DynamicResource Ov.Soft}" BorderThickness="0"/>
                    <ComboBox Grid.Row="3" Grid.Column="2"
                              Text="{Binding PanePosition, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource ModernEditableComboBoxStyle}"
                              behaviors:EditableComboBoxTypingBehavior.IsEnabled="True"
                              MaxDropDownHeight="320">
                        <ComboBoxItem Content="Outer"/>
                        <ComboBoxItem Content="Inner"/>
                    </ComboBox>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Card 3: Quantity Selector -->
        <Border Style="{StaticResource Ov.CardCompact}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{DynamicResource SheetStore.QuantityUSESheets}"
                           Style="{StaticResource Ov.Meta}" FontWeight="{DynamicResource Weight.Bold}"
                           Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource OutlinedPillButton}"
                            Height="40" Content="−" FontSize="18"
                            ToolTip="{DynamicResource SheetStore.DecreaseQuantity}"
                            Command="{Binding DecreaseCommand}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                             behaviors:TextBoxBehaviors.SelectAllOnFocus="True"
                             behaviors:TextBoxBehaviors.AcceptIntegersOnly="True"
                             FontSize="{DynamicResource FontSize.Display}" FontWeight="{DynamicResource Weight.Bold}" TextAlignment="Center"
                             VerticalContentAlignment="Center" Height="40"
                             Background="{DynamicResource Ov.Soft}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderThickness="0"
                             Margin="8,0">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasQuantityError}" Value="True">
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Button Grid.Column="2" Style="{StaticResource OutlinedPillButton}"
                            Height="40" Content="+" FontSize="18"
                            ToolTip="{DynamicResource SheetStore.IncreaseQuantity}"
                            Command="{Binding IncreaseCommand}"/>
                </Grid>

                <TextBlock Text="{Binding QuantityError}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="{DynamicResource FontSize.BodySmall}"
                           FontWeight="{DynamicResource Weight.SemiBold}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"
                           Visibility="{Binding HasQuantityError, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <!-- Card 4: Consumption Impact Preview -->
        <Border Style="{StaticResource Ov.CardCompact}" Margin="0,0,0,6">
            <StackPanel>
                <TextBlock Text="{DynamicResource SheetStore.UsagePreview}"
                           Style="{StaticResource Ov.Meta}" FontWeight="{DynamicResource Weight.Bold}"
                           Margin="0,0,0,8"/>
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="{DynamicResource SheetStore.SQMUsed}" Style="{StaticResource Ov.Meta}"/>
                    <TextBlock Text="{Binding TotalSqm, Converter={StaticResource CurrencyConverter}, ConverterParameter=area}"
                               FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="{DynamicResource SheetStore.RemainingBalance}" Style="{StaticResource Ov.Meta}"/>
                    <TextBlock Text="{Binding RemainingBalance, StringFormat={}{0} Sheets}"
                               FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Right"/>
                </DockPanel>
                <Border Height="1" Background="{DynamicResource Ov.Line}" Margin="0,2,0,8"/>
                <DockPanel>
                    <TextBlock Text="{DynamicResource SheetStore.ValueConsumed}"
                               FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Viewbox MaxHeight="26" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding TotalValue, Converter={StaticResource CurrencyConverter}, ConverterParameter=suffix}"
                                   Style="{StaticResource Ov.Value}" Foreground="{DynamicResource AccentBrush}"/>
                    </Viewbox>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Error Banner -->
        <Border Background="{DynamicResource Ov.DangerSoft}" BorderBrush="{DynamicResource DangerBrush}"
                BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,6,0,0"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="{DynamicResource FontSize.Body}"/>
        </Border>
    </StackPanel>

    <dialogs:ThemedDialogWindow.FooterContent>
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource OutlinedPillButton}"
                    Height="36"
                    Tag="&#xE711;" Content="{DynamicResource Action.Cancel}"
                    ToolTip="{DynamicResource SheetStore.CloseWithoutUsingStock}"
                    Command="{Binding CancelCommand}"/>
            <Button Grid.Column="2" Style="{StaticResource SuccessPillButton}"
                    Height="36"
                    Tag="&#xE73E;" Content="{DynamicResource SheetStore.ConfirmUSE}"
                    ToolTip="{DynamicResource SheetStore.ConfirmStockUsage}"
                    Command="{Binding ConfirmCommand}"/>
        </Grid>
    </dialogs:ThemedDialogWindow.FooterContent>
</dialogs:ThemedDialogWindow>