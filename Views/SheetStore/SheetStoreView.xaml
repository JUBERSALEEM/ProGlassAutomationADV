<UserControl x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="StatBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="StatValueBig" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="StatSubLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- Action button (Buy/Use/Edit/Del) with hover + press -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header action button (Import/CSV/Excel/PDF/History) with hover -->
        <Style x:Key="HeaderActionBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Data row style with hover -->
        <Style x:Key="DataRowStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius"
                    Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ListBoxItem — strips default WPF selection padding -->
        <Style x:Key="SheetListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- ══════════════════════════════════════════════════════════════
         ROOT LAYOUT — sticky header + virtualized list
    ══════════════════════════════════════════════════════════════ -->
    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Sticky header -->
            <RowDefinition Height="*"/>
            <!-- Virtualized list -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             STICKY HEADER
        ═══════════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="24,20,24,0">

            <!-- HEADER -->
            <DockPanel Margin="8,0,8,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <!-- v2 design system: shared module title scale -->
                        <TextBlock Text="SHEET STORE"
                                   Style="{StaticResource ModulePageTitleStyle}"/>
                        <Border Background="{DynamicResource AccentBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="10,4"
                                VerticalAlignment="Center" Margin="14,6,0,0">
                            <TextBlock Text="INVENTORY" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Stock Management &amp; Pricing System"
                               Style="{StaticResource ModulePageSubtitleStyle}"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="📥 Import" Style="{StaticResource HeaderActionBtn}"
                            Background="{DynamicResource MenuHoverBrush}"
                            Foreground="{DynamicResource PrimaryForegroundBrush}"
                            ToolTip="Import sheets from CSV file"
                            Command="{Binding ImportCsvCommand}"/>
                    <Button Content="📤 CSV" Style="{StaticResource HeaderActionBtn}"
                            Background="{DynamicResource MenuHoverBrush}"
                            Foreground="{DynamicResource PrimaryForegroundBrush}"
                            ToolTip="Export current view to CSV"
                            Command="{Binding ExportCsvCommand}"/>
                    <Button Content="📊 Excel" Style="{StaticResource HeaderActionBtn}"
                            Background="{DynamicResource SuccessBrush}" Foreground="White"
                            ToolTip="Export current view to formatted Excel (.xlsx)"
                            Command="{Binding ExportExcelCommand}"/>
                    <Button Content="📄 PDF" Style="{StaticResource HeaderActionBtn}"
                            Background="{DynamicResource DangerBrush}" Foreground="White"
                            ToolTip="Generate PDF inventory report"
                            Command="{Binding ExportPdfCommand}"/>
                    <Button Content="📜 History" Style="{StaticResource HeaderActionBtn}"
                            Background="{DynamicResource MenuHoverBrush}"
                            Foreground="{DynamicResource PrimaryForegroundBrush}"
                            Command="{Binding ShowHistoryCommand}"/>
                    <Button Content="+ Add New" Style="{StaticResource HeaderActionBtn}"
                            Padding="16,0" Margin="0"
                            Background="{DynamicResource AccentBrush}" Foreground="White"
                            Command="{Binding AddCommand}"/>
                </StackPanel>
            </DockPanel>

            <!-- LAST UPDATED BAR -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10" Padding="14,8" Margin="8,0,8,12"
                    SnapsToDevicePixels="True">
                <DockPanel>
                    <TextBlock Text="🕒" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding LastUpdatedDisplay}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                </DockPanel>
            </Border>

            <!-- SELECTION INDICATOR -->
            <Border Background="{DynamicResource AccentBrush}"
                    CornerRadius="12" Padding="14,10" Margin="8,0,8,10"
                    SnapsToDevicePixels="True"
                    Visibility="{Binding IsRowSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel>
                    <TextBlock Text="🎯" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="SHOWING VALUES FOR SELECTED ROW"
                                   FontSize="10" FontWeight="Bold" Foreground="White" Opacity="0.9"/>
                        <TextBlock Text="{Binding SelectionLabel}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="✕ Clear Selection"
                            Height="30" Padding="14,0" HorizontalAlignment="Right"
                            Background="{DynamicResource OverlayButtonBackgroundBrush}"
                            Foreground="{DynamicResource OverlayButtonForegroundBrush}"
                            FontSize="11" FontWeight="SemiBold"
                            BorderThickness="0" Cursor="Hand"
                            Command="{Binding ClearSelectionCommand}"/>
                </DockPanel>
            </Border>

            <!-- STATS ROW 1 -->
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,4">
                <Border Style="{StaticResource StatBox}">
                    <StackPanel>
                        <TextBlock Text="ITEMS" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding DisplayItems}" Style="{StaticResource StatValue}"/>
                        <TextBlock Text="glass types" Style="{StaticResource StatSubLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatBox}">
                    <StackPanel>
                        <TextBlock Text="STOCK" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding DisplayStock}" Style="{StaticResource StatValue}" Foreground="{DynamicResource SuccessBrush}"/>
                        <TextBlock Text="{Binding DisplaySqmInStock, StringFormat={}{0:N2} SQM}" Style="{StaticResource StatSubLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatBox}">
                    <StackPanel>
                        <TextBlock Text="USED" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding DisplayUsed}" Style="{StaticResource StatValue}" Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="sheets consumed" Style="{StaticResource StatSubLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatBox}">
                    <StackPanel>
                        <TextBlock Text="BALANCE" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding DisplayBalance}" Style="{StaticResource StatValue}" Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock Text="{Binding DisplaySqmBalance, StringFormat={}{0:N2} SQM available}" Style="{StaticResource StatSubLabel}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- STATS ROW 2 -->
            <UniformGrid Rows="1" Columns="3" Margin="0,0,0,16">
                <Border Style="{StaticResource StatBox}" Background="{DynamicResource TintRedBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💸" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="BUYING VALUE" Margin="6,0,0,0" Style="{StaticResource StatLabel}" Foreground="{DynamicResource DangerBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DisplayBuyingValue, StringFormat={}{0:N0}}" Style="{StaticResource StatValueBig}" Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="AED (total investment)" Style="{StaticResource StatSubLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatBox}" Background="{DynamicResource TintGreenBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💰" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="SELLING VALUE" Margin="6,0,0,0" Style="{StaticResource StatLabel}" Foreground="{DynamicResource SuccessBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DisplaySellingValue, StringFormat={}{0:N0}}" Style="{StaticResource StatValueBig}" Foreground="{DynamicResource SuccessBrush}"/>
                        <TextBlock Text="AED (if all sold at current price)" Style="{StaticResource StatSubLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatBox}" Background="{DynamicResource TintBlueBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📈" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="EXPECTED PROFIT" Margin="6,0,0,0" Style="{StaticResource StatLabel}" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DisplayProfit, StringFormat={}{0:N0}}" Style="{StaticResource StatValueBig}" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="AED (Selling − Buying)" Style="{StaticResource StatSubLabel}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- FILTERS + SORT + SEARCH -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12" Padding="16,14" Margin="8,0,8,16"
                    SnapsToDevicePixels="True">
                <StackPanel>
                    <!-- Row 1: Filters + Sort -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CATEGORY" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="4,0,0,4"/>
                            <ComboBox ItemsSource="{Binding CategoryOptions}"
                                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                      Height="34" Padding="10,6" FontSize="12"
                                      Background="{DynamicResource MenuHoverBrush}"
                                      Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="THICKNESS" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="4,0,0,4"/>
                            <ComboBox ItemsSource="{Binding ThicknessOptions}"
                                      SelectedItem="{Binding SelectedThickness, Mode=TwoWay}"
                                      Height="34" Padding="10,6" FontSize="12"
                                      Background="{DynamicResource MenuHoverBrush}"
                                      Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="COLOR" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="4,0,0,4"/>
                            <ComboBox ItemsSource="{Binding ColorOptions}"
                                      SelectedItem="{Binding SelectedColor, Mode=TwoWay}"
                                      Height="34" Padding="10,6" FontSize="12"
                                      Background="{DynamicResource MenuHoverBrush}"
                                      Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="SUPPLIER" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="4,0,0,4"/>
                            <ComboBox ItemsSource="{Binding SupplierOptions}"
                                      SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                                      Height="34" Padding="10,6" FontSize="12"
                                      Background="{DynamicResource MenuHoverBrush}"
                                      Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="8">
                            <TextBlock Text="SORT BY" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="4,0,0,4"/>
                            <ComboBox ItemsSource="{Binding SortOptions}"
                                      SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                                      Height="34" Padding="10,6" FontSize="12"
                                      Background="{DynamicResource MenuHoverBrush}"
                                      Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="10" VerticalAlignment="Bottom">
                            <TextBlock Text=" " FontSize="11" Margin="0,0,0,4"/>
                            <Button Content="✕ Clear"
                                    Height="34" Padding="14,0"
                                    Background="{DynamicResource AccentBrush}" Foreground="White"
                                    BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                                    FontSize="12"
                                    Command="{Binding ClearFiltersCommand}"
                                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: Search -->
                    <Border Background="{DynamicResource MenuHoverBrush}"
                            CornerRadius="8" Padding="12,8" Margin="0,10,0,0"
                            SnapsToDevicePixels="True">
                        <DockPanel>
                            <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent"
                                     FontSize="13" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                     VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- STICKY TABLE COLUMN HEADER -->
            <Border Background="{DynamicResource AccentBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14,14,0,0" Padding="12,10" Margin="8,0,8,0"
                    SnapsToDevicePixels="True">
                    <!-- v2: header stays visible even when the list is
                         empty — users must always see the columns. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="#" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Grid.Column="1" Text="CATEGORY" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Grid.Column="2" Text="THICK" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Grid.Column="3" Text="COLOR" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Grid.Column="4" Text="SIZE" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Grid.Column="5" Text="SUPPLIER" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Grid.Column="6" Text="SQM" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="7" Text="BUY/SQM" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="8" Text="SELL/SQM" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="9" Text="TOTAL BUY" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="10" Text="TOTAL SELL" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="11" Text="STOCK" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="12" Text="USED" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="13" Text="BAL" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="14" Text="ACTIONS" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ═══════════════════════════════════════════════════════════
             VIRTUALIZED SHEET ROWS
             SmoothScrollBehavior on the ListBox for buttery scroll
             SINGLE SCROLL SURFACE — outer window doesn't scroll (fits)
        ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{DynamicResource ModuleBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,1,1"
                CornerRadius="0,0,14,14"
                Margin="32,0,32,16"
                SnapsToDevicePixels="True">
            <Grid>
                <!-- Virtualized data list -->
                <ListBox ItemsSource="{Binding Sheets}"
                         ItemContainerStyle="{StaticResource SheetListBoxItemStyle}"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="10,6,10,10"
                         Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.IsDeferredScrollingEnabled="False"
                         ScrollViewer.PanningMode="None"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingStackPanel.ScrollUnit="Item"
                         VirtualizingStackPanel.CacheLength="1,2"
                         VirtualizingStackPanel.CacheLengthUnit="Page"
                         behaviors:SmoothScrollBehavior.IsEnabled="True"
                         Visibility="{Binding HasSheets, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DataRowStyle}"
                                    MouseLeftButtonDown="Row_Click"
                                    Tag="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="12"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ThicknessDisplay}" FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Color}" FontSize="12"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding SizeDisplay}" FontSize="12"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Supplier}" FontSize="12"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="{Binding SqmPerSheet, StringFormat={}{0:N4}}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="7" Text="{Binding PurchasePricePerSqm, StringFormat={}{0:N2}}"
                                               FontSize="12" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="8" Text="{Binding SellPricePerSqm, StringFormat={}{0:N2}}"
                                               FontSize="12" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="9" Text="{Binding TotalPurchaseValue, StringFormat={}{0:N0}}"
                                               FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="10" Text="{Binding TotalSellValue, StringFormat={}{0:N0}}"
                                               FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <Border Grid.Column="11" Background="{DynamicResource TintGreenBrush}" CornerRadius="6"
                                            Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Stock}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                    </Border>
                                    <Border Grid.Column="12" Background="{DynamicResource TintRedBrush}" CornerRadius="6"
                                            Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Used}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                                    </Border>
                                    <Border Grid.Column="13" Background="{DynamicResource TintAmberBrush}" CornerRadius="6"
                                            Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Balance}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="14" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Buy" Style="{StaticResource ActionBtn}" Background="{DynamicResource SuccessBrush}"
                                                Command="{Binding DataContext.BuyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Use" Style="{StaticResource ActionBtn}" Background="{DynamicResource AccentBrush}"
                                                Command="{Binding DataContext.UseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Edit" Style="{StaticResource ActionBtn}" Background="{DynamicResource WarningBrush}"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Del" Style="{StaticResource ActionBtn}" Background="{DynamicResource DangerBrush}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty state (overlaid on list) -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                    <emptyState:EmptyStateControl
                        Icon="📦"
                        Title="No glass sheets yet"
                        Message="The Sheet Store is your raw-glass inventory — sizes, thicknesses, colours, stock and value. Click '+ Add New' to add your first glass sheet."/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>