<!-- Sheet Store — Studio Bento list, same visual contract as the
     Proforma Invoice list (SavedInvoicesListView): Sl.* hero/KPI band,
     filter card, soft table headers, virtualized rows, slide-in
     inspection rail and consumables item editor. All collections,
     commands and code-behind x:Name contracts retained. -->
<UserControl x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:layout="clr-namespace:ProGlassAutomation.Views.Dashboard"
             TextOptions.TextHintingMode="Fixed"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="{DynamicResource Ov.Canvas}"
             Foreground="{DynamicResource Ov.Ink}"
             Focusable="True">

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding ClearSelectionCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Shared/Lists/StudioListResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Action dropdown item (Sl.* popup rows) -->
            <Style x:Key="SheetMenuActionItem" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="MenuBg" Background="Transparent"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" Padding="10,7"
                                    SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{TemplateBinding Tag}"
                                               FontFamily="{DynamicResource FontFamily.Icon}"
                                               FontSize="{DynamicResource FontSize.Icon}"
                                               Foreground="{DynamicResource Ov.Accent}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBlock Text="{TemplateBinding Content}"
                                               FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                               Foreground="{DynamicResource Ov.Ink}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="MenuBg" Property="Background" Value="{DynamicResource Ov.Soft}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="MenuBg" Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- toolbar: hero + KPIs + actions + filters -->
            <RowDefinition Height="*"/>    <!-- data deck + slide-in panels -->
        </Grid.RowDefinitions>

        <!-- ══ TOOLBAR ═══════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False" Focusable="False" Margin="16,10,16,0">
            <StackPanel>
                <layout:IndigoDashboardPanel MaxColumns="3" MinimumColumnWidth="270" Gap="14">
                    <!-- Hero: expected profit -->
                    <Border Style="{StaticResource Sl.Hero}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource SheetStore.ExpectedProfit}" Style="{StaticResource Sl.Label}"
                                       TextWrapping="Wrap" Foreground="{DynamicResource Ov.OnAccent}"/>
                            <TextBlock Text="{Binding ExpectedProfit, StringFormat={}{0:N0} AED}" Style="{StaticResource Sl.Value}"
                                       TextWrapping="Wrap" Foreground="{DynamicResource Ov.OnAccent}"
                                       Typography.NumeralAlignment="Tabular"
                                       ToolTip="{Binding ExpectedProfit}"/>
                            <TextBlock Text="{DynamicResource Module.SheetStore}" Style="{StaticResource Sl.Subtitle}"
                                       TextWrapping="Wrap" Foreground="{DynamicResource Ov.OnAccentMuted}"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI band -->
                    <layout:IndigoDashboardPanel MaxColumns="3" MinimumColumnWidth="126" Gap="10">
                        <Border Style="{StaticResource Sl.Card}" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource DeliveryNote.Items}" Style="{StaticResource Sl.Label}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding TotalItems}" Style="{StaticResource Sl.Value}"
                                           Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" ToolTip="{Binding TotalItems}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Sl.Card}" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SheetStore.Stock}" Style="{StaticResource Sl.Label}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding TotalStock}" Style="{StaticResource Sl.Value}"
                                           Foreground="{DynamicResource Ov.Success}"
                                           Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" ToolTip="{Binding TotalStock}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Sl.Card}" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SheetStore.BuyingValue}" Style="{StaticResource Sl.Label}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding TotalBuyingValue, StringFormat={}{0:N0} AED}" Style="{StaticResource Sl.Value}"
                                           Foreground="{DynamicResource Ov.Danger}"
                                           Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" ToolTip="{Binding TotalBuyingValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Sl.Card}" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SheetStore.SellingValue}" Style="{StaticResource Sl.Label}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding TotalSellingValue, StringFormat={}{0:N0} AED}" Style="{StaticResource Sl.Value}"
                                           Foreground="{DynamicResource Ov.Success}"
                                           Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" ToolTip="{Binding TotalSellingValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Sl.Card}" Padding="14,10" ToolTip="{DynamicResource SheetStore.UsedValueTip}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SheetStore.UsedValue}" Style="{StaticResource Sl.Label}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding TotalUsedValue, StringFormat={}{0:N0} AED}" Style="{StaticResource Sl.Value}"
                                           Foreground="{DynamicResource Ov.Warning}"
                                           Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" ToolTip="{Binding TotalUsedValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Sl.Card}" Padding="14,10" ToolTip="{DynamicResource SheetStore.BalanceValueTip}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SheetStore.BalanceValue}" Style="{StaticResource Sl.Label}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding TotalBalanceValue, StringFormat={}{0:N0} AED}" Style="{StaticResource Sl.Value}"
                                           Foreground="{DynamicResource Ov.Accent}"
                                           Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" ToolTip="{Binding TotalBalanceValue}"/>
                            </StackPanel>
                        </Border>
                    </layout:IndigoDashboardPanel>

                    <!-- Actions card -->
                    <Border Style="{StaticResource Sl.Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Common.Actions}" Style="{StaticResource Sl.Label}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1"
                                        Background="{DynamicResource Ov.DangerSoft}"
                                        CornerRadius="{DynamicResource Radius.Small}" Padding="8,3"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasLowStock, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding LowStockCount, StringFormat={}{0} LOW}"
                                               FontSize="{DynamicResource FontSize.Caption}"
                                               FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource Ov.Danger}"/>
                                </Border>
                            </Grid>

                            <!-- View mode toggle -->
                            <WrapPanel Margin="0,8,0,0">
                                <!-- Outlined pair shows while the view is NOT active -->
                                <Button Command="{Binding ShowGlassCommand}"
                                        Tag="&#xE7B8;" Content="Glass sheets" Margin="0,0,6,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Sl.Button}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGlassView}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Command="{Binding ShowGlassCommand}"
                                        Tag="&#xE7B8;" Content="Glass sheets" Margin="0,0,6,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Sl.PrimaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGlassView}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Command="{Binding ShowConsumablesCommand}"
                                        Tag="&#xE71D;" Content="Consumables" Margin="0,0,6,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Sl.Button}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConsumablesView}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Command="{Binding ShowConsumablesCommand}"
                                        Tag="&#xE71D;" Content="Consumables" Margin="0,0,6,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Sl.PrimaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConsumablesView}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </WrapPanel>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ActionsMenuButton" Grid.Column="0"
                                        Style="{StaticResource Sl.Button}" HorizontalAlignment="Stretch"
                                        Tag="&#xE712;" Content="{DynamicResource Common.Actions}"
                                        ToolTip="{DynamicResource SheetStore.MoreActions}"
                                        behaviors:DropdownButtonBehavior.Popup="{Binding ElementName=ActionsMenuPopup}"/>
                                <Button Grid.Column="2" Style="{StaticResource Sl.PrimaryButton}" HorizontalAlignment="Stretch"
                                        Tag="&#xE710;" Content="{DynamicResource SheetStore.ADDNEW}"
                                        ToolTip="{DynamicResource SheetStore.AddNewGlassSheet}"
                                        Command="{Binding AddNewStockCommand}"/>
                            </Grid>

                            <!-- Action popup menu -->
                            <Popup x:Name="ActionsMenuPopup"
                                   PlacementTarget="{Binding ElementName=ActionsMenuButton}"
                                   Placement="Bottom"
                                   VerticalOffset="4"
                                   AllowsTransparency="True"
                                   StaysOpen="True"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource Ov.Surface}"
                                        BorderBrush="{DynamicResource Ov.Line}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Medium}"
                                        Padding="6"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="4"
                                                          Direction="270" Opacity="0.22"
                                                          Color="{DynamicResource LiquidShadowColor}"/>
                                    </Border.Effect>
                                    <StackPanel MinWidth="190">
                                        <Button Style="{StaticResource SheetMenuActionItem}"
                                                Tag="&#xE72C;" Content="{DynamicResource SheetStore.RefreshData}"
                                                Command="{Binding RefreshCommand}"
                                                behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                                        <Button Style="{StaticResource SheetMenuActionItem}"
                                                Tag="&#xE896;" Content="{DynamicResource SheetStore.ImportCSV}"
                                                Command="{Binding ImportCsvCommand}"
                                                behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                                        <Border Height="1" Margin="8,4" Background="{DynamicResource Ov.Line}"/>
                                        <Button Style="{StaticResource SheetMenuActionItem}"
                                                Tag="&#xE72D;" Content="{DynamicResource DeliveryNote.ExportCSV}"
                                                Command="{Binding ExportCsvCommand}"
                                                behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                                        <Button Style="{StaticResource SheetMenuActionItem}"
                                                Tag="&#xE9F9;" Content="{DynamicResource DeliveryNote.ExportExcel}"
                                                Command="{Binding ExportExcelCommand}"
                                                behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                                        <Button Style="{StaticResource SheetMenuActionItem}"
                                                Tag="&#xE8A5;" Content="{DynamicResource SheetStore.ExportPDFReport}"
                                                Command="{Binding ExportPdfCommand}"
                                                behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                                        <Button Style="{StaticResource SheetMenuActionItem}"
                                                Tag="&#xE72D;" Content="{DynamicResource Sharing.Share}"
                                                Command="{Binding ShareCommand}"
                                                behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                                        <Border Height="1" Margin="8,4" Background="{DynamicResource Ov.Line}"/>
                                        <Button Style="{StaticResource SheetMenuActionItem}"
                                                Tag="&#xE81C;" Content="{DynamicResource SheetStore.ShowHistory}"
                                                Command="{Binding ShowHistoryCommand}"
                                                behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Border>
                </layout:IndigoDashboardPanel>

                <!-- FILTER CARD -->
                <Border Style="{StaticResource Sl.FilterBar}" Margin="0,10,0,10">
                    <StackPanel>
                        <WrapPanel Visibility="{Binding IsGlassView, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SheetStore.Category}" Style="{StaticResource Sl.Label}" Margin="0,0,0,3"/>
                                <ComboBox Margin="0,0,8,4" Width="150"
                                          ItemsSource="{Binding CategoryOptions}"
                                          SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                          Style="{StaticResource Sl.Combo}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ProformaInvoice.Thickness}" Style="{StaticResource Sl.Label}" Margin="0,0,0,3"/>
                                <ComboBox Margin="0,0,8,4" Width="120"
                                          ItemsSource="{Binding ThicknessOptions}"
                                          SelectedItem="{Binding SelectedThickness, Mode=TwoWay}"
                                          Style="{StaticResource Sl.Combo}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ProformaInvoice.Color}" Style="{StaticResource Sl.Label}" Margin="0,0,0,3"/>
                                <ComboBox Margin="0,0,8,4" Width="140"
                                          ItemsSource="{Binding ColorOptions}"
                                          SelectedItem="{Binding SelectedColor, Mode=TwoWay}"
                                          Style="{StaticResource Sl.Combo}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SheetStore.Supplier}" Style="{StaticResource Sl.Label}" Margin="0,0,0,3"/>
                                <ComboBox Margin="0,0,8,4" Width="150"
                                          ItemsSource="{Binding SupplierOptions}"
                                          SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                                          Style="{StaticResource Sl.Combo}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource SheetStore.SORT}" Style="{StaticResource Sl.Label}" Margin="0,0,0,3"/>
                                <ComboBox Margin="0,0,8,4" Width="160"
                                          ItemsSource="{Binding SortOptions}"
                                          SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                                          Style="{StaticResource Sl.Combo}"/>
                            </StackPanel>
                            <Button Style="{StaticResource Sl.Button}" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                    Tag="&#xE711;" Content="{DynamicResource Action.Clear}"
                                    ToolTip="{DynamicResource SheetStore.ClearFilters}"
                                    MinWidth="88"
                                    Command="{Binding ClearFiltersCommand}"
                                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </WrapPanel>

                        <!-- Fast live search -->
                        <Border BorderBrush="{DynamicResource Ov.Line}" BorderThickness="1"
                                Background="{DynamicResource Ov.Soft}"
                                CornerRadius="{DynamicResource Radius.Medium}" Padding="10,7" Margin="0,4,0,0"
                                SnapsToDevicePixels="True">
                            <DockPanel>
                                <TextBlock Text="&#xE721;" FontFamily="{DynamicResource FontFamily.Icon}"
                                           FontSize="{DynamicResource FontSize.Icon}"
                                           Foreground="{DynamicResource Ov.Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                         behaviors:TextBoxBehaviors.SelectAllOnFocus="True"
                                         BorderThickness="0" Background="Transparent"
                                         FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Ov.Ink}"
                                         VerticalAlignment="Center" Style="{StaticResource TextBoxStyle}"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ══ DATA DECK ═════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!-- Animated slide panel: width 0 when closed, 376 when open -->
                <ColumnDefinition x:Name="DetailColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- ══ GLASS SHEETS LIST ══ -->
            <Grid Grid.Column="0" Visibility="{Binding IsGlassView, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Style="{StaticResource Sl.Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Sl.TableHeader}" Margin="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="0.9*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="65"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="#" Style="{StaticResource Sl.ColumnLabel}" Margin="12,0,0,0"/>
                                <TextBlock Grid.Column="1" Padding="4,0" Text="{DynamicResource SheetStore.Category}" Style="{StaticResource Sl.ColumnLabel}"/>
                                <TextBlock Grid.Column="2" Padding="4,0" Text="{DynamicResource SheetStore.Thick}" Style="{StaticResource Sl.ColumnLabel}"/>
                                <TextBlock Grid.Column="3" Padding="4,0" Text="{DynamicResource ProformaInvoice.Color}" Style="{StaticResource Sl.ColumnLabel}"/>
                                <TextBlock Grid.Column="4" Padding="4,0" Text="{DynamicResource ProformaInvoice.SIZE}" Style="{StaticResource Sl.ColumnLabel}"/>
                                <TextBlock Grid.Column="5" Padding="4,0" Text="{DynamicResource SheetStore.Supplier}" Style="{StaticResource Sl.ColumnLabel}"/>
                                <TextBlock Grid.Column="6" Padding="4,0" Text="{DynamicResource SheetStore.TotalBUY}" Style="{StaticResource Sl.ColumnLabel}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="7" Padding="4,0" Text="{DynamicResource SheetStore.TotalSELL}" Style="{StaticResource Sl.ColumnLabel}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="8" Padding="4,0" Text="{DynamicResource SheetStore.Stock}" Style="{StaticResource Sl.ColumnLabel}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="9" Padding="4,0" Text="{DynamicResource SheetStore.USED}" Style="{StaticResource Sl.ColumnLabel}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="10" Padding="4,0" Text="BAL" Style="{StaticResource Sl.ColumnLabel}" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Sheets}"
                                 ItemContainerStyle="{StaticResource Sl.ListItem}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 Focusable="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="False"
                                 ScrollViewer.IsDeferredScrollingEnabled="False"
                                 ScrollViewer.PanningMode="None"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingStackPanel.ScrollUnit="Pixel"
                                 VirtualizingStackPanel.CacheLength="200,400"
                                 VirtualizingStackPanel.CacheLengthUnit="Pixel"
                                 behaviors:SmoothScrollBehavior.IsEnabled="True"
                                 Visibility="{Binding HasSheets, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border behaviors:ClickToCommandBehavior.Command="{Binding DataContext.SelectSheetCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            behaviors:ClickToCommandBehavior.CommandParameter="{Binding}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                          Command="{Binding DataContext.OpenEditPanelCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Sl.Row}">
                                                <Setter Property="MinHeight" Value="52"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource ReferenceEqualityConverter}">
                                                                <Binding Path="DataContext.SelectedSheet" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                <Binding/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="{DynamicResource Ov.Soft}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="45"/>
                                                <ColumnDefinition Width="1.3*"/>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="0.9*"/>
                                                <ColumnDefinition Width="1.1*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="95"/>
                                                <ColumnDefinition Width="95"/>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="65"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Id}" Margin="12,0,0,0"
                                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                                       Foreground="{DynamicResource Ov.Muted}"
                                                       VerticalAlignment="Center"
                                                       Typography.NumeralAlignment="Tabular"/>
                                            <TextBlock Grid.Column="1" Padding="4,0" Text="{Binding Category}"
                                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                       Foreground="{DynamicResource Ov.Ink}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Category}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Padding="4,0" Text="{Binding ThicknessDisplay}"
                                                       FontSize="{DynamicResource FontSize.Body}"
                                                       Foreground="{DynamicResource Ov.Accent}" FontWeight="{DynamicResource Weight.Bold}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       Typography.NumeralAlignment="Tabular"/>
                                            <TextBlock Grid.Column="3" Padding="4,0" Text="{Binding Color}"
                                                       FontSize="{DynamicResource FontSize.Body}"
                                                       Foreground="{DynamicResource Ov.Muted}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Padding="4,0" Text="{Binding SizeDisplay}"
                                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                                       Foreground="{DynamicResource Ov.Ink}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       Typography.NumeralAlignment="Tabular"/>
                                            <TextBlock Grid.Column="5" Padding="4,0" Text="{Binding Supplier}"
                                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                                       Foreground="{DynamicResource Ov.Muted}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Supplier}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="6" Padding="4,0" Text="{Binding TotalPurchaseValue, StringFormat={}{0:N0}}"
                                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource Ov.Danger}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       Typography.NumeralAlignment="Tabular"/>
                                            <TextBlock Grid.Column="7" Padding="4,0" Text="{Binding TotalSellValue, StringFormat={}{0:N0}}"
                                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource Ov.Success}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       Typography.NumeralAlignment="Tabular"/>

                                            <Border Grid.Column="8" Margin="4,0"
                                                    Background="{DynamicResource Ov.SuccessSoft}"
                                                    CornerRadius="{DynamicResource Radius.Small}" Padding="7,3"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Stock}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                           FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.Success}"
                                                           Typography.NumeralAlignment="Tabular"/>
                                            </Border>
                                            <Border Grid.Column="9" Margin="4,0"
                                                    Background="{DynamicResource Ov.DangerSoft}"
                                                    CornerRadius="{DynamicResource Radius.Small}" Padding="7,3"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Used}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                           FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.Danger}"
                                                           Typography.NumeralAlignment="Tabular"/>
                                            </Border>
                                            <Border Grid.Column="10" Margin="4,0"
                                                    Background="{DynamicResource Ov.WarningSoft}"
                                                    CornerRadius="{DynamicResource Radius.Small}" Padding="7,3"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Balance}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                           FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.Warning}"
                                                           Typography.NumeralAlignment="Tabular"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty state -->
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                            <emptyState:EmptyStateControl
                                Icon="&#xE7B8;"
                                Title="{DynamicResource SheetStore.NoGlassSheetsYet}"
                                Message="Inventory is your raw-glass stock — sizes, thicknesses, colours, quantity and value. Click '+ Add New' to add your first glass sheet."/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══ CONSUMABLES LIST ══ -->
            <Grid Grid.Column="0" Visibility="{Binding IsConsumablesView, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Style="{StaticResource Sl.Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Sl.TableHeader}" Margin="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="300"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ITEM" Style="{StaticResource Sl.ColumnLabel}" Margin="12,0,0,0"/>
                                <TextBlock Grid.Column="1" Text="BALANCE" Style="{StaticResource Sl.ColumnLabel}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="USED" Style="{StaticResource Sl.ColumnLabel}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="VALUE" Style="{StaticResource Sl.ColumnLabel}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="ACTIONS" Style="{StaticResource Sl.ColumnLabel}" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Items}"
                                 ItemContainerStyle="{StaticResource Sl.ListItem}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 Focusable="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="False"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingStackPanel.ScrollUnit="Pixel"
                                 VirtualizingStackPanel.CacheLength="400,800"
                                 VirtualizingStackPanel.CacheLengthUnit="Pixel"
                                 behaviors:SmoothScrollBehavior.IsEnabled="True"
                                 Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border behaviors:ClickToCommandBehavior.Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            behaviors:ClickToCommandBehavior.CommandParameter="{Binding}">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Sl.Row}">
                                                <Setter Property="MinHeight" Value="52"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Ov.DangerSoft}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.2*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1.1*"/>
                                                <ColumnDefinition Width="300"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Item description -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="12,0,8,0">
                                                <TextBlock Text="{Binding FullDescription}"
                                                           FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FullDescription}"
                                                           Foreground="{DynamicResource Ov.Ink}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding CategoryDisplay}"
                                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                                               Foreground="{DynamicResource Ov.Accent}"/>
                                                    <TextBlock Text="{Binding Supplier, StringFormat={}  ·  {0}}"
                                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                                               Foreground="{DynamicResource Ov.Muted}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Balance -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding BalanceDisplay}"
                                                           FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                           Foreground="{DynamicResource Ov.Success}"
                                                           Typography.NumeralAlignment="Tabular"/>
                                                <TextBlock Text="{Binding UomDisplay}"
                                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                                           Foreground="{DynamicResource Ov.Muted}"/>
                                            </StackPanel>

                                            <!-- Used -->
                                            <TextBlock Grid.Column="2" Text="{Binding Used, StringFormat={}{0:N2}}"
                                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource Ov.Danger}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       Typography.NumeralAlignment="Tabular"/>

                                            <!-- Value -->
                                            <TextBlock Grid.Column="3" Text="{Binding BalanceCostValue, StringFormat={}{0:N0} AED}"
                                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource Ov.Accent}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       Typography.NumeralAlignment="Tabular"/>

                                            <!-- Row actions -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,8,0">
                                                <Button Style="{StaticResource Sl.SuccessButton}"
                                                        MinHeight="30" Padding="10,4"
                                                        Tag="&#xE7B8;" Content="Buy"
                                                        Command="{Binding DataContext.ReceiveItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource Sl.PrimaryButton}"
                                                        MinHeight="30" Padding="10,4" Margin="4,0,0,0"
                                                        Tag="&#xE896;" Content="Use"
                                                        Command="{Binding DataContext.ConsumeItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource Sl.Button}"
                                                        MinHeight="30" Padding="10,4" Margin="4,0,0,0"
                                                        Tag="&#xE8E5;" Content="Edit"
                                                        Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource Sl.DangerButton}"
                                                        MinHeight="30" Padding="10,4" Margin="4,0,0,0"
                                                        Tag="&#xE74D;" Content="Delete"
                                                        Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty state -->
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVisibilityConverter}}">
                            <emptyState:EmptyStateControl
                                Icon="&#xE7B8;"
                                Title="No consumables yet"
                                Message="Spacer bar, desiccant, primary and secondary sealant, cavity gas and hardware are stocked here in their own units. Click ADD NEW to add the first one."/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══ SLIDE-IN DETAIL PANEL (code-behind contract:
                 x:Name="DetailPanel", TranslateTransform x:Name="PanelSlide") ══ -->
            <Grid x:Name="DetailPanel" Grid.Column="1" Margin="14,0,0,0"
                  Visibility="Collapsed">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="PanelSlide" X="0"/>
                </Grid.RenderTransform>

                <Border Width="360" VerticalAlignment="Stretch"
                        Style="{StaticResource Sl.Card}" Padding="16"
                        SnapsToDevicePixels="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  behaviors:SmoothScrollBehavior.IsEnabled="True">
                        <StackPanel>
                            <!-- Panel header -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="{DynamicResource Radius.Medium}"
                                        Background="{DynamicResource Ov.Soft}" Grid.Column="0">
                                    <TextBlock Text="&#xE7B8;" FontFamily="{DynamicResource FontFamily.Icon}"
                                               FontSize="{DynamicResource FontSize.Body}"
                                               Foreground="{DynamicResource Ov.Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                                    <TextBlock Text="{DynamicResource SheetStore.SheetDetails}"
                                               FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource Ov.Ink}"/>
                                    <TextBlock Text="{Binding SelectionLabel}"
                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                               Foreground="{DynamicResource Ov.Muted}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Style="{StaticResource Sl.Button}"
                                        Width="32" Height="32" MinWidth="32" Padding="0"
                                        Content="✕" ToolTip="{DynamicResource DeliveryNote.CloseClickRowAgain}"
                                        Command="{Binding ClearSelectionCommand}"/>
                            </Grid>

                            <!-- Valuation metrics -->
                            <TextBlock Text="{DynamicResource DeliveryNote.ROWDetails}"
                                       FontSize="{DynamicResource FontSize.Caption}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource Ov.Muted}"
                                       Margin="2,0,0,8"/>

                            <Border CornerRadius="{DynamicResource Radius.Medium}" Padding="12,10" Margin="0,0,0,8"
                                    Background="{DynamicResource Ov.DangerSoft}"
                                    BorderBrush="{DynamicResource Ov.Danger}"
                                    BorderThickness="1" SnapsToDevicePixels="True">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource SheetStore.PurchaseValue}"
                                               FontSize="{DynamicResource FontSize.Caption}" FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource Ov.Danger}"/>
                                    <TextBlock Text="{Binding DisplayBuyingValue, StringFormat={}{0:N0} AED}"
                                               FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource Ov.Ink}"
                                               Typography.NumeralAlignment="Tabular" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border CornerRadius="{DynamicResource Radius.Medium}" Padding="12,10" Margin="0,0,0,8"
                                    Background="{DynamicResource Ov.SuccessSoft}"
                                    BorderBrush="{DynamicResource Ov.Success}"
                                    BorderThickness="1" SnapsToDevicePixels="True">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource SheetStore.SellingValue}"
                                               FontSize="{DynamicResource FontSize.Caption}" FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource Ov.Success}"/>
                                    <TextBlock Text="{Binding DisplaySellingValue, StringFormat={}{0:N0} AED}"
                                               FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource Ov.Ink}"
                                               Typography.NumeralAlignment="Tabular" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border CornerRadius="{DynamicResource Radius.Medium}" Padding="12,10" Margin="0,0,0,12"
                                    Background="{DynamicResource Ov.Soft}"
                                    BorderBrush="{DynamicResource Ov.Accent}"
                                    BorderThickness="1" SnapsToDevicePixels="True">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource SheetStore.ExpectedProfit}"
                                               FontSize="{DynamicResource FontSize.Caption}" FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource Ov.Accent}"/>
                                    <TextBlock Text="{Binding DisplayProfit, StringFormat={}{0:N0} AED}"
                                               FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource Ov.Ink}"
                                               Typography.NumeralAlignment="Tabular" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Selected row stock: stock / used / balance -->
                            <TextBlock Text="{DynamicResource SheetStore.SelectedROW}"
                                       FontSize="{DynamicResource FontSize.Caption}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource Ov.Muted}"
                                       Margin="2,0,0,8"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="{DynamicResource Radius.Medium}" Padding="10,8"
                                        Background="{DynamicResource Ov.SuccessSoft}"
                                        BorderBrush="{DynamicResource Ov.Success}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource SheetStore.Stock}" FontSize="{DynamicResource FontSize.Caption}"
                                                   FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.Success}"/>
                                        <TextBlock Text="{Binding DisplayStock}" FontSize="{DynamicResource FontSize.Title}"
                                                   FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.Ink}"
                                                   Typography.NumeralAlignment="Tabular" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" CornerRadius="{DynamicResource Radius.Medium}" Padding="10,8"
                                        Background="{DynamicResource Ov.DangerSoft}"
                                        BorderBrush="{DynamicResource Ov.Danger}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource SheetStore.USED}" FontSize="{DynamicResource FontSize.Caption}"
                                                   FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.Danger}"/>
                                        <TextBlock Text="{Binding DisplayUsed}" FontSize="{DynamicResource FontSize.Title}"
                                                   FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.Ink}"
                                                   Typography.NumeralAlignment="Tabular" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" CornerRadius="{DynamicResource Radius.Medium}" Padding="10,8"
                                        Background="{DynamicResource Ov.WarningSoft}"
                                        BorderBrush="{DynamicResource Ov.Warning}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Common.Balance}" FontSize="{DynamicResource FontSize.Caption}"
                                                   FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.Warning}"/>
                                        <TextBlock Text="{Binding DisplayBalance}" FontSize="{DynamicResource FontSize.Title}"
                                                   FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.Ink}"
                                                   Typography.NumeralAlignment="Tabular" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Per-sheet SQM pricing -->
                            <StackPanel Margin="0,0,0,12"
                                        Visibility="{Binding IsRowSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="{DynamicResource Radius.Medium}" Padding="10,8"
                                            Background="{DynamicResource Ov.Soft}"
                                            BorderBrush="{DynamicResource Ov.Accent}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="SQM/SHEET" FontSize="{DynamicResource FontSize.Caption}"
                                                       FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.Accent}"/>
                                            <TextBlock Text="{Binding DisplaySqmPerSheet, StringFormat={}{0:0.####}}"
                                                       FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource Ov.Ink}" Margin="0,2,0,0"
                                                       Typography.NumeralAlignment="Tabular"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" CornerRadius="{DynamicResource Radius.Medium}" Padding="10,8"
                                            Background="{DynamicResource Ov.DangerSoft}"
                                            BorderBrush="{DynamicResource Ov.Danger}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource SheetStore.BUYSQM}" FontSize="{DynamicResource FontSize.Caption}"
                                                       FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.Danger}"/>
                                            <TextBlock Text="{Binding DisplayBuyPricePerSqm, StringFormat={}{0:0.##} AED}"
                                                       FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource Ov.Ink}" Margin="0,2,0,0"
                                                       Typography.NumeralAlignment="Tabular"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border CornerRadius="{DynamicResource Radius.Medium}" Padding="10,8"
                                        Background="{DynamicResource Ov.SuccessSoft}"
                                        BorderBrush="{DynamicResource Ov.Success}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource SheetStore.SELLSQM}" FontSize="{DynamicResource FontSize.Caption}"
                                                   FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.Success}"/>
                                        <TextBlock Text="{Binding DisplaySellPricePerSqm, StringFormat={}{0:0.##} AED}"
                                                   FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource Ov.Ink}" Margin="0,2,0,0"
                                                   Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource Ov.Line}" Margin="0,2,0,12"/>

                            <!-- Actions -->
                            <TextBlock Text="{DynamicResource Common.Actions}"
                                       FontSize="{DynamicResource FontSize.Caption}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource Ov.Muted}"
                                       Margin="2,0,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource Sl.SuccessButton}"
                                        MinHeight="36" HorizontalAlignment="Stretch"
                                        Tag="&#xE7B8;" Content="{DynamicResource SheetStore.BUY}"
                                        Command="{Binding BuyCommand}"
                                        CommandParameter="{Binding SelectedSheet}"/>
                                <Button Grid.Column="2" Style="{StaticResource Sl.PrimaryButton}"
                                        MinHeight="36" HorizontalAlignment="Stretch"
                                        Tag="&#xE896;" Content="{DynamicResource Login.Use}"
                                        Command="{Binding UseCommand}"
                                        CommandParameter="{Binding SelectedSheet}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource Sl.Button}"
                                        MinHeight="36" HorizontalAlignment="Stretch"
                                        Tag="&#xE70F;" Content="{DynamicResource Action.Edit}"
                                        Command="{Binding OpenEditPanelCommand}"
                                        CommandParameter="{Binding SelectedSheet}"/>
                                <Button Grid.Column="2" Style="{StaticResource Sl.DangerButton}"
                                        MinHeight="36" HorizontalAlignment="Stretch"
                                        Tag="&#xE74D;" Content="{DynamicResource Action.Delete}"
                                        Command="{Binding DeleteCommand}"
                                        CommandParameter="{Binding SelectedSheet}"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ══ SLIDE-IN CONSUMABLE ITEM EDITOR (code-behind
                 contract: x:Name="ItemEditorPanel") ══ -->
            <Grid x:Name="ItemEditorPanel" Grid.Column="1" Margin="14,0,0,0"
                  Visibility="Collapsed">
                <Border Width="360" VerticalAlignment="Stretch"
                        Style="{StaticResource Sl.Card}" Padding="16"
                        DataContext="{Binding ItemEditor}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  behaviors:SmoothScrollBehavior.IsEnabled="True">
                        <StackPanel Style="{StaticResource Field.Panel}">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource Ov.Ink}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="NAME" Style="{StaticResource Field.Label}"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Input.TextBox}"/>
                            <TextBlock Text="{Binding NameError}" Style="{StaticResource Typography.Caption}"
                                       Foreground="{DynamicResource Ov.Danger}"
                                       Visibility="{Binding HasNameError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <TextBlock Text="CATEGORY" Style="{StaticResource Field.Label}"/>
                            <ComboBox ItemsSource="{Binding Categories}"
                                      Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                      IsTextSearchEnabled="True"
                                      Style="{StaticResource ModernEditableComboBoxStyle}"
                                      Margin="0,0,0,8"/>

                            <TextBlock Text="UNIT OF MEASURE" Style="{StaticResource Field.Label}"/>
                            <ComboBox ItemsSource="{Binding Uoms}"
                                      Text="{Binding Uom, UpdateSourceTrigger=PropertyChanged}"
                                      IsTextSearchEnabled="True"
                                      Style="{StaticResource ModernEditableComboBoxStyle}"
                                      Margin="0,0,0,8"/>

                            <TextBlock Text="SPECIFICATION" Style="{StaticResource Field.Label}"/>
                            <TextBox Text="{Binding Specification, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Input.TextBox}"/>

                            <TextBlock Text="PART NUMBER" Style="{StaticResource Field.Label}"/>
                            <TextBox Text="{Binding PartNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Input.TextBox}"/>

                            <TextBlock Text="SUPPLIER" Style="{StaticResource Field.Label}"/>
                            <TextBox Text="{Binding Supplier, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Input.TextBox}"/>

                            <TextBlock Text="OPENING STOCK" Style="{StaticResource Field.Label}"/>
                            <TextBox Text="{Binding StockText, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                     IsEnabled="{Binding CanEditStock}"
                                     Style="{StaticResource Input.TextBox}"/>
                            <TextBlock Text="{Binding StockError}" Style="{StaticResource Typography.Caption}"
                                       Foreground="{DynamicResource Ov.Danger}"
                                       Visibility="{Binding HasStockError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <TextBlock Text="REORDER LEVEL" Style="{StaticResource Field.Label}"/>
                            <TextBox Text="{Binding ReorderText, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                     Style="{StaticResource Input.TextBox}"/>
                            <TextBlock Text="{Binding ReorderError}" Style="{StaticResource Typography.Caption}"
                                       Foreground="{DynamicResource Ov.Danger}"
                                       Visibility="{Binding HasReorderError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <TextBlock Text="PURCHASE PRICE / UNIT" Style="{StaticResource Field.Label}"/>
                            <TextBox Text="{Binding PurchaseText, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                     Style="{StaticResource Input.TextBox}"/>
                            <TextBlock Text="{Binding PurchaseError}" Style="{StaticResource Typography.Caption}"
                                       Foreground="{DynamicResource Ov.Danger}"
                                       Visibility="{Binding HasPurchaseError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <TextBlock Text="SELL PRICE / UNIT" Style="{StaticResource Field.Label}"/>
                            <TextBox Text="{Binding SellText, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                     Style="{StaticResource Input.TextBox}"/>
                            <TextBlock Text="{Binding SellError}" Style="{StaticResource Typography.Caption}"
                                       Foreground="{DynamicResource Ov.Danger}"
                                       Visibility="{Binding HasSellError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <Border Background="{DynamicResource Ov.WarningSoft}"
                                    BorderBrush="{DynamicResource Ov.Warning}"
                                    BorderThickness="1" Padding="10,8" Margin="0,4,0,0"
                                    CornerRadius="{DynamicResource Radius.Medium}"
                                    Visibility="{Binding HasMarginWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding MarginWarning}" TextWrapping="Wrap"
                                           FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.SemiBold}"
                                           Foreground="{DynamicResource Ov.Warning}"/>
                            </Border>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource Sl.Button}"
                                        MinHeight="36" HorizontalAlignment="Stretch"
                                        Content="{DynamicResource Action.Cancel}"
                                        Command="{Binding DataContext.CloseItemEditorCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                <Button Grid.Column="2" Style="{StaticResource Sl.PrimaryButton}"
                                        MinHeight="36" HorizontalAlignment="Stretch"
                                        Content="{Binding SaveButtonText}"
                                        Command="{Binding DataContext.SaveItemEditorCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
