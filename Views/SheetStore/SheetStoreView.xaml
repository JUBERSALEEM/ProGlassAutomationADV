<!-- ═══════════════════════════════════════════════════════════════
     SHEET STORE — Bento Design System Redesign
     Clean industrial Bento layout with responsive proportional grid,
     balanced KPI metric cards, high-density filter bar, and
     retractable inspection drawer. All bindings & commands preserved.
═══════════════════════════════════════════════════════════════ -->
<UserControl Style="{StaticResource ErpPageRootStyle}"
             x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="{DynamicResource Ov.Canvas}"
             Focusable="True">

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding ClearSelectionCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Dashboard/Overview/IndigoStudioResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Reusable modern menu item -->
            <Style x:Key="SheetMenuActionItem" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="Transparent"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" Padding="14,10"
                                    SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{TemplateBinding Tag}"
                                               FontFamily="{DynamicResource FontFamily.Icon}"
                                               FontSize="{DynamicResource FontSize.H3}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                    <TextBlock Text="{TemplateBinding Content}"
                                               FontSize="{DynamicResource FontSize.Body}"
                                               FontWeight="{DynamicResource Weight.SemiBold}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ListBoxItem — strips default WPF selection padding -->
            <Style x:Key="SheetListBoxItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- ══════════════════════════════════════════════════════════════
         ROOT BENTO LAYOUT — Sticky header, filters, KPIs & main split
    ══════════════════════════════════════════════════════════════ -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header + KPIs + Filters -->
            <RowDefinition Height="*"/>    <!-- Main data grid + sidebar rail -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             STICKY BENTO TOP SECTION
        ═══════════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="24,14,24,12">

            <!-- 1. HEADER BAR: Title, Navigation Tabs & Primary Actions -->
            <DockPanel Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Module.SheetStore}"
                               Style="{StaticResource Ov.Title}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <Border Background="{DynamicResource Ov.Soft}"
                            CornerRadius="8"
                            Padding="10,4"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0">
                        <TextBlock Text="{DynamicResource Nav.GroupInventory}"
                                   Style="{StaticResource Ov.Meta}"
                                   FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource Ov.Accent}"/>
                    </Border>

                    <!-- Bento Segmented Tabs: Glass Sheets / Consumables -->
                    <Border Background="{DynamicResource Ov.Soft}"
                            CornerRadius="10"
                            Padding="3"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding ShowGlassCommand}"
                                    Tag="&#xE7B8;" Content="GLASS SHEETS"
                                    Height="32" Padding="14,0" Margin="0,0,2,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGlassView}" Value="False">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Ov.Muted}"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Command="{Binding ShowConsumablesCommand}"
                                    Tag="&#xE71D;" Content="CONSUMABLES"
                                    Height="32" Padding="14,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConsumablesView}" Value="False">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Ov.Muted}"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Low Stock Alert Pill -->
                    <Border Background="{DynamicResource Ov.DangerSoft}"
                            BorderBrush="{DynamicResource Ov.Danger}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,4"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"
                            Visibility="{Binding HasLowStock, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding LowStockCount, StringFormat={}{0} LOW STOCK}"
                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                   FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource Ov.Danger}"/>
                    </Border>
                </StackPanel>

                <!-- Right Header Actions -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ActionsMenuButton"
                            Style="{StaticResource OutlinedPillButton}"
                            Height="36" Padding="14,0"
                            Tag="&#xE712;" Content="{DynamicResource Common.Actions}"
                            ToolTip="{DynamicResource SheetStore.MoreActions}"
                            Margin="0,0,10,0"
                            behaviors:DropdownButtonBehavior.Popup="{Binding ElementName=ActionsMenuPopup}"/>

                    <Button Style="{StaticResource PrimaryPillButton}"
                            Height="36" Padding="18,0"
                            Tag="&#xE710;" Content="{DynamicResource SheetStore.ADDNEW}"
                            ToolTip="{DynamicResource SheetStore.AddNewGlassSheet}"
                            Command="{Binding AddNewStockCommand}"/>

                    <!-- Dropdown Popup -->
                    <Popup x:Name="ActionsMenuPopup"
                           PlacementTarget="{Binding ElementName=ActionsMenuButton}"
                           Placement="Bottom"
                           VerticalOffset="6"
                           AllowsTransparency="True"
                           StaysOpen="True"
                           PopupAnimation="Fade">
                        <Border Background="{DynamicResource PopupSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="8"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4"
                                                  Direction="270" Opacity="0.25"
                                                  Color="{DynamicResource LiquidShadowColor}"/>
                            </Border.Effect>
                            <StackPanel MinWidth="180">
                                <Button Style="{StaticResource SheetMenuActionItem}"
                                        Tag="&#xE72C;" Content="{DynamicResource SheetStore.RefreshData}"
                                        Command="{Binding RefreshCommand}"
                                        behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                                <Button Style="{StaticResource SheetMenuActionItem}"
                                        Tag="&#xE896;" Content="{DynamicResource SheetStore.ImportCSV}"
                                        Command="{Binding ImportCsvCommand}"
                                        behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                                <Border Height="1" Margin="8,4" Background="{DynamicResource BorderDefaultBrush}"/>
                                <Button Style="{StaticResource SheetMenuActionItem}"
                                        Tag="&#xE72D;" Content="{DynamicResource DeliveryNote.ExportCSV}"
                                        Command="{Binding ExportCsvCommand}"
                                        behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                                <Button Style="{StaticResource SheetMenuActionItem}"
                                        Tag="&#xE9F9;" Content="{DynamicResource DeliveryNote.ExportExcel}"
                                        Command="{Binding ExportExcelCommand}"
                                        behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                                <Button Style="{StaticResource SheetMenuActionItem}"
                                        Tag="&#xE8A5;" Content="{DynamicResource SheetStore.ExportPDFReport}"
                                        Command="{Binding ExportPdfCommand}"
                                        behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                                <Button Style="{StaticResource SheetMenuActionItem}"
                                        Tag="&#xE72D;" Content="{DynamicResource Sharing.Share}"
                                        Command="{Binding ShareCommand}"
                                        behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                                <Border Height="1" Margin="8,4" Background="{DynamicResource BorderDefaultBrush}"/>
                                <Button Style="{StaticResource SheetMenuActionItem}"
                                        Tag="&#xE81C;" Content="{DynamicResource SheetStore.ShowHistory}"
                                        Command="{Binding ShowHistoryCommand}"
                                        behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </DockPanel>

            <!-- 2. BENTO KPI METRIC CARDS (Rule 2: 5 balanced columns, Rule 5: Viewbox + Ov.Value) -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Metric 1: Total Items -->
                <Border Grid.Column="0" Style="{StaticResource Ov.CardCompact}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource DeliveryNote.Items}" Style="{StaticResource Ov.Meta}"/>
                        <Viewbox MaxHeight="28" HorizontalAlignment="Left" Margin="0,8,0,0">
                            <TextBlock Text="{Binding TotalItems}" Style="{StaticResource Ov.Value}"/>
                        </Viewbox>
                        <TextBlock Text="Catalog SKUs" Style="{StaticResource Ov.Meta}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Metric 2: Total Stock On Rack -->
                <Border Grid.Column="2" Style="{StaticResource Ov.CardCompact}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SheetStore.Stock}" Style="{StaticResource Ov.Meta}"/>
                        <Viewbox MaxHeight="28" HorizontalAlignment="Left" Margin="0,8,0,0">
                            <TextBlock Text="{Binding TotalStock, StringFormat={}{0:N0}}"
                                       Style="{StaticResource Ov.Value}"
                                       Foreground="{DynamicResource Ov.Success}"/>
                        </Viewbox>
                        <TextBlock Text="In-Stock Units" Style="{StaticResource Ov.Meta}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Metric 3: Purchase Value -->
                <Border Grid.Column="4" Style="{StaticResource Ov.CardCompact}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SheetStore.BuyingValue}" Style="{StaticResource Ov.Meta}"/>
                        <Viewbox MaxHeight="28" HorizontalAlignment="Left" Margin="0,8,0,0">
                            <TextBlock Text="{Binding TotalBuyingValue, StringFormat={}{0:N0} AED}"
                                       Style="{StaticResource Ov.Value}"
                                       Foreground="{DynamicResource Ov.Danger}"/>
                        </Viewbox>
                        <TextBlock Text="Procurement Cost" Style="{StaticResource Ov.Meta}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Metric 4: Selling Value -->
                <Border Grid.Column="6" Style="{StaticResource Ov.CardCompact}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SheetStore.SellingValue}" Style="{StaticResource Ov.Meta}"/>
                        <Viewbox MaxHeight="28" HorizontalAlignment="Left" Margin="0,8,0,0">
                            <TextBlock Text="{Binding TotalSellingValue, StringFormat={}{0:N0} AED}"
                                       Style="{StaticResource Ov.Value}"
                                       Foreground="{DynamicResource Ov.Success}"/>
                        </Viewbox>
                        <TextBlock Text="Retail Valuation" Style="{StaticResource Ov.Meta}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Metric 5: Expected Profit -->
                <Border Grid.Column="8" Style="{StaticResource Ov.CardCompact}" Background="{DynamicResource Ov.Soft}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SheetStore.ExpectedProfit}" Style="{StaticResource Ov.Meta}"
                                   Foreground="{DynamicResource Ov.Accent}" FontWeight="{DynamicResource Weight.Bold}"/>
                        <Viewbox MaxHeight="28" HorizontalAlignment="Left" Margin="0,8,0,0">
                            <TextBlock Text="{Binding ExpectedProfit, StringFormat={}{0:N0} AED}"
                                       Style="{StaticResource Ov.Value}"
                                       Foreground="{DynamicResource Ov.Accent}"/>
                        </Viewbox>
                        <TextBlock Text="Projected Margin" Style="{StaticResource Ov.Meta}"
                                   Foreground="{DynamicResource Ov.Accent}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. BENTO FILTER & SEARCH BAR -->
            <Border Style="{StaticResource Ov.CardCompact}" Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Dropdowns Row (Glass Mode) -->
                    <Grid Grid.Row="0" Margin="0,0,0,10"
                          Visibility="{Binding IsGlassView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource SheetStore.Category}" Style="{StaticResource Ov.Meta}" Margin="2,0,0,4"/>
                            <ComboBox ItemsSource="{Binding CategoryOptions}"
                                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      Height="34"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource ProformaInvoice.Thickness}" Style="{StaticResource Ov.Meta}" Margin="2,0,0,4"/>
                            <ComboBox ItemsSource="{Binding ThicknessOptions}"
                                      SelectedItem="{Binding SelectedThickness, Mode=TwoWay}"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      Height="34"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="{DynamicResource ProformaInvoice.Color}" Style="{StaticResource Ov.Meta}" Margin="2,0,0,4"/>
                            <ComboBox ItemsSource="{Binding ColorOptions}"
                                      SelectedItem="{Binding SelectedColor, Mode=TwoWay}"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      Height="34"/>
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="{DynamicResource SheetStore.Supplier}" Style="{StaticResource Ov.Meta}" Margin="2,0,0,4"/>
                            <ComboBox ItemsSource="{Binding SupplierOptions}"
                                      SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      Height="34"/>
                        </StackPanel>

                        <StackPanel Grid.Column="8">
                            <TextBlock Text="{DynamicResource SheetStore.SORT}" Style="{StaticResource Ov.Meta}"
                                       Foreground="{DynamicResource Ov.Accent}" FontWeight="{DynamicResource Weight.SemiBold}" Margin="2,0,0,4"/>
                            <ComboBox ItemsSource="{Binding SortOptions}"
                                      SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      Height="34"/>
                        </StackPanel>

                        <Button Grid.Column="10"
                                Style="{StaticResource OutlinedPillButton}"
                                Height="34" Padding="14,0"
                                VerticalAlignment="Bottom"
                                Tag="&#xE711;" Content="{DynamicResource Action.Clear}"
                                ToolTip="{DynamicResource SheetStore.ClearFilters}"
                                Command="{Binding ClearFiltersCommand}"
                                Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>

                    <!-- Search Input Bar -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource Ov.Soft}"
                            BorderBrush="{DynamicResource Ov.Line}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,6">
                        <DockPanel>
                            <TextBlock Text="&#xE721;"
                                       Style="{StaticResource Ov.Glyph}"
                                       FontSize="16"
                                       Foreground="{DynamicResource Ov.Accent}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                     behaviors:TextBoxBehaviors.SelectAllOnFocus="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="{DynamicResource FontSize.Body}"
                                     Foreground="{DynamicResource Ov.Ink}"
                                     MinHeight="28"
                                     VerticalContentAlignment="Center"
                                     Style="{StaticResource TextBoxStyle}"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ═══════════════════════════════════════════════════════════
             MAIN WORKSPACE — Proportional Data Grid + Animated Sidebar
        ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="24,0,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!-- Retractable inspection drawer column: animated by code-behind (SheetStoreView.xaml.cs) -->
                <ColumnDefinition x:Name="DetailColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- ══ 1. GLASS SHEETS LIST ══ -->
            <Grid Grid.Column="0" Visibility="{Binding IsGlassView, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Proportional Column Header -->
                <Border Grid.Row="0"
                        Background="{DynamicResource Ov.Accent}"
                        CornerRadius="12,12,0,0"
                        Padding="20,12"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="45"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="65"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="#" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.OnAccent}"/>
                        <TextBlock Grid.Column="1" Padding="6,0" Text="{DynamicResource SheetStore.Category}" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.OnAccent}"/>
                        <TextBlock Grid.Column="2" Padding="6,0" Text="{DynamicResource SheetStore.Thick}" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.OnAccent}"/>
                        <TextBlock Grid.Column="3" Padding="6,0" Text="{DynamicResource ProformaInvoice.Color}" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.OnAccent}"/>
                        <TextBlock Grid.Column="4" Padding="6,0" Text="{DynamicResource ProformaInvoice.SIZE}" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.OnAccent}"/>
                        <TextBlock Grid.Column="5" Padding="6,0" Text="{DynamicResource SheetStore.Supplier}" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.OnAccent}"/>
                        <TextBlock Grid.Column="6" Padding="6,0" Text="{DynamicResource SheetStore.TotalBUY}" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.OnAccent}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="7" Padding="6,0" Text="{DynamicResource SheetStore.TotalSELL}" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.OnAccent}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="8" Padding="6,0" Text="{DynamicResource SheetStore.Stock}" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.OnAccent}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="9" Padding="6,0" Text="{DynamicResource SheetStore.USED}" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.OnAccent}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="10" Padding="6,0" Text="BAL" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.OnAccent}" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Virtualized Sheet Rows -->
                <Border Grid.Row="1"
                        Background="{DynamicResource Ov.Surface}"
                        BorderBrush="{DynamicResource Ov.Line}"
                        BorderThickness="1,0,1,1"
                        CornerRadius="0,0,14,14"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <ListBox ItemsSource="{Binding Sheets}"
                                 ItemContainerStyle="{StaticResource SheetListBoxItemStyle}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="10,8,10,10"
                                 Focusable="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="False"
                                 ScrollViewer.IsDeferredScrollingEnabled="False"
                                 ScrollViewer.PanningMode="None"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingStackPanel.ScrollUnit="Pixel"
                                 VirtualizingStackPanel.CacheLength="200,400"
                                 VirtualizingStackPanel.CacheLengthUnit="Pixel"
                                 behaviors:SmoothScrollBehavior.IsEnabled="True"
                                 Visibility="{Binding HasSheets, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border behaviors:ClickToCommandBehavior.Command="{Binding DataContext.SelectSheetCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            behaviors:ClickToCommandBehavior.CommandParameter="{Binding}"
                                            Padding="14,10"
                                            CornerRadius="10"
                                            Background="{DynamicResource Ov.Surface}"
                                            BorderBrush="{DynamicResource Ov.Line}"
                                            BorderThickness="1"
                                            SnapsToDevicePixels="True">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                          Command="{Binding DataContext.OpenEditPanelCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource ReferenceEqualityConverter}">
                                                                <Binding Path="DataContext.SelectedSheet" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                                <Binding/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="{DynamicResource Ov.Soft}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Ov.Accent}"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Ov.AccentHover}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="45"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="0.9*"/>
                                                <ColumnDefinition Width="1.1*"/>
                                                <ColumnDefinition Width="1.3*"/>
                                                <ColumnDefinition Width="95"/>
                                                <ColumnDefinition Width="95"/>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="65"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource Ov.Muted}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Padding="6,0" Text="{Binding Category}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource Ov.Ink}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Padding="6,0" Text="{Binding ThicknessDisplay}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Ov.Ink}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Padding="6,0" Text="{Binding Color}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Ov.Ink}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Padding="6,0" Text="{Binding SizeDisplay}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Ov.Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Padding="6,0" Text="{Binding Supplier}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource Ov.Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="6" Padding="6,0" Text="{Binding TotalPurchaseValue, StringFormat={}{0:N0}}"
                                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.Danger}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="7" Padding="6,0" Text="{Binding TotalSellValue, StringFormat={}{0:N0}}"
                                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.Success}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                            <!-- Stock Pill -->
                                            <Border Grid.Column="8" Margin="4,0"
                                                    Background="{DynamicResource Ov.SuccessSoft}"
                                                    CornerRadius="6" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Stock}" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.Success}"/>
                                            </Border>

                                            <!-- Used Pill -->
                                            <Border Grid.Column="9" Margin="4,0"
                                                    Background="{DynamicResource Ov.DangerSoft}"
                                                    CornerRadius="6" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Used}" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.Danger}"/>
                                            </Border>

                                            <!-- Balance Pill -->
                                            <Border Grid.Column="10" Margin="4,0"
                                                    Background="{DynamicResource Ov.WarningSoft}"
                                                    CornerRadius="6" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Balance}" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.Warning}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty state -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                            <emptyState:EmptyStateControl
                                Icon="&#xE7B8;"
                                Title="{DynamicResource SheetStore.NoGlassSheetsYet}"
                                Message="Inventory is your raw-glass stock — sizes, thicknesses, colours, quantity and value. Click '+ Add New' to add your first glass sheet."/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══ 2. CONSUMABLES LIST ══ -->
            <Grid Grid.Column="0" Visibility="{Binding IsConsumablesView, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource Ov.Accent}"
                        CornerRadius="12,12,0,0"
                        Padding="20,12"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ITEM &amp; SPECIFICATION" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.OnAccent}"/>
                        <TextBlock Grid.Column="1" Text="BALANCE" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.OnAccent}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="USED" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.OnAccent}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="VALUE (AED)" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.OnAccent}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="ACTIONS" MinWidth="260" Margin="16,0,0,0" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.OnAccent}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="{DynamicResource Ov.Surface}"
                        BorderBrush="{DynamicResource Ov.Line}"
                        BorderThickness="1,0,1,1"
                        CornerRadius="0,0,14,14"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <ListBox ItemsSource="{Binding Items}"
                                 ItemContainerStyle="{StaticResource SheetListBoxItemStyle}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="10,8,10,10"
                                 Focusable="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="False"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingStackPanel.ScrollUnit="Pixel"
                                 VirtualizingStackPanel.CacheLength="400,800"
                                 VirtualizingStackPanel.CacheLengthUnit="Pixel"
                                 behaviors:SmoothScrollBehavior.IsEnabled="True"
                                 Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border behaviors:ClickToCommandBehavior.Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            behaviors:ClickToCommandBehavior.CommandParameter="{Binding}"
                                            Padding="14,10"
                                            CornerRadius="10"
                                            Background="{DynamicResource Ov.Surface}"
                                            BorderBrush="{DynamicResource Ov.Line}"
                                            BorderThickness="1"
                                            SnapsToDevicePixels="True">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Ov.DangerSoft}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Ov.Danger}"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Ov.AccentHover}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Description -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullDescription}"
                                                           FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FullDescription}"
                                                           Foreground="{DynamicResource Ov.Ink}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding CategoryDisplay}"
                                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                                               Foreground="{DynamicResource Ov.Accent}"/>
                                                    <TextBlock Text="{Binding Supplier, StringFormat={}  ·  {0}}"
                                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                                               Foreground="{DynamicResource Ov.Muted}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Balance -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding BalanceDisplay}"
                                                           FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                           Foreground="{DynamicResource Ov.Success}"/>
                                                <TextBlock Text="{Binding UomDisplay}"
                                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                                           Foreground="{DynamicResource Ov.Muted}"/>
                                            </StackPanel>

                                            <!-- Used -->
                                            <TextBlock Grid.Column="2" Text="{Binding Used, StringFormat={}{0:N2}}"
                                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource Ov.Danger}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                            <!-- Value -->
                                            <TextBlock Grid.Column="3" Text="{Binding BalanceCostValue, StringFormat={}{0:N0} AED}"
                                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource Ov.Accent}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <Button Style="{StaticResource RowSuccessButton}"
                                                        Height="32" Padding="12,0"
                                                        Tag="&#xE7B8;" Content="BUY"
                                                        Command="{Binding DataContext.ReceiveItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource RowPrimaryButton}"
                                                        Height="32" Padding="12,0" Margin="6,0,0,0"
                                                        Tag="&#xE896;" Content="USE"
                                                        Command="{Binding DataContext.ConsumeItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource RowOutlinedButton}"
                                                        Height="32" Padding="12,0" Margin="6,0,0,0"
                                                        Tag="&#xE8E5;" Content="EDIT"
                                                        Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource RowDangerButton}"
                                                        Height="32" Padding="12,0" Margin="6,0,0,0"
                                                        Tag="&#xE74D;" Content="DELETE"
                                                        Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVisibilityConverter}}">
                            <emptyState:EmptyStateControl
                                Icon="&#xE7B8;"
                                Title="No consumables yet"
                                Message="Spacer bar, desiccant, primary and secondary sealant, cavity gas and hardware are stocked here in their own units. Click ADD NEW to add the first one."/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══ 3. RIGHT RETRACTABLE INSPECTION BENTO DRAWER ══
                 Code-behind animates DetailColumn width between 0 and 376. -->
            <Grid x:Name="DetailPanel" Grid.Column="1" Margin="16,0,0,0" Visibility="Collapsed">
                <Border Width="360"
                        VerticalAlignment="Stretch"
                        Style="{StaticResource Ov.Card}"
                        Padding="20"
                        SnapsToDevicePixels="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Panel Header -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource Ov.IconBox}" Grid.Column="0">
                                    <TextBlock Text="&#xE7B8;" Style="{StaticResource Ov.Glyph}"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
                                    <TextBlock Text="{DynamicResource SheetStore.SheetDetails}"
                                               Style="{StaticResource Ov.CardTitle}"/>
                                    <TextBlock Text="{Binding SelectionLabel}"
                                               Style="{StaticResource Ov.Meta}"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Style="{StaticResource OutlinedPillButton}"
                                        Height="30" Width="30" Padding="0"
                                        Tag="&#xE711;"
                                        ToolTip="{DynamicResource Common.Close}"
                                        Command="{Binding ClearSelectionCommand}"/>
                            </Grid>

                            <!-- Specifications Card -->
                            <Border Style="{StaticResource Ov.CardMicro}" Margin="0,0,0,12" Background="{DynamicResource Ov.Soft}">
                                <StackPanel>
                                    <TextBlock Text="SPECIFICATION" Style="{StaticResource Ov.Meta}" FontWeight="{DynamicResource Weight.Bold}"/>
                                    <TextBlock Text="{Binding SelectedSheet.Category}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Margin="0,4,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding SelectedSheet.ThicknessDisplay}" Style="{StaticResource Ov.Meta}"/>
                                        <TextBlock Text=" · " Style="{StaticResource Ov.Meta}"/>
                                        <TextBlock Text="{Binding SelectedSheet.Color}" Style="{StaticResource Ov.Meta}"/>
                                        <TextBlock Text=" · " Style="{StaticResource Ov.Meta}"/>
                                        <TextBlock Text="{Binding SelectedSheet.SizeDisplay}" Style="{StaticResource Ov.Meta}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedSheet.Supplier, StringFormat={}Supplier: {0}}" Style="{StaticResource Ov.Meta}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Financial Breakdown -->
                            <TextBlock Text="VALUATION METRICS" Style="{StaticResource Ov.Meta}" FontWeight="{DynamicResource Weight.Bold}" Margin="2,0,0,6"/>

                            <Border Style="{StaticResource Ov.CardMicro}" Margin="0,0,0,8">
                                <DockPanel>
                                    <TextBlock Text="{DynamicResource SheetStore.PurchaseValue}" Style="{StaticResource Ov.Meta}" VerticalAlignment="Center"/>
                                    <Viewbox MaxHeight="22" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding DisplayBuyingValue, StringFormat={}{0:N0} AED}"
                                                   Style="{StaticResource Ov.Value}"
                                                   Foreground="{DynamicResource Ov.Danger}"/>
                                    </Viewbox>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Ov.CardMicro}" Margin="0,0,0,8">
                                <DockPanel>
                                    <TextBlock Text="{DynamicResource SheetStore.SellingValue}" Style="{StaticResource Ov.Meta}" VerticalAlignment="Center"/>
                                    <Viewbox MaxHeight="22" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding DisplaySellingValue, StringFormat={}{0:N0} AED}"
                                                   Style="{StaticResource Ov.Value}"
                                                   Foreground="{DynamicResource Ov.Success}"/>
                                    </Viewbox>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Ov.CardMicro}" Margin="0,0,0,12" Background="{DynamicResource Ov.Soft}">
                                <DockPanel>
                                    <TextBlock Text="{DynamicResource SheetStore.ExpectedProfit}" Style="{StaticResource Ov.Meta}"
                                               Foreground="{DynamicResource Ov.Accent}" FontWeight="{DynamicResource Weight.Bold}" VerticalAlignment="Center"/>
                                    <Viewbox MaxHeight="22" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding DisplayProfit, StringFormat={}{0:N0} AED}"
                                                   Style="{StaticResource Ov.Value}"
                                                   Foreground="{DynamicResource Ov.Accent}"/>
                                    </Viewbox>
                                </DockPanel>
                            </Border>

                            <!-- Stock Levels: Stock / Used / Balance -->
                            <TextBlock Text="{DynamicResource SheetStore.SelectedROW}" Style="{StaticResource Ov.Meta}" FontWeight="{DynamicResource Weight.Bold}" Margin="2,0,0,6"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Ov.CardMicro}" Background="{DynamicResource Ov.SuccessSoft}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource SheetStore.Stock}" Style="{StaticResource Ov.Meta}" Foreground="{DynamicResource Ov.Success}"/>
                                        <Viewbox MaxHeight="22" HorizontalAlignment="Left" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding DisplayStock}" Style="{StaticResource Ov.Value}" Foreground="{DynamicResource Ov.Success}"/>
                                        </Viewbox>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Ov.CardMicro}" Background="{DynamicResource Ov.DangerSoft}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource SheetStore.USED}" Style="{StaticResource Ov.Meta}" Foreground="{DynamicResource Ov.Danger}"/>
                                        <Viewbox MaxHeight="22" HorizontalAlignment="Left" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding DisplayUsed}" Style="{StaticResource Ov.Value}" Foreground="{DynamicResource Ov.Danger}"/>
                                        </Viewbox>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" Style="{StaticResource Ov.CardMicro}" Background="{DynamicResource Ov.WarningSoft}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Common.Balance}" Style="{StaticResource Ov.Meta}" Foreground="{DynamicResource Ov.Warning}"/>
                                        <Viewbox MaxHeight="22" HorizontalAlignment="Left" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding DisplayBalance}" Style="{StaticResource Ov.Value}" Foreground="{DynamicResource Ov.Warning}"/>
                                        </Viewbox>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- SQM Calculations -->
                            <StackPanel Margin="0,0,0,16" Visibility="{Binding IsRowSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="AREA &amp; UNIT RATES" Style="{StaticResource Ov.Meta}" FontWeight="{DynamicResource Weight.Bold}" Margin="2,0,0,6"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource Ov.CardMicro}">
                                        <StackPanel>
                                            <TextBlock Text="SQM/SHEET" Style="{StaticResource Ov.Meta}"/>
                                            <TextBlock Text="{Binding DisplaySqmPerSheet, StringFormat={}{0:0.####} m²}"
                                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource Ov.CardMicro}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource SheetStore.BUYSQM}" Style="{StaticResource Ov.Meta}"/>
                                            <TextBlock Text="{Binding DisplayBuyPricePerSqm, StringFormat={}{0:0.##} AED}"
                                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource Ov.Danger}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource Ov.CardMicro}">
                                    <DockPanel>
                                        <TextBlock Text="{DynamicResource SheetStore.SELLSQM}" Style="{StaticResource Ov.Meta}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DisplaySellPricePerSqm, StringFormat={}{0:0.##} AED}"
                                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource Ov.Success}" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- Row Actions -->
                            <TextBlock Text="{DynamicResource Common.Actions}" Style="{StaticResource Ov.Meta}" FontWeight="{DynamicResource Weight.Bold}" Margin="2,0,0,6"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource SuccessPillButton}"
                                        Height="36"
                                        Tag="&#xE7B8;" Content="{DynamicResource SheetStore.BUY}"
                                        Command="{Binding BuyCommand}"
                                        CommandParameter="{Binding SelectedSheet}"/>
                                <Button Grid.Column="2" Style="{StaticResource PrimaryPillButton}"
                                        Height="36"
                                        Tag="&#xE896;" Content="{DynamicResource Login.Use}"
                                        Command="{Binding UseCommand}"
                                        CommandParameter="{Binding SelectedSheet}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource OutlinedPillButton}"
                                        Height="36"
                                        Tag="&#xE70F;" Content="{DynamicResource Action.Edit}"
                                        Command="{Binding OpenEditPanelCommand}"
                                        CommandParameter="{Binding SelectedSheet}"/>
                                <Button Grid.Column="2" Style="{StaticResource DangerButton}"
                                        Height="36"
                                        Tag="&#xE74D;" Content="{DynamicResource Action.Delete}"
                                        Command="{Binding DeleteCommand}"
                                        CommandParameter="{Binding SelectedSheet}"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ══ 4. CONSUMABLE ITEM EDITOR DRAWER ══ -->
            <Grid x:Name="ItemEditorPanel" Grid.Column="1" Margin="16,0,0,0" Visibility="Collapsed">
                <Border Width="360"
                        VerticalAlignment="Stretch"
                        Style="{StaticResource Ov.Card}"
                        Padding="20"
                        DataContext="{Binding ItemEditor}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" behaviors:SmoothScrollBehavior.IsEnabled="True">
                        <StackPanel Style="{StaticResource Field.Panel}">
                            <TextBlock Text="{Binding Title}"
                                       Style="{StaticResource Ov.CardTitle}"
                                       Margin="0,0,0,16"/>

                            <TextBlock Text="NAME" Style="{StaticResource Field.Label}"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Input.TextBox}"/>
                            <TextBlock Text="{Binding NameError}" Style="{StaticResource Typography.Caption}"
                                       Visibility="{Binding HasNameError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <TextBlock Text="CATEGORY" Style="{StaticResource Field.Label}"/>
                            <ComboBox ItemsSource="{Binding Categories}"
                                      Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                      IsTextSearchEnabled="True"
                                      Style="{StaticResource ModernEditableComboBoxStyle}"
                                      Margin="0,0,0,12"/>

                            <TextBlock Text="UNIT OF MEASURE" Style="{StaticResource Field.Label}"/>
                            <ComboBox ItemsSource="{Binding Uoms}"
                                      Text="{Binding Uom, UpdateSourceTrigger=PropertyChanged}"
                                      IsTextSearchEnabled="True"
                                      Style="{StaticResource ModernEditableComboBoxStyle}"
                                      Margin="0,0,0,12"/>

                            <TextBlock Text="SPECIFICATION" Style="{StaticResource Field.Label}"/>
                            <TextBox Text="{Binding Specification, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Input.TextBox}"/>

                            <TextBlock Text="PART NUMBER" Style="{StaticResource Field.Label}"/>
                            <TextBox Text="{Binding PartNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Input.TextBox}"/>

                            <TextBlock Text="SUPPLIER" Style="{StaticResource Field.Label}"/>
                            <TextBox Text="{Binding Supplier, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Input.TextBox}"/>

                            <TextBlock Text="OPENING STOCK" Style="{StaticResource Field.Label}"/>
                            <TextBox Text="{Binding StockText, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                     IsEnabled="{Binding CanEditStock}"
                                     Style="{StaticResource Input.TextBox}"/>
                            <TextBlock Text="{Binding StockError}" Style="{StaticResource Typography.Caption}"
                                       Visibility="{Binding HasStockError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <TextBlock Text="REORDER LEVEL" Style="{StaticResource Field.Label}"/>
                            <TextBox Text="{Binding ReorderText, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                     Style="{StaticResource Input.TextBox}"/>
                            <TextBlock Text="{Binding ReorderError}" Style="{StaticResource Typography.Caption}"
                                       Visibility="{Binding HasReorderError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <TextBlock Text="PURCHASE PRICE / UNIT" Style="{StaticResource Field.Label}"/>
                            <TextBox Text="{Binding PurchaseText, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                     Style="{StaticResource Input.TextBox}"/>
                            <TextBlock Text="{Binding PurchaseError}" Style="{StaticResource Typography.Caption}"
                                       Visibility="{Binding HasPurchaseError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <TextBlock Text="SELL PRICE / UNIT" Style="{StaticResource Field.Label}"/>
                            <TextBox Text="{Binding SellText, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                     Style="{StaticResource Input.TextBox}"/>
                            <TextBlock Text="{Binding SellError}" Style="{StaticResource Typography.Caption}"
                                       Visibility="{Binding HasSellError, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <Border Background="{DynamicResource Ov.WarningSoft}"
                                    BorderBrush="{DynamicResource Ov.Warning}"
                                    BorderThickness="1" Padding="12,8" Margin="0,6,0,0"
                                    CornerRadius="8"
                                    Visibility="{Binding HasMarginWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding MarginWarning}" TextWrapping="Wrap"
                                           FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.SemiBold}"
                                           Foreground="{DynamicResource Ov.Warning}"/>
                            </Border>

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource OutlinedPillButton}"
                                        Height="36" Content="CANCEL"
                                        Command="{Binding DataContext.CloseItemEditorCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                <Button Grid.Column="2" Style="{StaticResource PrimaryPillButton}"
                                        Height="36" Content="{Binding SaveButtonText}"
                                        Command="{Binding DataContext.SaveItemEditorCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
