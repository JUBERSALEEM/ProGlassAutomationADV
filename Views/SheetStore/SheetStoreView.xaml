<!-- ═══════════════════════════════════════════════════════════════
     SHEET STORE — restructured layout
     The main DataGrid list is the priority. Stats no longer crowd the
     top; instead a detail/stats panel slides in from the right when a
     row is clicked (single click opens, clicking the same row closes).
     The action menu (Refresh/Import/CSV/Excel/PDF/History/Add) stays.
═══════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Focusable="True">

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding ClearSelectionCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>


        <!-- Consumable editor panel field chrome -->
        <Style x:Key="ItemFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="ItemEntry" TargetType="TextBox"
               BasedOn="{StaticResource ModernTextBoxStyle}">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ItemFieldError" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,-8,0,10"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        </Style>

        <!-- Reusable modern menu item (left-click runs its command). -->
        <Style x:Key="SheetMenuActionItem" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent"
                                CornerRadius="{DynamicResource ControlCornerRadius}" Padding="12,9"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="{StaticResource TextSection}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontSize="{StaticResource TextBodyLarge}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        
        <Style x:Key="InventoryKpiCell" TargetType="Border"
               BasedOn="{StaticResource PiKpiCellStyle}">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="MinHeight" Value="72"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextTitle}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- Data row style with hover -->
        <Style x:Key="DataRowStyle" TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius"
                    Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ListBoxItem — strips default WPF selection padding -->
        <Style x:Key="SheetListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ══════════════════════════════════════════════════════════════
         ROOT LAYOUT — compact header + filters + main grid + slide panel
    ══════════════════════════════════════════════════════════════ -->
    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header + filters -->
            <RowDefinition Height="*"/>
            <!-- Main content (grid + right slide panel) -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             STICKY HEADER (compact)
        ═══════════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="24,20,24,0">

            <!-- HEADER + ACTION MENU — 16px below, 12px between ACTIONS and ADD -->
            <DockPanel Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Module.SheetStore}"
                                   Style="{StaticResource ModulePageTitleStyle}"/>
                        <Border Background="{DynamicResource AccentBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="10,4"
                                VerticalAlignment="Center" Margin="14,6,0,0">
                            <TextBlock Text="{DynamicResource Nav.GroupInventory}" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource SheetStore.StockManagementPricingSystem}"
                               Style="{StaticResource ModulePageSubtitleStyle}"
                               Margin="0,4,0,0"/>

                    <!-- STEP D tab pair — same Outlined/Primary pills as
                         Job Order and Delivery Note. TabPillButton clips. -->
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Command="{Binding ShowGlassCommand}"
                                Tag="&#xE7B8;" Content="GLASS SHEETS" Margin="0,0,10,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource OutlinedPillButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGlassView}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding ShowGlassCommand}"
                                Tag="&#xE7B8;" Content="GLASS SHEETS" Margin="0,0,10,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGlassView}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding ShowConsumablesCommand}"
                                Tag="&#xE71D;" Content="CONSUMABLES" Margin="0,0,10,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource OutlinedPillButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConsumablesView}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding ShowConsumablesCommand}"
                                Tag="&#xE71D;" Content="CONSUMABLES" Margin="0,0,10,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConsumablesView}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Border Background="{DynamicResource DangerBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="9,3" VerticalAlignment="Center" Margin="0,0,4,0"
                                Visibility="{Binding HasLowStock, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding LowStockCount, StringFormat={}{0} LOW}"
                                       FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">

                    <!-- ACTION MENU — a single button toggles a dropdown of the
                         6 secondary actions (Refresh/Import/CSV/Excel/PDF/
                         History). Single left click opens; second click closes.
                         ADD NEW stays outside as a primary button. -->
                    <Button x:Name="ActionsMenuButton"
                            Style="{StaticResource OutlinedPillButton}"
                            Tag="&#xE712;" Content="{DynamicResource Common.Actions}"
                            ToolTip="{DynamicResource SheetStore.MoreActions}"
                            Margin="0,0,12,0"
                            behaviors:DropdownButtonBehavior.Popup="{Binding ElementName=ActionsMenuPopup}"/>
                    <Button Style="{StaticResource PrimaryPillButton}"
                            Tag="&#xE710;" Content="{DynamicResource SheetStore.ADDNEW}"
                            ToolTip="{DynamicResource SheetStore.AddNewGlassSheet}"
                            Command="{Binding AddNewStockCommand}"/>

                    <!-- Dropdown popup anchored to the ACTIONS button. A Popup
                         (not a ContextMenu) so the button's own Click handler
                         owns the open/close toggle reliably on left click.
                         StaysOpen=True lets the button Click fire; an outside
                         click closes it via the UserControl's preview handler. -->
                    <Popup x:Name="ActionsMenuPopup"
                           PlacementTarget="{Binding ElementName=ActionsMenuButton}"
                           Placement="Bottom"
                           VerticalOffset="4"
                           AllowsTransparency="True"
                           StaysOpen="True"
                           PopupAnimation="Fade">
                        <Border Background="{DynamicResource PopupSurfaceBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="{DynamicResource Border.HairlineThickness}"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                Padding="6"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4"
                                                  Direction="270" Opacity="0.25"
                                                  Color="{DynamicResource LiquidShadowColor}"/>
                            </Border.Effect>
                            <StackPanel>
                                <Button Style="{StaticResource SheetMenuActionItem}"
                                        Tag="&#xE72C;" Content="{DynamicResource SheetStore.RefreshData}"
                                        Command="{Binding RefreshCommand}"
                                        behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                                <Button Style="{StaticResource SheetMenuActionItem}"
                                        Tag="&#xE896;" Content="{DynamicResource SheetStore.ImportCSV}"
                                        Command="{Binding ImportCsvCommand}"
                                        behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                                <Border Height="1" Margin="10,4"
                                        Background="{DynamicResource OutlineBrush}"/>
                                <Button Style="{StaticResource SheetMenuActionItem}"
                                        Tag="&#xE72D;" Content="{DynamicResource DeliveryNote.ExportCSV}"
                                        Command="{Binding ExportCsvCommand}"
                                        behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                                <Button Style="{StaticResource SheetMenuActionItem}"
                                        Tag="&#xE9F9;" Content="{DynamicResource DeliveryNote.ExportExcel}"
                                        Command="{Binding ExportExcelCommand}"
                                        behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                                <Button Style="{StaticResource SheetMenuActionItem}"
                                        Tag="&#xE8A5;" Content="{DynamicResource SheetStore.ExportPDFReport}"
                                        Command="{Binding ExportPdfCommand}"
                                        behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                                <Border Height="1" Margin="10,4"
                                        Background="{DynamicResource OutlineBrush}"/>
                                <Button Style="{StaticResource SheetMenuActionItem}"
                                        Tag="&#xE81C;" Content="{DynamicResource SheetStore.ShowHistory}"
                                        Command="{Binding ShowHistoryCommand}"
                                        behaviors:DropdownButtonBehavior.ClosePopup="{Binding ElementName=ActionsMenuPopup}"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                </StackPanel>
            </DockPanel>

            <!-- FILTERS + SORT + SEARCH -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}" Padding="20,16" Margin="0,0,0,16"
                    SnapsToDevicePixels="True">
                <StackPanel>
                    <Grid Visibility="{Binding IsGlassView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource SheetStore.Category}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="4,0,0,4"/>
                            <ComboBox ItemsSource="{Binding CategoryOptions}"
                                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      Height="40" MinHeight="40" MinWidth="110"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource ProformaInvoice.Thickness}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="4,0,0,4"/>
                            <ComboBox ItemsSource="{Binding ThicknessOptions}"
                                      SelectedItem="{Binding SelectedThickness, Mode=TwoWay}"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      Height="40" MinHeight="40" MinWidth="110"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="{DynamicResource ProformaInvoice.Color}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="4,0,0,4"/>
                            <ComboBox ItemsSource="{Binding ColorOptions}"
                                      SelectedItem="{Binding SelectedColor, Mode=TwoWay}"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      Height="40" MinHeight="40" MinWidth="110"/>
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="{DynamicResource SheetStore.Supplier}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="4,0,0,4"/>
                            <ComboBox ItemsSource="{Binding SupplierOptions}"
                                      SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      Height="40" MinHeight="40" MinWidth="110"/>
                        </StackPanel>
                        <StackPanel Grid.Column="8">
                            <TextBlock Text="{DynamicResource SheetStore.SORT}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,4"/>
                            <ComboBox ItemsSource="{Binding SortOptions}"
                                      SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      Height="40" MinHeight="40" MinWidth="110"/>
                        </StackPanel>
                        <StackPanel Grid.Column="10" VerticalAlignment="Bottom">
                            <TextBlock Text=" " FontSize="{StaticResource TextBody}" Margin="0,0,0,4"/>
                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Tag="&#xE711;" Content="{DynamicResource Action.Clear}"
                                    ToolTip="{DynamicResource SheetStore.ClearFilters}"
                                    MinWidth="92"
                                    Command="{Binding ClearFiltersCommand}"
                                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>

                    <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}"
                            Background="{DynamicResource MenuHoverBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" Padding="12,7" Margin="0,10,0,0"
                            SnapsToDevicePixels="True">
                        <DockPanel>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSection}"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                     behaviors:TextBoxBehaviors.SelectAllOnFocus="True"
                                     BorderThickness="{DynamicResource Border.NoneThickness}" Background="Transparent"
                                     FontSize="{StaticResource TextBodyLarge}" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                     MinHeight="40" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- TOTAL INVENTORY — one row of KPI cards with 12px gutters.
                 UniformGrid wrapping collapsed height; the 4px Pi strip
                 hid the figures. MinHeight keeps the values readable. -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="16,14" Margin="0,0,0,16"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource SheetStore.TotalInventory}"
                               Style="{StaticResource PiKpiCaptionStyle}"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Border Grid.Column="1" Style="{StaticResource InventoryKpiCell}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource DeliveryNote.Items}"
                                       Style="{StaticResource PiKpiCaptionStyle}"/>
                            <TextBlock Text="{Binding TotalItems}"
                                       Style="{StaticResource PiKpiValueStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource InventoryKpiCell}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SheetStore.Stock}"
                                       Style="{StaticResource PiKpiCaptionStyle}"/>
                            <TextBlock Text="{Binding TotalStock}"
                                       Style="{StaticResource PiKpiValueStyle}"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource InventoryKpiCell}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SheetStore.BuyingValue}"
                                       Style="{StaticResource PiKpiCaptionStyle}"/>
                            <TextBlock Text="{Binding TotalBuyingValue, StringFormat={}{0:N0} AED}"
                                       Style="{StaticResource PiKpiValueStyle}"
                                       Foreground="{DynamicResource DangerBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource InventoryKpiCell}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SheetStore.SellingValue}"
                                       Style="{StaticResource PiKpiCaptionStyle}"/>
                            <TextBlock Text="{Binding TotalSellingValue, StringFormat={}{0:N0} AED}"
                                       Style="{StaticResource PiKpiValueStyle}"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="5" Style="{StaticResource InventoryKpiCell}"
                            ToolTip="{DynamicResource SheetStore.UsedValueTip}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SheetStore.UsedValue}"
                                       Style="{StaticResource PiKpiCaptionStyle}"/>
                            <TextBlock Text="{Binding TotalUsedValue, StringFormat={}{0:N0} AED}"
                                       Style="{StaticResource PiKpiValueStyle}"
                                       Foreground="{DynamicResource WarningBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="6" Style="{StaticResource InventoryKpiCell}"
                            ToolTip="{DynamicResource SheetStore.BalanceValueTip}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SheetStore.BalanceValue}"
                                       Style="{StaticResource PiKpiCaptionStyle}"/>
                            <TextBlock Text="{Binding TotalBalanceValue, StringFormat={}{0:N0} AED}"
                                       Style="{StaticResource PiKpiValueStyle}"
                                       Foreground="{DynamicResource InfoBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="7" Style="{StaticResource InventoryKpiCell}" Margin="0"
                            ToolTip="{DynamicResource SheetStore.ExpectedProfitTip}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SheetStore.ExpectedProfit}"
                                       Style="{StaticResource PiKpiCaptionStyle}"/>
                            <TextBlock Text="{Binding ExpectedProfit, StringFormat={}{0:N0} AED}"
                                       Style="{StaticResource PiKpiValueStyle}"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ═══════════════════════════════════════════════════════════
             MAIN CONTENT — DataGrid list (priority) + right slide panel
        ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="24,0,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!-- Animated panel column: width 0 when closed, expands to
                     376 (360 panel + 16 margin) when a row is selected. -->
                <ColumnDefinition x:Name="DetailColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- ══ MAIN LIST (DataGrid) ══ -->
            <Grid Grid.Column="0" Visibility="{Binding IsGlassView, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Sticky column header -->
                <Border Grid.Row="0"
                        Background="{DynamicResource AccentBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource Radius.Top.Medium}" Padding="24,10"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.45*" MinWidth="36"/>
                            <ColumnDefinition Width="1.6*" MinWidth="120"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="1.2*" MinWidth="100"/>
                            <ColumnDefinition Width="1.3*" MinWidth="112"/>
                            <ColumnDefinition Width="1.6*" MinWidth="130"/>
                            <ColumnDefinition Width="1.3*" MinWidth="116"/>
                            <ColumnDefinition Width="1.4*" MinWidth="124"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Padding="0,0,6,0" Text="#" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock Grid.Column="1" Padding="6,0" Text="{DynamicResource SheetStore.Category}" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock Grid.Column="2" Padding="6,0" Text="{DynamicResource SheetStore.Thick}" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock Grid.Column="3" Padding="6,0" Text="{DynamicResource ProformaInvoice.Color}" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock Grid.Column="4" Padding="6,0" Text="{DynamicResource ProformaInvoice.SIZE}" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock Grid.Column="5" Padding="6,0" Text="{DynamicResource SheetStore.Supplier}" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock Grid.Column="6" Padding="6,0" Text="{DynamicResource SheetStore.TotalBUY}" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource OnAccentForegroundBrush}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="7" Padding="6,0" Text="{DynamicResource SheetStore.TotalSELL}" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource OnAccentForegroundBrush}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="8" Padding="6,0" Text="{DynamicResource SheetStore.Stock}" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource OnAccentForegroundBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="9" Padding="6,0" Text="{DynamicResource SheetStore.USED}" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource OnAccentForegroundBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="10" Padding="6,0,0,0" Text="BAL" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource OnAccentForegroundBrush}" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Virtualized sheet rows -->
                <Border Grid.Row="1"
                        Background="{DynamicResource ModuleBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource Border.BoxNoTopThickness}"
                        CornerRadius="{DynamicResource Radius.Bottom.Medium}"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <ListBox ItemsSource="{Binding Sheets}"
                                 ItemContainerStyle="{StaticResource SheetListBoxItemStyle}"
                                 BorderThickness="{DynamicResource Border.NoneThickness}"
                                 Background="Transparent"
                                 Padding="10,6,10,10"
                                 Focusable="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.IsDeferredScrollingEnabled="False"
                                 ScrollViewer.PanningMode="None"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingStackPanel.ScrollUnit="Item"
                                 VirtualizingStackPanel.CacheLength="1,2"
                                 VirtualizingStackPanel.CacheLengthUnit="Page"
                                 behaviors:SmoothScrollBehavior.IsEnabled="True"
                                 Visibility="{Binding HasSheets, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border behaviors:ClickToCommandBehavior.Command="{Binding DataContext.SelectSheetCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            behaviors:ClickToCommandBehavior.CommandParameter="{Binding}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                          Command="{Binding DataContext.OpenEditPanelCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource DataRowStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource ReferenceEqualityConverter}">
                                                                <Binding Path="SelectedSheet"/>
                                                                <Binding/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <!-- DynamicResource: LiquidSelectionBrush/AccentBrush are
                                                             repainted live by the theme engine + accent manager; a
                                                             StaticResource here would freeze the selected tile's
                                                             colour at load time and ignore theme/family/accent
                                                             switches (the "not accepting theme" defect class). -->
                                                        <Setter Property="Background" Value="{DynamicResource LiquidSelectionBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.45*" MinWidth="36"/>
                                                <ColumnDefinition Width="1.6*" MinWidth="120"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="1.2*" MinWidth="100"/>
                                                <ColumnDefinition Width="1.3*" MinWidth="112"/>
                                                <ColumnDefinition Width="1.6*" MinWidth="130"/>
                                                <ColumnDefinition Width="1.3*" MinWidth="116"/>
                                                <ColumnDefinition Width="1.4*" MinWidth="124"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="64"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Padding="0,0,6,0" Text="{Binding Id}" FontSize="{StaticResource TextBody}"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Padding="6,0" Text="{Binding Category}" FontSize="{StaticResource TextBodyLarge}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Category}"/>
                                            <TextBlock Grid.Column="2" Padding="6,0" Text="{Binding ThicknessDisplay}" FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center"
                                                       TextAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Padding="6,0" Text="{Binding Color}" FontSize="{StaticResource TextBody}"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Color}"/>
                                            <TextBlock Grid.Column="4" Padding="6,0" Text="{Binding SizeDisplay}" FontSize="{StaticResource TextBody}"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SizeDisplay}"/>
                                            <TextBlock Grid.Column="5" Padding="6,0" Text="{Binding Supplier}" FontSize="{StaticResource TextBody}"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Supplier}"/>
                                            <TextBlock Grid.Column="6" Padding="6,0" Text="{Binding TotalPurchaseValue, StringFormat={}{0:N0}}"
                                                       FontSize="{StaticResource TextBody}" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="7" Padding="6,0" Text="{Binding TotalSellValue, StringFormat={}{0:N0}}"
                                                       FontSize="{StaticResource TextBody}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Grid.Column="8" Margin="6,0"
                                                    Background="{DynamicResource TintGreenBrush}" CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Stock}" FontSize="{StaticResource TextBody}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                            </Border>
                                            <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Grid.Column="9" Margin="6,0"
                                                    Background="{DynamicResource TintRedBrush}" CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Used}" FontSize="{StaticResource TextBody}" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                                            </Border>
                                            <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Grid.Column="10" Margin="6,0,0,0"
                                                    Background="{DynamicResource TintAmberBrush}" CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Balance}" FontSize="{StaticResource TextBody}" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty state -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                            <emptyState:EmptyStateControl
                                Icon="&#xE7B8;"
                                Title="{DynamicResource SheetStore.NoGlassSheetsYet}"
                                Message="Inventory is your raw-glass stock — sizes, thicknesses, colours, quantity and value. Click '+ Add New' to add your first glass sheet."/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>


            <!-- ══ CONSUMABLES LIST ══ -->
            <Grid Grid.Column="0" Visibility="{Binding IsConsumablesView, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Background="{DynamicResource AccentBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource Radius.Top.Medium}" Padding="24,10"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ITEM" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock Grid.Column="1" Text="BALANCE" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock Grid.Column="2" Text="USED" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock Grid.Column="3" Text="VALUE" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock Grid.Column="4" Text="ACTIONS" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                    </Grid>
                </Border>
                <Border Grid.Row="1"
                        Background="{DynamicResource ModuleBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource Border.BoxNoTopThickness}"
                        CornerRadius="{DynamicResource Radius.Bottom.Medium}"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <ListBox ItemsSource="{Binding Items}"
                                 ItemContainerStyle="{StaticResource SheetListBoxItemStyle}"
                                 BorderThickness="{DynamicResource Border.NoneThickness}"
                                 Background="Transparent"
                                 Padding="10,6,10,10"
                                 Focusable="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 behaviors:SmoothScrollBehavior.IsEnabled="True"
                                 Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border behaviors:ClickToCommandBehavior.Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            behaviors:ClickToCommandBehavior.CommandParameter="{Binding}"
                                            Padding="14,11" Margin="0,0,0,6"
                                            CornerRadius="{DynamicResource CardCornerRadius}"
                                            BorderThickness="1"
                                            SnapsToDevicePixels="True">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource TintRedBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullDescription}"
                                                           FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding CategoryDisplay}"
                                                               FontSize="{StaticResource TextCaption}"
                                                               Foreground="{DynamicResource AccentBrush}"/>
                                                    <TextBlock Text="{Binding Supplier, StringFormat={}  ·  {0}}"
                                                               FontSize="{StaticResource TextCaption}"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BalanceDisplay}"
                                                           FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                                           Foreground="{DynamicResource SuccessBrush}"/>
                                                <TextBlock Text="{Binding UomDisplay}"
                                                           FontSize="{StaticResource TextCaption}"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Used, StringFormat={}{0:N2}}"
                                                       FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding BalanceCostValue, StringFormat={}{0:N0} AED}"
                                                       FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource RowSuccessButton}"
                                                        Tag="&#xE7B8;" Content="BUY" MinWidth="92"
                                                        Command="{Binding DataContext.ReceiveItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource RowPrimaryButton}"
                                                        Tag="&#xE896;" Content="USE" MinWidth="92" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.ConsumeItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource RowOutlinedButton}"
                                                        Tag="&#xE8E5;" Content="EDIT" MinWidth="86" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource RowDangerButton}"
                                                        Tag="&#xE74D;" Content="DELETE" MinWidth="96" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVisibilityConverter}}">
                            <emptyState:EmptyStateControl
                                Icon="&#xE7B8;"
                                Title="No consumables yet"
                                Message="Spacer bar, desiccant, primary and secondary sealant, cavity gas and hardware are stocked here in their own units. Click ADD NEW to add the first one."/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══ RIGHT SLIDE-IN DETAIL / STATS PANEL ══
                 Collapsed by default so the main grid is full-width. It slides
                 in only when a row is selected (see code-behind). Full-height
                 pill-style panel showing TOTAL buy / sell / profit plus the
                 selected row's stock and its actions. -->
            <Grid x:Name="DetailPanel" Grid.Column="1" Margin="14,0,0,0"
                  Visibility="Collapsed">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="PanelSlide" X="0"/>
                </Grid.RenderTransform>

                <Border Width="360"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource ModuleBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="20"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="22" ShadowDepth="5"
                                          Direction="270" Opacity="0.18"
                                          Color="{DynamicResource LiquidShadowColor}"/>
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Panel header — close button pinned to the far
                                 right corner so it never overlaps the content. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                                        Grid.Column="0"
                                        Background="{DynamicResource AccentBrush}">
                                    <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="{StaticResource TextTitle}" Foreground="{DynamicResource OnAccentForegroundBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                            Margin="12,0,10,0">
                                    <TextBlock Text="{DynamicResource SheetStore.SheetDetails}"
                                               FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding SelectionLabel}"
                                               FontSize="{StaticResource TextBodyLarge}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Style="{StaticResource RowOutlinedButton}"
                                        Tag="&#xE711;" Content=""
                                        VerticalAlignment="Top"
                                        ToolTip="{DynamicResource DeliveryNote.CloseClickRowAgain}"
                                        Command="{Binding ClearSelectionCommand}"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource OutlineBrush}" Margin="0,16,0,16"/>

                            <!-- SELECTED ROW PURCHASE / SELLING / PROFIT —
                                 per-row values, not the list totals. -->
                            <TextBlock Text="{DynamicResource DeliveryNote.ROWDetails}"
                                       FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="4,0,0,8"/>
                            <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="16,12"
                                    Margin="0,0,0,10"
                                    Background="{DynamicResource TintRedBrush}"
                                    BorderBrush="{DynamicResource DangerBrush}"
                                    BorderThickness="{DynamicResource Border.HairlineThickness}"
                                    SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextTitle}" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource SheetStore.PurchaseValue}" Style="{StaticResource StatLabel}" Foreground="{DynamicResource DangerBrush}"/>
                                        <TextBlock Text="{Binding DisplayBuyingValue, StringFormat={}{0:N0} AED}" FontSize="{StaticResource TextTitle}" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="16,12"
                                    Margin="0,0,0,10"
                                    Background="{DynamicResource TintGreenBrush}"
                                    BorderBrush="{DynamicResource SuccessBrush}"
                                    BorderThickness="{DynamicResource Border.HairlineThickness}"
                                    SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextTitle}" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource SheetStore.SellingValue}" Style="{StaticResource StatLabel}" Foreground="{DynamicResource SuccessBrush}"/>
                                        <TextBlock Text="{Binding DisplaySellingValue, StringFormat={}{0:N0} AED}" FontSize="{StaticResource TextTitle}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="16,12"
                                    Margin="0,0,0,16"
                                    Background="{DynamicResource TintBlueBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="{DynamicResource Border.HairlineThickness}"
                                    SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextTitle}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource SheetStore.ExpectedProfit}" Style="{StaticResource StatLabel}" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="{Binding DisplayProfit, StringFormat={}{0:N0} AED}" FontSize="{StaticResource TextTitle}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Selected row stock: STOCK / USED / BALANCE -->
                            <TextBlock Text="{DynamicResource SheetStore.SelectedROW}"
                                       FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="4,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="12,10"
                                        Margin="0,0,3,10"
                                        Background="{DynamicResource TintGreenBrush}"
                                        BorderBrush="{DynamicResource SuccessBrush}"
                                        BorderThickness="{DynamicResource Border.HairlineThickness}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource SheetStore.Stock}" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                        <TextBlock Text="{Binding DisplayStock}" FontSize="{StaticResource TextSection}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="12,10"
                                        Margin="3,0,3,10"
                                        Background="{DynamicResource TintRedBrush}"
                                        BorderBrush="{DynamicResource DangerBrush}"
                                        BorderThickness="{DynamicResource Border.HairlineThickness}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource SheetStore.USED}" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                                        <TextBlock Text="{Binding DisplayUsed}" FontSize="{StaticResource TextSection}" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="12,10"
                                        Margin="3,0,0,10"
                                        Background="{DynamicResource TintAmberBrush}"
                                        BorderBrush="{DynamicResource WarningBrush}"
                                        BorderThickness="{DynamicResource Border.HairlineThickness}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Common.Balance}" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                        <TextBlock Text="{Binding DisplayBalance}" FontSize="{StaticResource TextSection}" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- PER-SHEET SQM PRICING (2026-09-05) —
                                 moved out of the main grid: keeping BUY/SQM
                                 and SELL/SQM as fixed columns next to the
                                 flexible Supplier star column is what made
                                 the table read as "inconsistent spacing" on
                                 wide screens. This is SELECTION-scoped data
                                 (per-sheet rate, not a portfolio figure), so
                                 the card hides when no row is selected. -->
                            <StackPanel Margin="0,0,0,10"
                                        Visibility="{Binding IsRowSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="12,10"
                                            Margin="0,0,3,0"
                                            Background="{DynamicResource TintBlueBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="{DynamicResource Border.HairlineThickness}">
                                        <StackPanel>
                                            <TextBlock Text="SQM/SHEET" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="{Binding DisplaySqmPerSheet, StringFormat={}{0:0.####}}" FontSize="{StaticResource TextSection}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="12,10"
                                            Margin="3,0,0,0"
                                            Background="{DynamicResource TintRedBrush}"
                                            BorderBrush="{DynamicResource DangerBrush}"
                                            BorderThickness="{DynamicResource Border.HairlineThickness}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource SheetStore.BUYSQM}" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                                            <TextBlock Text="{Binding DisplayBuyPricePerSqm, StringFormat={}{0:0.##} AED}" FontSize="{StaticResource TextSection}" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}" Padding="12,10"
                                        Margin="0,6,0,0"
                                        Background="{DynamicResource TintGreenBrush}"
                                        BorderBrush="{DynamicResource SuccessBrush}"
                                        BorderThickness="{DynamicResource Border.HairlineThickness}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource SheetStore.SELLSQM}" FontSize="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                        <TextBlock Text="{Binding DisplaySellPricePerSqm, StringFormat={}{0:0.##} AED}" FontSize="{StaticResource TextSection}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource OutlineBrush}" Margin="0,4,0,16"/>

                            <!-- Row actions -->
                            <TextBlock Text="{DynamicResource Common.Actions}"
                                       FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="4,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource SuccessPillButton}"
                                        Tag="&#xE7B8;" Content="{DynamicResource SheetStore.BUY}"
                                        Command="{Binding BuyCommand}"
                                        CommandParameter="{Binding SelectedSheet}"
                                        Margin="0,0,8,0"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource PrimaryPillButton}"
                                        Tag="&#xE896;" Content="{DynamicResource Login.Use}"
                                        Command="{Binding UseCommand}"
                                        CommandParameter="{Binding SelectedSheet}"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource OutlinedPillButton}"
                                        Tag="&#xE70F;" Content="{DynamicResource Action.Edit}"
                                        Command="{Binding OpenEditPanelCommand}"
                                        CommandParameter="{Binding SelectedSheet}"
                                        Margin="0,0,8,0"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource DangerButton}"
                                        Tag="&#xE74D;" Content="{DynamicResource Action.Delete}"
                                        Command="{Binding DeleteCommand}"
                                        CommandParameter="{Binding SelectedSheet}"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Grid x:Name="ItemEditorPanel" Grid.Column="1" Margin="14,0,0,0"
                  Visibility="Collapsed">
                <Border Width="360" VerticalAlignment="Stretch"
                        Background="{DynamicResource DialogSurfaceBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="20"
                        DataContext="{Binding ItemEditor}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  behaviors:SmoothScrollBehavior.IsEnabled="True">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}"
                                       FontSize="{StaticResource TextHeadline}" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       Margin="0,0,0,16"/>
                            <TextBlock Text="NAME" Style="{StaticResource ItemFieldLabel}"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ItemEntry}"/>
                            <TextBlock Text="{Binding NameError}" Style="{StaticResource ItemFieldError}"
                                       Visibility="{Binding HasNameError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Text="CATEGORY" Style="{StaticResource ItemFieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding Category}"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      Margin="0,0,0,12" Height="40" MinHeight="40"/>
                            <TextBlock Text="UNIT OF MEASURE" Style="{StaticResource ItemFieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Uoms}"
                                      SelectedItem="{Binding Uom}"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      Margin="0,0,0,12" Height="40" MinHeight="40"/>
                            <TextBlock Text="SPECIFICATION" Style="{StaticResource ItemFieldLabel}"/>
                            <TextBox Text="{Binding Specification, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ItemEntry}"/>
                            <TextBlock Text="PART NUMBER" Style="{StaticResource ItemFieldLabel}"/>
                            <TextBox Text="{Binding PartNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ItemEntry}"/>
                            <TextBlock Text="SUPPLIER" Style="{StaticResource ItemFieldLabel}"/>
                            <TextBox Text="{Binding Supplier, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ItemEntry}"/>
                            <TextBlock Text="OPENING STOCK" Style="{StaticResource ItemFieldLabel}"/>
                            <TextBox Text="{Binding StockText, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                     IsEnabled="{Binding CanEditStock}"
                                     Style="{StaticResource ItemEntry}"/>
                            <TextBlock Text="{Binding StockError}" Style="{StaticResource ItemFieldError}"
                                       Visibility="{Binding HasStockError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Text="REORDER LEVEL" Style="{StaticResource ItemFieldLabel}"/>
                            <TextBox Text="{Binding ReorderText, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                     Style="{StaticResource ItemEntry}"/>
                            <TextBlock Text="{Binding ReorderError}" Style="{StaticResource ItemFieldError}"
                                       Visibility="{Binding HasReorderError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Text="PURCHASE PRICE / UNIT" Style="{StaticResource ItemFieldLabel}"/>
                            <TextBox Text="{Binding PurchaseText, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                     Style="{StaticResource ItemEntry}"/>
                            <TextBlock Text="{Binding PurchaseError}" Style="{StaticResource ItemFieldError}"
                                       Visibility="{Binding HasPurchaseError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Text="SELL PRICE / UNIT" Style="{StaticResource ItemFieldLabel}"/>
                            <TextBox Text="{Binding SellText, UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                     Style="{StaticResource ItemEntry}"/>
                            <TextBlock Text="{Binding SellError}" Style="{StaticResource ItemFieldError}"
                                       Visibility="{Binding HasSellError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <Border Background="{DynamicResource MenuHoverBrush}"
                                    BorderBrush="{DynamicResource WarningBrush}"
                                    BorderThickness="1" Padding="10,8" Margin="0,4,0,0"
                                    CornerRadius="{DynamicResource CardCornerRadius}"
                                    Visibility="{Binding HasMarginWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding MarginWarning}" TextWrapping="Wrap"
                                           FontSize="{StaticResource TextCaption}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource WarningBrush}"/>
                            </Border>
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource OutlinedPillButton}"
                                        Content="CANCEL"
                                        Command="{Binding DataContext.CloseItemEditorCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                <Button Grid.Column="2" Style="{StaticResource PrimaryPillButton}"
                                        Content="{Binding SaveButtonText}"
                                        Command="{Binding DataContext.SaveItemEditorCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
