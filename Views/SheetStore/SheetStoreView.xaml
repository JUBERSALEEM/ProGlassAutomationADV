<UserControl x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="StatBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="6"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,90,30,30">

                <!-- HEADER -->
                <DockPanel Margin="10,0,10,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SHEET STORE"
                                       FontSize="30" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <Border Background="{DynamicResource AccentBrush}"
                                    CornerRadius="8" Padding="10,4"
                                    VerticalAlignment="Center" Margin="14,6,0,0">
                                <TextBlock Text="INVENTORY"
                                           FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Stock Management &amp; Pricing System"
                                   FontSize="12" Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Content="+ Add New"
                            Height="40" Padding="20,0"
                            Background="{DynamicResource AccentBrush}" Foreground="White"
                            BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                            Command="{Binding AddCommand}"/>
                </DockPanel>

                <!-- STATS ROW -->
                <UniformGrid Rows="1" Columns="5" Margin="4,0,4,20">
                    <Border Style="{StaticResource StatBox}">
                        <StackPanel>
                            <TextBlock Text="ITEMS" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding TotalItems}" Style="{StaticResource StatValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatBox}">
                        <StackPanel>
                            <TextBlock Text="STOCK" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding TotalStock}"
                                       Style="{StaticResource StatValue}"
                                       Foreground="#10B981"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatBox}">
                        <StackPanel>
                            <TextBlock Text="USED" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding TotalUsed}"
                                       Style="{StaticResource StatValue}"
                                       Foreground="#EF4444"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatBox}">
                        <StackPanel>
                            <TextBlock Text="BALANCE" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding TotalBalance}"
                                       Style="{StaticResource StatValue}"
                                       Foreground="#F59E0B"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatBox}">
                        <StackPanel>
                            <TextBlock Text="VALUE (AED)" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding TotalValue, StringFormat={}{0:N0}}"
                                       Style="{StaticResource StatValue}"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- SEARCH -->
                <Border Background="{DynamicResource ModuleBackgroundBrush}"
                        CornerRadius="10" Padding="14,10" Margin="10,0,10,16">
                    <DockPanel>
                        <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="13"
                                 Foreground="{DynamicResource PrimaryForegroundBrush}"
                                 VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- TABLE CARD -->
                <Border Background="{DynamicResource ModuleBackgroundBrush}"
                        CornerRadius="14" Padding="10" Margin="10,0,10,10">
                    <Grid>
                        <!-- Table (visible when has data) -->
                        <StackPanel Visibility="{Binding HasSheets, Converter={StaticResource BoolToVisibilityConverter}}">

                            <!-- Header row -->
                            <Border Background="{DynamicResource MenuHoverBrush}"
                                    CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="#" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <TextBlock Grid.Column="1" Text="CATEGORY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <TextBlock Grid.Column="2" Text="THICK" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <TextBlock Grid.Column="3" Text="COLOR" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <TextBlock Grid.Column="4" Text="SIZE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <TextBlock Grid.Column="5" Text="SUPPLIER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <TextBlock Grid.Column="6" Text="SQM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <TextBlock Grid.Column="7" Text="PURCHASE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="8" Text="SELL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="9" Text="STOCK" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="10" Text="USED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="11" Text="BAL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="12" Text="ACTIONS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Data rows -->
                            <ItemsControl ItemsSource="{Binding Sheets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,10" Margin="0,2" CornerRadius="8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="1.4*"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="220"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="12"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Category}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ThicknessDisplay}"
                                                           FontSize="12" FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Color}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding SizeDisplay}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="{Binding Supplier}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="6" Text="{Binding Sqm, StringFormat={}{0:N2}}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="7" Text="{Binding PurchasePricePerSqm, StringFormat={}{0:N2}}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="8" Text="{Binding SellPricePerSqm, StringFormat={}{0:N2}}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                <Border Grid.Column="9" Background="#DCFCE7" CornerRadius="6"
                                                        Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Stock}" FontSize="12" FontWeight="Bold" Foreground="#166534"/>
                                                </Border>
                                                <Border Grid.Column="10" Background="#FEE2E2" CornerRadius="6"
                                                        Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Used}" FontSize="12" FontWeight="Bold" Foreground="#991B1B"/>
                                                </Border>
                                                <Border Grid.Column="11" Background="#FEF3C7" CornerRadius="6"
                                                        Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Balance}" FontSize="12" FontWeight="Bold" Foreground="#92400E"/>
                                                </Border>
                                                <StackPanel Grid.Column="12" Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="Buy" Style="{StaticResource ActionBtn}"
                                                            Background="#10B981"
                                                            Command="{Binding DataContext.BuyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Use" Style="{StaticResource ActionBtn}"
                                                            Background="#3B82F6"
                                                            Command="{Binding DataContext.UseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Edit" Style="{StaticResource ActionBtn}"
                                                            Background="#F59E0B"
                                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Del" Style="{StaticResource ActionBtn}"
                                                            Background="#EF4444"
                                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Empty state -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="📦" FontSize="72" HorizontalAlignment="Center" Opacity="0.4"/>
                            <TextBlock Text="No glass sheets yet"
                                       FontSize="20" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,20,0,8"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="Click '+ Add New' to add your first glass sheet"
                                       FontSize="13" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>