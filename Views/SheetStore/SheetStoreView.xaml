<UserControl x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="StatBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="StatValueBig" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="StatSubLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DataRowStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,90,30,30">

                <!-- HEADER -->
                <DockPanel Margin="10,0,10,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SHEET STORE" FontSize="30" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <Border Background="{DynamicResource AccentBrush}"
                                    CornerRadius="8" Padding="10,4"
                                    VerticalAlignment="Center" Margin="14,6,0,0">
                                <TextBlock Text="INVENTORY" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Stock Management &amp; Pricing System"
                                   FontSize="12" Margin="0,4,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="📥 Import" Height="40" Padding="14,0" Margin="0,0,8,0"
                                Background="{DynamicResource MenuHoverBrush}"
                                Foreground="{DynamicResource PrimaryForegroundBrush}"
                                BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                                ToolTip="Import sheets from CSV file"
                                Command="{Binding ImportCsvCommand}"/>
                        <Button Content="📤 Export" Height="40" Padding="14,0" Margin="0,0,8,0"
                                Background="{DynamicResource MenuHoverBrush}"
                                Foreground="{DynamicResource PrimaryForegroundBrush}"
                                BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                                ToolTip="Export current view to CSV"
                                Command="{Binding ExportCsvCommand}"/>
                        <Button Content="📜 History" Height="40" Padding="14,0" Margin="0,0,10,0"
                                Background="{DynamicResource MenuHoverBrush}"
                                Foreground="{DynamicResource PrimaryForegroundBrush}"
                                BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                                Command="{Binding ShowHistoryCommand}"/>
                        <Button Content="+ Add New" Height="40" Padding="20,0"
                                Background="{DynamicResource AccentBrush}" Foreground="White"
                                BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                                Command="{Binding AddCommand}"/>
                    </StackPanel>
                </DockPanel>

                <!-- LAST UPDATED BAR -->
                <Border Background="{DynamicResource ModuleBackgroundBrush}"
                        CornerRadius="8" Padding="14,8" Margin="10,0,10,14">
                    <DockPanel>
                        <TextBlock Text="🕒" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding LastUpdatedDisplay}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </DockPanel>
                </Border>

                <!-- SELECTION INDICATOR -->
                <Border Background="{DynamicResource AccentBrush}"
                        CornerRadius="10" Padding="14,10" Margin="10,0,10,10"
                        Visibility="{Binding IsRowSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel>
                        <TextBlock Text="🎯" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="SHOWING VALUES FOR SELECTED ROW"
                                       FontSize="9" FontWeight="Bold" Foreground="White" Opacity="0.9"/>
                            <TextBlock Text="{Binding SelectionLabel}"
                                       FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="✕ Clear Selection"
                                Height="30" Padding="14,0" HorizontalAlignment="Right"
                                Background="#33FFFFFF" Foreground="White"
                                FontSize="11" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand"
                                Command="{Binding ClearSelectionCommand}"/>
                    </DockPanel>
                </Border>

                <!-- STATS ROW 1 -->
                <UniformGrid Rows="1" Columns="4" Margin="4,0,4,10">
                    <Border Style="{StaticResource StatBox}">
                        <StackPanel>
                            <TextBlock Text="ITEMS" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding DisplayItems}" Style="{StaticResource StatValue}"/>
                            <TextBlock Text="glass types" Style="{StaticResource StatSubLabel}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatBox}">
                        <StackPanel>
                            <TextBlock Text="STOCK" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding DisplayStock}" Style="{StaticResource StatValue}" Foreground="#10B981"/>
                            <TextBlock Text="{Binding DisplaySqmInStock, StringFormat={}{0:N2} SQM}" Style="{StaticResource StatSubLabel}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatBox}">
                        <StackPanel>
                            <TextBlock Text="USED" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding DisplayUsed}" Style="{StaticResource StatValue}" Foreground="#EF4444"/>
                            <TextBlock Text="sheets consumed" Style="{StaticResource StatSubLabel}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatBox}">
                        <StackPanel>
                            <TextBlock Text="BALANCE" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding DisplayBalance}" Style="{StaticResource StatValue}" Foreground="#F59E0B"/>
                            <TextBlock Text="{Binding DisplaySqmBalance, StringFormat={}{0:N2} SQM available}" Style="{StaticResource StatSubLabel}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- STATS ROW 2 -->
                <UniformGrid Rows="1" Columns="3" Margin="4,0,4,20">
                    <Border Style="{StaticResource StatBox}" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💸" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="BUYING VALUE" Margin="6,0,0,0" Style="{StaticResource StatLabel}" Foreground="#991B1B"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DisplayBuyingValue, StringFormat={}{0:N0}}" Style="{StaticResource StatValueBig}" Foreground="#991B1B"/>
                            <TextBlock Text="AED (total investment)" Style="{StaticResource StatSubLabel}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatBox}" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💰" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="SELLING VALUE" Margin="6,0,0,0" Style="{StaticResource StatLabel}" Foreground="#166534"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DisplaySellingValue, StringFormat={}{0:N0}}" Style="{StaticResource StatValueBig}" Foreground="#166534"/>
                            <TextBlock Text="AED (if all sold at current price)" Style="{StaticResource StatSubLabel}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatBox}" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📈" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="EXPECTED PROFIT" Margin="6,0,0,0" Style="{StaticResource StatLabel}" Foreground="#1E40AF"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DisplayProfit, StringFormat={}{0:N0}}" Style="{StaticResource StatValueBig}" Foreground="#1E40AF"/>
                            <TextBlock Text="AED (Selling − Buying)" Style="{StaticResource StatSubLabel}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- FILTERS + SORT + SEARCH -->
                <Border Background="{DynamicResource ModuleBackgroundBrush}"
                        CornerRadius="10" Padding="14,12" Margin="10,0,10,16">
                    <StackPanel>
                        <!-- Row 1: Filters + Sort -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Category -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CATEGORY" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           Margin="4,0,0,4"/>
                                <ComboBox ItemsSource="{Binding CategoryOptions}"
                                          SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                          Height="34" Padding="10,6" FontSize="12"
                                          Background="{DynamicResource MenuHoverBrush}"
                                          Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            </StackPanel>

                            <!-- Thickness -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="THICKNESS" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           Margin="4,0,0,4"/>
                                <ComboBox ItemsSource="{Binding ThicknessOptions}"
                                          SelectedItem="{Binding SelectedThickness, Mode=TwoWay}"
                                          Height="34" Padding="10,6" FontSize="12"
                                          Background="{DynamicResource MenuHoverBrush}"
                                          Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            </StackPanel>

                            <!-- Color -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="COLOR" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           Margin="4,0,0,4"/>
                                <ComboBox ItemsSource="{Binding ColorOptions}"
                                          SelectedItem="{Binding SelectedColor, Mode=TwoWay}"
                                          Height="34" Padding="10,6" FontSize="12"
                                          Background="{DynamicResource MenuHoverBrush}"
                                          Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            </StackPanel>

                            <!-- Supplier -->
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="SUPPLIER" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           Margin="4,0,0,4"/>
                                <ComboBox ItemsSource="{Binding SupplierOptions}"
                                          SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                                          Height="34" Padding="10,6" FontSize="12"
                                          Background="{DynamicResource MenuHoverBrush}"
                                          Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            </StackPanel>

                            <!-- Sort -->
                            <StackPanel Grid.Column="8">
                                <TextBlock Text="SORT BY" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Margin="4,0,0,4"/>
                                <ComboBox ItemsSource="{Binding SortOptions}"
                                          SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                                          Height="34" Padding="10,6" FontSize="12"
                                          Background="{DynamicResource MenuHoverBrush}"
                                          Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            </StackPanel>

                            <!-- Clear Filters -->
                            <StackPanel Grid.Column="10" VerticalAlignment="Bottom">
                                <TextBlock Text=" " FontSize="9" Margin="0,0,0,4"/>
                                <Button Content="✕ Clear"
                                        Height="34" Padding="14,0"
                                        Background="{DynamicResource AccentBrush}" Foreground="White"
                                        BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                                        FontSize="12"
                                        Command="{Binding ClearFiltersCommand}"
                                        Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Search -->
                        <Border Background="{DynamicResource MenuHoverBrush}"
                                CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
                            <DockPanel>
                                <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent"
                                         FontSize="13" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                         VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- TABLE CARD -->
                <Border Background="{DynamicResource ModuleBackgroundBrush}"
                        CornerRadius="14" Padding="10" Margin="10,0,10,10">
                    <Grid>
                        <StackPanel Visibility="{Binding HasSheets, Converter={StaticResource BoolToVisibilityConverter}}">

                            <!-- Header row -->
                            <Border Background="{DynamicResource MenuHoverBrush}"
                                    CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="#" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <TextBlock Grid.Column="1" Text="CATEGORY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <TextBlock Grid.Column="2" Text="THICK" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <TextBlock Grid.Column="3" Text="COLOR" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <TextBlock Grid.Column="4" Text="SIZE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <TextBlock Grid.Column="5" Text="SUPPLIER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <TextBlock Grid.Column="6" Text="SQM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="7" Text="BUY/SQM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="8" Text="SELL/SQM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="9" Text="TOTAL BUY" FontSize="10" FontWeight="Bold" Foreground="#991B1B" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="10" Text="TOTAL SELL" FontSize="10" FontWeight="Bold" Foreground="#166534" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="11" Text="STOCK" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="12" Text="USED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="13" Text="BAL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="14" Text="ACTIONS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Data rows -->
                            <ItemsControl ItemsSource="{Binding Sheets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DataRowStyle}"
                                                MouseLeftButtonDown="Row_Click"
                                                Tag="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="1.6*"/>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="200"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="12"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ThicknessDisplay}" FontSize="12" FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Color}" FontSize="12"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding SizeDisplay}" FontSize="12"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="{Binding Supplier}" FontSize="12"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="6" Text="{Binding SqmPerSheet, StringFormat={}{0:N4}}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="7" Text="{Binding PurchasePricePerSqm, StringFormat={}{0:N2}}"
                                                           FontSize="12" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="8" Text="{Binding SellPricePerSqm, StringFormat={}{0:N2}}"
                                                           FontSize="12" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="9" Text="{Binding TotalPurchaseValue, StringFormat={}{0:N0}}"
                                                           FontSize="12" FontWeight="Bold" Foreground="#991B1B"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="10" Text="{Binding TotalSellValue, StringFormat={}{0:N0}}"
                                                           FontSize="12" FontWeight="Bold" Foreground="#166534"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                <Border Grid.Column="11" Background="#DCFCE7" CornerRadius="6"
                                                        Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Stock}" FontSize="12" FontWeight="Bold" Foreground="#166534"/>
                                                </Border>
                                                <Border Grid.Column="12" Background="#FEE2E2" CornerRadius="6"
                                                        Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Used}" FontSize="12" FontWeight="Bold" Foreground="#991B1B"/>
                                                </Border>
                                                <Border Grid.Column="13" Background="#FEF3C7" CornerRadius="6"
                                                        Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Balance}" FontSize="12" FontWeight="Bold" Foreground="#92400E"/>
                                                </Border>
                                                <StackPanel Grid.Column="14" Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="Buy" Style="{StaticResource ActionBtn}" Background="#10B981"
                                                            Command="{Binding DataContext.BuyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Use" Style="{StaticResource ActionBtn}" Background="#3B82F6"
                                                            Command="{Binding DataContext.UseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Edit" Style="{StaticResource ActionBtn}" Background="#F59E0B"
                                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Del" Style="{StaticResource ActionBtn}" Background="#EF4444"
                                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Empty state -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="📦" FontSize="72" HorizontalAlignment="Center" Opacity="0.4"/>
                            <TextBlock Text="No glass sheets yet" FontSize="20" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,20,0,8"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="Click '+ Add New' to add your first glass sheet"
                                       FontSize="13" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>