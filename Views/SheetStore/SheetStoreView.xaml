<!-- ═══════════════════════════════════════════════════════════════
     SHEET STORE — restructured layout
     The main DataGrid list is the priority. Stats no longer crowd the
     top; instead a detail/stats panel slides in from the right when a
     row is clicked (single click opens, clicking the same row closes).
     The action menu (Refresh/Import/CSV/Excel/PDF/History/Add) stays.
═══════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- Dropdown menu for the grouped header actions (Refresh/Import/
             CSV/Excel/PDF/History). Lives in Resources because a ContextMenu
             cannot be a logical/visual child of a panel. -->
        <ContextMenu x:Key="ActionsMenu"
                     Placement="Bottom"
                     Style="{StaticResource ModernContextMenuStyle}">
            <MenuItem Header="Refresh Data"
                      Tag="&#xE72C;"
                      Style="{StaticResource ModernMenuItemStyle}"
                      Command="{Binding RefreshCommand}"/>
            <MenuItem Header="Import from CSV"
                      Tag="&#xE896;"
                      Style="{StaticResource ModernMenuItemStyle}"
                      Command="{Binding ImportCsvCommand}"/>
            <Separator Style="{StaticResource ModernMenuSeparatorStyle}"/>
            <MenuItem Header="Export CSV"
                      Tag="&#xE72D;"
                      Style="{StaticResource ModernMenuItemStyle}"
                      Command="{Binding ExportCsvCommand}"/>
            <MenuItem Header="Export Excel"
                      Tag="&#xE9F9;"
                      Style="{StaticResource ModernMenuItemStyle}"
                      Command="{Binding ExportExcelCommand}"/>
            <MenuItem Header="Export PDF Report"
                      Tag="&#xE8A5;"
                      Style="{StaticResource ModernMenuItemStyle}"
                      Command="{Binding ExportPdfCommand}"/>
            <Separator Style="{StaticResource ModernMenuSeparatorStyle}"/>
            <MenuItem Header="Show History"
                      Tag="&#xE81C;"
                      Style="{StaticResource ModernMenuItemStyle}"
                      Command="{Binding ShowHistoryCommand}"/>
        </ContextMenu>

        <Style x:Key="StatBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- Data row style with hover -->
        <Style x:Key="DataRowStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius"
                    Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ListBoxItem — strips default WPF selection padding -->
        <Style x:Key="SheetListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ══════════════════════════════════════════════════════════════
         ROOT LAYOUT — compact header + filters + main grid + slide panel
    ══════════════════════════════════════════════════════════════ -->
    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header + filters -->
            <RowDefinition Height="*"/>
            <!-- Main content (grid + right slide panel) -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             STICKY HEADER (compact)
        ═══════════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="24,16,24,0">

            <!-- HEADER + ACTION MENU -->
            <DockPanel Margin="8,0,8,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SHEET STORE"
                                   Style="{StaticResource ModulePageTitleStyle}"/>
                        <Border Background="{DynamicResource AccentBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="10,4"
                                VerticalAlignment="Center" Margin="14,6,0,0">
                            <TextBlock Text="INVENTORY" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Stock Management &amp; Pricing System"
                               Style="{StaticResource ModulePageSubtitleStyle}"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">

                    <!-- ACTION MENU — a single button that opens a dropdown of
                         the 6 secondary actions (Refresh/Import/CSV/Excel/PDF/
                         History). ADD NEW stays outside as a primary button. -->
                    <Button x:Name="ActionsMenuButton"
                            Style="{StaticResource OutlinedPillButton}"
                            Tag="&#xE712;" Content="ACTIONS"
                            ToolTip="More actions"
                            Click="ActionsMenuButton_Click"/>
                    <Button Style="{StaticResource PrimaryPillButton}"
                            Tag="&#xE710;" Content="ADD NEW"
                            ToolTip="Add a new glass sheet"
                            Command="{Binding AddCommand}"/>
                </StackPanel>
            </DockPanel>

            <!-- FILTERS + SORT + SEARCH -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="12" Padding="16,12" Margin="8,0,8,12"
                    SnapsToDevicePixels="True">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CATEGORY" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="4,0,0,4"/>
                            <ComboBox ItemsSource="{Binding CategoryOptions}"
                                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                      Height="32" Padding="10,6" FontSize="12"
                                      Background="{DynamicResource MenuHoverBrush}"
                                      Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="THICKNESS" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="4,0,0,4"/>
                            <ComboBox ItemsSource="{Binding ThicknessOptions}"
                                      SelectedItem="{Binding SelectedThickness, Mode=TwoWay}"
                                      Height="32" Padding="10,6" FontSize="12"
                                      Background="{DynamicResource MenuHoverBrush}"
                                      Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="COLOR" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="4,0,0,4"/>
                            <ComboBox ItemsSource="{Binding ColorOptions}"
                                      SelectedItem="{Binding SelectedColor, Mode=TwoWay}"
                                      Height="32" Padding="10,6" FontSize="12"
                                      Background="{DynamicResource MenuHoverBrush}"
                                      Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="SUPPLIER" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="4,0,0,4"/>
                            <ComboBox ItemsSource="{Binding SupplierOptions}"
                                      SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                                      Height="32" Padding="10,6" FontSize="12"
                                      Background="{DynamicResource MenuHoverBrush}"
                                      Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="8">
                            <TextBlock Text="SORT BY" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,4"/>
                            <ComboBox ItemsSource="{Binding SortOptions}"
                                      SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                                      Height="32" Padding="10,6" FontSize="12"
                                      Background="{DynamicResource MenuHoverBrush}"
                                      Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="10" VerticalAlignment="Bottom">
                            <TextBlock Text=" " FontSize="11" Margin="0,0,0,4"/>
                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Tag="&#xE711;" Content="CLEAR"
                                    ToolTip="Clear all filters"
                                    MinWidth="92"
                                    Command="{Binding ClearFiltersCommand}"
                                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>

                    <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}"
                            Background="{DynamicResource MenuHoverBrush}"
                            CornerRadius="8" Padding="12,7" Margin="0,10,0,0"
                            SnapsToDevicePixels="True">
                        <DockPanel>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent"
                                     FontSize="13" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                     VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- TOTAL INVENTORY STATS — always visible aggregate summary -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="12" Padding="14,10" Margin="8,0,8,12"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0"
                                Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="TOTAL INVENTORY" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,28,0">
                        <TextBlock Text="ITEMS" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding TotalItems}" Style="{StaticResource StatValue}" FontSize="16"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,28,0">
                        <TextBlock Text="STOCK" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding TotalStock}" Style="{StaticResource StatValue}" FontSize="16" Foreground="{DynamicResource SuccessBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="0,0,28,0">
                        <TextBlock Text="BUYING VALUE" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding TotalBuyingValue, StringFormat={}{0:N0} AED}" Style="{StaticResource StatValue}" FontSize="16" Foreground="{DynamicResource DangerBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="5">
                        <TextBlock Text="SELLING VALUE" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding TotalSellingValue, StringFormat={}{0:N0} AED}" Style="{StaticResource StatValue}" FontSize="16" Foreground="{DynamicResource SuccessBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ═══════════════════════════════════════════════════════════
             MAIN CONTENT — DataGrid list (priority) + right slide panel
        ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="24,0,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!-- Animated panel column: width 0 when closed, expands to
                     376 (360 panel + 16 margin) when a row is selected. -->
                <ColumnDefinition x:Name="DetailColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- ══ MAIN LIST (DataGrid) ══ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Sticky column header -->
                <Border Grid.Row="0"
                        Background="{DynamicResource AccentBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="14,14,0,0" Padding="12,10"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="104"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="66"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="52"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="#" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Grid.Column="1" Text="CATEGORY" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Grid.Column="2" Text="THICK" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Grid.Column="3" Text="COLOR" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Grid.Column="4" Text="SIZE" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Grid.Column="5" Text="SUPPLIER" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Grid.Column="6" Text="SQM" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="7" Text="BUY/SQM" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="8" Text="SELL/SQM" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="9" Text="TOTAL BUY" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="10" Text="TOTAL SELL" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="11" Text="STOCK" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="12" Text="USED" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="13" Text="BAL" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Virtualized sheet rows -->
                <Border Grid.Row="1"
                        Background="{DynamicResource ModuleBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="1,0,1,1"
                        CornerRadius="0,0,14,14"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <ListBox ItemsSource="{Binding Sheets}"
                                 ItemContainerStyle="{StaticResource SheetListBoxItemStyle}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="10,6,10,10"
                                 Focusable="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.IsDeferredScrollingEnabled="False"
                                 ScrollViewer.PanningMode="None"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingStackPanel.ScrollUnit="Item"
                                 VirtualizingStackPanel.CacheLength="1,2"
                                 VirtualizingStackPanel.CacheLengthUnit="Page"
                                 behaviors:SmoothScrollBehavior.IsEnabled="True"
                                 Visibility="{Binding HasSheets, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DataRowStyle}"
                                            MouseLeftButtonDown="Row_Click"
                                            Tag="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="78"/>
                                                <ColumnDefinition Width="104"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="66"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="88"/>
                                                <ColumnDefinition Width="88"/>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="52"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="12"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Category}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ThicknessDisplay}" FontSize="12" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Color}" FontSize="12"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding SizeDisplay}" FontSize="12"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Supplier}" FontSize="12"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Supplier}"/>
                                            <TextBlock Grid.Column="6" Text="{Binding SqmPerSheet, StringFormat={}{0:N4}}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="7" Text="{Binding PurchasePricePerSqm, StringFormat={}{0:0.##}}"
                                                       FontSize="12" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="8" Text="{Binding SellPricePerSqm, StringFormat={}{0:0.##}}"
                                                       FontSize="12" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="9" Text="{Binding TotalPurchaseValue, StringFormat={}{0:N0}}"
                                                       FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="10" Text="{Binding TotalSellValue, StringFormat={}{0:N0}}"
                                                       FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Grid.Column="11"
                                                    Background="{DynamicResource TintGreenBrush}" CornerRadius="6"
                                                    Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Stock}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                            </Border>
                                            <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Grid.Column="12"
                                                    Background="{DynamicResource TintRedBrush}" CornerRadius="6"
                                                    Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Used}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                                            </Border>
                                            <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Grid.Column="13"
                                                    Background="{DynamicResource TintAmberBrush}" CornerRadius="6"
                                                    Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Balance}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty state -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                            <emptyState:EmptyStateControl
                                Icon="&#xE7B8;"
                                Title="No glass sheets yet"
                                Message="The Sheet Store is your raw-glass inventory — sizes, thicknesses, colours, stock and value. Click '+ Add New' to add your first glass sheet."/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══ RIGHT SLIDE-IN DETAIL / STATS PANEL ══
                 Collapsed by default so the main grid is full-width. It slides
                 in only when a row is selected (see code-behind). Full-height
                 pill-style panel showing TOTAL buy / sell / profit plus the
                 selected row's stock and its actions. -->
            <Grid x:Name="DetailPanel" Grid.Column="1" Margin="14,0,0,0"
                  Visibility="Collapsed">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="PanelSlide" X="0"/>
                </Grid.RenderTransform>

                <Border Width="360"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource ModuleBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="22"
                        Padding="20"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="5"
                                          Direction="270" Opacity="0.18"
                                          Color="#000000"/>
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Panel header — close button pinned to the far
                                 right corner so it never overlaps the content. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="20"
                                        Grid.Column="0"
                                        Background="{DynamicResource AccentBrush}">
                                    <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="17" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                            Margin="12,0,10,0">
                                    <TextBlock Text="SHEET DETAILS"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding SelectionLabel}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Style="{StaticResource RowOutlinedButton}"
                                        Tag="&#xE711;" Content=""
                                        VerticalAlignment="Top"
                                        ToolTip="Close (click the row again)"
                                        Command="{Binding ClearSelectionCommand}"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource OutlineBrush}" Margin="0,16,0,16"/>

                            <!-- TOTAL PURCHASE / SELLING / PROFIT — clean cards
                                 matching the top-panel pill-button shape (radius
                                 20) instead of oversized pills. -->
                            <TextBlock Text="TOTAL INVENTORY"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="4,0,0,8"/>
                            <Border CornerRadius="20" Padding="16,12"
                                    Margin="0,0,0,10"
                                    Background="{DynamicResource TintRedBrush}"
                                    BorderBrush="{DynamicResource DangerBrush}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="TOTAL PURCHASE" Style="{StaticResource StatLabel}" Foreground="{DynamicResource DangerBrush}"/>
                                        <TextBlock Text="{Binding TotalBuyingValue, StringFormat={}{0:N0} AED}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="20" Padding="16,12"
                                    Margin="0,0,0,10"
                                    Background="{DynamicResource TintGreenBrush}"
                                    BorderBrush="{DynamicResource SuccessBrush}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="TOTAL SELLING" Style="{StaticResource StatLabel}" Foreground="{DynamicResource SuccessBrush}"/>
                                        <TextBlock Text="{Binding TotalSellingValue, StringFormat={}{0:N0} AED}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="20" Padding="16,12"
                                    Margin="0,0,0,16"
                                    Background="{DynamicResource TintBlueBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="EXPECTED PROFIT" Style="{StaticResource StatLabel}" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="{Binding TotalProfit, StringFormat={}{0:N0} AED}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Selected row stock cards (radius 20, matching pills) -->
                            <TextBlock Text="SELECTED ROW"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="4,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="20" Padding="12,10"
                                        Margin="0,0,4,10"
                                        Background="{DynamicResource TintGreenBrush}"
                                        BorderBrush="{DynamicResource SuccessBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="STOCK" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                        <TextBlock Text="{Binding DisplayStock}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" CornerRadius="20" Padding="12,10"
                                        Margin="4,0,0,10"
                                        Background="{DynamicResource TintAmberBrush}"
                                        BorderBrush="{DynamicResource WarningBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="BALANCE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                        <TextBlock Text="{Binding DisplayBalance}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource OutlineBrush}" Margin="0,4,0,16"/>

                            <!-- Row actions -->
                            <TextBlock Text="ACTIONS"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="4,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource RowSuccessButton}"
                                        Tag="&#xE7B8;" Content="BUY"
                                        Command="{Binding BuyCommand}"
                                        CommandParameter="{Binding SelectedSheet}"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource RowPrimaryButton}"
                                        Tag="&#xE896;" Content="USE"
                                        Command="{Binding UseCommand}"
                                        CommandParameter="{Binding SelectedSheet}"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource RowOutlinedButton}"
                                        Tag="&#xE8E5;" Content="EDIT"
                                        Command="{Binding EditCommand}"
                                        CommandParameter="{Binding SelectedSheet}"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource RowDangerButton}"
                                        Tag="&#xE74D;" Content="DELETE"
                                        Command="{Binding DeleteCommand}"
                                        CommandParameter="{Binding SelectedSheet}"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
