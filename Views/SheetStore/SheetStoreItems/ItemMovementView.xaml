<dialogs:ThemedDialogWindow x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreItems.ItemMovementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
        xmlns:dialogs="clr-namespace:ProGlassAutomation.Views.Shared.Dialogs"
        Title="{Binding DialogTitle}"
        Width="480"
        DialogIcon="&#xE7B8;"
        DialogSubtitle="{Binding AvailableLabel}"
             FontFamily="{DynamicResource AppFontFamily}">

    <Window.Resources>
        <!-- Migrated FieldLabelStyle to global SurfacePrimaryStyle / Typography -->

        <!-- Shared entry chrome: red outline while the field is rejected.
             The inline message alone is easy to miss on a dense form. -->
        <!-- Migrated ErrorAwareEntry to global Input.TextBox -->
    
                            </TextBox.Style>
                        </TextBox>

                        <TextBlock Text="{Binding QuantityError}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                   FontWeight="{DynamicResource Weight.SemiBold}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasQuantityError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Unit price — receipts only. Prefilled with the current
                     price because the common case is a repeat order; still
                     editable because a delivery often reprices. -->
                <Border Background="{DynamicResource SurfacePrimaryBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadius}" Padding="20,16" Margin="0,0,0,16"
                        SnapsToDevicePixels="True" Style="{StaticResource SurfacePrimaryStyle}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowUnitPrice}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="UNIT PRICE (AED)" Style="{StaticResource Typography.Label}"
                                   Margin="0,0,0,8"/>
                        <TextBox Text="{Binding UnitPriceText, UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:TextBoxBehaviors.SelectAllOnFocus="True"
                                 behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                 FontSize="{DynamicResource FontSize.H2}" FontWeight="{DynamicResource Weight.Bold}" Style="{StaticResource TextBoxStyle}">
                            <TextBox.Style Style="{StaticResource TextBoxStyle}">
                                <Style TargetType="TextBox" BasedOn="{StaticResource Input.TextBox}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUnitPriceError}" Value="True">
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Text="{Binding UnitPriceError}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                   FontWeight="{DynamicResource Weight.SemiBold}" TextWrapping="Wrap" Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUnitPriceError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Resulting balance. Shown only once the entry parses,
                     so it never displays a figure derived from junk. -->
                <Border Background="{DynamicResource DialogInsetBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadius}" Padding="16,12" Margin="0,0,0,12"
                        SnapsToDevicePixels="True" Style="{StaticResource SurfacePrimaryStyle}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowPreview}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Balance after " FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="{Binding BalanceAfterDisplay}"
                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Movement value " FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="{Binding MovementValue, StringFormat={}{0:N2} AED}"
                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Reorder warning — advisory, never blocking. Running low
                     is allowed; being surprised by it is the problem. -->
                <Border Background="{DynamicResource DialogInsetBrush}"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CardCornerRadius}" Padding="14,10" Margin="0,0,0,12"
                        SnapsToDevicePixels="True" Style="{StaticResource SurfacePrimaryStyle}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasReorderWarning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ReorderWarning}" TextWrapping="Wrap"
                               FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.SemiBold}"
                               Foreground="{DynamicResource WarningBrush}"/>
                </Border>

    </StackPanel>

    <dialogs:ThemedDialogWindow.FooterContent>
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource OutlinedPillButton}"
                    Tag="&#xE711;" Content="{DynamicResource Action.Cancel}"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"/>
            <Button Grid.Column="2" Style="{StaticResource PrimaryPillButton}"
                    Tag="&#xE73E;" Content="{Binding ActionLabel}"
                    Command="{Binding ConfirmCommand}"
                    IsDefault="True"/>
        </Grid>
    </dialogs:ThemedDialogWindow.FooterContent>
</dialogs:ThemedDialogWindow>
