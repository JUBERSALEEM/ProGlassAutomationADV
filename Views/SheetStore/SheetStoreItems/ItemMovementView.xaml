<Window x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreItems.ItemMovementView"
        TextOptions.TextHintingMode="Fixed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
        Title="{Binding DialogTitle}"
        Width="480"
        MinWidth="480"
        MinHeight="480"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="Transparent"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- Standard dialog: Esc → Cancel · Enter → Confirm -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
        <KeyBinding Key="Enter" Command="{Binding ConfirmCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
        </Style>

        <!-- Shared entry chrome: red outline while the field is rejected.
             The inline message alone is easy to miss on a dense form. -->
        <Style x:Key="ErrorAwareEntry" TargetType="TextBox">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource DialogInsetBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        </Style>
    </Window.Resources>

    <Border Margin="18"
            CornerRadius="{DynamicResource CardCornerRadiusLarge}"
            Background="{DynamicResource DialogSurfaceBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="1"
            Padding="4,4,4,4"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24"
                              ShadowDepth="0" Opacity="0.45"/>
        </Border.Effect>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      IsDeferredScrollingEnabled="False"
                      PanningMode="None"
                      Focusable="True"
                      FocusVisualStyle="{x:Null}"
                      Background="Transparent"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">
            <StackPanel Margin="24">

                <!-- Header -->
                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="{StaticResource TextDisplay}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DialogTitle}" FontSize="{StaticResource TextHeadline}"
                                   FontWeight="Bold" Margin="12,0,0,0"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding AvailableLabel}"
                               FontSize="{StaticResource TextBody}" Margin="0,4,0,0"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>

                <!-- Item info card -->
                <Border Background="{DynamicResource DialogInsetBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadius}" Padding="16,14" Margin="0,0,0,16"
                        SnapsToDevicePixels="True">
                    <StackPanel>
                        <TextBlock Text="{Binding Item.CategoryDisplay}"
                                   FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{Binding ItemLabel}" FontSize="{StaticResource TextBody}"
                                   FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Stock " FontSize="{StaticResource TextBody}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="{Binding Item.Stock, StringFormat={}{0:N2}}"
                                       FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="  Used " FontSize="{StaticResource TextBody}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="{Binding Item.Used, StringFormat={}{0:N2}}"
                                       FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                       Foreground="{DynamicResource DangerBrush}"/>
                            <TextBlock Text="  Balance " FontSize="{StaticResource TextBody}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="{Binding Item.BalanceDisplay}"
                                       FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Quantity — DECIMAL, unlike the glass dialogs: you
                     genuinely receive 45.55 LM of spacer bar. -->
                <Border Background="{DynamicResource ModuleBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadius}" Padding="20,16" Margin="0,0,0,16"
                        SnapsToDevicePixels="True">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="QUANTITY" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock Text="{Binding UomLabel}" Margin="6,0,0,0"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>

                        <!-- Bound to RAW TEXT, not the decimal. A decimal
                             binding cannot observe an empty box: conversion
                             fails, the setter never runs, and the stale
                             value survives behind an empty control. -->
                        <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:TextBoxBehaviors.SelectAllOnFocus="True"
                                 behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                 FontSize="{StaticResource TextDisplayLarge}" FontWeight="Bold"
                                 TextAlignment="Center">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource ErrorAwareEntry}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasQuantityError}" Value="True">
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <TextBlock Text="{Binding QuantityError}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontSize="{StaticResource TextCaption}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasQuantityError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Unit price — receipts only. Prefilled with the current
                     price because the common case is a repeat order; still
                     editable because a delivery often reprices. -->
                <Border Background="{DynamicResource ModuleBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadius}" Padding="20,16" Margin="0,0,0,16"
                        SnapsToDevicePixels="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowUnitPrice}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="UNIT PRICE (AED)" Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,0,0,8"/>
                        <TextBox Text="{Binding UnitPriceText, UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:TextBoxBehaviors.SelectAllOnFocus="True"
                                 behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                 FontSize="{StaticResource TextTitle}" FontWeight="Bold">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource ErrorAwareEntry}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUnitPriceError}" Value="True">
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Text="{Binding UnitPriceError}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontSize="{StaticResource TextCaption}"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUnitPriceError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Resulting balance. Shown only once the entry parses,
                     so it never displays a figure derived from junk. -->
                <Border Background="{DynamicResource DialogInsetBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="{DynamicResource CardCornerRadius}" Padding="16,12" Margin="0,0,0,12"
                        SnapsToDevicePixels="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowPreview}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Balance after " FontSize="{StaticResource TextBody}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="{Binding BalanceAfterDisplay}"
                                       FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Movement value " FontSize="{StaticResource TextBody}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="{Binding MovementValue, StringFormat={}{0:N2} AED}"
                                       FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Reorder warning — advisory, never blocking. Running low
                     is allowed; being surprised by it is the problem. -->
                <Border Background="{DynamicResource DialogInsetBrush}"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource CardCornerRadius}" Padding="14,10" Margin="0,0,0,12"
                        SnapsToDevicePixels="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasReorderWarning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ReorderWarning}" TextWrapping="Wrap"
                               FontSize="{StaticResource TextCaption}" FontWeight="SemiBold"
                               Foreground="{DynamicResource WarningBrush}"/>
                </Border>

                <!-- Actions. Confirm is GATED on CanConfirm, not merely
                     styled as disabled — the 0-quantity bug was exactly a
                     dialog that closed and silently recorded nothing. -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource OutlinedPillButton}"
                            Content="CANCEL" Command="{Binding CancelCommand}"/>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryPillButton}"
                            Content="{Binding ActionLabel}" Command="{Binding ConfirmCommand}"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
