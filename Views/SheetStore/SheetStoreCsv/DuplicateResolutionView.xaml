<!-- ═══════════════════════════════════════════════════════════════
     CSV DUPLICATE RESOLUTION — Indigo Studio Bento Redesign
     Clean Bento comparison card, standardized 36px action buttons.
═══════════════════════════════════════════════════════════════ -->
<dialogs:ThemedDialogWindow x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreCsv.DuplicateResolutionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:ProGlassAutomation.Views.Shared.Dialogs"
             Title="{DynamicResource SheetStore.DuplicateSheetDetected}"
             Width="780" Height="620"
             MinWidth="640" MinHeight="460"
             ResizeMode="CanResize"
             DialogIcon="&#xE7BA;"
             DialogIconBrush="{DynamicResource WarningBrush}"
             DialogSubtitle="{DynamicResource SheetStore.SheetAlreadyExistsChooseHowHandle}"
             FontFamily="{DynamicResource AppFontFamily}">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelImportCommand}"/>
    </Window.InputBindings>

    <StackPanel>
        <TextBlock Text="{Binding HeaderText}"
                   Style="{StaticResource Ov.Meta}"
                   FontWeight="{DynamicResource Weight.Bold}"
                   Foreground="{DynamicResource AccentBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <!-- Sheet Identity Chip -->
        <Border Style="{StaticResource Ov.CardMicro}" Padding="12,8" Margin="0,0,0,10">
            <TextBlock Text="{Binding SheetLabel}"
                       Style="{StaticResource Ov.CardTitle}"
                       FontSize="16"/>
        </Border>

        <!-- Bento Comparison Grid -->
        <Border Style="{StaticResource Ov.CardCompact}" Padding="0" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Headers -->
                <Border Grid.Row="0" Grid.Column="0"
                        Background="{DynamicResource Ov.Soft}"
                        Padding="12,10" CornerRadius="10,0,0,0">
                    <TextBlock Text="{DynamicResource SheetStore.Field}" Style="{StaticResource Ov.Meta}" FontWeight="{DynamicResource Weight.Bold}"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="1"
                        Background="{DynamicResource AccentBrush}"
                        Padding="12,10">
                    <TextBlock Text="{DynamicResource SheetStore.ExistingDB}"
                               FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="2"
                        Background="{DynamicResource WarningBrush}"
                        Padding="12,10" CornerRadius="0,10,0,0">
                    <TextBlock Text="{DynamicResource SheetStore.IncomingCSV}"
                               FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                </Border>

                <!-- Purchase Price -->
                <Border Grid.Row="1" Grid.Column="0" BorderBrush="{DynamicResource Ov.Line}" BorderThickness="0,1,0,0" Padding="12,8">
                    <TextBlock Text="{DynamicResource SheetStore.PurchaseSQM}" Style="{StaticResource Ov.Meta}"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource Ov.Line}" BorderThickness="0,1,0,0" Padding="12,8">
                    <TextBlock Text="{Binding Existing.PurchasePricePerSqm, StringFormat={}{0:0.##} AED}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" BorderBrush="{DynamicResource Ov.Line}" BorderThickness="0,1,0,0" Padding="12,8">
                    <TextBlock Text="{Binding Incoming.PurchasePricePerSqm, StringFormat={}{0:0.##} AED}" FontSize="{DynamicResource FontSize.Body}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BuyPriceDifferent}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- Sell Price -->
                <Border Grid.Row="2" Grid.Column="0" BorderBrush="{DynamicResource Ov.Line}" BorderThickness="0,1,0,0" Padding="12,8">
                    <TextBlock Text="{DynamicResource SheetStore.SELLSQM}" Style="{StaticResource Ov.Meta}"/>
                </Border>
                <Border Grid.Row="2" Grid.Column="1" BorderBrush="{DynamicResource Ov.Line}" BorderThickness="0,1,0,0" Padding="12,8">
                    <TextBlock Text="{Binding Existing.SellPricePerSqm, StringFormat={}{0:0.##} AED}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"/>
                </Border>
                <Border Grid.Row="2" Grid.Column="2" BorderBrush="{DynamicResource Ov.Line}" BorderThickness="0,1,0,0" Padding="12,8">
                    <TextBlock Text="{Binding Incoming.SellPricePerSqm, StringFormat={}{0:0.##} AED}" FontSize="{DynamicResource FontSize.Body}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SellPriceDifferent}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- Stock -->
                <Border Grid.Row="3" Grid.Column="0" BorderBrush="{DynamicResource Ov.Line}" BorderThickness="0,1,0,0" Padding="12,8">
                    <TextBlock Text="{DynamicResource SheetStore.Stock}" Style="{StaticResource Ov.Meta}"/>
                </Border>
                <Border Grid.Row="3" Grid.Column="1" BorderBrush="{DynamicResource Ov.Line}" BorderThickness="0,1,0,0" Padding="12,8">
                    <TextBlock Text="{Binding Existing.Stock}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"/>
                </Border>
                <Border Grid.Row="3" Grid.Column="2" BorderBrush="{DynamicResource Ov.Line}" BorderThickness="0,1,0,0" Padding="12,8">
                    <TextBlock Text="{Binding Incoming.Stock}" FontSize="{DynamicResource FontSize.Body}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StockDifferent}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- Used -->
                <Border Grid.Row="4" Grid.Column="0" BorderBrush="{DynamicResource Ov.Line}" BorderThickness="0,1,0,0" Padding="12,8">
                    <TextBlock Text="{DynamicResource SheetStore.USED}" Style="{StaticResource Ov.Meta}"/>
                </Border>
                <Border Grid.Row="4" Grid.Column="1" BorderBrush="{DynamicResource Ov.Line}" BorderThickness="0,1,0,0" Padding="12,8">
                    <TextBlock Text="{Binding Existing.Used}" FontSize="{DynamicResource FontSize.Body}"/>
                </Border>
                <Border Grid.Row="4" Grid.Column="2" BorderBrush="{DynamicResource Ov.Line}" BorderThickness="0,1,0,0" Padding="12,8">
                    <TextBlock Text="{Binding Incoming.Used}" FontSize="{DynamicResource FontSize.Body}"/>
                </Border>

                <!-- Balance -->
                <Border Grid.Row="5" Grid.Column="0" BorderBrush="{DynamicResource Ov.Line}" BorderThickness="0,1,0,0" Padding="12,8">
                    <TextBlock Text="{DynamicResource Common.Balance}" Style="{StaticResource Ov.Meta}"/>
                </Border>
                <Border Grid.Row="5" Grid.Column="1" BorderBrush="{DynamicResource Ov.Line}" BorderThickness="0,1,0,0" Padding="12,8">
                    <TextBlock Text="{Binding Existing.Balance}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource SuccessBrush}"/>
                </Border>
                <Border Grid.Row="5" Grid.Column="2" BorderBrush="{DynamicResource Ov.Line}" BorderThickness="0,1,0,0" Padding="12,8">
                    <TextBlock Text="{Binding Incoming.Balance}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Apply to all checkbox -->
        <CheckBox Content="{DynamicResource SheetStore.ApplyActionRemainingDuplicates}"
                  IsChecked="{Binding ApplyToRemaining, Mode=TwoWay}"
                  FontSize="{DynamicResource FontSize.Body}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  Margin="2,4,0,8"
                  Cursor="Hand"/>
    </StackPanel>

    <dialogs:ThemedDialogWindow.FooterContent>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource OutlinedPillButton}"
                    Height="36"
                    Tag="&#xE711;" Content="{DynamicResource SheetStore.SKIP}"
                    ToolTip="{DynamicResource SheetStore.IgnoreRowKeepExistingSheetUnchangedEscCancel}"
                    Command="{Binding SkipCommand}"/>

            <Button Grid.Column="2" Style="{StaticResource SuccessPillButton}"
                    Height="36"
                    Tag="&#xE710;" Content="{DynamicResource SheetStore.ADDStock}"
                    ToolTip="{DynamicResource SheetStore.AddIncomingStockExistingKeepsPrices}"
                    Command="{Binding AddToStockCommand}"/>

            <Button Grid.Column="4" Style="{StaticResource PrimaryPillButton}"
                    Height="36"
                    Tag="&#xE895;" Content="{DynamicResource SheetStore.Update}"
                    ToolTip="{DynamicResource SheetStore.OverwriteFieldsIncomingValues}"
                    Command="{Binding UpdateAllCommand}"/>

            <Button Grid.Column="6" Style="{StaticResource DangerButton}"
                    Height="36"
                    Tag="&#xE711;" Content="{DynamicResource SheetStore.CancelImport}"
                    ToolTip="{DynamicResource SheetStore.StopEntireImportPressEsc}"
                    Command="{Binding CancelImportCommand}"
                    IsCancel="True"/>
        </Grid>
    </dialogs:ThemedDialogWindow.FooterContent>
</dialogs:ThemedDialogWindow>