<!-- ═══════════════════════════════════════════════════════════════
     SHEET STORE — Duplicate Sheet Resolution Dialog
     Bento Design System: Side-by-side comparison Bento cards,
     clear conflict highlighting, standardized 36px action buttons.
═══════════════════════════════════════════════════════════════ -->
<dialogs:ThemedDialogWindow x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreCsv.DuplicateResolutionView"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:dialogs="clr-namespace:ProGlassAutomation.Views.Shared.Dialogs"
                            Title="{DynamicResource SheetStore.DuplicateSheetDetected}"
                            Width="780" Height="620"
                            MinWidth="640" MinHeight="480"
                            ResizeMode="CanResize"
                            DialogIcon="&#xE7BA;"
                            DialogIconBrush="{DynamicResource WarningBrush}"
                            DialogSubtitle="{DynamicResource SheetStore.SheetAlreadyExistsChooseHowHandle}"
                            FontFamily="{DynamicResource AppFontFamily}">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelImportCommand}"/>
    </Window.InputBindings>

    <dialogs:ThemedDialogWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Dashboard/Overview/IndigoStudioResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </dialogs:ThemedDialogWindow.Resources>

    <StackPanel>
        <TextBlock Text="{Binding HeaderText}"
                   Style="{StaticResource Ov.CardTitle}"
                   Foreground="{DynamicResource Ov.Accent}"
                   Margin="0,0,0,8"/>

        <!-- Sheet Identity Bento Pill -->
        <Border Style="{StaticResource Ov.CardMicro}"
                Background="{DynamicResource Ov.Soft}"
                Margin="0,0,0,12">
            <TextBlock Text="{Binding SheetLabel}"
                       Style="{StaticResource Ov.Text}"
                       FontWeight="{DynamicResource Weight.SemiBold}"/>
        </Border>

        <!-- Side-by-side Comparison Bento Card -->
        <Border Style="{StaticResource Ov.CardCompact}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Headers -->
                <Border Grid.Row="0" Grid.Column="0"
                        Background="{DynamicResource Ov.Soft}"
                        Padding="12,10" CornerRadius="8,0,0,8">
                    <TextBlock Text="{DynamicResource SheetStore.Field}" Style="{StaticResource Ov.Meta}"
                               FontWeight="{DynamicResource Weight.Bold}" HorizontalAlignment="Center"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="1"
                        Background="{DynamicResource Ov.Accent}"
                        Padding="12,10">
                    <TextBlock Text="{DynamicResource SheetStore.ExistingDB}" Style="{StaticResource Ov.Meta}"
                               FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.OnAccent}"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="2"
                        Background="{DynamicResource Ov.Warning}"
                        Padding="12,10" CornerRadius="0,8,8,0">
                    <TextBlock Text="{DynamicResource SheetStore.IncomingCSV}" Style="{StaticResource Ov.Meta}"
                               FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.OnAccent}"/>
                </Border>

                <!-- Purchase Price -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource SheetStore.PurchaseSQM}"
                           Style="{StaticResource Ov.Meta}" Margin="12,10,0,10" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding Existing.PurchasePricePerSqm, StringFormat={}{0:0.##} AED}"
                           Style="{StaticResource Ov.Text}" FontWeight="{DynamicResource Weight.SemiBold}"
                           Margin="12,10,0,10" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="2"
                           Text="{Binding Incoming.PurchasePricePerSqm, StringFormat={}{0:0.##} AED}"
                           Style="{StaticResource Ov.Text}"
                           Margin="12,10,0,10" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Ov.Text}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BuyPriceDifferent}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Ov.Danger}"/>
                                    <Setter Property="FontWeight" Value="{DynamicResource Weight.Bold}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Sell Price -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource SheetStore.SELLSQM}"
                           Style="{StaticResource Ov.Meta}" Margin="12,10,0,10" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{Binding Existing.SellPricePerSqm, StringFormat={}{0:0.##} AED}"
                           Style="{StaticResource Ov.Text}" FontWeight="{DynamicResource Weight.SemiBold}"
                           Margin="12,10,0,10" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="2"
                           Text="{Binding Incoming.SellPricePerSqm, StringFormat={}{0:0.##} AED}"
                           Style="{StaticResource Ov.Text}"
                           Margin="12,10,0,10" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Ov.Text}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SellPriceDifferent}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Ov.Danger}"/>
                                    <Setter Property="FontWeight" Value="{DynamicResource Weight.Bold}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Stock -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource SheetStore.Stock}"
                           Style="{StaticResource Ov.Meta}" Margin="12,10,0,10" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="3" Grid.Column="1"
                           Text="{Binding Existing.Stock, StringFormat={}{0} Sheets}"
                           Style="{StaticResource Ov.Text}" FontWeight="{DynamicResource Weight.SemiBold}"
                           Margin="12,10,0,10" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="3" Grid.Column="2"
                           Text="{Binding Incoming.Stock, StringFormat={}{0} Sheets}"
                           Style="{StaticResource Ov.Text}"
                           Margin="12,10,0,10" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Ov.Text}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StockDifferent}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Ov.Danger}"/>
                                    <Setter Property="FontWeight" Value="{DynamicResource Weight.Bold}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Used -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource SheetStore.USED}"
                           Style="{StaticResource Ov.Meta}" Margin="12,10,0,10" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="4" Grid.Column="1"
                           Text="{Binding Existing.Used}"
                           Style="{StaticResource Ov.Text}"
                           Margin="12,10,0,10" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="4" Grid.Column="2"
                           Text="{Binding Incoming.Used}"
                           Style="{StaticResource Ov.Text}"
                           Margin="12,10,0,10" VerticalAlignment="Center"/>

                <!-- Balance -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource Common.Balance}"
                           Style="{StaticResource Ov.Meta}" Margin="12,10,0,10" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="5" Grid.Column="1"
                           Text="{Binding Existing.Balance}"
                           Style="{StaticResource Ov.Text}" FontWeight="{DynamicResource Weight.Bold}"
                           Foreground="{DynamicResource Ov.Success}"
                           Margin="12,10,0,10" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="5" Grid.Column="2"
                           Text="{Binding Incoming.Balance}"
                           Style="{StaticResource Ov.Text}" FontWeight="{DynamicResource Weight.Bold}"
                           Foreground="{DynamicResource Ov.Success}"
                           Margin="12,10,0,10" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Apply to All Checkbox -->
        <CheckBox Content="{DynamicResource SheetStore.ApplyActionRemainingDuplicates}"
                  IsChecked="{Binding ApplyToRemaining, Mode=TwoWay}"
                  FontSize="{DynamicResource FontSize.Body}"
                  Foreground="{DynamicResource Ov.Ink}"
                  Margin="4,12,0,8"
                  Cursor="Hand"/>
    </StackPanel>

    <!-- Standardized 36px Footer Buttons -->
    <dialogs:ThemedDialogWindow.FooterContent>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource OutlinedPillButton}"
                    Height="36" Padding="12,0"
                    Tag="&#xE711;" Content="{DynamicResource SheetStore.SKIP}"
                    ToolTip="{DynamicResource SheetStore.IgnoreRowKeepExistingSheetUnchangedEscCancel}"
                    Command="{Binding SkipCommand}"/>

            <Button Grid.Column="2" Style="{StaticResource SuccessPillButton}"
                    Height="36" Padding="12,0"
                    Tag="&#xE710;" Content="{DynamicResource SheetStore.ADDStock}"
                    ToolTip="{DynamicResource SheetStore.AddIncomingStockExistingKeepsPrices}"
                    Command="{Binding AddToStockCommand}"/>

            <Button Grid.Column="4" Style="{StaticResource PrimaryPillButton}"
                    Height="36" Padding="12,0"
                    Tag="&#xE895;" Content="{DynamicResource SheetStore.Update}"
                    ToolTip="{DynamicResource SheetStore.OverwriteFieldsIncomingValues}"
                    Command="{Binding UpdateAllCommand}"/>

            <Button Grid.Column="6" Style="{StaticResource DangerButton}"
                    Height="36" Padding="12,0"
                    Tag="&#xE711;" Content="{DynamicResource SheetStore.CancelImport}"
                    ToolTip="{DynamicResource SheetStore.StopEntireImportPressEsc}"
                    Command="{Binding CancelImportCommand}"
                    IsCancel="True"/>
        </Grid>
    </dialogs:ThemedDialogWindow.FooterContent>
</dialogs:ThemedDialogWindow>
