<!-- ═══════════════════════════════════════════════════════════════
     MIGRATION LOG — Button Standardization (master prompt v1.0)
     Date: 2026-08-15 — SheetStore module batch
     • All buttons -> centralized PrimaryPill/SuccessPill/OutlinedPill/
       DangerButton styles with MDL2 Tag glyphs + UPPERCASE content
     • Removed legacy local styles (ActionBtn, HeaderActionBtn,
       QtyButtonStyle, Cancel/Save/ConfirmButtonStyle,
       FilterActionButtonStyle, CancelImportBtn)
     • Decorative emojis (search/clock/empty/mailbox) -> MDL2 glyphs
     Commands/bindings preserved; no ViewModel changes.
═══════════════════════════════════════════════════════════════ -->
<Window x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreCsv.DuplicateResolutionView"
             TextOptions.TextHintingMode="Fixed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SheetStore.DuplicateSheetDetected}"
        Width="760" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- Standard dialog: Esc → Cancel Import (destructive escape) -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelImportCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="ColumnHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <!-- Action button with hover + press states — critical for destructive dialog -->

        <!-- Cancel Import button — extra emphasis (Bold + slightly darker press) -->
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextDisplay}" VerticalAlignment="Center"/>
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="{DynamicResource SheetStore.DuplicateSheetDetected}"
                               FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="{Binding HeaderText}"
                               FontSize="{StaticResource TextBody}" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="{DynamicResource SheetStore.SheetAlreadyExistsChooseHowHandle}"
                       FontSize="{StaticResource TextBody}" Margin="0,8,0,0"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
        </StackPanel>

        <!-- Sheet identity -->
        <Border Grid.Row="1"
                Background="{DynamicResource MenuHoverBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="{DynamicResource CardBorderThickness}"
                CornerRadius="{DynamicResource ControlCornerRadius}" Padding="14,10" Margin="0,0,0,16"
                SnapsToDevicePixels="True">
            <TextBlock Text="{Binding SheetLabel}"
                       FontSize="{StaticResource TextBodyLarge}" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
        </Border>

        <!-- Comparison grid -->
        <Border Grid.Row="2"
                Background="{DynamicResource ModuleBackgroundBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="{DynamicResource CardBorderThickness}"
                CornerRadius="{DynamicResource CardCornerRadius}" Padding="0"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Headers -->
                <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Grid.Row="0" Grid.Column="0"
                        Background="{DynamicResource MenuHoverBrush}"
                        Padding="10,10" CornerRadius="{DynamicResource Radius.Medium}">
                    <TextBlock Text="{DynamicResource SheetStore.Field}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               HorizontalAlignment="Center"/>
                </Border>
                <Border CornerRadius="{DynamicResource CardCornerRadius}" Grid.Row="0" Grid.Column="1" Background="{DynamicResource AccentBrush}" Padding="10,10">
                    <TextBlock Text="{DynamicResource SheetStore.ExistingDB}" Style="{StaticResource ColumnHeader}"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource WarningBrush}" Padding="10,10"
                        CornerRadius="{DynamicResource Radius.Medium}">
                    <TextBlock Text="{DynamicResource SheetStore.IncomingCSV}" Style="{StaticResource ColumnHeader}"/>
                </Border>

                <!-- Purchase Price -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource SheetStore.PurchaseSQM}" Style="{StaticResource RowLabel}"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding Existing.PurchasePricePerSqm, StringFormat={}{0:0.##}}"
                           Style="{StaticResource RowValue}"/>
                <TextBlock Grid.Row="1" Grid.Column="2"
                           Text="{Binding Incoming.PurchasePricePerSqm, StringFormat={}{0:0.##}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource RowValue}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BuyPriceDifferent}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Sell Price -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource SheetStore.SELLSQM}" Style="{StaticResource RowLabel}"/>
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{Binding Existing.SellPricePerSqm, StringFormat={}{0:0.##}}"
                           Style="{StaticResource RowValue}"/>
                <TextBlock Grid.Row="2" Grid.Column="2"
                           Text="{Binding Incoming.SellPricePerSqm, StringFormat={}{0:0.##}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource RowValue}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SellPriceDifferent}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Stock -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource SheetStore.Stock}" Style="{StaticResource RowLabel}"/>
                <TextBlock Grid.Row="3" Grid.Column="1"
                           Text="{Binding Existing.Stock}"
                           Style="{StaticResource RowValue}"/>
                <TextBlock Grid.Row="3" Grid.Column="2"
                           Text="{Binding Incoming.Stock}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource RowValue}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StockDifferent}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Used -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource SheetStore.USED}" Style="{StaticResource RowLabel}"/>
                <TextBlock Grid.Row="4" Grid.Column="1"
                           Text="{Binding Existing.Used}"
                           Style="{StaticResource RowValue}"/>
                <TextBlock Grid.Row="4" Grid.Column="2"
                           Text="{Binding Incoming.Used}"
                           Style="{StaticResource RowValue}"/>

                <!-- Balance (info only) -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource Common.Balance}" Style="{StaticResource RowLabel}"/>
                <TextBlock Grid.Row="5" Grid.Column="1"
                           Text="{Binding Existing.Balance}"
                           Style="{StaticResource RowValue}"/>
                <TextBlock Grid.Row="5" Grid.Column="2"
                           Text="{Binding Incoming.Balance}"
                           Style="{StaticResource RowValue}"/>
            </Grid>
        </Border>

        <!-- Apply to all checkbox -->
        <CheckBox Grid.Row="3"
                  Content="{DynamicResource SheetStore.ApplyActionRemainingDuplicates}"
                  IsChecked="{Binding ApplyToRemaining, Mode=TwoWay}"
                  FontSize="{StaticResource TextBody}"
                  Foreground="{DynamicResource PrimaryForegroundBrush}"
                  Margin="0,16,0,12"
                  Cursor="Hand"/>

        <!-- Action buttons — palette-aligned + hover/press states -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource OutlinedPillButton}"
                    Tag="&#xE711;" Content="{DynamicResource SheetStore.SKIP}"
                    ToolTip="{DynamicResource SheetStore.IgnoreRowKeepExistingSheetUnchangedEscCancel}"
                    Command="{Binding SkipCommand}"/>

            <Button Grid.Column="1" Style="{StaticResource SuccessPillButton}"
                    Tag="&#xE710;" Content="{DynamicResource SheetStore.ADDStock}"
                    ToolTip="{DynamicResource SheetStore.AddIncomingStockExistingKeepsPrices}"
                    Command="{Binding AddToStockCommand}"/>

            <Button Grid.Column="2" Style="{StaticResource PrimaryPillButton}"
                    Tag="&#xE895;" Content="{DynamicResource SheetStore.Update}"
                    ToolTip="{DynamicResource SheetStore.OverwriteFieldsIncomingValues}"
                    Command="{Binding UpdateAllCommand}"/>

            <Button Grid.Column="3" Style="{StaticResource DangerButton}"
                    Tag="&#xE711;" Content="{DynamicResource SheetStore.CancelImport}"
                    ToolTip="{DynamicResource SheetStore.StopEntireImportPressEsc}"
                    Command="{Binding CancelImportCommand}"
                    IsCancel="True"/>
        </Grid>
    </Grid>
</Window>