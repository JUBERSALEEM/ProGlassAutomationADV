<Window x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreCsv.DuplicateResolutionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duplicate Sheet Detected"
        Width="760" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="{DynamicResource ModuleBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- Standard dialog: Esc → Cancel Import (destructive escape) -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelImportCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="ColumnHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <!-- Action button with hover + press states — critical for destructive dialog -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cancel Import button — extra emphasis (Bold + slightly darker press) -->
        <Style x:Key="CancelImportBtn" TargetType="Button"
               BasedOn="{StaticResource ActionBtn}">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠️" FontSize="24" VerticalAlignment="Center"/>
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="DUPLICATE SHEET DETECTED"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="{Binding HeaderText}"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="This sheet already exists. Choose how to handle it:"
                       FontSize="12" Margin="0,8,0,0"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
        </StackPanel>

        <!-- Sheet identity -->
        <Border Grid.Row="1"
                Background="{DynamicResource MenuHoverBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10" Padding="14,10" Margin="0,0,0,16"
                SnapsToDevicePixels="True">
            <TextBlock Text="{Binding SheetLabel}"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
        </Border>

        <!-- Comparison grid -->
        <Border Grid.Row="2"
                Background="{DynamicResource ModuleBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12" Padding="0"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Headers -->
                <Border Grid.Row="0" Grid.Column="0"
                        Background="{DynamicResource MenuHoverBrush}"
                        Padding="10,10" CornerRadius="12,0,0,0">
                    <TextBlock Text="FIELD" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               HorizontalAlignment="Center"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Background="#1E40AF" Padding="10,10">
                    <TextBlock Text="📀 EXISTING (in DB)" Style="{StaticResource ColumnHeader}"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Background="#B45309" Padding="10,10"
                        CornerRadius="0,12,0,0">
                    <TextBlock Text="📥 INCOMING (from CSV)" Style="{StaticResource ColumnHeader}"/>
                </Border>

                <!-- Purchase Price -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="PURCHASE/SQM" Style="{StaticResource RowLabel}"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding Existing.PurchasePricePerSqm, StringFormat={}{0:N2}}"
                           Style="{StaticResource RowValue}"/>
                <TextBlock Grid.Row="1" Grid.Column="2"
                           Text="{Binding Incoming.PurchasePricePerSqm, StringFormat={}{0:N2}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource RowValue}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BuyPriceDifferent}" Value="True">
                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Sell Price -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="SELL/SQM" Style="{StaticResource RowLabel}"/>
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{Binding Existing.SellPricePerSqm, StringFormat={}{0:N2}}"
                           Style="{StaticResource RowValue}"/>
                <TextBlock Grid.Row="2" Grid.Column="2"
                           Text="{Binding Incoming.SellPricePerSqm, StringFormat={}{0:N2}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource RowValue}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SellPriceDifferent}" Value="True">
                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Stock -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="STOCK" Style="{StaticResource RowLabel}"/>
                <TextBlock Grid.Row="3" Grid.Column="1"
                           Text="{Binding Existing.Stock}"
                           Style="{StaticResource RowValue}"/>
                <TextBlock Grid.Row="3" Grid.Column="2"
                           Text="{Binding Incoming.Stock}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource RowValue}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StockDifferent}" Value="True">
                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Used -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="USED" Style="{StaticResource RowLabel}"/>
                <TextBlock Grid.Row="4" Grid.Column="1"
                           Text="{Binding Existing.Used}"
                           Style="{StaticResource RowValue}"/>
                <TextBlock Grid.Row="4" Grid.Column="2"
                           Text="{Binding Incoming.Used}"
                           Style="{StaticResource RowValue}"/>

                <!-- Balance (info only) -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="BALANCE" Style="{StaticResource RowLabel}"/>
                <TextBlock Grid.Row="5" Grid.Column="1"
                           Text="{Binding Existing.Balance}"
                           Style="{StaticResource RowValue}"/>
                <TextBlock Grid.Row="5" Grid.Column="2"
                           Text="{Binding Incoming.Balance}"
                           Style="{StaticResource RowValue}"/>
            </Grid>
        </Border>

        <!-- Apply to all checkbox -->
        <CheckBox Grid.Row="3"
                  Content="Apply this action to all remaining duplicates"
                  IsChecked="{Binding ApplyToRemaining, Mode=TwoWay}"
                  FontSize="12"
                  Foreground="{DynamicResource PrimaryForegroundBrush}"
                  Margin="0,16,0,12"
                  Cursor="Hand"/>

        <!-- Action buttons — palette-aligned + hover/press states -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource ActionBtn}"
                    Background="#64748B" Content="Skip"
                    ToolTip="Ignore this row, keep existing sheet unchanged (Esc = Cancel Import)"
                    Command="{Binding SkipCommand}"/>

            <Button Grid.Column="1" Style="{StaticResource ActionBtn}"
                    Background="{DynamicResource SuccessBrush}" Content="+ Add to Stock"
                    ToolTip="Add incoming stock to existing (keeps prices)"
                    Command="{Binding AddToStockCommand}"/>

            <Button Grid.Column="2" Style="{StaticResource ActionBtn}"
                    Background="#B45309" Content="Update All"
                    ToolTip="Overwrite all fields with incoming values"
                    Command="{Binding UpdateAllCommand}"/>

            <Button Grid.Column="3" Style="{StaticResource CancelImportBtn}"
                    Background="#B91C1C" Content="✕ Cancel Import"
                    ToolTip="Stop the entire import (or press Esc)"
                    Command="{Binding CancelImportCommand}"
                    IsCancel="True"/>
        </Grid>
    </Grid>
</Window>