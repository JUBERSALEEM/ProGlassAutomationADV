<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/SheetStore/SheetStoreHistory/HistoryView.xaml
     MODULE: Sheet Store — Inventory Audit History
     Bento Design System: 1-column full-width transaction ledger (Rule 2),
     clean filter bar, tabular numerals, standardized button heights.
═══════════════════════════════════════════════════════════════════════ -->
<dialogs:ThemedDialogWindow x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreHistory.HistoryView"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
                            xmlns:dialogs="clr-namespace:ProGlassAutomation.Views.Shared.Dialogs"
                            Title="{DynamicResource SheetStore.HistoryLOG}"
                            Width="1100" Height="720"
                            MinWidth="800" MinHeight="520"
                            MaxWidth="1400"
                            SizeToContent="Manual"
                            ResizeMode="CanResize"
                            DialogIcon="&#xE81C;"
                            DialogSubtitle="{DynamicResource SheetStore.ChangeSheetStoreRecordedHere}"
                            FontFamily="{DynamicResource AppFontFamily}">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>

    <dialogs:ThemedDialogWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Dashboard/Overview/IndigoStudioResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </dialogs:ThemedDialogWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="280"/>
        </Grid.RowDefinitions>

        <!-- ══ 1. FILTER / TOOLBAR BENTO BAR ════════════════════════════ -->
        <Border Grid.Row="0"
                Style="{StaticResource Ov.CardCompact}"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{DynamicResource Shared.Action}"
                           Style="{StaticResource Ov.Meta}" Margin="2,0,0,4"/>
                <ComboBox Grid.Row="1" Grid.Column="0"
                          SelectedValue="{Binding FilterAction, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Tag"
                          Style="{StaticResource ModuleListFilterComboStyle}"
                          Height="34"
                          HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="{DynamicResource Common.All}" Tag="All"/>
                    <ComboBoxItem Content="{DynamicResource ProformaInvoice.Added}" Tag="Added"/>
                    <ComboBoxItem Content="{DynamicResource SheetStore.Edited}" Tag="Edited"/>
                    <ComboBoxItem Content="{DynamicResource SheetStore.Deleted}" Tag="Deleted"/>
                    <ComboBoxItem Content="{DynamicResource SheetStore.Bought}" Tag="Bought"/>
                    <ComboBoxItem Content="{DynamicResource SheetStore.USED}" Tag="Used"/>
                    <ComboBoxItem Content="Reversed" Tag="Reversed"/>
                </ComboBox>

                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="{DynamicResource Common.FromDate}"
                           Style="{StaticResource Ov.Meta}" Margin="2,0,0,4"/>
                <DatePicker Grid.Row="1" Grid.Column="2"
                            SelectedDate="{Binding FromDate, Mode=TwoWay}"
                            Style="{StaticResource ModuleListFilterDatePickerStyle}"
                            Height="34"
                            HorizontalAlignment="Stretch"/>

                <TextBlock Grid.Row="0" Grid.Column="4"
                           Text="{DynamicResource Common.ToDate}"
                           Style="{StaticResource Ov.Meta}" Margin="2,0,0,4"/>
                <DatePicker Grid.Row="1" Grid.Column="4"
                            SelectedDate="{Binding ToDate, Mode=TwoWay}"
                            Style="{StaticResource ModuleListFilterDatePickerStyle}"
                            Height="34"
                            HorizontalAlignment="Stretch"/>

                <Button Grid.Row="1" Grid.Column="6"
                        Style="{StaticResource OutlinedPillButton}"
                        Height="34" Padding="12,0"
                        VerticalAlignment="Bottom"
                        Tag="&#xE711;" Content="{DynamicResource SheetStore.ClearDates}"
                        ToolTip="{DynamicResource SheetStore.ClearDateFilter}"
                        Command="{Binding ClearDatesCommand}"
                        Visibility="{Binding HasDateFilter, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Button Grid.Row="1" Grid.Column="8"
                        Style="{StaticResource PrimaryPillButton}"
                        Height="34" Padding="14,0"
                        VerticalAlignment="Bottom"
                        Tag="&#xE72C;" Content="{DynamicResource Action.Refresh}"
                        ToolTip="{DynamicResource SheetStore.ReloadHistory}"
                        Command="{Binding RefreshCommand}"/>

                <TextBlock Grid.Row="0" Grid.Column="10"
                           Text="{DynamicResource Action.Search}"
                           Style="{StaticResource Ov.Meta}" Margin="2,0,0,4"/>
                <TextBox Grid.Row="1" Grid.Column="10"
                         behaviors:TextBoxBehaviors.SelectAllOnFocus="True"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         Style="{StaticResource TextBoxStyle}"
                         Height="34"
                         VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <!-- ══ 2. RESULTS TABLE BENTO CARD ═════════════════════════════ -->
        <Border Grid.Row="1"
                Style="{StaticResource Ov.CardCompact}"
                Padding="0"
                MinHeight="280">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="240"/>
                </Grid.RowDefinitions>

                <!-- Column Header -->
                <Border Grid.Row="0" Style="{StaticResource ModuleListTableHeaderStyle}" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="118"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Shared.Action}" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="2" Text="{DynamicResource SheetStore.SheetDetails}" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="4" Text="{DynamicResource Shared.Details}" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="6" Text="{DynamicResource Common.Qty}" Style="{StaticResource ModuleListHeaderTextStyle}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="8" Text="{DynamicResource SystemCenter.USER}" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="10" Text="{DynamicResource Shared.DATETIME}" Style="{StaticResource ModuleListHeaderTextStyle}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="12" Text=" " Style="{StaticResource ModuleListHeaderTextStyle}"/>
                    </Grid>
                </Border>

                <!-- Virtualized Rows -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding FilteredHistory}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="6,4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ModuleListRowStyle}" Padding="10,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="118"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Action Badge -->
                                    <Border Grid.Column="0"
                                            CornerRadius="6"
                                            Padding="8,3"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding ActionColor, Converter={StaticResource ColorStringConverter}}"/>
                                        </Border.Background>
                                        <TextBlock Text="{Binding Action}"
                                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                                   FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                    </Border>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding SheetDescription}"
                                               FontSize="{DynamicResource FontSize.Body}"
                                               FontWeight="{DynamicResource Weight.SemiBold}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding SheetDescription}"/>

                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Details}"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   ToolTip="{Binding Details}"/>
                                        <Border Margin="0,4,0,0" Padding="7,1"
                                                HorizontalAlignment="Left"
                                                CornerRadius="4"
                                                Background="{DynamicResource Ov.WarningSoft}"
                                                Visibility="{Binding IsReversed, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{DynamicResource SheetStore.ReversedBadge}"
                                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                                       FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource Ov.Warning}"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Grid.Column="6"
                                               Text="{Binding QuantityChanged, StringFormat=N0}"
                                               FontSize="{DynamicResource FontSize.Body}"
                                               FontWeight="{DynamicResource Weight.SemiBold}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Typography.NumeralAlignment="Tabular"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                                    <TextBlock Grid.Column="8"
                                               Text="{Binding UserName}"
                                               FontSize="{DynamicResource FontSize.Body}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               ToolTip="{Binding UserName}"/>

                                    <StackPanel Grid.Column="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DateDisplay}"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   FontWeight="{DynamicResource Weight.SemiBold}"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding TimeDisplay}"
                                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>

                                    <Button Grid.Column="12"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource RowOutlinedButton}"
                                            Height="30" Padding="8,0"
                                            Tag="&#xE7A7;"
                                            Content="{DynamicResource SheetStore.UndoMovement}"
                                            Command="{Binding DataContext.UndoMovementCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{DynamicResource SheetStore.UndoMovementTooltip}"
                                            Visibility="{Binding CanReverse, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>

    <!-- Standardized Footer -->
    <dialogs:ThemedDialogWindow.FooterContent>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock VerticalAlignment="Center"
                       Margin="0,0,16,0"
                       Style="{StaticResource Ov.Meta}">
                <TextBlock.Inlines>
                    <Run Text="{Binding TotalEntries, Mode=OneWay}"/>
                    <Run Text=" "/>
                    <Run Text="{DynamicResource SheetStore.Entries}"/>
                </TextBlock.Inlines>
            </TextBlock>
            <Button Style="{StaticResource OutlinedPillButton}"
                    Height="36" Padding="18,0"
                    Tag="&#xE711;" Content="{DynamicResource Action.Close}"
                    ToolTip="{DynamicResource SheetStore.CloseHistory}"
                    Command="{Binding CloseCommand}"/>
        </StackPanel>
    </dialogs:ThemedDialogWindow.FooterContent>
</dialogs:ThemedDialogWindow>
