<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/SheetStore/SheetStoreHistory/HistoryView.xaml
     MODULE: Sheet Store — inventory history (layout pass)

     Layout-only. Bindings, commands, filters and inventory math are
     unchanged. The page consumes shared dialog + list-page styles so
     it reads as an operational ERP history screen, not a stack of
     nested cards with a disconnected accent chip.

     Topology (ThemedDialogWindow chrome supplies title/subtitle/footer):
       1. Filter / toolbar band — one height, one inset
       2. Result table — shared column grid for header + rows
       3. Footer — count (left) + Close (right)
═══════════════════════════════════════════════════════════════════════ -->
<dialogs:ThemedDialogWindow x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreHistory.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:dialogs="clr-namespace:ProGlassAutomation.Views.Shared.Dialogs"
             Title="{DynamicResource SheetStore.HistoryLOG}"
             Width="1100" Height="720"
             MinWidth="800" MinHeight="520"
             MaxWidth="1400"
             SizeToContent="Manual"
             ResizeMode="CanResize"
             DialogIcon="&#xE81C;"
             DialogSubtitle="{DynamicResource SheetStore.ChangeSheetStoreRecordedHere}"
             FontFamily="{DynamicResource AppFontFamily}">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="280"/>
        </Grid.RowDefinitions>

        <!-- ══ FILTER / TOOLBAR ══════════════════════════════════════ -->
        <Border Grid.Row="0"
                Style="{StaticResource DialogSectionCardStyle}"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="168"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="148"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="148"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{DynamicResource Shared.Action}"
                           Style="{StaticResource DialogFieldLabelStyle}"/>
                <!-- Tag is the persisted Action ("Used", "Added"), not
                     the localized Content. SelectedValuePath=Content
                     compared "USED"/"ADDED" against "Used"/"Added"
                     and the filter silently matched nothing. -->
                <ComboBox Grid.Row="1" Grid.Column="0"
                          SelectedValue="{Binding FilterAction, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Tag"
                          Style="{StaticResource ModuleListFilterComboStyle}"
                          HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="{DynamicResource Common.All}" Tag="All"/>
                    <ComboBoxItem Content="{DynamicResource ProformaInvoice.Added}" Tag="Added"/>
                    <ComboBoxItem Content="{DynamicResource SheetStore.Edited}" Tag="Edited"/>
                    <ComboBoxItem Content="{DynamicResource SheetStore.Deleted}" Tag="Deleted"/>
                    <ComboBoxItem Content="{DynamicResource SheetStore.Bought}" Tag="Bought"/>
                    <ComboBoxItem Content="{DynamicResource SheetStore.USED}" Tag="Used"/>
                    <ComboBoxItem Content="Reversed" Tag="Reversed"/>
                </ComboBox>

                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="{DynamicResource Common.FromDate}"
                           Style="{StaticResource DialogFieldLabelStyle}"/>
                <DatePicker Grid.Row="1" Grid.Column="2"
                            SelectedDate="{Binding FromDate, Mode=TwoWay}"
                            Style="{StaticResource ModuleListFilterDatePickerStyle}"
                            HorizontalAlignment="Stretch"/>

                <TextBlock Grid.Row="0" Grid.Column="4"
                           Text="{DynamicResource Common.ToDate}"
                           Style="{StaticResource DialogFieldLabelStyle}"/>
                <DatePicker Grid.Row="1" Grid.Column="4"
                            SelectedDate="{Binding ToDate, Mode=TwoWay}"
                            Style="{StaticResource ModuleListFilterDatePickerStyle}"
                            HorizontalAlignment="Stretch"/>

                <Button Grid.Row="1" Grid.Column="6"
                        Style="{StaticResource OutlinedPillButton}"
                        Height="{DynamicResource DensityButtonHeight}"
                        VerticalAlignment="Bottom"
                        Tag="&#xE711;" Content="{DynamicResource SheetStore.ClearDates}"
                        ToolTip="{DynamicResource SheetStore.ClearDateFilter}"
                        Command="{Binding ClearDatesCommand}"
                        Visibility="{Binding HasDateFilter, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Button Grid.Row="1" Grid.Column="8"
                        Style="{StaticResource PrimaryPillButton}"
                        Height="{DynamicResource DensityButtonHeight}"
                        VerticalAlignment="Bottom"
                        Tag="&#xE72C;" Content="{DynamicResource Action.Refresh}"
                        ToolTip="{DynamicResource SheetStore.ReloadHistory}"
                        Command="{Binding RefreshCommand}"/>

                <TextBlock Grid.Row="0" Grid.Column="10"
                           Text="{DynamicResource Action.Search}"
                           Style="{StaticResource DialogFieldLabelStyle}"/>
                <TextBox Grid.Row="1" Grid.Column="10"
                         behaviors:TextBoxBehaviors.SelectAllOnFocus="True"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         Style="{StaticResource TextBoxStyle}"
                         Height="{DynamicResource DensityInputHeight}"
                         VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <!-- ══ RESULTS TABLE ═════════════════════════════════════════ -->
        <!-- Bounded height so the chrome ScrollViewer (infinite measure)
             cannot stretch the list to every row. Internal virtualization
             owns scrolling; MinHeight keeps empty/loading readable. -->
        <Border Grid.Row="1"
                Style="{StaticResource DialogSectionCardStyle}"
                Padding="0"
                MinHeight="280"
                MaxHeight="420">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="240"/>
                </Grid.RowDefinitions>

                <!-- Column headers share the same rails as each row. -->
                <Border Grid.Row="0" Style="{StaticResource ModuleListTableHeaderStyle}">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="118"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="88"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Shared.Action}"
                                   Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="2" Text="{DynamicResource SheetStore.SheetDetails}"
                                   Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="4" Text="{DynamicResource Shared.Details}"
                                   Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="6" Text="{DynamicResource Common.Qty}"
                                   Style="{StaticResource ModuleListHeaderTextStyle}"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="8" Text="{DynamicResource SystemCenter.USER}"
                                   Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="10" Text="{DynamicResource Shared.DATETIME}"
                                   Style="{StaticResource ModuleListHeaderTextStyle}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <!-- Empty — only when not busy, so a load is not
                         mistaken for "no history yet". -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False" Margin="24">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsEmpty}" Value="True"/>
                                            <Condition Binding="{Binding IsBusy}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE8A5;" FontFamily="{DynamicResource FontFamily.Icon}"
                                   FontSize="{DynamicResource FontSize.Display}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource SheetStore.NoHistoryYet}"
                                   FontSize="{DynamicResource FontSize.H2}"
                                   FontWeight="{DynamicResource Weight.SemiBold}"
                                   Margin="0,16,0,4" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource SheetStore.ActionsSheetStoreAppearHere}"
                                   FontSize="{DynamicResource FontSize.Body}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource Common.Loading}"
                                   FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>

                    <ListBox ItemsSource="{Binding Entries}"
                             Style="{StaticResource ModuleReportListBoxStyle}"
                             Focusable="False"
                             ScrollViewer.PanningMode="None"
                             behaviors:SmoothScrollBehavior.IsEnabled="True"
                             Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ModuleListRowStyle}" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="1.6*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="2.2*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="118"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Padding="8,3"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding ActionColor, Converter={StaticResource ColorStringConverter}}"/>
                                            </Border.Background>
                                            <TextBlock Text="{Binding Action}"
                                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                                       FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                        </Border>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SheetDescription}"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   FontWeight="{DynamicResource Weight.SemiBold}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding SheetDescription}"/>

                                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Details}"
                                                       FontSize="{DynamicResource FontSize.Body}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       ToolTip="{Binding Details}"/>
                                            <Border Margin="0,4,0,0" Padding="7,1"
                                                    HorizontalAlignment="Left"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Background="{DynamicResource TintAmberBrush}"
                                                    Visibility="{Binding IsReversed,
                                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{DynamicResource SheetStore.ReversedBadge}"
                                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                                           FontWeight="{DynamicResource Weight.Bold}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Grid.Column="6"
                                                   Text="{Binding QuantityChanged, StringFormat=N0}"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   FontWeight="{DynamicResource Weight.SemiBold}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Typography.NumeralAlignment="Tabular"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                                        <TextBlock Grid.Column="8"
                                                   Text="{Binding UserName}"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   ToolTip="{Binding UserName}"/>

                                        <StackPanel Grid.Column="10" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DateDisplay}"
                                                       FontSize="{DynamicResource FontSize.Body}"
                                                       FontWeight="{DynamicResource Weight.SemiBold}"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding TimeDisplay}"
                                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <Button Grid.Column="12"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource RowOutlinedButton}"
                                                Tag="&#xE7A7;"
                                                Content="{DynamicResource SheetStore.UndoMovement}"
                                                Command="{Binding DataContext.UndoMovementCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{DynamicResource SheetStore.UndoMovementTooltip}"
                                                Visibility="{Binding CanReverse,
                                                             Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>
    </Grid>

    <dialogs:ThemedDialogWindow.FooterContent>
        <!-- Chrome footer presenter is right-aligned; keep count + Close
             as one packed row so the count is not collapsed. -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock VerticalAlignment="Center"
                       Margin="0,0,16,0"
                       FontSize="{DynamicResource FontSize.Body}"
                       Foreground="{DynamicResource TextSecondaryBrush}">
                <TextBlock.Inlines>
                    <Run Text="{Binding TotalEntries, Mode=OneWay}"/>
                    <Run Text=" "/>
                    <Run Text="{DynamicResource SheetStore.Entries}"/>
                </TextBlock.Inlines>
            </TextBlock>
            <Button Style="{StaticResource OutlinedPillButton}"
                    Tag="&#xE711;" Content="{DynamicResource Action.Close}"
                    ToolTip="{DynamicResource SheetStore.CloseHistory}"
                    Command="{Binding CloseCommand}"/>
        </StackPanel>
    </dialogs:ThemedDialogWindow.FooterContent>
</dialogs:ThemedDialogWindow>
