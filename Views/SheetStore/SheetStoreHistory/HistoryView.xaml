<!-- ═══════════════════════════════════════════════════════════════
     MIGRATION LOG — Button Standardization (master prompt v1.0)
     Date: 2026-08-15 — SheetStore module batch
     • All buttons -> centralized PrimaryPill/SuccessPill/OutlinedPill/
       DangerButton styles with MDL2 Tag glyphs + UPPERCASE content
     • Removed legacy local styles (ActionBtn, HeaderActionBtn,
       QtyButtonStyle, Cancel/Save/ConfirmButtonStyle,
       FilterActionButtonStyle, CancelImportBtn)
     • Decorative emojis (search/clock/empty/mailbox) -> MDL2 glyphs
     Commands/bindings preserved; no ViewModel changes.
═══════════════════════════════════════════════════════════════ -->
<Window x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreHistory.HistoryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
        Title="Sheet Store — History"
        Width="1000" Height="680"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="{DynamicResource ModuleBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- Standard dialog: Esc → Close -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>

    <Window.Resources>

        <!-- Field label — 11 SemiBold UPPERCASE (spec) -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin" Value="4,0,0,6"/>
        </Style>

        <!-- Filter action button (Clear Dates / Refresh) -->

        <!-- Close button — primary indigo -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Log entry row style with hover -->
        <Style x:Key="LogEntryStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ListBoxItem — strips selection padding -->
        <Style x:Key="HistoryListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="24" VerticalAlignment="Center"/>
                <TextBlock Text="HISTORY LOG" FontSize="22" FontWeight="Bold"
                           Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                <Border Background="{DynamicResource AccentBrush}"
                        CornerRadius="10" Padding="10,4"
                        VerticalAlignment="Center" Margin="14,2,0,0">
                    <TextBlock Text="{Binding TotalEntries, StringFormat={}{0} entries}"
                               FontSize="11" FontWeight="Bold" Foreground="White"/>
                </Border>
            </StackPanel>
            <TextBlock Text="Every change to Sheet Store is recorded here."
                       FontSize="12" Margin="0,4,0,0"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
        </StackPanel>

        <!-- Filters -->
        <Border Grid.Row="1"
                Background="{DynamicResource ModuleBackgroundBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="{DynamicResource CardBorderThickness}"
                CornerRadius="12" Padding="16,14" Margin="0,0,0,16"
                SnapsToDevicePixels="True">
            <StackPanel>
                <!-- Row 1: Action + Date Range + Clear + Refresh -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ACTION" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox SelectedValue="{Binding FilterAction, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Content"
                                  Height="38" Padding="10,6" FontSize="12"
                                  Background="{DynamicResource MenuHoverBrush}"
                                  Foreground="{DynamicResource PrimaryForegroundBrush}"
                                  VerticalContentAlignment="Center">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="Added"/>
                            <ComboBoxItem Content="Edited"/>
                            <ComboBoxItem Content="Deleted"/>
                            <ComboBoxItem Content="Bought"/>
                            <ComboBoxItem Content="Used"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="FROM DATE" Style="{StaticResource FieldLabelStyle}"/>
                        <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}"
                                    Height="38" FontSize="12"
                                    Background="{DynamicResource MenuHoverBrush}"
                                    Foreground="{DynamicResource PrimaryForegroundBrush}"
                                    VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="TO DATE" Style="{StaticResource FieldLabelStyle}"/>
                        <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}"
                                    Height="38" FontSize="12"
                                    Background="{DynamicResource MenuHoverBrush}"
                                    Foreground="{DynamicResource PrimaryForegroundBrush}"
                                    VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
                        <TextBlock Text=" " FontSize="11" Margin="0,0,0,6"/>
                        <Button Style="{StaticResource DangerButton}"
                                Tag="&#xE711;" Content="CLEAR DATES"
                                ToolTip="Clear the date filter"
                                Command="{Binding ClearDatesCommand}"
                                Visibility="{Binding HasDateFilter, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="8" VerticalAlignment="Bottom">
                        <TextBlock Text=" " FontSize="11" Margin="0,0,0,6"/>
                        <Button Style="{StaticResource PrimaryPillButton}"
                                Tag="&#xE72C;" Content="REFRESH"
                                ToolTip="Reload history"
                                Command="{Binding RefreshCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Search -->
                <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Background="{DynamicResource MenuHoverBrush}"
                        CornerRadius="8" Padding="12,8" Margin="0,12,0,0"
                        SnapsToDevicePixels="True">
                    <DockPanel>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent"
                                 VerticalAlignment="Center" FontSize="13"
                                 Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             VIRTUALIZED LOG ENTRIES
             SmoothScrollBehavior on the ListBox — handles 10K+ entries
        ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource ModuleBackgroundBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="{DynamicResource CardBorderThickness}"
                CornerRadius="12" Padding="12"
                SnapsToDevicePixels="True">
            <Grid>
                <!-- Empty state (overlaid, non-interactive) -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="60" Foreground="{DynamicResource AccentBrush}" Opacity="0.4" HorizontalAlignment="Center"/>
                    <TextBlock Text="No history yet" FontSize="18" FontWeight="SemiBold"
                               Margin="0,16,0,4" HorizontalAlignment="Center"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="Actions on Sheet Store will appear here"
                               FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>

                <!-- Virtualized log list -->
                <ListBox ItemsSource="{Binding Entries}"
                         ItemContainerStyle="{StaticResource HistoryListBoxItemStyle}"
                         BorderThickness="0"
                         Background="Transparent"
                         Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.IsDeferredScrollingEnabled="False"
                         ScrollViewer.PanningMode="None"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingStackPanel.ScrollUnit="Item"
                         VirtualizingStackPanel.CacheLength="1,2"
                         VirtualizingStackPanel.CacheLengthUnit="Page"
                         behaviors:SmoothScrollBehavior.IsEnabled="True"
                         Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource LogEntryStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Action badge -->
                                    <Border Grid.Column="0"
                                            CornerRadius="6" Padding="10,5"
                                            VerticalAlignment="Top">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding ActionColor, Converter={StaticResource ColorStringConverter}}"/>
                                        </Border.Background>
                                        <TextBlock Text="{Binding Action}"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>

                                    <!-- Content -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding SheetDescription}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        <TextBlock Text="{Binding Details}"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Margin="0,3,0,0"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding UserName}"
                                                       FontSize="11" Margin="4,0,0,0"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Timestamp -->
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding DateDisplay}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        <TextBlock Text="{Binding DayDisplay}"
                                                   FontSize="10"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        <TextBlock Text="{Binding TimeDisplay}"
                                                   FontSize="11" FontWeight="Bold"
                                                   HorizontalAlignment="Right" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Close button -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Style="{StaticResource OutlinedPillButton}"
                    Tag="&#xE711;" Content="CLOSE"
                    ToolTip="Close history"
                    Command="{Binding CloseCommand}"/>
        </StackPanel>
    </Grid>
</Window>