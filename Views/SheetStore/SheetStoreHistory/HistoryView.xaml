<!-- ═══════════════════════════════════════════════════════════════
     MIGRATION LOG — Button Standardization (master prompt v1.0)
     Date: 2026-08-15 — SheetStore module batch
     • All buttons -> centralized PrimaryPill/SuccessPill/OutlinedPill/
       DangerButton styles with MDL2 Tag glyphs + UPPERCASE content
     • Removed legacy local styles (ActionBtn, HeaderActionBtn,
       QtyButtonStyle, Cancel/Save/ConfirmButtonStyle,
       FilterActionButtonStyle, CancelImportBtn)
     • Decorative emojis (search/clock/empty/mailbox) -> MDL2 glyphs
     Commands/bindings preserved; no ViewModel changes.
═══════════════════════════════════════════════════════════════ -->
<Window x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreHistory.HistoryView"
             TextOptions.TextHintingMode="Fixed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
        Title="{DynamicResource SheetStore.SheetStoreHistory}"
        Width="1000" Height="680"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- Standard dialog: Esc → Close -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>

    <Window.Resources>

        <!-- Field label — 11 SemiBold UPPERCASE (spec) -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin" Value="4,0,0,6"/>
        </Style>

        <!-- Filter action button (Clear Dates / Refresh) -->

        <!-- Close button — primary indigo -->
        

        <!-- Log entry row style with hover -->
        <Style x:Key="LogEntryStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ListBoxItem — strips selection padding -->
        <Style x:Key="HistoryListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextDisplay}" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource SheetStore.HistoryLOG}" FontSize="{StaticResource TextHeadline}" FontWeight="Bold"
                           Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                <Border Background="{DynamicResource AccentBrush}"
                        CornerRadius="{DynamicResource ControlCornerRadius}" Padding="10,4"
                        VerticalAlignment="Center" Margin="14,2,0,0">
                    <TextBlock FontSize="{StaticResource TextBody}" FontWeight="Bold"
                               Foreground="{DynamicResource OnAccentForegroundBrush}">
                        <TextBlock.Inlines>
                            <Run Text="{Binding TotalEntries, Mode=OneWay}"/>
                            <Run Text=" "/>
                            <Run Text="{DynamicResource SheetStore.Entries}"/>
                        </TextBlock.Inlines>
                    </TextBlock>
                </Border>
            </StackPanel>
            <TextBlock Text="{DynamicResource SheetStore.ChangeSheetStoreRecordedHere}"
                       FontSize="{StaticResource TextBody}" Margin="0,4,0,0"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
        </StackPanel>

        <!-- Filters -->
        <Border Grid.Row="1"
                Background="{DynamicResource ModuleBackgroundBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="{DynamicResource CardBorderThickness}"
                CornerRadius="{DynamicResource CardCornerRadius}" Padding="16,14" Margin="0,0,0,16"
                SnapsToDevicePixels="True">
            <StackPanel>
                <!-- Row 1: Action + Date Range + Clear + Refresh -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Shared.Action}" Style="{StaticResource FieldLabelStyle}"/>
                        <!-- Tag is the persisted Action ("Used", "Added"), not
                             the localized Content. SelectedValuePath=Content
                             compared "USED"/"ADDED" against "Used"/"Added"
                             and the filter silently matched nothing. -->
                        <ComboBox SelectedValue="{Binding FilterAction, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Tag"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  Height="40" MinHeight="40" MinWidth="160">
                            <ComboBoxItem Content="{DynamicResource Common.All}" Tag="All"/>
                            <ComboBoxItem Content="{DynamicResource ProformaInvoice.Added}" Tag="Added"/>
                            <ComboBoxItem Content="{DynamicResource SheetStore.Edited}" Tag="Edited"/>
                            <ComboBoxItem Content="{DynamicResource SheetStore.Deleted}" Tag="Deleted"/>
                            <ComboBoxItem Content="{DynamicResource SheetStore.Bought}" Tag="Bought"/>
                            <ComboBoxItem Content="{DynamicResource SheetStore.USED}" Tag="Used"/>
                            <ComboBoxItem Content="Reversed" Tag="Reversed"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource Common.FromDate}" Style="{StaticResource FieldLabelStyle}"/>
                        <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}"
                                    Style="{StaticResource PiDatePickerStyle}"
                                    Height="40"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="{DynamicResource Common.ToDate}" Style="{StaticResource FieldLabelStyle}"/>
                        <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}"
                                    Style="{StaticResource PiDatePickerStyle}"
                                    Height="40"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
                        <TextBlock Text=" " FontSize="{StaticResource TextBody}" Margin="0,0,0,6"/>
                        <Button Style="{StaticResource DangerButton}"
                                Tag="&#xE711;" Content="{DynamicResource SheetStore.ClearDates}"
                                ToolTip="{DynamicResource SheetStore.ClearDateFilter}"
                                Command="{Binding ClearDatesCommand}"
                                Visibility="{Binding HasDateFilter, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="8" VerticalAlignment="Bottom">
                        <TextBlock Text=" " FontSize="{StaticResource TextBody}" Margin="0,0,0,6"/>
                        <Button Style="{StaticResource PrimaryPillButton}"
                                Tag="&#xE72C;" Content="{DynamicResource Action.Refresh}"
                                ToolTip="{DynamicResource SheetStore.ReloadHistory}"
                                Command="{Binding RefreshCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Search -->
                <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Background="{DynamicResource MenuHoverBrush}"
                        CornerRadius="{DynamicResource ControlCornerRadius}" Padding="12,8" Margin="0,12,0,0"
                        SnapsToDevicePixels="True">
                    <DockPanel>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextSection}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox behaviors:TextBoxBehaviors.SelectAllOnFocus="True"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                 BorderThickness="0" Background="Transparent"
                                 VerticalAlignment="Center" FontSize="{StaticResource TextBodyLarge}"
                                 Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             VIRTUALIZED LOG ENTRIES
             SmoothScrollBehavior on the ListBox — handles 10K+ entries
        ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource ModuleBackgroundBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="{DynamicResource CardBorderThickness}"
                CornerRadius="{DynamicResource CardCornerRadius}" Padding="12"
                SnapsToDevicePixels="True">
            <Grid>
                <!-- Empty state (overlaid, non-interactive) -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="60" Foreground="{DynamicResource MutedForegroundBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource SheetStore.NoHistoryYet}" FontSize="{StaticResource TextTitle}" FontWeight="SemiBold"
                               Margin="0,16,0,4" HorizontalAlignment="Center"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="{DynamicResource SheetStore.ActionsSheetStoreAppearHere}"
                               FontSize="{StaticResource TextBody}" HorizontalAlignment="Center"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>

                <!-- Virtualized log list -->
                <ListBox ItemsSource="{Binding Entries}"
                         ItemContainerStyle="{StaticResource HistoryListBoxItemStyle}"
                         BorderThickness="0"
                         Background="Transparent"
                         Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.IsDeferredScrollingEnabled="False"
                         ScrollViewer.PanningMode="None"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingStackPanel.ScrollUnit="Item"
                         VirtualizingStackPanel.CacheLength="1,2"
                         VirtualizingStackPanel.CacheLengthUnit="Page"
                         behaviors:SmoothScrollBehavior.IsEnabled="True"
                         Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource LogEntryStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Action badge -->
                                    <Border Grid.Column="0"
                                            CornerRadius="{DynamicResource ControlCornerRadius}" Padding="10,5"
                                            VerticalAlignment="Top">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding ActionColor, Converter={StaticResource ColorStringConverter}}"/>
                                        </Border.Background>
                                        <TextBlock Text="{Binding Action}"
                                                   FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>

                                    <!-- Content -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding SheetDescription}"
                                                   FontSize="{StaticResource TextBodyLarge}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        <TextBlock Text="{Binding Details}"
                                                   FontSize="{StaticResource TextBody}" TextWrapping="Wrap"
                                                   Margin="0,3,0,0"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextBody}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding UserName}"
                                                       FontSize="{StaticResource TextBody}" Margin="4,0,0,0"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                                            <!-- 2026-09-06 REVERSED badge. The original row is
                                                 never deleted on undo (immutable audit record),
                                                 so it must READ as superseded or the operator
                                                 would think the mistake is still live. -->
                                            <Border Margin="10,0,0,0" Padding="7,2"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Background="{DynamicResource TintAmberBrush}"
                                                    Visibility="{Binding IsReversed,
                                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{DynamicResource SheetStore.ReversedBadge}"
                                                           FontSize="{StaticResource TextCaption}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Timestamp -->
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding DateDisplay}"
                                                   FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        <TextBlock Text="{Binding DayDisplay}"
                                                   FontSize="{StaticResource TextCaption}"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        <TextBlock Text="{Binding TimeDisplay}"
                                                   FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                                   HorizontalAlignment="Right" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource AccentBrush}"/>

                                        <!-- UNDO (2026-09-06). Visible only on a reversible
                                             MOVEMENT: CanReverse is false for Added/Edited/
                                             Deleted rows, for an already-reversed row, and for
                                             a compensating row itself. The repository
                                             re-validates all of that server-side, so a stale
                                             grid cannot double-undo. -->
                                        <Button Margin="0,8,0,0"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource OutlinedPillButton}"
                                                Command="{Binding DataContext.UndoMovementCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{DynamicResource SheetStore.UndoMovementTooltip}"
                                                Visibility="{Binding CanReverse,
                                                             Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7A7;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="{StaticResource TextBody}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource SheetStore.UndoMovement}"
                                                           Margin="6,0,0,0"
                                                           FontSize="{StaticResource TextCaption}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Close button -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Style="{StaticResource OutlinedPillButton}"
                    Tag="&#xE711;" Content="{DynamicResource Action.Close}"
                    ToolTip="{DynamicResource SheetStore.CloseHistory}"
                    Command="{Binding CloseCommand}"/>
        </StackPanel>
    </Grid>
</Window>