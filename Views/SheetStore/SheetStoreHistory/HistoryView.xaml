<Window x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreHistory.HistoryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ProGlassAutomation.Converters"
        Title="Sheet Store — History"
        Width="900" Height="640"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <conv:ColorStringConverter x:Key="ColorStringConverter"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📜" FontSize="24" VerticalAlignment="Center"/>
                <TextBlock Text="HISTORY LOG" FontSize="22" FontWeight="Bold"
                           Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                <Border Background="{DynamicResource AccentBrush}"
                        CornerRadius="8" Padding="10,4"
                        VerticalAlignment="Center" Margin="14,2,0,0">
                    <TextBlock Text="{Binding TotalEntries, StringFormat={}{0} entries}"
                               FontSize="11" FontWeight="Bold" Foreground="White"/>
                </Border>
            </StackPanel>
            <TextBlock Text="Every change to Sheet Store is recorded here."
                       FontSize="12" Margin="0,4,0,0"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
        </StackPanel>

        <!-- Filters -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      SelectedValue="{Binding FilterAction, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="Content"
                      Height="36" Padding="10,6" FontSize="13"
                      Background="{DynamicResource MenuHoverBrush}"
                      Foreground="{DynamicResource PrimaryForegroundBrush}">
                <ComboBoxItem Content="All" IsSelected="True"/>
                <ComboBoxItem Content="Added"/>
                <ComboBoxItem Content="Edited"/>
                <ComboBoxItem Content="Deleted"/>
                <ComboBoxItem Content="Bought"/>
                <ComboBoxItem Content="Used"/>
            </ComboBox>

            <Border Grid.Column="2"
                    Background="{DynamicResource MenuHoverBrush}"
                    CornerRadius="8" Padding="12,0" Height="36" VerticalAlignment="Center">
                <DockPanel>
                    <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="Transparent"
                             VerticalAlignment="Center" FontSize="13"
                             Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                </DockPanel>
            </Border>

            <Button Grid.Column="4" Content="🔄 Refresh"
                    Height="36" Padding="14,0"
                    Background="{DynamicResource AccentBrush}" Foreground="White"
                    BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                    Command="{Binding RefreshCommand}"/>
        </Grid>

        <!-- Table -->
        <Border Grid.Row="2"
                Background="{DynamicResource ModuleBackgroundBrush}"
                CornerRadius="12" Padding="10">
            <Grid>
                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="📭" FontSize="60" Opacity="0.4" HorizontalAlignment="Center"/>
                    <TextBlock Text="No history yet" FontSize="18" FontWeight="SemiBold"
                               Margin="0,16,0,4" HorizontalAlignment="Center"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="Actions on Sheet Store will appear here"
                               FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </StackPanel>

                <!-- Log entries -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource WindowBackgroundBrush}"
                                        CornerRadius="10" Padding="14,12" Margin="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Action badge -->
                                        <Border Grid.Column="0"
                                                CornerRadius="6" Padding="10,5"
                                                VerticalAlignment="Top">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding ActionColor, Converter={StaticResource ColorStringConverter}}"/>
                                            </Border.Background>
                                            <TextBlock Text="{Binding Action}"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="White"/>
                                        </Border>

                                        <!-- Content -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding SheetDescription}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                            <TextBlock Text="{Binding Details}"
                                                       FontSize="12" TextWrapping="Wrap"
                                                       Margin="0,3,0,0"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="👤" FontSize="10" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding UserName}"
                                                           FontSize="10" Margin="4,0,0,0"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Timestamp -->
                                        <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding DateDisplay}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                            <TextBlock Text="{Binding DayDisplay}"
                                                       FontSize="10"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            <TextBlock Text="{Binding TimeDisplay}"
                                                       FontSize="11" FontWeight="Bold"
                                                       HorizontalAlignment="Right" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Close button -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Close" Width="110" Height="38"
                    Background="{DynamicResource AccentBrush}" Foreground="White"
                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                    Command="{Binding CloseCommand}"/>
        </StackPanel>
    </Grid>
</Window>