<!-- ═══════════════════════════════════════════════════════════════
     MIGRATION LOG — Button Standardization (master prompt v1.0)
     Date: 2026-08-15 — SheetStore module batch
     • All buttons -> centralized PrimaryPill/SuccessPill/OutlinedPill/
       DangerButton styles with MDL2 Tag glyphs + UPPERCASE content
     • Removed legacy local styles (ActionBtn, HeaderActionBtn,
       QtyButtonStyle, Cancel/Save/ConfirmButtonStyle,
       FilterActionButtonStyle, CancelImportBtn)
     • Decorative emojis (search/clock/empty/mailbox) -> MDL2 glyphs
     Commands/bindings preserved; no ViewModel changes.
═══════════════════════════════════════════════════════════════ -->
<dialogs:ThemedDialogWindow x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreBuy.BuyDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
        xmlns:dialogs="clr-namespace:ProGlassAutomation.Views.Shared.Dialogs"
        Title="{DynamicResource SheetStore.BUYStock}"
        Width="480"
        DialogIcon="&#xE7B8;"
        DialogSubtitle="{DynamicResource SheetStore.AddMoreSheetsInventory}"
             FontFamily="{DynamicResource AppFontFamily}">

    <!-- Standard dialog: Esc → Cancel · Enter → Confirm -->
    <!-- 2026-09 dialog audit: chrome (card/header/footer) comes from
         ThemedDialogWindow; this file keeps only the form body. Field labels
         use the shared DialogFieldLabelStyle; section cards use the shared
         DialogInsetBrush token so every dialog's cards align identically. -->
    <StackPanel>

            <!-- Sheet info card -->
            <Border Background="{DynamicResource DialogInsetBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}" Padding="16,14" Margin="0,0,0,16"
                    SnapsToDevicePixels="True" Style="{StaticResource SurfacePrimaryStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding Sheet.Category}" FontSize="{DynamicResource FontSize.H2}" FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding Sheet.ThicknessDisplay}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Sheet.Color}" FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Sheet.SizeDisplay}" FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{DynamicResource SheetStore.TotalStock}" FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding Sheet.Stock}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource SheetStore.Used}" FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding Sheet.Used}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="{DynamicResource SheetStore.Balance}" FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding Sheet.Balance}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource SuccessBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{DynamicResource Common.Price}" FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding Sheet.PurchasePricePerSqm, StringFormat={}{0:0.##}}"
                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource SheetStore.AEDSQMSQMSheet}" FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding Sheet.SqmPerSheet, StringFormat={}{0:N4}}"
                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Quantity selector -->
            <Border Background="{DynamicResource DialogInsetBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}" Padding="20,16" Margin="0,0,0,16"
                    SnapsToDevicePixels="True" Style="{StaticResource SurfacePrimaryStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SheetStore.QuantitySheets}"
                               Style="{StaticResource DialogFieldLabelStyle}"
                               Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource OutlinedPillButton}"
                                Content="−" MinWidth="50"
                                ToolTip="{DynamicResource SheetStore.DecreaseQuantity}"
                                Command="{Binding DecreaseCommand}"/>
                        <!-- Quantity TextBox — integer-only, big centered number -->
                        <!-- Bound to RAW TEXT, not the int. An int binding
                             with PropertyChanged cannot observe an empty box:
                             conversion fails and the setter never runs, so the
                             stale value survives behind an empty control. -->
                        <TextBox Grid.Column="1"
                                 Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:TextBoxBehaviors.SelectAllOnFocus="True"
                                 behaviors:TextBoxBehaviors.AcceptIntegersOnly="True"
                                 FontSize="{DynamicResource FontSize.Display}" FontWeight="{DynamicResource Weight.Bold}" TextAlignment="Center"
                                 VerticalContentAlignment="Center" Height="44"
                                 Background="{DynamicResource DialogInsetBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Margin="8,0">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <!-- Red outline while the entry is
                                             rejected: the error text alone is
                                             easy to miss on a dense form. -->
                                        <DataTrigger Binding="{Binding HasQuantityError}" Value="True">
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Grid.Column="2" Style="{StaticResource OutlinedPillButton}"
                                Content="+" MinWidth="50"
                                ToolTip="{DynamicResource SheetStore.IncreaseQuantity}"
                                Command="{Binding IncreaseCommand}"/>
                    </Grid>

                    <!-- Inline field error. Attached to the OFFENDING BOX
                         rather than a shared line at the foot of the form,
                         so the operator is pointed at what to fix. -->
                    <TextBlock Text="{Binding QuantityError}"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="{DynamicResource FontSize.BodySmall}"
                               FontWeight="{DynamicResource Weight.SemiBold}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="{Binding HasQuantityError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Border>

            <!-- Preview -->
            <Border Background="{DynamicResource DialogInsetBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}" Padding="20,16" Margin="0,0,0,16"
                    SnapsToDevicePixels="True" Style="{StaticResource SurfacePrimaryStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SheetStore.PurchasePreview}"
                               Style="{StaticResource DialogFieldLabelStyle}"
                               Margin="0,0,0,10"/>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource DeliveryNote.TotalSQM}" FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding TotalSqm, Converter={StaticResource CurrencyConverter}}"
                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource SheetStore.NewTotalStock}" FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding NewStockAfterBuy}"
                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource SheetStore.NewBalanceAvailable}" FontSize="{DynamicResource FontSize.Body}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding NewBalanceAfterBuy}"
                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Separator Opacity="0.3" Margin="0,6"/>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="{DynamicResource JobProfitability.TotalCOST}" FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.SemiBold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding TotalCost, Converter={StaticResource CurrencyConverter}, ConverterParameter=suffix}"
                                   FontSize="{DynamicResource FontSize.H2}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Right"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Buttons -->
                </StackPanel>

    <dialogs:ThemedDialogWindow.FooterContent>
<Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource OutlinedPillButton}"
                        Tag="&#xE711;" Content="{DynamicResource Action.Cancel}"
                        ToolTip="{DynamicResource SheetStore.CloseWithoutBuying}"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"/>
                <Button Grid.Column="2" Style="{StaticResource SuccessPillButton}"
                        Tag="&#xE73E;" Content="{DynamicResource SheetStore.ConfirmPurchase}"
                        ToolTip="{DynamicResource SheetStore.ConfirmAddStock}"
                        Command="{Binding ConfirmCommand}"
                        IsDefault="True"/>
            </Grid>
    </dialogs:ThemedDialogWindow.FooterContent>
</dialogs:ThemedDialogWindow>
