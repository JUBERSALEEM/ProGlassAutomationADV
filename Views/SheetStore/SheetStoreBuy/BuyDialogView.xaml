<Window x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreBuy.BuyDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
        Title="Buy Stock"
        Width="480" Height="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="{DynamicResource ModuleBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- Standard dialog: Esc → Cancel · Enter → Confirm -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
        <KeyBinding Key="Enter" Command="{Binding ConfirmCommand}"/>
    </Window.InputBindings>

    <Window.Resources>

        <!-- Field label — 11 SemiBold UPPERCASE + MutedForeground -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
        </Style>

        <!-- Quantity ± button (large, high contrast) -->
        <Style x:Key="QtyButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cancel button — secondary neutral -->
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{DynamicResource MenuHoverBrush}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Confirm button — primary Deep Forest (constructive) -->
        <Style x:Key="ConfirmButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{DynamicResource SuccessBrush}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#10B981"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#065F46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  IsDeferredScrollingEnabled="False"
                  PanningMode="None"
                  Focusable="True"
                  FocusVisualStyle="{x:Null}"
                  Background="Transparent"
                  behaviors:SmoothScrollBehavior.IsEnabled="True">
        <StackPanel Margin="24">

            <!-- Header -->
            <StackPanel Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📦" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock Text="BUY STOCK" FontSize="22" FontWeight="Bold" Margin="12,0,0,0"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                </StackPanel>
                <TextBlock Text="Add more sheets to inventory"
                           FontSize="12" Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </StackPanel>

            <!-- Sheet info card -->
            <Border Background="{DynamicResource MenuHoverBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12" Padding="16,14" Margin="0,0,0,16"
                    SnapsToDevicePixels="True">
                <StackPanel>
                    <TextBlock Text="{Binding Sheet.Category}" FontSize="16" FontWeight="Bold"
                               Foreground="#4338CA"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding Sheet.ThicknessDisplay}" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Sheet.Color}" FontSize="12"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Sheet.SizeDisplay}" FontSize="12"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Total stock: " FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding Sheet.Stock}" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="  •  Used: " FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding Sheet.Used}" FontSize="11" FontWeight="Bold"
                                   Foreground="#B91C1C"/>
                        <TextBlock Text="  •  Balance: " FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding Sheet.Balance}" FontSize="11" FontWeight="Bold"
                                   Foreground="#047857"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Price: " FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding Sheet.PurchasePricePerSqm, StringFormat={}{0:N2}}"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text=" AED/SQM  •  SQM/sheet: " FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding Sheet.SqmPerSheet, StringFormat={}{0:N4}}"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Quantity selector -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12" Padding="20,16" Margin="0,0,0,16"
                    SnapsToDevicePixels="True">
                <StackPanel>
                    <TextBlock Text="QUANTITY (sheets)"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="−"
                                Style="{StaticResource QtyButtonStyle}"
                                Background="#B91C1C"
                                Command="{Binding DecreaseCommand}"/>
                        <!-- Quantity TextBox — integer-only, big centered number -->
                        <TextBox Grid.Column="1"
                                 Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:TextBoxBehaviors.AcceptIntegersOnly="True"
                                 FontSize="28" FontWeight="Bold" TextAlignment="Center"
                                 VerticalContentAlignment="Center" Height="44"
                                 Background="{DynamicResource MenuHoverBrush}"
                                 Foreground="{DynamicResource PrimaryForegroundBrush}"
                                 BorderThickness="0" Margin="8,0"/>
                        <Button Grid.Column="2" Content="+"
                                Style="{StaticResource QtyButtonStyle}"
                                Background="{DynamicResource SuccessBrush}"
                                Command="{Binding IncreaseCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Preview -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12" Padding="20,16" Margin="0,0,0,16"
                    SnapsToDevicePixels="True">
                <StackPanel>
                    <TextBlock Text="PURCHASE PREVIEW"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,10"/>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Total SQM" FontSize="12"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding TotalSqm, StringFormat={}{0:N2}}"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="New total stock" FontSize="12"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding NewStockAfterBuy}"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="New balance (available)" FontSize="12"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding NewBalanceAfterBuy}"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="#047857"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Separator Opacity="0.3" Margin="0,6"/>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="Total Cost" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="{Binding TotalCost, StringFormat={}{0:N2} AED}"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#B91C1C" HorizontalAlignment="Right"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Buttons -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel"
                        Style="{StaticResource CancelButtonStyle}"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"/>
                <Button Grid.Column="2" Content="✓ Confirm Purchase"
                        Style="{StaticResource ConfirmButtonStyle}"
                        Command="{Binding ConfirmCommand}"
                        IsDefault="True"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Window>