<!-- ═══════════════════════════════════════════════════════════════
     MIGRATION LOG — Button Standardization (master prompt v1.0)
     Date: 2026-08-15 — SheetStore module batch
     • All buttons -> centralized PrimaryPill/SuccessPill/OutlinedPill/
       DangerButton styles with MDL2 Tag glyphs + UPPERCASE content
     • Removed legacy local styles (ActionBtn, HeaderActionBtn,
       QtyButtonStyle, Cancel/Save/ConfirmButtonStyle,
       FilterActionButtonStyle, CancelImportBtn)
     • Decorative emojis (search/clock/empty/mailbox) -> MDL2 glyphs
     Commands/bindings preserved; no ViewModel changes.
═══════════════════════════════════════════════════════════════ -->
<Window x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreBuy.BuyDialogView"
             TextOptions.TextHintingMode="Fixed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
        Title="{DynamicResource SheetStore.BUYStock}"
        Width="480"
        MinWidth="480"
        SizeToContent="Height"
        MaxHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="Transparent"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- Standard dialog: Esc → Cancel · Enter → Confirm -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
        <KeyBinding Key="Enter" Command="{Binding ConfirmCommand}"/>
    </Window.InputBindings>

    <Window.Resources>

        <!-- Field label — 11 SemiBold UPPERCASE + MutedForeground -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
        </Style>

        <!-- Quantity ± button (large, high contrast) -->

        <!-- Cancel button — secondary neutral -->

        <!-- Confirm button — primary Deep Forest (constructive) -->

    </Window.Resources>

    <!-- 2026-09-09 shell upgrade: the borderless professional chrome —
         CardCornerRadiusLarge card + outline + soft elevation shadow;
         the OS title bar / resize-grip frame is gone everywhere. -->
    <Border Margin="18"
            CornerRadius="{DynamicResource CardCornerRadiusLarge}"
            Background="{DynamicResource DialogSurfaceBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="1"
            Padding="4,4,4,4"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24"
                              ShadowDepth="0" Opacity="0.45"/>
        </Border.Effect>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  IsDeferredScrollingEnabled="False"
                  PanningMode="None"
                  Focusable="True"
                  FocusVisualStyle="{x:Null}"
                  Background="Transparent"
                  behaviors:SmoothScrollBehavior.IsEnabled="True">
        <StackPanel Margin="24">

            <!-- Header -->
            <StackPanel Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextDisplay}" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource SheetStore.BUYStock}" FontSize="{StaticResource TextHeadline}" FontWeight="Bold" Margin="12,0,0,0"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                </StackPanel>
                <TextBlock Text="{DynamicResource SheetStore.AddMoreSheetsInventory}"
                           FontSize="{StaticResource TextBody}" Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </StackPanel>

            <!-- Sheet info card -->
            <Border Background="{DynamicResource DialogInsetBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}" Padding="16,14" Margin="0,0,0,16"
                    SnapsToDevicePixels="True">
                <StackPanel>
                    <TextBlock Text="{Binding Sheet.Category}" FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding Sheet.ThicknessDisplay}" FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Sheet.Color}" FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Sheet.SizeDisplay}" FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{DynamicResource SheetStore.TotalStock}" FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding Sheet.Stock}" FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="{DynamicResource SheetStore.Used}" FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding Sheet.Used}" FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="{DynamicResource SheetStore.Balance}" FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding Sheet.Balance}" FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{DynamicResource Common.Price}" FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding Sheet.PurchasePricePerSqm, StringFormat={}{0:0.##}}"
                                   FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="{DynamicResource SheetStore.AEDSQMSQMSheet}" FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding Sheet.SqmPerSheet, StringFormat={}{0:N4}}"
                                   FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Quantity selector -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}" Padding="20,16" Margin="0,0,0,16"
                    SnapsToDevicePixels="True">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SheetStore.QuantitySheets}"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource OutlinedPillButton}"
                                Content="−" MinWidth="50"
                                ToolTip="{DynamicResource SheetStore.DecreaseQuantity}"
                                Command="{Binding DecreaseCommand}"/>
                        <!-- Quantity TextBox — integer-only, big centered number -->
                        <TextBox Grid.Column="1"
                                 Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:TextBoxBehaviors.AcceptIntegersOnly="True"
                                 FontSize="{StaticResource TextDisplayLarge}" FontWeight="Bold" TextAlignment="Center"
                                 VerticalContentAlignment="Center" Height="44"
                                 Background="{DynamicResource DialogInsetBrush}"
                                 Foreground="{DynamicResource PrimaryForegroundBrush}"
                                 BorderThickness="0" Margin="8,0"/>
                        <Button Grid.Column="2" Style="{StaticResource OutlinedPillButton}"
                                Content="+" MinWidth="50"
                                ToolTip="{DynamicResource SheetStore.IncreaseQuantity}"
                                Command="{Binding IncreaseCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Preview -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}" Padding="20,16" Margin="0,0,0,16"
                    SnapsToDevicePixels="True">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SheetStore.PurchasePreview}"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,10"/>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource DeliveryNote.TotalSQM}" FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding TotalSqm, Converter={StaticResource CurrencyConverter}}"
                                   FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource SheetStore.NewTotalStock}" FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding NewStockAfterBuy}"
                                   FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource SheetStore.NewBalanceAvailable}" FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding NewBalanceAfterBuy}"
                                   FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Separator Opacity="0.3" Margin="0,6"/>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="{DynamicResource JobProfitability.TotalCOST}" FontSize="{StaticResource TextSection}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="{Binding TotalCost, Converter={StaticResource CurrencyConverter}, ConverterParameter=suffix}"
                                   FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                   Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Right"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Buttons -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource OutlinedPillButton}"
                        Tag="&#xE711;" Content="{DynamicResource Action.Cancel}"
                        ToolTip="{DynamicResource SheetStore.CloseWithoutBuying}"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"/>
                <Button Grid.Column="2" Style="{StaticResource SuccessPillButton}"
                        Tag="&#xE73E;" Content="{DynamicResource SheetStore.ConfirmPurchase}"
                        ToolTip="{DynamicResource SheetStore.ConfirmAddStock}"
                        Command="{Binding ConfirmCommand}"
                        IsDefault="True"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
    </Border>
</Window>