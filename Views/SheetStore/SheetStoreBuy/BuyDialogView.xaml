<!-- ═══════════════════════════════════════════════════════════════
     SHEET STORE — Buy / Receive Stock Dialog
     Bento Design System: Clean metric cards, big clear quantity
     stepper, purchase projection, and standardized 36px action buttons.
═══════════════════════════════════════════════════════════════ -->
<dialogs:ThemedDialogWindow x:Class="ProGlassAutomation.Views.SheetStore.SheetStoreBuy.BuyDialogView"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
                            xmlns:dialogs="clr-namespace:ProGlassAutomation.Views.Shared.Dialogs"
                            Title="{DynamicResource SheetStore.BUYStock}"
                            Width="500"
                            DialogIcon="&#xE7B8;"
                            DialogSubtitle="{DynamicResource SheetStore.AddMoreSheetsInventory}"
                            FontFamily="{DynamicResource AppFontFamily}">

    <dialogs:ThemedDialogWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Dashboard/Overview/IndigoStudioResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </dialogs:ThemedDialogWindow.Resources>

    <StackPanel>
        <!-- 1. Sheet Info Bento Card -->
        <Border Style="{StaticResource Ov.CardCompact}" Margin="0,0,0,14" Background="{DynamicResource Ov.Soft}">
            <StackPanel>
                <TextBlock Text="{Binding Sheet.Category}" Style="{StaticResource Ov.CardTitle}"
                           Foreground="{DynamicResource Ov.Accent}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding Sheet.ThicknessDisplay}" Style="{StaticResource Ov.Meta}" FontWeight="{DynamicResource Weight.Bold}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Sheet.Color}" Style="{StaticResource Ov.Meta}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Sheet.SizeDisplay}" Style="{StaticResource Ov.Meta}"/>
                </StackPanel>

                <!-- Inner tint groups (zero concentric card styles) -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource Ov.Surface}" CornerRadius="8" Padding="10,8" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SheetStore.TotalStock}" Style="{StaticResource Ov.Meta}"/>
                            <TextBlock Text="{Binding Sheet.Stock}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{DynamicResource Ov.DangerSoft}" CornerRadius="8" Padding="10,8" Margin="2,0,2,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SheetStore.Used}" Style="{StaticResource Ov.Meta}" Foreground="{DynamicResource Ov.Danger}"/>
                            <TextBlock Text="{Binding Sheet.Used}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.Danger}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource Ov.SuccessSoft}" CornerRadius="8" Padding="10,8" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SheetStore.Balance}" Style="{StaticResource Ov.Meta}" Foreground="{DynamicResource Ov.Success}"/>
                            <TextBlock Text="{Binding Sheet.Balance}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource Ov.Success}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <DockPanel Margin="0,10,0,0">
                    <TextBlock Text="{DynamicResource Common.Price}" Style="{StaticResource Ov.Meta}"/>
                    <TextBlock Text="{Binding Sheet.PurchasePricePerSqm, StringFormat={}{0:0.##} AED/m²}"
                               Style="{StaticResource Ov.Meta}" FontWeight="{DynamicResource Weight.Bold}" Margin="6,0,0,0"/>
                    <TextBlock Text="{Binding Sheet.SqmPerSheet, StringFormat={}  ·  {0:N4} m²/sheet}"
                               Style="{StaticResource Ov.Meta}"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- 2. Quantity Selector Bento Card -->
        <Border Style="{StaticResource Ov.CardCompact}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{DynamicResource SheetStore.QuantitySheets}"
                           Style="{StaticResource Ov.Meta}" FontWeight="{DynamicResource Weight.Bold}"
                           Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="54"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource OutlinedPillButton}"
                            Height="44" Padding="0"
                            Content="−" FontSize="18"
                            ToolTip="{DynamicResource SheetStore.DecreaseQuantity}"
                            Command="{Binding DecreaseCommand}"/>

                    <TextBox Grid.Column="1"
                             Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                             behaviors:TextBoxBehaviors.SelectAllOnFocus="True"
                             behaviors:TextBoxBehaviors.AcceptIntegersOnly="True"
                             FontSize="22" FontWeight="{DynamicResource Weight.Bold}" TextAlignment="Center"
                             VerticalContentAlignment="Center" Height="44"
                             Background="{DynamicResource Ov.Soft}"
                             Foreground="{DynamicResource Ov.Ink}"
                             Margin="8,0">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasQuantityError}" Value="True">
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Ov.Danger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Button Grid.Column="2" Style="{StaticResource OutlinedPillButton}"
                            Height="44" Padding="0"
                            Content="+" FontSize="18"
                            ToolTip="{DynamicResource SheetStore.IncreaseQuantity}"
                            Command="{Binding IncreaseCommand}"/>
                </Grid>

                <TextBlock Text="{Binding QuantityError}"
                           Foreground="{DynamicResource Ov.Danger}"
                           FontSize="{DynamicResource FontSize.BodySmall}"
                           FontWeight="{DynamicResource Weight.SemiBold}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           Visibility="{Binding HasQuantityError, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <!-- 3. Purchase Preview Bento Card -->
        <Border Style="{StaticResource Ov.CardCompact}" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="{DynamicResource SheetStore.PurchasePreview}"
                           Style="{StaticResource Ov.Meta}" FontWeight="{DynamicResource Weight.Bold}"
                           Margin="0,0,0,10"/>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="{DynamicResource DeliveryNote.TotalSQM}" Style="{StaticResource Ov.Meta}"/>
                    <TextBlock Text="{Binding TotalSqm, Converter={StaticResource CurrencyConverter}, ConverterParameter=area}"
                               Style="{StaticResource Ov.Meta}" FontWeight="{DynamicResource Weight.Bold}"
                               HorizontalAlignment="Right"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="{DynamicResource SheetStore.NewTotalStock}" Style="{StaticResource Ov.Meta}"/>
                    <TextBlock Text="{Binding NewStockAfterBuy}"
                               Style="{StaticResource Ov.Meta}" FontWeight="{DynamicResource Weight.Bold}"
                               HorizontalAlignment="Right"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="{DynamicResource SheetStore.NewBalanceAvailable}" Style="{StaticResource Ov.Meta}"/>
                    <TextBlock Text="{Binding NewBalanceAfterBuy}"
                               Style="{StaticResource Ov.Meta}" FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource Ov.Success}"
                               HorizontalAlignment="Right"/>
                </DockPanel>
                <Border Height="1" Background="{DynamicResource Ov.Line}" Margin="0,2,0,10"/>
                <DockPanel>
                    <TextBlock Text="{DynamicResource JobProfitability.TotalCOST}"
                               Style="{StaticResource Ov.CardTitle}" VerticalAlignment="Center"/>
                    <Viewbox MaxHeight="28" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding TotalCost, Converter={StaticResource CurrencyConverter}, ConverterParameter=suffix}"
                                   Style="{StaticResource Ov.Value}"
                                   Foreground="{DynamicResource Ov.Danger}"/>
                    </Viewbox>
                </DockPanel>
            </StackPanel>
        </Border>
    </StackPanel>

    <!-- Standardized 36px Dialog Footer Actions -->
    <dialogs:ThemedDialogWindow.FooterContent>
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource OutlinedPillButton}"
                    Height="36" Padding="16,0"
                    Tag="&#xE711;" Content="{DynamicResource Action.Cancel}"
                    ToolTip="{DynamicResource SheetStore.CloseWithoutBuying}"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"/>
            <Button Grid.Column="2" Style="{StaticResource SuccessPillButton}"
                    Height="36" Padding="16,0"
                    Tag="&#xE73E;" Content="{DynamicResource SheetStore.ConfirmPurchase}"
                    ToolTip="{DynamicResource SheetStore.ConfirmAddStock}"
                    Command="{Binding ConfirmCommand}"
                    IsDefault="True"/>
        </Grid>
    </dialogs:ThemedDialogWindow.FooterContent>
</dialogs:ThemedDialogWindow>
