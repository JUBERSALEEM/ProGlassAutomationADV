                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush"
                                                Value="{StaticResource PillBorderLightBrush}"/>
                                        <Setter Property="Background"
                                                Value="{DynamicResource ModuleBackgroundBrush}"/>
