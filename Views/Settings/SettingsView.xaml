                                                <Style TargetType="Button"
                                                       BasedOn="{StaticResource ProviderSelectButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGeminiActive}"
                                                                     Value="True">
                                                            <Setter Property="Content"
                                                                    Value="✓ ACTIVE"/>
                                                            <Setter Property="Foreground"
                                                                    Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DockPanel>
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="API KEY"
                                                   Style="{StaticResource LabelStyle}"/>
                                        <PasswordBox x:Name="GeminiKeyBox"
                                                     Style="{StaticResource RoundedPasswordBoxStyle}"
