                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Margin="0,10,0,0"
                                       Text="Master toggle. When disabled, the chat button is hidden and no API calls are made."/>
                        </StackPanel>
                    </Border>

                    <!-- DATA ACCESS -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="DATA ACCESS"
                                       Style="{StaticResource SectionLabelStyle}"/>
                            <DockPanel Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="📊" FontSize="18"
