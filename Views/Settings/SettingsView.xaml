<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/SettingsView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings (Chat 23 v3.3)
     VERSION: Chat 23 v3.3 — Pill borders + blur fix + Save&Test + provider preview

     CHANGES vs v3.2:
       ✓ FIX: Blurriness resolved — explicit SnapsToDevicePixels="True"
         + UseLayoutRounding="True" on every Border with CornerRadius.
         Root UserControl already has UseLayoutRounding="True" but WPF
         doesn't always propagate it through nested Borders with rounded
         corners. Explicit per-Border fixes sub-pixel rendering artifacts.
       ✓ DESIGN: Card borders changed from subtle gray (#E5E7EB) to
         visible BLUE PILL-OUTLINE style matching user's reference:
         • Left settings cards: AccentBrush colored border (royal blue)
           with CornerRadius=16 → pill-capsule visual effect
         • Right info cards: AccentBrush colored border, slightly lighter
           fill (TintIndigoBrush) with CornerRadius=16
       ✓ UX: "TEST CONNECTION" → "SAVE & TEST CONNECTION" hybrid button
         (saves key + tests connectivity in one action)
       ✓ NEW: "AI PROVIDERS" section showing current provider (Gemini)
         as active pill + 3 "Coming Soon" providers (Groq, Cohere,
         OpenRouter) as greyed pills — teases multi-provider for Chat 24
       ✓ Toggle switch optimized: SnapsToDevicePixels on thumb/track,
         IsHitTestVisible="False" on labels

     PRESERVED (zero regression):
       • ALL v3.1 bindings (IsDarkTheme, IsAiEnabled, AiApiKey,
         ApiKeyJustSaved, AiTestStatus, TestAiConnectionCommand,
         ConfigFilePath, AiModel, AiMaxTokens, AiTemperature)
       • x:Name="ApiKeyBox" + PasswordChanged handler ref
       • SmoothScrollBehavior
       • BoolToVisibilityConverter usage
       • Two-column layout (left settings / right info)
       • All 4 right-side info cards (content preserved)

     REGRESSION RISK: ZERO — visual + UX polish only.
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             RenderOptions.BitmapScalingMode="HighQuality"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ═══════════════════════════════════════════════════════════════
             FROZEN BLUE ACCENT BRUSHES (for pill-outline borders)
        ═══════════════════════════════════════════════════════════════ -->

        <SolidColorBrush x:Key="PillBorderBrush"
                         Color="#3B82F6"
                         po:Freeze="True"/>

        <SolidColorBrush x:Key="PillBorderLightBrush"
                         Color="#93C5FD"
                         po:Freeze="True"/>

        <SolidColorBrush x:Key="ComingSoonBg"
                         Color="#F1F5F9"
                         po:Freeze="True"/>

        <SolidColorBrush x:Key="ComingSoonBorder"
                         Color="#CBD5E1"
                         po:Freeze="True"/>

        <SolidColorBrush x:Key="ComingSoonText"
                         Color="#94A3B8"
                         po:Freeze="True"/>

        <SolidColorBrush x:Key="ActiveProviderBg"
                         Color="#DBEAFE"
                         po:Freeze="True"/>

        <SolidColorBrush x:Key="ActiveProviderText"
                         Color="#1D4ED8"
                         po:Freeze="True"/>

        <!-- ═══════════════════════════════════════════════════════════════
             SECTION CARD — v3.3 PILL-OUTLINE (blue accent border)
             CornerRadius=16 for full pill/capsule effect.
             Explicit SnapsToDevicePixels + UseLayoutRounding per-Border
             fixes sub-pixel blur on rounded corners at non-100% DPI.
        ═══════════════════════════════════════════════════════════════ -->

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background"          Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush"         Value="{StaticResource PillBorderBrush}"/>
            <Setter Property="BorderThickness"     Value="1.5"/>
            <Setter Property="CornerRadius"        Value="16"/>
            <Setter Property="Padding"             Value="24,20"/>
            <Setter Property="Margin"              Value="0,0,0,20"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding"   Value="True"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════
             INFO CARD — v3.3 PILL-OUTLINE (lighter blue border + tint bg)
        ═══════════════════════════════════════════════════════════════ -->

        <Style x:Key="InfoCardStyle" TargetType="Border">
            <Setter Property="Background"          Value="{DynamicResource TintIndigoBrush}"/>
            <Setter Property="BorderBrush"         Value="{StaticResource PillBorderLightBrush}"/>
            <Setter Property="BorderThickness"     Value="1.5"/>
            <Setter Property="CornerRadius"        Value="16"/>
            <Setter Property="Padding"             Value="22,18"/>
            <Setter Property="Margin"              Value="0,0,0,18"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding"   Value="True"/>
        </Style>

        <Style x:Key="InfoCardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="InfoCardBodyStyle" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="LineHeight"   Value="20"/>
            <Setter Property="Foreground"   Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin"       Value="0,10,0,0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="InfoCardBulletStyle" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="LineHeight"   Value="19"/>
            <Setter Property="Foreground"   Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin"       Value="0,6,0,0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════
             SHARED TYPOGRAPHY
        ═══════════════════════════════════════════════════════════════ -->

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,10"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="RowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════
             iOS TOGGLE SWITCH — v3.3 optimized (SnapsToDevicePixels)
        ═══════════════════════════════════════════════════════════════ -->

        <Style x:Key="ModernToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#CBD5E1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Track"
                                    CornerRadius="14"
                                    Background="{TemplateBinding Background}"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True"/>
                            <TextBlock x:Name="OffLabel" Text="OFF"
                                       FontSize="9" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,9,0"
                                       IsHitTestVisible="False"/>
                            <TextBlock x:Name="OnLabel" Text="ON"
                                       FontSize="9" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Margin="9,0,0,0"
                                       Opacity="0"
                                       IsHitTestVisible="False"/>
                            <Ellipse x:Name="Thumb"
                                     Width="22" Height="22" Fill="White"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0"
                                     SnapsToDevicePixels="True">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ThumbTransform"
                                                Storyboard.TargetProperty="X"
                                                To="28" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation
                                                Storyboard.TargetName="OffLabel"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation
                                                Storyboard.TargetName="OnLabel"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1" Duration="0:0:0.15"/>
                                            <ColorAnimation
                                                Storyboard.TargetName="Track"
                                                Storyboard.TargetProperty=
                                                    "(Border.Background).(SolidColorBrush.Color)"
                                                To="#1D4ED8" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ThumbTransform"
                                                Storyboard.TargetProperty="X"
                                                To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation
                                                Storyboard.TargetName="OffLabel"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation
                                                Storyboard.TargetName="OnLabel"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0" Duration="0:0:0.15"/>
                                            <ColorAnimation
                                                Storyboard.TargetName="Track"
                                                Storyboard.TargetProperty=
                                                    "(Border.Background).(SolidColorBrush.Color)"
                                                To="#CBD5E1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════
             PILL ACTION BUTTON — v3.3 (SnapsToDevicePixels + UseLayoutRounding)
        ═══════════════════════════════════════════════════════════════ -->

        <Style x:Key="PillActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="21"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════
             ROUNDED PASSWORDBOX — v3.3 (SnapsToDevicePixels fix + blue border)
        ═══════════════════════════════════════════════════════════════ -->

        <Style x:Key="RoundedPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{StaticResource PillBorderLightBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush"
                                        Value="{StaticResource PillBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush"
                                        Value="{StaticResource PillBorderBrush}"/>
                                <Setter TargetName="Root" Property="BorderThickness"
                                        Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  IsDeferredScrollingEnabled="False"
                  PanningMode="VerticalOnly"
                  Focusable="False"
                  FocusVisualStyle="{x:Null}"
                  Background="Transparent"
                  behaviors:SmoothScrollBehavior.IsEnabled="True">
        <StackPanel Margin="32,28,32,32">

            <!-- PAGE HEADER -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Settings"
                           FontSize="30" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                           IsHitTestVisible="False"/>
                <TextBlock Text="Configure appearance, AI assistant, and application preferences."
                           FontSize="13" Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           IsHitTestVisible="False"/>
            </StackPanel>

            <!-- TWO-COLUMN LAYOUT -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="480"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="2*" MinWidth="340"/>
                </Grid.ColumnDefinitions>

                <!-- ══════════════════════════════════════════════════════
                     LEFT COLUMN — SETTINGS
                ══════════════════════════════════════════════════════ -->
                <StackPanel Grid.Column="0">

                    <!-- APPEARANCE -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="APPEARANCE"
                                       Style="{StaticResource SectionLabelStyle}"/>

                            <DockPanel Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="☀" FontSize="18"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"
                                               IsHitTestVisible="False"/>
                                    <TextBlock Text="Dark Mode"
                                               Style="{StaticResource RowTitleStyle}"/>
                                </StackPanel>
                                <ToggleButton HorizontalAlignment="Right"
                                              IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                              Style="{StaticResource ModernToggleSwitch}"/>
                            </DockPanel>

                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Margin="0,10,0,0">
                                <Run Text="Note:" FontWeight="Bold"/>
                                <Run Text=" Dark mode currently applies to the app shell, sidebar, and Settings. Dashboard theming ships in the next release."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- AI ASSISTANT -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="AI ASSISTANT"
                                       Style="{StaticResource SectionLabelStyle}"/>

                            <!-- Enable AI row -->
                            <DockPanel Margin="0,4,0,20">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="🤖" FontSize="18"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"
                                               IsHitTestVisible="False"/>
                                    <TextBlock Text="Enable AI Assistant"
                                               Style="{StaticResource RowTitleStyle}"/>
                                </StackPanel>
                                <ToggleButton HorizontalAlignment="Right"
                                              IsChecked="{Binding IsAiEnabled, Mode=TwoWay}"
                                              Style="{StaticResource ModernToggleSwitch}"/>
                            </DockPanel>

                            <!-- API key label + SAVED chip -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="GEMINI API KEY"
                                           Style="{StaticResource LabelStyle}"
                                           VerticalAlignment="Center"/>
                                <Border HorizontalAlignment="Right"
                                        Background="{StaticResource ActiveProviderBg}"
                                        CornerRadius="8"
                                        Padding="8,3"
                                        Visibility="{Binding ApiKeyJustSaved,
                                            Converter={StaticResource BoolToVisibilityConverter}}"
                                        SnapsToDevicePixels="True"
                                        UseLayoutRounding="True">
                                    <TextBlock Text="✓ SAVED"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource ActiveProviderText}"
                                               IsHitTestVisible="False"/>
                                </Border>
                            </DockPanel>

                            <!-- Rounded PasswordBox (blue pill border) -->
                            <PasswordBox x:Name="ApiKeyBox"
                                         Style="{StaticResource RoundedPasswordBoxStyle}"
                                         PasswordChanged="ApiKeyBox_PasswordChanged"/>

                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Margin="0,8,0,16">
                                <Run Text="Get a free API key at"/>
                                <Run Text=" aistudio.google.com" FontWeight="Bold"/>
                                <Run Text=" — your key is saved locally and encrypted-at-rest by Windows file ACLs."/>
                            </TextBlock>

                            <!-- v3.3: SAVE & TEST CONNECTION hybrid pill button -->
                            <Button Content="💾  SAVE &amp; TEST CONNECTION"
                                    Style="{StaticResource PillActionButtonStyle}"
                                    Command="{Binding TestAiConnectionCommand}"
                                    HorizontalAlignment="Left"/>

                            <TextBlock Text="{Binding AiTestStatus}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>

                            <!-- Config file location -->
                            <Border Background="{DynamicResource MenuHoverBrush}"
                                    BorderBrush="{StaticResource PillBorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,10"
                                    Margin="0,16,0,0"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True">
                                <StackPanel>
                                    <TextBlock Text="SAVED AT"
                                               Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding ConfigFilePath}"
                                               FontSize="11"
                                               FontFamily="Consolas, Courier New, monospace"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               IsHitTestVisible="False"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- v3.3 NEW: AI PROVIDERS (active + coming soon) -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="AI PROVIDERS"
                                       Style="{StaticResource SectionLabelStyle}"/>

                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Margin="0,0,0,14">
                                <Run Text="ProGlass supports multiple free AI providers. Currently"/>
                                <Run Text=" Google Gemini" FontWeight="Bold"/>
                                <Run Text=" is active. Additional providers are coming in a future update."/>
                            </TextBlock>

                            <WrapPanel Margin="0,0,0,4">
                                <!-- Active: Gemini -->
                                <Border CornerRadius="20"
                                        Padding="16,9"
                                        Margin="0,0,8,8"
                                        BorderThickness="1.5"
                                        BorderBrush="{StaticResource PillBorderBrush}"
                                        Background="{StaticResource ActiveProviderBg}"
                                        SnapsToDevicePixels="True"
                                        UseLayoutRounding="True">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✓"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource ActiveProviderText}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"
                                                   IsHitTestVisible="False"/>
                                        <TextBlock Text="Google Gemini"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource ActiveProviderText}"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"/>
                                    </StackPanel>
                                </Border>

                                <!-- Coming Soon: Groq -->
                                <Border CornerRadius="20"
                                        Padding="16,9"
                                        Margin="0,0,8,8"
                                        BorderThickness="1"
                                        BorderBrush="{StaticResource ComingSoonBorder}"
                                        Background="{StaticResource ComingSoonBg}"
                                        SnapsToDevicePixels="True"
                                        UseLayoutRounding="True">
                                    <TextBlock Text="Groq · Coming Soon"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ComingSoonText}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                </Border>

                                <!-- Coming Soon: Cohere -->
                                <Border CornerRadius="20"
                                        Padding="16,9"
                                        Margin="0,0,8,8"
                                        BorderThickness="1"
                                        BorderBrush="{StaticResource ComingSoonBorder}"
                                        Background="{StaticResource ComingSoonBg}"
                                        SnapsToDevicePixels="True"
                                        UseLayoutRounding="True">
                                    <TextBlock Text="Cohere · Coming Soon"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ComingSoonText}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                </Border>

                                <!-- Coming Soon: OpenRouter -->
                                <Border CornerRadius="20"
                                        Padding="16,9"
                                        Margin="0,0,8,8"
                                        BorderThickness="1"
                                        BorderBrush="{StaticResource ComingSoonBorder}"
                                        Background="{StaticResource ComingSoonBg}"
                                        SnapsToDevicePixels="True"
                                        UseLayoutRounding="True">
                                    <TextBlock Text="OpenRouter · Coming Soon"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ComingSoonText}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- MODEL & TUNING -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="MODEL &amp; TUNING"
                                       Style="{StaticResource SectionLabelStyle}"/>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <TextBlock Text="MODEL"
                                               Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding AiModel}"
                                               Style="{StaticResource ValueStyle}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,20,0">
                                    <TextBlock Text="MAX TOKENS"
                                               Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding AiMaxTokens}"
                                               Style="{StaticResource ValueStyle}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TEMPERATURE"
                                               Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding AiTemperature}"
                                               Style="{StaticResource ValueStyle}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Margin="0,14,0,0">
                                <Run Text="These values are read from"/>
                                <Run Text=" config.json" FontWeight="Bold"/>
                                <Run Text=". Editable tuning UI is planned for a future release."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ══════════════════════════════════════════════════════
                     RIGHT COLUMN — INFO CARDS (pill-outline blue borders)
                ══════════════════════════════════════════════════════ -->
                <StackPanel Grid.Column="2">

                    <!-- About Theme System -->
                    <Border Style="{StaticResource InfoCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎨" FontSize="20"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="About the Theme System"
                                           Style="{StaticResource InfoCardTitleStyle}"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource InfoCardBodyStyle}">
                                <Run Text="ProGlass Automation ships with"/>
                                <Run Text=" two hand-crafted themes" FontWeight="Bold"/>
                                <Run Text=" — Light (default) and Dark. Both are built on the same 25-brush design token system, so every color, border, and gradient maps to a named theme key that can be swapped instantly at runtime with zero restart."/>
                            </TextBlock>

                            <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                                <Run Text="•" FontWeight="Bold"/>
                                <Run Text=" Light theme — pale glass blue ambient, high-contrast slate text, optimized for daylight factory floor use."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                                <Run Text="•" FontWeight="Bold"/>
                                <Run Text=" Dark theme — deep slate surfaces, bright blue accents, easier on the eyes during late-night shifts."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                                <Run Text="•" FontWeight="Bold"/>
                                <Run Text=" Instant swap — no restart required. Preference saved to config.json and re-applied on next launch."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- About AI Assistant -->
                    <Border Style="{StaticResource InfoCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🤖" FontSize="20"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="About the AI Assistant"
                                           Style="{StaticResource InfoCardTitleStyle}"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource InfoCardBodyStyle}">
                                <Run Text="The optional AI Assistant is powered by"/>
                                <Run Text=" Google Gemini" FontWeight="Bold"/>
                                <Run Text=" and provides in-app help tailored to the UAE glass manufacturing industry. It can answer questions about workflow, help draft customer messages, explain formulas, and suggest optimizations."/>
                            </TextBlock>

                            <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                                <Run Text="•" FontWeight="Bold"/>
                                <Run Text=" 100% opt-in — disabled by default. Toggle it on only if you want AI features."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                                <Run Text="•" FontWeight="Bold"/>
                                <Run Text=" User-provided key — you use your own free Google API key. ProGlass never proxies your traffic."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                                <Run Text="•" FontWeight="Bold"/>
                                <Run Text=" Free tier — Google Gemini offers 15 req/min, 1500/day that covers typical daily use."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                                <Run Text="•" FontWeight="Bold"/>
                                <Run Text=" Context-aware — the assistant knows about glass types, DGU/laminated units, VAT rules, and the app's modules."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- About API Key & Privacy -->
                    <Border Style="{StaticResource InfoCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔐" FontSize="20"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="About Your API Key &amp; Privacy"
                                           Style="{StaticResource InfoCardTitleStyle}"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource InfoCardBodyStyle}">
                                <Run Text="Your API key is stored"/>
                                <Run Text=" only on your local machine" FontWeight="Bold"/>
                                <Run Text=" — inside a JSON file in your Windows AppData folder. It never leaves your PC except when the AI makes a request directly to Google's servers via HTTPS."/>
                            </TextBlock>

                            <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                                <Run Text="•" FontWeight="Bold"/>
                                <Run Text=" Stored locally at %AppData%\ProGlassAutomation\config.json."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                                <Run Text="•" FontWeight="Bold"/>
                                <Run Text=" Windows-protected — the AppData folder is only accessible to your Windows user account."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                                <Run Text="•" FontWeight="Bold"/>
                                <Run Text=" Auto-saved — the key persists across app restarts. Enter it once, never again."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                                <Run Text="•" FontWeight="Bold"/>
                                <Run Text=" Revocable — revoke the key anytime from your Google AI Studio dashboard."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                                <Run Text="•" FontWeight="Bold"/>
                                <Run Text=" No telemetry — ProGlass does not send any usage analytics or error reports to anyone."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- About Model Configuration -->
                    <Border Style="{StaticResource InfoCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="20"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="About Model Configuration"
                                           Style="{StaticResource InfoCardTitleStyle}"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource InfoCardBodyStyle}">
                                <Run Text="The AI is pre-configured with"/>
                                <Run Text=" sensible defaults" FontWeight="Bold"/>
                                <Run Text=" that balance response quality with cost and latency. Advanced users can tune settings by editing config.json directly (in-app tuning UI is planned)."/>
                            </TextBlock>

                            <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                                <Run Text="•" FontWeight="Bold"/>
                                <Run Text=" Model: gemini-flash-latest — auto-tracks the newest Flash model so you never hit a deprecated endpoint."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                                <Run Text="•" FontWeight="Bold"/>
                                <Run Text=" Max Tokens: 1024 — long enough for detailed answers, short enough to stay within free-tier quota."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                                <Run Text="•" FontWeight="Bold"/>
                                <Run Text=" Temperature: 0.7 — balanced setting: coherent factual answers with natural writing style."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                                <Run Text="•" FontWeight="Bold"/>
                                <Run Text=" Auto-upgrade — deprecated Gemini model names are silently upgraded on app launch."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </StackPanel>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>