                                            <Button.Style>
                                                <Style TargetType="Button"
                                                       BasedOn="{StaticResource ProviderSelectButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCohereActive}"
                                                                     Value="True">
                                                            <Setter Property="Content"
                                                                    Value="✓ ACTIVE"/>
                                                            <Setter Property="Foreground"
                                                                    Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
