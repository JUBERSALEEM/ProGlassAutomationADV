                                    Padding="12,10" Margin="0,12,0,0"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True">
                                <StackPanel>
                                    <TextBlock Text="ALL KEYS SAVED AT"
                                               Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding ConfigFilePath}"
                                               FontSize="11"
                                               FontFamily="Consolas, Courier New, monospace"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               IsHitTestVisible="False"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- MODEL & TUNING -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="MODEL &amp; TUNING"
                                       Style="{StaticResource SectionLabelStyle}"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <TextBlock Text="MODEL"
                                               Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding AiModel}"
                                               Style="{StaticResource ValueStyle}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,20,0">
                                    <TextBlock Text="MAX TOKENS"
                                               Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding AiMaxTokens}"
                                               Style="{StaticResource ValueStyle}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TEMPERATURE"
                                               Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding AiTemperature}"
                                               Style="{StaticResource ValueStyle}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Margin="0,14,0,0">
                                <Run Text="These values are read from"/>
                                <Run Text=" config.json" FontWeight="Bold"/>
                                <Run Text=". Editable tuning UI is planned for a future release."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ══════════════════════════════════════════════
                         VOICE ASSISTANT
                    ══════════════════════════════════════════════ -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="VOICE ASSISTANT"
                                       Style="{StaticResource SectionLabelStyle}"/>

                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Margin="0,0,0,14">
                                <Run Text="ProGlass AI supports"/>
                                <Run Text=" voice input" FontWeight="Bold"/>
                                <Run Text=" via OpenAI Whisper running locally. 95%+ accuracy, works offline, handles accents."/>
                            </TextBlock>

                            <!-- MODEL SELECTOR LABEL -->
                            <TextBlock Text="SELECT WHISPER MODEL"
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0,0,0,8"/>

                            <!--
                                 ═══════════════════════════════════════
                                 MODEL OPTION CARDS
                                 ─────────────────────────────────────
                                 FIX XLS0501: The Border element has NO
                                 Style= attribute. All styling is via
                                 <Border.Style> child element only,
                                 using BasedOn="ModelOptionCardStyle".
                                 The base style provides all shared
                                 setters (CornerRadius, Padding, etc.)
                                 The child Style adds hover DataTrigger.
                                 ═══════════════════════════════════════
                            -->
                            <ItemsControl ItemsSource="{Binding WhisperModelOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--
                                             NO Style= attribute here.
                                             Styling exclusively via
                                             <Border.Style> below.
                                             Tag holds model key string
                                             for code-behind handler.
                                        -->
                                        <Border MouseLeftButtonDown="ModelOption_MouseLeftButtonDown"
                                                Tag="{Binding Key}">
                                            <Border.Style>
                                                <!--
                                                     BasedOn pulls all shared setters
                                                     (CornerRadius=10, Padding=12,10,
                                                      Margin=0,0,0,8, BorderThickness=1.5,
                                                      Cursor=Hand, SnapsToDevicePixels,
                                                      UseLayoutRounding, BorderBrush,
                                                      Background) from ModelOptionCardStyle.
                                                     No duplication. No double-set.
                                                -->
                                                <Style TargetType="Border"
                                                       BasedOn="{StaticResource ModelOptionCardStyle}">
                                                    <Style.Triggers>
                                                        <!--
                                                             Hover: darken border slightly.
                                                             Background stays on ModuleBackgroundBrush
                                                             unless this card is the selected one
                                                             (selection highlight handled by VM
                                                              in Phase 2 if needed).
                                                        -->
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush"
                                                                    Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Model info -->
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="13" FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                               IsHitTestVisible="False"/>
                                                    <TextBlock FontSize="10"
                                                               Margin="0,2,0,0"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               IsHitTestVisible="False">
                                                        <Run Text="{Binding SizeMB, Mode=OneWay}"/>
                                                        <Run Text=" MB · "/>
                                                        <Run Text="{Binding Accuracy, Mode=OneWay}"/>
                                                        <Run Text=" accuracy · "/>
                                                        <Run Text="{Binding Speed, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="10"
                                                               Margin="0,3,0,0"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               TextWrapping="Wrap"
                                                               IsHitTestVisible="False"/>
                                                </StackPanel>

                                                <!--
                                                     Checkmark — visible only when
                                                     this model is the selected one.
                                                     Collapsed by default.
                                                     Selection state driven by VM
                                                     SelectedWhisperModel in Phase 2.
                                                -->
                                                <TextBlock Grid.Column="1"
                                                           Text="✓"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0,0,0"
                                                           Visibility="Collapsed"
                                                           IsHitTestVisible="False"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- MODEL STATUS CARD -->
                            <Border CornerRadius="12" Padding="16,12"
                                    Margin="0,12,0,12"
                                    BorderThickness="1.5"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush"
                                                Value="{StaticResource PillBorderLightBrush}"/>
                                        <Setter Property="Background"
                                                Value="{DynamicResource ModuleBackgroundBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWhisperModelReady}"
                                                         Value="True">
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Background"
                                                        Value="{DynamicResource TintIndigoBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel>
                                    <DockPanel LastChildFill="True">

                                        <!-- Status badge — RIGHT docked first -->
                                        <Border DockPanel.Dock="Right"
                                                VerticalAlignment="Center"
                                                CornerRadius="10" Padding="10,4"
                                                SnapsToDevicePixels="True"
                                                UseLayoutRounding="True">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource TintRedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWhisperModelReady}"
                                                                     Value="True">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource TintIndigoBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="10" FontWeight="Bold"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text"
                                                                Value="NOT INSTALLED"/>
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource DangerBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWhisperModelReady}"
                                                                         Value="True">
                                                                <Setter Property="Text"
                                                                        Value="INSTALLED"/>
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- Icon + title — LastChildFill -->
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="🎤" FontSize="20"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"
                                                       IsHitTestVisible="False"/>
                                            <StackPanel>
                                                <TextBlock FontSize="14" FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text"
                                                                    Value="Whisper Model — Not Installed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWhisperModelReady}"
                                                                             Value="True">
                                                                    <Setter Property="Text"
                                                                            Value="Whisper Model — Ready ✓"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock FontSize="10"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                           IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text"
                                                                    Value="{Binding SelectedModelInfo.FileName,
                                                                        StringFormat='{}{0} · Download required'}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWhisperModelReady}"
                                                                             Value="True">
                                                                    <Setter Property="Text"
                                                                            Value="{Binding SelectedModelInfo.FileName,
                                                                                StringFormat='{}{0} · Installed · Offline neural STT'}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Download progress -->
                                    <StackPanel Margin="0,10,0,0"
                                                Visibility="{Binding IsDownloadingModel,
                                                    Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ProgressBar Value="{Binding DownloadProgress}"
                                                     Style="{StaticResource DownloadProgressBarStyle}"
                                                     Width="300"
                                                     HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding VoiceStatus}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Margin="0,4,0,0"
                                                   IsHitTestVisible="False"/>
                                    </StackPanel>

                                    <!-- Action buttons -->
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,10,0,0">

                                                                    <Button Style="{StaticResource PrimaryPillButton}"
                                    Tag="&#xE896;" Content="DOWNLOAD MODEL"
                            Command="{Binding DownloadWhisperModelCommand}"
                            Margin="0,0,8,0"
                            Visibility="{Binding IsWhisperModelReady,
                                                    Converter={StaticResource InverseBoolToVisibilityConverter}}"
                            MinWidth="180"
                            Height="34"
                            FontSize="11"/>

                                                                    <Button Style="{StaticResource OutlinedPillButton}"
                                    Tag="&#xE711;" Content="CANCEL"
                            Command="{Binding CancelDownloadCommand}"
                            Margin="0,0,8,0"
                            Visibility="{Binding IsDownloadingModel,
                                                    Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                                    <Button Style="{StaticResource DangerButton}"
                                    Tag="&#xE74D;" Content="DELETE MODEL"
                            Command="{Binding DeleteWhisperModelCommand}"
                            Visibility="{Binding IsWhisperModelReady,
                                                    Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <!-- Unified status text -->
                                    <TextBlock Text="{Binding VoiceStatus}"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDownloadingModel}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Model file location -->
                                    <Border Background="{DynamicResource MenuHoverBrush}"
                                            BorderBrush="{StaticResource PillBorderLightBrush}"
                                            BorderThickness="1" CornerRadius="8"
                                            Padding="10,8" Margin="0,10,0,0"
                                            SnapsToDevicePixels="True"
                                            UseLayoutRounding="True"
                                            Visibility="{Binding IsWhisperModelReady,
                                                Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="MODEL STORED AT"
                                                       Style="{StaticResource LabelStyle}"/>
                                            <TextBlock Text="{Binding ModelFilePath}"
                                                       FontSize="10"
                                                       FontFamily="Consolas, Courier New, monospace"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsHitTestVisible="False"/>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ══════════════════════════════════════════════════
                     RIGHT COLUMN — INFO CARDS
                ══════════════════════════════════════════════════════ -->
                <StackPanel Grid.Column="2">

                    <!-- About Theme System -->
                    <Border Style="{StaticResource InfoCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎨" FontSize="20"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="About the Theme System"
                                           Style="{StaticResource InfoCardTitleStyle}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource InfoCardBodyStyle}">
                                <Run Text="ProGlass Automation ships with"/>
                                <Run Text=" two hand-crafted themes" FontWeight="Bold"/>
                                <Run Text=" — Light (default) and Dark."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                                <Run Text="•" FontWeight="Bold"/>
                                <Run Text=" Light theme — optimized for daylight factory floor use."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                                <Run Text="•" FontWeight="Bold"/>
                                <Run Text=" Dark theme — easier on the eyes during late-night shifts."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                                <Run Text="•" FontWeight="Bold"/>
                                <Run Text=" Instant swap — no restart required."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- About AI Assistant -->
                    <Border Style="{StaticResource InfoCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🤖" FontSize="20"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="About the AI Assistant"
                                           Style="{StaticResource InfoCardTitleStyle}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource InfoCardBodyStyle}">
                                <Run Text="The optional AI Assistant supports"/>
                                <Run Text=" Google Gemini, Groq, and Cohere" FontWeight="Bold"/>
                                <Run Text=" — all free tiers. Tailored for UAE glass manufacturing."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                                <Run Text="•" FontWeight="Bold"/>
                                <Run Text=" 100% opt-in — uses your own API key."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                                <Run Text="•" FontWeight="Bold"/>
                                <Run Text=" Context-aware — knows glass types, VAT rules, app modules."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                                <Run Text="•" FontWeight="Bold"/>
                                <Run Text=" Voice input via Whisper — offline, 95%+ accuracy."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- About API Key & Privacy -->
                    <Border Style="{StaticResource InfoCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔐" FontSize="20"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="About Your API Key &amp; Privacy"
                                           Style="{StaticResource InfoCardTitleStyle}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource InfoCardBodyStyle}">
                                <Run Text="Your API key is stored"/>
                                <Run Text=" only on your local machine" FontWeight="Bold"/>
                                <Run Text=" in AppData. It never leaves your PC except for direct HTTPS requests to the AI provider."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                                <Run Text="•" FontWeight="Bold"/>
                                <Run Text=" Stored at %AppData%\ProGlassAutomation\config.json."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                                <Run Text="•" FontWeight="Bold"/>
                                <Run Text=" No telemetry — zero analytics sent anywhere."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- About Voice Models -->
                    <Border Style="{StaticResource InfoCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎙" FontSize="20"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="About Voice Models"
                                           Style="{StaticResource InfoCardTitleStyle}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource InfoCardBodyStyle}">
                                <Run Text="Three Whisper model sizes are available."/>
                                <Run Text=" Base is recommended" FontWeight="Bold"/>
                                <Run Text=" for most users — fast, accurate, only 142 MB."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                                <Run Text="•" FontWeight="Bold"/>
                                <Run Text=" Base (142 MB) — 95%+ accuracy. Best for daily use."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                                <Run Text="•" FontWeight="Bold"/>
                                <Run Text=" Medium (1.5 GB) — 97%+ accuracy. Noisy environments."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                                <Run Text="•" FontWeight="Bold"/>
                                <Run Text=" Large v3 (3.1 GB) — 99%+ accuracy. Maximum quality."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                                <Run Text="•" FontWeight="Bold"/>
                                <Run Text=" All models run fully OFFLINE — no internet after download."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- BACKUP & RESTORE (v2 — full dataset sets) -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="BACKUP &amp; RESTORE"
                                       Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Text="A backup set copies every database + settings into one timestamped folder. Automatic sets are created when the app closes; restore always takes a safety snapshot first."/>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                            <Button Style="{StaticResource PrimaryPillButton}"
                                    Tag="&#xE74E;" Content="CREATE BACKUP NOW"
                            Command="{Binding CreateBackupNowCommand}"
                            HorizontalAlignment="Center"/>
                                                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Tag="&#xE72C;" Content="REFRESH"
                            Command="{Binding RefreshBackupsCommand}"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Center"/>
                                                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Tag="&#xE8B7;" Content="OPEN FOLDER"
                            Command="{Binding OpenBackupsFolderCommand}"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Center"/>
                            </StackPanel>

                            <ListBox ItemsSource="{Binding BackupSets}"
                                     SelectedItem="{Binding SelectedBackup}"
                                     Margin="0,12,0,0"
                                     MaxHeight="190"
                                     BorderThickness="1"
