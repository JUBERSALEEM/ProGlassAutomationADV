<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/SettingsView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — SHELL (navigation rail + section hosts)

     v2 REDESIGN (was a single 2000-line scrolling page):
       • Left navigation rail — Appearance / AI Assistant / Voice /
         Updates / Data & Backup / About & Help.
       • Each page is an independent UserControl under Sections/.
       • Shared styles live in SettingsSectionStyles.xaml.
       • Buttons come from global Styles/ButtonStyles.xaml.
       • Page switching: SettingsViewModel.SettingsPage +
         SwitchSettingsPageCommand (same proven pattern as the
         TI/DN/JO detail tab strips).

     Sections:
       SettingsAppearanceSection — theme, wallpaper, accent, motion
       SettingsThemesSection     — visual family + Crystal Fluid tuning
       SettingsAiSection         — providers, keys, tuning, security
       SettingsVoiceSection      — Whisper speech-to-text models
       SettingsUpdatesSection    — OTA check / download / install
       SettingsDataSection       — backup & restore, sample data
       SettingsDemoSection       — live module recordings + ffmpeg
       SettingsAboutSection      — product knowledge cards
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.SettingsView"
             x:Name="SettingsRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sections="clr-namespace:ProGlassAutomation.Views.Settings.Sections"
             xmlns:local="clr-namespace:ProGlassAutomation.Views.Settings"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             RenderOptions.BitmapScalingMode="HighQuality"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The module design system: cards, tiles, chips, pills,
                     type roles, spacing scale. Declared before the section
                     styles so both are resolvable by the sections. -->
                <ResourceDictionary Source="SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="SettingsSectionStyles.xaml"/>
                <!-- v3 lazy host: one DataTemplate per page (SettingsPageTemplates.xaml) -->
                <ResourceDictionary Source="SettingsPageTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- v3 (2026-09-17): the page host builds ONE section at a time.
                 v2 stacked all twelve in the Grid below with Visibility
                 converters — opening Settings instantiated 6,000+ lines of
                 XAML and every theme switch re-measured all twelve trees. -->
            <local:SettingsPageTemplateSelector x:Key="SettingsPageTemplateSelector"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <!-- ERR-BEFC44 follow-up + 2026-09-05 drawer behaviour:
                 ERR-BEFC44: rail was a hard 232px, clipping long labels.
                 The AUTO-SIZE contract (Min 232 / Max 420) now lives on the
                 rail Border itself; the column is plain Auto so the rail can
                 shrink to 0 when the user closes it (single-click toggle +
                 auto-close on page pick — the section then gets the full
                 module width). -->
            <ColumnDefinition Width="Auto"/>
            <!-- Always-visible rail TAB (2026-09-05): 34px grab-handle that
                 NEVER disappears — single click opens/closes the rail; no
                 "open with nothing visible" dead state. -->
            <ColumnDefinition Width="34"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             LEFT — NAVIGATION RAIL (rounded floating card, clearly visible)
             Visibility = IsSettingsRailOpen (drawer: closes on page pick,
             re-opens via the floating menu button).
        ══════════════════════════════════════════════════════════════ -->
        <!-- Rail — the card grammar, and since 2026-09-17 the card MATERIAL:
             SettingsPageCardStyle now composes the crystal face, the tri-stop
             edge and the tinted shadow, so the rail picks all three up from
             the one style it shares with the page cards (Ios26RadiusCard still
             follows the Appearance card-corner slider). It used to carry its
             own drop shadow and a sheen stack, which is why the rail and the
             cards it framed did not read as the same material. -->
        <Border Grid.Column="0"
                Margin="14,14,6,14"
                MinWidth="232" MaxWidth="420"
                Visibility="{Binding IsSettingsRailOpen,
                    Converter={StaticResource BoolToVisibilityConverter}}"
                RenderOptions.EdgeMode="Aliased"
                SnapsToDevicePixels="True"
                Style="{StaticResource SettingsPageCardStyle}">
            <Border.Resources>
                <!-- The rail is a page card whose own margin lives on the
                     instance above, so it must not inherit the card margin. -->
                <Thickness x:Key="SettingsCardMargin">0</Thickness>
            </Border.Resources>
            <!-- The rail carries the liquid-glass touch — a crisp top
                 catch-light plus a soft glare band, exactly like the main
                 shell drawer, so it reads as frosted glass over the stage
                 instead of a flat card. -->
            <Grid>
                <!-- 2026-09-16: the sheen stack was removed with the rail
                     restyle. The About card material is flat frosted glass
                     with a hairline edge and one soft shadow; a top catch
                     light plus a glare band made the rail read as a different
                     material from the cards it hosts. -->
                <DockPanel Margin="10,10,10,10">

                <!-- Brand header — 2026-09-05 restyled to the REPORTS-module
                     rail design (owner directive: identical visual language):
                     accent header card with icon tile, two-line title, and
                     the collapse button INSIDE the header (single click). -->
                    <Border DockPanel.Dock="Top" Margin="4,2,4,8"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Background="{DynamicResource AccentBrush}"
                        Padding="10,10" Style="{StaticResource SurfacePrimaryStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="38" Height="38"
                                CornerRadius="{DynamicResource Radius.Medium}"
                                Background="{DynamicResource SurfaceElevatedBrush}" Style="{StaticResource SurfacePrimaryStyle}">
                                <TextBlock Text="&#xE713;"
                                       FontFamily="{DynamicResource FontFamily.Icon}"
                                       FontSize="{DynamicResource FontSize.H2}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings.Title}"
                                       FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                <TextBlock Text="{DynamicResource Settings.Subtitle}"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       Foreground="{DynamicResource OnAccentSecondaryForegroundBrush}"/>
                            </StackPanel>
                        <!-- Collapse rail button (single click — the rail
                             re-opens from the hamburger in the content
                             header, exactly like the Reports module). -->
                            <Button Grid.Column="2"
                                Width="30" Height="30"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                BorderThickness="{DynamicResource Border.NoneThickness}"
                                Cursor="Hand"
                                ToolTip="{DynamicResource ToolTip.ToggleMenu}"
                                Command="{Binding ToggleSettingsRailCommand}">
                                <TextBlock Text="&#xE76B;" FontFamily="{DynamicResource FontFamily.Icon}"
                                       FontSize="{DynamicResource FontSize.Title}"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>
                    <Border DockPanel.Dock="Top" Height="1"
                        Background="{DynamicResource BorderDefaultBrush}"
                        Margin="14,0,14,8"/>

                <!-- Nav items — scroll so every page stays reachable on
                     short windows instead of clipping License / About. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding NavRows}"
                              KeyboardNavigation.TabNavigation="Cycle">
                    <!-- v3 (2026-09-05 Phase 3): data-driven rail — the
                         row list in the VM is THE page registry; adding
                         a page = one NavRows entry + one host line below.
                         Tab cycles the rail; the keyboard cue is
                         SettingsNavFocusStyle (accent ring adorner). -->
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SwitchSettingsPageCommand, ElementName=SettingsRoot}"
                                    CommandParameter="{Binding Key}">
                                        <Button.Style>
                                            <Style TargetType="Button"
                                           BasedOn="{StaticResource SettingsNavButtonStyle}">
                                                <Setter Property="FocusVisualStyle"
                                                Value="{StaticResource SettingsNavFocusStyle}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Tag" Value="Active"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                <!-- 2026-09-14: the glyph TextBlock had no
                                     FontFamily — the MDL2 code point rendered
                                     with the app font as a broken box before
                                     the label.
                                     2026-09-16: both text runs now come from
                                     the Settings grammar (SettingsRowGlyph /
                                     SettingsRowLabel), so the 18 px icon column
                                     and the 10 px icon↔text gap are the SAME
                                     tokens every tile in the module uses, and
                                     neither run sets a Foreground — the active
                                     accent pill flips glyph and label together. -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}"
                                               Style="{StaticResource SettingsRowGlyphStyle}"/>
                                            <TextBlock Text="{Binding Label}"
                                               Style="{StaticResource SettingsRowLabelStyle}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             RIGHT — SECTION HOSTS (visibility-switched pages)
        ══════════════════════════════════════════════════════════════ -->
        <!-- ═══════════════════════════════════════════════════════════
             CRITICAL: every Visibility binding below MUST be anchored to
             this SettingsView's own DataContext via ElementName.

             A binding declared on an element resolves against THAT
             ELEMENT'S DataContext. SettingsAgentSection used to replace
             its root DataContext with an AgentSettingsViewModel, which has
             no page-flag property, so an unanchored binding here silently
             failed, Visibility fell back to its default of Visible, and
             the Agent page rendered on TOP of every other settings page.

             ElementName=SettingsRoot pins the source to this view
             (DataContext = SettingsViewModel), so a section may own its
             DataContext without breaking page switching.
             FallbackValue/TargetNullValue=Collapsed means any future
             binding failure hides the page instead of stacking it.
        ═══════════════════════════════════════════════════════════════ -->
        <!-- ══════════════════════════════════════════════════════════
             RAIL GRAB-TAB (2026-09-05): the professional open/close
             affordance — ALWAYS visible, both when the rail is open and
             after it auto-closes. Chevron flips with the state; single
             click toggles. No dead "whatever close the rail and it's
             gone" state anywhere.
        ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Column="1"
                Margin="0,14,0,14"
                Background="{DynamicResource SideMenuBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="{DynamicResource Border.BoxNoLeftThickness}"
                CornerRadius="{DynamicResource Radius.Right.Medium}"
                SnapsToDevicePixels="True" Style="{StaticResource SurfacePrimaryStyle}">
            <Button Command="{Binding ToggleSettingsRailCommand}"
                    ToolTip="{DynamicResource ToolTip.ToggleMenu}"
                    Cursor="Hand"
                    Background="Transparent"
                    BorderThickness="{DynamicResource Border.NoneThickness}" Style="{StaticResource SecondaryButtonStyle}">
                <TextBlock FontFamily="{DynamicResource FontFamily.Icon}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE76B;"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSettingsRailOpen}" Value="False">
                                    <Setter Property="Text" Value="&#xE76C;"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>
        </Border>

        <!-- ══════════ CONTENT COLUMN (header strip + stacked sections) ══════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════
                 PAGE HEADER (2026-09-16 redesign — mockup sheet 01)

                 The same card material as every page card, and the page name
                 read from the SAME registry row the rail highlights
                 (SettingsViewModel.ActivePageLabel). One source: a page cannot
                 announce itself under the wrong name, which is exactly what
                 the hand-copied top panel used to do.

                 No icon disc beside the title: the approved sheets head every
                 page with the hamburger and the name, and keep icons for the
                 rows (sheet 01/02/03/10).

                 The hamburger stays here so a collapsed rail re-opens in
                 one click from inside the content column.

                 2026-09-17: Margin was 14,10,12,0. The sections below all
                 carry Margin 18,14,18,18, so the strip sat 4 px left of every
                 card it heads and 6 px right of them — a misalignment that is
                 invisible in a screenshot of one card and obvious on the page.
                 Now 18,14,18,8: same left and right edge as the cards, same top
                 edge as the rail (14), and an 8 + 14 = 22 gap to the first card,
                 which is exactly the card-to-card rhythm.
            ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Margin="18,14,18,8" Padding="14,12"
                    Style="{StaticResource SettingsPageCardStyle}">
                <Border.Resources>
                    <!-- The strip owns its own margin above. -->
                    <Thickness x:Key="SettingsCardMargin">0</Thickness>
                </Border.Resources>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Width="38" Height="38"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="{DynamicResource Border.NoneThickness}"
                            ToolTip="{DynamicResource ToolTip.ToggleMenu}"
                            Command="{Binding ToggleSettingsRailCommand}" Style="{StaticResource SecondaryButtonStyle}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                    <Border Width="20" Height="2.5" CornerRadius="{DynamicResource Radius.XSmall}"
                                            Background="{DynamicResource TextPrimaryBrush}"
                                            Margin="0,0,0,4" Style="{StaticResource SurfacePrimaryStyle}"/>
                                    <Border Width="20" Height="2.5" CornerRadius="{DynamicResource Radius.XSmall}"
                                            Background="{DynamicResource TextPrimaryBrush}"
                                            Margin="0,0,0,4" Style="{StaticResource SurfacePrimaryStyle}"/>
                                    <Border Width="20" Height="2.5" CornerRadius="{DynamicResource Radius.XSmall}"
                                            Background="{DynamicResource TextPrimaryBrush}" Style="{StaticResource SurfacePrimaryStyle}"/>
                                </StackPanel>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="{StaticResource SettingsIconTextMargin}">
                        <TextBlock VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding ActivePageLabel}"
                                   Style="{StaticResource SettingsPageTitleStyle}"/>

                        <!-- MODE CHIP (sheet 02) — the live base colour mode beside
                             the page name, on every page. Old panel: a static
                             "LIGHT"/"DARK" label that was right only until the first
                             toggle. Now the chip reads a brush KEY from the VM and
                             resolves it through BrushKeyConverter, so the fill and
                             the text are state-driven (neutral pill in Light,
                             accent-soft in Dark) and a theme switch repaints them
                             without one colour literal in this file. Text comes
                             from the language files; visibility from IsDarkTheme. -->
                        <Border Margin="10,0,0,0"
                                Style="{StaticResource SettingsChipStyle}"
                                Background="{Binding ThemeModeChipBackgroundKey,
                                    Converter={StaticResource BrushKeyConverter}}"
                                AutomationProperties.AutomationId="Settings.ModeChip">
                            <Grid>
                                <TextBlock Text="{DynamicResource Settings.ModeBadgeLight}"
                                           Style="{StaticResource SettingsChipTextStyle}"
                                           Foreground="{Binding ThemeModeChipForegroundKey,
                                               Converter={StaticResource BrushKeyConverter}}"
                                           Visibility="{Binding IsDarkTheme,
                                               Converter={StaticResource InverseBoolToVis}}"/>
                                <TextBlock Text="{DynamicResource Settings.ModeBadgeDark}"
                                           Style="{StaticResource SettingsChipTextStyle}"
                                           Foreground="{Binding ThemeModeChipForegroundKey,
                                               Converter={StaticResource BrushKeyConverter}}"
                                           Visibility="{Binding IsDarkTheme,
                                               Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PAGE HOST — lazy: the section for SettingsPage is built on
                 first visit and released on leave (Loaded/Unloaded in each
                 section already drive the VM Initialize/Teardown hooks).
                 One scroller lives at a time (the section's own), so the
                 wheel never scrolls a hidden page behind the visible one. -->
            <ContentControl Grid.Row="1"
                            Content="{Binding}"
                            ContentTemplateSelector="{StaticResource SettingsPageTemplateSelector}"
                            Focusable="False"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
        </Grid>
    </Grid>
</UserControl>
