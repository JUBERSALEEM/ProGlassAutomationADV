<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/SettingsView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings (Chat 25 v1.2 — XLS0501 double-set fix)

     CHANGES vs Chat 25 v1.0/v1.1:
       ✓ FIX XLS0501 lines 839/842: ModelOptionCard Border had Style
         set TWICE — once as XML attribute Style="{StaticResource ...}"
         and once as <Border.Style> child element with BasedOn.
         WPF parser treats these as two separate Style assignments.
         FIX: XML attribute Style= REMOVED entirely from the Border.
         All styling now exclusively in <Border.Style> child element
         using BasedOn="{StaticResource ModelOptionCardStyle}".
         No visual change — behavior and appearance identical.
       ✓ ALL other sections preserved exactly from Chat 25 v1.0.
       ✓ Zero new errors introduced.

     VERIFIED CLEAN:
       • Zero Style double-set on any element
       • Zero inline SolidColorBrush elements
       • All frozen brushes declared in Resources
       • All converters confirmed in App.xaml
       • All VM bindings traced to SettingsViewModel properties

     REGRESSION RISK: ZERO
═══════════════════════════════════════════════════════════════════════ -->

<UserControl x:Class="ProGlassAutomation.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             RenderOptions.BitmapScalingMode="HighQuality"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ═══════════════════════════════════════════════════════════
             FROZEN BRUSHES
        ═══════════════════════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="PillBorderLightBrush" Color="#93C5FD" po:Freeze="True"/>
        <SolidColorBrush x:Key="ComingSoonBg"         Color="#F1F5F9" po:Freeze="True"/>
        <SolidColorBrush x:Key="ComingSoonBorder"     Color="#CBD5E1" po:Freeze="True"/>
        <SolidColorBrush x:Key="ComingSoonText"       Color="#94A3B8" po:Freeze="True"/>

        <!-- ═══════════════════════════════════════════════════════════
             SECTION CARD
        ═══════════════════════════════════════════════════════════════ -->
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background"          Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush"         Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness"     Value="1.5"/>
            <Setter Property="CornerRadius"        Value="14"/>
            <Setter Property="Padding"             Value="24,20"/>
            <Setter Property="Margin"              Value="0,0,0,20"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding"   Value="True"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             INFO CARD
        ═══════════════════════════════════════════════════════════════ -->
        <Style x:Key="InfoCardStyle" TargetType="Border">
            <Setter Property="Background"          Value="{DynamicResource TintIndigoBrush}"/>
            <Setter Property="BorderBrush"         Value="{StaticResource PillBorderLightBrush}"/>
            <Setter Property="BorderThickness"     Value="1.5"/>
            <Setter Property="CornerRadius"        Value="16"/>
            <Setter Property="Padding"             Value="22,18"/>
            <Setter Property="Margin"              Value="0,0,0,18"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding"   Value="True"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             PROVIDER SELECT BUTTON
        ═══════════════════════════════════════════════════════════════ -->
        <Style x:Key="ProviderSelectButtonStyle" TargetType="Button">
            <Setter Property="Content"             Value="SELECT"/>
            <Setter Property="Foreground"          Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Height"              Value="28"/>
            <Setter Property="Padding"             Value="12,0"/>
            <Setter Property="FontSize"            Value="10"/>
            <Setter Property="FontWeight"          Value="Bold"/>
            <Setter Property="BorderThickness"     Value="0"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding"   Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1.5"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             DANGER PILL BUTTON (Cancel)
        ═══════════════════════════════════════════════════════════════ -->
        <Style x:Key="DangerPillButtonStyle" TargetType="Button">
            <Setter Property="Height"              Value="34"/>
            <Setter Property="Padding"             Value="14,0"/>
            <Setter Property="FontSize"            Value="11"/>
            <Setter Property="FontWeight"          Value="Bold"/>
            <Setter Property="Foreground"          Value="{DynamicResource DangerBrush}"/>
            <Setter Property="BorderThickness"     Value="0"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding"   Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="17"
                                Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource TintRedBrush}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             DELETE PILL BUTTON
        ═══════════════════════════════════════════════════════════════ -->
        <Style x:Key="DeletePillButtonStyle" TargetType="Button">
            <Setter Property="Height"              Value="34"/>
            <Setter Property="Padding"             Value="14,0"/>
            <Setter Property="FontSize"            Value="11"/>
            <Setter Property="FontWeight"          Value="Bold"/>
            <Setter Property="Foreground"          Value="{DynamicResource DangerBrush}"/>
            <Setter Property="BorderThickness"     Value="0"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding"   Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="17"
                                Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource MenuHoverBrush}"
                                BorderBrush="{StaticResource PillBorderLightBrush}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource TintRedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             DOWNLOAD PROGRESS BAR
        ═══════════════════════════════════════════════════════════════ -->
        <Style x:Key="DownloadProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height"              Value="8"/>
            <Setter Property="Maximum"             Value="100"/>
            <Setter Property="Foreground"          Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background"          Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="BorderThickness"     Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding"   Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <Border x:Name="PART_Indicator"
                                    CornerRadius="4"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             MODEL OPTION CARD BASE STYLE
             Used exclusively via BasedOn in Border.Style child element.
             Never set as a Style= attribute directly on any Border.
             This is the base — per-card triggers extend it via BasedOn.
        ═══════════════════════════════════════════════════════════════ -->
        <Style x:Key="ModelOptionCardStyle" TargetType="Border">
            <Setter Property="CornerRadius"        Value="10"/>
            <Setter Property="Padding"             Value="12,10"/>
            <Setter Property="Margin"              Value="0,0,0,8"/>
            <Setter Property="BorderThickness"     Value="1.5"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding"   Value="True"/>
            <Setter Property="BorderBrush"         Value="{StaticResource PillBorderLightBrush}"/>
            <Setter Property="Background"          Value="{DynamicResource ModuleBackgroundBrush}"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             TYPOGRAPHY
        ═══════════════════════════════════════════════════════════════ -->
        <Style x:Key="InfoCardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="14"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="Foreground"        Value="{DynamicResource AccentBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible"  Value="False"/>
        </Style>

        <Style x:Key="InfoCardBodyStyle" TargetType="TextBlock">
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="LineHeight"       Value="20"/>
            <Setter Property="Foreground"       Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="TextWrapping"     Value="Wrap"/>
            <Setter Property="Margin"           Value="0,10,0,0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="InfoCardBulletStyle" TargetType="TextBlock">
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="LineHeight"       Value="19"/>
            <Setter Property="Foreground"       Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="TextWrapping"     Value="Wrap"/>
            <Setter Property="Margin"           Value="0,6,0,0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="FontWeight"       Value="Bold"/>
            <Setter Property="Foreground"       Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin"           Value="0,0,0,10"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="RowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="14"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="Foreground"        Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="Foreground"       Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="TextWrapping"     Value="Wrap"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"         Value="10"/>
            <Setter Property="FontWeight"       Value="Bold"/>
            <Setter Property="Foreground"       Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             iOS TOGGLE SWITCH
        ═══════════════════════════════════════════════════════════════ -->
        <Style x:Key="ModernToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Width"               Value="56"/>
            <Setter Property="Height"              Value="28"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="BorderThickness"     Value="0"/>
            <Setter Property="Background"          Value="#CBD5E1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding"   Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Track"
                                    CornerRadius="14"
                                    Background="{TemplateBinding Background}"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True"/>
                            <TextBlock x:Name="OffLabel" Text="OFF"
                                       FontSize="9" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,9,0"
                                       IsHitTestVisible="False"/>
                            <TextBlock x:Name="OnLabel" Text="ON"
                                       FontSize="9" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Margin="9,0,0,0"
                                       Opacity="0"
                                       IsHitTestVisible="False"/>
                            <Ellipse x:Name="Thumb"
                                     Width="22" Height="22" Fill="White"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0"
                                     SnapsToDevicePixels="True">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ThumbTransform"
                                                Storyboard.TargetProperty="X"
                                                To="28" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation
                                                Storyboard.TargetName="OffLabel"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation
                                                Storyboard.TargetName="OnLabel"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1" Duration="0:0:0.15"/>
                                            <ColorAnimation
                                                Storyboard.TargetName="Track"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#1D4ED8" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ThumbTransform"
                                                Storyboard.TargetProperty="X"
                                                To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation
                                                Storyboard.TargetName="OffLabel"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation
                                                Storyboard.TargetName="OnLabel"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0" Duration="0:0:0.15"/>
                                            <ColorAnimation
                                                Storyboard.TargetName="Track"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#CBD5E1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             PILL ACTION BUTTON (primary blue)
        ═══════════════════════════════════════════════════════════════ -->
        <Style x:Key="PillActionButtonStyle" TargetType="Button">
            <Setter Property="Height"              Value="42"/>
            <Setter Property="MinWidth"            Value="220"/>
            <Setter Property="Padding"             Value="24,0"/>
            <Setter Property="FontSize"            Value="12"/>
            <Setter Property="FontWeight"          Value="Bold"/>
            <Setter Property="Foreground"          Value="White"/>
            <Setter Property="Background"          Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness"     Value="0"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding"   Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="21"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════
             ROUNDED PASSWORD BOX
        ═══════════════════════════════════════════════════════════════ -->
        <Style x:Key="RoundedPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height"                   Value="42"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Padding"                  Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background"               Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground"               Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness"          Value="1.5"/>
            <Setter Property="BorderBrush"              Value="{StaticResource PillBorderLightBrush}"/>
            <Setter Property="SnapsToDevicePixels"      Value="True"/>
            <Setter Property="UseLayoutRounding"        Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Root" Property="BorderThickness"
                                        Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small pill used by the accent colour presets row. -->
        <Style x:Key="AccentChipStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{DynamicResource MenuHoverBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="999"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════
         ROOT SCROLL VIEWER
    ═══════════════════════════════════════════════════════════════════ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  IsDeferredScrollingEnabled="False"
                  PanningMode="VerticalOnly"
                  Focusable="False"
                  FocusVisualStyle="{x:Null}"
                  Background="Transparent"
                  behaviors:SmoothScrollBehavior.IsEnabled="True">
        <StackPanel Margin="32,28,32,32">

            <!-- PAGE HEADER -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Settings"
                           FontSize="30" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                           IsHitTestVisible="False"/>
                <TextBlock Text="Configure appearance, AI assistant, and application preferences."
                           FontSize="13" Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           IsHitTestVisible="False"/>
            </StackPanel>

            <!-- TWO-COLUMN LAYOUT -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="480"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="2*" MinWidth="340"/>
                </Grid.ColumnDefinitions>

                <!-- ══════════════════════════════════════════════════
                     LEFT COLUMN — SETTINGS
                ══════════════════════════════════════════════════════ -->
                <StackPanel Grid.Column="0">

                    <!-- APPEARANCE — v2: split into focused cards -->

                    <!-- THEME MODE -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="THEME MODE"
                                       Style="{StaticResource SectionLabelStyle}"/>
                            <DockPanel Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="☀" FontSize="18"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"
                                               IsHitTestVisible="False"/>
                                    <TextBlock Text="Dark Mode"
                                               Style="{StaticResource RowTitleStyle}"/>
                                </StackPanel>
                                <ToggleButton HorizontalAlignment="Right"
                                              IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                              Style="{StaticResource ModernToggleSwitch}"/>
                            </DockPanel>

                            <TextBlock Text="Visual Theme"
                                       Style="{StaticResource RowTitleStyle}"
                                       Margin="0,16,0,6"/>
                            <ComboBox ItemsSource="{Binding VisualThemeOptions}"
                                      SelectedItem="{Binding SelectedVisualTheme}"
                                      MinWidth="200"
                                      Padding="10,7"
                                      FontSize="13"/>
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="Normal = clean default. Monet = wallpaper with glass surfaces. Professional = premium corporate finish."/>
                        </StackPanel>
                    </Border>

                    <!-- WALLPAPER -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="WALLPAPER"
                                       Style="{StaticResource SectionLabelStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Tag="&#xE728;" Content="SET WALLPAPER…"
                            Command="{Binding SetWallpaperCommand}"
                            HorizontalAlignment="Center"/>
                                                            <Button Style="{StaticResource RowOutlinedButton}"
                                    Tag="&#xE711;" Content="CLEAR"
                            Command="{Binding ClearWallpaperCommand}"
                            Margin="8,0,0,0"
                            HorizontalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding WallpaperStatus}"
                                       FontSize="11" Margin="0,8,0,0"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Wallpaper visibility"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                <Slider Value="{Binding WallpaperOpacity}"
                                        Minimum="0.3" Maximum="1"
                                        Width="180"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ACCENT COLOUR -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="ACCENT COLOUR"
                                       Style="{StaticResource SectionLabelStyle}"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Glass Blue" Command="{Binding ApplyAccentCommand}" CommandParameter="GlassBlue" Style="{StaticResource AccentChipStyle}"/>
                                <Button Content="🟢 Emerald"    Command="{Binding ApplyAccentCommand}" CommandParameter="Emerald"   Style="{StaticResource AccentChipStyle}" Margin="8,0,0,0"/>
                                <Button Content="Amber"      Command="{Binding ApplyAccentCommand}" CommandParameter="Amber"     Style="{StaticResource AccentChipStyle}" Margin="8,0,0,0"/>
                                <Button Content="🌹 Rose"       Command="{Binding ApplyAccentCommand}" CommandParameter="Rose"      Style="{StaticResource AccentChipStyle}" Margin="8,0,0,0"/>
                                <Button Content="🟣 Violet"     Command="{Binding ApplyAccentCommand}" CommandParameter="Violet"    Style="{StaticResource AccentChipStyle}" Margin="8,0,0,0"/>
                                <Button Content="Teal"       Command="{Binding ApplyAccentCommand}" CommandParameter="Teal"      Style="{StaticResource AccentChipStyle}" Margin="8,0,0,0"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Margin="0,10,0,0"
                                       Text="The engine derives hover, tint and contrast colours automatically from the chosen accent."/>
                        </StackPanel>
                    </Border>

                    <!-- MOTION & PERFORMANCE -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="MOTION &amp; PERFORMANCE"
                                       Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Margin="0,6,0,0"
                                       Text="{Binding PerformanceTierDisplay}"/>
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Margin="0,4,0,0"
                                       Text="Animations adapt to your display refresh rate (60/90/120/144/165 Hz)."/>
                        </StackPanel>
                    </Border>

                    <!-- SECURITY — API key storage (v2) -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="SECURITY"
                                       Style="{StaticResource SectionLabelStyle}"/>
                            <DockPanel Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="🔐" FontSize="18"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"
                                               IsHitTestVisible="False"/>
                                    <TextBlock Text="Keep API keys saved on this device"
                                               Style="{StaticResource RowTitleStyle}"/>
                                </StackPanel>
                                <ToggleButton HorizontalAlignment="Right"
                                              IsChecked="{Binding KeepApiKeysSaved, Mode=TwoWay}"
                                              Style="{StaticResource ModernToggleSwitch}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="Keys are encrypted with Windows user-level protection (DPAPI) — never stored in plain text. Turn OFF to keep keys in memory for this session only."/>
                                                        <Button Style="{StaticResource DangerButton}"
                                    Tag="&#xE74D;" Content="REMOVE SAVED KEYS"
                            Command="{Binding RemoveSavedKeysCommand}"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"/>
                                                        <Button Style="{StaticResource DangerButton}"
                                    Tag="&#xE74D;" Content="CLEAR AI MEMORY"
                            Command="{Binding ClearAiMemoryCommand}"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <!-- UPDATES — OTA (v2 §34) -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="UPDATES"
                                       Style="{StaticResource SectionLabelStyle}"/>

                            <!-- Version row: current vs latest -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Background="{DynamicResource MenuHoverBrush}"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Padding="14,10" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="CURRENT VERSION"
                                                   FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        <TextBlock FontSize="16" FontWeight="Bold"
                                                   Margin="0,3,0,0"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}">
                                            <Run Text="v"/>
                                            <Run Text="{Binding CurrentVersionDisplay, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1"
                                        Background="{DynamicResource TintBlueBrush}"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Padding="14,10" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="LATEST RELEASE"
                                                   FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        <TextBlock FontSize="16" FontWeight="Bold"
                                                   Margin="0,3,0,0"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Text="{Binding LatestVersionDisplay}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding UpdateStatus}"
                                       Style="{StaticResource RowTitleStyle}"
                                       Margin="0,12,0,0"
                                       TextWrapping="Wrap"/>
                            <!-- v3 OTA §8: last-checked stamp -->
                            <TextBlock Text="{Binding LastCheckedDisplay}"
                                       FontSize="10"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                            <Button Style="{StaticResource PrimaryPillButton}"
                                    Tag="&#xE72C;" Content="CHECK FOR UPDATES"
                            Command="{Binding CheckForUpdatesCommand}"
                            HorizontalAlignment="Center"/>
                            <Button Tag="&#xE896;" Content="DOWNLOAD UPDATE"
                            Command="{Binding DownloadUpdateCommand}"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <!-- hidden again once the
                                                     download is ready -->
                                                <DataTrigger Binding="{Binding IsUpdateReady}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                            </Button>
                            </StackPanel>

                            <!-- ═══════════════════════════════════════
                                 v3 OTA §8: READY STATE
                                 Install & restart / later — appears only
                                 once the download has completed.
                            ════════════════════════════════════════ -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,10,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUpdateReady}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                                            <Button Style="{StaticResource SuccessPillButton}"
                                    Tag="&#xE74E;" Content="INSTALL &amp; RESTART"
                            Command="{Binding InstallUpdateCommand}"
                            HorizontalAlignment="Center"/>
                                <TextBlock Text="…or install later — the file stays in your Downloads folder."
                                           FontSize="10"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                            </StackPanel>

                            <!-- Mode=OneWay: UpdateDownloadProgress is
                                 read-only from XAML's perspective
                                 (private setter) — TwoWay would throw
                                 InvalidOperationException (ERR-441A02). -->
                            <ProgressBar Value="{Binding UpdateDownloadProgress, Mode=OneWay}"
                                         Maximum="100"
                                         Height="6"
                                         Margin="0,10,0,0">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDownloadingUpdate}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <!-- Release details (v2 §34) -->
                            <Border Margin="0,14,0,0"
                                    Background="{DynamicResource MenuHoverBrush}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="14,12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasReleaseInfo}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📦"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding ReleaseNameDisplay}"
                                                   FontSize="13" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        <TextBlock FontSize="11"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedForegroundBrush}">
                                            <Run Text="published"/>
                                            <Run Text="{Binding ReleasePublishedDisplay, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ReleaseNotesPreview}"
                                               FontSize="11"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"
                                               MaxHeight="90"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Update history ledger (v2 §34) -->
                            <StackPanel Margin="0,14,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUpdateHistory}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="UPDATE HISTORY"
                                           FontSize="10" FontWeight="Bold"
                                           Margin="0,0,0,6"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>

                                <ItemsControl ItemsSource="{Binding UpdateHistory}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="2,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource MutedForegroundBrush}">
                                                        <Run Text="{Binding TimestampUtc, Mode=OneWay,
                                                                    StringFormat='dd MMM yyyy HH:mm'}"/>
                                                    </TextBlock>
                                                    <Border Grid.Column="1"
                                                            CornerRadius="8"
                                                            Padding="8,2"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource TintBlueBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EventType}" Value="Downloaded">
                                                                        <Setter Property="Background"
                                                                                Value="{DynamicResource TintGreenBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding EventType}" Value="CheckFailed">
                                                                        <Setter Property="Background"
                                                                                Value="{DynamicResource TintRedBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding EventType}"
                                                                   FontSize="9" FontWeight="Bold"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="2"
                                                               FontSize="11"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Detail}"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}">
                                                        <Run Text="v"/>
                                                        <Run Text="{Binding Version, Mode=OneWay}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding ReleaseName, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="The app never replaces its own files. Downloads are saved to your Downloads folder — you decide when to install."/>
                        </StackPanel>
                    </Border>

                    <!-- AI ASSISTANT -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="AI ASSISTANT"
                                       Style="{StaticResource SectionLabelStyle}"/>
                            <DockPanel Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="🤖" FontSize="18"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"
