<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/SettingsView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — SHELL (navigation rail + section hosts)

     v2 REDESIGN (was a single 2000-line scrolling page):
       • Left navigation rail — Appearance / AI Assistant / Voice /
         Updates / Data & Backup / About & Help.
       • Each page is an independent UserControl under Sections/.
       • Shared styles live in SettingsSectionStyles.xaml.
       • Buttons come from global Styles/ButtonStyles.xaml.
       • Page switching: SettingsViewModel.SettingsPage +
         SwitchSettingsPageCommand (same proven pattern as the
         TI/DN/JO detail tab strips).

     Sections:
       SettingsAppearanceSection — theme, wallpaper, accent, motion
       SettingsAiSection         — providers, keys, tuning, security
       SettingsVoiceSection      — Whisper speech-to-text models
       SettingsUpdatesSection    — OTA check / download / install
       SettingsDataSection       — backup & restore, sample data
       SettingsDemoSection       — live module recordings + ffmpeg
       SettingsAboutSection      — product knowledge cards
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.SettingsView"
             x:Name="SettingsRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sections="clr-namespace:ProGlassAutomation.Views.Settings.Sections"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             RenderOptions.BitmapScalingMode="HighQuality"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <!-- ERR-BEFC44 follow-up + 2026-09-05 drawer behaviour:
                 ERR-BEFC44: rail was a hard 232px, clipping long labels.
                 The AUTO-SIZE contract (Min 232 / Max 420) now lives on the
                 rail Border itself; the column is plain Auto so the rail can
                 shrink to 0 when the user closes it (single-click toggle +
                 auto-close on page pick — the section then gets the full
                 module width). -->
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             LEFT — NAVIGATION RAIL (rounded floating card, clearly visible)
             Visibility = IsSettingsRailOpen (drawer: closes on page pick,
             re-opens via the floating menu button).
        ══════════════════════════════════════════════════════════════ -->
        <Border CornerRadius="{DynamicResource CardCornerRadius}" Grid.Column="0"
                Margin="14,14,6,14"
                MinWidth="232" MaxWidth="420"
                Visibility="{Binding IsSettingsRailOpen,
                    Converter={StaticResource BoolToVisibilityConverter}}"
                Background="{DynamicResource SideMenuBackgroundBrush}"
                BorderBrush="{DynamicResource GlassBorderGradientCrystal}"
                BorderThickness="1.5"
                RenderOptions.EdgeMode="Aliased"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3"
                                  Direction="270" Opacity="0.20"
                                  Color="#000000"/>
            </Border.Effect>
            <!-- 2026-09-01: the rail now carries the liquid-glass touch —
                 a crisp top catch-light plus a soft glare band, exactly
                 like the main shell drawer, so it reads as frosted glass
                 over the stage instead of a flat card. -->
            <Grid>
                <Border Height="1" VerticalAlignment="Top"
                        Background="{DynamicResource ShellSheenBrush}"
                        IsHitTestVisible="False"/>
                <Border Height="14" VerticalAlignment="Top"
                        CornerRadius="14,14,5,5"
                        Background="{DynamicResource GlassTopReflection}"
                        Opacity="0.55"
                        IsHitTestVisible="False"/>
            <DockPanel Margin="10,20,10,16">

                <!-- Brand header — 2026-09-05 restyled to the REPORTS-module
                     rail design (owner directive: identical visual language):
                     accent header card with icon tile, two-line title, and
                     the collapse button INSIDE the header (single click). -->
                <Border DockPanel.Dock="Top" Margin="4,2,4,10"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Background="{DynamicResource AccentBrush}"
                        Padding="12,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="38" Height="38"
                                CornerRadius="10"
                                Background="{DynamicResource GlassSurfaceElevated}">
                            <TextBlock Text="&#xE713;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource TextTitle}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Settings.Title}"
                                       FontSize="{StaticResource TextSection}" FontWeight="Bold"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Text="{DynamicResource Settings.Subtitle}"
                                       FontSize="{StaticResource TextBody}"
                                       Foreground="{DynamicResource OnAccentSecondaryForegroundBrush}"/>
                        </StackPanel>
                        <!-- Collapse rail button (single click — the rail
                             re-opens from the hamburger in the content
                             header, exactly like the Reports module). -->
                        <Button Grid.Column="2"
                                Width="30" Height="30"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="{DynamicResource ToolTip.ToggleMenu}"
                                Command="{Binding ToggleSettingsRailCommand}">
                            <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource TextBodyLarge}"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>
                <Border DockPanel.Dock="Top" Height="1"
                        Background="{DynamicResource OutlineBrush}"
                        Margin="14,0,14,8"/>

                <!-- Nav items — scroll so every page stays reachable on
                     short windows instead of clipping License / About. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              PanningMode="VerticalOnly">
                <StackPanel>

                    <!-- APPEARANCE -->
                    <Button Command="{Binding SwitchSettingsPageCommand}"
                            CommandParameter="Appearance">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource SettingsNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAppearancePage}" Value="True">
                                        <Setter Property="Tag" Value="Active"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyphStyle}" Text="&#xE790;"/>
                            <TextBlock Style="{StaticResource NavLabelStyle}" Text="{DynamicResource Settings.SecAppearance}"/>
                        </StackPanel>
                    </Button>

                    <!-- AI ASSISTANT -->
                    <Button Command="{Binding SwitchSettingsPageCommand}"
                            CommandParameter="AI">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource SettingsNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAiPage}" Value="True">
                                        <Setter Property="Tag" Value="Active"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyphStyle}" Text="&#xE8F2;"/>
                            <TextBlock Style="{StaticResource NavLabelStyle}" Text="{DynamicResource Settings.SecAi}"/>
                        </StackPanel>
                    </Button>

                    <!-- AI & AGENT (PHASE F) -->
                    <Button Command="{Binding SwitchSettingsPageCommand}"
                            CommandParameter="Agent">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource SettingsNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAgentPage}" Value="True">
                                        <Setter Property="Tag" Value="Active"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyphStyle}" Text="&#xE8F2;"/>
                            <TextBlock Style="{StaticResource NavLabelStyle}" Text="{DynamicResource Settings.SecAgent}"/>
                        </StackPanel>
                    </Button>

                    <!-- VOICE -->
                    <Button Command="{Binding SwitchSettingsPageCommand}"
                            CommandParameter="Voice">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource SettingsNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVoicePage}" Value="True">
                                        <Setter Property="Tag" Value="Active"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyphStyle}" Text="&#xE720;"/>
                            <TextBlock Style="{StaticResource NavLabelStyle}" Text="{DynamicResource Settings.SecVoice}"/>
                        </StackPanel>
                    </Button>

                    <!-- UPDATES -->
                    <Button Command="{Binding SwitchSettingsPageCommand}"
                            CommandParameter="Updates">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource SettingsNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUpdatesPage}" Value="True">
                                        <Setter Property="Tag" Value="Active"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyphStyle}" Text="&#xE72C;"/>
                            <TextBlock Style="{StaticResource NavLabelStyle}" Text="{DynamicResource Settings.SecUpdates}"/>
                        </StackPanel>
                    </Button>

                    <!-- DATA & BACKUP -->
                    <Button Command="{Binding SwitchSettingsPageCommand}"
                            CommandParameter="Data">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource SettingsNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDataPage}" Value="True">
                                        <Setter Property="Tag" Value="Active"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyphStyle}" Text="&#xE74E;"/>
                            <TextBlock Style="{StaticResource NavLabelStyle}" Text="{DynamicResource Settings.SecData}"/>
                        </StackPanel>
                    </Button>

                    <!-- DEMO CENTER -->
                    <Button Command="{Binding SwitchSettingsPageCommand}"
                            CommandParameter="Demo">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource SettingsNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDemoPage}" Value="True">
                                        <Setter Property="Tag" Value="Active"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyphStyle}" Text="&#xE714;"/>
                            <TextBlock Style="{StaticResource NavLabelStyle}" Text="{DynamicResource Settings.SecDemo}"/>
                        </StackPanel>
                    </Button>

                    <!-- FEATURES — per-module UI toggles. Right now it
                         hosts the Proforma Invoice field-visibility pills
                         so a non-coder operator can hide fields they
                         never fill in. -->
                    <Button Command="{Binding SwitchSettingsPageCommand}"
                            CommandParameter="Features">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource SettingsNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFeaturesPage}" Value="True">
                                        <Setter Property="Tag" Value="Active"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyphStyle}" Text="&#xE762;"/>
                            <TextBlock Style="{StaticResource NavLabelStyle}" Text="{DynamicResource Settings.SecFeatures}"/>
                        </StackPanel>
                    </Button>

                    <!-- LICENSE — Settings-level licensing surface
                         (the old startup License overlay was removed;
                          this is the ONLY place users see licensing). -->
                    <Button Command="{Binding SwitchSettingsPageCommand}"
                            CommandParameter="License">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource SettingsNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLicensePage}" Value="True">
                                        <Setter Property="Tag" Value="Active"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyphStyle}" Text="&#xE192;"/>
                            <TextBlock Style="{StaticResource NavLabelStyle}" Text="{DynamicResource Settings.SecLicense}"/>
                        </StackPanel>
                    </Button>

                    <!-- ABOUT & HELP -->
                    <Button Command="{Binding SwitchSettingsPageCommand}"
                            CommandParameter="About">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource SettingsNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAboutPage}" Value="True">
                                        <Setter Property="Tag" Value="Active"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyphStyle}" Text="&#xE946;"/>
                            <TextBlock Style="{StaticResource NavLabelStyle}" Text="{DynamicResource Settings.SecAbout}"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
                </ScrollViewer>
            </DockPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             RIGHT — SECTION HOSTS (visibility-switched pages)
        ══════════════════════════════════════════════════════════════ -->
        <!-- ═══════════════════════════════════════════════════════════
             CRITICAL: every Visibility binding below MUST be anchored to
             this SettingsView's own DataContext via ElementName.

             A binding declared on an element resolves against THAT
             ELEMENT'S DataContext. SettingsAgentSection used to replace
             its root DataContext with an AgentSettingsViewModel, which has
             no page-flag property, so an unanchored binding here silently
             failed, Visibility fell back to its default of Visible, and
             the Agent page rendered on TOP of every other settings page.

             ElementName=SettingsRoot pins the source to this view
             (DataContext = SettingsViewModel), so a section may own its
             DataContext without breaking page switching.
             FallbackValue/TargetNullValue=Collapsed means any future
             binding failure hides the page instead of stacking it.
        ═══════════════════════════════════════════════════════════════ -->
        <!-- ══════════ CONTENT COLUMN (header strip + stacked sections) ══════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Content header strip (2026-09-05 — Reports-module parity):
                 hamburger re-opens the auto-closed rail in ONE click; the
                 current section name sits next to it so the workspace
                 always announces where you are. -->
            <Border Grid.Row="0" Margin="14,10,12,0" Padding="14,10"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Background="{DynamicResource ElevatedSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Width="38" Height="38"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="{DynamicResource ToolTip.ToggleMenu}"
                            Command="{Binding ToggleSettingsRailCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                    <Border Width="20" Height="2.5" CornerRadius="2"
                                            Background="{DynamicResource PrimaryForegroundBrush}"
                                            Margin="0,0,0,4"/>
                                    <Border Width="20" Height="2.5" CornerRadius="2"
                                            Background="{DynamicResource PrimaryForegroundBrush}"
                                            Margin="0,0,0,4"/>
                                    <Border Width="20" Height="2.5" CornerRadius="2"
                                            Background="{DynamicResource PrimaryForegroundBrush}"/>
                                </StackPanel>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               FontSize="{StaticResource TextSection}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               Text="{Binding SettingsPage}"/>
                </Grid>
            </Border>

        <Grid Grid.Row="1">
            <sections:SettingsAppearanceSection
                Visibility="{Binding DataContext.IsAppearancePage,
                    ElementName=SettingsRoot,
                    Converter={StaticResource BoolToVisibilityConverter},
                    FallbackValue=Collapsed, TargetNullValue=Collapsed}"/>
            <sections:SettingsAiSection
                Visibility="{Binding DataContext.IsAiPage,
                    ElementName=SettingsRoot,
                    Converter={StaticResource BoolToVisibilityConverter},
                    FallbackValue=Collapsed, TargetNullValue=Collapsed}"/>
            <sections:SettingsAgentSection
                Visibility="{Binding DataContext.IsAgentPage,
                    ElementName=SettingsRoot,
                    Converter={StaticResource BoolToVisibilityConverter},
                    FallbackValue=Collapsed, TargetNullValue=Collapsed}"/>
            <sections:SettingsVoiceSection
                Visibility="{Binding DataContext.IsVoicePage,
                    ElementName=SettingsRoot,
                    Converter={StaticResource BoolToVisibilityConverter},
                    FallbackValue=Collapsed, TargetNullValue=Collapsed}"/>
            <sections:SettingsUpdatesSection
                Visibility="{Binding DataContext.IsUpdatesPage,
                    ElementName=SettingsRoot,
                    Converter={StaticResource BoolToVisibilityConverter},
                    FallbackValue=Collapsed, TargetNullValue=Collapsed}"/>
            <sections:SettingsDataSection
                Visibility="{Binding DataContext.IsDataPage,
                    ElementName=SettingsRoot,
                    Converter={StaticResource BoolToVisibilityConverter},
                    FallbackValue=Collapsed, TargetNullValue=Collapsed}"/>
            <sections:SettingsDemoSection
                Panel.ZIndex="2"
                Visibility="{Binding DataContext.IsDemoPage,
                    ElementName=SettingsRoot,
                    Converter={StaticResource BoolToVisibilityConverter},
                    FallbackValue=Collapsed, TargetNullValue=Collapsed}"/>
            <sections:SettingsFeaturesSection
                Visibility="{Binding DataContext.IsFeaturesPage,
                    ElementName=SettingsRoot,
                    Converter={StaticResource BoolToVisibilityConverter},
                    FallbackValue=Collapsed, TargetNullValue=Collapsed}"/>
            <sections:SettingsLicenseSection
                Visibility="{Binding DataContext.IsLicensePage,
                    ElementName=SettingsRoot,
                    Converter={StaticResource BoolToVisibilityConverter},
                    FallbackValue=Collapsed, TargetNullValue=Collapsed}"/>
            <sections:SettingsAboutSection
                Visibility="{Binding DataContext.IsAboutPage,
                    ElementName=SettingsRoot,
                    Converter={StaticResource BoolToVisibilityConverter},
                    FallbackValue=Collapsed, TargetNullValue=Collapsed}"/>

        </Grid>
        </Grid>
    </Grid>
</UserControl>
