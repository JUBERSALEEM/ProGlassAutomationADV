                                <Run Text="Select your preferred AI provider. Only the"/>
                                <Run Text=" active" FontWeight="Bold"/>
                                <Run Text=" provider processes your requests."/>
                            </TextBlock>

                            <!-- ── GEMINI ──────────────────────────── -->
                            <Border CornerRadius="14" Padding="16,14"
                                    Margin="0,0,0,12" BorderThickness="1.5"
