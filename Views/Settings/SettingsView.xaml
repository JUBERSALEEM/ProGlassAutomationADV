                            Height="34"
                            FontSize="11"/>
                                        <TextBlock Text="{Binding GeminiTestStatus}"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Margin="0,6,0,0"
                                                   IsHitTestVisible="False"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ── GROQ ──────────────────────────────── -->
                            <Border CornerRadius="14" Padding="16,14"
                                    Margin="0,0,0,12" BorderThickness="1.5"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush"
                                                Value="{StaticResource PillBorderLightBrush}"/>
                                        <Setter Property="Background"
                                                Value="{DynamicResource ModuleBackgroundBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGroqActive}"
                                                         Value="True">
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Background"
                                                        Value="{DynamicResource TintIndigoBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="⚡" FontSize="18"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       IsHitTestVisible="False"/>
                                            <StackPanel>
                                                <TextBlock Text="Groq"
                                                           FontSize="14" FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                <TextBlock Text="30 req/min · 14,400/day · Fastest speed"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                           IsHitTestVisible="False"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button DockPanel.Dock="Right"
                                                HorizontalAlignment="Right"
                                                Command="{Binding SelectGroqCommand}">
