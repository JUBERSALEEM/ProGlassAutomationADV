                            MinWidth="160"
                            Height="34"
                            FontSize="11"/>
                                        <TextBlock Text="{Binding GroqTestStatus}"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Margin="0,6,0,0"
                                                   IsHitTestVisible="False"/>
