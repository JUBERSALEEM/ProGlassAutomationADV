                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Margin="0,6,0,10"
                                       TextWrapping="Wrap"
                                       Text="Give any module its own background image. The image stays behind readable UI — surfaces become slightly transparent where the active theme supports it."/>

                            <ItemsControl ItemsSource="{Binding ModuleWallpaperRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource DividerBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="2,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,10,0"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Label}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding FileName}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="8,0"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                                                <StackPanel Grid.Column="3"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Slider Value="{Binding OpacityValue}"
                                                            Minimum="0.3" Maximum="1"
                                                            Width="110"
                                                            ToolTip="Visibility"
                                                            VerticalAlignment="Center"/>
                                                                                <Button Style="{StaticResource RowOutlinedButton}"
                                    Tag="&#xE728;" Content="SET"
                            Command="{Binding DataContext.SetModuleWallpaperCommand,
                                                                        RelativeSource={RelativeSource
                                                                            AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Center"
                            FontSize="11"/>
                                                </StackPanel>

                                                <Button Grid.Column="4"
                                                        Content="✕"
                                                        Command="{Binding DataContext.ClearModuleWallpaperCommand,
                                                                    RelativeSource={RelativeSource
                                                                        AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Cursor="Hand"
                                                        FontSize="11"
                                                        Padding="9,5"
                                                        Margin="8,0,0,0"
                                                        BorderThickness="0"
                                                        ToolTip="Remove this module's wallpaper">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{DynamicResource MenuHoverBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="999"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>