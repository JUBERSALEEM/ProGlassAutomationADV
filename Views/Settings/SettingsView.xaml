<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/SettingsView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — SHELL (navigation rail + section hosts)

     v2 REDESIGN (was a single 2000-line scrolling page):
       • Left navigation rail — Appearance / AI Assistant / Voice /
         Updates / Data & Backup / About & Help.
       • Each page is an independent UserControl under Sections/.
       • Shared styles live in SettingsSectionStyles.xaml.
       • Buttons come from global Styles/ButtonStyles.xaml.
       • Page switching: SettingsViewModel.SettingsPage +
         SwitchSettingsPageCommand (same proven pattern as the
         TI/DN/JO detail tab strips).

     Sections:
       SettingsAppearanceSection — theme, wallpaper, accent, motion
       SettingsAiSection         — providers, keys, tuning, security
       SettingsVoiceSection      — Whisper speech-to-text models
       SettingsUpdatesSection    — OTA check / download / install
       SettingsDataSection       — backup & restore, sample data
       SettingsAboutSection      — product knowledge cards
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sections="clr-namespace:ProGlassAutomation.Views.Settings.Sections"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             RenderOptions.BitmapScalingMode="HighQuality"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             LEFT — NAVIGATION RAIL
        ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="0,26,0,20">

                <!-- Brand header -->
                <StackPanel DockPanel.Dock="Top" Margin="22,0,22,20">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="10"
                                Background="{DynamicResource AccentBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE713;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Settings"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="ProGlass Automation"
                                       FontSize="10"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Nav items -->
                <StackPanel>

                    <!-- APPEARANCE -->
                    <Button Command="{Binding SwitchSettingsPageCommand}"
                            CommandParameter="Appearance">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource SettingsNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAppearancePage}" Value="True">
                                        <Setter Property="Tag" Value="Active"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyphStyle}" Text="&#xE790;"/>
                            <TextBlock Style="{StaticResource NavLabelStyle}" Text="Appearance"/>
                        </StackPanel>
                    </Button>

                    <!-- AI ASSISTANT -->
                    <Button Command="{Binding SwitchSettingsPageCommand}"
                            CommandParameter="AI">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource SettingsNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAiPage}" Value="True">
                                        <Setter Property="Tag" Value="Active"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyphStyle}" Text="&#xE8F2;"/>
                            <TextBlock Style="{StaticResource NavLabelStyle}" Text="AI Assistant"/>
                        </StackPanel>
                    </Button>

                    <!-- VOICE -->
                    <Button Command="{Binding SwitchSettingsPageCommand}"
                            CommandParameter="Voice">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource SettingsNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVoicePage}" Value="True">
                                        <Setter Property="Tag" Value="Active"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyphStyle}" Text="&#xE720;"/>
                            <TextBlock Style="{StaticResource NavLabelStyle}" Text="Voice"/>
                        </StackPanel>
                    </Button>

                    <!-- UPDATES -->
                    <Button Command="{Binding SwitchSettingsPageCommand}"
                            CommandParameter="Updates">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource SettingsNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUpdatesPage}" Value="True">
                                        <Setter Property="Tag" Value="Active"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyphStyle}" Text="&#xE72C;"/>
                            <TextBlock Style="{StaticResource NavLabelStyle}" Text="Updates"/>
                        </StackPanel>
                    </Button>

                    <!-- DATA & BACKUP -->
                    <Button Command="{Binding SwitchSettingsPageCommand}"
                            CommandParameter="Data">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource SettingsNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDataPage}" Value="True">
                                        <Setter Property="Tag" Value="Active"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyphStyle}" Text="&#xE74E;"/>
                            <TextBlock Style="{StaticResource NavLabelStyle}" Text="Data &amp; Backup"/>
                        </StackPanel>
                    </Button>

                    <!-- ABOUT & HELP -->
                    <Button Command="{Binding SwitchSettingsPageCommand}"
                            CommandParameter="About">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource SettingsNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAboutPage}" Value="True">
                                        <Setter Property="Tag" Value="Active"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyphStyle}" Text="&#xE946;"/>
                            <TextBlock Style="{StaticResource NavLabelStyle}" Text="About &amp; Help"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             RIGHT — SECTION HOSTS (visibility-switched pages)
        ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <sections:SettingsAppearanceSection
                Visibility="{Binding IsAppearancePage,
                    Converter={StaticResource BoolToVisibilityConverter}}"/>
            <sections:SettingsAiSection
                Visibility="{Binding IsAiPage,
                    Converter={StaticResource BoolToVisibilityConverter}}"/>
            <sections:SettingsVoiceSection
                Visibility="{Binding IsVoicePage,
                    Converter={StaticResource BoolToVisibilityConverter}}"/>
            <sections:SettingsUpdatesSection
                Visibility="{Binding IsUpdatesPage,
                    Converter={StaticResource BoolToVisibilityConverter}}"/>
            <sections:SettingsDataSection
                Visibility="{Binding IsDataPage,
                    Converter={StaticResource BoolToVisibilityConverter}}"/>
            <sections:SettingsAboutSection
                Visibility="{Binding IsAboutPage,
                    Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</UserControl>
