<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/SettingsCardStyles.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings — the approved page grammar (2026-09-16 rewrite)

     ───────────────────────────────────────────────────────────────────
     THIS FILE IS THE SETTINGS DESIGN SYSTEM. Nothing else in the module
     declares a card, a tile, a chip, a pill, a caption or a spacing
     value. Every section merges it and composes from these keys.
     ───────────────────────────────────────────────────────────────────

     WHY IT LOOKS LIKE ABOUT
     ───────────────────────
     Owner directive: "apply exact cards style of about module in complete
     setting module … i want full redesign". So the grammar is the About
     card language, and it is built on the SAME geometry and type tokens
     About uses — which are application-level and live:

       Ios26Radius{Card,Inner,Tile,Chip,Small} (AboutSurface.xaml, then
                                                republished from the live
                                                card-radius setting)
       Ios26FontSize*                          (AboutTypeScale.xaml, then
                                                republished per density)
       Ios26Text{Title,Body,Secondary,Muted,Faint}Brush, accent family
       Ios26HairlineBrush, Ios26HoverBrush      (theme dictionaries)
       Ios26TileBrush / Ios26TileBorderBrush    (theme dictionaries — the
                                                action bar and the danger wash)

     THE MATERIAL IS SETTINGS' OWN (2026-09-17)
     ─────────────────────────────────────────
     Owner directive: "Generate the new mockup with crystal liquid ios 26
     theme type", after "design is still same / cards are too close".

     That complaint was correct and its cause was the SPEC, not the code: the
     first approved sheet set specified a flat card (#CCFFFFFF + a 1 px
     #E2E8F0 hairline + a 10 % shadow), and the module implemented it
     faithfully. Settings therefore carries its own crystal material, declared
     in the same theme dictionaries so Light/Dark still repaints it:

       SettingsCardFaceBrush   L2 tint + L3 specular rim + L4 sheen +
                               L5 refraction lip, one stretchable DrawingBrush
       SettingsCardEdgeBrush   L1 tri-stop crystal edge
       SettingsInnerFaceBrush  the translucent panel inside a card
       SettingsInnerEdgeBrush  its edge
       SettingsCardShadow      L0, tinted and wider than About's

     Ios26CardBrush / Ios26CardBorderBrush / Ios26CardShadow are deliberately
     untouched: they are the About reference design, and its locks (see
     Tests/Theme/AppStageAuditTests) pin those values.

     NAMING
     ──────
     `Settings*` prefix, so a settings key can never be mistaken for a
     global surface token. The values are the About ones; the names say
     where they are used. Containers come from SurfacePrimaryStyle's
     family only where the mockup is genuinely a shell surface (the page
     header strip) — everything card-shaped is here.

     COMPOSITION RULES (enforced by SettingsRedesignAuditTests)
     ────────────────────────────────────────────────────────
       1. A page = a StackPanel of SettingsPageCardStyle cards, gap 14.
       2. A card = icon tile + title + optional chip in the header row,
          then content; never a bare border with no title.
       3. Content inside a card is SettingsInnerTileStyle (or plain rows
          separated by SettingsRowSeparatorStyle).
       4. Read-only values are SettingsValuePillStyle, never coloured text.
       5. Status is a chip (soft / green / warning / danger), never a
          coloured label.
       6. Spacing comes from SettingsGap* tokens; dividers come from
          SettingsRowSeparatorStyle — never an empty card used as a gap
          (the old module did that with <Border Style="SurfaceDetailStyle"/>).
       7. No literal hex, no literal CornerRadius, no literal FontSize in
          any settings view (audit-locked; the sections were already clean
          and must stay clean).
═══════════════════════════════════════════════════════════════════ -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ═══ SPACING SCALE — the only gaps a settings page may use ═══
         Density-derived where density exists (CardPadding follows the
         profile); the rest are composition gaps, deliberately fixed so a
         page's rhythm does not change when the operator changes density
         of CONTROLS. -->
    <!-- 2026-09-16 (owner: "cards are too big … check About module cards
         spacing then compare with complete setting modules all screen and
         apply accordingly"). The About module is the benchmark this whole
         crystal design came from, so its rhythm numbers are now the
         settings rhythm too — measured, not guessed:

           About page block      StackPanel Margin="32,26,32,32"  (AboutView:266)
           About card padding    Ios26CardStyle Padding="22,20"   (AboutIos26Theme:112)
           About card gap        Margin="0,0,0,14" on every card  (12 of 14 cards)
           About header gap      title Margin="0,0,0,14"          (DiagnosticsSection:58)

         The settings module was running 24,22 padding / 22 gap / 18 page
         padding: every card was 4 px taller, 4 px wider inside and 8 px
         further from its neighbour than the About card it is supposed to
         look like — which is exactly "the cards are too big". Page padding
         goes 18 → 24 horizontally rather than About's 32: About is a
         read-only page, these carry dense label+control rows and a 32 px
         inset starts clipping them below 1280. -->
    <Thickness x:Key="SettingsPagePadding">24,20,24,24</Thickness>
    <Thickness x:Key="SettingsCardPadding">22,20</Thickness>
    <!-- Crystal-axis rows (Themes): label sits above the track, 6px air,
         then 22px to the next row — matches the approved mockup rhythm. -->
    <Thickness x:Key="SettingsAxisLabelMargin">0,0,0,6</Thickness>
    <Thickness x:Key="SettingsAxisRowMargin">0,0,0,22</Thickness>
    <Thickness x:Key="SettingsCardContentMargin">0,14,0,0</Thickness>
    <Thickness x:Key="SettingsTilePadding">12,10</Thickness>
    <Thickness x:Key="SettingsRowPadding">0,9</Thickness>
    <Thickness x:Key="SettingsIconTextMargin">10,0,0,0</Thickness>

    <!-- The scale in About's numbers: 14 between cards/blocks, 6 between
         rows inside a card, 10 for inline icon↔label air. (2026-09-17 had
         these at 22 after a "cards are too close" report; the owner then
         benchmarked the module against About, and 14 is what About uses —
         the 22 was compensating for the over-padded card, not for the gap.) -->
    <sys:Double x:Key="SettingsGapPage">14</sys:Double>
    <sys:Double x:Key="SettingsGapCard">14</sys:Double>
    <sys:Double x:Key="SettingsGapRow">6</sys:Double>
    <sys:Double x:Key="SettingsGapInline">10</sys:Double>
    <sys:Double x:Key="SettingsGapSection">14</sys:Double>

    <Thickness x:Key="SettingsCardMargin">0,0,0,14</Thickness>
    <Thickness x:Key="SettingsRowMargin">0,0,0,6</Thickness>
    <!-- v3 (2026-09-17) spacing scale completion: every rhythmic gap in the
         sections now has ONE name. Before this, 425 literal Margin="…" values
         carried the rhythm, which is why "give the cards air" could never be
         applied globally. Optical 1-4 px nudges stay literal on purpose. -->
    <Thickness x:Key="SettingsTrailingGap">0,0,12,0</Thickness>
    <Thickness x:Key="SettingsStackGap4">0,4,0,0</Thickness>
    <Thickness x:Key="SettingsStackGap8">0,8,0,0</Thickness>
    <Thickness x:Key="SettingsStackGap10">0,10,0,0</Thickness>
    <Thickness x:Key="SettingsStackGap12">0,12,0,0</Thickness>
    <Thickness x:Key="SettingsStackGap18">0,18,0,0</Thickness>
    <Thickness x:Key="SettingsStackBottom8">0,0,0,8</Thickness>
    <Thickness x:Key="SettingsStackBottom10">0,0,0,10</Thickness>
    <Thickness x:Key="SettingsInlineGap6">6,0,0,0</Thickness>
    <Thickness x:Key="SettingsInlineGap8">8,0,0,0</Thickness>
    <Thickness x:Key="SettingsInlineGap6R">0,0,6,0</Thickness>
    <Thickness x:Key="SettingsInlineGap8R">0,0,8,0</Thickness>
    <Thickness x:Key="SettingsInlineGap10R">0,0,10,0</Thickness>
    <Thickness x:Key="SettingsNoteMargin">0,4,0,10</Thickness>
    <Thickness x:Key="SettingsTileWrapMargin">0,0,8,8</Thickness>

    <!-- OPTION-TILE GUTTER (2026-09-18, owner report: "cards under cards of
         options too close — give the same spacing inside cards' options as the
         main cards"). A UniformGrid has no gap property, so the 14 px rhythm
         that separates the CARDS (SettingsCardMargin 0,0,0,14) is reproduced
         inside a tile grid the only way a grid allows: half the gutter on every
         side of every child, plus a matching negative bleed on the grid so the
         outer edges stay flush with the card content box. Net effect: 14 px
         between tiles on BOTH axes, 14 px below the grid (replacing the old
         6 px SettingsRowMargin), zero drift at the card edges. -->
    <Thickness x:Key="SettingsTileGridMargin">7,7</Thickness>
    <Thickness x:Key="SettingsTileGridBleed">-7,-7,-7,7</Thickness>
    <!-- Same bleed for a grid that must KEEP a top offset (one that sat under a
         card title via SettingsCardContentMargin 0,14,0,0): top +7 plus the
         children's 7 reproduces the original 14 px instead of cancelling it. -->
    <Thickness x:Key="SettingsTileGridBleedKeepTop">-7,7,-7,7</Thickness>
    <Thickness x:Key="SettingsInlineGap12">12,0,0,0</Thickness>
    <Thickness x:Key="SettingsStackGap6">0,6,0,0</Thickness>
    <Thickness x:Key="SettingsHeaderContentMargin">0,14,0,4</Thickness>
    <Thickness x:Key="SettingsStackGap14">0,14,0,0</Thickness>
    <Thickness x:Key="SettingsStackGap16">0,16,0,0</Thickness>
    <Thickness x:Key="SettingsStackGap16Bottom4">0,16,0,4</Thickness>
    <Thickness x:Key="SettingsStackGap12Bottom2">0,12,0,2</Thickness>
    <Thickness x:Key="SettingsStackGap12Bottom4">0,12,0,4</Thickness>
    <Thickness x:Key="SettingsStackGap6Bottom2">0,6,0,2</Thickness>
    <Thickness x:Key="SettingsNoteTightMargin">0,2,0,10</Thickness>
    <Thickness x:Key="SettingsNoteBottom8">0,10,0,8</Thickness>
    <Thickness x:Key="SettingsTrailingGapWide">0,0,20,0</Thickness>
    <Thickness x:Key="SettingsDiscTitleMargin">4,16,0,0</Thickness>
    <Thickness x:Key="SettingsHeaderInlineMargin">18,8</Thickness>
    <Thickness x:Key="SettingsUniformGap">12</Thickness>
    <Thickness x:Key="SettingsInlineGap14">14,0,0,0</Thickness>
    <Thickness x:Key="SettingsIconTextTightMargin">10,0,6,0</Thickness>
    <Thickness x:Key="SettingsInlineGap10Top2">10,2,0,0</Thickness>
    <Thickness x:Key="SettingsFlagGridMargin">32,4,32,0</Thickness>
    <Thickness x:Key="SettingsBentoColLeft">0,0,8,0</Thickness>
    <Thickness x:Key="SettingsBentoColRight">8,0,0,0</Thickness>
    <Thickness x:Key="SettingsBentoRowMargin">0,0,0,16</Thickness>
    <Thickness x:Key="SettingsInset4">4</Thickness>
    <Thickness x:Key="SettingsInset2">2</Thickness>
    <Thickness x:Key="SettingsStackGap2">0,2,0,0</Thickness>
    <Thickness x:Key="SettingsStackBottom4">0,0,0,4</Thickness>
    <Thickness x:Key="SettingsStackGap4Bottom2">0,4,0,2</Thickness>
    <Thickness x:Key="SettingsDockTextMargin">2,4,2,2</Thickness>
    <Thickness x:Key="SettingsDockCaptionMargin">2,0,2,2</Thickness>

    <!-- ═══ CARD — page-sized crystal glass (2026-09-17) ═══

         The surface keys below are theme-owned (Themes/LightTheme.xaml,
         Themes/DarkTheme.xaml) so a Light/Dark switch repaints the whole
         module with no code-behind:

           SettingsCardFaceBrush   base gradient + specular rim + sheen +
                                   refraction lip, in ONE DrawingBrush that
                                   stretches to any card size
           SettingsCardEdgeBrush   tri-stop crystal edge
           SettingsCardShadow      tinted, wider, softer than About's

         It stays a Border on purpose. Turning the card into a templated
         ContentControl (the LiquidGlassSurface route) would give the same
         six layers but would break every section's Border composition and the
         nested-card / card-as-spacer locks; a gradient face plus a gradient
         edge plus a tinted shadow carries the material on its own. -->
    <Style x:Key="SettingsPageCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SettingsCardFaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource CardEdgeThickness}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Ios26RadiusCard}"/>
        <Setter Property="Padding" Value="{StaticResource SettingsCardPadding}"/>
        <Setter Property="Margin" Value="{StaticResource SettingsCardMargin}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="RenderOptions.EdgeMode" Value="Aliased"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        <Setter Property="Effect" Value="{DynamicResource SettingsCardShadow}"/>
        <Style.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0.88" To="1.0"
                                         Duration="0:0:0.12">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- Card frames that need no shadow: the action bar and any card the
         page already sits inside another surface for. -->
    <Style x:Key="SettingsFlatCardStyle" TargetType="Border"
           BasedOn="{StaticResource SettingsPageCardStyle}">
        <Setter Property="Effect" Value="{x:Null}"/>
        <Setter Property="Background" Value="{DynamicResource Ios26TileBrush}"/>
        <Setter Property="Padding" Value="14,12"/>
    </Style>

    <!-- Danger card: same geometry, red-tinted edge + wash, for the
         destructive pages (Demo reset, Data purge). -->
    <Style x:Key="SettingsDangerCardStyle" TargetType="Border"
           BasedOn="{StaticResource SettingsPageCardStyle}">
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Ios26TileBrush}"/>
    </Style>

    <!-- ═══ INNER TILE — the panel inside a card ═══
         2026-09-17: was Ios26TileBrush, which is OPAQUE #FFFFFF in Light. An
         opaque panel on top of translucent glass is what made every tile look
         like a flat sticker pasted on the card, and it was the single biggest
         reason the module still read as the old design. The inner surface is
         now translucent in both themes. -->
    <Style x:Key="SettingsInnerTileStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SettingsInnerFaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsInnerEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource CardEdgeThickness}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Ios26RadiusInner}"/>
        <Setter Property="Padding" Value="{StaticResource SettingsTilePadding}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="RenderOptions.EdgeMode" Value="Aliased"/>
    </Style>

    <!-- Hover surface for an interactive tile / row (mockup: preset tiles,
         scene cells, backup rows). -->
    <Style x:Key="SettingsInteractiveTileStyle" TargetType="Border"
           BasedOn="{StaticResource SettingsInnerTileStyle}">
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Ios26HoverBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Tile with no fill — for grids that sit directly on the card. -->
    <Style x:Key="SettingsBareTileStyle" TargetType="Border"
           BasedOn="{StaticResource SettingsInnerTileStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ios26HairlineBrush}"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>

    <!-- Semantic tiles: a tile whose WASH carries meaning (this PC vs the
         published release, a verified backup, a warning). The old pages
         built these by hand — Background="{DynamicResource TintBlueBrush}"
         plus their own CornerRadius/Padding — which is how twelve pages
         ended up with twelve slightly different "cards". -->
    <Style x:Key="SettingsInfoTileStyle" TargetType="Border"
           BasedOn="{StaticResource SettingsInnerTileStyle}">
        <Setter Property="Background" Value="{DynamicResource Ios26AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ios26AccentSoftBrush}"/>
    </Style>

    <Style x:Key="SettingsSuccessTileStyle" TargetType="Border"
           BasedOn="{StaticResource SettingsInnerTileStyle}">
        <Setter Property="Background" Value="{DynamicResource Ios26SuccessSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ios26SuccessSoftBrush}"/>
    </Style>

    <Style x:Key="SettingsWashTileStyle" TargetType="Border"
           BasedOn="{StaticResource SettingsInnerTileStyle}">
        <Setter Property="Background" Value="{DynamicResource Ios26ValuePillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ios26ValuePillBrush}"/>
    </Style>

    <!-- ═══ METRIC ROLES — the big number inside a tile (version, size,
         latency, days remaining). ═══ -->
    <Style x:Key="SettingsMetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Ios26FontSizeH2}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.Bold}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ios26TextTitleBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="SettingsMetricLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Ios26FontSizeCaption}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ios26TextMutedBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- The old module tagged these labels with inline
         FontSize/FontWeight/Foreground triples — 200+ sites. The roles
         above replace them. -->

    <!-- ═══ ICON TILE — the disc that opens every card header ═══ -->
    <Style x:Key="SettingsIconTileStyle" TargetType="Border">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Ios26RadiusTile}"/>
        <Setter Property="Background" Value="{DynamicResource Ios26AccentSoftBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SettingsIconGlyphStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Icon}"/>
        <Setter Property="FontSize" Value="{DynamicResource Ios26FontSizeGlyph}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ios26AccentSoftTextBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ═══ TYPE ROLES ═══ -->
    <Style x:Key="SettingsCardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource Ios26FontSizeCardTitle}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.Bold}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ios26TextTitleBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="SettingsCardNoteStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Ios26FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ios26TextMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- Danger card roles: the destructive card's title and warning line are
         red on its wash (sheet 08: "Reset demonstration data" + its warning). -->
    <Style x:Key="SettingsDangerCardTitleStyle" TargetType="TextBlock"
           BasedOn="{StaticResource SettingsCardTitleStyle}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    </Style>

    <Style x:Key="SettingsDangerCardNoteStyle" TargetType="TextBlock"
           BasedOn="{StaticResource SettingsCardNoteStyle}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    </Style>

    <!-- Card header block — title, then the optional helper line. The note's
         own margin only separates it from the title, so the header roles add
         the air the approved mockups show between the header and the card's
         first row: title-only cards use SettingsCardHeaderStyle, cards with a
         helper line put the gap on the helper (SettingsCardHeaderNoteStyle) so
         the pair stays tight. -->
    <Style x:Key="SettingsCardHeaderStyle" TargetType="TextBlock"
           BasedOn="{StaticResource SettingsCardTitleStyle}">
        <!-- 14 = About's card title → first row gap (DiagnosticsSection:58). -->
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <Style x:Key="SettingsCardHeaderNoteStyle" TargetType="TextBlock"
           BasedOn="{StaticResource SettingsCardNoteStyle}">
        <Setter Property="Margin" Value="0,4,0,12"/>
    </Style>

    <Style x:Key="SettingsPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource Ios26FontSizeH1}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.Bold}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ios26TextTitleBrush}"/>
    </Style>

    <Style x:Key="SettingsPageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Ios26FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ios26TextMutedBrush}"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Group caption inside a page: the small uppercase-looking kicker
         that used to be SettingsGroupHeaderTextStyle. -->
    <!-- Cap sub-heading INSIDE a card. The second redesign pass moved every
         page's group heading into its card's header, so this is no longer a
         page-level band: it now heads a sub-group within a card — the
         wizard-step groups inside Features' module cards (sheet 10 keeps a cap
         group inside its "Module flags" tile). A page that uses it for a
         floating band above a group has undone the redesign; the test
         Settings_pages_head_their_groups_with_cards_not_bands says so. -->
    <Style x:Key="SettingsGroupCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource Ios26FontSizeLabel}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ios26TextMutedBrush}"/>
        <Setter Property="Margin" Value="4,4,0,8"/>
    </Style>

    <Style x:Key="SettingsFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Ios26FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ios26TextMutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SettingsFieldValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Ios26FontSizeValue}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ios26TextTitleBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ═══ NAVIGATION ROW (rail + any future nav surface) ═══
         Foreground is deliberately NOT set on either style. The rail's
         active state paints the row as a filled accent pill; a setter here
         would win over that state and leave dark ink on the accent fill.
         Unset, the glyph and the label inherit the button's foreground and
         flip together, which is how the approved mockup shows the selected
         row. Spacing uses the same 10 px icon↔text token as every tile. -->
    <Style x:Key="SettingsRowGlyphStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Icon}"/>
        <Setter Property="FontSize" Value="{DynamicResource Ios26FontSizeGlyph}"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SettingsRowLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource Ios26FontSizeValue}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="{StaticResource SettingsIconTextMargin}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="SettingsRowTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Ios26FontSizeValue}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ios26TextBodyBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SettingsRowMetaStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Ios26FontSizeLabel}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ios26TextFaintBrush}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <!-- ═══ VALUE PILL — every read-only value (keys, paths, sizes, counts) ═══ -->
    <Style x:Key="SettingsValuePillStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ios26ValuePillBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Ios26RadiusSmall}"/>
        <Setter Property="Padding" Value="9,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <Style x:Key="SettingsValuePillTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Ios26FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ios26TextSecondaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- ═══ CHIPS — status, counts, scope ═══ -->
    <Style x:Key="SettingsChipStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource Ios26RadiusChip}"/>
        <Setter Property="Padding" Value="9,3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource Ios26AccentSoftBrush}"/>
    </Style>

    <Style x:Key="SettingsChipTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Ios26FontSizeCaption}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ios26AccentSoftTextBrush}"/>
    </Style>

    <Style x:Key="SettingsChipGreenStyle" TargetType="Border"
           BasedOn="{StaticResource SettingsChipStyle}">
        <Setter Property="Background" Value="{DynamicResource Ios26SuccessSoftBrush}"/>
    </Style>

    <Style x:Key="SettingsChipGreenTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource SettingsChipTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource Ios26SuccessBrush}"/>
    </Style>

    <Style x:Key="SettingsChipMutedStyle" TargetType="Border"
           BasedOn="{StaticResource SettingsChipStyle}">
        <Setter Property="Background" Value="{DynamicResource Ios26ValuePillBrush}"/>
    </Style>

    <Style x:Key="SettingsChipMutedTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource SettingsChipTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource Ios26TextMutedBrush}"/>
    </Style>

    <Style x:Key="SettingsChipDangerStyle" TargetType="Border"
           BasedOn="{StaticResource SettingsChipStyle}">
        <Setter Property="Background" Value="{DynamicResource Ios26ValuePillBrush}"/>
    </Style>

    <Style x:Key="SettingsChipDangerTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource SettingsChipTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource Ios26DangerDotBrush}"/>
    </Style>

    <!-- Dot + label status row (mockup: "Connected", "UP TO DATE"). -->
    <Style x:Key="SettingsStatusDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="7"/>
        <Setter Property="Height" Value="7"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <!-- ═══ SEPARATOR — a real hairline, never an empty card ═══ -->
    <Style x:Key="SettingsRowSeparatorStyle" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Ios26HairlineBrush}"/>
        <Setter Property="Margin" Value="0,8"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ═══ BUTTONS — 12 px radius, never a 999 pill (owner directive) ═══ -->
    <Style x:Key="SettingsPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeightMedium}"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource Ios26FontSizeBody}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{DynamicResource Ios26AccentBrush}"
                            CornerRadius="{DynamicResource Ios26RadiusChip}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Ios26AccentDeepBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeightMedium}"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="FontSize" Value="{DynamicResource Ios26FontSizeBody}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ios26TextSecondaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{DynamicResource Ios26TileBrush}"
                            BorderBrush="{DynamicResource Ios26TileBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Ios26RadiusChip}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Ios26HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.78"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small square icon button (copy, folder, pencil, download). -->
    <Style x:Key="SettingsIconButtonStyle" TargetType="Button"
           BasedOn="{StaticResource SettingsSecondaryButtonStyle}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- ═══ SEGMENTED CONTROL — 2–4 mutually exclusive options (Light/Dark
         mode, display density; sheet 02/03). The track is the pill, the items
         are the segments, the SELECTED segment is the accent fill.

         A ListBox, not a row of ToggleButtons: the selector owns single
         selection, keyboard navigation and the accessibility tree, so an
         N-option control needs NO per-option IsChecked plumbing — bind
         SelectedItem/SelectedValue and the ViewModel stays the one source of
         truth. A ToggleButton row cannot do that (one IsChecked per button,
         so N options = N bools + N commands, and nothing unchecks the others).
         The template drops the selector's ScrollViewer on purpose: the panel
         is a 1-row UniformGrid, so there is nothing to scroll and the wheel
         keeps travelling to the page. ═══ -->
    <Style x:Key="SettingsSegmentItemStyle" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeightMedium}"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="FontSize" Value="{DynamicResource Ios26FontSizeBody}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ios26TextSecondaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="{DynamicResource Ios26RadiusChip}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Ios26HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Ios26AccentBrush}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource OnAccentForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The track the segments sit in: hugs its content (a 2-option switch). -->
    <Style x:Key="SettingsSegmentTrackStyle" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource Ios26ValuePillBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsSegmentItemStyle}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <!-- UniformGrid: every segment gets the same width, whatever
                         its label length, so the row reads as one control. -->
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Ios26RadiusChip}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The same control filling its column (4-option density, sheet 03). -->
    <Style x:Key="SettingsSegmentTrackFillStyle" TargetType="ListBox"
           BasedOn="{StaticResource SettingsSegmentTrackStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- ═══ ACTION BAR — the slim footer card with right-aligned buttons ═══ -->
    <Style x:Key="SettingsActionBarStyle" TargetType="Border"
           BasedOn="{StaticResource SettingsFlatCardStyle}">
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
</ResourceDictionary>
