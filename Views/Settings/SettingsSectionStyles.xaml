    <!-- ═══════════════════════════════════════════════════════════════
         6. TILE-GRID DESIGN SYSTEM (Settings redesign — Aug 2026)

         The pre-2026 Settings layout stacked every option as a full-width
         DockPanel row inside one giant SectionCardStyle. On wide monitors
         that wasted 60-70% of horizontal space; on a 1366-pixel laptop
         the vertical stack felt endless and crowded. The user asked for
         a stylish, professional card layout.

         WHAT THIS DESIGN SYSTEM IS
         Each individual setting becomes its own self-contained "tile" -
         a rounded bordered card that displays icon + title + subtitle +
         control in a fixed footprint. Tiles are dropped into a WrapPanel
         so they auto-flow into 1/2/3/4 columns depending on window
         width. Wide-content tiles (wallpaper picker, backup list,
         provider matrix) span two column widths; a Full-row variant
         forces a break for the very largest surfaces.

         STATUS (2026-09-16 redesign, second pass)
           The tile grammar above is superseded by SettingsCardStyles.xaml for
           layout: every page's group is a PAGE CARD whose header is the group's
           title plus its recap line, and every container inside a card is an
           INNER TILE. What still lives here is behaviour, not layout — the
           password box, provider select, progress bar, sliders, the rail's
           button + focus styles and the action button.

         RESOURCE INDEX
           SettingsGroupCaptionStyle    - CAP SUB-HEADING inside a card (the
                                          wizard-step groups in Features'
                                          module cards). Not a page-level band
                                          any more — a band above a group is a
                                          regression, and a test locks that.
           SettingsTileFooterHintStyle  - one-line hint below control.
           SettingsTileHeroStyle        - centred value badge for metric
                                          tiles (theme mode / version).

         RULES
           - Tiles do NOT set their own Width - the WrapPanel host does.
             Hard-coding width inside the Setter would break reflow.
           - Every tile uses the same Padding (18,16) and Margin
             (0,0,14,14) so the WrapPanel gutter stays even regardless
             of tile count.
           - Only the accent-BorderBrush follows the current accent
             preset; background stays neutral so the tile grid reads as
             calm cards, not neon. Matches SectionCardStyle intent.
    ═══════════════════════════════════════════════════════════════ -->

    

    

    

    

    

    

    

    

    

    

    

    

    <!-- Full-width action row — an even row of buttons that STRETCH so they
         span the whole card. Each Button in the UniformGrid gets an equal
         share of the width (set Columns per row). This fixes the "buttons
         left-aligned leaving a big empty gap on the right" complaint. -->
    

    <!-- A single button used inside SettingsActionRowStyle: stretch to fill
         its cell so the grouped buttons never appear left-cramped. -->
    <!-- Modern full-width action button. All settings action buttons use
         this so they share one polished shape: 12px rounded (follows the
         dynamic CardCornerRadius token), a tinted fill, a subtle outline,
         and clear hover / pressed / focus states. It stretches to fill the
         UniformGrid cell so a button group never leaves a right-hand gap. -->
    <Style x:Key="SettingsActionButtonStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="MinWidth" Value="{DynamicResource DensityButtonMinWidth}"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{DynamicResource SurfaceTertiaryBrush}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="{DynamicResource CardBorderThickness}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            MinHeight="{TemplateBinding MinHeight}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center">
                            <!-- Optional Tag-glyph icon (matches Pill/Row button convention).
                                 Collapses automatically when Tag is empty or unset. -->
                            <TextBlock Text="{TemplateBinding Tag}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Bg" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         MODERN SLIDER — iPhone-style pill slider: a tall rounded pill
         track with an accent-coloured fill that shows the current level,
         and a round accent thumb. Replaces the default OS slider look for
         settings controls (border thickness, wallpaper visibility, etc.).
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="ModernSliderTrackRepeatStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{DynamicResource SurfaceTertiaryBrush}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernSliderFillRepeatStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{DynamicResource AccentBrush}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernSliderThumbStyle" TargetType="Thumb">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Ellipse Width="24" Height="24"
                                 Fill="{DynamicResource AccentBrush}"
                                 Opacity="0.20"/>
                        <Ellipse Width="16" Height="16"
                                 Fill="{DynamicResource AccentBrush}">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4"
                                                  ShadowDepth="1"
                                                  Opacity="0.20"
                                                  RenderingBias="Performance"
                                                  Color="{DynamicResource LiquidShadowColor}"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fill-bar slider (reference look): a tall rounded bar with an
         accent-coloured fill showing the current level and a centered value
         label ("62%" for opacity sliders, "1.5" for border thickness). The
         thumb is subtle; the whole bar is the slider. -->
    <Style x:Key="ModernSliderStyle" TargetType="Slider">
        <Setter Property="Height" Value="40"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <!-- Base rounded bar -->
                        <Border Height="40" CornerRadius="{DynamicResource CardCornerRadius}"
                                Background="{DynamicResource SurfaceTertiaryBrush}"
                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                BorderThickness="{DynamicResource Border.HairlineThickness}"
                                SnapsToDevicePixels="True"/>
                        <!-- Accent fill (Decrease portion) + track -->
                        <Track x:Name="PART_Track"
                               Height="40">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ModernSliderFillRepeatStyle}"
                                              Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ModernSliderTrackRepeatStyle}"
                                              Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ModernSliderThumbStyle}"/>
                            </Track.Thumb>
                        </Track>
                        <!-- Centered value label -->
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.SemiBold}"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   IsHitTestVisible="False">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource SliderValueLabelConverter}">
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
