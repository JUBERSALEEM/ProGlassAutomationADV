    <!-- Rounded password box (API keys). -->
    <Style x:Key="RoundedPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Height"                   Value="36"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Title}"/>
        <Setter Property="Padding"                  Value="14,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background"               Value="{DynamicResource Surface.Primary.BackgroundBrush}"/>
        <Setter Property="Foreground"               Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness"          Value="1.5"/>
        <Setter Property="BorderBrush"              Value="{DynamicResource Surface.Primary.BorderBrush}"/>
        <Setter Property="SnapsToDevicePixels"      Value="True"/>
        <Setter Property="UseLayoutRounding"        Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{DynamicResource Surface.Primary.BorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{DynamicResource Surface.Primary.BorderBrush}"/>
                            <Setter TargetName="Root" Property="BorderThickness"
                                    Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent preset chip — migrated to the standardized design
         system (H34 pill, hover/pressed/focus/disabled triggers).
         Content is a swatch dot + label defined inline per chip. -->
    <Style x:Key="AccentChipStyle" TargetType="Button">
        <Setter Property="Cursor"              Value="Hand"/>
        <Setter Property="Height"              Value="34"/>
        <Setter Property="Padding"             Value="12,0"/>
        <Setter Property="Margin"              Value="0,0,8,8"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
        <Setter Property="FontWeight"          Value="{DynamicResource Weight.SemiBold}"/>
        <Setter Property="Foreground"          Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{DynamicResource SurfaceTertiaryBrush}"
                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                            BorderThickness="{DynamicResource CardBorderThickness}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="bd" Property="Background"
                                    Value="{DynamicResource SurfaceSecondaryBrush}"/>
                            <Setter TargetName="bd" Property="Opacity" Value="0.95"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="bd" Property="BorderThickness"
                                    Value="1.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SELECT pill inside provider cards. Extends to ACTIVE state via
         per-provider DataTrigger (BasedOn in the card). -->
    <Style x:Key="ProviderSelectButtonStyle" TargetType="Button">
        <Setter Property="Content"             Value="SELECT"/>
        <!-- 2026-09-01: was GlassBorderSoft → SELECT label was white-
             on-white. Now the real accent ink so the button reads. -->
        <Setter Property="Foreground"          Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Height"              Value="32"/>
        <Setter Property="MinHeight"           Value="32"/>
        <Setter Property="Padding"             Value="14,0"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.BodySmall}"/>
        <Setter Property="FontWeight"          Value="{DynamicResource Weight.Bold}"/>
        <Setter Property="BorderThickness"     Value="0"/>
        <Setter Property="Cursor"              Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="{DynamicResource CardBorderThickness}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Whisper model download progress bar. -->
    <Style x:Key="DownloadProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height"              Value="8"/>
        <Setter Property="Maximum"             Value="100"/>
        <!-- 2026-09-01: was GlassBorderSoft (white 18% alpha) → the
             download fill was invisible. Accent is the progress colour. -->
        <Setter Property="Foreground"          Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background"          Value="{DynamicResource SurfaceElevatedBrush}"/>
        <Setter Property="BorderThickness"     Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="{DynamicResource Radius.XSmall}"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <Border x:Name="PART_Indicator"
                                CornerRadius="{DynamicResource Radius.XSmall}"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Base style for Whisper model option cards. Used exclusively via
