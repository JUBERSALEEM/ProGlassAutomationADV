<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/SettingsSectionStyles.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — shared resource dictionary

     Single source of truth for every Settings section UserControl and
     the Settings shell. Merged by:
       • SettingsView.xaml (shell — nav rail + section hosts)
       • Sections/Settings{Appearance,Ai,Voice,Updates,Data,About}Section.xaml

     CONTENT
       1. Frozen brushes (local constants)
       2. Cards (SectionCard, InfoCard)
       3. Typography (labels, rows, hints, values)
       4. Controls (toggle switch, password box, accent chips,
          provider SELECT button, download progress bar,
          Whisper model option card base)
       5. Shell (navigation rail item style)

     RULES
       • Buttons come from global Styles/ButtonStyles.xaml
         (PrimaryPillButton / OutlinedPillButton / SuccessPillButton /
          DangerButton / RowOutlinedButton …). No local button styles.
       • Icons: Segoe MDL2 Assets glyphs only — never emoji.
═══════════════════════════════════════════════════════════════════════ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- ═══════════════════════════════════════════════════════════════
         1. FROZEN BRUSHES (local constants)
    ═══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="PillBorderLightBrush" Color="#93C5FD" po:Freeze="True"/>
    <SolidColorBrush x:Key="ProviderDotBlue"      Color="#4285F4" po:Freeze="True"/>
    <SolidColorBrush x:Key="ProviderDotAmber"     Color="{DynamicResource WarningColor}"/>
    <SolidColorBrush x:Key="ProviderDotViolet"    Color="#8B5CF6" po:Freeze="True"/>

    <!-- ═══════════════════════════════════════════════════════════════
         2. CARDS
    ═══════════════════════════════════════════════════════════════ -->
    <!-- The accent border is INTENTIONAL and original. It is what gives every
         Settings section card its visible coloured edge, and it follows the
         chosen accent preset (Glass Blue / Emerald / Amber / Rose / Violet /
         Teal) because ThemeManager.ApplyAccent rewrites AccentBrush.
         A previous edit swapped this for the neutral OutlineBrush, which
         erased the coloured card edges the user relies on - do not repeat
         that. Neutral hairlines belong on plain surfaces, not on these. -->
    <Style x:Key="SectionCardStyle" TargetType="Border">
        <Setter Property="Background"          Value="{DynamicResource ModuleBackgroundBrush}"/>
        <Setter Property="BorderBrush"         Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness"     Value="1.5"/>
        <Setter Property="CornerRadius"        Value="14"/>
        <Setter Property="Padding"             Value="24,20"/>
        <Setter Property="Margin"              Value="0,0,0,20"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
    </Style>

    <Style x:Key="InfoCardStyle" TargetType="Border">
        <Setter Property="Background"          Value="{DynamicResource TintIndigoBrush}"/>
        <!-- Was StaticResource PillBorderLightBrush, a frozen #93C5FD.
             StaticResource resolves ONCE at load, so this keyline could
             never follow a Light/Dark swap or a Monet/Professional
             recolour - which is why the About and Help cards stayed pale
             blue while Appearance adapted. Now the shared dynamic token. -->
        <Setter Property="BorderBrush"         Value="{DynamicResource OutlineBrush}"/>
        <Setter Property="BorderThickness"     Value="1.5"/>
        <Setter Property="CornerRadius"        Value="{DynamicResource CardCornerRadiusLarge}"/>
        <Setter Property="Padding"             Value="22,18"/>
        <Setter Property="Margin"              Value="0,0,0,18"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
    </Style>

    <!-- Base setters for the AI provider cards. Each card extends this
         with BasedOn + its own IsXxxActive DataTrigger. -->
    <Style x:Key="ProviderCardBaseStyle" TargetType="Border">
        <Setter Property="CornerRadius"        Value="14"/>
        <Setter Property="Padding"             Value="16,14"/>
        <Setter Property="Margin"              Value="0,0,0,12"/>
        <Setter Property="BorderThickness"     Value="1.5"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
        <Setter Property="BorderBrush"         Value="{DynamicResource OutlineBrush}"/>
        <Setter Property="Background"          Value="{DynamicResource ModuleBackgroundBrush}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         3. TYPOGRAPHY
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="InfoCardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"          Value="14"/>
        <Setter Property="FontWeight"        Value="Bold"/>
        <Setter Property="Foreground"        Value="{DynamicResource AccentBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <Style x:Key="InfoCardBodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize"         Value="12"/>
        <Setter Property="LineHeight"       Value="20"/>
        <Setter Property="Foreground"       Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="TextWrapping"     Value="Wrap"/>
        <Setter Property="Margin"           Value="0,10,0,0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="InfoCardBulletStyle" TargetType="TextBlock">
        <Setter Property="FontSize"         Value="12"/>
        <Setter Property="LineHeight"       Value="19"/>
        <Setter Property="Foreground"       Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="TextWrapping"     Value="Wrap"/>
        <Setter Property="Margin"           Value="0,6,0,0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize"         Value="11"/>
        <Setter Property="FontWeight"       Value="Bold"/>
        <Setter Property="Foreground"       Value="{DynamicResource MutedForegroundBrush}"/>
        <Setter Property="Margin"           Value="0,0,0,10"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="RowTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"          Value="14"/>
        <Setter Property="FontWeight"        Value="Bold"/>
        <Setter Property="Foreground"        Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="HintTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize"         Value="11"/>
        <Setter Property="Foreground"       Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="TextWrapping"     Value="Wrap"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="LabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize"         Value="10"/>
        <Setter Property="FontWeight"       Value="Bold"/>
        <Setter Property="Foreground"       Value="{DynamicResource MutedForegroundBrush}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="ValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
    </Style>

    <!-- Page header used at the top of every section. -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"         Value="24"/>
        <Setter Property="FontWeight"       Value="Bold"/>
        <Setter Property="Foreground"       Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"         Value="12"/>
        <Setter Property="Margin"           Value="0,4,0,0"/>
        <Setter Property="Foreground"       Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <!-- LAYOUT FIX: was missing, unlike HintTextStyle. Without it a
             long subtitle (the AI & Agent page has the longest in the app
             at 71 chars) renders as one unbroken line, widening the header
             row and pushing content past the right edge on narrow windows. -->
        <Setter Property="TextWrapping"     Value="Wrap"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         4. CONTROLS
    ═══════════════════════════════════════════════════════════════ -->

    <!-- iOS-style animated toggle switch. -->
    <Style x:Key="ModernToggleSwitch" TargetType="ToggleButton">
        <Setter Property="Width"               Value="56"/>
        <Setter Property="Height"              Value="28"/>
        <Setter Property="Cursor"              Value="Hand"/>
        <Setter Property="BorderThickness"     Value="0"/>
        <!-- NOTE: must be a LITERAL color, not a DynamicResource. The
             ControlTemplate's trigger Storyboard animates
             (Border.Background).(SolidColorBrush.Color), and a Storyboard
             that references a DynamicResource (or a shared frozen brush)
             cannot be frozen when the Style is sealed → it throws
             "Cannot freeze this Storyboard timeline tree" at runtime. -->
        <Setter Property="Background"          Value="#CBD5E1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Track"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True"/>
                        <TextBlock x:Name="OffLabel" Text="OFF"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,9,0"
                                   IsHitTestVisible="False"/>
                        <TextBlock x:Name="OnLabel" Text="ON"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="9,0,0,0"
                                   Opacity="0"
                                   IsHitTestVisible="False"/>
                        <Ellipse x:Name="Thumb"
                                 Width="22" Height="22" Fill="White"
                                 HorizontalAlignment="Left"
                                 Margin="3,0,0,0"
                                 SnapsToDevicePixels="True">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="ThumbTransform" X="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ThumbTransform"
                                            Storyboard.TargetProperty="X"
                                            To="28" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="OffLabel"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0" Duration="0:0:0.15"/>
                                        <DoubleAnimation
                                            Storyboard.TargetName="OnLabel"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1" Duration="0:0:0.15"/>
                                        <ColorAnimation
                                            Storyboard.TargetName="Track"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#1D4ED8" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ThumbTransform"
                                            Storyboard.TargetProperty="X"
                                            To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="OffLabel"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1" Duration="0:0:0.15"/>
                                        <DoubleAnimation
                                            Storyboard.TargetName="OnLabel"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0" Duration="0:0:0.15"/>
                                        <ColorAnimation
                                            Storyboard.TargetName="Track"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#CBD5E1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rounded password box (API keys). -->
    <Style x:Key="RoundedPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Height"                   Value="42"/>
        <Setter Property="FontSize"                 Value="13"/>
        <Setter Property="Padding"                  Value="14,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background"               Value="{DynamicResource ModuleBackgroundBrush}"/>
        <Setter Property="Foreground"               Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="BorderThickness"          Value="1.5"/>
        <Setter Property="BorderBrush"              Value="{DynamicResource OutlineBrush}"/>
        <Setter Property="SnapsToDevicePixels"      Value="True"/>
        <Setter Property="UseLayoutRounding"        Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Root" Property="BorderThickness"
                                    Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent preset chip — migrated to the standardized design
         system (H34 pill, hover/pressed/focus/disabled triggers).
         Content is a swatch dot + label defined inline per chip. -->
    <Style x:Key="AccentChipStyle" TargetType="Button">
        <Setter Property="Cursor"              Value="Hand"/>
        <Setter Property="Height"              Value="34"/>
        <Setter Property="Padding"             Value="12,0"/>
        <Setter Property="Margin"              Value="0,0,8,8"/>
        <Setter Property="FontSize"            Value="12"/>
        <Setter Property="FontWeight"          Value="SemiBold"/>
        <Setter Property="Foreground"          Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{DynamicResource MenuHoverBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="{DynamicResource CardBorderThickness}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="bd" Property="BorderThickness"
                                    Value="1.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SELECT pill inside provider cards. Extends to ACTIVE state via
         per-provider DataTrigger (BasedOn in the card). -->
    <Style x:Key="ProviderSelectButtonStyle" TargetType="Button">
        <Setter Property="Content"             Value="SELECT"/>
        <Setter Property="Foreground"          Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Height"              Value="28"/>
        <Setter Property="Padding"             Value="12,0"/>
        <Setter Property="FontSize"            Value="10"/>
        <Setter Property="FontWeight"          Value="Bold"/>
        <Setter Property="BorderThickness"     Value="0"/>
        <Setter Property="Cursor"              Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="{DynamicResource CardBorderThickness}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Whisper model download progress bar. -->
    <Style x:Key="DownloadProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height"              Value="8"/>
        <Setter Property="Maximum"             Value="100"/>
        <Setter Property="Foreground"          Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background"          Value="{DynamicResource MenuHoverBrush}"/>
        <Setter Property="BorderThickness"     Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <Border x:Name="PART_Indicator"
                                CornerRadius="4"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Base style for Whisper model option cards. Used exclusively via
         BasedOn inside Border.Style child elements — never as a Style=
         attribute (XLS0501 prevention). -->
    <Style x:Key="ModelOptionCardStyle" TargetType="Border">
        <Setter Property="CornerRadius"        Value="10"/>
        <Setter Property="Padding"             Value="12,10"/>
        <Setter Property="Margin"              Value="0,0,0,8"/>
        <Setter Property="BorderThickness"     Value="1.5"/>
        <Setter Property="Cursor"              Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
        <Setter Property="BorderBrush"         Value="{DynamicResource OutlineBrush}"/>
        <Setter Property="Background"          Value="{DynamicResource ModuleBackgroundBrush}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         5. SHELL — NAVIGATION RAIL
    ═══════════════════════════════════════════════════════════════ -->

    <!-- One navigation entry in the left rail. Active state is driven by
         the Button's Tag: the per-item Style sets Tag="Active" from a
         DataTrigger on its Is{Page}Page VM property; the template then
         lights the tinted background + accent bar (ControlTemplate
         triggers are the ONLY place TargetName is legal). -->
    <Style x:Key="SettingsNavButtonStyle" TargetType="Button">
        <Setter Property="Cursor"              Value="Hand"/>
        <Setter Property="Margin"              Value="10,2"/>
        <Setter Property="Tag"                 Value="Inactive"/>
        <Setter Property="Background"          Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="12,10"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="ActiveBar"
                                Width="3.5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Height="22"
                                Margin="2,0,0,0"
                                CornerRadius="2"
                                Background="{DynamicResource AccentBrush}"
                                Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource MenuHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource TintIndigoBrush}"/>
                            <Setter TargetName="ActiveBar" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon slot in a nav item (Segoe MDL2 Assets glyph). -->
    <Style x:Key="NavGlyphStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"        Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize"          Value="15"/>
        <Setter Property="Width"             Value="22"/>
        <Setter Property="TextAlignment"     Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground"        Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <!-- Label slot in a nav item. -->
    <Style x:Key="NavLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize"          Value="12.5"/>
        <Setter Property="FontWeight"        Value="SemiBold"/>
        <Setter Property="Margin"            Value="10,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground"        Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <!-- Circular glyph badge for info cards. -->
    <Style x:Key="InfoGlyphBadgeStyle" TargetType="Border">
        <Setter Property="Width"               Value="34"/>
        <Setter Property="Height"              Value="34"/>
        <Setter Property="CornerRadius"        Value="17"/>
        <Setter Property="Background"          Value="{DynamicResource TintBlueBrush}"/>
        <Setter Property="Margin"              Value="0,0,12,0"/>
        <Setter Property="VerticalAlignment"   Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
    </Style>

    <Style x:Key="InfoGlyphTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"             Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize"               Value="15"/>
        <Setter Property="Foreground"             Value="{DynamicResource AccentBrush}"/>
        <Setter Property="HorizontalAlignment"    Value="Center"/>
        <Setter Property="VerticalAlignment"      Value="Center"/>
        <Setter Property="IsHitTestVisible"       Value="False"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         6. TILE-GRID DESIGN SYSTEM (Settings redesign — Aug 2026)

         The pre-2026 Settings layout stacked every option as a full-width
         DockPanel row inside one giant SectionCardStyle. On wide monitors
         that wasted 60-70% of horizontal space; on a 1366-pixel laptop
         the vertical stack felt endless and crowded. The user asked for
         a stylish, professional card layout.

         WHAT THIS DESIGN SYSTEM IS
         Each individual setting becomes its own self-contained "tile" -
         a rounded bordered card that displays icon + title + subtitle +
         control in a fixed footprint. Tiles are dropped into a WrapPanel
         so they auto-flow into 1/2/3/4 columns depending on window
         width. Wide-content tiles (wallpaper picker, backup list,
         provider matrix) span two column widths; a Full-row variant
         forces a break for the very largest surfaces.

         RESOURCE INDEX
           SettingsGroupHeaderTextStyle - group heading ("APPEARANCE").
           SettingsGroupCaptionStyle    - one-line description under it.
           SettingsTileStyle            - standard 320-wide setting tile.
           SettingsWideTileStyle        - 660-wide (spans two columns).
           SettingsFullRowTileStyle     - fills the row (Demo output).
           SettingsTileHeaderPanelStyle - icon + title layout.
           SettingsTileIconStyle        - MDL2 glyph in tile header.
           SettingsTileTitleStyle       - big label at top of tile.
           SettingsTileCaptionStyle     - small subtitle under title.
           SettingsTileFooterHintStyle  - one-line hint below control.
           SettingsTileHeroStyle        - centred value badge for metric
                                          tiles (theme mode / version).
           SettingsGroupSeparatorStyle  - divider between tile groups.

         RULES
           - Tiles do NOT set their own Width - the WrapPanel host does.
             Hard-coding width inside the Setter would break reflow.
           - Every tile uses the same Padding (18,16) and Margin
             (0,0,14,14) so the WrapPanel gutter stays even regardless
             of tile count.
           - Only the accent-BorderBrush follows the current accent
             preset; background stays neutral so the tile grid reads as
             calm cards, not neon. Matches SectionCardStyle intent.
    ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="SettingsGroupHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize"         Value="12"/>
        <Setter Property="FontWeight"       Value="Bold"/>
        <Setter Property="Foreground"       Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Margin"           Value="0,4,0,0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="SettingsGroupCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize"         Value="12"/>
        <Setter Property="Foreground"       Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="Margin"           Value="0,4,0,14"/>
        <Setter Property="TextWrapping"     Value="Wrap"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="SettingsTileStyle" TargetType="Border">
        <Setter Property="MinWidth"            Value="320"/>
        <Setter Property="MaxWidth"            Value="380"/>
        <Setter Property="MinHeight"           Value="128"/>
        <Setter Property="Margin"              Value="0,0,14,14"/>
        <Setter Property="Padding"             Value="18,16"/>
        <Setter Property="CornerRadius"        Value="14"/>
        <Setter Property="BorderThickness"     Value="1"/>
        <Setter Property="BorderBrush"         Value="{DynamicResource OutlineBrush}"/>
        <Setter Property="Background"          Value="{DynamicResource ModuleBackgroundBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="12" ShadowDepth="1.5"
                                  Direction="270" Opacity="0.08"
                                  Color="#000000"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsWideTileStyle" TargetType="Border"
           BasedOn="{StaticResource SettingsTileStyle}">
        <Setter Property="MinWidth"  Value="660"/>
        <Setter Property="MaxWidth"  Value="780"/>
        <Setter Property="MinHeight" Value="128"/>
    </Style>

    <Style x:Key="SettingsFullRowTileStyle" TargetType="Border"
           BasedOn="{StaticResource SettingsTileStyle}">
        <Setter Property="MinWidth"  Value="660"/>
        <Setter Property="MaxWidth"  Value="1280"/>
        <Setter Property="MinHeight" Value="120"/>
    </Style>

    <Style x:Key="SettingsTileHeaderPanelStyle" TargetType="StackPanel">
        <Setter Property="Orientation"       Value="Horizontal"/>
        <Setter Property="Margin"            Value="0,0,0,6"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SettingsTileIconStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"        Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize"          Value="16"/>
        <Setter Property="Width"             Value="20"/>
        <Setter Property="TextAlignment"     Value="Center"/>
        <Setter Property="Margin"            Value="0,0,10,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground"        Value="{DynamicResource AccentBrush}"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <Style x:Key="SettingsTileTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"          Value="14"/>
        <Setter Property="FontWeight"        Value="Bold"/>
        <Setter Property="Foreground"        Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <Style x:Key="SettingsTileCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize"         Value="11"/>
        <Setter Property="Foreground"       Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="Margin"           Value="0,0,0,12"/>
        <Setter Property="LineHeight"       Value="16"/>
        <Setter Property="TextWrapping"     Value="Wrap"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="SettingsTileFooterHintStyle" TargetType="TextBlock">
        <Setter Property="FontSize"         Value="11"/>
        <Setter Property="Foreground"       Value="{DynamicResource MutedForegroundBrush}"/>
        <Setter Property="Margin"           Value="0,10,0,0"/>
        <Setter Property="LineHeight"       Value="15"/>
        <Setter Property="TextWrapping"     Value="Wrap"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="SettingsTileHeroStyle" TargetType="TextBlock">
        <Setter Property="FontSize"            Value="22"/>
        <Setter Property="FontWeight"          Value="Bold"/>
        <Setter Property="Foreground"          Value="{DynamicResource AccentBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin"              Value="0,4,0,0"/>
        <Setter Property="IsHitTestVisible"    Value="False"/>
    </Style>

    <Style x:Key="SettingsGroupSeparatorStyle" TargetType="Border">
        <Setter Property="Height"     Value="1"/>
        <Setter Property="Margin"     Value="0,6,0,18"/>
        <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         MODERN SLIDER — iPhone-style pill slider: a tall rounded pill
         track with an accent-coloured fill that shows the current level,
         and a round accent thumb. Replaces the default OS slider look for
         settings controls (border thickness, wallpaper visibility, etc.).
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="ModernSliderTrackRepeatStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{DynamicResource MenuHoverBrush}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernSliderFillRepeatStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{DynamicResource AccentBrush}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernSliderThumbStyle" TargetType="Thumb">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Ellipse Width="24" Height="24"
                                 Fill="{DynamicResource AccentBrush}"
                                 Opacity="0.20"/>
                        <Ellipse Width="16" Height="16"
                                 Fill="{DynamicResource AccentBrush}">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6"
                                                  ShadowDepth="1"
                                                  Opacity="0.25"
                                                  Color="#000000"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fill-bar slider (reference look): a tall rounded bar with an
         accent-coloured fill showing the current level and a centered value
         label ("62%" for opacity sliders, "1.5" for border thickness). The
         thumb is subtle; the whole bar is the slider. -->
    <Style x:Key="ModernSliderStyle" TargetType="Slider">
        <Setter Property="Height" Value="40"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <!-- Base rounded bar -->
                        <Border Height="40" CornerRadius="{DynamicResource CardCornerRadius}"
                                Background="{DynamicResource MenuHoverBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True"/>
                        <!-- Accent fill (Decrease portion) + track -->
                        <Track x:Name="PART_Track"
                               Height="40">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ModernSliderFillRepeatStyle}"
                                              Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ModernSliderTrackRepeatStyle}"
                                              Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ModernSliderThumbStyle}"/>
                            </Track.Thumb>
                        </Track>
                        <!-- Centered value label -->
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="White"
                                   IsHitTestVisible="False">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource SliderValueLabelConverter}">
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
