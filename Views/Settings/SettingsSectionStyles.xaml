<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/SettingsSectionStyles.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — shared resource dictionary

     Single source of truth for every Settings section UserControl and
     the Settings shell. Merged by:
       • SettingsView.xaml (shell — nav rail + section hosts)
       • Sections/Settings{Appearance,Ai,Voice,Updates,Data,About}Section.xaml

     CONTENT
       1. Frozen brushes (local constants)
       2. Cards (SectionCard, InfoCard)
       3. Typography (labels, rows, hints, values)
       4. Controls (toggle switch, password box, accent chips,
          provider SELECT button, download progress bar,
          Whisper model option card base)
       5. Shell (navigation rail item style)

     RULES
       • Buttons come from global Styles/ButtonStyles.xaml
         (PrimaryPillButton / OutlinedPillButton / SuccessPillButton /
          DangerButton / RowOutlinedButton …). No local button styles.
       • Icons: Segoe MDL2 Assets glyphs only — never emoji.
═══════════════════════════════════════════════════════════════════════ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- ═══════════════════════════════════════════════════════════════
         1. FROZEN BRUSHES (local constants)
    ═══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="PillBorderLightBrush" Color="#93C5FD" po:Freeze="True"/>
    <SolidColorBrush x:Key="ProviderDotBlue"      Color="#4285F4" po:Freeze="True"/>
    <SolidColorBrush x:Key="ProviderDotAmber"     Color="#F59E0B" po:Freeze="True"/>
    <SolidColorBrush x:Key="ProviderDotViolet"    Color="#8B5CF6" po:Freeze="True"/>

    <!-- ═══════════════════════════════════════════════════════════════
         2. CARDS
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="SectionCardStyle" TargetType="Border">
        <Setter Property="Background"          Value="{DynamicResource ModuleBackgroundBrush}"/>
        <Setter Property="BorderBrush"         Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness"     Value="1.5"/>
        <Setter Property="CornerRadius"        Value="14"/>
        <Setter Property="Padding"             Value="24,20"/>
        <Setter Property="Margin"              Value="0,0,0,20"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
    </Style>

    <Style x:Key="InfoCardStyle" TargetType="Border">
        <Setter Property="Background"          Value="{DynamicResource TintIndigoBrush}"/>
        <Setter Property="BorderBrush"         Value="{StaticResource PillBorderLightBrush}"/>
        <Setter Property="BorderThickness"     Value="1.5"/>
        <Setter Property="CornerRadius"        Value="16"/>
        <Setter Property="Padding"             Value="22,18"/>
        <Setter Property="Margin"              Value="0,0,0,18"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
    </Style>

    <!-- Base setters for the AI provider cards. Each card extends this
         with BasedOn + its own IsXxxActive DataTrigger. -->
    <Style x:Key="ProviderCardBaseStyle" TargetType="Border">
        <Setter Property="CornerRadius"        Value="14"/>
        <Setter Property="Padding"             Value="16,14"/>
        <Setter Property="Margin"              Value="0,0,0,12"/>
        <Setter Property="BorderThickness"     Value="1.5"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
        <Setter Property="BorderBrush"         Value="{StaticResource PillBorderLightBrush}"/>
        <Setter Property="Background"          Value="{DynamicResource ModuleBackgroundBrush}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         3. TYPOGRAPHY
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="InfoCardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"          Value="14"/>
        <Setter Property="FontWeight"        Value="Bold"/>
        <Setter Property="Foreground"        Value="{DynamicResource AccentBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <Style x:Key="InfoCardBodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize"         Value="12"/>
        <Setter Property="LineHeight"       Value="20"/>
        <Setter Property="Foreground"       Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="TextWrapping"     Value="Wrap"/>
        <Setter Property="Margin"           Value="0,10,0,0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="InfoCardBulletStyle" TargetType="TextBlock">
        <Setter Property="FontSize"         Value="12"/>
        <Setter Property="LineHeight"       Value="19"/>
        <Setter Property="Foreground"       Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="TextWrapping"     Value="Wrap"/>
        <Setter Property="Margin"           Value="0,6,0,0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize"         Value="11"/>
        <Setter Property="FontWeight"       Value="Bold"/>
        <Setter Property="Foreground"       Value="{DynamicResource MutedForegroundBrush}"/>
        <Setter Property="Margin"           Value="0,0,0,10"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="RowTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"          Value="14"/>
        <Setter Property="FontWeight"        Value="Bold"/>
        <Setter Property="Foreground"        Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="HintTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize"         Value="11"/>
        <Setter Property="Foreground"       Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="TextWrapping"     Value="Wrap"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="LabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize"         Value="10"/>
        <Setter Property="FontWeight"       Value="Bold"/>
        <Setter Property="Foreground"       Value="{DynamicResource MutedForegroundBrush}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="ValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
    </Style>

    <!-- Page header used at the top of every section. -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"         Value="24"/>
        <Setter Property="FontWeight"       Value="Bold"/>
        <Setter Property="Foreground"       Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize"         Value="12"/>
        <Setter Property="Margin"           Value="0,4,0,0"/>
        <Setter Property="Foreground"       Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         4. CONTROLS
    ═══════════════════════════════════════════════════════════════ -->

    <!-- iOS-style animated toggle switch. -->
    <Style x:Key="ModernToggleSwitch" TargetType="ToggleButton">
        <Setter Property="Width"               Value="56"/>
        <Setter Property="Height"              Value="28"/>
        <Setter Property="Cursor"              Value="Hand"/>
        <Setter Property="BorderThickness"     Value="0"/>
        <Setter Property="Background"          Value="#CBD5E1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Track"
                                CornerRadius="14"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True"/>
                        <TextBlock x:Name="OffLabel" Text="OFF"
                                   FontSize="9" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,9,0"
                                   IsHitTestVisible="False"/>
                        <TextBlock x:Name="OnLabel" Text="ON"
                                   FontSize="9" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="9,0,0,0"
                                   Opacity="0"
                                   IsHitTestVisible="False"/>
                        <Ellipse x:Name="Thumb"
                                 Width="22" Height="22" Fill="White"
                                 HorizontalAlignment="Left"
                                 Margin="3,0,0,0"
                                 SnapsToDevicePixels="True">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="ThumbTransform" X="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ThumbTransform"
                                            Storyboard.TargetProperty="X"
                                            To="28" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="OffLabel"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0" Duration="0:0:0.15"/>
                                        <DoubleAnimation
                                            Storyboard.TargetName="OnLabel"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1" Duration="0:0:0.15"/>
                                        <ColorAnimation
                                            Storyboard.TargetName="Track"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#1D4ED8" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ThumbTransform"
                                            Storyboard.TargetProperty="X"
                                            To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="OffLabel"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1" Duration="0:0:0.15"/>
                                        <DoubleAnimation
                                            Storyboard.TargetName="OnLabel"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0" Duration="0:0:0.15"/>
                                        <ColorAnimation
                                            Storyboard.TargetName="Track"
                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                            To="#CBD5E1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rounded password box (API keys). -->
    <Style x:Key="RoundedPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Height"                   Value="42"/>
        <Setter Property="FontSize"                 Value="13"/>
        <Setter Property="Padding"                  Value="14,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background"               Value="{DynamicResource ModuleBackgroundBrush}"/>
        <Setter Property="Foreground"               Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="BorderThickness"          Value="1.5"/>
        <Setter Property="BorderBrush"              Value="{StaticResource PillBorderLightBrush}"/>
        <Setter Property="SnapsToDevicePixels"      Value="True"/>
        <Setter Property="UseLayoutRounding"        Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Root" Property="BorderThickness"
                                    Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent preset chip — migrated to the standardized design
         system (H34 pill, hover/pressed/focus/disabled triggers).
         Content is a swatch dot + label defined inline per chip. -->
    <Style x:Key="AccentChipStyle" TargetType="Button">
        <Setter Property="Cursor"              Value="Hand"/>
        <Setter Property="Height"              Value="34"/>
        <Setter Property="Padding"             Value="12,0"/>
        <Setter Property="Margin"              Value="0,0,8,8"/>
        <Setter Property="FontSize"            Value="12"/>
        <Setter Property="FontWeight"          Value="SemiBold"/>
        <Setter Property="Foreground"          Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{DynamicResource MenuHoverBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="17"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="bd" Property="BorderThickness"
                                    Value="1.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SELECT pill inside provider cards. Extends to ACTIVE state via
         per-provider DataTrigger (BasedOn in the card). -->
    <Style x:Key="ProviderSelectButtonStyle" TargetType="Button">
        <Setter Property="Content"             Value="SELECT"/>
        <Setter Property="Foreground"          Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Height"              Value="28"/>
        <Setter Property="Padding"             Value="12,0"/>
        <Setter Property="FontSize"            Value="10"/>
        <Setter Property="FontWeight"          Value="Bold"/>
        <Setter Property="BorderThickness"     Value="0"/>
        <Setter Property="Cursor"              Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="14"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1.5"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Whisper model download progress bar. -->
    <Style x:Key="DownloadProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height"              Value="8"/>
        <Setter Property="Maximum"             Value="100"/>
        <Setter Property="Foreground"          Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background"          Value="{DynamicResource MenuHoverBrush}"/>
        <Setter Property="BorderThickness"     Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <Border x:Name="PART_Indicator"
                                CornerRadius="4"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Base style for Whisper model option cards. Used exclusively via
         BasedOn inside Border.Style child elements — never as a Style=
         attribute (XLS0501 prevention). -->
    <Style x:Key="ModelOptionCardStyle" TargetType="Border">
        <Setter Property="CornerRadius"        Value="10"/>
        <Setter Property="Padding"             Value="12,10"/>
        <Setter Property="Margin"              Value="0,0,0,8"/>
        <Setter Property="BorderThickness"     Value="1.5"/>
        <Setter Property="Cursor"              Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
        <Setter Property="BorderBrush"         Value="{StaticResource PillBorderLightBrush}"/>
        <Setter Property="Background"          Value="{DynamicResource ModuleBackgroundBrush}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         5. SHELL — NAVIGATION RAIL
    ═══════════════════════════════════════════════════════════════ -->

    <!-- One navigation entry in the left rail. Active state is driven by
         the Button's Tag: the per-item Style sets Tag="Active" from a
         DataTrigger on its Is{Page}Page VM property; the template then
         lights the tinted background + accent bar (ControlTemplate
         triggers are the ONLY place TargetName is legal). -->
    <Style x:Key="SettingsNavButtonStyle" TargetType="Button">
        <Setter Property="Cursor"              Value="Hand"/>
        <Setter Property="Margin"              Value="10,2"/>
        <Setter Property="Tag"                 Value="Inactive"/>
        <Setter Property="Background"          Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd"
                                CornerRadius="10"
                                Padding="12,10"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="ActiveBar"
                                Width="3.5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Height="22"
                                Margin="2,0,0,0"
                                CornerRadius="2"
                                Background="{DynamicResource AccentBrush}"
                                Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource MenuHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource TintIndigoBrush}"/>
                            <Setter TargetName="ActiveBar" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon slot in a nav item (Segoe MDL2 Assets glyph). -->
    <Style x:Key="NavGlyphStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"        Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize"          Value="15"/>
        <Setter Property="Width"             Value="22"/>
        <Setter Property="TextAlignment"     Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground"        Value="{DynamicResource SecondaryForegroundBrush}"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <!-- Label slot in a nav item. -->
    <Style x:Key="NavLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize"          Value="12.5"/>
        <Setter Property="FontWeight"        Value="SemiBold"/>
        <Setter Property="Margin"            Value="10,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground"        Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <!-- Circular glyph badge for info cards. -->
    <Style x:Key="InfoGlyphBadgeStyle" TargetType="Border">
        <Setter Property="Width"               Value="34"/>
        <Setter Property="Height"              Value="34"/>
        <Setter Property="CornerRadius"        Value="17"/>
        <Setter Property="Background"          Value="{DynamicResource TintBlueBrush}"/>
        <Setter Property="Margin"              Value="0,0,12,0"/>
        <Setter Property="VerticalAlignment"   Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
    </Style>

    <Style x:Key="InfoGlyphTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"             Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize"               Value="15"/>
        <Setter Property="Foreground"             Value="{DynamicResource AccentBrush}"/>
        <Setter Property="HorizontalAlignment"    Value="Center"/>
        <Setter Property="VerticalAlignment"      Value="Center"/>
        <Setter Property="IsHitTestVisible"       Value="False"/>
    </Style>

</ResourceDictionary>
