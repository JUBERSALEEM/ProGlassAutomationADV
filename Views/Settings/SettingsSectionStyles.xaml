    <!-- One navigation entry in the left rail. Active state is driven by
         the Button's Tag: the per-item Style sets Tag="Active" from a
         DataTrigger on its Is{Page}Page VM property; the template then
         lights the tinted background + accent bar (ControlTemplate
         triggers are the ONLY place TargetName is legal). -->
    <!-- Phase 3 (2026-09-05): keyboard focus cue for the nav rail —
         an adorner ring supplied through FocusVisualStyle, so the shared
         button style needs no template surgery. Bound nav buttons get a
         visible accent ring on Tab focus (full keyboard traversal). -->
    <Style x:Key="SettingsNavFocusStyle" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border Margin="-3"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="{DynamicResource Border.StrongThickness}"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         RAIL NAV ROW — senior spacing pass 2026-09-16 (owner: "menu too
         close"). 40 px rows on a 6 px vertical rhythm, 8 px side inset,
         grouped rail with caption headers. Active page = solid accent
         pill with on-accent ink (the old 3.5 px side bar is retired);
         hover = soft tertiary surface, no border noise. Motion keeps the
         shared BounceHover curve so the rail matches every opted-in card.
         ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="SettingsNavButtonStyle" TargetType="Button">
        <Setter Property="Cursor"              Value="Hand"/>
        <Setter Property="behaviors:BounceHover.IsEnabled"  Value="True"/>
        <Setter Property="behaviors:BounceHover.HoverScale" Value="1.02"/>
        <Setter Property="behaviors:BounceHover.PressScale" Value="0.97"/>
        <Setter Property="Margin"              Value="8,3"/>
        <Setter Property="Tag"                 Value="Inactive"/>
        <Setter Property="Background"          Value="Transparent"/>
        <Setter Property="Foreground"          Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="12,10"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource SurfaceTertiaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource TintIndigoBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource OnAccentForegroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Group caption between rail clusters ("System", "Studio", ...).
         Collapses itself when a row group carries no caption so ungrouped
         pages keep the flat rhythm. -->
    <Style x:Key="SettingsNavGroupHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="{DynamicResource FontSize.Caption}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="Margin"     Value="18,16,18,6"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Name, TargetNullValue=''}" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

