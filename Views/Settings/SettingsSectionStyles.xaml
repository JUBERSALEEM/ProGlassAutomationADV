<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/SettingsSectionStyles.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — shared resource dictionary

     Single source of truth for every Settings section UserControl and
     the Settings shell. Merged by:
       • SettingsView.xaml (shell — nav rail + section hosts)
       • Sections/Settings{Appearance,Ai,Voice,Updates,Data,About}Section.xaml

     CONTENT
       1. Frozen brushes (local constants)
       2. Cards (SectionCard, InfoCard)
       3. Typography (labels, rows, hints, values)
       4. Controls (toggle switch, password box, accent chips,
          provider SELECT button, download progress bar,
          Whisper model option card base)
       5. Shell (navigation rail item style)

     RULES
       • Buttons come from global Styles/ButtonStyles.xaml
         (PrimaryPillButton / OutlinedPillButton / SuccessPillButton /
          DangerButton / RowOutlinedButton …). No local button styles.
       • Icons: Segoe MDL2 Assets glyphs only — never emoji.
═══════════════════════════════════════════════════════════════════════ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- ═══════════════════════════════════════════════════════════════
         1. FROZEN BRUSHES (local constants)
    ═══════════════════════════════════════════════════════════════ -->
    
    <SolidColorBrush x:Key="ProviderDotBlue"      Color="#4285F4" po:Freeze="True"/>
    <SolidColorBrush x:Key="ProviderDotAmber"     Color="{DynamicResource WarningColor}"/>
    <SolidColorBrush x:Key="ProviderDotViolet"    Color="#8B5CF6" po:Freeze="True"/>

    <!-- ═══════════════════════════════════════════════════════════════
         2. CARDS
    ═══════════════════════════════════════════════════════════════ -->
    <!-- The accent border is INTENTIONAL and original. It is what gives every
         Settings section card its visible coloured edge, and it follows the
         chosen accent preset (Glass Blue / Emerald / Amber / Rose / Violet /
         Teal) because ThemeManager.ApplyAccent rewrites AccentBrush.
         A previous edit swapped this for the neutral OutlineBrush, which
         erased the coloured card edges the user relies on - do not repeat
         that. Neutral hairlines belong on plain surfaces, not on these. -->
    <Style x:Key="SectionCardStyle" TargetType="Border">
        <Setter Property="Background"          Value="{DynamicResource GlassSurfaceBrush}"/>
        <Setter Property="BorderBrush"         Value="{DynamicResource GlassBorderSoft}"/>
        <Setter Property="BorderThickness"     Value="1.5"/>
        <Setter Property="CornerRadius"        Value="14"/>
        <Setter Property="Padding"             Value="24,20"/>
        <Setter Property="Margin"              Value="0,0,0,20"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
    </Style>

    

    <!-- Base setters for the AI provider cards. Each card extends this
         with BasedOn + its own IsXxxActive DataTrigger. -->
    <Style x:Key="ProviderCardBaseStyle" TargetType="Border">
        <Setter Property="CornerRadius"        Value="14"/>
        <Setter Property="Padding"             Value="16,14"/>
        <Setter Property="Margin"              Value="0,0,0,12"/>
        <Setter Property="BorderThickness"     Value="1.5"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
        <Setter Property="BorderBrush"         Value="{DynamicResource GlassBorderSoft}"/>
        <Setter Property="Background"          Value="{DynamicResource GlassSurfaceBrush}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         3. TYPOGRAPHY
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="InfoCardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextSection}"/>
        <Setter Property="FontWeight"        Value="Bold"/>
        <!-- 2026-09-01: was GlassBorderSoft (a BORDER token — white at
             18-40% alpha) so every info-card heading rendered nearly
             invisible. TextPrimaryBrush is the real ink token. -->
        <Setter Property="Foreground"        Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    

    

    <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight"       Value="Bold"/>
        <Setter Property="Foreground"       Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Margin"           Value="0,0,0,10"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="RowTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextSection}"/>
        <Setter Property="FontWeight"        Value="Bold"/>
        <Setter Property="Foreground"        Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="HintTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="Foreground"       Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping"     Value="Wrap"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="LabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
        <Setter Property="FontWeight"       Value="Bold"/>
        <Setter Property="Foreground"       Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="ValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- Page header used at the top of every section. -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextDisplay}"/>
        <Setter Property="FontWeight"       Value="Bold"/>
        <Setter Property="Foreground"       Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="Margin"           Value="0,4,0,0"/>
        <Setter Property="Foreground"       Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <!-- LAYOUT FIX: was missing, unlike HintTextStyle. Without it a
             long subtitle (the AI & Agent page has the longest in the app
             at 71 chars) renders as one unbroken line, widening the header
             row and pushing content past the right edge on narrow windows. -->
        <Setter Property="TextWrapping"     Value="Wrap"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         4. CONTROLS
    ═══════════════════════════════════════════════════════════════ -->

    <!-- iOS-style animated toggle switch — uses the canonical Liquid
         Glass switch template with proper dimensions for the thumb
         track, spring animation, and layered glass composition. -->
    <Style x:Key="ModernToggleSwitch" TargetType="ToggleButton"
           BasedOn="{StaticResource LiquidGlassToggleSwitch}">
        <Setter Property="Width"  Value="62"/>
        <Setter Property="Height" Value="36"/>
    </Style>

    <!-- Rounded password box (API keys). -->
    <Style x:Key="RoundedPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Height"                   Value="42"/>
        <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
        <Setter Property="Padding"                  Value="14,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background"               Value="{DynamicResource GlassSurfaceBrush}"/>
        <Setter Property="Foreground"               Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness"          Value="1.5"/>
        <Setter Property="BorderBrush"              Value="{DynamicResource GlassBorderSoft}"/>
        <Setter Property="SnapsToDevicePixels"      Value="True"/>
        <Setter Property="UseLayoutRounding"        Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{DynamicResource GlassBorderSoft}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{DynamicResource GlassBorderSoft}"/>
                            <Setter TargetName="Root" Property="BorderThickness"
                                    Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent preset chip — migrated to the standardized design
         system (H34 pill, hover/pressed/focus/disabled triggers).
         Content is a swatch dot + label defined inline per chip. -->
    <Style x:Key="AccentChipStyle" TargetType="Button">
        <Setter Property="Cursor"              Value="Hand"/>
        <Setter Property="Height"              Value="34"/>
        <Setter Property="Padding"             Value="12,0"/>
        <Setter Property="Margin"              Value="0,0,8,8"/>
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight"          Value="SemiBold"/>
        <Setter Property="Foreground"          Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{DynamicResource MenuHoverBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="{DynamicResource CardBorderThickness}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush"
                                    Value="{DynamicResource GlassBorderSoft}"/>
                            <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush"
                                    Value="{DynamicResource GlassBorderSoft}"/>
                            <Setter TargetName="bd" Property="BorderThickness"
                                    Value="1.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SELECT pill inside provider cards. Extends to ACTIVE state via
         per-provider DataTrigger (BasedOn in the card). -->
    <Style x:Key="ProviderSelectButtonStyle" TargetType="Button">
        <Setter Property="Content"             Value="SELECT"/>
        <!-- 2026-09-01: was GlassBorderSoft → SELECT label was white-
             on-white. Now the real accent ink so the button reads. -->
        <Setter Property="Foreground"          Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Height"              Value="28"/>
        <Setter Property="Padding"             Value="12,0"/>
        <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
        <Setter Property="FontWeight"          Value="Bold"/>
        <Setter Property="BorderThickness"     Value="0"/>
        <Setter Property="Cursor"              Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="{DynamicResource CardBorderThickness}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Whisper model download progress bar. -->
    <Style x:Key="DownloadProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height"              Value="8"/>
        <Setter Property="Maximum"             Value="100"/>
        <!-- 2026-09-01: was GlassBorderSoft (white 18% alpha) → the
             download fill was invisible. Accent is the progress colour. -->
        <Setter Property="Foreground"          Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background"          Value="{DynamicResource GlassSurfaceElevated}"/>
        <Setter Property="BorderThickness"     Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <Border x:Name="PART_Indicator"
                                CornerRadius="4"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Base style for Whisper model option cards. Used exclusively via
         BasedOn inside Border.Style child elements — never as a Style=
         attribute (XLS0501 prevention). -->
    <Style x:Key="ModelOptionCardStyle" TargetType="Border">
        <Setter Property="CornerRadius"        Value="10"/>
        <Setter Property="Padding"             Value="12,10"/>
        <Setter Property="Margin"              Value="0,0,0,8"/>
        <Setter Property="BorderThickness"     Value="1.5"/>
        <Setter Property="Cursor"              Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
        <Setter Property="BorderBrush"         Value="{DynamicResource GlassBorderSoft}"/>
        <Setter Property="Background"          Value="{DynamicResource GlassSurfaceBrush}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         5. SHELL — NAVIGATION RAIL
    ═══════════════════════════════════════════════════════════════ -->

    <!-- One navigation entry in the left rail. Active state is driven by
         the Button's Tag: the per-item Style sets Tag="Active" from a
         DataTrigger on its Is{Page}Page VM property; the template then
         lights the tinted background + accent bar (ControlTemplate
         triggers are the ONLY place TargetName is legal). -->
    <Style x:Key="SettingsNavButtonStyle" TargetType="Button">
        <Setter Property="Cursor"              Value="Hand"/>
        <!-- The springy hover that inspired the app-wide treatment. Now
             driven by the shared behavior so the rail and every opted-in
             card use exactly the same motion curve. -->
        <Setter Property="behaviors:BounceHover.IsEnabled"  Value="True"/>
        <Setter Property="behaviors:BounceHover.HoverScale" Value="1.035"/>
        <Setter Property="behaviors:BounceHover.PressScale" Value="0.97"/>
        <Setter Property="Margin"              Value="10,2"/>
        <Setter Property="Tag"                 Value="Inactive"/>
        <Setter Property="Background"          Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="12,10"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="ActiveBar"
                                Width="3.5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Height="22"
                                Margin="2,0,0,0"
                                CornerRadius="2"
                                Background="{DynamicResource AccentBrush}"
                                Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource GlassSurfaceElevated}"/>
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource GlassBorderGradientSoft}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource TintIndigoBrush}"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.95"/>
                            <Setter TargetName="ActiveBar" Property="Opacity" Value="0.55"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <!-- 2026-09-01 touch pass: the active pill used
                                 GlassSurfaceUltra (~5% alpha) — invisible on
                                 the frosted rail. Now the real material ramp
                                 so the current page clearly reads as
                                 pressed glass, plus the accent bar. -->
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource GlassSurfaceBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource GlassBorderGradientCrystal}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="ActiveBar" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon slot in a nav item (Segoe MDL2 Assets glyph).
         2026-09-01 touch pass: the glyph also lights up accent when its
         parent nav button is Tag=Active (set by the per-page DataTrigger
         in SettingsView), so the current page reads at a glance. -->
    <Style x:Key="NavGlyphStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"        Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="{StaticResource TextSubhead}"/>
        <Setter Property="Width"             Value="22"/>
        <Setter Property="TextAlignment"     Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground"        Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                         Value="Active">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Label slot in a nav item. -->
    <Style x:Key="NavLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
        <Setter Property="FontWeight"        Value="SemiBold"/>
        <Setter Property="Margin"            Value="10,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground"        Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                         Value="Active">
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Circular glyph badge for info cards. -->
    <Style x:Key="InfoGlyphBadgeStyle" TargetType="Border">
        <Setter Property="Width"               Value="34"/>
        <Setter Property="Height"              Value="34"/>
        <Setter Property="CornerRadius"        Value="17"/>
        <Setter Property="Background"          Value="{DynamicResource TintBlueBrush}"/>
        <Setter Property="Margin"              Value="0,0,12,0"/>
        <Setter Property="VerticalAlignment"   Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
    </Style>

    <Style x:Key="InfoGlyphTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"             Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="{StaticResource TextSubhead}"/>
        <!-- 2026-09-01: was GlassBorderSoft → glyph invisible on the
             tinted badge. Text ink token instead. -->
        <Setter Property="Foreground"             Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalAlignment"    Value="Center"/>
        <Setter Property="VerticalAlignment"      Value="Center"/>
        <Setter Property="IsHitTestVisible"       Value="False"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         6. TILE-GRID DESIGN SYSTEM (Settings redesign — Aug 2026)

         The pre-2026 Settings layout stacked every option as a full-width
         DockPanel row inside one giant SectionCardStyle. On wide monitors
         that wasted 60-70% of horizontal space; on a 1366-pixel laptop
         the vertical stack felt endless and crowded. The user asked for
         a stylish, professional card layout.

         WHAT THIS DESIGN SYSTEM IS
         Each individual setting becomes its own self-contained "tile" -
         a rounded bordered card that displays icon + title + subtitle +
         control in a fixed footprint. Tiles are dropped into a WrapPanel
         so they auto-flow into 1/2/3/4 columns depending on window
         width. Wide-content tiles (wallpaper picker, backup list,
         provider matrix) span two column widths; a Full-row variant
         forces a break for the very largest surfaces.

         RESOURCE INDEX
           SettingsGroupHeaderTextStyle - group heading ("APPEARANCE").
           SettingsGroupCaptionStyle    - one-line description under it.
           SettingsTileStyle            - standard 320-wide setting tile.
           SettingsWideTileStyle        - 660-wide (spans two columns).
           SettingsFullRowTileStyle     - fills the row (Demo output).
           SettingsTileHeaderPanelStyle - icon + title layout.
           SettingsTileIconStyle        - MDL2 glyph in tile header.
           SettingsTileTitleStyle       - big label at top of tile.
           SettingsTileCaptionStyle     - small subtitle under title.
           SettingsTileFooterHintStyle  - one-line hint below control.
           SettingsTileHeroStyle        - centred value badge for metric
                                          tiles (theme mode / version).
           SettingsGroupSeparatorStyle  - divider between tile groups.

         RULES
           - Tiles do NOT set their own Width - the WrapPanel host does.
             Hard-coding width inside the Setter would break reflow.
           - Every tile uses the same Padding (18,16) and Margin
             (0,0,14,14) so the WrapPanel gutter stays even regardless
             of tile count.
           - Only the accent-BorderBrush follows the current accent
             preset; background stays neutral so the tile grid reads as
             calm cards, not neon. Matches SectionCardStyle intent.
    ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="SettingsGroupHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight"       Value="Bold"/>
        <!-- 2026-09-01: was GlassBorderSoft → group headings rendered
             white-on-white. Real ink token now. -->
        <Setter Property="Foreground"       Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Margin"           Value="0,4,0,0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="SettingsGroupCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="Foreground"       Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Margin"           Value="0,4,0,14"/>
        <Setter Property="TextWrapping"     Value="Wrap"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="SettingsTileStyle" TargetType="Border">
        <Setter Property="MinWidth"            Value="0"/>
        <Setter Property="MinHeight"           Value="128"/>
        <Setter Property="Margin"              Value="0,0,14,14"/>
        <Setter Property="Padding"             Value="18,16"/>
        <Setter Property="CornerRadius"        Value="14"/>
        <Setter Property="BorderThickness"     Value="1"/>
        <Setter Property="BorderBrush"         Value="{DynamicResource GlassBorderSoft}"/>
        <Setter Property="Background"          Value="{DynamicResource GlassSurfaceBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding"   Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="12" ShadowDepth="1.5"
                                  Direction="270" Opacity="0.08"
                                  Color="#000000"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsWideTileStyle" TargetType="Border"
           BasedOn="{StaticResource SettingsTileStyle}">
        <Setter Property="MinHeight" Value="128"/>
    </Style>

    <Style x:Key="SettingsFullRowTileStyle" TargetType="Border"
           BasedOn="{StaticResource SettingsTileStyle}">
        <Setter Property="MinHeight" Value="120"/>
    </Style>

    <Style x:Key="SettingsTileHeaderPanelStyle" TargetType="StackPanel">
        <Setter Property="Orientation"       Value="Horizontal"/>
        <Setter Property="Margin"            Value="0,0,0,6"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SettingsTileIconStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"        Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="{StaticResource TextTitle}"/>
        <Setter Property="Width"             Value="20"/>
        <Setter Property="TextAlignment"     Value="Center"/>
        <Setter Property="Margin"            Value="0,0,10,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <!-- 2026-09-01: was GlassBorderSoft → tile icons were white-on-
             white. Real ink token now. -->
        <Setter Property="Foreground"        Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <Style x:Key="SettingsTileTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextSection}"/>
        <Setter Property="FontWeight"        Value="Bold"/>
        <Setter Property="Foreground"        Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible"  Value="False"/>
    </Style>

    <Style x:Key="SettingsTileCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="Foreground"       Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Margin"           Value="0,0,0,12"/>
        <Setter Property="LineHeight"       Value="16"/>
        <Setter Property="TextWrapping"     Value="Wrap"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="SettingsTileFooterHintStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="Foreground"       Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Margin"           Value="0,10,0,0"/>
        <Setter Property="LineHeight"       Value="15"/>
        <Setter Property="TextWrapping"     Value="Wrap"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="SettingsTileHeroStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TextHeadline}"/>
        <Setter Property="FontWeight"          Value="Bold"/>
        <!-- 2026-09-01: was GlassBorderSoft → hero values (theme mode,
             version) were white-on-white. Real ink token now. -->
        <Setter Property="Foreground"          Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin"              Value="0,4,0,0"/>
        <Setter Property="IsHitTestVisible"    Value="False"/>
    </Style>

    <Style x:Key="SettingsGroupSeparatorStyle" TargetType="Border">
        <Setter Property="Height"     Value="1"/>
        <Setter Property="Margin"     Value="0,6,0,18"/>
        <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
    </Style>

    <!-- Full-width action row — an even row of buttons that STRETCH so they
         span the whole card. Each Button in the UniformGrid gets an equal
         share of the width (set Columns per row). This fixes the "buttons
         left-aligned leaving a big empty gap on the right" complaint. -->
    <Style x:Key="SettingsActionRowStyle" TargetType="UniformGrid">
        <Setter Property="Rows"    Value="1"/>
        <Setter Property="Margin"  Value="0,10,0,0"/>
    </Style>

    <!-- A single button used inside SettingsActionRowStyle: stretch to fill
         its cell so the grouped buttons never appear left-cramped. -->
    <!-- Modern full-width action button. All settings action buttons use
         this so they share one polished shape: 12px rounded (follows the
         dynamic CardCornerRadius token), a tinted fill, a subtle outline,
         and clear hover / pressed / focus states. It stretches to fill the
         UniformGrid cell so a button group never leaves a right-hand gap. -->
    <Style x:Key="SettingsActionButtonStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="MinHeight" Value="{DynamicResource DensityButtonHeight}"/>
        <Setter Property="MinWidth" Value="{DynamicResource DensityButtonMinWidth}"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{DynamicResource MenuHoverBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="{DynamicResource CardBorderThickness}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            MinHeight="{TemplateBinding MinHeight}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource GlassSurfaceUltra}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource GlassBorderSoft}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource GlassBorderSoft}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource GlassBorderSoft}"/>
                            <Setter TargetName="Bg" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         MODERN SLIDER — iPhone-style pill slider: a tall rounded pill
         track with an accent-coloured fill that shows the current level,
         and a round accent thumb. Replaces the default OS slider look for
         settings controls (border thickness, wallpaper visibility, etc.).
    ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="ModernSliderTrackRepeatStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{DynamicResource MenuHoverBrush}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernSliderFillRepeatStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{DynamicResource AccentBrush}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernSliderThumbStyle" TargetType="Thumb">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Ellipse Width="24" Height="24"
                                 Fill="{DynamicResource AccentBrush}"
                                 Opacity="0.20"/>
                        <Ellipse Width="16" Height="16"
                                 Fill="{DynamicResource AccentBrush}">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6"
                                                  ShadowDepth="1"
                                                  Opacity="0.25"
                                                  Color="#000000"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fill-bar slider (reference look): a tall rounded bar with an
         accent-coloured fill showing the current level and a centered value
         label ("62%" for opacity sliders, "1.5" for border thickness). The
         thumb is subtle; the whole bar is the slider. -->
    <Style x:Key="ModernSliderStyle" TargetType="Slider">
        <Setter Property="Height" Value="40"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <!-- Base rounded bar -->
                        <Border Height="40" CornerRadius="{DynamicResource CardCornerRadius}"
                                Background="{DynamicResource MenuHoverBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True"/>
                        <!-- Accent fill (Decrease portion) + track -->
                        <Track x:Name="PART_Track"
                               Height="40">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ModernSliderFillRepeatStyle}"
                                              Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ModernSliderTrackRepeatStyle}"
                                              Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ModernSliderThumbStyle}"/>
                            </Track.Thumb>
                        </Track>
                        <!-- Centered value label -->
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource TextSubhead}" FontWeight="SemiBold"
                                   Foreground="White"
                                   IsHitTestVisible="False">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource SliderValueLabelConverter}">
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
