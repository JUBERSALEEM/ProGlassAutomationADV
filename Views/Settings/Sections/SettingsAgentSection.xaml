<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsAgentSection.xaml
     PROJECT: ProGlassAutomation — ProGlass Agent (PHASE F)
     MODULE: Settings — AI & AGENT page (tile-grid redesign Aug 2026)

     REDESIGN
       Was: four full-width cards stacked vertically (Privacy,
       Provider Credentials, Taught Phrases, Memory & Knowledge).
       The Privacy card alone held two full-width toggle rows plus two
       stacked info cards — on a wide monitor most of the row was
       empty.

       Now: privacy toggles become two compact 320-wide tiles side by
       side; the two explanatory info cards collapse into full-row
       tiles beneath; credentials / taught phrases / memory keep
       their wide surfaces. All bindings preserved, including the
       code-behind contract (AgentRoot DataContext handoff,
       AgentKeyBox PasswordBox, StoreKey_Click handler).

     DataContext is an AgentSettingsViewModel, created by the
     code-behind so the agent subsystem owns its own state and the
     existing SettingsViewModel is not modified. The root Grid keeps
     x:Name="AgentRoot" — leaving the root's DataContext untouched so
     SettingsView's page-visibility bindings keep working.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsAgentSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- x:Name="AgentRoot": the code-behind assigns the
         AgentSettingsViewModel to THIS Grid, not to the UserControl root.
         Why it matters: SettingsView sets this control's Visibility with a
         binding. If the root's DataContext were replaced by the agent VM,
         that binding would resolve IsAgentPage against a VM that has no
         such property, fail, and fall back to Visible - which made this
         page render on top of every other settings page.
         Keeping the agent VM one level down leaves the root inheriting
         SettingsViewModel, so page switching works, while every child
         here still binds to the agent VM exactly as before. -->
    <Grid x:Name="AgentRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,26,32,14">
            <TextBlock Text="{DynamicResource Settings.SecAgent}" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="{DynamicResource Settings.PrivacyPostureProviderCredentialsTaught}"
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">
            <StackPanel Margin="32,0,32,32">

                <!-- ═══════ GROUP: PRIVACY ═══════ -->
                <TextBlock Text="{DynamicResource About.Privacy}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.ControlWhetherAgentTalksInternetWhatAllowed}"
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <UniformGrid Columns="2" Margin="0,0,0,6">
                    <!-- Local only -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE72E;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{Binding LocalOnlyLabel}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.WhenAgentNeverContactsInternetDefault}"/>
                            <Button Command="{Binding ToggleLocalOnlyCommand}"
                                    Style="{StaticResource SettingsActionButtonStyle}"
                                    Tag="&#xE72E;"
                                    Content="{DynamicResource Settings.Toggle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Cloud consent -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE774;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{Binding CloudConsentLabel}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.SeparateExplicitAgreementSendQuestionsOnline}"/>
                            <Button Command="{Binding ToggleCloudConsentCommand}"
                                    Style="{StaticResource SettingsActionButtonStyle}"
                                    Tag="&#xE72E;"
                                    Content="{DynamicResource Settings.Toggle}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Plain-English summary -->
                <Border Style="{StaticResource SettingsFullRowTileStyle}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                            <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE946;"/>
                            <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.WhatMeans}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PrivacySummary}"
                                   Style="{StaticResource SettingsTileCaptionStyle}"/>
                        <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}">
                            <Run Text="{DynamicResource Settings.AllowedHosts}" FontWeight="SemiBold"/>
                            <Run Text="{Binding AllowedHostsDisplay, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Local model advice (never downloads) -->
                <Border Style="{StaticResource SettingsFullRowTileStyle}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                            <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE90F;"/>
                            <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.LocalModelAdvice}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding HardwareAdvice}"
                                   Style="{StaticResource SettingsTileCaptionStyle}"/>
                    </StackPanel>
                </Border>

                <!-- ═══════ ONE-CLICK LOCAL MODEL (offline brain) ═══════
                     User-initiated installer: catalog-only models (permissive
                     licences), download on click only, integrity record kept,
                     deletes fully on uninstall. Literal text on purpose —
                     this card ships new UI before the 15 locale packs add keys. -->
                <Border Style="{StaticResource SettingsFullRowTileStyle}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                            <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE896;"/>
                            <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Offline AI model (install once, works without internet)"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                   TextWrapping="Wrap"
                                   Text="These models run 100% on this computer after the one-time download — no messages ever leave the machine. Licences are linked before install; only permissive Apache-2.0 / MIT models are offered."/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="240"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding ModelRows}"
                                      SelectedItem="{Binding SelectedModel}"
                                      Height="38"
                                      FontSize="{StaticResource TextBodyLarge}"
                                      VerticalContentAlignment="Center" DisplayMemberPath="Title"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                           FontSize="{StaticResource TextCaption}"
                                           Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="{Binding SelectedModel.SizeText, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding SelectedModel.RamText, Mode=OneWay}"/>
                                    <Run Text=" · License: "/>
                                    <Run Text="{Binding SelectedModel.LicenseName, Mode=OneWay}"/>
                                </TextBlock>
                                <Button Content="License"
                                        ToolTip="{Binding SelectedModel.LicenseUrl, Mode=OneWay}"
                                        Margin="8,0,0,0"
                                        Click="OpenModelLicense_Click"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource SettingsTileCaptionStyle}"
                                   Text="{Binding SelectedModel.Description, Mode=OneWay}"/>
                        <TextBlock TextWrapping="Wrap"
                                   Style="{StaticResource SettingsTileFooterHintStyle}"
                                   Text="{Binding SelectedModel.Badge, Mode=OneWay}"/>
                        <TextBlock TextWrapping="Wrap"
                                   Style="{StaticResource SettingsTileCaptionStyle}"
                                   Text="{Binding SelectedModel.DisplayStatus, Mode=OneWay}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource SuccessPillButton}"
                                    Content="Install / Update"
                                    Tag="&#xE896;"
                                    Command="{Binding InstallModelCommand}"
                                    HorizontalAlignment="Left" Padding="20,10"
                                    Visibility="{Binding SelectedModel.IsInstalled, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}"/>
                            <Button Content="Verify integrity"
                                    Command="{Binding VerifyModelCommand}"
                                    Margin="10,0,0,0" Padding="16,10"
                                    Visibility="{Binding SelectedModel.IsInstalled, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}"/>
                            <Button Content="Uninstall"
                                    Command="{Binding UninstallModelCommand}"
                                    Margin="10,0,0,0" Padding="16,10"
                                    Visibility="{Binding SelectedModel.IsInstalled, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}"/>
                            <Button Content="Cancel"
                                    Command="{Binding CancelInstallCommand}"
                                    Margin="10,0,0,0" Padding="16,10"
                                    Visibility="{Binding IsModelBusy, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}"/>
                        </StackPanel>

                        <Grid Margin="0,10,0,0"
                              Visibility="{Binding IsModelBusy, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ProgressBar Minimum="0" Maximum="100" Height="8"
                                         Value="{Binding ModelProgress, Mode=OneWay}"/>
                            <TextBlock Grid.Row="1" Margin="0,4,0,0"
                                       Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{Binding ModelBusyText, Mode=OneWay}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <!-- OneWay on purpose: the Command is the only
                                 mutator. TwoWay would try to write the
                                 private-set property AND leave the toggle
                                 visually flipped when the enable-guard
                                 refuses. -->
                            <ToggleButton IsChecked="{Binding IsLocalModelEnabled, Mode=OneWay}"
                                          Content="Use the local model when answering"
                                          Command="{Binding ToggleLocalModelCommand}"
                                          Padding="14,8"/>
                        </StackPanel>

                        <TextBlock TextWrapping="Wrap"
                                   Style="{StaticResource SettingsTileFooterHintStyle}"
                                   Text="Nothing is uploaded — inference is local. Enabling only switches the agent's recognizer for future chat turns."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsGroupSeparatorStyle}"/>

                <!-- ═══════ GROUP: PROVIDER CREDENTIALS ═══════ -->
                <TextBlock Text="{DynamicResource Settings.ProviderCredentials}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.KeysEncryptedWindowsDpapiUserAccountNever}"
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <StackPanel Margin="0,0,0,6">
                    <Border Style="{StaticResource SettingsWideTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8B7;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.StoreAPIKey}"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="150"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*" MinWidth="160"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource Settings.Provider}" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding ProviderOptions}"
                                              SelectedItem="{Binding SelectedProvider}"
                                              Height="38"
                                              FontSize="{StaticResource TextBodyLarge}"
                                              VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Settings.APIKEY}" Style="{StaticResource LabelStyle}"/>
                                    <PasswordBox x:Name="AgentKeyBox"
                                                 Style="{StaticResource RoundedPasswordBoxStyle}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding KeyStatus}"
                                       Style="{StaticResource SettingsTileFooterHintStyle}"/>
                            <!-- Full-width action row: buttons stretch evenly
                                 across the whole card. -->
                            <UniformGrid Columns="2" Style="{StaticResource SettingsActionRowStyle}" Margin="0,10,0,0">
                                <Button Style="{StaticResource SuccessPillButton}"
                                        Tag="&#xE74E;"
                                        Content="{DynamicResource Settings.StoreKEY}"
                                        HorizontalAlignment="Stretch"
                                        Click="StoreKey_Click"/>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                        Tag="&#xE74D;"
                                        Content="{DynamicResource Settings.RemoveKEY}"
                                        Margin="0"
                                        Command="{Binding RemoveKeyCommand}"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource SettingsGroupSeparatorStyle}"/>

                <!-- ═══════ GROUP: TAUGHT PHRASES ═══════ -->
                <TextBlock Text="{DynamicResource Settings.TaughtPhrases}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.TaughtPhraseNothingUntilApproveHere}"
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <StackPanel Margin="0,0,0,6">
                    <Border Style="{StaticResource SettingsFullRowTileStyle}">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right"
                                        Command="{Binding RefreshRulesCommand}"
                                        Style="{StaticResource SettingsActionButtonStyle}"
                                        Tag="&#xE72C;"
                                        Content="{DynamicResource Action.Refresh}"
                                        VerticalAlignment="Center"/>
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding Rules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="{DynamicResource CardCornerRadius}"
                                                BorderBrush="{DynamicResource OutlineBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                                    <TextBlock Text="{Binding Display}"
                                                               FontSize="{StaticResource TextBody}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                    <TextBlock Text="{Binding StatusDisplay}"
                                                               FontSize="{StaticResource TextCaption}"
                                                               Margin="0,3,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource WarningBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsApproved}" Value="True">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource SuccessBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Style="{StaticResource RowSuccessButton}"
                                                            Tag="&#xE73E;"
                                                            Content="{DynamicResource Settings.Approve}"
                                                            Command="{Binding DataContext.ApproveRuleCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource RowDangerButton}"
                                                            Tag="&#xE74D;"
                                                            Content="{DynamicResource Settings.Revoke}"
                                                            Margin="8,0,0,0"
                                                            Command="{Binding DataContext.RevokeRuleCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{DynamicResource Settings.NothingTaughtYet}"
                                       Style="{StaticResource SettingsTileFooterHintStyle}"
                                       Margin="0,12,0,0"
                                       Visibility="{Binding HasRules,
                                           Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                            <Button Style="{StaticResource SettingsActionButtonStyle}"
                                    Tag="&#xE74D;"
                                    Content="{DynamicResource Settings.ClearTaughtPhrases}"
                                    Margin="0,14,0,0"
                                    Command="{Binding ClearTeachingCommand}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource SettingsGroupSeparatorStyle}"/>

                <!-- ═══════ GROUP: MEMORY & KNOWLEDGE ═══════ -->
                <TextBlock Text="{DynamicResource Settings.MemoryKnowledge}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.SavedMemoryKnowledgeBaseLiveAgentSDatabase}"
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <StackPanel Margin="0,0,0,6">
                    <Border Style="{StaticResource SettingsWideTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8F7;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.AgentData}"/>
                            </StackPanel>
                            <UniformGrid Columns="2" Style="{StaticResource SettingsActionRowStyle}">
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                        Tag="&#xE78C;"
                                        Content="{DynamicResource Settings.ExportKnowledge}"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding ExportKnowledgeCommand}"/>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                        Tag="&#xE896;"
                                        Content="{DynamicResource Settings.ImportKnowledge}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0"
                                        Command="{Binding ImportKnowledgeCommand}"/>
                            </UniformGrid>
                            <UniformGrid Columns="2" Style="{StaticResource SettingsActionRowStyle}" Margin="0,4,0,0">
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                        Tag="&#xE74D;"
                                        Content="{DynamicResource Settings.ClearMemory}"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding ClearMemoryCommand}"/>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                        Tag="&#xE74D;"
                                        Content="{DynamicResource Settings.ClearKnowledge}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0"
                                        Command="{Binding ClearKnowledgeCommand}"/>
                            </UniformGrid>

                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}"
                                       Margin="0,12,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding AgentDatabasePath, Mode=OneWay}">
                                <Run Text="{DynamicResource Settings.AgentDatabase}"/>
                                <Run Text="{Binding AgentDatabasePath, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}"
                                       Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SettingsFilePath, Mode=OneWay}">
                                <Run Text="{DynamicResource Settings.AgentSettings}"/>
                                <Run Text="{Binding SettingsFilePath, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Status line -->
                <TextBlock Text="{Binding Status}"
                           Style="{StaticResource SettingsGroupCaptionStyle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           Margin="4,16,0,0"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
