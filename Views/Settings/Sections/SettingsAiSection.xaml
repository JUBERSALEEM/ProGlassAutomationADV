<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsAiSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — AI ASSISTANT page (redesigned Aug 2026)
     REDESIGN
       Was: 5 giant stacked SectionCardStyle blocks (Master toggle, Data
       access, Model & tuning, Providers, Security). The Providers card
       alone contained three vertically-stacked ProviderCardBaseStyle
       cards taking the full width — on a wide monitor 65% of horizontal
       space was empty.
       Now: tile-grid layout — master switches and metric readouts fit
       into 320-wide tiles, providers become side-by-side wide tiles
       that self-align in the WrapPanel. API keys stay in a
       PasswordBox whose x:Name matches the code-behind handlers
       (GeminiKeyBox / GroqKeyBox / CohereKeyBox) so the existing
       PasswordChanged wiring keeps working byte-for-byte.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsAiSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,26,32,14">
            <TextBlock Text="{DynamicResource Settings.SecAi}" Style="{StaticResource Typography.H1}"/>
            <TextBlock Text="{DynamicResource Settings.ProvidersAPIKeysModelTuningDataAccess}"
                       Style="{StaticResource Typography.Subtitle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}">
            <StackPanel Margin="32,0,32,32">

                <!-- ═════════ GROUP: SWITCHES & MODEL ═════════ -->
                <TextBlock Text="{DynamicResource Settings.Assistant}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.MasterSwitchesTuningValuesUsedRequest}"
                           Style="{StaticResource Typography.BodySmall}"/>

                <UniformGrid Columns="3" Margin="0,0,0,6">

                    <!-- Master toggle -->
                    <Border>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SurfaceDetailPanelStyle}">
                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8F2;"/>
                                <TextBlock Style="{StaticResource Typography.Title}" Text="{DynamicResource Settings.EnableAIAssistant}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Style="{StaticResource Typography.BodySmall}"
                                       Text="{DynamicResource Settings.MasterSwitchWhenChatButtonHiddenNoAPICalls}"/>
                            <ToggleButton Grid.Row="3"
                                          HorizontalAlignment="Left"
                                          IsChecked="{Binding IsAiEnabled, Mode=TwoWay}"
                                          Style="{StaticResource ModernToggleSwitch}"/>
                        </Grid>
                    </Border>

                    <!-- Real business data -->
                    <Border>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SurfaceDetailPanelStyle}">
                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE9F9;"/>
                                <TextBlock Style="{StaticResource Typography.Title}" Text="{DynamicResource Settings.UseRealBusinessData}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Style="{StaticResource Typography.BodySmall}"
                                       Text="{DynamicResource Settings.WhenLiveInvoiceJobDeliveryBalanceDataSent}"/>
                            <ToggleButton Grid.Row="3"
                                          HorizontalAlignment="Left"
                                          IsChecked="{Binding UseRealData, Mode=TwoWay}"
                                          Style="{StaticResource ModernToggleSwitch}"/>
                        </Grid>
                    </Border>

                    <!-- Model readout -->
                    <Border>
                        <StackPanel>
                            <StackPanel Style="{StaticResource SurfaceDetailPanelStyle}">
                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE9F5;"/>
                                <TextBlock Style="{StaticResource Typography.Title}" Text="{DynamicResource Settings.ActiveModel}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding AiModel}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource Typography.Caption}"
                                       Text="{DynamicResource Settings.ModelIdentifierCurrentlySelectedProvider}"/>
                        </StackPanel>
                    </Border>

                    <!-- Max tokens -->
                    <Border>
                        <StackPanel>
                            <StackPanel Style="{StaticResource SurfaceDetailPanelStyle}">
                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE762;"/>
                                <TextBlock Style="{StaticResource Typography.Title}" Text="{DynamicResource Settings.MaxTokens}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding AiMaxTokens}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource Typography.Caption}"
                                       Text="{DynamicResource Settings.ResponseLengthCeilingCallAdjustConfigJsonNow}"/>
                        </StackPanel>
                    </Border>

                    <!-- Temperature -->
                    <Border>
                        <StackPanel>
                            <StackPanel Style="{StaticResource SurfaceDetailPanelStyle}">
                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE706;"/>
                                <TextBlock Style="{StaticResource Typography.Title}" Text="{DynamicResource Settings.Temperature}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding AiTemperature}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource Typography.Caption}"
                                       Text="{DynamicResource Settings.HigherMoreCreativeLowerMoreDeterministicRead}"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <Border/>

                <!-- ═════════ GROUP: PROVIDERS ═════════ -->
                <TextBlock Text="{DynamicResource Settings.Providers}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.ActiveProviderProcessesRequestsKeysEncrypted}"
                           Style="{StaticResource Typography.BodySmall}"/>

                <StackPanel Margin="0,0,0,6">

                    <!-- ── Gemini tile ─────────────────────────── -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGeminiActive}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                        <Setter Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="12" Height="12"
                                             Fill="{DynamicResource ProviderDotBlue}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"
                                             IsHitTestVisible="False"/>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Settings.GoogleGemini}"
                                                   Style="{StaticResource Typography.Title}"/>
                                        <TextBlock Text="{DynamicResource Settings.15ReqMin1500DayBestQuality}"
                                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   IsHitTestVisible="False"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button DockPanel.Dock="Right"
                                        HorizontalAlignment="Right"
                                        Command="{Binding SelectGeminiCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ProviderSelectButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGeminiActive}" Value="True">
                                                    <Setter Property="Content" Value="ACTIVE"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DockPanel>

                            <TextBlock Text="{DynamicResource Settings.APIKEY}"
                                       Style="{StaticResource Typography.Label}"
                                       Margin="0,14,0,4"/>
                            <PasswordBox x:Name="GeminiKeyBox"
                                         Style="{StaticResource RoundedPasswordBoxStyle}"
                                         PasswordChanged="GeminiKeyBox_PasswordChanged"/>
                            <TextBlock Text="{DynamicResource Settings.GetKeyAistudioGoogleCom}"
                                       Style="{StaticResource Typography.BodySmall}"
                                       Margin="0,4,0,10"/>
                            <Button
                                    Tag="&#xE74E;" Content="{DynamicResource Settings.SAVETEST}"
                                    Command="{Binding TestGeminiCommand}"
                                    HorizontalAlignment="Stretch"
                                    Height="32"
                                    FontSize="{DynamicResource FontSize.Body}"/>
                            <TextBlock Text="{Binding GeminiTestStatus}"
                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       IsHitTestVisible="False"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Groq tile ───────────────────────────── -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGroqActive}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                        <Setter Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="12" Height="12"
                                             Fill="{DynamicResource ProviderDotAmber}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"
                                             IsHitTestVisible="False"/>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Settings.Groq}"
                                                   Style="{StaticResource Typography.Title}"/>
                                        <TextBlock Text="{DynamicResource Settings.FastLlamaGenerousFreeTier}"
                                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   IsHitTestVisible="False"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button DockPanel.Dock="Right"
                                        HorizontalAlignment="Right"
                                        Command="{Binding SelectGroqCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ProviderSelectButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGroqActive}" Value="True">
                                                    <Setter Property="Content" Value="ACTIVE"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DockPanel>

                            <TextBlock Text="{DynamicResource Settings.APIKEY}"
                                       Style="{StaticResource Typography.Label}"
                                       Margin="0,14,0,4"/>
                            <PasswordBox x:Name="GroqKeyBox"
                                         Style="{StaticResource RoundedPasswordBoxStyle}"
                                         PasswordChanged="GroqKeyBox_PasswordChanged"/>
                            <TextBlock Text="{DynamicResource Settings.GetKeyConsoleGroqCom}"
                                       Style="{StaticResource Typography.BodySmall}"
                                       Margin="0,4,0,10"/>
                            <Button
                                    Tag="&#xE74E;" Content="{DynamicResource Settings.SAVETEST}"
                                    Command="{Binding TestGroqCommand}"
                                    HorizontalAlignment="Stretch"
                                    Height="32"
                                    FontSize="{DynamicResource FontSize.Body}"/>
                            <TextBlock Text="{Binding GroqTestStatus}"
                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       IsHitTestVisible="False"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Cohere tile ─────────────────────────── -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCohereActive}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                        <Setter Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="12" Height="12"
                                             Fill="{DynamicResource ProviderDotViolet}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"
                                             IsHitTestVisible="False"/>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Settings.Cohere}"
                                                   Style="{StaticResource Typography.Title}"/>
                                        <TextBlock Text="{DynamicResource Settings.EnterpriseGradeCommandFamily}"
                                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   IsHitTestVisible="False"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button DockPanel.Dock="Right"
                                        HorizontalAlignment="Right"
                                        Command="{Binding SelectCohereCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ProviderSelectButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCohereActive}" Value="True">
                                                    <Setter Property="Content" Value="ACTIVE"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DockPanel>

                            <TextBlock Text="{DynamicResource Settings.APIKEY}"
                                       Style="{StaticResource Typography.Label}"
                                       Margin="0,14,0,4"/>
                            <PasswordBox x:Name="CohereKeyBox"
                                         Style="{StaticResource RoundedPasswordBoxStyle}"
                                         PasswordChanged="CohereKeyBox_PasswordChanged"/>
                            <TextBlock Text="{DynamicResource Settings.GetKeyDashboardCohereCom}"
                                       Style="{StaticResource Typography.BodySmall}"
                                       Margin="0,4,0,10"/>
                            <Button Style="{StaticResource PrimaryPillButton}"
                                    Tag="&#xE74E;" Content="{DynamicResource Settings.SAVETEST}"
                                    Command="{Binding TestCohereCommand}"
                                    HorizontalAlignment="Stretch"
                                    Height="32"
                                    FontSize="{DynamicResource FontSize.Body}"/>
                            <TextBlock Text="{Binding CohereTestStatus}"
                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       IsHitTestVisible="False"/>
                        </StackPanel>
                    </Border>

                    <!-- Config path (full-row tile) -->
                    <Border Style="{StaticResource SurfacePrimaryStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SurfaceDetailPanelStyle}">
                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8B7;"/>
                                <TextBlock Style="{StaticResource Typography.Title}" Text="{DynamicResource Settings.KeysFile}"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Settings.ProviderKeysEncryptedRestWindowsDpapiStored}"
                                       Style="{StaticResource Typography.BodySmall}"/>
                            <TextBlock Text="{Binding ConfigFilePath}"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       FontFamily="{DynamicResource FontFamily.Code}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <Border Style="{StaticResource SurfaceDetailStyle}"/>

                <!-- ═════════ GROUP: SECURITY ═════════ -->
                <TextBlock Text="{DynamicResource Settings.Security}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.ControlKeyPersistenceWipeStoredConversation}"
                           Style="{StaticResource Typography.BodySmall}"/>

                <UniformGrid Columns="3" Margin="0,0,0,6">

                    <!-- Keep API keys saved -->
                    <Border Style="{StaticResource SurfacePrimaryStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SurfaceDetailPanelStyle}">
                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE72E;"/>
                                <TextBlock Style="{StaticResource Typography.Title}" Text="{DynamicResource Settings.KeepKeysSaved}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Style="{StaticResource Typography.BodySmall}"
                                       Text="{DynamicResource Settings.KeysHeldSessionKeysAlwaysEncryptedWindows}"/>
                            <ToggleButton Grid.Row="3"
                                          HorizontalAlignment="Left"
                                          IsChecked="{Binding KeepApiKeysSaved, Mode=TwoWay}"
                                          Style="{StaticResource ModernToggleSwitch}"/>
                        </Grid>
                    </Border>

                    <!-- Remove saved keys -->
                    <Border Style="{StaticResource SurfacePrimaryStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SurfaceDetailPanelStyle}">
                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE74D;"/>
                                <TextBlock Style="{StaticResource Typography.Title}" Text="{DynamicResource Settings.RemoveSavedKeys}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Typography.BodySmall}"
                                       Text="{DynamicResource Settings.DeleteProviderKeyDiskAssistantAskReEnterNext}"/>
                            <Button Style="{StaticResource DangerButton}"
                                    Tag="&#xE74D;" Content="{DynamicResource Settings.RemoveKEYS}"
                                    Command="{Binding RemoveSavedKeysCommand}"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <!-- Clear AI memory -->
                    <Border Style="{StaticResource SurfacePrimaryStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SurfaceDetailPanelStyle}">
                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE81C;"/>
                                <TextBlock Style="{StaticResource Typography.Title}" Text="{DynamicResource Settings.ClearAIMemory}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Typography.BodySmall}"
                                       Text="{DynamicResource Settings.WipeStoredConversationHistoryAssistantUses}"/>
                            <Button Style="{StaticResource DangerButton}"
                                    Tag="&#xE74D;" Content="{DynamicResource Settings.ClearMemory}"
                                    Command="{Binding ClearAiMemoryCommand}"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
