<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsAiSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — AI ASSISTANT page (redesigned Aug 2026)

     REDESIGN
       Was: 5 giant stacked SectionCardStyle blocks (Master toggle, Data
       access, Model & tuning, Providers, Security). The Providers card
       alone contained three vertically-stacked ProviderCardBaseStyle
       cards taking the full width — on a wide monitor 65% of horizontal
       space was empty.

       Now: tile-grid layout — master switches and metric readouts fit
       into 320-wide tiles, providers become side-by-side wide tiles
       that self-align in the WrapPanel. API keys stay in a
       PasswordBox whose x:Name matches the code-behind handlers
       (GeminiKeyBox / GroqKeyBox / CohereKeyBox) so the existing
       PasswordChanged wiring keeps working byte-for-byte.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsAiSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,26,32,14">
            <TextBlock Text="AI Assistant" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Providers, API keys, model tuning and data access."
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}">
            <StackPanel Margin="32,0,32,32">

                <!-- ═════════ GROUP: SWITCHES & MODEL ═════════ -->
                <TextBlock Text="ASSISTANT"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="Master switches and the tuning values used on every request."
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <UniformGrid Columns="3" Margin="0,0,0,6">

                    <!-- Master toggle -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8F2;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Enable AI Assistant"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="Master switch. When off, the chat button is hidden and no API calls are made."/>
                            <ToggleButton Grid.Row="3"
                                          HorizontalAlignment="Left"
                                          IsChecked="{Binding IsAiEnabled, Mode=TwoWay}"
                                          Style="{StaticResource ModernToggleSwitch}"/>
                        </Grid>
                    </Border>

                    <!-- Real business data -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE9F9;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Use Real Business Data"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="When on, live invoice / job / delivery / balance data is sent to your chosen provider over the internet."/>
                            <ToggleButton Grid.Row="3"
                                          HorizontalAlignment="Left"
                                          IsChecked="{Binding UseRealData, Mode=TwoWay}"
                                          Style="{StaticResource ModernToggleSwitch}"/>
                        </Grid>
                    </Border>

                    <!-- Model readout -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE9F5;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Active Model"/>
                            </StackPanel>
                            <TextBlock Text="{Binding AiModel}"
                                       Style="{StaticResource SettingsTileHeroStyle}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}"
                                       Text="Model identifier of the currently selected provider — from config.json."/>
                        </StackPanel>
                    </Border>

                    <!-- Max tokens -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE762;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Max Tokens"/>
                            </StackPanel>
                            <TextBlock Text="{Binding AiMaxTokens}"
                                       Style="{StaticResource SettingsTileHeroStyle}"/>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}"
                                       Text="Response length ceiling per call. Adjust in config.json for now."/>
                        </StackPanel>
                    </Border>

                    <!-- Temperature -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE706;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Temperature"/>
                            </StackPanel>
                            <TextBlock Text="{Binding AiTemperature}"
                                       Style="{StaticResource SettingsTileHeroStyle}"/>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}"
                                       Text="Higher = more creative, lower = more deterministic. Read from config.json."/>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <Border Style="{StaticResource SettingsGroupSeparatorStyle}"/>

                <!-- ═════════ GROUP: PROVIDERS ═════════ -->
                <TextBlock Text="PROVIDERS"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="Only the ACTIVE provider processes your requests. Keys are encrypted at rest with DPAPI."
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <StackPanel Margin="0,0,0,6">

                    <!-- ── Gemini tile ─────────────────────────── -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SettingsTileStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGeminiActive}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                        <Setter Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="12" Height="12"
                                             Fill="{StaticResource ProviderDotBlue}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"
                                             IsHitTestVisible="False"/>
                                    <StackPanel>
                                        <TextBlock Text="Google Gemini"
                                                   Style="{StaticResource SettingsTileTitleStyle}"/>
                                        <TextBlock Text="15 req/min · 1,500/day · best quality"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   IsHitTestVisible="False"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button DockPanel.Dock="Right"
                                        HorizontalAlignment="Right"
                                        Command="{Binding SelectGeminiCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ProviderSelectButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGeminiActive}" Value="True">
                                                    <Setter Property="Content" Value="ACTIVE"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DockPanel>

                            <TextBlock Text="API KEY"
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0,14,0,4"/>
                            <PasswordBox x:Name="GeminiKeyBox"
                                         Style="{StaticResource RoundedPasswordBoxStyle}"
                                         PasswordChanged="GeminiKeyBox_PasswordChanged"/>
                            <TextBlock Text="Get key at aistudio.google.com"
                                       Style="{StaticResource HintTextStyle}"
                                       Margin="0,4,0,10"/>
                            <Button Style="{StaticResource PrimaryPillButton}"
                                    Tag="&#xE74E;" Content="SAVE &amp; TEST"
                                    Command="{Binding TestGeminiCommand}"
                                    HorizontalAlignment="Stretch"
                                    Height="32"
                                    FontSize="11"/>
                            <TextBlock Text="{Binding GeminiTestStatus}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       IsHitTestVisible="False"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Groq tile ───────────────────────────── -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SettingsTileStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGroqActive}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                        <Setter Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="12" Height="12"
                                             Fill="{StaticResource ProviderDotAmber}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"
                                             IsHitTestVisible="False"/>
                                    <StackPanel>
                                        <TextBlock Text="Groq"
                                                   Style="{StaticResource SettingsTileTitleStyle}"/>
                                        <TextBlock Text="Fast Llama · Very generous free tier"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   IsHitTestVisible="False"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button DockPanel.Dock="Right"
                                        HorizontalAlignment="Right"
                                        Command="{Binding SelectGroqCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ProviderSelectButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGroqActive}" Value="True">
                                                    <Setter Property="Content" Value="ACTIVE"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DockPanel>

                            <TextBlock Text="API KEY"
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0,14,0,4"/>
                            <PasswordBox x:Name="GroqKeyBox"
                                         Style="{StaticResource RoundedPasswordBoxStyle}"
                                         PasswordChanged="GroqKeyBox_PasswordChanged"/>
                            <TextBlock Text="Get key at console.groq.com"
                                       Style="{StaticResource HintTextStyle}"
                                       Margin="0,4,0,10"/>
                            <Button Style="{StaticResource PrimaryPillButton}"
                                    Tag="&#xE74E;" Content="SAVE &amp; TEST"
                                    Command="{Binding TestGroqCommand}"
                                    HorizontalAlignment="Stretch"
                                    Height="32"
                                    FontSize="11"/>
                            <TextBlock Text="{Binding GroqTestStatus}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       IsHitTestVisible="False"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Cohere tile ─────────────────────────── -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SettingsTileStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCohereActive}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                        <Setter Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="12" Height="12"
                                             Fill="{StaticResource ProviderDotViolet}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"
                                             IsHitTestVisible="False"/>
                                    <StackPanel>
                                        <TextBlock Text="Cohere"
                                                   Style="{StaticResource SettingsTileTitleStyle}"/>
                                        <TextBlock Text="Enterprise-grade · Command family"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   IsHitTestVisible="False"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button DockPanel.Dock="Right"
                                        HorizontalAlignment="Right"
                                        Command="{Binding SelectCohereCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ProviderSelectButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCohereActive}" Value="True">
                                                    <Setter Property="Content" Value="ACTIVE"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DockPanel>

                            <TextBlock Text="API KEY"
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0,14,0,4"/>
                            <PasswordBox x:Name="CohereKeyBox"
                                         Style="{StaticResource RoundedPasswordBoxStyle}"
                                         PasswordChanged="CohereKeyBox_PasswordChanged"/>
                            <TextBlock Text="Get key at dashboard.cohere.com"
                                       Style="{StaticResource HintTextStyle}"
                                       Margin="0,4,0,10"/>
                            <Button Style="{StaticResource PrimaryPillButton}"
                                    Tag="&#xE74E;" Content="SAVE &amp; TEST"
                                    Command="{Binding TestCohereCommand}"
                                    HorizontalAlignment="Stretch"
                                    Height="32"
                                    FontSize="11"/>
                            <TextBlock Text="{Binding CohereTestStatus}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       IsHitTestVisible="False"/>
                        </StackPanel>
                    </Border>

                    <!-- Config path (full-row tile) -->
                    <Border Style="{StaticResource SettingsFullRowTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8B7;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Keys File"/>
                            </StackPanel>
                            <TextBlock Text="All provider keys are encrypted at rest with Windows DPAPI and stored at:"
                                       Style="{StaticResource SettingsTileCaptionStyle}"/>
                            <TextBlock Text="{Binding ConfigFilePath}"
                                       FontSize="12"
                                       FontFamily="Consolas, Courier New, monospace"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <Border Style="{StaticResource SettingsGroupSeparatorStyle}"/>

                <!-- ═════════ GROUP: SECURITY ═════════ -->
                <TextBlock Text="SECURITY"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="Control key persistence and wipe stored conversation memory."
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <UniformGrid Columns="3" Margin="0,0,0,6">

                    <!-- Keep API keys saved -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE72E;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Keep Keys Saved"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="Off = keys held only for this session. Keys are always encrypted with Windows DPAPI — never plain text."/>
                            <ToggleButton Grid.Row="3"
                                          HorizontalAlignment="Left"
                                          IsChecked="{Binding KeepApiKeysSaved, Mode=TwoWay}"
                                          Style="{StaticResource ModernToggleSwitch}"/>
                        </Grid>
                    </Border>

                    <!-- Remove saved keys -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE74D;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Remove Saved Keys"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="Delete every provider key from disk. The assistant will ask you to re-enter them next time."/>
                            <Button Style="{StaticResource DangerButton}"
                                    Tag="&#xE74D;" Content="REMOVE KEYS"
                                    Command="{Binding RemoveSavedKeysCommand}"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <!-- Clear AI memory -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE81C;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Clear AI Memory"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="Wipe stored conversation history that the assistant uses to remember context between chats."/>
                            <Button Style="{StaticResource DangerButton}"
                                    Tag="&#xE74D;" Content="CLEAR MEMORY"
                                    Command="{Binding ClearAiMemoryCommand}"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
