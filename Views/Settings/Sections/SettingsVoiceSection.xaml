<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsVoiceSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — VOICE page (redesigned Aug 2026)

     REDESIGN
       Was: one giant SectionCardStyle containing the model picker AND
       a nested "MODEL STATUS" card. Model picker was already card-like
       but competed with the big outer border, so the page felt
       double-boxed.

       Now: tile-grid layout with two full-row tiles — one for the
       MODEL PICKER, one for MODEL STATUS. Nested double borders
       removed. ModelOption_MouseLeftButtonDown handler on the item
       template is preserved byte-for-byte so the click-to-select
       behaviour still works.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsVoiceSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
        <UserControl.Resources>
        <!-- Migrated StatusBadgeStyle to global SurfacePrimaryStyle -->
        <!-- 2026-09-14: the shared Settings dictionary was missing here (every
             other section merges it) — StaticResource lookups such as
             DownloadProgressBarStyle failed at first render of this section
             (ERR-56F1CC). -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,26,32,14">
            <TextBlock Text="{DynamicResource Settings.SecVoice}"/>
            <TextBlock Text="{DynamicResource Settings.OfflineSpeechTextOpenaiWhisper95AccuracyNo}"
                      />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}">
            <StackPanel Margin="32,0,32,32">

                <!-- ═════════ GROUP: WHISPER MODEL ═════════ -->
                <TextBlock Text="{DynamicResource Settings.WhisperModel}"
                          />
                <TextBlock Text="{DynamicResource Settings.PickModelSizeDownloadOnceLargerModelsMore}"
                          />

                <StackPanel Margin="0,0,0,6">

                    <!-- Model picker (full row) -->
                    <Border>
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Text="&#xE720;"
                                           FontFamily="{DynamicResource FontFamily.Icon}"
                                           FontSize="{DynamicResource FontSize.Body}"
                                           Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Settings.ChooseModel}"/>
                            </StackPanel>
                            <TextBlock
                                       Text="{DynamicResource Settings.ClickCardSelectOneModelActiveTimeSwitch}"/>

                            <ItemsControl ItemsSource="{Binding WhisperModelOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border MouseLeftButtonDown="ModelOption_MouseLeftButtonDown"
                                                Tag="{Binding Key}">
                                            <Border.Style>
                                                <Style TargetType="Border"
                                                       BasedOn="{StaticResource ModelOptionCardStyle}">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush"
                                                                    Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="{StaticResource TextBodyLarge}" FontWeight="{DynamicResource Weight.Bold}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               IsHitTestVisible="False"/>
                                                    <TextBlock FontSize="{StaticResource TextCaption}"
                                                               Margin="0,2,0,0"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               IsHitTestVisible="False">
                                                        <Run Text="{Binding SizeMB, Mode=OneWay}"/>
                                                        <Run Text="{DynamicResource Settings.MB}"/>
                                                        <Run Text="{Binding Accuracy, Mode=OneWay}"/>
                                                        <Run Text="{DynamicResource Settings.Accuracy}"/>
                                                        <Run Text="{Binding Speed, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="{StaticResource TextCaption}"
                                                               Margin="0,3,0,0"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               TextWrapping="Wrap"
                                                               IsHitTestVisible="False"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Text="&#xE73E;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="{StaticResource TextSection}"
                                                           FontWeight="{DynamicResource Weight.Bold}"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0,0,0"
                                                           Visibility="Collapsed"
                                                           IsHitTestVisible="False"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <Border Style="{StaticResource SettingsGroupSeparatorStyle}"/>

                <!-- ═════════ GROUP: STATUS ═════════ -->
                <TextBlock Text="{DynamicResource Common.Status}"
                          />
                <TextBlock Text="{DynamicResource Settings.WhereSelectedModelStandsDownloadCancelDelete}"
                          />

                <StackPanel Margin="0,0,0,6">

                    <!-- Model status (full row) -->
                    <Border Style="{StaticResource SettingsFullRowTileStyle}">
                        <Border.Resources>
                            <!-- Local: tinted highlight when the model is ready. -->
                            <Style x:Key="StatusBadgeStyle" TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}">
                                <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
                                <Setter Property="Padding" Value="10,4"/>
                                <Setter Property="Background" Value="{DynamicResource TintRedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWhisperModelReady}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Resources>
                        <StackPanel>
                            <DockPanel LastChildFill="True">

                                <!-- Right-docked badge -->
                                <Border DockPanel.Dock="Right"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SurfacePrimaryStyle}">
                                    <TextBlock FontSize="{StaticResource TextCaption}" FontWeight="{DynamicResource Weight.Bold}" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="NOT INSTALLED"/>
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWhisperModelReady}" Value="True">
                                                        <Setter Property="Text" Value="INSTALLED"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                    <TextBlock Text="&#xE720;"
                                           FontFamily="{DynamicResource FontFamily.Icon}"
                                           FontSize="{DynamicResource FontSize.Body}"
                                           Margin="0,0,6,0"/>
                                    <StackPanel>
                                        <!-- Style is set ONLY via the property-element <TextBlock.Style>.
                                             Do NOT also set Style="…" on the opening tag — WPF rejects
                                             that with XLS0501 / MC3024 ("Style set more than once")
                                             even when both point at the same resource. BasedOn keeps
                                             the tile-title look; the trigger swaps the Text. -->
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SettingsTileTitleStyle}">
                                                    <Setter Property="Text" Value="Whisper — Not Installed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWhisperModelReady}" Value="True">
                                                            <Setter Property="Text" Value="Whisper — Ready"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock FontSize="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   Text="{Binding SelectedModelInfo.FileName}"
                                                   IsHitTestVisible="False"/>
                                        <TextBlock FontSize="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   Text="·" Margin="5,0"
                                                   IsHitTestVisible="False"/>
                                        <TextBlock FontSize="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{DynamicResource Settings.VoiceDownloadRequired}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWhisperModelReady}" Value="True">
                                                            <Setter Property="Text" Value="{DynamicResource Settings.VoiceInstalledOfflineSTT}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>

                            <!-- Download progress -->
                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding IsDownloadingModel,
                                            Converter={StaticResource BoolToVisibilityConverter}}">
                                <ProgressBar Value="{Binding DownloadProgress}"
                                             Style="{StaticResource DownloadProgressBarStyle}"
                                             HorizontalAlignment="Stretch"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock FontSize="{StaticResource TextBody}" FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               IsHitTestVisible="False">
                                        <Run Text="{Binding DownloadProgress, Mode=OneWay}"/><Run Text="%"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding DownloadSizeText}"
                                               FontSize="{StaticResource TextBody}" Margin="10,0,0,0"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               IsHitTestVisible="False"/>
                                    <TextBlock Text="{Binding DownloadSpeedText}"
                                               FontSize="{StaticResource TextBody}" FontWeight="{DynamicResource Weight.Bold}" Margin="10,0,0,0"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               IsHitTestVisible="False"/>
                                    <TextBlock Text="{Binding DownloadEtaText}"
                                               FontSize="{StaticResource TextBody}" Margin="10,0,0,0"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               IsHitTestVisible="False"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Actions — full-width row. The primary DOWNLOAD
                                 button takes the star (always fills the card);
                                 CANCEL / DELETE are auto columns that collapse
                                 to 0 when hidden, so the row always reads as
                                 a single unbroken full-width action bar. -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Tag="&#xE896;"
                                        Command="{Binding DownloadWhisperModelCommand}"
                                        Margin="0,0,8,0"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{Binding IsWhisperModelReady,
                                                Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                        MinWidth="180"
                                        Height="34"
                                        FontSize="{StaticResource TextBody}">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource PrimaryPillButton}">
                                            <Setter Property="Content" Value="DOWNLOAD MODEL"/>
                                            <Setter Property="IsEnabled" Value="True"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDownloadingModel}" Value="True">
                                                    <Setter Property="Content" Value="DOWNLOADING…"/>
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Grid.Column="1"
                                        Style="{StaticResource OutlinedPillButton}"
                                        Tag="&#xE711;" Content="{DynamicResource Action.Cancel}"
                                        Command="{Binding CancelDownloadCommand}"
                                        Margin="0,0,8,0"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{Binding IsDownloadingModel,
                                                Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Button Grid.Column="2"
                                        Style="{StaticResource DangerButton}"
                                        Tag="&#xE74D;" Content="{DynamicResource Settings.DeleteModel}"
                                        Command="{Binding DeleteWhisperModelCommand}"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{Binding IsWhisperModelReady,
                                                Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>

                            <!-- Unified status text (hidden while downloading — progress bar takes over) -->
                            <TextBlock Text="{Binding VoiceStatus}"
                                       FontSize="{StaticResource TextBody}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDownloadingModel}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- File location -->
                            <TextBlock Text="{DynamicResource Settings.ModelStored}"
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0,12,0,4"
                                       Visibility="{Binding IsWhisperModelReady,
                                            Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding ModelFilePath}"
                                       FontSize="{StaticResource TextBody}"
                                       FontFamily="Consolas, Courier New, monospace"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding IsWhisperModelReady,
                                            Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
