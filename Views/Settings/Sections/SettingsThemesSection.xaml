<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsThemesSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — THEMES page (2026-09-06)
     Replaces the removed Theme Studio (0–100 playground) with its one
     legitimate capability: bounded, persisted Crystal Fluid (Ios-17pm)
     material tuning. FAMILY-AWARE:
       · The visual-theme family ComboBox and the per-family Reset are
         always visible.
       · The Crystal Fluid material group (quick presets + six live axes
         + live water preview) is only visible while Ios-17pm is active
         (SettingsViewModel.IsCrystalThemeActive).
       · Normal / Monet keep their existing Appearance controls
         (CardCornerRadius, CardBorderThickness, UseGradientSurfaces);
         a hint tile points back to Appearance when Crystal is inactive.
     Six LIVE axes only (water opacity/speed, wave amplitude, caustic,
     bubble, reflection opacity). Glass/glass-border/shadow opacity stay
     parked in CrystalFluidSettings — no fake controls.
     Bindings target SettingsViewModel (DataContext flows from shell).
═══════════════════════════════════════════════════════════════════ -->
<UserControl
             xmlns:cards="clr-namespace:ProGlassAutomation.Views.Settings.Sections.Cards" x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsThemesSection"
             xmlns:crystal="clr-namespace:ProGlassAutomation.Controls.CrystalFluid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}">
            <StackPanel Margin="{StaticResource SettingsPagePadding}">

                <!-- ═══ CARD — VISUAL THEME (always visible) ═══ -->
                <Border Style="{StaticResource SettingsPageCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.LblThemeFamily}"
                                   Style="{StaticResource SettingsCardTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Settings.NormalMonetIos17pm}"
                                   Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                        <UniformGrid Columns="2" Margin="{StaticResource SettingsTileGridBleed}">
                            <Border Margin="{StaticResource SettingsTileGridMargin}" Style="{StaticResource SettingsInnerTileStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE790;"/>
                                        <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center"
                                                   Text="{DynamicResource Settings.LblThemeFamily}"/>
                                    </StackPanel>
                                    <ComboBox AutomationProperties.AutomationId="Settings.VisualTheme"
                                              ItemsSource="{Binding VisualThemeOptions}"
                                              DisplayMemberPath="Display"
                                              SelectedValuePath="Key"
                                              SelectedValue="{Binding SelectedVisualTheme, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"
                                              Padding="10,7" FontSize="{DynamicResource FontSize.Title}" Style="{StaticResource ComboBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <!-- Base Light / Dark Mode Toggle -->
                            <Border Margin="{StaticResource SettingsTileGridMargin}" Style="{StaticResource SettingsInnerTileStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE706;"/>
                                        <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center"
                                                   Text="{DynamicResource Settings.Mode}"/>
                                    </StackPanel>
                                    <ListBox Style="{StaticResource SettingsSegmentTrackFillStyle}"
                                             AutomationProperties.Name="{DynamicResource Settings.Mode}"
                                             SelectedValuePath="Tag"
                                             SelectedValue="{Binding ThemeMode, Mode=TwoWay}"
                                             AutomationProperties.AutomationId="Settings.ThemeModeStudio">
                                        <ListBoxItem Tag="Light" Content="{DynamicResource Settings.ModeLight}" Style="{StaticResource SettingsSegmentItemStyle}"/>
                                        <ListBoxItem Tag="Dark" Content="{DynamicResource Settings.ModeDark}" Style="{StaticResource SettingsSegmentItemStyle}"/>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Brand Accent Palette Directly Inside Theme Studio -->
                        <Border Margin="0,12,0,0" Style="{StaticResource SettingsInnerTileStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE790;"/>
                                        <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center"
                                                   Text="{DynamicResource Settings.LblAccent}"/>
                                    </StackPanel>
                                    <!-- One-Tap Factory Theme Reset -->
                                    <Button Grid.Column="1" AutomationProperties.AutomationId="Settings.ResetThemeFamilyStudio"
                                            Command="{Binding ResetThemeFamilyCommand}"
                                            Style="{StaticResource RowOutlinedButton}" Height="28" Padding="12,0"
                                            Content="{DynamicResource Settings.ResetThemeFamily}"/>
                                </Grid>
                                <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                           Text="{DynamicResource Settings.ButtonsTintsHoverStatesMonetGlassSurfaces}"/>

                                <ItemsControl ItemsSource="{Binding AccentPalette}" Margin="{StaticResource SettingsStackGap4}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.ApplyAccentCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Key}"
                                                    Style="{StaticResource AccentChipStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="11" Height="11" Fill="{Binding Swatch}"
                                                             VerticalAlignment="Center" Margin="{StaticResource SettingsInlineGap8R}"/>
                                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Live Interactive Component Deck -->
                                <Border Margin="0,12,0,0" Padding="14,12" Background="{DynamicResource SurfaceSecondaryBrush}"
                                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}"
                                        CornerRadius="{DynamicResource CardCornerRadius}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Text="Live Studio Specimen" FontSize="{DynamicResource FontSize.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="Real-time theme engine tokens verified with automatic WCAG contrast derivation."
                                                       FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="18,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource TintBlueBrush}" CornerRadius="12" Padding="10,4" Margin="0,0,6,0">
                                                <TextBlock Text="Active Accent" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                            <Border Background="{DynamicResource TintGreenBrush}" CornerRadius="12" Padding="10,4">
                                                <TextBlock Text="WCAG AAA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Padding="12,8"
                                                Background="{DynamicResource SurfacePrimaryBrush}"
                                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}"
                                                CornerRadius="{DynamicResource Radius.Small}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="13" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Tokens active across all sales, production, about, and settings views."
                                                               FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource PrimaryPillButton}" Height="26" Padding="14,0" Content="Test State" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Visibility="{Binding IsCrystalThemeActive,
                    Converter={StaticResource BoolToVisibilityConverter}}">

                    <!-- ═══ CARD — CRYSTAL FLUID MATERIAL (Ios-17pm only) ═══ -->
                    <Border Style="{StaticResource SettingsPageCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings.GrpCrystalMaterial}"
                                       Style="{StaticResource SettingsCardTitleStyle}"/>
                            <TextBlock Text="{DynamicResource Settings.CrystalMaterialHint}"
                                       Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                            <!-- Quick presets (Default / Calm / Intense) -->
                            <Border Style="{StaticResource SettingsInnerTileStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8A9;"/>
                                        <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center"
                                                   Text="{DynamicResource Settings.GrpPresets}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                               Text="{DynamicResource Settings.PresetsHint}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button AutomationProperties.AutomationId="Settings.PresetDefault"
                                                Command="{Binding ApplyThemePresetCommand}"
                                                CommandParameter="Default"
                                                Content="{DynamicResource Settings.ThemePresetDefault}"
                                                Margin="{StaticResource SettingsInlineGap8R}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource OutlinedPillButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveCrystalPreset}" Value="Default">
                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button AutomationProperties.AutomationId="Settings.PresetCalm"
                                                Command="{Binding ApplyThemePresetCommand}"
                                                CommandParameter="Calm"
                                                Content="{DynamicResource Settings.ThemePresetCalm}"
                                                Margin="{StaticResource SettingsInlineGap8R}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource OutlinedPillButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveCrystalPreset}" Value="Calm">
                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button AutomationProperties.AutomationId="Settings.PresetIntense"
                                                Command="{Binding ApplyThemePresetCommand}"
                                                CommandParameter="Intense"
                                                Content="{DynamicResource Settings.ThemePresetIntense}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource OutlinedPillButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveCrystalPreset}" Value="Intense">
                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Six live Crystal Fluid axes -->
                            <Border Margin="{StaticResource SettingsStackGap14}" Style="{StaticResource SettingsInnerTileStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE771;"/>
                                        <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center"
                                                   Text="{DynamicResource Settings.GrpCrystalMaterial}"/>
                                    </StackPanel>

                                                                        <StackPanel Margin="{StaticResource SettingsAxisRowMargin}">
                                        <TextBlock Text="{DynamicResource Settings.CrystalWaterOpacity}"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   Margin="{StaticResource SettingsAxisLabelMargin}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="52"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Style="{StaticResource ModernSliderStyle}"
                                        AutomationProperties.Name="{DynamicResource Settings.CrystalWaterOpacity}"
                                                AutomationProperties.AutomationId="Settings.CrystalWaterOpacity"
                                                Minimum="{Binding CrystalWaterOpacityMin}"
                                                Maximum="{Binding CrystalWaterOpacityMax}"
                                                Value="{Binding CrystalWaterOpacity, Mode=TwoWay}"
                                                VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" TextAlignment="Right"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding CrystalWaterOpacity, Mode=OneWay, StringFormat={}{0:0.00}}"/>
                                        </Grid>
                                    </StackPanel>

                                                                        <StackPanel>
                                        <TextBlock Text="{DynamicResource Settings.CrystalWaterSpeed}"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   Margin="{StaticResource SettingsAxisLabelMargin}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="52"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Style="{StaticResource ModernSliderStyle}"
                                        AutomationProperties.Name="{DynamicResource Settings.CrystalWaterSpeed}"
                                                AutomationProperties.AutomationId="Settings.CrystalWaterSpeed"
                                                Minimum="{Binding CrystalWaterSpeedMin}"
                                                Maximum="{Binding CrystalWaterSpeedMax}"
                                                Value="{Binding CrystalWaterSpeed, Mode=TwoWay}"
                                                VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" TextAlignment="Right"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding CrystalWaterSpeed, Mode=OneWay, StringFormat={}{0:0.00}}"/>
                                        </Grid>
                                    </StackPanel>

                                                                        <StackPanel Margin="{StaticResource SettingsAxisRowMargin}">
                                        <TextBlock Text="{DynamicResource Settings.CrystalWaveAmplitude}"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   Margin="{StaticResource SettingsAxisLabelMargin}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="52"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Style="{StaticResource ModernSliderStyle}"
                                        AutomationProperties.Name="{DynamicResource Settings.CrystalWaveAmplitude}"
                                                AutomationProperties.AutomationId="Settings.CrystalWaveAmplitude"
                                                Minimum="{Binding CrystalWaveAmplitudeMin}"
                                                Maximum="{Binding CrystalWaveAmplitudeMax}"
                                                Value="{Binding CrystalWaveAmplitude, Mode=TwoWay}"
                                                VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" TextAlignment="Right"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding CrystalWaveAmplitude, Mode=OneWay, StringFormat={}{0:0.0}}"/>
                                        </Grid>
                                    </StackPanel>

                                                                        <StackPanel Margin="{StaticResource SettingsAxisRowMargin}">
                                        <TextBlock Text="{DynamicResource Settings.CrystalCausticIntensity}"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   Margin="{StaticResource SettingsAxisLabelMargin}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="52"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Style="{StaticResource ModernSliderStyle}"
                                        AutomationProperties.Name="{DynamicResource Settings.CrystalCausticIntensity}"
                                                AutomationProperties.AutomationId="Settings.CrystalCausticIntensity"
                                                Minimum="{Binding CrystalCausticIntensityMin}"
                                                Maximum="{Binding CrystalCausticIntensityMax}"
                                                Value="{Binding CrystalCausticIntensity, Mode=TwoWay}"
                                                VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" TextAlignment="Right"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding CrystalCausticIntensity, Mode=OneWay, StringFormat={}{0:0.00}}"/>
                                        </Grid>
                                    </StackPanel>

                                                                        <StackPanel Margin="{StaticResource SettingsAxisRowMargin}">
                                        <TextBlock Text="{DynamicResource Settings.CrystalBubbleIntensity}"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   Margin="{StaticResource SettingsAxisLabelMargin}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="52"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Style="{StaticResource ModernSliderStyle}"
                                        AutomationProperties.Name="{DynamicResource Settings.CrystalBubbleIntensity}"
                                                AutomationProperties.AutomationId="Settings.CrystalBubbleIntensity"
                                                Minimum="{Binding CrystalBubbleIntensityMin}"
                                                Maximum="{Binding CrystalBubbleIntensityMax}"
                                                Value="{Binding CrystalBubbleIntensity, Mode=TwoWay}"
                                                VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" TextAlignment="Right"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding CrystalBubbleIntensity, Mode=OneWay, StringFormat={}{0:0.00}}"/>
                                        </Grid>
                                    </StackPanel>

                                                                        <StackPanel Margin="{StaticResource SettingsAxisRowMargin}">
                                        <TextBlock Text="{DynamicResource Settings.CrystalReflectionOpacity}"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   Margin="{StaticResource SettingsAxisLabelMargin}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="52"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Style="{StaticResource ModernSliderStyle}"
                                        AutomationProperties.Name="{DynamicResource Settings.CrystalReflectionOpacity}"
                                                AutomationProperties.AutomationId="Settings.CrystalReflectionOpacity"
                                                Minimum="{Binding CrystalReflectionOpacityMin}"
                                                Maximum="{Binding CrystalReflectionOpacityMax}"
                                                Value="{Binding CrystalReflectionOpacity, Mode=TwoWay}"
                                                VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" TextAlignment="Right"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding CrystalReflectionOpacity, Mode=OneWay, StringFormat={}{0:0.00}}"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Live preview: the same CrystalWaterControl the real
                                 screens use. Its default style feeds WaterOpacity /
                                 WaterSpeed / WaveAmplitude / BubbleOpacity from the
                                 Crystal* tokens, so dragging the axes above repaints
                                 this reservoir live. -->
                            <Border Margin="{StaticResource SettingsStackGap14}" Style="{StaticResource SettingsInnerTileStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8EC;"/>
                                        <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center"
                                                   Text="{DynamicResource Settings.PreviewTitle}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                               Text="{DynamicResource Settings.CrystalPreviewHint}"/>
                                    <Border CornerRadius="{DynamicResource CardCornerRadius}"
                                            Background="{DynamicResource SurfaceSecondaryBrush}"
                                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                                            BorderThickness="{DynamicResource Border.HairlineThickness}"
                                            Margin="{StaticResource SettingsStackGap8}"
                                            Height="150"
                                            SnapsToDevicePixels="True" Style="{StaticResource SettingsInnerTileStyle}">
                                        <crystal:CrystalWaterControl
                                            WaterEnabled="{DynamicResource CrystalWaterDefaultEnabled}"
                                            WaterLevel="0.4"
                                            CornerRadius="{DynamicResource CardCornerRadius}"
                                            IsHitTestVisible="False"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ═══ CARD — WALLPAPERS LINKED NOTICE ═══
                     Wallpaper library and per-module wallpaper controls are cleanly
                     centralized in Settings -> Appearance -> Wallpapers to eliminate
                     UI duplication across pages. -->
                <Border Style="{StaticResource SettingsPageCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xEB9F;"/>
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center"
                                       Text="{DynamicResource Settings.Wallpapers}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                   Text="Wallpapers and background scenes are managed centrally in Appearance to keep your workspace streamlined."/>
                        <Button Style="{StaticResource RowOutlinedButton}" Height="30" Padding="14,0" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Command="{Binding NavigateSettingsPageCommand}" CommandParameter="Appearance"
                                Content="Open Wallpapers in Appearance"/>
                    </StackPanel>
                </Border>

                <!-- ═══ GROUP: CRYSTAL INACTIVE HINT (Normal/Monet only) ═══ -->
                <Border Style="{StaticResource SettingsPageCardStyle}"
                        Visibility="{Binding IsCrystalThemeActive,
                            Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel>
                        <Border 
        Style="{StaticResource SettingsInnerTileStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE946;"/>
                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center"
                                       Text="{DynamicResource Settings.SecThemes}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                   Text="{DynamicResource Settings.CrystalOnlyIos17pm}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
