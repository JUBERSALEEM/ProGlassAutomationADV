<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsThemesSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — THEMES page (2026-09-06)
     Replaces the removed Theme Studio (0–100 playground) with its one
     legitimate capability: bounded, persisted Crystal Fluid (Ios-17pm)
     material tuning. FAMILY-AWARE:
       · The visual-theme family ComboBox and the per-family Reset are
         always visible.
       · The Crystal Fluid material group (quick presets + six live axes
         + live water preview) is only visible while Ios-17pm is active
         (SettingsViewModel.IsCrystalThemeActive).
       · Normal / Monet keep their existing Appearance controls
         (CardCornerRadius, CardBorderThickness, UseGradientSurfaces);
         a hint tile points back to Appearance when Crystal is inactive.
     Six LIVE axes only (water opacity/speed, wave amplitude, caustic,
     bubble, reflection opacity). Glass/glass-border/shadow opacity stay
     parked in CrystalFluidSettings — no fake controls.
     Bindings target SettingsViewModel (DataContext flows from shell).
═══════════════════════════════════════════════════════════════════ -->
<UserControl
             xmlns:cards="clr-namespace:ProGlassAutomation.Views.Settings.Sections.Cards" x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsThemesSection"
             xmlns:crystal="clr-namespace:ProGlassAutomation.Controls.CrystalFluid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             RenderOptions.ClearTypeHint="Enabled"
             RenderOptions.EdgeMode="Aliased">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}">
            <StackPanel Margin="{StaticResource SettingsPagePadding}">

                <!-- ═══ BENTO HERO BANNER — THEMES & SURFACE TUNING ═══ -->
                <Border Style="{StaticResource SettingsHeroCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SettingsHeroIconTileStyle}">
                            <TextBlock Text="&#xE790;" Style="{StaticResource SettingsHeroIconGlyphStyle}"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center">
                            <TextBlock Text="Themes &amp; Surface Tuning" Style="{StaticResource SettingsHeroTitleStyle}"/>
                            <TextBlock Text="Bounded material precision tuning, porcelain contrast, and real-time fluid refraction" Style="{StaticResource SettingsHeroNoteStyle}"/>
                        </StackPanel>

                        <Border Grid.Column="2" Style="{StaticResource SettingsHeroBadgeStyle}">
                            <TextBlock Text="Studio Engine" Style="{StaticResource SettingsHeroBadgeTextStyle}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- ═══ CARD — VISUAL THEME (always visible) ═══ -->
                <Border Style="{StaticResource SettingsPageCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.LblThemeFamily}"
                                   Style="{StaticResource SettingsCardTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Settings.NormalMonetIos17pm}"
                                   Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                        <UniformGrid Columns="2" Margin="{StaticResource SettingsTileGridBleed}">
                            <StackPanel Margin="{StaticResource SettingsTileGridMargin}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE790;"/>
                                    <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center"
                                               Text="{DynamicResource Settings.LblThemeFamily}"/>
                                </StackPanel>
                                <ComboBox AutomationProperties.AutomationId="Settings.VisualTheme"
                                          ItemsSource="{Binding VisualThemeOptions}"
                                          DisplayMemberPath="Display"
                                          SelectedValuePath="Key"
                                          SelectedValue="{Binding SelectedVisualTheme, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          Padding="10,7" FontSize="{DynamicResource FontSize.Title}" Style="{StaticResource ComboBoxStyle}"/>
                            </StackPanel>

                            <!-- Base Light / Dark Mode Toggle -->
                            <StackPanel Margin="{StaticResource SettingsTileGridMargin}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE706;"/>
                                    <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center"
                                               Text="{DynamicResource Settings.Mode}"/>
                                </StackPanel>
                                <ListBox Style="{StaticResource SettingsSegmentTrackFillStyle}"
                                         AutomationProperties.Name="{DynamicResource Settings.Mode}"
                                         SelectedValuePath="Tag"
                                         SelectedValue="{Binding ThemeMode, Mode=TwoWay}"
                                         AutomationProperties.AutomationId="Settings.ThemeModeStudio">
                                    <ListBoxItem Tag="Light" Content="{DynamicResource Settings.ModeLight}" Style="{StaticResource SettingsSegmentItemStyle}"/>
                                    <ListBoxItem Tag="Dark" Content="{DynamicResource Settings.ModeDark}" Style="{StaticResource SettingsSegmentItemStyle}"/>
                                </ListBox>
                            </StackPanel>
                        </UniformGrid>

                        <!-- Brand Accent Palette Directly Inside Theme Studio -->
                        <StackPanel Margin="{StaticResource SettingsStackGap14}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE790;"/>
                                    <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center"
                                               Text="{DynamicResource Settings.LblAccent}"/>
                                </StackPanel>
                                <!-- Action Strip: Theme Reset, Export & Import Theme Pack -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button AutomationProperties.AutomationId="Settings.ExportThemePackStudio"
                                            Command="{Binding ExportThemeProfileCommand}"
                                            Style="{StaticResource RowOutlinedButton}" Height="28" Padding="10,0" Margin="{StaticResource SettingsInlineGap6R}"
                                            ToolTip="Export theme pack configuration to clipboard"
                                            Content="Export Pack"/>
                                    <Button AutomationProperties.AutomationId="Settings.ImportThemePackStudio"
                                            Command="{Binding ImportThemeProfileCommand}"
                                            Style="{StaticResource RowOutlinedButton}" Height="28" Padding="10,0" Margin="{StaticResource SettingsInlineGap6R}"
                                            ToolTip="Import theme pack configuration from clipboard"
                                            Content="Import Pack"/>
                                    <Button AutomationProperties.AutomationId="Settings.ResetThemeFamilyStudio"
                                            Command="{Binding ResetThemeFamilyCommand}"
                                            Style="{StaticResource RowOutlinedButton}" Height="28" Padding="10,0"
                                            Content="{DynamicResource Settings.ResetThemeFamily}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                       Text="{DynamicResource Settings.ButtonsTintsHoverStatesMonetGlassSurfaces}"/>

                            <ItemsControl ItemsSource="{Binding AccentPalette}" Margin="{StaticResource SettingsStackGap4}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ApplyAccentCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Key}"
                                                Style="{StaticResource AccentChipStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="11" Height="11" Fill="{Binding Swatch}"
                                                         VerticalAlignment="Center" Margin="{StaticResource SettingsInlineGap8R}"/>
                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Live Interactive Component Deck -->
                            <Border Margin="{StaticResource SettingsStackGap12}" Padding="14,12" Background="{DynamicResource SurfaceSecondaryBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}"
                                    CornerRadius="{DynamicResource CardCornerRadius}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="10" Height="10" CornerRadius="{DynamicResource Radius.Small}" Background="{DynamicResource AccentBrush}" Margin="{StaticResource SettingsInlineGap8R}"/>
                                            <TextBlock Text="Live Studio Specimen" FontSize="{DynamicResource FontSize.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="Real-time theme engine tokens verified with automatic WCAG contrast derivation."
                                                   FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="{StaticResource SettingsStackGap4}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource TintBlueBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="10,4" Margin="{StaticResource SettingsInlineGap6R}">
                                            <TextBlock Text="Active Accent" FontSize="{DynamicResource FontSize.Chip}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <Border Background="{DynamicResource TintGreenBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="10,4">
                                            <TextBlock Text="WCAG AAA" FontSize="{DynamicResource FontSize.Chip}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="{StaticResource SettingsStackGap10}" Padding="12,8"
                                            Background="{DynamicResource SurfacePrimaryBrush}"
                                            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}"
                                            CornerRadius="{DynamicResource Radius.Small}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="{StaticResource SettingsInlineGap8R}"/>
                                                <TextBlock Text="Tokens active across all sales, production, about, and settings views."
                                                           FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource PrimaryPillButton}" Height="26" Padding="14,0" Content="Test State" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Visibility="{Binding IsCrystalThemeActive,
                    Converter={StaticResource BoolToVisibilityConverter}}">

                    <!-- ═══ CARD — CRYSTAL FLUID MATERIAL (Ios-17pm only) ═══ -->
                    <cards:ThemesCrystalMaterialCard/>
                </StackPanel>

                <!-- ═══ CARD — WALLPAPERS LINKED NOTICE ═══
                     Wallpaper library and per-module wallpaper controls are cleanly
                     centralized in Settings -> Appearance -> Wallpapers to eliminate
                     UI duplication across pages. -->
                <Border Style="{StaticResource SettingsPageCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xEB9F;"/>
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center"
                                       Text="{DynamicResource Settings.Wallpapers}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                   Text="Wallpapers and background scenes are managed centrally in Appearance to keep your workspace streamlined."/>
                        <Button Style="{StaticResource RowOutlinedButton}" Height="30" Padding="14,0" HorizontalAlignment="Left" Margin="{StaticResource SettingsStackGap8}"
                                Command="{Binding SwitchSettingsPageCommand}" CommandParameter="Appearance"
                                Content="Open Wallpapers in Appearance"/>
                    </StackPanel>
                </Border>

                <!-- ═══ GROUP: CRYSTAL INACTIVE HINT (Normal/Monet only) ═══ -->
                <Border Style="{StaticResource SettingsPageCardStyle}"
                        Visibility="{Binding IsCrystalThemeActive,
                            Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource SettingsRowMargin}">
                            <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE946;" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center"
                                   Text="{DynamicResource Settings.SecThemes}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                   Text="{DynamicResource Settings.CrystalOnlyIos17pm}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
