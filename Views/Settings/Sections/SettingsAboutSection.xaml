<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsAboutSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings — ABOUT page (2026-09-16 grammar rewrite)

     WHAT CHANGED AND WHY
     ────────────────────
       • Duplicate page title + subtitle removed: the shell header strip
         already names the page.
       • Every card was `SurfacePrimaryStyle` with a second
         `SurfaceDetailStyle` Border wrapped around its header row — a card
         inside a card, three indentation levels deep. Now: one
         SettingsPageCardStyle per card, header built from the icon tile +
         title roles.
       • `<Border Style="SurfaceDetailStyle"/>` used as a vertical gap →
         real spacing.
       • The four "learn more" cards keep the UniformGrid so the page still
         reads as a grid on wide screens, but each one is the same material
         as the version card above it.
       • Fact lines moved from Typography.Caption to SettingsRowMetaStyle so
         they inherit the grammar's muted ink and sizes.

     All content keys and the CurrentVersionDisplay binding are unchanged.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsAboutSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             RenderOptions.ClearTypeHint="Enabled"
             RenderOptions.EdgeMode="Aliased">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly"
                  behaviors:SmoothScrollBehavior.IsEnabled="True"
                  Focusable="False"
                  FocusVisualStyle="{x:Null}"
                  Padding="{StaticResource SettingsPagePadding}">
        <StackPanel>

            <!-- ═══ BENTO HERO BANNER — ABOUT & KNOWLEDGE BASE ═══ -->
            <Border Style="{StaticResource SettingsHeroCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SettingsHeroIconTileStyle}">
                        <TextBlock Text="&#xE946;" Style="{StaticResource SettingsHeroIconGlyphStyle}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center">
                        <TextBlock Text="About &amp; Knowledge Base" Style="{StaticResource SettingsHeroTitleStyle}"/>
                        <TextBlock Text="System architecture, offline neural models, DPAPI privacy guarantees, and workstation diagnostics" Style="{StaticResource SettingsHeroNoteStyle}"/>
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource SettingsHeroBadgeStyle}">
                        <TextBlock Text="ProGlass 2026" Style="{StaticResource SettingsHeroBadgeTextStyle}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ CARD — APPLICATION ═══ -->
            <Border Style="{StaticResource SettingsPageCardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                            <TextBlock Text="&#xE946;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="{StaticResource SettingsIconTextMargin}"
                                    VerticalAlignment="Center">
                            <TextBlock Text="ProGlass Automation"
                                       Style="{StaticResource SettingsCardTitleStyle}"/>
                            <TextBlock Text="{DynamicResource Settings.ProductVersionRunningMachine}"
                                       Style="{StaticResource SettingsRowMetaStyle}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Style="{StaticResource SettingsValuePillStyle}"
                                Margin="{StaticResource SettingsInlineGap12}"
                                VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingsValuePillTextStyle}">
                                <Run Text="{DynamicResource Settings.InstalledVersion}"/><Run Text=" "/>
                                <Run Text="{Binding CurrentVersionDisplay, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource SettingsRowSeparatorStyle}"/>

                    <TextBlock Text="{DynamicResource Settings.BuiltUAEGlassFabricators}"
                               Style="{StaticResource SettingsCardNoteStyle}"/>
                </StackPanel>
            </Border>

            <!-- ═══ CARD — LEARN MORE ═══ -->
            <Border Style="{StaticResource SettingsPageCardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                            <TextBlock Text="&#xE7BE;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="{StaticResource SettingsIconTextMargin}"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Settings.LearnMORE}"
                                       Style="{StaticResource SettingsCardTitleStyle}"/>
                            <TextBlock Text="{DynamicResource Settings.ShortExplainersThemeSystemAIAssistantPrivacy}"
                                       Style="{StaticResource SettingsRowMetaStyle}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <UniformGrid Columns="2" Margin="{StaticResource SettingsTileGridBleedKeepTop}">

                        <!-- About the Theme System -->
                        <StackPanel Margin="{StaticResource SettingsTileGridMargin}">
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource SettingsRowMargin}">
                                <Border Style="{StaticResource SettingsIconTileStyle}"
                                        Width="26" Height="26"
                                        Background="{DynamicResource Ios26ValuePillBrush}">
                                    <TextBlock Text="&#xE790;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Settings.AboutThemeSystem}"
                                           Style="{StaticResource SettingsRowTitleStyle}"
                                           Margin="{StaticResource SettingsIconTextMargin}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsCardNoteStyle}">
                                <Run Text="{DynamicResource Settings.ProglassAutomationShips}"/><Run Text="{DynamicResource Settings.TwoHandCraftedThemes}"/><Run Text="{DynamicResource Settings.LightDefaultDark}"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.AboutLightTheme}"/>
                            <TextBlock Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.AboutDarkTheme}"/>
                            <TextBlock Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.AboutInstantSwap}"/>
                        </StackPanel>

                        <!-- About the AI Assistant -->
                        <StackPanel Margin="{StaticResource SettingsTileGridMargin}">
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource SettingsRowMargin}">
                                <Border Style="{StaticResource SettingsIconTileStyle}"
                                        Width="26" Height="26"
                                        Background="{DynamicResource Ios26ValuePillBrush}">
                                    <TextBlock Text="&#xE8F2;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Settings.AboutAIAssistant}"
                                           Style="{StaticResource SettingsRowTitleStyle}"
                                           Margin="{StaticResource SettingsIconTextMargin}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsCardNoteStyle}">
                                <Run Text="{DynamicResource Settings.OptionalAIAssistantSupports}"/><Run Text="{DynamicResource Settings.GoogleGeminiGroqCohere}"/><Run Text="{DynamicResource Settings.FreeTiersTailoredUAEGlassManufacturing}"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.AboutOptIn}"/>
                            <TextBlock Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.AboutContextAware}"/>
                            <TextBlock Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.AboutVoiceInput}"/>
                        </StackPanel>

                        <!-- About Your API Key & Privacy -->
                        <StackPanel Margin="{StaticResource SettingsTileGridMargin}">
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource SettingsRowMargin}">
                                <Border Style="{StaticResource SettingsIconTileStyle}"
                                        Width="26" Height="26"
                                        Background="{DynamicResource Ios26ValuePillBrush}">
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Settings.AboutAPIKeyPrivacy}"
                                           Style="{StaticResource SettingsRowTitleStyle}"
                                           Margin="{StaticResource SettingsIconTextMargin}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsCardNoteStyle}">
                                <Run Text="{DynamicResource Settings.APIKeyStored}"/><Run Text="{DynamicResource Settings.LocalMachine}"/><Run Text="{DynamicResource Settings.AppdataNeverLeavesPCExceptDirectHttps}"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.AboutStoredAt}"/>
                            <TextBlock Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.AboutNoTelemetry}"/>
                        </StackPanel>

                        <!-- About Voice Models -->
                        <StackPanel Margin="{StaticResource SettingsTileGridMargin}">
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource SettingsRowMargin}">
                                <Border Style="{StaticResource SettingsIconTileStyle}"
                                        Width="26" Height="26"
                                        Background="{DynamicResource Ios26ValuePillBrush}">
                                    <TextBlock Text="&#xE720;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Settings.AboutVoiceModels}"
                                           Style="{StaticResource SettingsRowTitleStyle}"
                                           Margin="{StaticResource SettingsIconTextMargin}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsCardNoteStyle}">
                                <Run Text="{DynamicResource Settings.ThreeWhisperModelSizesAvailable}"/><Run Text="{DynamicResource Settings.BaseRecommended}"/><Run Text="{DynamicResource Settings.MostUsersFastAccurate142MB}"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.AboutModelBase}"/>
                            <TextBlock Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.AboutModelMedium}"/>
                            <TextBlock Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.AboutModelLarge}"/>
                            <TextBlock Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.AboutModelsOffline}"/>
                        </StackPanel>

                    </UniformGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
