<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsAboutSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — ABOUT & HELP page (tile-grid redesign Aug 2026)

     REDESIGN
       Was: one version strip plus four full-width InfoCard boxes
       stacked vertically. On a wide monitor each info card stretched
       the whole pane with its bullet list, so 60% of horizontal space
       was empty and the page was a very long scroll.

       Now: the four knowledge cards become 660-wide tiles that reflow
       into two per row in the WrapPanel. Each keeps its glyph badge +
       title + paragraph + bullets so the same information is legible,
       just arranged professionally instead of stacked. The version
       card stays at the top as a wide tile. All one binding
       (CurrentVersionDisplay) preserved.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsAboutSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,26,32,14">
            <TextBlock Text="{DynamicResource Settings.SecAbout}" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="{DynamicResource Settings.HowProglassWorksHood}"
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}">
            <StackPanel Margin="32,0,32,32">

                <!-- ═══════ GROUP: APPLICATION ═══════ -->
                <TextBlock Text="{DynamicResource Settings.Application}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.ProductVersionRunningMachine}"
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <StackPanel Margin="0,0,0,6">
                    <!-- Version card -->
                    <Border Style="{StaticResource SettingsWideTileStyle}">
                        <DockPanel>
                            <Border Style="{StaticResource InfoGlyphBadgeStyle}" DockPanel.Dock="Left">
                                <TextBlock Text="&#xE946;" Style="{StaticResource InfoGlyphTextStyle}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ProGlass Automation"
                                           Style="{StaticResource SettingsTileTitleStyle}"/>
                                <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                           Margin="0,2,0,0">
                                    <Run Text="{DynamicResource Settings.InstalledVersion}"/><Run Text=" "/>
                                    <Run Text="{Binding CurrentVersionDisplay, Mode=OneWay}" FontWeight="Bold"/>
                                    <Run Text="{DynamicResource Settings.BuiltUAEGlassFabricators}"/>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource SettingsGroupSeparatorStyle}"/>

                <!-- ═══════ GROUP: LEARN MORE ═══════ -->
                <TextBlock Text="{DynamicResource Settings.LearnMORE}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.ShortExplainersThemeSystemAIAssistantPrivacy}"
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <UniformGrid Columns="3" Margin="0,0,0,6">

                    <!-- About the Theme System -->
                    <Border Style="{StaticResource SettingsWideTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <Border Style="{StaticResource InfoGlyphBadgeStyle}" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE790;" Style="{StaticResource InfoGlyphTextStyle}"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Settings.AboutThemeSystem}"
                                           Style="{StaticResource SettingsTileTitleStyle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}">
                                <Run Text="{DynamicResource Settings.ProglassAutomationShips}"/><Run Text="{DynamicResource Settings.TwoHandCraftedThemes}" FontWeight="Bold"/><Run Text="{DynamicResource Settings.LightDefaultDark}"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}" Text="{DynamicResource Settings.AboutLightTheme}"/>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}" Text="{DynamicResource Settings.AboutDarkTheme}"/>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}" Text="{DynamicResource Settings.AboutInstantSwap}"/>
                        </StackPanel>
                    </Border>

                    <!-- About the AI Assistant -->
                    <Border Style="{StaticResource SettingsWideTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <Border Style="{StaticResource InfoGlyphBadgeStyle}" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE8F2;" Style="{StaticResource InfoGlyphTextStyle}"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Settings.AboutAIAssistant}"
                                           Style="{StaticResource SettingsTileTitleStyle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}">
                                <Run Text="{DynamicResource Settings.OptionalAIAssistantSupports}"/><Run Text="{DynamicResource Settings.GoogleGeminiGroqCohere}" FontWeight="Bold"/><Run Text="{DynamicResource Settings.FreeTiersTailoredUAEGlassManufacturing}"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}" Text="{DynamicResource Settings.AboutOptIn}"/>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}" Text="{DynamicResource Settings.AboutContextAware}"/>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}" Text="{DynamicResource Settings.AboutVoiceInput}"/>
                        </StackPanel>
                    </Border>

                    <!-- About Your API Key & Privacy -->
                    <Border Style="{StaticResource SettingsWideTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <Border Style="{StaticResource InfoGlyphBadgeStyle}" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource InfoGlyphTextStyle}"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Settings.AboutAPIKeyPrivacy}"
                                           Style="{StaticResource SettingsTileTitleStyle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}">
                                <Run Text="{DynamicResource Settings.APIKeyStored}"/><Run Text="{DynamicResource Settings.LocalMachine}" FontWeight="Bold"/><Run Text="{DynamicResource Settings.AppdataNeverLeavesPCExceptDirectHttps}"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}" Text="{DynamicResource Settings.AboutStoredAt}"/>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}" Text="{DynamicResource Settings.AboutNoTelemetry}"/>
                        </StackPanel>
                    </Border>

                    <!-- About Voice Models -->
                    <Border Style="{StaticResource SettingsWideTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <Border Style="{StaticResource InfoGlyphBadgeStyle}" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE720;" Style="{StaticResource InfoGlyphTextStyle}"/>
                                </Border>
                                <TextBlock Text="{DynamicResource Settings.AboutVoiceModels}"
                                           Style="{StaticResource SettingsTileTitleStyle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}">
                                <Run Text="{DynamicResource Settings.ThreeWhisperModelSizesAvailable}"/><Run Text="{DynamicResource Settings.BaseRecommended}" FontWeight="Bold"/><Run Text="{DynamicResource Settings.MostUsersFastAccurate142MB}"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}" Text="{DynamicResource Settings.AboutModelBase}"/>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}" Text="{DynamicResource Settings.AboutModelMedium}"/>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}" Text="{DynamicResource Settings.AboutModelLarge}"/>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}" Text="{DynamicResource Settings.AboutModelsOffline}"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
