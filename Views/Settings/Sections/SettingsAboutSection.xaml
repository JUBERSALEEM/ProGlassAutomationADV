<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsAboutSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — ABOUT & HELP page

     Product knowledge cards: theme system · AI assistant · privacy ·
     voice models — plus the running version.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsAboutSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,26,32,14">
            <TextBlock Text="About &amp; Help" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="How ProGlass works under the hood."
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}">
            <StackPanel Margin="32,0,32,32">

                <!-- ── VERSION CARD ───────────────────────────────── -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <DockPanel>
                        <Border Style="{StaticResource InfoGlyphBadgeStyle}">
                            <TextBlock Text="&#xE946;" Style="{StaticResource InfoGlyphTextStyle}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ProGlass Automation"
                                       Style="{StaticResource RowTitleStyle}"/>
                            <TextBlock FontSize="11" Margin="0,2,0,0"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}">
                                <Run Text="Installed version"/>
                                <Run Text="{Binding CurrentVersionDisplay, Mode=OneWay}"
                                     FontWeight="Bold"/>
                                <Run Text="— built for UAE glass fabricators."/>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ── ABOUT THE THEME SYSTEM ─────────────────────── -->
                <Border Style="{StaticResource InfoCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource InfoGlyphBadgeStyle}">
                                <TextBlock Text="&#xE790;" Style="{StaticResource InfoGlyphTextStyle}"/>
                            </Border>
                            <TextBlock Text="About the Theme System"
                                       Style="{StaticResource InfoCardTitleStyle}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource InfoCardBodyStyle}">
                            <Run Text="ProGlass Automation ships with"/>
                            <Run Text=" two hand-crafted themes" FontWeight="Bold"/>
                            <Run Text=" — Light (default) and Dark."/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                            <Run Text="•" FontWeight="Bold"/>
                            <Run Text=" Light theme — optimized for daylight factory floor use."/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                            <Run Text="•" FontWeight="Bold"/>
                            <Run Text=" Dark theme — easier on the eyes during late-night shifts."/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                            <Run Text="•" FontWeight="Bold"/>
                            <Run Text=" Instant swap — no restart required."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ── ABOUT THE AI ASSISTANT ─────────────────────── -->
                <Border Style="{StaticResource InfoCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource InfoGlyphBadgeStyle}">
                                <TextBlock Text="&#xE8F2;" Style="{StaticResource InfoGlyphTextStyle}"/>
                            </Border>
                            <TextBlock Text="About the AI Assistant"
                                       Style="{StaticResource InfoCardTitleStyle}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource InfoCardBodyStyle}">
                            <Run Text="The optional AI Assistant supports"/>
                            <Run Text=" Google Gemini, Groq, and Cohere" FontWeight="Bold"/>
                            <Run Text=" — all free tiers. Tailored for UAE glass manufacturing."/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                            <Run Text="•" FontWeight="Bold"/>
                            <Run Text=" 100% opt-in — uses your own API key."/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                            <Run Text="•" FontWeight="Bold"/>
                            <Run Text=" Context-aware — knows glass types, VAT rules, app modules."/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                            <Run Text="•" FontWeight="Bold"/>
                            <Run Text=" Voice input via Whisper — offline, 95%+ accuracy."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ── ABOUT YOUR API KEY & PRIVACY ───────────────── -->
                <Border Style="{StaticResource InfoCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource InfoGlyphBadgeStyle}">
                                <TextBlock Text="&#xE72E;" Style="{StaticResource InfoGlyphTextStyle}"/>
                            </Border>
                            <TextBlock Text="About Your API Key &amp; Privacy"
                                       Style="{StaticResource InfoCardTitleStyle}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource InfoCardBodyStyle}">
                            <Run Text="Your API key is stored"/>
                            <Run Text=" only on your local machine" FontWeight="Bold"/>
                            <Run Text=" in AppData. It never leaves your PC except for direct HTTPS requests to the AI provider."/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                            <Run Text="•" FontWeight="Bold"/>
                            <Run Text=" Stored at %AppData%\ProGlassAutomation\config.json."/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                            <Run Text="•" FontWeight="Bold"/>
                            <Run Text=" No telemetry — zero analytics sent anywhere."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ── ABOUT VOICE MODELS ─────────────────────────── -->
                <Border Style="{StaticResource InfoCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource InfoGlyphBadgeStyle}">
                                <TextBlock Text="&#xE720;" Style="{StaticResource InfoGlyphTextStyle}"/>
                            </Border>
                            <TextBlock Text="About Voice Models"
                                       Style="{StaticResource InfoCardTitleStyle}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource InfoCardBodyStyle}">
                            <Run Text="Three Whisper model sizes are available."/>
                            <Run Text=" Base is recommended" FontWeight="Bold"/>
                            <Run Text=" for most users — fast, accurate, only 142 MB."/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                            <Run Text="•" FontWeight="Bold"/>
                            <Run Text=" Base (142 MB) — 95%+ accuracy. Best for daily use."/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                            <Run Text="•" FontWeight="Bold"/>
                            <Run Text=" Medium (1.5 GB) — 97%+ accuracy. Noisy environments."/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                            <Run Text="•" FontWeight="Bold"/>
                            <Run Text=" Large v3 (3.1 GB) — 99%+ accuracy. Maximum quality."/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource InfoCardBulletStyle}">
                            <Run Text="•" FontWeight="Bold"/>
                            <Run Text=" All models run fully OFFLINE — no internet after download."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
