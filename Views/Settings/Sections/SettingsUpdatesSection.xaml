<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsUpdatesSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — UPDATES page (OTA) — tile-grid redesign Aug 2026

     REDESIGN
       Was: one giant full-width card that held the version grid, the
       Check/Download buttons, the progress bar, the ready-state block,
       the release-notes border and the update-history ledger all in a
       single stacked surface. That read as one long monolithic wall.

       Now: split into three labelled full-row tiles — OVERVIEW (version
       comparison + status), RELEASE NOTES, and UPDATE HISTORY — so the
       page breathes and the user can scan each part on its own. Every
       conditional visibility trigger (IsUpdateAvailable / IsUpdateReady /
       IsDownloadingUpdate / HasReleaseInfo / HasUpdateHistory) and all
       22 ViewModel bindings preserved.

       Check → download → install & restart. Installed builds use the
       Velopack path (SettingsViewModel routes); dev builds keep the
       classic GitHub-release + installer flow.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsUpdatesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,26,32,14">
            <TextBlock Text="{DynamicResource Settings.SecUpdates}" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="{DynamicResource Settings.KeepProglassLatestReleaseSafely}"
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}">
            <StackPanel Margin="32,0,32,32">

                <!-- ═══════ GROUP: OVERVIEW ═══════ -->
                <TextBlock Text="{DynamicResource Nav.Overview}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.RunningVersionAgainstLatestPublishedRelease}"
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <StackPanel Margin="0,0,0,6">
                    <Border Style="{StaticResource SettingsFullRowTileStyle}">
                        <StackPanel>
                            <!-- Version row: current vs latest -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Grid.Column="0"
                                        Background="{DynamicResource MenuHoverBrush}"
                                        CornerRadius="{DynamicResource CardCornerRadius}"
                                        Padding="14,10" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Settings.CurrentVersion}"
                                                   FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        <TextBlock FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                                   Margin="0,3,0,0"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}">
                                            <Run Text="{DynamicResource Settings.V}"/>
                                            <Run Text="{Binding CurrentVersionDisplay, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" Grid.Column="1"
                                        Background="{DynamicResource TintBlueBrush}"
                                        CornerRadius="{DynamicResource CardCornerRadius}"
                                        Padding="14,10" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Settings.LatestRelease}"
                                                   FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        <TextBlock FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                                   Margin="0,3,0,0"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Text="{Binding LatestVersionDisplay}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding UpdateStatus}"
                                       Style="{StaticResource SettingsTileCaptionStyle}"
                                       FontSize="{StaticResource TextBodyLarge}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding LastCheckedDisplay}"
                                       Style="{StaticResource SettingsTileFooterHintStyle}"/>

                            <!-- Full-width action row. CHECK takes the free space
                                 (star) so it always spans the card; DOWNLOAD is an
                                 auto column that collapses to 0 when hidden, so
                                 CHECK fills the full width when it's the only button. -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Style="{StaticResource PrimaryPillButton}"
                                        Tag="&#xE72C;" Content="{DynamicResource About.Update}"
                                        Command="{Binding CheckForUpdatesCommand}"
                                        HorizontalAlignment="Stretch"/>
                                <Button Grid.Column="1"
                                        Tag="&#xE896;" Content="{DynamicResource Settings.DownloadUpdate}"
                                        Command="{Binding DownloadUpdateCommand}"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Stretch">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <!-- hidden again once the download is ready -->
                                                <DataTrigger Binding="{Binding IsUpdateReady}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <!-- READY STATE — install & restart -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,10,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUpdateReady}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                        Tag="&#xE74E;" Content="{DynamicResource Settings.InstallRestart}"
                                        Command="{Binding InstallUpdateCommand}"/>
                                <TextBlock Text="{DynamicResource Settings.InstallLaterFileStaysDownloadsFolder}"
                                           FontSize="{StaticResource TextCaption}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedForegroundBrush}"/>
                            </StackPanel>

                            <!-- Mode=OneWay: UpdateDownloadProgress is read-only
                                 from XAML's perspective (private setter) — TwoWay
                                 would throw InvalidOperationException (ERR-441A02). -->
                            <ProgressBar Value="{Binding UpdateDownloadProgress, Mode=OneWay}"
                                         Maximum="100"
                                         Height="6"
                                         Margin="0,10,0,0">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDownloadingUpdate}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource SettingsGroupSeparatorStyle}"/>

                <!-- ═══════ GROUP: RELEASE NOTES ═══════ -->
                <TextBlock Text="{DynamicResource Settings.ReleaseNotes}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.WhatReleaseChangesStraightPublisher}"
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <StackPanel Margin="0,0,0,6">
                    <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}"
                            Background="{DynamicResource MenuHoverBrush}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="14,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasReleaseInfo}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B8;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="{StaticResource TextSection}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding ReleaseNameDisplay}"
                                           FontSize="{StaticResource TextBodyLarge}" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                <TextBlock FontSize="{StaticResource TextBody}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedForegroundBrush}">
                                    <Run Text="{DynamicResource Settings.Published}"/>
                                    <Run Text="{Binding ReleasePublishedDisplay, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding ReleaseNotesPreview}"
                                       FontSize="{StaticResource TextBody}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       MaxHeight="90"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource SettingsGroupSeparatorStyle}"/>

                <!-- ═══════ GROUP: UPDATE HISTORY ═══════ -->
                <TextBlock Text="{DynamicResource Settings.UpdateHistory}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.CheckDownloadFailureRecordedMachine}"
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <StackPanel Margin="0,0,0,6">
                    <Border Style="{StaticResource SettingsFullRowTileStyle}">
                        <StackPanel>
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUpdateHistory}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <ItemsControl ItemsSource="{Binding UpdateHistory}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="{DynamicResource CardCornerRadius}" BorderBrush="{DynamicResource OutlineBrush}"
                                                    BorderThickness="{DynamicResource Border.BottomHairlineThickness}"
                                                    Padding="2,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               FontSize="{StaticResource TextBody}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource MutedForegroundBrush}">
                                                        <Run Text="{Binding TimestampUtc, Mode=OneWay,
                                                                    StringFormat='dd MMM yyyy HH:mm'}"/>
                                                    </TextBlock>
                                                    <Border Grid.Column="1"
                                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                                            Padding="8,2"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource TintBlueBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EventType}" Value="Downloaded">
                                                                        <Setter Property="Background"
                                                                                Value="{DynamicResource TintGreenBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding EventType}" Value="CheckFailed">
                                                                        <Setter Property="Background"
                                                                                Value="{DynamicResource TintRedBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding EventType}"
                                                                   FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="2"
                                                               FontSize="{StaticResource TextBody}"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Detail}"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}">
                                                        <Run Text="{DynamicResource Settings.V}"/>
                                                        <Run Text="{Binding Version, Mode=OneWay}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding ReleaseName, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Text="{DynamicResource Settings.NoUpdateHistoryYetCheckUpdatesRecordFirst}"
                                       Style="{StaticResource SettingsTileFooterHintStyle}"
                                       Visibility="{Binding HasUpdateHistory,
                                           Converter={StaticResource InverseBoolToVisibilityConverter},
                                           FallbackValue=Collapsed}"/>

                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="{DynamicResource Settings.InstalledBuildsUpdatePlaceVelopackRestart}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
