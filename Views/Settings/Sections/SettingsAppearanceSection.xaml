<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsAppearanceSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — APPEARANCE page

     Cards: theme mode · wallpaper · accent colour · motion &
     performance · module wallpapers.
     All bindings target SettingsViewModel (DataContext flows from shell).
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsAppearanceSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,26,32,14">
            <TextBlock Text="Appearance" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Theme, colours, wallpapers and motion."
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}">
            <StackPanel Margin="32,0,32,32">

                <!-- ── THEME MODE ─────────────────────────────────── -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="THEME MODE"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <!-- Dark Mode was MOVED to the top bar (before the AI
                             agent) — a single switch accessible from any
                             module. It is no longer here. -->

                        <TextBlock Text="Visual Theme"
                                   Style="{StaticResource RowTitleStyle}"
                                   Margin="0,16,0,6"/>
                        <ComboBox ItemsSource="{Binding VisualThemeOptions}"
                                  SelectedItem="{Binding SelectedVisualTheme}"
                                  MinWidth="200"
                                  Padding="10,7"
                                  FontSize="13"/>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Text="Normal = clean default. Monet = colour-adaptive glass derived from your accent colour. Professional = premium corporate with cool crisp surfaces. Glass = frosted translucency with a glass stage. Ocean = deep teal corporate. Your choice restyles the whole app instantly."/>

                        <!-- Defined card edge — one switch, applied globally
                             through the OutlineBrush theme key. -->
                        <Border Height="1" Margin="0,18,0,16"
                                Background="{DynamicResource DividerBrush}"/>

                        <DockPanel>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#xE71B;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="Defined Card Edges"
                                           Style="{StaticResource RowTitleStyle}"/>
                            </StackPanel>
                            <ToggleButton HorizontalAlignment="Right"
                                          IsChecked="{Binding UseDefinedOutline, Mode=TwoWay}"
                                          Style="{StaticResource ModernToggleSwitch}"/>
                        </DockPanel>

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Text="Draws a strong dark outline on rounded cards and pill buttons so they stay clearly separate from tinted surfaces instead of blending into them. Applies everywhere in the app and adapts to Light and Dark themes."/>

                        <Border Height="1" Margin="0,18,0,16"
                                Background="{DynamicResource DividerBrush}"/>

                        <!-- Global card border thickness — one control restyles
                             every card instead of editing them individually. -->
                        <DockPanel>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#xE72D;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="Card Border Thickness"
                                           Style="{StaticResource RowTitleStyle}"/>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}">
                                <Run Text="{Binding CardBorderThickness, Mode=OneWay, StringFormat={}{0:0.#}}"/>
                                <Run Text=" DIP"/>
                            </TextBlock>
                        </DockPanel>
                        <Slider Margin="0,10,0,0"
                                Style="{StaticResource ModernSliderStyle}"
                                Minimum="0" Maximum="4"
                                Value="{Binding CardBorderThickness, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Text="Sets the edge weight of every card and panel across the whole app (0 = no border). One setting, applied everywhere."/>

                        <Border Height="1" Margin="0,18,0,16"
                                Background="{DynamicResource DividerBrush}"/>

                        <DockPanel>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#xE7B3;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="Card Corner Radius"
                                           Style="{StaticResource RowTitleStyle}"/>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}">
                                <Run Text="{Binding CardCornerRadius, Mode=OneWay, StringFormat={}{0:0}}"/>
                                <Run Text=" px"/>
                            </TextBlock>
                        </DockPanel>
                        <Slider Margin="0,10,0,0"
                                Style="{StaticResource ModernSliderStyle}"
                                Minimum="0" Maximum="24"
                                TickFrequency="2"
                                IsSnapToTickEnabled="True"
                                Value="{Binding CardCornerRadius, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Text="How round every card AND button is. Default 12 px. 0 is a sharp rectangle. One slider restyles the whole app — cards, inputs and buttons together."/>

                        <Border Height="1" Margin="0,18,0,16"
                                Background="{DynamicResource DividerBrush}"/>

                        <DockPanel>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#xE740;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="Display Density"
                                           Style="{StaticResource RowTitleStyle}"/>
                            </StackPanel>
                            <ComboBox HorizontalAlignment="Right"
                                      MinWidth="180"
                                      Padding="10,7"
                                      FontSize="13"
                                      ItemsSource="{Binding DisplayDensityOptions}"
                                      SelectedItem="{Binding DisplayDensity}"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Text="Compact fits more of the glass grid on a laptop. Normal is the desktop default. Comfortable is larger touch targets. One switch — inputs, buttons, titles and card padding all follow it. Short laptops stay Compact even if a desktop session saved Comfortable."/>

                        <Border Height="1" Margin="0,18,0,16"
                                Background="{DynamicResource DividerBrush}"/>

                        <DockPanel>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#xE8A3;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="UI Scale"
                                           Style="{StaticResource RowTitleStyle}"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Margin="0,0,12,0">
                                    <Run Text="{Binding UiScalePercent, Mode=OneWay}"/>
                                    <Run Text="%"/>
                                </TextBlock>
                                <Button Content="RESET"
                                        Style="{StaticResource OutlinedPillButton}"
                                        Command="{Binding ResetUiScaleCommand}"
                                        Height="30" MinWidth="72"
                                        Padding="12,0"/>
                            </StackPanel>
                        </DockPanel>
                        <Slider Margin="0,10,0,0"
                                Style="{StaticResource ModernSliderStyle}"
                                Minimum="0.8" Maximum="1.25"
                                TickFrequency="0.05"
                                IsSnapToTickEnabled="True"
                                Value="{Binding UiScale, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Text="Ctrl + mouse wheel zooms the whole app. Ctrl + 0 resets to 100%. Zoom out shows more of the cut list on a laptop. Layouts reflow — this is not a frozen poster scale."/>

                        <Border Height="1" Margin="0,18,0,16"
                                Background="{DynamicResource DividerBrush}"/>

                        <DockPanel>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#xE8A5;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="PDF Layout"
                                           Style="{StaticResource RowTitleStyle}"/>
                            </StackPanel>
                            <ComboBox HorizontalAlignment="Right"
                                      MinWidth="200"
                                      Padding="10,7"
                                      FontSize="13"
                                      ItemsSource="{Binding PdfLayoutOptions}"
                                      SelectedItem="{Binding PdfLayout}"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Text="{Binding PdfLayoutHint}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Text="These are five different page architectures — letterhead, tables, cards, totals and signatures all change. Not a colour swap. Applies to PI, JO, DN, Tax Invoice, Statement and Sheet Store on the next export."/>
                    </StackPanel>
                </Border>

                <!-- ── WALLPAPER ──────────────────────────────────── -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="WALLPAPER"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Tag="&#xE728;" Content="SET WALLPAPER…"
                                    Command="{Binding SetWallpaperCommand}"/>
                            <Button Style="{StaticResource RowOutlinedButton}"
                                    Tag="&#xE711;" Content="CLEAR"
                                    Command="{Binding ClearWallpaperCommand}"
                                    Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding WallpaperStatus}"
                                   FontSize="11" Margin="0,8,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Text="One wallpaper, every view: the image is applied system-wide behind all modules. Per-module wallpapers below override it for individual screens."/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Wallpaper visibility"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <Slider Value="{Binding WallpaperOpacity}"
                                    Style="{StaticResource ModernSliderStyle}"
                                    Minimum="0.3" Maximum="1"
                                    Width="180"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── ACCENT COLOUR ──────────────────────────────── -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="ACCENT COLOUR"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Command="{Binding ApplyAccentCommand}" CommandParameter="GlassBlue" Style="{StaticResource AccentChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="11" Height="11" Fill="#0369A1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Glass Blue" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ApplyAccentCommand}" CommandParameter="Emerald" Style="{StaticResource AccentChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="11" Height="11" Fill="#059669" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Emerald" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ApplyAccentCommand}" CommandParameter="Amber" Style="{StaticResource AccentChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="11" Height="11" Fill="#D97706" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Amber" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ApplyAccentCommand}" CommandParameter="Rose" Style="{StaticResource AccentChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="11" Height="11" Fill="#E11D48" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Rose" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ApplyAccentCommand}" CommandParameter="Violet" Style="{StaticResource AccentChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="11" Height="11" Fill="#7C3AED" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Violet" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ApplyAccentCommand}" CommandParameter="Teal" Style="{StaticResource AccentChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="11" Height="11" Fill="#0D9488" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Teal" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Near-black (#111827), not pure #000000: a
                                 literal black edge on a near-black dark card
                                 is about 1.18:1 and reads as a hole. This
                                 stays neutral instead of being pushed to a
                                 blue-grey by the accent saturation floor. -->
                            <Button Command="{Binding ApplyAccentCommand}" CommandParameter="Black" Style="{StaticResource AccentChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="11" Height="11" Fill="#111827" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Black" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,2,0,0"
                                   Text="The whole UI adapts to the chosen accent — buttons, tints, hover states and Monet glass surfaces are all derived from it. Your choice is saved and restored on every start."/>
                    </StackPanel>
                </Border>

                <!-- ── GLOBAL FONT ─────────────────────────────────── -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="GLOBAL FONT"
                                   Style="{StaticResource SectionLabelStyle}"/>

                        <TextBlock Text="Font Family"
                                   Style="{StaticResource RowTitleStyle}"
                                   Margin="0,14,0,6"/>
                        <ComboBox ItemsSource="{Binding FontOptions}"
                                  SelectedItem="{Binding SelectedFont, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  MinWidth="260"
                                  Padding="10,7"
                                  FontSize="13"
                                  MaxDropDownHeight="320"/>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,8,0,0"
                                   Text="Every screen, dialog and table uses this family (icons stay on Segoe MDL2). You can import your own .ttf / .otf / .ttc / .fon file below."/>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Weight"
                                           Style="{StaticResource RowTitleStyle}"
                                           Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding FontWeightChoices}"
                                          SelectedItem="{Binding SelectedFontWeight, Mode=TwoWay}"
                                          Padding="10,7" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Style"
                                           Style="{StaticResource RowTitleStyle}"
                                           Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding FontStyleChoices}"
                                          SelectedItem="{Binding SelectedFontStyle, Mode=TwoWay}"
                                          Padding="10,7" FontSize="13"/>
                            </StackPanel>
                        </Grid>

                        <WrapPanel Margin="0,16,0,0">
                            <Button Command="{Binding ImportFontCommand}"
                                    Style="{StaticResource AccentChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="IMPORT FONT…" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ResetFontCommand}"
                                    Style="{StaticResource AccentChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="RESET" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,10,0,0"
                                   Text="{Binding FontStatus}"/>
                    </StackPanel>
                </Border>

                <!-- ── MOTION & PERFORMANCE ───────────────────────── -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="MOTION &amp; PERFORMANCE"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,6,0,0"
                                   Text="{Binding PerformanceTierDisplay}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,4,0,0"
                                   Text="Animations adapt to your display refresh rate (60/90/120/144/165 Hz)."/>
                    </StackPanel>
                </Border>

                <!-- ── MODULE WALLPAPERS ──────────────────────────── -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="MODULE WALLPAPERS"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,6,0,10"
                                   TextWrapping="Wrap"
                                   Text="Give any module its own background image. The image stays behind readable UI — surfaces become slightly transparent where the active theme supports it."/>

                        <ItemsControl ItemsSource="{Binding ModuleWallpaperRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="{DynamicResource CardCornerRadius}" BorderBrush="{DynamicResource OutlineBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="2,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"/>

                                            <!-- LAYOUT FIX: fixed 170px column with
                                                 no trimming clipped long module names
                                                 mid-character. Column 2 already trims. -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Label}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Label}"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding FileName}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="8,0"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                                            <StackPanel Grid.Column="3"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Slider Value="{Binding OpacityValue}"
                                                        Style="{StaticResource ModernSliderStyle}"
                                                        Minimum="0.3" Maximum="1"
                                                        Width="110"
                                                        ToolTip="Visibility"
                                                        VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource RowOutlinedButton}"
                                                        Tag="&#xE728;" Content="SET"
                                                        Command="{Binding DataContext.SetModuleWallpaperCommand,
                                                                            RelativeSource={RelativeSource
                                                                                AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="10,0,0,0"
                                                        FontSize="11"/>
                                            </StackPanel>

                                            <Button Grid.Column="4"
                                                    Style="{StaticResource RowDangerButton}"
                                                    Tag="&#xE711;" Content=""
                                                    Command="{Binding DataContext.ClearModuleWallpaperCommand,
                                                                RelativeSource={RelativeSource
                                                                    AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="8,0,0,0"
                                                    ToolTip="Remove this module's wallpaper"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
