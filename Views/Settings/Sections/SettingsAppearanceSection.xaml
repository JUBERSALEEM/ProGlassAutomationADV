<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsAppearanceSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — APPEARANCE page (redesigned Aug 2026)

     REDESIGN
       Was: one giant SectionCardStyle per subject (Theme mode, Wallpaper,
       Accent, Font, Motion, Module wallpapers) containing full-width
       DockPanel rows. On wide monitors that wasted 60-70% of horizontal
       space; on 1366 laptops it felt endless.

       Now: a WrapPanel of individual "tiles" (SettingsTileStyle) that
       auto-flow into 2-4 columns. Wide surfaces (module wallpaper list,
       accent palette) use SettingsWideTileStyle / SettingsFullRowTileStyle
       so they still get proper width when they need it. Every binding is
       preserved byte-for-byte — this is a layout redesign, not a data
       change.

     Bindings target SettingsViewModel (DataContext flows from shell).
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsAppearanceSection"
             xmlns:crystal="clr-namespace:ProGlassAutomation.Controls.CrystalFluid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,26,32,14">
            <TextBlock Text="{DynamicResource Settings.SecAppearance}" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="{DynamicResource Settings.ThemeColoursWallpapersMotionModule}"
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}">
            <StackPanel Margin="32,0,32,32">

                <!-- ═════════ GROUP: THEME & LAYOUT ═════════ -->
                <TextBlock Text="{DynamicResource Settings.ThemeLayout}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.OverallLookCardWeightDensity}"
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <!-- 2026-08-25: one-tap factory reset for everything the
                     Appearance module owns (theme, accent, gradients, card
                     shape, density, zoom, font, wallpapers, PDF layout). -->
                <Button AutomationProperties.AutomationId="Appearance.ResetDefaults"
                        Command="{Binding ResetAppearanceCommand}"
                        ToolTip="{DynamicResource Settings.RestoreThemeAccentCardShapeDensityZoomFont}"
                        HorizontalAlignment="Left"
                        Padding="0"
                        Margin="0,2,0,10">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SettingsActionButtonStyle}">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <StackPanel Orientation="Horizontal" Margin="18,8">
                                        <TextBlock Text="&#xE777;" 
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="{StaticResource TextSection}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource Settings.ResetAppearanceDefaults}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsResettingAppearance}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <StackPanel Orientation="Horizontal" Margin="18,8">
                                                <ProgressBar IsIndeterminate="True"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0"/>
                                                <TextBlock Text="{DynamicResource Settings.Resetting}"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Loading indicator for reset operation -->
                <Border Margin="0,0,0,10"
                        Padding="16,12"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        BorderThickness="{DynamicResource Border.HairlineThickness}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Opacity" Value="0"/>
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsResettingAppearance}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1"
                                                                 Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ProgressBar IsIndeterminate="True"
                                         Width="120"
                                         Height="4"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0"
                                         Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Text="{DynamicResource Settings.ResettingAppearance}"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                       FontWeight="Bold"
                                       FontSize="{StaticResource TextBodyLarge}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ResetStatusMessage}"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="{StaticResource TextCaption}"
                                   Opacity="0.9"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                
                <!-- ═══ PHASE 2 — LIVE PREVIEW: a mini module card painted
                     from the SAME DynamicResource tokens the real screens
                     consume — surface, ink, keyline, accent, status chips
                     — so an operator commits to a look they have already
                     seen, not a label they trust blindly. -->
                <Border Style="{StaticResource SettingsTileStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                            <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8EC;"/>
                            <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.PreviewTitle}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                   Text="{DynamicResource Settings.PreviewCaption}"/>
                        <Border CornerRadius="{DynamicResource CardCornerRadius}"
                                Background="{DynamicResource SurfaceSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                BorderThickness="{DynamicResource Border.HairlineThickness}"
                                Margin="0,8,0,0"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Crystal Fluid studio preview: a water
                                     reservoir — WaterFlow moves the level
                                     live (§60), the family gate keeps it
                                     invisible under other families.
                                     Ios-17pm P4e: AUTHORED water control
                                     (interim CrystalWater retired P4b). -->
                                <!-- Live CrystalWaterControl removed — TokenStore preview only. -->
                            <StackPanel Margin="12,10">
                                <TextBlock Text="{DynamicResource Settings.PreviewModuleCard}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="{StaticResource TextBody}"/>
                                <TextBlock Text="{DynamicResource Settings.PreviewBody}"
                                           FontSize="{StaticResource TextCaption}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           TextWrapping="Wrap" Margin="0,2,0,8"/>
                                <UniformGrid Columns="5">
                                    <Border Padding="9,3" CornerRadius="{DynamicResource Radius.XSmall}" Margin="0,0,6,0"
                                            Background="{DynamicResource AccentBrush}">
                                        <TextBlock Text="{DynamicResource Settings.PreviewAction}"
                                                   FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Padding="9,3" CornerRadius="{DynamicResource Radius.XSmall}" Margin="0,0,6,0"
                                            Background="{DynamicResource TintGreenBrush}">
                                        <TextBlock Text="{DynamicResource Settings.PreviewOk}"
                                                   FontSize="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Padding="9,3" CornerRadius="{DynamicResource Radius.XSmall}" Margin="0,0,6,0"
                                            Background="{DynamicResource TintAmberBrush}">
                                        <TextBlock Text="{DynamicResource Settings.PreviewWarn}"
                                                   FontSize="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Padding="9,3" CornerRadius="{DynamicResource Radius.XSmall}" Margin="0,0,6,0"
                                            Background="{DynamicResource TintRedBrush}">
                                        <TextBlock Text="{DynamicResource Settings.PreviewErr}"
                                                   FontSize="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Padding="9,3" CornerRadius="{DynamicResource Radius.XSmall}"
                                            Background="{DynamicResource SurfacePrimaryBrush}"
                                            BorderBrush="{DynamicResource BorderDefaultBrush}"
                                            BorderThickness="{DynamicResource Border.HairlineThickness}">
                                        <TextBlock Text="{DynamicResource Settings.PreviewKeyline}"
                                                   FontSize="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════
                     IOS-17PM P4e (2026-09-05) — AUTHORED PREVIEW
                     COMPOSITION (file-20 reference). Family-gated: the
                     engine writes CrystalPreviewHostVisibility under
                     Crystal Fluid and removes it at BOTH switch paths,
                     so this gallery renders ONLY under its own family.

                     Order mirrors file 20: environment highlight trio +
                     ambient → KPI strip (water) → nav row → status pill
                     + DETERMINATE progress → authored grid chrome.
                     Strings are static demo copy (§46 — presentation
                     only; no business data is invented). Indeterminate
                     progress remains 100% stock: nothing in this tile,
                     anywhere, touches IsIndeterminate.
                     ═══════════════════════════════════════════════════ -->
                <Border Style="{StaticResource SettingsTileStyle}"
                        Margin="0,0,0,10"
                        Visibility="{DynamicResource CrystalPreviewHostVisibility}">
                    <Grid UseLayoutRounding="True" SnapsToDevicePixels="True"
                          MinHeight="330" ClipToBounds="True">

                        <!-- environment highlight trio (file-20 §22) -->
                        <Border Background="{DynamicResource CrystalEnvironmentHighlightTopLeftBrush}"
                                IsHitTestVisible="False"/>
                        <Border Background="{DynamicResource CrystalEnvironmentCyanTopRightBrush}"
                                IsHitTestVisible="False"/>
                        <Border Background="{DynamicResource CrystalEnvironmentCyanBottomRightBrush}"
                                IsHitTestVisible="False"/>
                        <crystal:CrystalAmbientBackground/>

                        <StackPanel Margin="12" VerticalAlignment="Stretch">

                            <!-- KPI strip with water (file-20 rows) -->
                            <UniformGrid Columns="3" Margin="0,0,0,10">
                                <crystal:CrystalKpiCard Title="Proforma"
                                        Value="128 KP"
                                        WaterLevel="0.42" BubbleCount="3"
                                        Margin="0,0,6,0">
                                    <crystal:CrystalKpiCard.Icon>
                                        <TextBlock Text="◇" FontSize="{StaticResource TextBodyLarge}"/>
                                    </crystal:CrystalKpiCard.Icon>
                                    <crystal:CrystalStatusPill Content="+12.8%"
                                            StatusColor="{StaticResource CrystalPositiveBrush}"/>
                                </crystal:CrystalKpiCard>
                                <crystal:CrystalKpiCard Title="Active"
                                        Value="24" WaterLevel="0.58"
                                        Margin="3,0">
                                    <crystal:CrystalKpiCard.Icon>
                                        <TextBlock Text="□" FontSize="{StaticResource TextBodyLarge}"/>
                                    </crystal:CrystalKpiCard.Icon>
                                    <crystal:CrystalStatusPill Content="running"
                                            StatusColor="{StaticResource CrystalPositiveBrush}"/>
                                </crystal:CrystalKpiCard>
                                <crystal:CrystalKpiCard Title="Margin"
                                        Value="27.4%" WaterLevel="0.31"
                                        BubbleEnabled="False"
                                        Margin="6,0,0,0">
                                    <crystal:CrystalKpiCard.Icon>
                                        <TextBlock Text="✓" FontSize="{StaticResource TextBodyLarge}"/>
                                    </crystal:CrystalKpiCard.Icon>
                                </crystal:CrystalKpiCard>
                            </UniformGrid>

                            <!-- authored nav (reference styles, demo group) -->
                            <TextBlock Style="{StaticResource CrystalNavLabelStyle}"
                                       Text="IOS-17PM"/>
                            <UniformGrid Columns="3" Rows="1" Margin="0,0,0,10">
                                <RadioButton Style="{StaticResource CrystalNavButtonStyle}"
                                             Content="Dashboard" IsChecked="True" Margin="0,0,6,0"/>
                                <RadioButton Style="{StaticResource CrystalNavButtonStyle}"
                                             Content="Production" Margin="3,0"/>
                                <RadioButton Style="{StaticResource CrystalNavButtonStyle}"
                                             Content="Reports" Margin="6,0,0,0"/>
                            </UniformGrid>

                            <!-- status pill + DETERMINATE progress (authored) -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <crystal:CrystalStatusPill Content="online"
                                        StatusColor="{StaticResource CrystalPositiveBrush}"
                                        Margin="0,0,8,0"/>
                                <crystal:CrystalProgressBar Value="64"
                                        Minimum="0" Maximum="100"
                                        VerticalAlignment="Center"
                                        Width="220"/>
                            </StackPanel>

                            <!-- authored grid chrome (headers only; demo
                                 shows grid-line + header identity, zero
                                 invented data rows) -->
                            <DataGrid Style="{StaticResource CrystalDataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource CrystalDataGridColumnHeaderStyle}"
                                      RowStyle="{StaticResource CrystalDataGridRowStyle}"
                                      CellStyle="{StaticResource CrystalDataGridCellStyle}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      RowHeaderWidth="0" CanUserAddRows="False"
                                      CanUserResizeColumns="False"
                                      MaxHeight="86">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Material" Width="*"/>
                                    <DataGridTextColumn Header="Qty" Width="*"/>
                                    <DataGridTextColumn Header="Status" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Grid>
                </Border>

                <UniformGrid Columns="3" Margin="0,0,0,6">

                    <!-- Visual theme -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE790;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.LblThemeFamily}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.NormalMonetIos17pm}"/>
                            <ComboBox ItemsSource="{Binding VisualThemeOptions}"
                                      DisplayMemberPath="Display"
                                      SelectedValuePath="Key"
                                      SelectedValue="{Binding SelectedVisualTheme, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      Padding="10,7" FontSize="{StaticResource TextBodyLarge}"/>
                        </StackPanel>
                    </Border>

                    <!-- Font Color (global text colour, 2026-08-25) -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE2B1;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.FontColor}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.OneGlobalTextColourViewAutoFollowsThemeIos}"/>
                            <!-- Chips generated from SettingsViewModel.FontColorPalette
                                 (Auto + FontColorPresets.All) — the swatch shown IS
                                 the exact primary colour that gets applied. -->
                            <ItemsControl ItemsSource="{Binding FontColorPalette}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ApplyFontColorCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Key}"
                                                Style="{StaticResource AccentChipStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="11" Height="11" Fill="{Binding Swatch}"
                                                         Stroke="{DynamicResource BorderDefaultBrush}"
                                                         StrokeThickness="1"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Free-pick font colour: type any hex, the whole
                                 text hierarchy (primary/secondary/muted) re-derives. -->
                            <Border Margin="0,10,0,0" Padding="8,6" CornerRadius="{DynamicResource Radius.Small}"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="14" Height="14"
                                             Fill="{Binding CustomFontColorSwatch}"
                                             Stroke="{DynamicResource BorderDefaultBrush}" StrokeThickness="1"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Text="{Binding CustomFontColorHex, UpdateSourceTrigger=PropertyChanged}"
                                             Width="96" Padding="8,5" FontSize="{StaticResource TextBodyLarge}"
                                             FontFamily="Consolas"
                                             VerticalAlignment="Center"/>
                                    <Button Command="{Binding ApplyCustomFontColorCommand}"
                                            Style="{StaticResource AccentChipStyle}" Margin="8,0,0,0">
                                        <TextBlock Text="{DynamicResource Action.Apply}"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}"
                                       Text="{Binding CustomFontColorStatus}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Defined card edges: on/off + edge weight (1–100) + colour plate -->
                    <Border Style="{StaticResource SettingsFullRowTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE71B;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.DefinedCardEdges}"/>
                                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0"
                                           FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="{Binding CardEdgeThickness, Mode=OneWay, StringFormat={}{0:0.#}}"/>
                                    <Run Text="{DynamicResource Settings.DIP}"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.AddsStrongDarkOutlineRoundedCardsPillButtons}"/>
                            <ToggleButton HorizontalAlignment="Left" Margin="0,8,0,0"
                                          IsChecked="{Binding UseDefinedOutline, Mode=TwoWay}"
                                          Style="{StaticResource ModernToggleSwitch}"/>

                            <!-- Edge weight 1–100 -->
                            <TextBlock Margin="0,16,0,0"
                                       Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.CardEdgeThickness}"/>
                            <Slider Style="{StaticResource ModernSliderStyle}"
                                    Minimum="1" Maximum="100"
                                    Value="{Binding CardEdgeThickness, Mode=TwoWay}"
                                    VerticalAlignment="Center" Margin="0,4,0,0"/>

                            <!-- Edge colour plate (same palette as the accent section) -->
                            <TextBlock Margin="0,16,0,4"
                                       Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.CardEdgeColorLabel}"/>
                            <ItemsControl ItemsSource="{Binding CardEdgePalette}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ApplyCardEdgePresetCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Key}"
                                                Style="{StaticResource AccentChipStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="11" Height="11" Fill="{Binding Swatch}"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Custom edge colour -->
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Ellipse Width="14" Height="14"
                                         Fill="{Binding CardEdgeSwatch}"
                                         Stroke="{DynamicResource BorderDefaultBrush}" StrokeThickness="1"
                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Text="{Binding CardEdgeColor, UpdateSourceTrigger=PropertyChanged}"
                                         Width="110" Padding="8,6" FontSize="{StaticResource TextBody}"
                                         FontFamily="Consolas" VerticalAlignment="Center"/>
                                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0"
                                           Style="{StaticResource SettingsTileCaptionStyle}"
                                           Text="{DynamicResource Settings.CardEdgeColorHint}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Gradient surfaces (adaptive-theme depth) -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE7F4;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.GradientSurfaces}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.RendersMonetGlassCardsWindowBackgroundAccent}"/>
                            <ToggleButton Grid.Row="3"
                                          HorizontalAlignment="Left"
                                          IsChecked="{Binding UseGradientSurfaces, Mode=TwoWay}"
                                          Style="{StaticResource ModernToggleSwitch}"/>
                        </Grid>
                    </Border>

                    <!-- Corner radius -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE7B3;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.CardCornerRadius}"/>
                                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0"
                                           FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="{Binding CardCornerRadius, Mode=OneWay, StringFormat={}{0:0}}"/>
                                    <Run Text="{DynamicResource Settings.Px}"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.HowRoundCardButtonDefault12Px0Sharp}"/>
                            <Slider Style="{StaticResource ModernSliderStyle}"
                                    Minimum="0" Maximum="24"
                                    TickFrequency="2"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding CardCornerRadius, Mode=TwoWay}"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Display density -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE740;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.GrpDensity}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.CompactFitsMoreLaptopComfortableGivesLarger}"/>
                            <ComboBox ItemsSource="{Binding DisplayDensityOptions}"
                                      SelectedItem="{Binding DisplayDensity}"
                                      HorizontalAlignment="Stretch"
                                      Padding="10,7" FontSize="{StaticResource TextBodyLarge}"/>
                        </StackPanel>
                    </Border>


                    <!-- Module-skin frost: blur wallpaper + tinted glass cards -->
                    <Border Style="{StaticResource SettingsFullRowTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE2B1;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Frosted module cards"/>
                                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0"
                                           FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="{Binding CardBlurIntensity, Mode=OneWay, StringFormat={}{0:0}}"/>
                                    <Run Text="/100"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="Blurs the module wallpaper behind every screen. Cards stay sharp. 1 = light frost, 50 = professional, 100 = max. Colour plate tints the shared card fill."/>
                            <Slider Style="{StaticResource ModernSliderStyle}"
                                    Minimum="1" Maximum="100"
                                    Value="{Binding CardBlurIntensity, Mode=TwoWay}"
                                    VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Margin="0,16,0,4"
                                       Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="Frost colour plate"/>
                            <ItemsControl ItemsSource="{Binding CardEdgePalette}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ApplyCardFrostTintCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Key}"
                                                Style="{StaticResource AccentChipStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="11" Height="11" Fill="{Binding Swatch}"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Ellipse Width="14" Height="14"
                                         Fill="{Binding CardFrostTintSwatch}"
                                         Stroke="{DynamicResource BorderDefaultBrush}" StrokeThickness="1"
                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Text="{Binding CardFrostTint, UpdateSourceTrigger=PropertyChanged}"
                                         Width="110" Padding="8,6" FontSize="{StaticResource TextBody}"
                                         FontFamily="Consolas" VerticalAlignment="Center"/>
                                <Button Command="{Binding ApplyCardFrostTintCommand}" CommandParameter="Auto"
                                        Style="{StaticResource AccentChipStyle}" Margin="8,0,0,0">
                                    <TextBlock Text="Auto (theme)"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Semantic ERP surfaces: Primary / Secondary / Detail customization -->
                    <Border Style="{StaticResource SettingsFullRowTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE771;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="ERP surface levels"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="Controls the three central card levels used by modules: Primary page regions, Secondary groups/KPIs, and Detail chips/facts."/>

                            <UniformGrid Columns="4" Margin="0,10,0,8">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource SettingsTileCaptionStyle}" Text="Material"/>
                                    <ComboBox ItemsSource="{Binding SurfaceMaterialOptions}"
                                              SelectedItem="{Binding SurfaceMaterialMode}"
                                              Padding="10,7" FontSize="{StaticResource TextBodyLarge}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource SettingsTileCaptionStyle}" Text="Rounded surfaces"/>
                                    <ToggleButton HorizontalAlignment="Left"
                                                  IsChecked="{Binding UseRoundedSurfaces, Mode=TwoWay}"
                                                  Style="{StaticResource ModernToggleSwitch}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource SettingsTileCaptionStyle}" Text="Primary elevation"/>
                                    <ToggleButton HorizontalAlignment="Left"
                                                  IsChecked="{Binding UsePrimarySurfaceElevation, Mode=TwoWay}"
                                                  Style="{StaticResource ModernToggleSwitch}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsTileCaptionStyle}" Text="Primary overlay"/>
                                    <Slider Style="{StaticResource ModernSliderStyle}"
                                            Minimum="0" Maximum="0.35" TickFrequency="0.05"
                                            Value="{Binding PrimarySurfaceOverlayOpacity, Mode=TwoWay}"/>
                                </StackPanel>
                            </UniformGrid>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource SurfacePrimaryStyle}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Primary" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Major page/module card" Style="{StaticResource SettingsTileCaptionStyle}"/>
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource SettingsTileCaptionStyle}" Text="Opacity"/>
                                        <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0.3" Maximum="1" Value="{Binding SurfacePrimaryOpacity, Mode=TwoWay}"/>
                                        <TextBlock Style="{StaticResource SettingsTileCaptionStyle}" Text="Radius"/>
                                        <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="48" Value="{Binding SurfacePrimaryRadius, Mode=TwoWay}"/>
                                        <TextBlock Style="{StaticResource SettingsTileCaptionStyle}" Text="Border"/>
                                        <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="24" Value="{Binding SurfacePrimaryBorderThickness, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource SurfaceSecondaryStyle}" Margin="4,0">
                                    <StackPanel>
                                        <TextBlock Text="Secondary" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Groups, filters, KPI cards" Style="{StaticResource SettingsTileCaptionStyle}"/>
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource SettingsTileCaptionStyle}" Text="Opacity"/>
                                        <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0.25" Maximum="1" Value="{Binding SurfaceSecondaryOpacity, Mode=TwoWay}"/>
                                        <TextBlock Style="{StaticResource SettingsTileCaptionStyle}" Text="Radius"/>
                                        <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="48" Value="{Binding SurfaceSecondaryRadius, Mode=TwoWay}"/>
                                        <TextBlock Style="{StaticResource SettingsTileCaptionStyle}" Text="Border"/>
                                        <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="24" Value="{Binding SurfaceSecondaryBorderThickness, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource SurfaceDetailStyle}" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Detail" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Chips, badges, facts" Style="{StaticResource SettingsTileCaptionStyle}"/>
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource SettingsTileCaptionStyle}" Text="Opacity"/>
                                        <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0.15" Maximum="1" Value="{Binding SurfaceDetailOpacity, Mode=TwoWay}"/>
                                        <TextBlock Style="{StaticResource SettingsTileCaptionStyle}" Text="Radius"/>
                                        <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="48" Value="{Binding SurfaceDetailRadius, Mode=TwoWay}"/>
                                        <TextBlock Style="{StaticResource SettingsTileCaptionStyle}" Text="Border"/>
                                        <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="24" Value="{Binding SurfaceDetailBorderThickness, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>


                    <!-- UI scale -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8A3;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.UIScale}"/>
                                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0"
                                           FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="{Binding UiScalePercent, Mode=OneWay}"/>
                                    <Run Text="%"/>
                                </TextBlock>
                                <Button Content="{DynamicResource Action.Reset}"
                                        Style="{StaticResource OutlinedPillButton}"
                                        Command="{Binding ResetUiScaleCommand}"
                                        Margin="12,0,0,0"
                                        Height="26" MinWidth="60" Padding="10,0"
                                        FontSize="{StaticResource TextCaption}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.CtrlMouseWheelZoomsAppCtrl0Resets100}"/>
                            <Slider Style="{StaticResource ModernSliderStyle}"
                                    Minimum="0.8" Maximum="1.25"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding UiScale, Mode=TwoWay}"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- PDF layout -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8A5;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.PDFLayout}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{Binding PdfLayoutHint}"/>
                            <ComboBox ItemsSource="{Binding PdfLayoutOptions}"
                                      SelectedItem="{Binding PdfLayout}"
                                      HorizontalAlignment="Stretch"
                                      Padding="10,7" FontSize="{StaticResource TextBodyLarge}"/>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}"
                                       Text="{DynamicResource Settings.AppliesPIJODNTaxInvoiceStatementSheetStore}"/>
                        </StackPanel>
                    </Border>

                    <!-- Motion & performance -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE9F5;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.MotionPerformance}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{Binding PerformanceTierDisplay}"/>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}"
                                       Text="{DynamicResource Settings.AnimationsAdaptDisplayRefreshRate6090120144}"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <Border Style="{StaticResource SettingsGroupSeparatorStyle}"/>

                <!-- ═════════ GROUP: ACCENT & FONT ═════════ -->
                <TextBlock Text="{DynamicResource Settings.AccentFONT}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.ColourIdentityTypographyAppliedScreen}"
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <UniformGrid Columns="3" Margin="0,0,0,6">

                    <!-- Accent palette (wide) -->
                    <Border Style="{StaticResource SettingsWideTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE790;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.LblAccent}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.ButtonsTintsHoverStatesMonetGlassSurfaces}"/>
                            <!-- Palette chips generated from SettingsViewModel.AccentPalette
                                 (single source of truth: AccentPresets.All) — the swatch
                                 shown IS the exact colour that gets applied. -->
                            <ItemsControl ItemsSource="{Binding AccentPalette}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ApplyAccentCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Key}"
                                                Style="{StaticResource AccentChipStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="11" Height="11" Fill="{Binding Swatch}"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Free-pick colour: type any hex, the whole adaptive palette
                                 (Monet glass, tints, keylines) re-derives from it. -->
                            <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="{DynamicResource Radius.Small}"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="14" Height="14"
                                             Fill="{Binding CustomAccentSwatch}"
                                             Stroke="{DynamicResource BorderDefaultBrush}" StrokeThickness="1"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Text="{Binding CustomAccentHex, UpdateSourceTrigger=PropertyChanged}"
                                             Width="110" Padding="8,6" FontSize="{StaticResource TextBodyLarge}"
                                             FontFamily="Consolas"
                                             VerticalAlignment="Center"/>
                                    <Button Command="{Binding ApplyCustomAccentCommand}"
                                            Style="{StaticResource AccentChipStyle}" Margin="8,0,0,0">
                                        <TextBlock Text="{DynamicResource Settings.ApplyCustomColour}"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}"
                                       Text="{Binding CustomAccentStatus}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Font family -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE185;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.FontFamily}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.UsedScreenDialogTableIconsStaySegoeMDL2}"/>
                            <ComboBox ItemsSource="{Binding FontOptions}"
                                      SelectedItem="{Binding SelectedFont, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      HorizontalAlignment="Stretch"
                                      Padding="10,7" FontSize="{StaticResource TextBodyLarge}"
                                      MaxDropDownHeight="320"/>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}"
                                       Text="{Binding FontStatus}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Weight + Style -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8D2;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.FontWeightStyle}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.TuneWeightStyleWithinSelectedFamily}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding FontWeightChoices}"
                                          SelectedItem="{Binding SelectedFontWeight, Mode=TwoWay}"
                                          Padding="10,7" FontSize="{StaticResource TextBodyLarge}"/>
                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding FontStyleChoices}"
                                          SelectedItem="{Binding SelectedFontStyle, Mode=TwoWay}"
                                          Padding="10,7" FontSize="{StaticResource TextBodyLarge}"/>
                            </Grid>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Command="{Binding ImportFontCommand}"
                                        Style="{StaticResource AccentChipStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="{StaticResource TextBody}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource Settings.ImportFONT}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ResetFontCommand}"
                                        Style="{StaticResource AccentChipStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="{StaticResource TextBody}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource Action.Reset}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <Border Style="{StaticResource SettingsGroupSeparatorStyle}"/>

                <!-- ═════════ GROUP: WALLPAPERS ═════════ -->
                <TextBlock Text="{DynamicResource Settings.Wallpapers}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.OneImageBehindModulePlusModuleOverrides}"
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <!-- One card per row (Columns=1): Global Wallpaper fills the
                     full width, then Per-Module Wallpapers fills the full
                     width below it with its own three-column grid. -->
                <StackPanel Margin="0,0,0,6">

                    <!-- Global wallpaper — one card, all controls on one line -->
                    <Border Style="{StaticResource SettingsFullRowTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xEB9F;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.GlobalWallpaper}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.AppliedSystemWideBehindModuleModuleOverrides}"/>
                            <!-- Single line: SET / CLEAR on the left, visibility
                                 slider on the right, so global wallpaper + its
                                 visibility no longer take two separate tiles. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Style="{StaticResource OutlinedPillButton}"
                                        Tag="&#xE728;" Content="{DynamicResource Settings.SET}"
                                        Command="{Binding SetWallpaperCommand}"
                                        VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource RowOutlinedButton}"
                                        Tag="&#xE711;" Content="{DynamicResource Action.Clear}"
                                        Command="{Binding ClearWallpaperCommand}"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3"
                                           Text="{DynamicResource Settings.Visibility}"
                                           Style="{StaticResource LabelStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <Slider Grid.Column="4"
                                        Value="{Binding WallpaperOpacity}"
                                        Style="{StaticResource ModernSliderStyle}"
                                        Minimum="0.3" Maximum="1"
                                        VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding WallpaperStatus}"
                                       Style="{StaticResource SettingsTileFooterHintStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Per-module wallpapers — three columns under one card so
                         the list no longer grows the page by 17 stacked rows. -->
                    <Border Style="{StaticResource SettingsFullRowTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8B9;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.ModuleWallpapers}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.GiveModuleBackgroundImageListSplitThree}"/>

                            <ItemsControl ItemsSource="{Binding ModuleWallpaperRows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="{DynamicResource CardCornerRadius}"
                                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                BorderThickness="{DynamicResource Border.RightBottomHairlineThickness}"
                                                Padding="4,7"
                                                Margin="0,0,8,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 2026-08-25: checkmark replaced with an
                                                     iOS-style on/off pill (ModernToggleSwitch). -->
                                                <ToggleButton Grid.Column="0"
                                                              Style="{StaticResource ModernToggleSwitch}"
                                                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                              VerticalAlignment="Center"
                                                              ToolTip="{DynamicResource Settings.EnableModuleSWallpaper}"
                                                              Margin="0,0,8,0"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Label}"
                                                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,6,0"
                                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                                    <TextBlock.ToolTip>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding FileName}" FontSize="{StaticResource TextCaption}"
                                                                       Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </TextBlock.ToolTip>
                                                </TextBlock>

                                                <Slider Grid.Column="2"
                                                        Value="{Binding OpacityValue}"
                                                        Style="{StaticResource ModernSliderStyle}"
                                                        Minimum="0.3" Maximum="1"
                                                        Width="76"
                                                        ToolTip="{DynamicResource Settings.Visibility}"
                                                        VerticalAlignment="Center"/>

                                                <Button Grid.Column="3"
                                                        Style="{StaticResource RowOutlinedButton}"
                                                        Tag="&#xE728;" Content="{DynamicResource Settings.SET}"
                                                        Command="{Binding DataContext.SetModuleWallpaperCommand,
                                                                            RelativeSource={RelativeSource
                                                                                AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="6,0,0,0"
                                                        FontSize="{StaticResource TextCaption}"
                                                        Padding="8,2"/>

                                                <Button Grid.Column="4"
                                                        Style="{StaticResource RowDangerButton}"
                                                        Tag="&#xE711;" Content=""
                                                        Command="{Binding DataContext.ClearModuleWallpaperCommand,
                                                                    RelativeSource={RelativeSource
                                                                        AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="6,0,0,0"
                                                        ToolTip="{DynamicResource Settings.RemoveModuleSWallpaper}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ═════════ GROUP: LANGUAGE &amp; CURRENCY ═════════ -->
                <TextBlock Text="{DynamicResource Settings.GrpLanguage}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.HintLanguage}"
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <UniformGrid Columns="3" Margin="0,0,0,6">

                    <!-- Language (15 shipped, live switch, en-US primary) -->
                    <Border Style="{StaticResource SettingsWideTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8EC;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}"
                                           Text="{DynamicResource Settings.LblLanguage}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.HintLanguage}"/>
                            <ComboBox AutomationProperties.AutomationId="Settings.Language"
                                      ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      MinWidth="180" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Currency (live FX, offline = last fetched) -->
                    <Border Style="{StaticResource SettingsWideTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xEAF1;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}"
                                           Text="{DynamicResource Settings.LblCurrency}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.HintCurrency}"/>
                            <ComboBox AutomationProperties.AutomationId="Settings.Currency"
                                      ItemsSource="{Binding Currencies}"
                                      SelectedItem="{Binding SelectedCurrency, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      MinWidth="180" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Phone country (from IP, editable) -->
                    <Border Style="{StaticResource SettingsWideTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE717;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}"
                                           Text="{DynamicResource Settings.LblPhoneCountry}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.HintPhoneCountry}"/>
                            <ComboBox AutomationProperties.AutomationId="Settings.PhoneCountry"
                                      ItemsSource="{Binding PhoneCountries}"
                                      SelectedItem="{Binding PhoneCountry, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      MinWidth="180" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- ═══ ACCESSIBILITY — reduced motion (§43) ═══
                     App-wide switch: the Crystal Fluid water/caustic/
                     bubble choreography and card tilt render calm and
                     static. Persisted; survives family switches. -->
                <Border Style="{StaticResource SettingsTileStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                            <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE713;"/>
                            <TextBlock Style="{StaticResource SettingsTileTitleStyle}"
                                       Text="{DynamicResource Settings.ReducedMotion}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                   Text="{DynamicResource Settings.ReducedMotionTip}"
                                   TextWrapping="Wrap"/>
                        <CheckBox AutomationProperties.AutomationId="Settings.ReducedMotion"
                                  Content="{DynamicResource Settings.ReducedMotion}"
                                  IsChecked="{Binding ReducedMotion, Mode=TwoWay}"
                                  Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ═══ WALLPAPER STUDIO (2026-09-05) ═══
                     Dynamic theme-linked scenes (code-drawn, accent-aware),
                     six built-in designs, one-tap 4K downloads with a
                     persistent local library. -->
                <Border Style="{StaticResource SettingsTileStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                            <TextBlock Style="{StaticResource SettingsTileTitleStyle}"
                                       Text="{DynamicResource Settings.WallpaperStudio}"/>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}" TextWrapping="Wrap"
                                       Text="{DynamicResource Settings.WallpaperStudioCaption}"/>
                        </StackPanel>

                        <!-- Mode: dynamic / file / pinned scene -->
                        <TextBlock Text="{DynamicResource Settings.WallpaperMode}"
                                   FontSize="{StaticResource TextBody}" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding WallpaperModeOptions}"
                                  SelectedItem="{Binding SelectedWallpaperMode, Mode=TwoWay}"
                                  Width="300" HorizontalAlignment="Left" Margin="0,2,0,4"/>

                        <!-- Built-in theme scenes (live swatches) -->
                        <TextBlock Text="{DynamicResource Settings.WallpaperBuiltin}"
                                   FontSize="{StaticResource TextXSmall}" FontWeight="Bold" Margin="0,6,0,2"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <ItemsControl ItemsSource="{Binding BuiltinSceneRows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- No Padding override: the pill template
                                         owns its metrics (2026-09-05 lesson —
                                         overrides collapsed the button text). -->
                                    <Button Style="{StaticResource OutlinedPillButton}"
                                            Command="{Binding DataContext.ApplyBuiltinSceneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Key}"
                                            Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="36" Height="20" RadiusX="5" RadiusY="5"
                                                       Fill="{Bindin           <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="36" Height="20" RadiusX="5" RadiusY="5"
                                                       Fill="{Binding Preview}"/>
                                            <TextBlock Text="{Binding Label}" Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Download 4K from the internet -->
                        <TextBlock Text="{DynamicResource Settings.WallpaperOnline}"
                                   FontSize="{StaticResource TextXSmall}" FontWeight="Bold" Margin="0,6,0,2"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ComboBox ItemsSource="{Binding OnlineCategoryRows}"
                                      DisplayMemberPath="Label" SelectedValuePath="Key"
                                      SelectedValue="{Binding SelectedOnlineCategoryKey, Mode=TwoWay}"
                                      Width="230" HorizontalAlignment="Left"/>
                            <Button Style="{StaticResource SuccessPillButton}"
                                    Command="{Binding FetchWallpaperCommand}"
                                    IsEnabled="{Binding IsWallpaperIdle}"
                                    Margin="10,0,0,0"
                                    Content="{DynamicResource Settings.WallpaperFetch}"/>
                            <ProgressBar Width="120" Height="8" Margin="14,0,0,0"
                                         VerticalAlignment="Center" IsIndeterminate="True"
                                         Foreground="{DynamicResource AccentBrush}"
                                         Visibility="{Binding IsWallpaperBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                        <!-- Phase 3: failure is now VISIBLE — the status
                             line switches to the danger tint whenever the
                             last wallpaper operation failed, instead of
                             hiding behind the same grey as success. -->
                        <TextBlock Text="{Binding WallpaperFetchStatus}"
                                   FontSize="{StaticResource TextCaption}"
                                   TextWrapping="Wrap" Margin="0,0,0,6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWallpaperFetchError}"
                                                     Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource TintRedBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Downloaded library (offline reuse) + management -->
                        <DockPanel Margin="0,4,0,2">
                            <TextBlock Text="{DynamicResource Settings.WallpaperLibrary}"
                                       FontSize="{StaticResource TextXSmall}" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource OutlinedPillButton}"
                                        Command="{Binding OpenWallpaperFolderCommand}"
                                        Margin="0,0,6,0"
                                        Content="{DynamicResource Settings.WallpaperOpenFolder}"/>
                                <Button Style="{StaticResource OutlinedPillButton}"
                                        Command="{Binding ClearWallpaperLibraryCommand}"
                                        Content="{DynamicResource Settings.WallpaperClearAll}"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding WallpaperLibrarySummary}"
                                   FontSize="{StaticResource TextCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4"/>
                        <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding CachedWallpapers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,1,0,1">
                                            <Button DockPanel.Dock="Right"
                                                    Style="{StaticResource DangerButton}"
                                                    Command="{Binding DataContext.DeleteCachedWallpaperCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding FullPath}"
                                                    FontSize="{StaticResource TextCaption}"
                                                    VerticalAlignment="Center"
                                                    Content="✕"/>
                                            <Button DockPanel.Dock="Right"
                                                    Style="{StaticResource OutlinedPillButton}"
                                                    Command="{Binding DataContext.ApplyCachedWallpaperCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding FullPath}"
                                                    FontSize="{StaticResource TextCaption}"
                                                    VerticalAlignment="Center" Margin="0,0,6,0"
                                                    Content="{DynamicResource Settings.WallpaperApply}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}"
                                                       FontSize="{StaticResource TextCaption}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="10,0,6,0"/>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="{StaticResource TextBody}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- OS-level window backdrop (experimental) -->
                        <TextBlock Text="{DynamicResource Settings.WallpaperBackdrop}"
                                   FontSize="{StaticResource TextXSmall}" FontWeight="Bold" Margin="0,12,0,2"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Command="{Binding SetWindowBackdropCommand}" CommandParameter="Off"
                                    Margin="0,0,8,0"
                                    Content="{DynamicResource Settings.WallpaperBackdropOff}"/>
                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Command="{Binding SetWindowBackdropCommand}" CommandParameter="Mica"
                                    Margin="0,0,8,0"
                                    Content="{DynamicResource Settings.WallpaperBackdropMica}"/>
                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Command="{Binding SetWindowBackdropCommand}" CommandParameter="Acrylic"
                                    Content="{DynamicResource Settings.WallpaperBackdropAcrylic}"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Settings.WallpaperBackdropCaption}"
                                   FontSize="{StaticResource TextCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>


                <!-- Auto-detect + currency status — 2026-09-05: was a bare
                     Grid with a default (unstyled) WPF button; now the same
                     rounded SettingsTileStyle card language as every other
                     tile in this section. Bindings/AutomationIds unchanged. -->
                <Border Style="{StaticResource SettingsTileStyle}" Margin="0,4,0,0">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                            <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE774;"/>
                            <TextBlock Style="{StaticResource SettingsTileTitleStyle}"
                                       Text="{DynamicResource Settings.LocaleFallback}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                   Text="{DynamicResource Settings.LocaleFallbackCaption}"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <CheckBox Content="{DynamicResource Settings.LblAutoDetect}"
                                          IsChecked="{Binding AutoSuggestByRegion, Mode=TwoWay}"
                                          FontSize="{StaticResource TextBody}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          VerticalContentAlignment="Center"
                                          AutomationProperties.AutomationId="Settings.AutoSuggestByRegion"/>
                                <TextBlock Text="{Binding FxStatusText}"
                                           Style="{StaticResource SettingsTileCaptionStyle}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource OutlinedPillButton}"
                                    Content="{DynamicResource Settings.ResetToEnglish}"
                                    Command="{Binding ResetToEnglishCommand}"
                                    AutomationProperties.AutomationId="Settings.ResetLocale"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
