<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsAppearanceSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings — APPEARANCE (Full Light Studio Bento redesign)
     Visual source of truth: mockups/v4-01-appearance.png
     Preserves all bindings to SettingsViewModel while elevating the
     layout hierarchy, card grammar, spacing, and typography ladder.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsAppearanceSection"
             xmlns:crystal="clr-namespace:ProGlassAutomation.Controls.CrystalFluid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cards="clr-namespace:ProGlassAutomation.Views.Settings.Sections.Cards"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             RenderOptions.ClearTypeHint="Enabled"
             RenderOptions.EdgeMode="Aliased">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly"
                  behaviors:SmoothScrollBehavior.IsEnabled="True"
                  Focusable="False"
                  FocusVisualStyle="{x:Null}">
        <StackPanel Margin="{StaticResource SettingsPagePadding}">

            <!-- ═══ BENTO HERO BANNER — APPEARANCE & WORKSPACE ═══ -->
            <Border Style="{StaticResource SettingsHeroCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SettingsHeroIconTileStyle}">
                        <TextBlock Text="&#xE790;" Style="{StaticResource SettingsHeroIconGlyphStyle}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center">
                        <TextBlock Text="Appearance &amp; Studio Workspace" Style="{StaticResource SettingsHeroTitleStyle}"/>
                        <TextBlock Text="Full Light Studio Bento visual system, typography ladder, and color accents" Style="{StaticResource SettingsHeroNoteStyle}"/>
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource SettingsHeroBadgeStyle}">
                        <TextBlock Text="Active Studio" Style="{StaticResource SettingsHeroBadgeTextStyle}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ 1. BENTO ROW — BASE COLOR MODE & DISPLAY DENSITY ═══ -->
            <Grid Margin="{StaticResource SettingsBentoRowMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <cards:AppearanceModeCard Grid.Column="0" Margin="{StaticResource SettingsBentoColLeft}"/>
                <cards:AppearanceDensityCard Grid.Column="1" Margin="{StaticResource SettingsBentoColRight}"/>
            </Grid>

            <!-- ═══ 2. CARD — THEME & SURFACE ARCHITECTURE ═══ -->
            <cards:AppearanceThemeLayoutCard/>

            <!-- ═══ 3. CARD — BRAND ACCENT & TYPOGRAPHY STUDIO ═══ -->
            <cards:AppearanceAccentFontCard/>

            <!-- ═══ 4. CARD — STUDIO WALLPAPERS & ATMOSPHERIC DEPTH ═══ -->
            <cards:AppearanceWallpapersCard/>

            <!-- ═══ 5. BENTO ROW — SPLASH SCREEN & REGIONAL LOCALIZATION ═══ -->
            <Grid Margin="{StaticResource SettingsBentoRowMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <cards:AppearanceSplashCard Grid.Column="0" Margin="{StaticResource SettingsBentoColLeft}"/>
                <cards:AppearanceLanguageCard Grid.Column="1" Margin="{StaticResource SettingsBentoColRight}"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>