<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsAppearanceSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — APPEARANCE page (redesigned Aug 2026)

     REDESIGN
       Was: one giant SectionCardStyle per subject (Theme mode, Wallpaper,
       Accent, Font, Motion, Module wallpapers) containing full-width
       DockPanel rows. On wide monitors that wasted 60-70% of horizontal
       space; on 1366 laptops it felt endless.

       Now: a WrapPanel of individual "tiles" (SettingsTileStyle) that
       auto-flow into 2-4 columns. Wide surfaces (module wallpaper list,
       accent palette) use SettingsWideTileStyle / SettingsFullRowTileStyle
       so they still get proper width when they need it. Every binding is
       preserved byte-for-byte — this is a layout redesign, not a data
       change.

     Bindings target SettingsViewModel (DataContext flows from shell).
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsAppearanceSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,26,32,14">
            <TextBlock Text="{DynamicResource Settings.SecAppearance}" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="{DynamicResource Settings.ThemeColoursWallpapersMotionModule}"
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}">
            <StackPanel Margin="32,0,32,32">

                <!-- ═════════ GROUP: THEME & LAYOUT ═════════ -->
                <TextBlock Text="{DynamicResource Settings.ThemeLayout}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.OverallLookCardWeightDensity}"
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <!-- 2026-08-25: one-tap factory reset for everything the
                     Appearance module owns (theme, accent, gradients, card
                     shape, density, zoom, font, wallpapers, PDF layout). -->
                <Button AutomationProperties.AutomationId="Appearance.ResetDefaults"
                        Command="{Binding ResetAppearanceCommand}"
                        ToolTip="{DynamicResource Settings.RestoreThemeAccentCardShapeDensityZoomFont}"
                        HorizontalAlignment="Left"
                        Padding="0"
                        Margin="0,2,0,10">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SettingsActionButtonStyle}">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <StackPanel Orientation="Horizontal" Margin="18,8">
                                        <TextBlock Text="&#xE777;" 
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource Settings.ResetAppearanceDefaults}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsResettingAppearance}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <StackPanel Orientation="Horizontal" Margin="18,8">
                                                <ProgressBar IsIndeterminate="True"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0"/>
                                                <TextBlock Text="{DynamicResource Settings.Resetting}"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Loading indicator for reset operation -->
                <Border Margin="0,0,0,10"
                        Padding="16,12"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Opacity" Value="0"/>
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsResettingAppearance}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1"
                                                                 Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ProgressBar IsIndeterminate="True"
                                         Width="120"
                                         Height="4"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0"
                                         Foreground="White"/>
                            <TextBlock Text="{DynamicResource Settings.ResettingAppearance}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ResetStatusMessage}"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Opacity="0.9"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ═══ THEME STUDIO — live 0–100 appearance customization ═══ -->
                <!-- Full-width tile: sliders apply instantly via
                     ThemeStudioService (no restart), persist debounced to
                     config.json, restore on startup. Basic = theme, frost,
                     transparency, corners, shadow; Advanced = everything
                     else. Presets are centralized profiles; Reset Current
                     restores the active family's defaults; Reset All clears
                     the studio layer for every family (Yes/No confirm). -->
                <Border Style="{StaticResource SettingsTileStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                            <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE7EF;"/>
                            <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.ThemeStudio}"/>
                            <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="10"
                                    Background="{DynamicResource AccentBrush}"
                                    Visibility="{Binding IsStudioCustomized, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{DynamicResource Settings.StudioCustomized}"
                                           Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                   Text="{DynamicResource Settings.ThemeStudioCaption}"/>

                        <!-- Presets + reset actions -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                            <TextBlock Text="{DynamicResource Settings.StudioPreset}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       FontWeight="SemiBold"
                                       FontSize="{StaticResource TextBody}"/>
                            <ComboBox ItemsSource="{Binding StudioPresetOptions}"
                                      SelectedItem="{Binding SelectedStudioPreset}"
                                      Width="180" Padding="8,5"
                                      FontSize="{StaticResource TextBody}"/>
                            <Button Command="{Binding ResetStudioThemeCommand}"
                                    Style="{StaticResource AccentChipStyle}"
                                    Margin="10,0,0,0" Padding="12,5">
                                <TextBlock Text="{DynamicResource Settings.StudioResetCurrent}"
                                           FontSize="{StaticResource TextBody}"/>
                            </Button>
                            <Button Command="{Binding ResetStudioAllCommand}"
                                    Style="{StaticResource AccentChipStyle}"
                                    Margin="8,0,0,0" Padding="12,5">
                                <TextBlock Text="{DynamicResource Settings.StudioResetAll}"
                                           FontSize="{StaticResource TextBody}"/>
                            </Button>
                        </StackPanel>

                        <!-- BASIC — the five everyday sliders -->
                        <TextBlock Text="{DynamicResource Settings.StudioBasic}"
                                   FontSize="10" FontWeight="Bold" Margin="0,6,0,2"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <UniformGrid Columns="5">
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="{DynamicResource Settings.StudioFrostness}"
                                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"/>
                                <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100"
                                        Value="{Binding StudioFrostness, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="{DynamicResource Settings.StudioTransparency}"
                                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"/>
                                <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100"
                                        Value="{Binding StudioTransparency, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="{DynamicResource Settings.StudioCorners}"
                                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"/>
                                <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100"
                                        Value="{Binding StudioCornerRoundness, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="{DynamicResource Settings.StudioShadow}"
                                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"/>
                                <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100"
                                        Value="{Binding StudioShadowIntensity, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="{DynamicResource Settings.StudioBlur}"
                                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"/>
                                <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100"
                                        Value="{Binding StudioBlurIntensity, Mode=TwoWay}"/>
                            </StackPanel>
                        </UniformGrid>

                        <!-- COLOUR & TEXT (2026-09-05 master request) —
                             the rich colour system: transparency has a
                             TRUE full range now (cards can reach near-
                             invisible), richness saturates EVERY surface
                             + tint + the wallpaper scene, and text
                             strength owns readability (auto-forced to
                             max ink whenever cards go near-invisible). -->
                        <TextBlock Text="{DynamicResource Settings.StudioColourText}"
                                   FontSize="10" FontWeight="Bold" Margin="0,6,0,2"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="{DynamicResource Settings.StudioColorRichness}"
                                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"/>
                                <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100"
                                        Value="{Binding StudioColorRichness, Mode=TwoWay}"
                                        ToolTip="{DynamicResource Settings.StudioColorRichnessHint}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="{DynamicResource Settings.StudioTextStrength}"
                                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"/>
                                <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100"
                                        Value="{Binding StudioTextStrength, Mode=TwoWay}"
                                        ToolTip="{DynamicResource Settings.StudioTextStrengthHint}"/>
                            </StackPanel>
                        </UniformGrid>

                        <!-- GLASS & WATER (2026-09-05) — the liquid-crystal
                             layer: frosted → water-fill cards. -->
                        <TextBlock Text="{DynamicResource Settings.StudioGlassWater}"
                                   FontSize="10" FontWeight="Bold" Margin="0,6,0,2"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="{DynamicResource Settings.StudioWaterFlow}"
                                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"/>
                                <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100"
                                        Value="{Binding StudioWaterFlow, Mode=TwoWay}"
                                        ToolTip="{DynamicResource Settings.StudioWaterFlowHint}"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Settings.StudioWaterFlowCaption}"
                                       FontSize="{StaticResource TextCaption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                       Margin="0,0,10,6"/>
                        </UniformGrid>

                        <!-- ADVANCED — everything else -->
                        <TextBlock Text="{DynamicResource Settings.StudioAdvanced}"
                                   FontSize="10" FontWeight="Bold" Margin="0,6,0,2"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="{DynamicResource Settings.StudioTint}"
                                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"/>
                                <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100"
                                        Value="{Binding StudioGlassTint, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="{DynamicResource Settings.StudioPadding}"
                                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"/>
                                <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100"
                                        Value="{Binding StudioCardPadding, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="{DynamicResource Settings.StudioSoftness}"
                                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"/>
                                <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100"
                                        Value="{Binding StudioShadowSoftness, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="{DynamicResource Settings.StudioDepth}"
                                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"/>
                                <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100"
                                        Value="{Binding StudioShadowDepth, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="{DynamicResource Settings.StudioBorder}"
                                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"/>
                                <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100"
                                        Value="{Binding StudioBorderVisibility, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="{DynamicResource Settings.StudioBorderOpacity}"
                                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"/>
                                <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100"
                                        Value="{Binding StudioBorderOpacity, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="{DynamicResource Settings.StudioBorderWidth}"
                                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"/>
                                <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100"
                                        Value="{Binding StudioBorderThickness, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="{DynamicResource Settings.StudioBackground}"
                                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"/>
                                <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100"
                                        Value="{Binding StudioBackgroundVisibility, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="{DynamicResource Settings.StudioGlow}"
                                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"/>
                                <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100"
                                        Value="{Binding StudioBackgroundGlow, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="{DynamicResource Settings.StudioHighlight}"
                                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"/>
                                <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100"
                                        Value="{Binding StudioHighlightStrength, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="{DynamicResource Settings.StudioAnimation}"
                                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"/>
                                <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100"
                                        Value="{Binding StudioAnimationIntensity, Mode=TwoWay}"/>
                            </StackPanel>
                        </UniformGrid>

                    </StackPanel>
                </Border>

                <!-- ═══ WALLPAPER STUDIO (2026-09-05) ═══
                     Dynamic theme-linked scenes (code-drawn, accent-aware),
                     six built-in designs, one-tap 4K downloads with a
                     persistent local library. -->
                <Border Style="{StaticResource SettingsTileStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                            <TextBlock Style="{StaticResource SettingsTileTitleStyle}"
                                       Text="{DynamicResource Settings.WallpaperStudio}"/>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}" TextWrapping="Wrap"
                                       Text="{DynamicResource Settings.WallpaperStudioCaption}"/>
                        </StackPanel>

                        <!-- Mode: dynamic / file / pinned scene -->
                        <TextBlock Text="{DynamicResource Settings.WallpaperMode}"
                                   FontSize="{StaticResource TextBody}" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding WallpaperModeOptions}"
                                  SelectedItem="{Binding SelectedWallpaperMode, Mode=TwoWay}"
                                  Width="300" HorizontalAlignment="Left" Margin="0,2,0,4"/>

                        <!-- Built-in theme scenes (live swatches) -->
                        <TextBlock Text="{DynamicResource Settings.WallpaperBuiltin}"
                                   FontSize="10" FontWeight="Bold" Margin="0,6,0,2"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <ItemsControl ItemsSource="{Binding BuiltinSceneRows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource OutlinedPillButton}"
                                            Command="{Binding DataContext.ApplyBuiltinSceneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Key}"
                                            Margin="0,0,8,8" Padding="10,6">
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="36" Height="20" RadiusX="5" RadiusY="5"
                                                       Fill="{Binding Preview}"/>
                                            <TextBlock Text="{Binding Label}" Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Download 4K from the internet -->
                        <TextBlock Text="{DynamicResource Settings.WallpaperOnline}"
                                   FontSize="10" FontWeight="Bold" Margin="0,6,0,2"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ComboBox ItemsSource="{Binding OnlineCategoryRows}"
                                      DisplayMemberPath="Label" SelectedValuePath="Key"
                                      SelectedValue="{Binding SelectedOnlineCategoryKey, Mode=TwoWay}"
                                      Width="230" HorizontalAlignment="Left"/>
                            <Button Style="{StaticResource SuccessPillButton}"
                                    Command="{Binding FetchWallpaperCommand}"
                                    IsEnabled="{Binding IsWallpaperIdle}"
                                    Margin="10,0,0,0" Padding="16,7"
                                    Content="{DynamicResource Settings.WallpaperFetch}"/>
                            <ProgressBar Width="120" Height="8" Margin="14,0,0,0"
                                         VerticalAlignment="Center" IsIndeterminate="True"
                                         Foreground="{DynamicResource AccentBrush}"
                                         Visibility="{Binding IsWallpaperBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding WallpaperFetchStatus}"
                                   FontSize="{StaticResource TextCaption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,6"/>

                        <!-- Downloaded library (offline reuse) -->
                        <TextBlock Text="{DynamicResource Settings.WallpaperLibrary}"
                                   FontSize="10" FontWeight="Bold" Margin="0,4,0,2"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding CachedWallpapers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,1,0,1">
                                            <Button DockPanel.Dock="Right"
                                                    Style="{StaticResource OutlinedPillButton}"
                                                    Command="{Binding DataContext.ApplyCachedWallpaperCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding FullPath}"
                                                    Padding="12,3" FontSize="{StaticResource TextCaption}"
                                                    Content="{DynamicResource Settings.WallpaperApply}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}"
                                                       FontSize="{StaticResource TextCaption}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="10,0"/>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="{StaticResource TextBody}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <UniformGrid Columns="3" Margin="0,0,0,6">

                    <!-- Visual theme -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE790;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.LblThemeFamily}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.NormalMonetProfessionalIosLiquidGlassOcean}"/>
                            <ComboBox ItemsSource="{Binding VisualThemeOptions}"
                                      SelectedItem="{Binding SelectedVisualTheme}"
                                      HorizontalAlignment="Stretch"
                                      Padding="10,7" FontSize="{StaticResource TextBodyLarge}"/>
                        </StackPanel>
                    </Border>

                    <!-- Font Color (global text colour, 2026-08-25) -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE2B1;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.FontColor}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.OneGlobalTextColourViewAutoFollowsThemeIos}"/>
                            <!-- Chips generated from SettingsViewModel.FontColorPalette
                                 (Auto + FontColorPresets.All) — the swatch shown IS
                                 the exact primary colour that gets applied. -->
                            <ItemsControl ItemsSource="{Binding FontColorPalette}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ApplyFontColorCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Key}"
                                                Style="{StaticResource AccentChipStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="11" Height="11" Fill="{Binding Swatch}"
                                                         Stroke="{DynamicResource OutlineBrush}"
                                                         StrokeThickness="1"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Free-pick font colour: type any hex, the whole
                                 text hierarchy (primary/secondary/muted) re-derives. -->
                            <Border Margin="0,10,0,0" Padding="8,6" CornerRadius="8"
                                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="14" Height="14"
                                             Fill="{Binding CustomFontColorSwatch}"
                                             Stroke="{DynamicResource OutlineBrush}" StrokeThickness="1"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Text="{Binding CustomFontColorHex, UpdateSourceTrigger=PropertyChanged}"
                                             Width="96" Padding="8,5" FontSize="{StaticResource TextBodyLarge}"
                                             FontFamily="Consolas"
                                             VerticalAlignment="Center"/>
                                    <Button Command="{Binding ApplyCustomFontColorCommand}"
                                            Style="{StaticResource AccentChipStyle}" Margin="8,0,0,0">
                                        <TextBlock Text="{DynamicResource Action.Apply}"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}"
                                       Text="{Binding CustomFontColorStatus}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Defined card edges -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE71B;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.DefinedCardEdges}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.AddsStrongDarkOutlineRoundedCardsPillButtons}"/>
                            <ToggleButton Grid.Row="3"
                                          HorizontalAlignment="Left"
                                          IsChecked="{Binding UseDefinedOutline, Mode=TwoWay}"
                                          Style="{StaticResource ModernToggleSwitch}"/>
                        </Grid>
                    </Border>

                    <!-- Gradient surfaces (adaptive-theme depth) -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE7F4;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.GradientSurfaces}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.RendersMonetGlassCardsWindowBackgroundAccent}"/>
                            <ToggleButton Grid.Row="3"
                                          HorizontalAlignment="Left"
                                          IsChecked="{Binding UseGradientSurfaces, Mode=TwoWay}"
                                          Style="{StaticResource ModernToggleSwitch}"/>
                        </Grid>
                    </Border>

                    <!-- Card border thickness -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE72D;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.CardBorderThickness}"/>
                                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0"
                                           FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="{Binding CardBorderThickness, Mode=OneWay, StringFormat={}{0:0.#}}"/>
                                    <Run Text="{DynamicResource Settings.DIP}"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.EdgeWeightCardPanelApp0NoBorder}"/>
                            <Slider Style="{StaticResource ModernSliderStyle}"
                                    Minimum="0" Maximum="4"
                                    Value="{Binding CardBorderThickness, Mode=TwoWay}"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Corner radius -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE7B3;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.CardCornerRadius}"/>
                                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0"
                                           FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="{Binding CardCornerRadius, Mode=OneWay, StringFormat={}{0:0}}"/>
                                    <Run Text="{DynamicResource Settings.Px}"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.HowRoundCardButtonDefault12Px0Sharp}"/>
                            <Slider Style="{StaticResource ModernSliderStyle}"
                                    Minimum="0" Maximum="24"
                                    TickFrequency="2"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding CardCornerRadius, Mode=TwoWay}"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Display density -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE740;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.GrpDensity}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.CompactFitsMoreLaptopComfortableGivesLarger}"/>
                            <ComboBox ItemsSource="{Binding DisplayDensityOptions}"
                                      SelectedItem="{Binding DisplayDensity}"
                                      HorizontalAlignment="Stretch"
                                      Padding="10,7" FontSize="{StaticResource TextBodyLarge}"/>
                        </StackPanel>
                    </Border>

                    <!-- UI scale -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8A3;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.UIScale}"/>
                                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0"
                                           FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="{Binding UiScalePercent, Mode=OneWay}"/>
                                    <Run Text="%"/>
                                </TextBlock>
                                <Button Content="{DynamicResource Action.Reset}"
                                        Style="{StaticResource OutlinedPillButton}"
                                        Command="{Binding ResetUiScaleCommand}"
                                        Margin="12,0,0,0"
                                        Height="26" MinWidth="60" Padding="10,0"
                                        FontSize="{StaticResource TextCaption}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.CtrlMouseWheelZoomsAppCtrl0Resets100}"/>
                            <Slider Style="{StaticResource ModernSliderStyle}"
                                    Minimum="0.8" Maximum="1.25"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding UiScale, Mode=TwoWay}"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- PDF layout -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8A5;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.PDFLayout}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{Binding PdfLayoutHint}"/>
                            <ComboBox ItemsSource="{Binding PdfLayoutOptions}"
                                      SelectedItem="{Binding PdfLayout}"
                                      HorizontalAlignment="Stretch"
                                      Padding="10,7" FontSize="{StaticResource TextBodyLarge}"/>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}"
                                       Text="{DynamicResource Settings.AppliesPIJODNTaxInvoiceStatementSheetStore}"/>
                        </StackPanel>
                    </Border>

                    <!-- Motion & performance -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE9F5;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.MotionPerformance}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{Binding PerformanceTierDisplay}"/>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}"
                                       Text="{DynamicResource Settings.AnimationsAdaptDisplayRefreshRate6090120144}"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <Border Style="{StaticResource SettingsGroupSeparatorStyle}"/>

                <!-- ═════════ GROUP: ACCENT & FONT ═════════ -->
                <TextBlock Text="{DynamicResource Settings.AccentFONT}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.ColourIdentityTypographyAppliedScreen}"
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <UniformGrid Columns="3" Margin="0,0,0,6">

                    <!-- Accent palette (wide) -->
                    <Border Style="{StaticResource SettingsWideTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE790;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.LblAccent}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.ButtonsTintsHoverStatesMonetGlassSurfaces}"/>
                            <!-- Palette chips generated from SettingsViewModel.AccentPalette
                                 (single source of truth: AccentPresets.All) — the swatch
                                 shown IS the exact colour that gets applied. -->
                            <ItemsControl ItemsSource="{Binding AccentPalette}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ApplyAccentCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Key}"
                                                Style="{StaticResource AccentChipStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="11" Height="11" Fill="{Binding Swatch}"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Free-pick colour: type any hex, the whole adaptive palette
                                 (Monet glass, tints, keylines) re-derives from it. -->
                            <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="8"
                                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="14" Height="14"
                                             Fill="{Binding CustomAccentSwatch}"
                                             Stroke="{DynamicResource OutlineBrush}" StrokeThickness="1"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Text="{Binding CustomAccentHex, UpdateSourceTrigger=PropertyChanged}"
                                             Width="110" Padding="8,6" FontSize="{StaticResource TextBodyLarge}"
                                             FontFamily="Consolas"
                                             VerticalAlignment="Center"/>
                                    <Button Command="{Binding ApplyCustomAccentCommand}"
                                            Style="{StaticResource AccentChipStyle}" Margin="8,0,0,0">
                                        <TextBlock Text="{DynamicResource Settings.ApplyCustomColour}"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}"
                                       Text="{Binding CustomAccentStatus}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Font family -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE185;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.FontFamily}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.UsedScreenDialogTableIconsStaySegoeMDL2}"/>
                            <ComboBox ItemsSource="{Binding FontOptions}"
                                      SelectedItem="{Binding SelectedFont, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      HorizontalAlignment="Stretch"
                                      Padding="10,7" FontSize="{StaticResource TextBodyLarge}"
                                      MaxDropDownHeight="320"/>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}"
                                       Text="{Binding FontStatus}"/>
                        </StackPanel>
                    </Border>

                    <!-- Weight + Style -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8D2;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.FontWeightStyle}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.TuneWeightStyleWithinSelectedFamily}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding FontWeightChoices}"
                                          SelectedItem="{Binding SelectedFontWeight, Mode=TwoWay}"
                                          Padding="10,7" FontSize="{StaticResource TextBodyLarge}"/>
                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding FontStyleChoices}"
                                          SelectedItem="{Binding SelectedFontStyle, Mode=TwoWay}"
                                          Padding="10,7" FontSize="{StaticResource TextBodyLarge}"/>
                            </Grid>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Command="{Binding ImportFontCommand}"
                                        Style="{StaticResource AccentChipStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="{StaticResource TextBody}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource Settings.ImportFONT}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ResetFontCommand}"
                                        Style="{StaticResource AccentChipStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="{StaticResource TextBody}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource Action.Reset}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <Border Style="{StaticResource SettingsGroupSeparatorStyle}"/>

                <!-- ═════════ GROUP: WALLPAPERS ═════════ -->
                <TextBlock Text="{DynamicResource Settings.Wallpapers}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.OneImageBehindModulePlusModuleOverrides}"
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <!-- One card per row (Columns=1): Global Wallpaper fills the
                     full width, then Per-Module Wallpapers fills the full
                     width below it with its own three-column grid. -->
                <StackPanel Margin="0,0,0,6">

                    <!-- Global wallpaper — one card, all controls on one line -->
                    <Border Style="{StaticResource SettingsFullRowTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xEB9F;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.GlobalWallpaper}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.AppliedSystemWideBehindModuleModuleOverrides}"/>
                            <!-- Single line: SET / CLEAR on the left, visibility
                                 slider on the right, so global wallpaper + its
                                 visibility no longer take two separate tiles. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Style="{StaticResource OutlinedPillButton}"
                                        Tag="&#xE728;" Content="{DynamicResource Settings.SET}"
                                        Command="{Binding SetWallpaperCommand}"
                                        VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource RowOutlinedButton}"
                                        Tag="&#xE711;" Content="{DynamicResource Action.Clear}"
                                        Command="{Binding ClearWallpaperCommand}"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3"
                                           Text="{DynamicResource Settings.Visibility}"
                                           Style="{StaticResource LabelStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <Slider Grid.Column="4"
                                        Value="{Binding WallpaperOpacity}"
                                        Style="{StaticResource ModernSliderStyle}"
                                        Minimum="0.3" Maximum="1"
                                        VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding WallpaperStatus}"
                                       Style="{StaticResource SettingsTileFooterHintStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Per-module wallpapers — three columns under one card so
                         the list no longer grows the page by 17 stacked rows. -->
                    <Border Style="{StaticResource SettingsFullRowTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8B9;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.ModuleWallpapers}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.GiveModuleBackgroundImageListSplitThree}"/>

                            <ItemsControl ItemsSource="{Binding ModuleWallpaperRows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="{DynamicResource CardCornerRadius}"
                                                BorderBrush="{DynamicResource OutlineBrush}"
                                                BorderThickness="0,0,1,1"
                                                Padding="4,7"
                                                Margin="0,0,8,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 2026-08-25: checkmark replaced with an
                                                     iOS-style on/off pill (ModernToggleSwitch). -->
                                                <ToggleButton Grid.Column="0"
                                                              Style="{StaticResource ModernToggleSwitch}"
                                                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                              VerticalAlignment="Center"
                                                              ToolTip="{DynamicResource Settings.EnableModuleSWallpaper}"
                                                              Margin="0,0,8,0"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Label}"
                                                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,6,0"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}">
                                                    <TextBlock.ToolTip>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding FileName}" FontSize="{StaticResource TextCaption}"
                                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                        </StackPanel>
                                                    </TextBlock.ToolTip>
                                                </TextBlock>

                                                <Slider Grid.Column="2"
                                                        Value="{Binding OpacityValue}"
                                                        Style="{StaticResource ModernSliderStyle}"
                                                        Minimum="0.3" Maximum="1"
                                                        Width="76"
                                                        ToolTip="{DynamicResource Settings.Visibility}"
                                                        VerticalAlignment="Center"/>

                                                <Button Grid.Column="3"
                                                        Style="{StaticResource RowOutlinedButton}"
                                                        Tag="&#xE728;" Content="{DynamicResource Settings.SET}"
                                                        Command="{Binding DataContext.SetModuleWallpaperCommand,
                                                                            RelativeSource={RelativeSource
                                                                                AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="6,0,0,0"
                                                        FontSize="{StaticResource TextCaption}"
                                                        Padding="8,2"/>

                                                <Button Grid.Column="4"
                                                        Style="{StaticResource RowDangerButton}"
                                                        Tag="&#xE711;" Content=""
                                                        Command="{Binding DataContext.ClearModuleWallpaperCommand,
                                                                    RelativeSource={RelativeSource
                                                                        AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="6,0,0,0"
                                                        ToolTip="{DynamicResource Settings.RemoveModuleSWallpaper}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ═════════ GROUP: LANGUAGE &amp; CURRENCY ═════════ -->
                <TextBlock Text="{DynamicResource Settings.GrpLanguage}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.HintLanguage}"
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <UniformGrid Columns="3" Margin="0,0,0,6">

                    <!-- Language (15 shipped, live switch, en-US primary) -->
                    <Border Style="{StaticResource SettingsWideTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8EC;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}"
                                           Text="{DynamicResource Settings.LblLanguage}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.HintLanguage}"/>
                            <ComboBox AutomationProperties.AutomationId="Settings.Language"
                                      ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      MinWidth="180" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Currency (live FX, offline = last fetched) -->
                    <Border Style="{StaticResource SettingsWideTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xEAF1;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}"
                                           Text="{DynamicResource Settings.LblCurrency}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.HintCurrency}"/>
                            <ComboBox AutomationProperties.AutomationId="Settings.Currency"
                                      ItemsSource="{Binding Currencies}"
                                      SelectedItem="{Binding SelectedCurrency, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      MinWidth="180" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Phone country (from IP, editable) -->
                    <Border Style="{StaticResource SettingsWideTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE717;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}"
                                           Text="{DynamicResource Settings.LblPhoneCountry}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.HintPhoneCountry}"/>
                            <ComboBox AutomationProperties.AutomationId="Settings.PhoneCountry"
                                      ItemsSource="{Binding PhoneCountries}"
                                      SelectedItem="{Binding PhoneCountry, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      MinWidth="180" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Auto-detect + currency status -->
                <Border Style="{StaticResource SettingsGroupSeparatorStyle}"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <CheckBox Content="{DynamicResource Settings.LblAutoDetect}"
                                  IsChecked="{Binding AutoSuggestByRegion, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="Settings.AutoSuggestByRegion"/>
                        <TextBlock Text="{Binding FxStatusText}"
                                   Style="{StaticResource SettingsTileCaptionStyle}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{DynamicResource Settings.ResetToEnglish}"
                            Command="{Binding ResetToEnglishCommand}"
                            AutomationProperties.AutomationId="Settings.ResetLocale"
                            VerticalAlignment="Center"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
