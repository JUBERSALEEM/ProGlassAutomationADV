<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsAppearanceSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — APPEARANCE page (redesigned Aug 2026)

     REDESIGN
       Was: one giant SectionCardStyle per subject (Theme mode, Wallpaper,
       Accent, Font, Motion, Module wallpapers) containing full-width
       DockPanel rows. On wide monitors that wasted 60-70% of horizontal
       space; on 1366 laptops it felt endless.

       Now: a WrapPanel of individual "tiles" (SettingsTileStyle) that
       auto-flow into 2-4 columns. Wide surfaces (module wallpaper list,
       accent palette) use SettingsWideTileStyle / SettingsFullRowTileStyle
       so they still get proper width when they need it. Every binding is
       preserved byte-for-byte — this is a layout redesign, not a data
       change.

     Bindings target SettingsViewModel (DataContext flows from shell).
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsAppearanceSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,26,32,14">
            <TextBlock Text="Appearance" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Theme, colours, wallpapers, motion and per-module backgrounds."
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}">
            <StackPanel Margin="32,0,32,32">

                <!-- ═════════ GROUP: THEME & LAYOUT ═════════ -->
                <TextBlock Text="THEME &amp; LAYOUT"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="Overall look, card weight and density."
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <!-- 2026-08-25: one-tap factory reset for everything the
                     Appearance module owns (theme, accent, gradients, card
                     shape, density, zoom, font, wallpapers, PDF layout). -->
                <Button Style="{StaticResource SettingsActionButtonStyle}"
                        Content="RESET APPEARANCE TO DEFAULTS"
                        Tag="&#xE777;"
                        Command="{Binding ResetAppearanceCommand}"
                        AutomationProperties.AutomationId="Appearance.ResetDefaults"
                        ToolTip="Restore theme, accent, card shape, density, zoom, font and wallpapers to factory defaults"
                        HorizontalAlignment="Left"
                        Padding="18,8"
                        Margin="0,2,0,10"/>

                <UniformGrid Columns="3" Margin="0,0,0,6">

                    <!-- Visual theme -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE790;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Visual Theme"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="Normal, Monet, Professional, Glass, Glassy or Ocean — restyles the whole app instantly. Glass and Glassy are full iOS-style glass: the window gets real acrylic backdrop blur (Windows 10/11) and every card becomes a translucent frosted pane. Systems without blur support fall back to the frosted gradient stage automatically."/>
                            <ComboBox ItemsSource="{Binding VisualThemeOptions}"
                                      SelectedItem="{Binding SelectedVisualTheme}"
                                      HorizontalAlignment="Stretch"
                                      Padding="10,7" FontSize="{StaticResource TextBodyLarge}"/>
                        </StackPanel>
                    </Border>

                    <!-- Font Color (global text colour, 2026-08-25) -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE2B1;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Font Color"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="One global text colour for every view. Auto follows the theme (Glassy uses the About palette); pick a colour so text always stays visible over transparent glass."/>
                            <!-- Chips generated from SettingsViewModel.FontColorPalette
                                 (Auto + FontColorPresets.All) — the swatch shown IS
                                 the exact primary colour that gets applied. -->
                            <ItemsControl ItemsSource="{Binding FontColorPalette}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ApplyFontColorCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Key}"
                                                Style="{StaticResource AccentChipStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="11" Height="11" Fill="{Binding Swatch}"
                                                         Stroke="{DynamicResource OutlineBrush}"
                                                         StrokeThickness="1"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Free-pick font colour: type any hex, the whole
                                 text hierarchy (primary/secondary/muted) re-derives. -->
                            <Border Margin="0,10,0,0" Padding="8,6" CornerRadius="8"
                                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="14" Height="14"
                                             Fill="{Binding CustomFontColorSwatch}"
                                             Stroke="{DynamicResource OutlineBrush}" StrokeThickness="1"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Text="{Binding CustomFontColorHex, UpdateSourceTrigger=PropertyChanged}"
                                             Width="96" Padding="8,5" FontSize="{StaticResource TextBodyLarge}"
                                             FontFamily="Consolas"
                                             VerticalAlignment="Center"/>
                                    <Button Command="{Binding ApplyCustomFontColorCommand}"
                                            Style="{StaticResource AccentChipStyle}" Margin="8,0,0,0">
                                        <TextBlock Text="APPLY"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}"
                                       Text="{Binding CustomFontColorStatus}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Defined card edges -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE71B;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Defined Card Edges"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="Adds a strong dark outline on rounded cards and pill buttons so they stay visually separate."/>
                            <ToggleButton Grid.Row="3"
                                          HorizontalAlignment="Left"
                                          IsChecked="{Binding UseDefinedOutline, Mode=TwoWay}"
                                          Style="{StaticResource ModernToggleSwitch}"/>
                        </Grid>
                    </Border>

                    <!-- Gradient surfaces (adaptive-theme depth) -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE7F4;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Gradient Surfaces"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="Renders Monet glass, cards and the window background as accent-derived gradients for a richer adaptive look. Off = the same palette, flat."/>
                            <ToggleButton Grid.Row="3"
                                          HorizontalAlignment="Left"
                                          IsChecked="{Binding UseGradientSurfaces, Mode=TwoWay}"
                                          Style="{StaticResource ModernToggleSwitch}"/>
                        </Grid>
                    </Border>

                    <!-- Card border thickness -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE72D;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Card Border Thickness"/>
                                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0"
                                           FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="{Binding CardBorderThickness, Mode=OneWay, StringFormat={}{0:0.#}}"/>
                                    <Run Text=" DIP"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="Edge weight of every card and panel across the app. 0 = no border."/>
                            <Slider Style="{StaticResource ModernSliderStyle}"
                                    Minimum="0" Maximum="4"
                                    Value="{Binding CardBorderThickness, Mode=TwoWay}"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Corner radius -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE7B3;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Card Corner Radius"/>
                                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0"
                                           FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="{Binding CardCornerRadius, Mode=OneWay, StringFormat={}{0:0}}"/>
                                    <Run Text=" px"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="How round every card and button is. Default 12 px, 0 is sharp rectangles."/>
                            <Slider Style="{StaticResource ModernSliderStyle}"
                                    Minimum="0" Maximum="24"
                                    TickFrequency="2"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding CardCornerRadius, Mode=TwoWay}"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Display density -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE740;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Display Density"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="Compact fits more on a laptop; Comfortable gives larger touch targets."/>
                            <ComboBox ItemsSource="{Binding DisplayDensityOptions}"
                                      SelectedItem="{Binding DisplayDensity}"
                                      HorizontalAlignment="Stretch"
                                      Padding="10,7" FontSize="{StaticResource TextBodyLarge}"/>
                        </StackPanel>
                    </Border>

                    <!-- UI scale -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8A3;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="UI Scale"/>
                                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0"
                                           FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="{Binding UiScalePercent, Mode=OneWay}"/>
                                    <Run Text="%"/>
                                </TextBlock>
                                <Button Content="RESET"
                                        Style="{StaticResource OutlinedPillButton}"
                                        Command="{Binding ResetUiScaleCommand}"
                                        Margin="12,0,0,0"
                                        Height="26" MinWidth="60" Padding="10,0"
                                        FontSize="{StaticResource TextCaption}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="Ctrl + mouse wheel zooms the app. Ctrl + 0 resets to 100 %."/>
                            <Slider Style="{StaticResource ModernSliderStyle}"
                                    Minimum="0.8" Maximum="1.25"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding UiScale, Mode=TwoWay}"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- PDF layout -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8A5;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="PDF Layout"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{Binding PdfLayoutHint}"/>
                            <ComboBox ItemsSource="{Binding PdfLayoutOptions}"
                                      SelectedItem="{Binding PdfLayout}"
                                      HorizontalAlignment="Stretch"
                                      Padding="10,7" FontSize="{StaticResource TextBodyLarge}"/>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}"
                                       Text="Applies to PI, JO, DN, Tax Invoice, Statement and Sheet Store on the next export."/>
                        </StackPanel>
                    </Border>

                    <!-- Motion & performance -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE9F5;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Motion &amp; Performance"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{Binding PerformanceTierDisplay}"/>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}"
                                       Text="Animations adapt to your display refresh rate (60 / 90 / 120 / 144 / 165 Hz)."/>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <Border Style="{StaticResource SettingsGroupSeparatorStyle}"/>

                <!-- ═════════ GROUP: ACCENT & FONT ═════════ -->
                <TextBlock Text="ACCENT &amp; FONT"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="Colour identity and typography — applied across every screen."
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <UniformGrid Columns="3" Margin="0,0,0,6">

                    <!-- Accent palette (wide) -->
                    <Border Style="{StaticResource SettingsWideTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE790;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Accent Colour"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="Buttons, tints, hover states and Monet glass surfaces are all derived from this. Your choice is saved and restored on every start."/>
                            <!-- Palette chips generated from SettingsViewModel.AccentPalette
                                 (single source of truth: AccentPresets.All) — the swatch
                                 shown IS the exact colour that gets applied. -->
                            <ItemsControl ItemsSource="{Binding AccentPalette}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ApplyAccentCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Key}"
                                                Style="{StaticResource AccentChipStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="11" Height="11" Fill="{Binding Swatch}"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Free-pick colour: type any hex, the whole adaptive palette
                                 (Monet glass, tints, keylines) re-derives from it. -->
                            <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="8"
                                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="14" Height="14"
                                             Fill="{Binding CustomAccentSwatch}"
                                             Stroke="{DynamicResource OutlineBrush}" StrokeThickness="1"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Text="{Binding CustomAccentHex, UpdateSourceTrigger=PropertyChanged}"
                                             Width="110" Padding="8,6" FontSize="{StaticResource TextBodyLarge}"
                                             FontFamily="Consolas"
                                             VerticalAlignment="Center"/>
                                    <Button Command="{Binding ApplyCustomAccentCommand}"
                                            Style="{StaticResource AccentChipStyle}" Margin="8,0,0,0">
                                        <TextBlock Text="APPLY CUSTOM COLOUR"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}"
                                       Text="{Binding CustomAccentStatus}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Font family -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE185;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Font Family"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="Used on every screen, dialog and table (icons stay on Segoe MDL2)."/>
                            <ComboBox ItemsSource="{Binding FontOptions}"
                                      SelectedItem="{Binding SelectedFont, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      HorizontalAlignment="Stretch"
                                      Padding="10,7" FontSize="{StaticResource TextBodyLarge}"
                                      MaxDropDownHeight="320"/>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}"
                                       Text="{Binding FontStatus}"/>
                        </StackPanel>
                    </Border>

                    <!-- Weight + Style -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8D2;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Font Weight &amp; Style"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="Tune the weight and style within the selected family."/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding FontWeightChoices}"
                                          SelectedItem="{Binding SelectedFontWeight, Mode=TwoWay}"
                                          Padding="10,7" FontSize="{StaticResource TextBodyLarge}"/>
                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding FontStyleChoices}"
                                          SelectedItem="{Binding SelectedFontStyle, Mode=TwoWay}"
                                          Padding="10,7" FontSize="{StaticResource TextBodyLarge}"/>
                            </Grid>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Command="{Binding ImportFontCommand}"
                                        Style="{StaticResource AccentChipStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="{StaticResource TextBody}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="IMPORT FONT…" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ResetFontCommand}"
                                        Style="{StaticResource AccentChipStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="{StaticResource TextBody}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="RESET" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <Border Style="{StaticResource SettingsGroupSeparatorStyle}"/>

                <!-- ═════════ GROUP: WALLPAPERS ═════════ -->
                <TextBlock Text="WALLPAPERS"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="One image behind every module, plus per-module overrides for individual screens."
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <!-- One card per row (Columns=1): Global Wallpaper fills the
                     full width, then Per-Module Wallpapers fills the full
                     width below it with its own three-column grid. -->
                <StackPanel Margin="0,0,0,6">

                    <!-- Global wallpaper — one card, all controls on one line -->
                    <Border Style="{StaticResource SettingsFullRowTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xEB9F;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Global Wallpaper"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="Applied system-wide behind every module. Per-module overrides win where set."/>
                            <!-- Single line: SET / CLEAR on the left, visibility
                                 slider on the right, so global wallpaper + its
                                 visibility no longer take two separate tiles. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Style="{StaticResource OutlinedPillButton}"
                                        Tag="&#xE728;" Content="SET…"
                                        Command="{Binding SetWallpaperCommand}"
                                        VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource RowOutlinedButton}"
                                        Tag="&#xE711;" Content="CLEAR"
                                        Command="{Binding ClearWallpaperCommand}"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3"
                                           Text="Visibility"
                                           Style="{StaticResource LabelStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <Slider Grid.Column="4"
                                        Value="{Binding WallpaperOpacity}"
                                        Style="{StaticResource ModernSliderStyle}"
                                        Minimum="0.3" Maximum="1"
                                        VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding WallpaperStatus}"
                                       Style="{StaticResource SettingsTileFooterHintStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Per-module wallpapers — three columns under one card so
                         the list no longer grows the page by 17 stacked rows. -->
                    <Border Style="{StaticResource SettingsFullRowTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8B9;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Per-Module Wallpapers"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="Give any module its own background image. The list is split into three columns; per-module visibility uses the small slider, everything else follows the global value above."/>

                            <ItemsControl ItemsSource="{Binding ModuleWallpaperRows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="{DynamicResource CardCornerRadius}"
                                                BorderBrush="{DynamicResource OutlineBrush}"
                                                BorderThickness="0,0,1,1"
                                                Padding="4,7"
                                                Margin="0,0,8,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 2026-08-25: checkmark replaced with an
                                                     iOS-style on/off pill (ModernToggleSwitch). -->
                                                <ToggleButton Grid.Column="0"
                                                              Style="{StaticResource ModernToggleSwitch}"
                                                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                              VerticalAlignment="Center"
                                                              ToolTip="Enable this module's wallpaper"
                                                              Margin="0,0,8,0"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Label}"
                                                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,6,0"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}">
                                                    <TextBlock.ToolTip>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding FileName}" FontSize="{StaticResource TextCaption}"
                                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                        </StackPanel>
                                                    </TextBlock.ToolTip>
                                                </TextBlock>

                                                <Slider Grid.Column="2"
                                                        Value="{Binding OpacityValue}"
                                                        Style="{StaticResource ModernSliderStyle}"
                                                        Minimum="0.3" Maximum="1"
                                                        Width="76"
                                                        ToolTip="Visibility"
                                                        VerticalAlignment="Center"/>

                                                <Button Grid.Column="3"
                                                        Style="{StaticResource RowOutlinedButton}"
                                                        Tag="&#xE728;" Content="SET"
                                                        Command="{Binding DataContext.SetModuleWallpaperCommand,
                                                                            RelativeSource={RelativeSource
                                                                                AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="6,0,0,0"
                                                        FontSize="{StaticResource TextCaption}"
                                                        Padding="8,2"/>

                                                <Button Grid.Column="4"
                                                        Style="{StaticResource RowDangerButton}"
                                                        Tag="&#xE711;" Content=""
                                                        Command="{Binding DataContext.ClearModuleWallpaperCommand,
                                                                    RelativeSource={RelativeSource
                                                                        AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="6,0,0,0"
                                                        ToolTip="Remove this module's wallpaper"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
