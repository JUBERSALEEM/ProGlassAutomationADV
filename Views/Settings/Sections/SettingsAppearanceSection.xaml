<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsAppearanceSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings — APPEARANCE (Full Light Studio Bento redesign)
     Visual source of truth: mockups/v4-01-appearance.png
     Smart 5-card Bento placement for compact preference controls,
     followed by dedicated full-width studios for Typography & Wallpapers.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsAppearanceSection"
             xmlns:crystal="clr-namespace:ProGlassAutomation.Controls.CrystalFluid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cards="clr-namespace:ProGlassAutomation.Views.Settings.Sections.Cards"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             RenderOptions.ClearTypeHint="Enabled"
             RenderOptions.EdgeMode="Aliased">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly"
                  behaviors:SmoothScrollBehavior.IsEnabled="True"
                  Focusable="False"
                  FocusVisualStyle="{x:Null}">
        <StackPanel Margin="{StaticResource SettingsPagePadding}">

            <!-- ═══ BENTO HERO BANNER — APPEARANCE & WORKSPACE ═══ -->
            <Border Style="{StaticResource SettingsHeroCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SettingsHeroIconTileStyle}">
                        <TextBlock Text="&#xE790;" Style="{StaticResource SettingsHeroIconGlyphStyle}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center">
                        <TextBlock Text="Appearance &amp; Studio Workspace" Style="{StaticResource SettingsHeroTitleStyle}"/>
                        <TextBlock Text="Full Light Studio Bento visual system, typography ladder, and color accents" Style="{StaticResource SettingsHeroNoteStyle}"/>
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource SettingsHeroBadgeStyle}">
                        <TextBlock Text="Active Studio" Style="{StaticResource SettingsHeroBadgeTextStyle}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ 5-CARD SMART BENTO DECK: COMPACT PREFERENCE CONTROLS ═══ -->
            <!-- Row 1: Mode + Density & Scale. Splash Screen host removed
                 (owner ruling: no Crystal Glassmorphism splash, no "10
                 corporate glass architectures", no splash reboot on this
                 page — the card file stays unhosted). -->
            <!-- Row gap is the card's own margin. A second 16px on the
                 grid stacked on that and left a hole under the shorter cards. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.3*"/>
                </Grid.ColumnDefinitions>
                <cards:AppearanceModeCard Grid.Column="0" Margin="{StaticResource SettingsBentoCol3Left}" VerticalAlignment="Top"/>
                <cards:AppearanceDensityCard Grid.Column="1" Margin="{StaticResource SettingsBentoCol3Mid}" VerticalAlignment="Top"/>
            </Grid>

            <!-- Theme & Layout is the tall surface card. It used to share a
                 row with Language & Currency, and the grid stretched the
                 shorter card to the same height. Full width keeps both at
                 their content height. The card style already supplies the
                 bottom margin. -->
            <cards:AppearanceThemeLayoutCard/>

            <cards:AppearanceLanguageCard/>

            <!-- Frosted-module-card tile unhosted (owner ruling: no
                 opacity/transparency surface sliders on this page). The
                 outline choice stays — it is a kept preference. -->
            <Border Style="{StaticResource SettingsCompactCardStyle}"
                    Margin="0,0,0,10" VerticalAlignment="Top">
                <cards:AppearanceCardEdgesTile/>
            </Border>

            <!-- Theme family stays in the Theme Engine combo above. A second
                 copy of that combo was the old tile; hosting both on this
                 page would show two controls for one setting. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SettingsCompactCardStyle}"
                        Margin="0,0,8,10" VerticalAlignment="Top">
                    <cards:AppearanceGradientTile/>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource SettingsCompactCardStyle}"
                        Margin="8,0,0,10" VerticalAlignment="Top">
                    <cards:AppearanceRadiusTile/>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SettingsCompactCardStyle}"
                        Margin="0,0,8,10" VerticalAlignment="Top">
                    <cards:AppearanceFontColorTile/>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource SettingsCompactCardStyle}"
                        Margin="8,0,0,10" VerticalAlignment="Top">
                    <cards:AppearancePreviewTile/>
                </Border>
            </Grid>

            <!-- Crystal Fluid environment tile unhosted (owner ruling:
                 this page must not sell Crystal) — file left unhosted. -->

            <!-- ═══ MAJOR STUDIO CARDS ═══ -->
            <!-- 1. Brand Accent Palette & Typography Studio -->
            <cards:AppearanceAccentFontCard/>

            <!-- 2. Studio Wallpapers & Atmospheric Depth -->
            <cards:AppearanceWallpapersCard/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
