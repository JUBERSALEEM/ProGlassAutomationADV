<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsAppearanceSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings — APPEARANCE (Full Light Studio Bento redesign)
     Visual source of truth: mockups/v4-01-appearance.png
     Preserves all bindings to SettingsViewModel while elevating the
     layout hierarchy, card grammar, spacing, and typography ladder.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsAppearanceSection"
             xmlns:crystal="clr-namespace:ProGlassAutomation.Controls.CrystalFluid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cards="clr-namespace:ProGlassAutomation.Views.Settings.Sections.Cards"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly"
                  behaviors:SmoothScrollBehavior.IsEnabled="True"
                  Focusable="False"
                  FocusVisualStyle="{x:Null}">
        <StackPanel Margin="{StaticResource SettingsPagePadding}">

            <!-- ═══ BENTO HERO BANNER — APPEARANCE & WORKSPACE ═══ -->
            <Border Style="{StaticResource SettingsPageCardStyle}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                        <TextBlock Text="&#xE790;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center">
                        <TextBlock Text="Appearance &amp; Studio Workspace" Style="{StaticResource SettingsCardTitleStyle}"/>
                        <TextBlock Text="Full Light Studio Bento visual system, typography ladder, and color accents" Style="{StaticResource SettingsCardNoteStyle}"/>
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource SettingsChipStyle}"
                            Background="{DynamicResource TintBlueBrush}" VerticalAlignment="Center">
                        <TextBlock Text="Active Studio" Style="{StaticResource SettingsChipTextStyle}"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ CARD — THEME & LAYOUT ═══ -->
            <cards:AppearanceThemeLayoutCard/>

            <!-- ═══ CARD — MODE (sheet 02: the base colour mode) ═══ -->
            <cards:AppearanceModeCard/>

            <!-- ═══ CARD — DISPLAY DENSITY (sheet 03) ═══ -->
            <cards:AppearanceDensityCard/>

            <!-- ═══ CARD — ACCENT & FONT ═══ -->
            <cards:AppearanceAccentFontCard/>

            <!-- ═══ CARD — WALLPAPERS ═══ -->
            <cards:AppearanceWallpapersCard/>

            <!-- ═══ CARD — SPLASH SCREEN THEMES ═══ -->
            <cards:AppearanceSplashCard/>

            <!-- ═══ CARD — LANGUAGE &amp; CURRENCY ═══ -->
            <cards:AppearanceLanguageCard/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
