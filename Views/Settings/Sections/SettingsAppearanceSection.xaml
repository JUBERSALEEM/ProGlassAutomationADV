<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsAppearanceSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings — APPEARANCE (Full Light Studio Bento redesign)
     Visual source of truth: mockups/v4-01-appearance.png
     Smart 5-card Bento placement for compact preference controls,
     followed by dedicated full-width studios for Typography & Wallpapers.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsAppearanceSection"
             xmlns:crystal="clr-namespace:ProGlassAutomation.Controls.CrystalFluid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cards="clr-namespace:ProGlassAutomation.Views.Settings.Sections.Cards"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             RenderOptions.ClearTypeHint="Enabled"
             RenderOptions.EdgeMode="Aliased">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly"
                  behaviors:SmoothScrollBehavior.IsEnabled="True"
                  Focusable="False"
                  FocusVisualStyle="{x:Null}">
        <StackPanel Margin="{StaticResource SettingsPagePadding}">

            <!-- ═══ BENTO HERO BANNER — APPEARANCE & WORKSPACE ═══ -->
            <Border Style="{StaticResource SettingsHeroCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SettingsHeroIconTileStyle}">
                        <TextBlock Text="&#xE790;" Style="{StaticResource SettingsHeroIconGlyphStyle}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center">
                        <TextBlock Text="Appearance &amp; Studio Workspace" Style="{StaticResource SettingsHeroTitleStyle}"/>
                        <TextBlock Text="Full Light Studio Bento visual system, typography ladder, and color accents" Style="{StaticResource SettingsHeroNoteStyle}"/>
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource SettingsHeroBadgeStyle}">
                        <TextBlock Text="Active Studio" Style="{StaticResource SettingsHeroBadgeTextStyle}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ 5-CARD SMART BENTO DECK: COMPACT PREFERENCE CONTROLS ═══ -->
            <!-- Row 1: 3-column Bento grid (Mode, Density & Scale, Splash Screen) -->
            <Grid Margin="{StaticResource SettingsBentoRowMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="1.3*"/>
                </Grid.ColumnDefinitions>
                <cards:AppearanceModeCard Grid.Column="0" Margin="{StaticResource SettingsBentoCol3Left}"/>
                <cards:AppearanceDensityCard Grid.Column="1" Margin="{StaticResource SettingsBentoCol3Mid}"/>
                <cards:AppearanceSplashCard Grid.Column="2" Margin="{StaticResource SettingsBentoCol3Right}"/>
            </Grid>

            <!-- Row 2: 2-column balanced Bento grid (Surface Architecture & Regional Localization) -->
            <Grid Margin="{StaticResource SettingsBentoRowMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
            <!-- 2026-09-23: owner asked for a little more gutter width between
                 the Theme and Language cards than the shared 8+8 bento margins;
                 12+12 = 24 px matches the SettingsUniformGap tile rhythm. -->
            <cards:AppearanceThemeLayoutCard Grid.Column="0" Margin="0,0,12,0"/>
            <cards:AppearanceLanguageCard Grid.Column="1" Margin="12,0,0,0"/>
            </Grid>

            <!-- ═══ MAJOR STUDIO CARDS ═══ -->
            <!-- 1. Brand Accent Palette & Typography Studio -->
            <cards:AppearanceAccentFontCard Margin="{StaticResource SettingsCardMargin}"/>

            <!-- 2. Studio Wallpapers & Atmospheric Depth -->
            <cards:AppearanceWallpapersCard Margin="{StaticResource SettingsCardMargin}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
