<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsAppearanceSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — APPEARANCE page

     Cards: theme mode · wallpaper · accent colour · motion &
     performance · module wallpapers.
     All bindings target SettingsViewModel (DataContext flows from shell).
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsAppearanceSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,26,32,14">
            <TextBlock Text="Appearance" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Theme, colours, wallpapers and motion."
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}">
            <StackPanel Margin="32,0,32,32" MaxWidth="780"
                        HorizontalAlignment="Left">

                <!-- ── THEME MODE ─────────────────────────────────── -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="THEME MODE"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <DockPanel Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#xE706;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="Dark Mode"
                                           Style="{StaticResource RowTitleStyle}"/>
                            </StackPanel>
                            <ToggleButton HorizontalAlignment="Right"
                                          IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                          Style="{StaticResource ModernToggleSwitch}"/>
                        </DockPanel>

                        <TextBlock Text="Visual Theme"
                                   Style="{StaticResource RowTitleStyle}"
                                   Margin="0,16,0,6"/>
                        <ComboBox ItemsSource="{Binding VisualThemeOptions}"
                                  SelectedItem="{Binding SelectedVisualTheme}"
                                  MinWidth="200"
                                  Padding="10,7"
                                  FontSize="13"/>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Text="Normal = clean default. Monet = wallpaper with glass surfaces. Professional = premium corporate finish."/>
                    </StackPanel>
                </Border>

                <!-- ── WALLPAPER ──────────────────────────────────── -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="WALLPAPER"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Tag="&#xE728;" Content="SET WALLPAPER…"
                                    Command="{Binding SetWallpaperCommand}"/>
                            <Button Style="{StaticResource RowOutlinedButton}"
                                    Tag="&#xE711;" Content="CLEAR"
                                    Command="{Binding ClearWallpaperCommand}"
                                    Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding WallpaperStatus}"
                                   FontSize="11" Margin="0,8,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Wallpaper visibility"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <Slider Value="{Binding WallpaperOpacity}"
                                    Minimum="0.3" Maximum="1"
                                    Width="180"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── ACCENT COLOUR ──────────────────────────────── -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="ACCENT COLOUR"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Glass Blue" Command="{Binding ApplyAccentCommand}" CommandParameter="GlassBlue" Style="{StaticResource AccentChipStyle}"/>
                            <Button Content="Emerald"    Command="{Binding ApplyAccentCommand}" CommandParameter="Emerald"   Style="{StaticResource AccentChipStyle}"/>
                            <Button Content="Amber"      Command="{Binding ApplyAccentCommand}" CommandParameter="Amber"     Style="{StaticResource AccentChipStyle}"/>
                            <Button Content="Rose"       Command="{Binding ApplyAccentCommand}" CommandParameter="Rose"      Style="{StaticResource AccentChipStyle}"/>
                            <Button Content="Violet"     Command="{Binding ApplyAccentCommand}" CommandParameter="Violet"    Style="{StaticResource AccentChipStyle}"/>
                            <Button Content="Teal"       Command="{Binding ApplyAccentCommand}" CommandParameter="Teal"      Style="{StaticResource AccentChipStyle}"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,2,0,0"
                                   Text="The engine derives hover, tint and contrast colours automatically from the chosen accent."/>
                    </StackPanel>
                </Border>

                <!-- ── MOTION & PERFORMANCE ───────────────────────── -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="MOTION &amp; PERFORMANCE"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,6,0,0"
                                   Text="{Binding PerformanceTierDisplay}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,4,0,0"
                                   Text="Animations adapt to your display refresh rate (60/90/120/144/165 Hz)."/>
                    </StackPanel>
                </Border>

                <!-- ── MODULE WALLPAPERS ──────────────────────────── -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="MODULE WALLPAPERS"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,6,0,10"
                                   TextWrapping="Wrap"
                                   Text="Give any module its own background image. The image stays behind readable UI — surfaces become slightly transparent where the active theme supports it."/>

                        <ItemsControl ItemsSource="{Binding ModuleWallpaperRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource DividerBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="2,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Label}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding FileName}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="8,0"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                                            <StackPanel Grid.Column="3"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Slider Value="{Binding OpacityValue}"
                                                        Minimum="0.3" Maximum="1"
                                                        Width="110"
                                                        ToolTip="Visibility"
                                                        VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource RowOutlinedButton}"
                                                        Tag="&#xE728;" Content="SET"
                                                        Command="{Binding DataContext.SetModuleWallpaperCommand,
                                                                            RelativeSource={RelativeSource
                                                                                AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="10,0,0,0"
                                                        FontSize="11"/>
                                            </StackPanel>

                                            <Button Grid.Column="4"
                                                    Style="{StaticResource RowDangerButton}"
                                                    Tag="&#xE711;" Content=""
                                                    Command="{Binding DataContext.ClearModuleWallpaperCommand,
                                                                RelativeSource={RelativeSource
                                                                    AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="8,0,0,0"
                                                    ToolTip="Remove this module's wallpaper"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
