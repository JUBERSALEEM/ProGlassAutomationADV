<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsAppearanceSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — APPEARANCE page

     Cards: theme mode · wallpaper · accent colour · motion &
     performance · module wallpapers.
     All bindings target SettingsViewModel (DataContext flows from shell).
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsAppearanceSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,26,32,14">
            <TextBlock Text="Appearance" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Theme, colours, wallpapers and motion."
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}">
            <StackPanel Margin="32,0,32,32">

                <!-- ── THEME MODE ─────────────────────────────────── -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="THEME MODE"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <DockPanel Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#xE706;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="Dark Mode"
                                           Style="{StaticResource RowTitleStyle}"/>
                            </StackPanel>
                            <ToggleButton HorizontalAlignment="Right"
                                          IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                          Style="{StaticResource ModernToggleSwitch}"/>
                        </DockPanel>

                        <TextBlock Text="Visual Theme"
                                   Style="{StaticResource RowTitleStyle}"
                                   Margin="0,16,0,6"/>
                        <ComboBox ItemsSource="{Binding VisualThemeOptions}"
                                  SelectedItem="{Binding SelectedVisualTheme}"
                                  MinWidth="200"
                                  Padding="10,7"
                                  FontSize="13"/>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Text="Normal = clean default. Monet = colour-adaptive glass surfaces derived from your accent colour. Professional = premium corporate finish with cool crisp surfaces."/>

                        <!-- Defined card edge — one switch, applied globally
                             through the OutlineBrush theme key. -->
                        <Border Height="1" Margin="0,18,0,16"
                                Background="{DynamicResource DividerBrush}"/>

                        <DockPanel>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#xE71B;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="Defined Card Edges"
                                           Style="{StaticResource RowTitleStyle}"/>
                            </StackPanel>
                            <ToggleButton HorizontalAlignment="Right"
                                          IsChecked="{Binding UseDefinedOutline, Mode=TwoWay}"
                                          Style="{StaticResource ModernToggleSwitch}"/>
                        </DockPanel>

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Text="Draws a strong dark outline on rounded cards and pill buttons so they stay clearly separate from tinted surfaces instead of blending into them. Applies everywhere in the app and adapts to Light and Dark themes."/>
                    </StackPanel>
                </Border>

                <!-- ── WALLPAPER ──────────────────────────────────── -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="WALLPAPER"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Tag="&#xE728;" Content="SET WALLPAPER…"
                                    Command="{Binding SetWallpaperCommand}"/>
                            <Button Style="{StaticResource RowOutlinedButton}"
                                    Tag="&#xE711;" Content="CLEAR"
                                    Command="{Binding ClearWallpaperCommand}"
                                    Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding WallpaperStatus}"
                                   FontSize="11" Margin="0,8,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Text="One wallpaper, every view: the image is applied system-wide behind all modules. Per-module wallpapers below override it for individual screens."/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Wallpaper visibility"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <Slider Value="{Binding WallpaperOpacity}"
                                    Minimum="0.3" Maximum="1"
                                    Width="180"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── ACCENT COLOUR ──────────────────────────────── -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="ACCENT COLOUR"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Command="{Binding ApplyAccentCommand}" CommandParameter="GlassBlue" Style="{StaticResource AccentChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="11" Height="11" Fill="#1D4ED8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Glass Blue" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ApplyAccentCommand}" CommandParameter="Emerald" Style="{StaticResource AccentChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="11" Height="11" Fill="#059669" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Emerald" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ApplyAccentCommand}" CommandParameter="Amber" Style="{StaticResource AccentChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="11" Height="11" Fill="#D97706" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Amber" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ApplyAccentCommand}" CommandParameter="Rose" Style="{StaticResource AccentChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="11" Height="11" Fill="#E11D48" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Rose" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ApplyAccentCommand}" CommandParameter="Violet" Style="{StaticResource AccentChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="11" Height="11" Fill="#7C3AED" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Violet" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ApplyAccentCommand}" CommandParameter="Teal" Style="{StaticResource AccentChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="11" Height="11" Fill="#0D9488" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Teal" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Near-black (#111827), not pure #000000: a
                                 literal black edge on a near-black dark card
                                 is about 1.18:1 and reads as a hole. This
                                 stays neutral instead of being pushed to a
                                 blue-grey by the accent saturation floor. -->
                            <Button Command="{Binding ApplyAccentCommand}" CommandParameter="Black" Style="{StaticResource AccentChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="11" Height="11" Fill="#111827" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Black" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,2,0,0"
                                   Text="The whole UI adapts to the chosen accent — buttons, tints, hover states and Monet glass surfaces are all derived from it. Your choice is saved and restored on every start."/>
                    </StackPanel>
                </Border>

                <!-- ── MOTION & PERFORMANCE ───────────────────────── -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="MOTION &amp; PERFORMANCE"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,6,0,0"
                                   Text="{Binding PerformanceTierDisplay}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,4,0,0"
                                   Text="Animations adapt to your display refresh rate (60/90/120/144/165 Hz)."/>
                    </StackPanel>
                </Border>

                <!-- ── MODULE WALLPAPERS ──────────────────────────── -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="MODULE WALLPAPERS"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,6,0,10"
                                   TextWrapping="Wrap"
                                   Text="Give any module its own background image. The image stays behind readable UI — surfaces become slightly transparent where the active theme supports it."/>

                        <ItemsControl ItemsSource="{Binding ModuleWallpaperRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="{DynamicResource CardCornerRadius}" BorderBrush="{DynamicResource OutlineBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="2,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"/>

                                            <!-- LAYOUT FIX: fixed 170px column with
                                                 no trimming clipped long module names
                                                 mid-character. Column 2 already trims. -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Label}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Label}"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding FileName}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="8,0"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                                            <StackPanel Grid.Column="3"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Slider Value="{Binding OpacityValue}"
                                                        Minimum="0.3" Maximum="1"
                                                        Width="110"
                                                        ToolTip="Visibility"
                                                        VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource RowOutlinedButton}"
                                                        Tag="&#xE728;" Content="SET"
                                                        Command="{Binding DataContext.SetModuleWallpaperCommand,
                                                                            RelativeSource={RelativeSource
                                                                                AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="10,0,0,0"
                                                        FontSize="11"/>
                                            </StackPanel>

                                            <Button Grid.Column="4"
                                                    Style="{StaticResource RowDangerButton}"
                                                    Tag="&#xE711;" Content=""
                                                    Command="{Binding DataContext.ClearModuleWallpaperCommand,
                                                                RelativeSource={RelativeSource
                                                                    AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="8,0,0,0"
                                                    ToolTip="Remove this module's wallpaper"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
