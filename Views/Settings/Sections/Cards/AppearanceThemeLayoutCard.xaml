<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/Cards/AppearanceThemeLayoutCard.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v3 — Appearance: Theme & Layout (Surface Studio),
     split out (2026-09-17) for the module line budget. DataContext
     inherits SettingsViewModel from the section; styles from the two
     merged module dictionaries.

     LAYOUT CONTRACT (2026-09-23 spacing pass):
     · Primary / Secondary / Detail are three 12 px rounded surface cards
       (Radius.Large) in a UniformGrid with SettingsTileGridMargin /
       SettingsTileGridBleedKeepTop — the module's approved 14 px option-tile
       gutter pattern (the old wrap panel collapsed them to stacked
       full-width tiles at the owner's window width).
     · The nine surface axes use the approved crystal-axis row rhythm
       (ThemesCrystalMaterialCard): label ABOVE the track
       (SettingsAxisLabelMargin = 6px air), 22px between rows
       (SettingsAxisRowMargin), full-width ModernSliderStyle bar whose
       centered label shows the live value. Slider stacks pin to the card
       bottom so all three cards share one baseline regardless of caption
       wrap.
     · System & Rendering tiles follow the AiAssistantCard bento rows:
       icon+title on top, content cluster pinned to the tile bottom.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.Cards.AppearanceThemeLayoutCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource SettingsCompactCardStyle}">
        <StackPanel>
            <!-- ── CARD HEADER & ONE-TAP RESET ─────────────────────── -->
            <Grid Margin="{StaticResource SettingsStackBottom8}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                    <TextBlock Text="&#xE790;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Settings.ThemeLayout}"
                               Style="{StaticResource SettingsCardTitleStyle}"/>
                    <TextBlock Text="{DynamicResource Settings.OverallLookCardWeightDensity}"
                               Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                </StackPanel>
                <Button Grid.Column="2"
                        AutomationProperties.AutomationId="Appearance.ResetDefaults"
                        Command="{Binding ResetAppearanceCommand}"
                        ToolTip="{DynamicResource Settings.RestoreThemeAccentCardShapeDensityZoomFont}"
                        Style="{StaticResource OutlinedPillButton}"
                        Height="32" Padding="12,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE777;" FontFamily="{DynamicResource FontFamily.Icon}"
                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                   VerticalAlignment="Center" Margin="{StaticResource SettingsInlineGap6R}"/>
                        <TextBlock Text="{DynamicResource Settings.ResetAppearanceDefaults}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource FontSize.BodySmall}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Loading indicator for reset operation -->
            <Border Margin="{StaticResource SettingsStackBottom10}"
                    Padding="14,8"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    BorderThickness="{DynamicResource Border.HairlineThickness}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsResettingAppearance}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <ProgressBar IsIndeterminate="True" Width="80" Height="4"
                                 VerticalAlignment="Center" Margin="{StaticResource SettingsTrailingGap}"
                                 Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                    <TextBlock Text="{DynamicResource Settings.ResettingAppearance}"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                               FontWeight="{DynamicResource Weight.Bold}"
                               FontSize="{DynamicResource FontSize.Body}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ResetStatusMessage}"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                               FontSize="{DynamicResource FontSize.BodySmall}"
                               Margin="{StaticResource SettingsInlineGap8}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ── THEME ENGINE ───────────────────────────────────────
                 The family picker and pack export/import lived only on the
                 Themes page, so Appearance → Theme had no engine. -->
            <Border Style="{StaticResource SettingsRowSeparatorStyle}" Margin="{StaticResource SettingsStackGap6}"/>
            <Grid Margin="{StaticResource SettingsStackBottom8}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE790;" FontFamily="{DynamicResource FontFamily.Icon}"
                           FontSize="{DynamicResource FontSize.Body}" VerticalAlignment="Center"
                           Foreground="{DynamicResource Ios26AccentBrush}"/>
                <StackPanel Grid.Column="1" Margin="{StaticResource SettingsInlineGap6}">
                    <TextBlock Text="Theme Engine" Style="{StaticResource SettingsRowTitleStyle}"/>
                    <TextBlock Text="{DynamicResource Settings.NormalMonetIos17pm}"
                               Style="{StaticResource SettingsRowMetaStyle}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            <ComboBox AutomationProperties.AutomationId="Settings.AppearanceThemeEngine"
                      ItemsSource="{Binding VisualThemeOptions}"
                      DisplayMemberPath="Display"
                      SelectedValuePath="Key"
                      SelectedValue="{Binding SelectedVisualTheme, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      Height="32" Padding="8,5"
                      Margin="{StaticResource SettingsStackBottom8}"
                      Style="{StaticResource ComboBoxStyle}"/>
            <StackPanel Orientation="Horizontal" Margin="{StaticResource SettingsStackBottom8}">
                <Button AutomationProperties.AutomationId="Settings.ExportThemePackAppearance"
                        Command="{Binding ExportThemeProfileCommand}"
                        Content="Export Pack"
                        Style="{StaticResource OutlinedPillButton}"
                        Height="30" Padding="12,0"
                        FontSize="{DynamicResource FontSize.BodySmall}"
                        Margin="{StaticResource SettingsInlineGap8R}"/>
                <Button AutomationProperties.AutomationId="Settings.ImportThemePackAppearance"
                        Command="{Binding ImportThemeProfileCommand}"
                        Content="Import Pack"
                        Style="{StaticResource OutlinedPillButton}"
                        Height="30" Padding="12,0"
                        FontSize="{DynamicResource FontSize.BodySmall}"/>
            </StackPanel>

            <!-- ── SECTION 1: SURFACE ARCHITECTURE ───────────────────
                 Primary / Secondary / Detail surface cards — fixed 3-up
                 grid with the module's 14px tile gutters. Tiles size to content;
                 a longer caption must not open a hole above the sliders. -->
            <Grid Margin="{StaticResource SettingsStackBottom8}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE790;" FontFamily="{DynamicResource FontFamily.Icon}"
                           FontSize="{DynamicResource FontSize.Body}" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}"/>
                <StackPanel Grid.Column="1" Margin="{StaticResource SettingsInlineGap6}">
                    <TextBlock Text="Surface Architecture" Style="{StaticResource SettingsRowTitleStyle}"/>
                    <TextBlock Text="Opacity, corner radius, and hairline borders for surface levels"
                               Style="{StaticResource SettingsRowMetaStyle}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- Material / shape / elevation were dropped with the 2026-09-24
                 rewrite. They still drive ThemeManager; Solid material also
                 turns wallpaper frost off, so the choice has to stay visible. -->
            <UniformGrid Columns="4" Margin="{StaticResource SettingsTileGridBleedKeepTop}">
                <StackPanel Margin="{StaticResource SettingsTileGridMargin}" VerticalAlignment="Top">
                    <TextBlock Style="{StaticResource SettingsRowMetaStyle}" Text="Material"/>
                    <ComboBox ItemsSource="{Binding SurfaceMaterialOptions}"
                              SelectedItem="{Binding SurfaceMaterialMode}"
                              AutomationProperties.Name="Material"
                              Padding="8,5" Height="32"
                              FontSize="{DynamicResource FontSize.Body}"
                              Style="{StaticResource ComboBoxStyle}"/>
                </StackPanel>
                <StackPanel Margin="{StaticResource SettingsTileGridMargin}" VerticalAlignment="Top">
                    <TextBlock Style="{StaticResource SettingsRowMetaStyle}" Text="Rounded surfaces"/>
                    <ToggleButton HorizontalAlignment="Left"
                                  AutomationProperties.Name="Rounded surfaces"
                                  IsChecked="{Binding UseRoundedSurfaces, Mode=TwoWay}"
                                  Style="{StaticResource ModernToggleSwitch}"/>
                </StackPanel>
                <StackPanel Margin="{StaticResource SettingsTileGridMargin}" VerticalAlignment="Top">
                    <TextBlock Style="{StaticResource SettingsRowMetaStyle}" Text="Primary elevation"/>
                    <ToggleButton HorizontalAlignment="Left"
                                  AutomationProperties.Name="Primary elevation"
                                  IsChecked="{Binding UsePrimarySurfaceElevation, Mode=TwoWay}"
                                  Style="{StaticResource ModernToggleSwitch}"/>
                </StackPanel>
                <StackPanel Margin="{StaticResource SettingsTileGridMargin}" VerticalAlignment="Top">
                    <TextBlock Style="{StaticResource SettingsRowMetaStyle}" Text="Primary overlay"/>
                    <Slider Style="{StaticResource ModernSliderStyle}"
                            AutomationProperties.Name="Primary overlay"
                            Minimum="0" Maximum="0.35" TickFrequency="0.05"
                            IsSnapToTickEnabled="True"
                            Value="{Binding PrimarySurfaceOverlayOpacity, Mode=TwoWay}"/>
                </StackPanel>
            </UniformGrid>

            <UniformGrid Columns="3" Margin="{StaticResource SettingsTileGridBleedKeepTop}">

                <!-- Primary surface card -->
                <Border Background="{DynamicResource SurfacePrimaryBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="{DynamicResource Border.HairlineThickness}"
                        CornerRadius="{DynamicResource Radius.Large}" Padding="12,10"
                        Margin="{StaticResource SettingsTileGridMargin}" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Primary" FontWeight="{DynamicResource Weight.Bold}"
                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="Canvases &amp; main cards"
                                       Style="{StaticResource SettingsRowMetaStyle}"
                                       TextWrapping="Wrap"
                                       Margin="{StaticResource SettingsStackBottom4}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" VerticalAlignment="Top">
                            <StackPanel Margin="{StaticResource SettingsAxisRowMargin}">
                                <TextBlock Text="Opacity" FontSize="{DynamicResource FontSize.Body}"
                                           Margin="{StaticResource SettingsAxisLabelMargin}"/>
                                <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0.5" Maximum="1"
                                        VerticalAlignment="Center"
                                        Value="{Binding SurfacePrimaryOpacity, Mode=TwoWay}"
                                        AutomationProperties.Name="{DynamicResource Settings.CardCornerRadius}"/>
                            </StackPanel>
                            <StackPanel Margin="{StaticResource SettingsAxisRowMargin}">
                                <TextBlock Text="Radius" FontSize="{DynamicResource FontSize.Body}"
                                           Margin="{StaticResource SettingsAxisLabelMargin}"/>
                                <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="48"
                                        VerticalAlignment="Center"
                                        Value="{Binding SurfacePrimaryRadius, Mode=TwoWay}"
                                        AutomationProperties.Name="{DynamicResource Settings.CardCornerRadius}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Border" FontSize="{DynamicResource FontSize.Body}"
                                           Margin="{StaticResource SettingsAxisLabelMargin}"/>
                                <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="24"
                                        VerticalAlignment="Center"
                                        Value="{Binding SurfacePrimaryBorderThickness, Mode=TwoWay}"
                                        AutomationProperties.Name="{DynamicResource Settings.CardCornerRadius}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Secondary surface card -->
                <Border Background="{DynamicResource SurfacePrimaryBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="{DynamicResource Border.HairlineThickness}"
                        CornerRadius="{DynamicResource Radius.Large}" Padding="12,10"
                        Margin="{StaticResource SettingsTileGridMargin}" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Secondary" FontWeight="{DynamicResource Weight.Bold}"
                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="Groups, filters, KPI cards"
                                       Style="{StaticResource SettingsRowMetaStyle}"
                                       TextWrapping="Wrap"
                                       Margin="{StaticResource SettingsStackBottom4}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" VerticalAlignment="Top">
                            <StackPanel Margin="{StaticResource SettingsAxisRowMargin}">
                                <TextBlock Text="Opacity" FontSize="{DynamicResource FontSize.Body}"
                                           Margin="{StaticResource SettingsAxisLabelMargin}"/>
                                <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0.25" Maximum="1"
                                        VerticalAlignment="Center"
                                        Value="{Binding SurfaceSecondaryOpacity, Mode=TwoWay}"
                                        AutomationProperties.Name="{DynamicResource Settings.CardCornerRadius}"/>
                            </StackPanel>
                            <StackPanel Margin="{StaticResource SettingsAxisRowMargin}">
                                <TextBlock Text="Radius" FontSize="{DynamicResource FontSize.Body}"
                                           Margin="{StaticResource SettingsAxisLabelMargin}"/>
                                <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="48"
                                        VerticalAlignment="Center"
                                        Value="{Binding SurfaceSecondaryRadius, Mode=TwoWay}"
                                        AutomationProperties.Name="{DynamicResource Settings.CardCornerRadius}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Border" FontSize="{DynamicResource FontSize.Body}"
                                           Margin="{StaticResource SettingsAxisLabelMargin}"/>
                                <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="24"
                                        VerticalAlignment="Center"
                                        Value="{Binding SurfaceSecondaryBorderThickness, Mode=TwoWay}"
                                        AutomationProperties.Name="{DynamicResource Settings.CardCornerRadius}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Detail surface card -->
                <Border Background="{DynamicResource SurfacePrimaryBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="{DynamicResource Border.HairlineThickness}"
                        CornerRadius="{DynamicResource Radius.Large}" Padding="12,10"
                        Margin="{StaticResource SettingsTileGridMargin}" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Detail" FontWeight="{DynamicResource Weight.Bold}"
                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="Chips, badges, facts"
                                       Style="{StaticResource SettingsRowMetaStyle}"
                                       TextWrapping="Wrap"
                                       Margin="{StaticResource SettingsStackBottom4}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" VerticalAlignment="Top">
                            <StackPanel Margin="{StaticResource SettingsAxisRowMargin}">
                                <TextBlock Text="Opacity" FontSize="{DynamicResource FontSize.Body}"
                                           Margin="{StaticResource SettingsAxisLabelMargin}"/>
                                <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0.15" Maximum="1"
                                        VerticalAlignment="Center"
                                        Value="{Binding SurfaceDetailOpacity, Mode=TwoWay}"
                                        AutomationProperties.Name="{DynamicResource Settings.CardCornerRadius}"/>
                            </StackPanel>
                            <StackPanel Margin="{StaticResource SettingsAxisRowMargin}">
                                <TextBlock Text="Radius" FontSize="{DynamicResource FontSize.Body}"
                                           Margin="{StaticResource SettingsAxisLabelMargin}"/>
                                <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="48"
                                        VerticalAlignment="Center"
                                        Value="{Binding SurfaceDetailRadius, Mode=TwoWay}"
                                        AutomationProperties.Name="{DynamicResource Settings.CardCornerRadius}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Border" FontSize="{DynamicResource FontSize.Body}"
                                           Margin="{StaticResource SettingsAxisLabelMargin}"/>
                                <Slider Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="24"
                                        VerticalAlignment="Center"
                                        Value="{Binding SurfaceDetailBorderThickness, Mode=TwoWay}"
                                        AutomationProperties.Name="{DynamicResource Settings.CardCornerRadius}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource SettingsRowSeparatorStyle}" Margin="{StaticResource SettingsStackGap6}"/>

            <!-- ── SECTION 2: SYSTEM & RENDERING PREFERENCES ─────────
                 UI Scale / PDF Layout / Motion tiles — same 14px gutter
                 grid. Tiles size to content so a taller neighbour does not
                 open a hole above the control. -->
            <Grid Margin="{StaticResource SettingsStackBottom8}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE771;" FontFamily="{DynamicResource FontFamily.Icon}"
                           FontSize="{DynamicResource FontSize.Body}" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}"/>
                <StackPanel Grid.Column="1" Margin="{StaticResource SettingsInlineGap6}">
                    <TextBlock Text="System &amp; Rendering Preferences" Style="{StaticResource SettingsRowTitleStyle}"/>
                </StackPanel>
            </Grid>

            <UniformGrid Columns="3" Margin="{StaticResource SettingsTileGridBleedKeepTop}">

                <!-- UI Scale -->
                <Border Style="{StaticResource SettingsInnerTileStyle}" Padding="12,10"
                        CornerRadius="{DynamicResource Radius.Large}"
                        Margin="{StaticResource SettingsTileGridMargin}" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="{StaticResource SettingsStackBottom8}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Typography.Icon}" Text="&#xE8A3;"
                                       FontSize="{DynamicResource FontSize.BodySmall}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource SettingsRowTitleStyle}"
                                       Margin="{StaticResource SettingsInlineGap6}" VerticalAlignment="Center"
                                       Text="{DynamicResource Settings.UIScale}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="2" FontSize="{DynamicResource FontSize.BodySmall}"
                                       FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                       Margin="{StaticResource SettingsInlineGap6}">
                                <Run Text="{Binding UiScalePercent, Mode=OneWay}"/><Run Text="%"/>
                            </TextBlock>
                        </Grid>
                        <StackPanel Grid.Row="2">
                            <Slider Style="{StaticResource ModernSliderStyle}"
                                    AutomationProperties.Name="{DynamicResource Settings.UIScale}"
                                    Minimum="0.8" Maximum="1.25"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding UiScale, Mode=TwoWay}"
                                    Margin="0,2,0,8"/>
                            <Button Content="{DynamicResource Action.Reset}"
                                    Style="{StaticResource OutlinedPillButton}"
                                    Command="{Binding ResetUiScaleCommand}"
                                    Height="26" MinWidth="56" Padding="10,0"
                                    FontSize="{DynamicResource FontSize.BodySmall}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                       Text="{DynamicResource Settings.CtrlMouseWheelZoomsAppCtrl0Resets100}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- PDF Layout -->
                <Border Style="{StaticResource SettingsInnerTileStyle}" Padding="12,10"
                        CornerRadius="{DynamicResource Radius.Large}"
                        Margin="{StaticResource SettingsTileGridMargin}" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="{StaticResource SettingsStackBottom8}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Typography.Icon}" Text="&#xE8A5;"
                                       FontSize="{DynamicResource FontSize.BodySmall}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource SettingsRowTitleStyle}"
                                       Margin="{StaticResource SettingsInlineGap6}" VerticalAlignment="Center"
                                       Text="{DynamicResource Settings.PDFLayout}" TextWrapping="Wrap"/>
                        </Grid>
                        <StackPanel Grid.Row="2">
                            <ComboBox ItemsSource="{Binding PdfLayoutOptions}"
                                      SelectedItem="{Binding PdfLayout}"
                                      HorizontalAlignment="Stretch"
                                      Padding="8,5" Height="32"
                                      FontSize="{DynamicResource FontSize.Body}"
                                      Style="{StaticResource ComboBoxStyle}"
                                      Margin="0,2,0,8"/>
                            <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                       Text="{Binding PdfLayoutHint}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                       Text="{DynamicResource Settings.AppliesPIJODNTaxInvoiceStatementSheetStore}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Motion &amp; Display Performance -->
                <Border Style="{StaticResource SettingsInnerTileStyle}" Padding="12,10"
                        CornerRadius="{DynamicResource Radius.Large}"
                        Margin="{StaticResource SettingsTileGridMargin}" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="{StaticResource SettingsStackBottom8}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Typography.Icon}" Text="&#xE9F5;"
                                       FontSize="{DynamicResource FontSize.BodySmall}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource SettingsRowTitleStyle}"
                                       Margin="{StaticResource SettingsInlineGap6}" VerticalAlignment="Center"
                                       Text="{DynamicResource Settings.MotionPerformance}" TextWrapping="Wrap"/>
                        </Grid>
                        <StackPanel Grid.Row="2">
                            <Border Background="{DynamicResource SurfaceTertiaryBrush}"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    BorderThickness="{DynamicResource Border.HairlineThickness}"
                                    CornerRadius="{DynamicResource Radius.Small}"
                                    Padding="10,7" Margin="0,2,0,8">
                                <TextBlock Text="{Binding PerformanceTierDisplay}"
                                           FontWeight="{DynamicResource Weight.SemiBold}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                           TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                       Text="{DynamicResource Settings.AnimationsAdaptDisplayRefreshRate6090120144}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>
        </StackPanel>
    </Border>
</UserControl>
