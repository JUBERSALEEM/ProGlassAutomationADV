<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/Cards/FeaturesSessionCard.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v3 — one card of the FeaturesSection page, split out of
     SettingsFeaturesSection.xaml (2026-09-17) so no section carries six cards in one
     1,200+ line tree. DataContext inherits SettingsViewModel from the
     section; styles come from the two merged module dictionaries.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.Cards.FeaturesSessionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource SettingsCompactCardStyle}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                    <TextBlock Text="&#xE77B;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Settings.Session}"
                               Style="{StaticResource SettingsCardTitleStyle}"/>
                    <TextBlock Text="{DynamicResource Settings.SignShiftHandoverForgetAutoSignCredentials}"
                               Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                </StackPanel>
            </Grid>

            <!-- ── SESSION SECURITY CONTROLS ── -->
            <StackPanel Margin="{StaticResource SettingsStackGap12}">
                <TextBlock Text="Manage active terminal credentials and shift handovers"
                           Style="{StaticResource SettingsRowMetaStyle}"/>
                <UniformGrid Columns="2" Margin="{StaticResource SettingsStackGap10}">
                    <Button Content="{DynamicResource Settings.ForgetDevice}"
                            Command="{Binding DataContext.ForgetThisDeviceCommand,
                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource SettingsActionButtonStyle}"
                            Margin="{StaticResource SettingsInlineGap6R}"
                            ToolTip="{DynamicResource Settings.ClearSkipLoginVaultEntryMachineWithout}"/>
                    <Button Content="{DynamicResource Login.SignOut}"
                            Command="{Binding DataContext.SignOutCommand,
                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource SettingsActionButtonStyle}"
                            ToolTip="{DynamicResource Settings.EndSessionClearSkipLoginVaultEntryReturn}"/>
                </UniformGrid>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
