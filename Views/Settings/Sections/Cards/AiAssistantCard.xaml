<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/Cards/AiAssistantCard.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v3 — one card of the AiSection page, split out
     (2026-09-17) for the module line budget. DataContext inherits
     SettingsViewModel from the section; styles from the two merged
     module dictionaries.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.Cards.AiAssistantCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="../../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

                <Border Style="{StaticResource SettingsPageCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                                <TextBlock Text="&#xE8F2;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings.Assistant}"
                                           Style="{StaticResource SettingsCardTitleStyle}"/>
                                <TextBlock Text="{DynamicResource Settings.MasterSwitchesTuningValuesUsedRequest}"
                                           Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                            </StackPanel>
                        </Grid>
                        <UniformGrid Columns="2" Margin="{StaticResource SettingsRowMargin}">

                            <!-- Master toggle -->
                            <Border Margin="{StaticResource SettingsTrailingGap}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="{StaticResource SettingsStackBottom8}">
    <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8F2;" Margin="{StaticResource SettingsInlineGap8R}" VerticalAlignment="Center"/>
    <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource Settings.EnableAIAssistant}" VerticalAlignment="Center"/>
</StackPanel>
                                    <TextBlock Grid.Row="1"
                                               Style="{StaticResource SettingsRowMetaStyle}"
                                               Text="{DynamicResource Settings.MasterSwitchWhenChatButtonHiddenNoAPICalls}"/>
                                    <ToggleButton Grid.Row="3"
                                    AutomationProperties.Name="{DynamicResource Settings.EnableAIAssistant}"
                                                  HorizontalAlignment="Left"
                                                  IsChecked="{Binding IsAiEnabled, Mode=TwoWay}"
                                                  Style="{StaticResource ModernToggleSwitch}"/>
                                </Grid>
                            </Border>

                            <!-- Real business data -->
                            <Border Margin="{StaticResource SettingsTrailingGap}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="{StaticResource SettingsStackBottom8}">
    <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE9F9;" Margin="{StaticResource SettingsInlineGap8R}" VerticalAlignment="Center"/>
    <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource Settings.UseRealBusinessData}" VerticalAlignment="Center"/>
</StackPanel>
                                    <TextBlock Grid.Row="1"
                                               Style="{StaticResource SettingsRowMetaStyle}"
                                               Text="{DynamicResource Settings.WhenLiveInvoiceJobDeliveryBalanceDataSent}"/>
                                    <ToggleButton Grid.Row="3"
                                    AutomationProperties.Name="{DynamicResource Settings.UseRealBusinessData}"
                                                  HorizontalAlignment="Left"
                                                  IsChecked="{Binding UseRealData, Mode=TwoWay}"
                                                  Style="{StaticResource ModernToggleSwitch}"/>
                                </Grid>
                            </Border>

                            <!-- Model readout -->
                            <Border Margin="{StaticResource SettingsTrailingGap}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="{StaticResource SettingsStackBottom8}">
    <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE9F5;" Margin="{StaticResource SettingsInlineGap8R}" VerticalAlignment="Center"/>
    <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource Settings.ActiveModel}" VerticalAlignment="Center"/>
</StackPanel>
                                    <TextBlock Text="{Binding AiModel}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                                    <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                               Text="{DynamicResource Settings.ModelIdentifierCurrentlySelectedProvider}"/>
                                </StackPanel>
                            </Border>

                            <!-- Max tokens -->
                            <Border Margin="{StaticResource SettingsTrailingGap}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="{StaticResource SettingsStackBottom8}">
    <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE762;" Margin="{StaticResource SettingsInlineGap8R}" VerticalAlignment="Center"/>
    <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource Settings.MaxTokens}" VerticalAlignment="Center"/>
</StackPanel>
                                    <TextBlock Text="{Binding AiMaxTokens}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                               Text="{DynamicResource Settings.ResponseLengthCeilingCallAdjustConfigJsonNow}"/>
                                </StackPanel>
                            </Border>

                            <!-- Temperature -->
                            <Border>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="{StaticResource SettingsStackBottom8}">
    <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE706;" Margin="{StaticResource SettingsInlineGap8R}" VerticalAlignment="Center"/>
    <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource Settings.Temperature}" VerticalAlignment="Center"/>
</StackPanel>
                                    <TextBlock Text="{Binding AiTemperature}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                               Text="{DynamicResource Settings.HigherMoreCreativeLowerMoreDeterministicRead}"/>
                                </StackPanel>
                            </Border>

                        </UniformGrid>

                        <Border/>
                    </StackPanel>
                </Border>
</UserControl>
