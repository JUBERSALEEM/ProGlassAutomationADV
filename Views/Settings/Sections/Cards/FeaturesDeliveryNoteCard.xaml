<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/Cards/FeaturesDeliveryNoteCard.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v3 — one card of the FeaturesSection page, split out of
     SettingsFeaturesSection.xaml (2026-09-17) so no section carries six cards in one
     1,200+ line tree. DataContext inherits SettingsViewModel from the
     section; styles come from the two merged module dictionaries.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.Cards.FeaturesDeliveryNoteCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="../../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

                    <Border Style="{StaticResource SettingsPageCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                                    <TextBlock Text="&#xE7ED;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Module.DeliveryNote}"
                                               Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <TextBlock Text="{DynamicResource Settings.TurnOptionalDispatchFieldsStatusCannotHidden}"
                                               Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="{StaticResource SettingsRowMargin}">
                                <Border Style="{StaticResource SettingsInnerTileStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE718;"/>
                                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center" Text="{DynamicResource Settings.BulkActions}"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                               Text="{DynamicResource Settings.FlipDeliveryNoteFieldOnce}"/>
                                        <Border 
                Style="{StaticResource SurfacePanelTileStyle}">
                                            <UniformGrid Columns="3">
                                                <Button Content="{DynamicResource Settings.Enable}"
                                                Command="{Binding EnableAllCommand}"
                                                Style="{StaticResource SettingsActionButtonStyle}"/>
                                                <Button Content="{DynamicResource Settings.HideOptional}"
                                                Command="{Binding DisableAllOptionalCommand}"
                                                Style="{StaticResource SettingsActionButtonStyle}"/>
                                                <Button Content="{DynamicResource ProformaInvoice.ResetDefaults}"
                                                Command="{Binding ResetToDefaultsCommand}"
                                                Style="{StaticResource SettingsActionButtonStyle}"
                                                Margin="0"/>
                                            </UniformGrid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{DynamicResource Settings.DeliveryDetails}"
                                   Style="{StaticResource SettingsGroupCaptionStyle}"
                                   Margin="{StaticResource SettingsStackGap18}"/>

                            <UniformGrid Columns="2" Margin="{StaticResource SettingsTileGridBleed}">
                                <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTileGridMargin}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
    <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;" Margin="0,0,8,0" VerticalAlignment="Center"/>
    <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource DeliveryNote.DriverNAME}" VerticalAlignment="Center"/>
</StackPanel>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.WhoDeliveredLoad}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowDriverName}"
                                        AutomationProperties.Name="{DynamicResource DeliveryNote.DriverNAME}"
                                        />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTileGridMargin}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
    <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;" Margin="0,0,8,0" VerticalAlignment="Center"/>
    <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource DeliveryNote.VehicleNumber}" VerticalAlignment="Center"/>
</StackPanel>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.TruckVanPlate}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowVehicleNumber}"
                                        AutomationProperties.Name="{DynamicResource DeliveryNote.VehicleNumber}"
                                        />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTileGridMargin}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
    <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;" Margin="0,0,8,0" VerticalAlignment="Center"/>
    <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource Settings.FOCFreeCost}" VerticalAlignment="Center"/>
</StackPanel>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.MarkDeliveryFreeComplimentary}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowIsFoc}"
                                        AutomationProperties.Name="{DynamicResource Settings.FOCFreeCost}"
                                        />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTileGridMargin}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
    <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;" Margin="0,0,8,0" VerticalAlignment="Center"/>
    <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource DeliveryNote.ReceiverNAME}" VerticalAlignment="Center"/>
</StackPanel>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.WhoSignedGoods}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowReceiverName}"
                                        AutomationProperties.Name="{DynamicResource DeliveryNote.ReceiverNAME}"
                                        />
                                    </Grid>
                                </Border>

                                <Border Margin="{StaticResource SettingsTileGridMargin}" Style="{StaticResource SettingsInnerTileStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
    <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;" Margin="0,0,8,0" VerticalAlignment="Center"/>
    <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource Common.Notes}" VerticalAlignment="Center"/>
</StackPanel>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.FreeformDispatchNotes}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowNotes}"
                                        AutomationProperties.Name="{DynamicResource Common.Notes}"
                                        />
                                    </Grid>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
</UserControl>
