<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/Cards/AiProvidersCard.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v3 — one card of the AiSection page, split out
     (2026-09-17) for the module line budget. DataContext inherits
     SettingsViewModel from the section; styles from the two merged
     module dictionaries.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.Cards.AiProvidersCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="../../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

                <Border Style="{StaticResource SettingsPageCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                                <TextBlock Text="&#xE9F5;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings.Providers}"
                                           Style="{StaticResource SettingsCardTitleStyle}"/>
                                <TextBlock Text="{DynamicResource Settings.ActiveProviderProcessesRequestsKeysEncrypted}"
                                           Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource SettingsChipStyle}"
                                    Background="{DynamicResource TintBlueBrush}" VerticalAlignment="Center">
                                <TextBlock Text="3 LLM Endpoints" Style="{StaticResource SettingsChipTextStyle}"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </Grid>
                        <UniformGrid Columns="3" Margin="{StaticResource SettingsTileGridBleedKeepTop}">

                            <!-- ── Gemini tile ─────────────────────────── -->
                            <Border Margin="{StaticResource SettingsTileGridMargin}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                                        <Setter Property="BorderThickness" Value="{DynamicResource Border.HairlineThickness}"/>
                                        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
                                        <Setter Property="Padding" Value="{StaticResource SettingsTilePadding}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGeminiActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                <Setter Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12"
                                                     Fill="{DynamicResource ProviderDotBlue}"
                                                     VerticalAlignment="Center"
                                                     Margin="{StaticResource SettingsInlineGap10R}"
                                                     IsHitTestVisible="False"/>
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Settings.GoogleGemini}"
                                                           Style="{StaticResource SettingsRowTitleStyle}"/>
                                                <TextBlock Text="{DynamicResource Settings.15ReqMin1500DayBestQuality}"
                                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                           IsHitTestVisible="False"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button DockPanel.Dock="Right"
                                                HorizontalAlignment="Right"
                                                Command="{Binding SelectGeminiCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ProviderSelectButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGeminiActive}" Value="True">
                                                            <Setter Property="Content" Value="ACTIVE"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DockPanel>

                                    <TextBlock Text="{DynamicResource Settings.APIKEY}"
                                               Style="{StaticResource Typography.Label}"
                                               Margin="{StaticResource SettingsHeaderContentMargin}"/>
                                    <PasswordBox x:Name="GeminiKeyBox"
                                                 Style="{StaticResource RoundedPasswordBoxStyle}"
                                                 PasswordChanged="GeminiKeyBox_PasswordChanged"/>
                                    <TextBlock Text="{DynamicResource Settings.GetKeyAistudioGoogleCom}"
                                               Style="{StaticResource SettingsRowMetaStyle}"
                                               Margin="{StaticResource SettingsNoteMargin}"/>
                                    <Button
                                        Style="{StaticResource SettingsActionButtonStyle}"
                                            Tag="&#xE74E;" Content="{DynamicResource Settings.SAVETEST}"
                                            Command="{Binding TestGeminiCommand}"
                                            HorizontalAlignment="Stretch"
                                            Height="32"
                                            FontSize="{DynamicResource FontSize.Body}"/>
                                    <TextBlock Text="{Binding GeminiTestStatus}"
                                               FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Margin="{StaticResource SettingsStackGap8}"
                                               TextWrapping="Wrap"
                                               IsHitTestVisible="False"/>
                                </StackPanel>
                            </Border>

                            <!-- ── Groq tile ───────────────────────────── -->
                            <Border Margin="{StaticResource SettingsTileGridMargin}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                                        <Setter Property="BorderThickness" Value="{DynamicResource Border.HairlineThickness}"/>
                                        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
                                        <Setter Property="Padding" Value="{StaticResource SettingsTilePadding}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGroqActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                <Setter Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12"
                                                     Fill="{DynamicResource ProviderDotAmber}"
                                                     VerticalAlignment="Center"
                                                     Margin="{StaticResource SettingsInlineGap10R}"
                                                     IsHitTestVisible="False"/>
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Settings.Groq}"
                                                           Style="{StaticResource SettingsRowTitleStyle}"/>
                                                <TextBlock Text="{DynamicResource Settings.FastLlamaGenerousFreeTier}"
                                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                           IsHitTestVisible="False"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button DockPanel.Dock="Right"
                                                HorizontalAlignment="Right"
                                                Command="{Binding SelectGroqCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ProviderSelectButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGroqActive}" Value="True">
                                                            <Setter Property="Content" Value="ACTIVE"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DockPanel>

                                    <TextBlock Text="{DynamicResource Settings.APIKEY}"
                                               Style="{StaticResource Typography.Label}"
                                               Margin="{StaticResource SettingsHeaderContentMargin}"/>
                                    <PasswordBox x:Name="GroqKeyBox"
                                                 Style="{StaticResource RoundedPasswordBoxStyle}"
                                                 PasswordChanged="GroqKeyBox_PasswordChanged"/>
                                    <TextBlock Text="{DynamicResource Settings.GetKeyConsoleGroqCom}"
                                               Style="{StaticResource SettingsRowMetaStyle}"
                                               Margin="{StaticResource SettingsNoteMargin}"/>
                                    <Button
                                        Style="{StaticResource SettingsActionButtonStyle}"
                                            Tag="&#xE74E;" Content="{DynamicResource Settings.SAVETEST}"
                                            Command="{Binding TestGroqCommand}"
                                            HorizontalAlignment="Stretch"
                                            Height="32"
                                            FontSize="{DynamicResource FontSize.Body}"/>
                                    <TextBlock Text="{Binding GroqTestStatus}"
                                               FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Margin="{StaticResource SettingsStackGap8}"
                                               TextWrapping="Wrap"
                                               IsHitTestVisible="False"/>
                                </StackPanel>
                            </Border>

                            <!-- ── Cohere tile ─────────────────────────── -->
                            <Border Margin="{StaticResource SettingsTileGridMargin}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                                        <Setter Property="BorderThickness" Value="{DynamicResource Border.HairlineThickness}"/>
                                        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
                                        <Setter Property="Padding" Value="{StaticResource SettingsTilePadding}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCohereActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                <Setter Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12"
                                                     Fill="{DynamicResource ProviderDotViolet}"
                                                     VerticalAlignment="Center"
                                                     Margin="{StaticResource SettingsInlineGap10R}"
                                                     IsHitTestVisible="False"/>
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Settings.Cohere}"
                                                           Style="{StaticResource SettingsRowTitleStyle}"/>
                                                <TextBlock Text="{DynamicResource Settings.EnterpriseGradeCommandFamily}"
                                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                           IsHitTestVisible="False"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button DockPanel.Dock="Right"
                                                HorizontalAlignment="Right"
                                                Command="{Binding SelectCohereCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ProviderSelectButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCohereActive}" Value="True">
                                                            <Setter Property="Content" Value="ACTIVE"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DockPanel>

                                    <TextBlock Text="{DynamicResource Settings.APIKEY}"
                                               Style="{StaticResource Typography.Label}"
                                               Margin="{StaticResource SettingsHeaderContentMargin}"/>
                                    <PasswordBox x:Name="CohereKeyBox"
                                                 Style="{StaticResource RoundedPasswordBoxStyle}"
                                                 PasswordChanged="CohereKeyBox_PasswordChanged"/>
                                    <TextBlock Text="{DynamicResource Settings.GetKeyDashboardCohereCom}"
                                               Style="{StaticResource SettingsRowMetaStyle}"
                                               Margin="{StaticResource SettingsNoteMargin}"/>
                                    <Button Style="{StaticResource SettingsActionButtonStyle}"
                                            Tag="&#xE74E;" Content="{DynamicResource Settings.SAVETEST}"
                                            Command="{Binding TestCohereCommand}"
                                            HorizontalAlignment="Stretch"
                                            Height="32"
                                            FontSize="{DynamicResource FontSize.Body}"/>
                                    <TextBlock Text="{Binding CohereTestStatus}"
                                               FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Margin="{StaticResource SettingsStackGap8}"
                                               TextWrapping="Wrap"
                                               IsHitTestVisible="False"/>
                                </StackPanel>
                            </Border>

                        </UniformGrid>

                        <!-- Config path directly on card canvas -->
                        <StackPanel Margin="{StaticResource SettingsStackTop12}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8B7;"/>
                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center" Text="{DynamicResource Settings.KeysFile}"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Settings.ProviderKeysEncryptedRestWindowsDpapiStored}"
                                       Style="{StaticResource SettingsRowMetaStyle}"/>
                            <TextBlock Text="{Binding ConfigFilePath}"
                                       FontSize="{DynamicResource FontSize.Body}"
                                       FontFamily="{DynamicResource FontFamily.Code}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False"/>
                        </StackPanel>

                        <Border Style="{StaticResource SettingsRowSeparatorStyle}"/>
                    </StackPanel>
                </Border>
</UserControl>
