<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/Cards/DemoQualityCard.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v3 — one card of the DemoSection page, split out
     (2026-09-17) for the module line budget. DataContext inherits
     SettingsViewModel from the section; styles from the two merged
     module dictionaries.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.Cards.DemoQualityCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="../../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

                <Border Style="{StaticResource SettingsPageCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                                <TextBlock Text="&#xE7F8;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings.RecordingSettings}"
                                           Style="{StaticResource SettingsCardTitleStyle}"/>
                                <TextBlock Text="{DynamicResource Settings.CapturesRunningAppWindowDesktopOtherPrograms}"
                                           Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                            </StackPanel>
                        </Grid>
                        <UniformGrid Columns="3" Margin="{StaticResource SettingsTileGridBleed}">
                            <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTileGridMargin}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE7F8;"/>
                                        <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center" Text="{DynamicResource Settings.Quality}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                               Text="{DynamicResource Settings.OutputResolutionRecordedVideo}"/>
                                    <ComboBox ItemsSource="{Binding Qualities}"
                                              SelectedItem="{Binding SelectedQuality, Mode=TwoWay}"
                                              DisplayMemberPath="Title"
                                              IsSynchronizedWithCurrentItem="False"
                                              MinWidth="200"
                                              Padding="10,7"
                                              FontSize="{DynamicResource FontSize.Title}" Style="{StaticResource ComboBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTileGridMargin}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE823;"/>
                                        <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center" Text="{DynamicResource Settings.FrameRate}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                               Text="{DynamicResource Settings.HowManyFramesSecondCaptured}"/>
                                    <ComboBox ItemsSource="{Binding FpsChoices}"
                                              SelectedItem="{Binding SelectedFps, Mode=TwoWay}"
                                              DisplayMemberPath="Title"
                                              IsSynchronizedWithCurrentItem="False"
                                              MinWidth="160"
                                              Padding="10,7"
                                              FontSize="{DynamicResource FontSize.Title}" Style="{StaticResource ComboBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTileGridMargin}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
    <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE767;" Margin="0,0,8,0" VerticalAlignment="Center"/>
    <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource Settings.InternalAudio}" VerticalAlignment="Center"/>
</StackPanel>
                                    <TextBlock Grid.Row="1"
                                               Style="{StaticResource SettingsRowMetaStyle}"
                                               Text="{DynamicResource Settings.CaptureAppNarrationSoundRunningApp}"/>
                                    <ToggleButton Grid.Row="3"
                                    AutomationProperties.Name="{DynamicResource Settings.InternalAudio}"
                                                  HorizontalAlignment="Left"
                                                  IsChecked="{Binding CaptureLiveAudio, Mode=TwoWay}"
                                                  Style="{StaticResource ModernToggleSwitch}"
                                                  AutomationProperties.AutomationId="DemoCenter.CaptureAudio"/>
                                </Grid>
                            </Border>

                            <Border Margin="{StaticResource SettingsTileGridMargin}" Style="{StaticResource SettingsInnerTileStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
    <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE77B;" Margin="0,0,8,0" VerticalAlignment="Center"/>
    <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource Settings.Microphone}" VerticalAlignment="Center"/>
</StackPanel>
                                    <TextBlock Grid.Row="1"
                                               Style="{StaticResource SettingsRowMetaStyle}"
                                               Text="{DynamicResource Settings.CaptureLiveSpokenNarrationMicrophone}"/>
                                    <ToggleButton Grid.Row="3"
                                    AutomationProperties.Name="{DynamicResource Settings.Microphone}"
                                                  HorizontalAlignment="Left"
                                                  IsChecked="{Binding CaptureMicrophone, Mode=TwoWay}"
                                                  Style="{StaticResource ModernToggleSwitch}"
                                                  AutomationProperties.AutomationId="DemoCenter.CaptureMic"/>
                                </Grid>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="{Binding RecordHint}"
                                   Style="{StaticResource SettingsRowMetaStyle}"
                                   Margin="{StaticResource SettingsRowMargin}"/>

                        <Border Style="{StaticResource SettingsRowSeparatorStyle}"/>
                    </StackPanel>
                </Border>
</UserControl>
