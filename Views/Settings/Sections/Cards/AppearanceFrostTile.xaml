<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/Cards/AppearanceFrostTile.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v3 — Appearance: Frosted Module Cards
     Studio Bento tile with concentric curvature and accessible contrast.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.Cards.AppearanceFrostTile"
             xmlns:crystal="clr-namespace:ProGlassAutomation.Controls.CrystalFluid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="{StaticResource SettingsStackGap8}">
        <StackPanel Orientation="Horizontal" Margin="{StaticResource SettingsRowMargin}">
            <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE792;" VerticalAlignment="Center"/>
            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center" Text="Frosted module cards"/>
            <Viewbox MaxHeight="18" VerticalAlignment="Center" Margin="{StaticResource SettingsIconTextMargin}">
                <TextBlock FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                           Foreground="{DynamicResource AccentBrush}">
                    <Run Text="{Binding CardBlurIntensity, Mode=OneWay, StringFormat={}{0:0}}"/>
                    <Run Text="/100"/>
                </TextBlock>
            </Viewbox>
        </StackPanel>
        <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                   TextWrapping="Wrap"
                   Text="Blurs the module wallpaper behind every screen. Cards stay sharp. 1 = light frost, 50 = professional, 100 = max. Colour plate tints the shared card fill."/>
        <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                   Text="Reduced motion is on, so wallpaper blur stays off. Turn it off in Language &amp; Currency to see the frost."
                   TextWrapping="Wrap"
                   Visibility="{Binding ReducedMotion, Converter={StaticResource BoolToVisibilityConverter}}"/>
        <Slider Style="{StaticResource ModernSliderStyle}"
                AutomationProperties.Name="Frost blur"
                Minimum="1" Maximum="100"
                Value="{Binding CardBlurIntensity, Mode=TwoWay}"
                VerticalAlignment="Center" Margin="{StaticResource SettingsStackGap8}"/>
        <!-- The page behind this card is opaque, so a wallpaper blur
             cannot be seen here. This specimen is the live proof: the
             wash blurs, the card on top stays sharp, and the plate
             retints the fill. -->
        <Grid Height="64" Margin="0,4,0,8">
            <Border Background="{DynamicResource AccentBrush}" Opacity="0.55"
                    CornerRadius="{DynamicResource Ios26RadiusInner}"
                    Effect="{DynamicResource ModuleSkinBlurEffect}"
                    IsHitTestVisible="False"/>
            <Border Margin="18,10" VerticalAlignment="Center"
                    Background="{DynamicResource Surface.Primary.LiveFill}"
                    BorderBrush="{DynamicResource SettingsCardEdgeBrush}"
                    BorderThickness="{DynamicResource CardEdgeThickness}"
                    CornerRadius="{DynamicResource Ios26RadiusInner}"
                    SnapsToDevicePixels="False"
                    RenderOptions.EdgeMode="Unspecified"
                    behaviors:RoundedEdgeStrokeBehavior.IsEnabled="True"
                    Padding="10,6">
                <TextBlock Text="Card stays sharp" HorizontalAlignment="Center"
                           FontSize="{DynamicResource FontSize.Caption}"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Border>
        </Grid>
        <TextBlock Margin="{StaticResource SettingsStackGap16Bottom4}"
                   Style="{StaticResource SettingsRowMetaStyle}"
                   Text="Frost colour plate"/>
        <ItemsControl ItemsSource="{Binding CardEdgePalette}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding DataContext.ApplyCardFrostTintCommand,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Key}"
                            Style="{StaticResource AccentChipStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="11" Height="11" Fill="{Binding Swatch}"
                                     VerticalAlignment="Center" Margin="{StaticResource SettingsInlineGap8R}"/>
                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Margin="{StaticResource SettingsStackGap12}">
            <Ellipse Width="14" Height="14"
                     Fill="{Binding CardFrostTintSwatch}"
                     Stroke="{DynamicResource BorderDefaultBrush}" StrokeThickness="1"
                     VerticalAlignment="Center" Margin="{StaticResource SettingsInlineGap10R}"/>
            <TextBox Text="{Binding CardFrostTint, UpdateSourceTrigger=PropertyChanged}"
                     Width="110" Padding="8,6" FontSize="{DynamicResource FontSize.Body}"
                     FontFamily="{DynamicResource FontFamily.Code}" VerticalAlignment="Center" Style="{StaticResource TextBoxStyle}"/>
            <Button Command="{Binding ApplyCardFrostTintCommand}" CommandParameter="Auto"
                    Style="{StaticResource AccentChipStyle}" Margin="{StaticResource SettingsInlineGap8}">
                <TextBlock Text="Auto (theme)"/>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
