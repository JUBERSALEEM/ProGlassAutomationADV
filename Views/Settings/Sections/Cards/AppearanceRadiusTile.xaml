<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/Cards/AppearanceRadiusTile.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v3 — inner tile of the Theme & Layout card,
     split out (2026-09-17) to keep every file under the line budget.
     DataContext inherits SettingsViewModel through the card.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.Cards.AppearanceRadiusTile"
             xmlns:crystal="clr-namespace:ProGlassAutomation.Controls.CrystalFluid" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="../../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

                            <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE7B3;"/>
                                        <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center" Text="{DynamicResource Settings.CardCornerRadius}"/>
                                        <TextBlock VerticalAlignment="Center" Margin="{StaticResource SettingsIconTextMargin}"
                                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource AccentBrush}">
                                            <Run Text="{Binding CardCornerRadius, Mode=OneWay, StringFormat={}{0:0}}"/>
                                            <Run Text="{DynamicResource Settings.Px}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                               Text="{DynamicResource Settings.HowRoundCardButtonDefault12Px0Sharp}"/>
                                    <Slider Style="{StaticResource ModernSliderStyle}"
                                    AutomationProperties.Name="{DynamicResource Settings.CardCornerRadius}"
                                            Minimum="0" Maximum="24"
                                            TickFrequency="2"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding CardCornerRadius, Mode=TwoWay}"
                                            VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
</UserControl>
