<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/Cards/AppearancePreviewTile.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v3 — inner tile of the Theme & Layout card,
     split out (2026-09-17) to keep every file under the line budget.
     DataContext inherits SettingsViewModel through the card.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.Cards.AppearancePreviewTile"
             xmlns:crystal="clr-namespace:ProGlassAutomation.Controls.CrystalFluid" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="../../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

                        <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsStackBottom10}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8EC;"/>
                                    <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center" Text="{DynamicResource Settings.PreviewTitle}"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                           Text="{DynamicResource Settings.PreviewCaption}"/>

                                <!-- 🌟 100% Professional Live Dynamic Preview Deck -->
                                <Border Margin="0,10,0,0" Padding="14,12" Background="{DynamicResource SurfaceSecondaryBrush}"
                                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}"
                                        CornerRadius="{DynamicResource CardCornerRadius}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Interactive Palette & Typography Specimen -->
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="12" Height="12" CornerRadius="6" Background="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Text="Live Token Specimen" FontSize="{DynamicResource FontSize.Body}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="All cards, inputs, and controls adapt dynamically in real-time."
                                                       FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="20,2,0,0"/>
                                        </StackPanel>

                                        <!-- Live Accent & Status Pills -->
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource TintBlueBrush}" CornerRadius="12" Padding="10,4" Margin="0,0,6,0">
                                                <TextBlock Text="Active Accent" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                            <Border Background="{DynamicResource TintGreenBrush}" CornerRadius="12" Padding="10,4">
                                                <TextBlock Text="Optimal" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Interactive Component Strip -->
                                        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Padding="12,8"
                                                Background="{DynamicResource SurfacePrimaryBrush}"
                                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}"
                                                CornerRadius="{DynamicResource Radius.Small}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="14" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Theme Engine Pipeline: Synced &amp; WCAG Contrast Verified"
                                                               FontSize="{DynamicResource FontSize.Caption}" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource PrimaryPillButton}" Height="26" Padding="12,0" Content="Test State" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
</UserControl>
