<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/Cards/DataHealthCard.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v3 — one card of the DataSection page, split out
     (2026-09-17) for the module line budget. DataContext inherits
     SettingsViewModel from the section; styles from the two merged
     module dictionaries.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.Cards.DataHealthCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="../../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

                <Border Style="{StaticResource SettingsPageCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                                <TextBlock Text="&#xE958;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings.DatabaseHealth}"
                                           Style="{StaticResource SettingsCardTitleStyle}"/>
                                <TextBlock Text="{DynamicResource Settings.ProbesProglassAutomationDatabaseFileAuto}"
                                           Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="{StaticResource SettingsRowMargin}">
                            <!-- License status strip (compact — full card lives on the About page) -->
                            <Border Style="{StaticResource SettingsWashTileStyle}"
                                    Margin="{StaticResource SettingsStackBottom10}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="&#xE73E;"
                                               FontFamily="{DynamicResource FontFamily.Icon}"
                                               FontSize="{DynamicResource FontSize.Title}"
                                               VerticalAlignment="Center"
                                               Margin="{StaticResource SettingsInlineGap8R}"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}">
                                            <Run Text="{DynamicResource About.License}"/>
                                            <Run Text="{Binding LicenseStatus.StatusBadge, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding LicenseStatus.StatusDescription}"
                                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                                   TextWrapping="Wrap"
                                                   Margin="{StaticResource SettingsStackGap2}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Full-width action row: buttons stretch evenly across the whole card. -->
                            <UniformGrid Columns="2" Margin="{StaticResource SettingsStackGap10}">
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                    Content="{DynamicResource Action.Refresh}"
                                    Command="{Binding RefreshDatabaseHealthCommand}"
                                    HorizontalAlignment="Stretch"
                                    ToolTip="{DynamicResource Settings.ProbeDatabaseRefreshRowCountTable}"/>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                    Content="{DynamicResource Settings.RebuildDatabasesEmergency}"
                                    Command="{Binding RebuildAllDatabasesCommand}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0"
                                    ToolTip="{DynamicResource Settings.MoveDbFileMigrationbackupsRecreateCurrent}"/>
                            </UniformGrid>

                            <ListBox ItemsSource="{Binding DatabaseHealthRows}"
                            AutomationProperties.Name="{DynamicResource Settings.RebuildDatabasesEmergency}"
                                     Margin="{StaticResource SettingsStackGap10}"
                                     MaxHeight="240"
                                     BorderThickness="{DynamicResource Border.HairlineThickness}"
                                     BorderBrush="{DynamicResource BorderDefaultBrush}"
                                     Background="{DynamicResource SurfaceTertiaryBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="{StaticResource SettingsInset2}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="{DynamicResource FontSize.Body}"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{DynamicResource FontSize.Body}"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       Text="{Binding Status}"/>
                                            <Viewbox Grid.Column="2" MaxHeight="18" HorizontalAlignment="Right">
                                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSize.Body}"
                                                           FontWeight="{DynamicResource Weight.Bold}"
                                                           Text="{Binding TotalRowsDisplay}"
                                                           TextAlignment="Right"/>
                                            </Viewbox>
                                            <Viewbox Grid.Column="3" MaxHeight="18" HorizontalAlignment="Right">
                                                <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource FontSize.Body}"
                                                           FontWeight="{DynamicResource Weight.Bold}"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                           Text="{Binding FileSizeDisplay}"
                                                           TextAlignment="Right"/>
                                            </Viewbox>
                                            <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="{DynamicResource FontSize.BodySmall}"
                                                       TextWrapping="Wrap"
                                                       Margin="{StaticResource SettingsInlineGap8}"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       Text="{Binding DriftDisplay}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="{Binding DatabaseHealthStatus}"
                                       Style="{StaticResource SettingsRowMetaStyle}"
                                       FontWeight="{DynamicResource Weight.SemiBold}"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
</UserControl>
