<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/Cards/AppearanceAccentFontCard.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v3 — one card of the AppearanceSection page, split out of
     SettingsAppearanceSection.xaml (2026-09-17) so no section carries six cards in one
     1,200+ line tree. DataContext inherits SettingsViewModel from the
     section; styles come from the two merged module dictionaries.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.Cards.AppearanceAccentFontCard"
             xmlns:crystal="clr-namespace:ProGlassAutomation.Controls.CrystalFluid" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="../../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

                <Border Style="{StaticResource SettingsPageCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.AccentFONT}"
                                   Style="{StaticResource SettingsCardTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Settings.ColourIdentityTypographyAppliedScreen}"
                                   Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                        <UniformGrid Columns="3" Margin="{StaticResource SettingsTileGridBleed}">

                            <!-- Accent palette (wide) -->
                            <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTileGridMargin}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE790;"/>
                                        <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center" Text="{DynamicResource Settings.LblAccent}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                               Text="{DynamicResource Settings.ButtonsTintsHoverStatesMonetGlassSurfaces}"/>
                                    <!-- Palette chips generated from SettingsViewModel.AccentPalette
                                         (single source of truth: AccentPresets.All) — the swatch
                                         shown IS the exact colour that gets applied. -->
                                    <ItemsControl ItemsSource="{Binding AccentPalette}" Margin="{StaticResource SettingsStackGap4}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.ApplyAccentCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Key}"
                                                        Style="{StaticResource AccentChipStyle}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="11" Height="11" Fill="{Binding Swatch}"
                                                                 VerticalAlignment="Center" Margin="{StaticResource SettingsInlineGap8R}"/>
                                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- Free-pick colour: type any hex, the whole adaptive palette
                                         (Monet glass, tints, keylines) re-derives from it. -->
                                    <Border Margin="{StaticResource SettingsStackGap12}" Padding="10,8" CornerRadius="{DynamicResource Radius.Small}"
                                            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}"
                                            HorizontalAlignment="Left" Style="{StaticResource SettingsWashTileStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="14" Height="14"
                                                     Fill="{Binding CustomAccentSwatch}"
                                                     Stroke="{DynamicResource BorderDefaultBrush}" StrokeThickness="1"
                                                     VerticalAlignment="Center" Margin="{StaticResource SettingsInlineGap10R}"/>
                                            <TextBox Text="{Binding CustomAccentHex, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="110" Padding="8,6" FontSize="{DynamicResource FontSize.Title}"
                                                     FontFamily="{DynamicResource FontFamily.Code}"
                                                     VerticalAlignment="Center" Style="{StaticResource TextBoxStyle}"/>
                                            <Button Command="{Binding ApplyCustomAccentCommand}"
                                                    Style="{StaticResource AccentChipStyle}" Margin="{StaticResource SettingsInlineGap8}">
                                                <TextBlock Text="{DynamicResource Settings.ApplyCustomColour}"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                               Text="{Binding CustomAccentStatus}" Margin="{StaticResource SettingsStackGap6}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Font family -->
                            <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTileGridMargin}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8EC;"/>
                                        <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center" Text="{DynamicResource Settings.FontFamily}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                               Text="{DynamicResource Settings.UsedScreenDialogTableIconsStaySegoeMDL2}"/>
                                    <ComboBox ItemsSource="{Binding FontOptions}"
                                              SelectedItem="{Binding SelectedFont, Mode=TwoWay}"
                                              DisplayMemberPath="Name"
                                              HorizontalAlignment="Stretch"
                                              Padding="10,7" FontSize="{DynamicResource FontSize.Title}"
                                              MaxDropDownHeight="320" Style="{StaticResource ComboBoxStyle}"/>
                                    <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                               Text="{Binding FontStatus}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Weight + Style -->
                            <Border Margin="{StaticResource SettingsTileGridMargin}" Style="{StaticResource SettingsInnerTileStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D2;"/>
                                        <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center" Text="{DynamicResource Settings.FontWeightStyle}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                               Text="{DynamicResource Settings.TuneWeightStyleWithinSelectedFamily}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding FontWeightChoices}"
                                                  SelectedItem="{Binding SelectedFontWeight, Mode=TwoWay}"
                                                  Padding="10,7" FontSize="{DynamicResource FontSize.Title}" Style="{StaticResource ComboBoxStyle}"/>
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding FontStyleChoices}"
                                                  SelectedItem="{Binding SelectedFontStyle, Mode=TwoWay}"
                                                  Padding="10,7" FontSize="{DynamicResource FontSize.Title}" Style="{StaticResource ComboBoxStyle}"/>
                                    </Grid>
                                    <WrapPanel Margin="{StaticResource SettingsStackGap12}">
                                        <Button Command="{Binding ImportFontCommand}"
                                                Style="{StaticResource AccentChipStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8E5;" FontFamily="{DynamicResource FontFamily.Icon}"
                                                           FontSize="{DynamicResource FontSize.Body}" VerticalAlignment="Center" Margin="{StaticResource SettingsInlineGap8R}"/>
                                                <TextBlock Text="{DynamicResource Settings.ImportFONT}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ResetFontCommand}"
                                                Style="{StaticResource AccentChipStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE777;" FontFamily="{DynamicResource FontFamily.Icon}"
                                                           FontSize="{DynamicResource FontSize.Body}" VerticalAlignment="Center" Margin="{StaticResource SettingsInlineGap8R}"/>
                                                <TextBlock Text="{DynamicResource Action.Reset}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                        </UniformGrid>

                        <Border Style="{StaticResource SettingsRowSeparatorStyle}"/>

                        <!-- ═════════ GROUP: WALLPAPERS ═════════ -->
                    </StackPanel>
                </Border>
</UserControl>
