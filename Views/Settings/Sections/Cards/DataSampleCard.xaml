<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/Cards/DataSampleCard.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v3 — one card of the DataSection page, split out
     (2026-09-17) for the module line budget. DataContext inherits
     SettingsViewModel from the section; styles from the two merged
     module dictionaries.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.Cards.DataSampleCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="../../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

                <Border Style="{StaticResource SettingsPageCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                                <TextBlock Text="&#xE8A5;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings.SampleDATA}"
                                           Style="{StaticResource SettingsCardTitleStyle}"/>
                                <TextBlock Text="{DynamicResource Settings.NewHereLoadSmallLinkedDemoDatasetExplore}"
                                           Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="{StaticResource SettingsRowMargin}">
                            <Border Style="{StaticResource SettingsInnerTileStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8A5;"/>
                                        <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center" Text="{DynamicResource Settings.ExploreSampleData}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                               Text="{DynamicResource Settings.6Sheets3Proformas2JobOrders2DeliveryNotes3}"/>
                                    <!-- Full-width action row: buttons stretch evenly
                                         across the whole card. -->
                                    <Border Margin="{StaticResource SettingsStackGap10}"
                Style="{StaticResource SurfacePanelTileStyle}">
                                        <UniformGrid Columns="2">
                                            <Button Style="{StaticResource SettingsActionButtonStyle}"
                                                Content="{DynamicResource Settings.LOADSampleDATA}"
                                                Command="{Binding LoadSampleDataCommand}"
                                                HorizontalAlignment="Stretch"
                                                ToolTip="{DynamicResource Settings.SeedDemoDatasetEmptyDatabase}"/>
                                            <Button Style="{StaticResource SettingsActionButtonStyle}"
                                                Content="{DynamicResource Settings.ClearDATA}"
                                                Command="{Binding ClearAllDataCommand}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0"
                                                ToolTip="{DynamicResource Settings.PermanentlyDeleteRecordModulesEGAfterTesting}"/>
                                        </UniformGrid>
                                    </Border>
                                    <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                               Text="{DynamicResource Settings.DoneTestingUseClearDATAWipeDemoDatasetOne}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Style="{StaticResource SettingsRowSeparatorStyle}"/>

                        <!-- ═══════ GROUP: DATABASE HEALTH ═══════
                             Diagnostics + emergency rebuild. Probes every
                             database file (row counts, schema version, missing /
                             extra columns). The rebuild button is the nuclear
                             option gated behind Manager+ and typed confirmation. -->
                    </StackPanel>
                </Border>
</UserControl>
