<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/Cards/DataSampleCard.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v3 — one card of the DataSection page, split out
     (2026-09-17) for the module line budget. DataContext inherits
     SettingsViewModel from the section; styles from the two merged
     module dictionaries.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.Cards.DataSampleCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource SettingsCompactCardStyle}"
            VerticalAlignment="Top"
            Background="{DynamicResource Ios26AccentSoftBrush}"
            BorderBrush="{DynamicResource Ios26AccentBrush}"
            BorderThickness="1.5">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                    <TextBlock Text="&#xE8A5;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Settings.SampleDATA}"
                               Style="{StaticResource SettingsCardTitleStyle}"/>
                    <TextBlock Text="{DynamicResource Settings.NewHereLoadSmallLinkedDemoDatasetExplore}"
                               Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                </StackPanel>
            </Grid>

            <!-- ── COMPACT ACTIONS & SEED CONTROLS ── -->
            <StackPanel Margin="{StaticResource SettingsStackGap12}">
                <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                           Text="{DynamicResource Settings.6Sheets3Proformas2JobOrders2DeliveryNotes3}"/>

                <!-- Compact action buttons side by side -->
                <Grid Margin="{StaticResource SettingsStackGap10}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource SettingsActionButtonStyle}"
                            Height="36" Margin="0"
                            Content="{DynamicResource Settings.LOADSampleDATA}"
                            Command="{Binding LoadSampleDataCommand}"
                            HorizontalAlignment="Stretch"
                            ToolTip="{DynamicResource Settings.SeedDemoDatasetEmptyDatabase}"/>
                    <Button Grid.Column="2" Style="{StaticResource DangerButton}"
                            Height="36" Margin="0"
                            Content="{DynamicResource Settings.ClearDATA}"
                            Command="{Binding ClearAllDataCommand}"
                            HorizontalAlignment="Stretch"
                            ToolTip="{DynamicResource Settings.PermanentlyDeleteRecordModulesEGAfterTesting}"/>
                </Grid>

                <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                           Margin="{StaticResource SettingsStackGap6}"
                           Text="{DynamicResource Settings.DoneTestingUseClearDATAWipeDemoDatasetOne}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
