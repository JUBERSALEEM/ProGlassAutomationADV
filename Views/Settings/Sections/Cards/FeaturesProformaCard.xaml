                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="{StaticResource SettingsStackBottom8}">
                                            <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8A5;" Margin="{StaticResource SettingsInlineGap8R}" VerticalAlignment="Center"/>
                                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" VerticalAlignment="Center" Text="{DynamicResource Settings.BulkActions}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}"
                                               Text="{DynamicResource Settings.FlipOptionalFieldOnceRestoreBoxLayout}"/>
                                        <UniformGrid Grid.Row="3" Columns="3" Margin="{StaticResource SettingsStackGap10}">
                                            <Button Content="{DynamicResource Settings.Enable}"
                                                    Command="{Binding EnableAllCommand}"
                                                    Style="{StaticResource SettingsActionButtonStyle}"
                                                    ToolTip="{DynamicResource Settings.ShowOptionalFieldWizard}"/>
                                            <Button Content="{DynamicResource Settings.HideOptional}"
                                                    Command="{Binding DisableAllOptionalCommand}"
                                                    Style="{StaticResource SettingsActionButtonStyle}"
                                                    ToolTip="{DynamicResource Settings.CollapseOptionalFieldThreeDBRequiredFields}"/>
                                            <Button Content="{DynamicResource ProformaInvoice.ResetDefaults}"
                                                    Command="{Binding ResetToDefaultsCommand}"
                                                    Style="{StaticResource SettingsActionButtonStyle}"
                                                    Margin="0"
                                                    ToolTip="{DynamicResource Settings.RestoreBoxLayoutFieldVisible}"/>
                                        </UniformGrid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
</UserControl>
