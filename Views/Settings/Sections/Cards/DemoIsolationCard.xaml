<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/Cards/DemoIsolationCard.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v3 — one card of the DemoSection page, split out
     (2026-09-17) for the module line budget. DataContext inherits
     SettingsViewModel from the section; styles from the two merged
     module dictionaries.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.Cards.DemoIsolationCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource SettingsPageCardStyle}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                    <TextBlock Text="&#xE7EB;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Settings.Isolation}"
                               Style="{StaticResource SettingsCardTitleStyle}"/>
                    <TextBlock Text="{DynamicResource Settings.DemoModeKeepsProductionDataUntouchedWhile}"
                               Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                </StackPanel>
            </Grid>

            <!-- ── DEMO SANDBOX CONTROLS DIRECTLY ON CARD ── -->
            <StackPanel Margin="{StaticResource SettingsStackGap12}">
                <TextBlock Text="{Binding IsolationText}"
                           Margin="{StaticResource SettingsStackGap4}"
                           Style="{StaticResource SettingsRowMetaStyle}"/>

                <UniformGrid Columns="2" Margin="{StaticResource SettingsStackGap10}">
                    <Button Style="{StaticResource SettingsActionButtonStyle}"
                            Content="{DynamicResource Settings.EnterDEMOMODE}"
                            Command="{Binding EnterDemoCommand}"
                            HorizontalAlignment="Stretch"/>
                    <Button Style="{StaticResource SettingsActionButtonStyle}"
                            Content="{DynamicResource Settings.EXITDEMOMODE}"
                            Command="{Binding ExitDemoCommand}"
                            HorizontalAlignment="Stretch"
                            Margin="0"/>
                </UniformGrid>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
