<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/Cards/AppearanceLanguageCard.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v3 — one card of the AppearanceSection page, split out of
     SettingsAppearanceSection.xaml (2026-09-17) so no section carries six cards in one
     1,200+ line tree. DataContext inherits SettingsViewModel from the
     section; styles come from the two merged module dictionaries.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.Cards.AppearanceLanguageCard"
             xmlns:crystal="clr-namespace:ProGlassAutomation.Controls.CrystalFluid" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="../../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

                <Border Style="{StaticResource SettingsPageCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.GrpLanguage}"
                                   Style="{StaticResource SettingsCardTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Settings.HintLanguage}"
                                   Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                        <UniformGrid Columns="3" Margin="{StaticResource SettingsTileGridBleed}">

                            <!-- Language (15 shipped, live switch, en-US primary) -->
                            <Border Margin="{StaticResource SettingsTileGridMargin}" Style="{StaticResource SettingsInnerTileStyle}">
                                <StackPanel>
                                    <Border 
                Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8EC;"/>
                                            <TextBlock
                                                   Text="{DynamicResource Settings.LblLanguage}"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock
                                               Text="{DynamicResource Settings.HintLanguage}"/>
                                    <ComboBox AutomationProperties.AutomationId="Settings.Language"
                                              ItemsSource="{Binding Languages}"
                                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName"
                                              MinWidth="180" Margin="{StaticResource SettingsStackGap8}" Style="{StaticResource ComboBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <!-- Currency (live FX, offline = last fetched) -->
                            <Border Margin="{StaticResource SettingsTileGridMargin}" Style="{StaticResource SettingsInnerTileStyle}">
                                <StackPanel>
                                    <Border 
                Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                        <StackPanel>
                                            <TextBlock Text="&#xEAF1;"
                                                   FontFamily="{DynamicResource FontFamily.Icon}"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   Margin="{StaticResource SettingsInlineGap6R}"/>
                                            <TextBlock
                                                   Text="{DynamicResource Settings.LblCurrency}"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock
                                               Text="{DynamicResource Settings.HintCurrency}"/>
                                    <ComboBox AutomationProperties.AutomationId="Settings.Currency"
                                              ItemsSource="{Binding Currencies}"
                                              SelectedItem="{Binding SelectedCurrency, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName"
                                              MinWidth="180" Margin="{StaticResource SettingsStackGap8}" Style="{StaticResource ComboBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <!-- Phone country (from IP, editable) -->
                            <Border Margin="{StaticResource SettingsTileGridMargin}" Style="{StaticResource SettingsInnerTileStyle}">
                                <StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="&#xE717;"
                                                   FontFamily="{DynamicResource FontFamily.Icon}"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   Margin="{StaticResource SettingsInlineGap6R}"/>
                                        <TextBlock
                                                   Text="{DynamicResource Settings.LblPhoneCountry}"/>
                                    </StackPanel>
                                    <TextBlock
                                               Text="{DynamicResource Settings.HintPhoneCountry}"/>
                                    <ComboBox AutomationProperties.AutomationId="Settings.PhoneCountry"
                                              ItemsSource="{Binding PhoneCountries}"
                                              SelectedItem="{Binding PhoneCountry, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName"
                                              MinWidth="180" Margin="{StaticResource SettingsStackGap8}" Style="{StaticResource ComboBoxStyle}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- ═══ ACCESSIBILITY — reduced motion (§43) ═══
                             App-wide switch: the Crystal Fluid water/caustic/
                             bubble choreography and card tilt render calm and
                             static. Persisted; survives family switches. -->
                        <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsStackBottom10}">
                            <StackPanel>
                                <StackPanel>
                                    <TextBlock Text="&#xE713;"
                                                   FontFamily="{DynamicResource FontFamily.Icon}"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   Margin="{StaticResource SettingsInlineGap6R}"/>
                                    <TextBlock
                                               Text="{DynamicResource Settings.ReducedMotion}"/>
                                </StackPanel>
                                <TextBlock
                                           Text="{DynamicResource Settings.ReducedMotionTip}"
                                           TextWrapping="Wrap"/>
                                <CheckBox AutomationProperties.AutomationId="Settings.ReducedMotion"
                                AutomationProperties.Name="{DynamicResource Settings.ReducedMotion}"
                                          Content="{DynamicResource Settings.ReducedMotion}"
                                          IsChecked="{Binding ReducedMotion, Mode=TwoWay}"
                                          Margin="{StaticResource SettingsStackGap8}"/>
                            </StackPanel>
                        </Border>

                        <!-- Auto-detect + currency status — 2026-09-05: was a bare
                             Grid with a default (unstyled) WPF button; now the same
                             rounded SettingsTileStyle card language as every other
                             tile in this section. Bindings/AutomationIds unchanged. -->
                        <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsStackGap4}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE774;"/>
                                    <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center"
                                               Text="{DynamicResource Settings.LocaleFallback}"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                           Text="{DynamicResource Settings.LocaleFallbackCaption}"/>
                                <Grid Margin="{StaticResource SettingsStackGap8}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <CheckBox Content="{DynamicResource Settings.LblAutoDetect}"
                                        AutomationProperties.Name="{DynamicResource Settings.LblAutoDetect}"
                                                  IsChecked="{Binding AutoSuggestByRegion, Mode=TwoWay}"
                                                  FontSize="{DynamicResource FontSize.Body}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  VerticalContentAlignment="Center"
                                                  AutomationProperties.AutomationId="Settings.AutoSuggestByRegion"/>
                                        <TextBlock Text="{Binding FxStatusText}"
                                                   Style="{StaticResource SettingsRowMetaStyle}"
                                                   Margin="{StaticResource SettingsStackGap4}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource OutlinedPillButton}"
                                            Content="{DynamicResource Settings.ResetToEnglish}"
                                            Command="{Binding ResetToEnglishCommand}"
                                            AutomationProperties.AutomationId="Settings.ResetLocale"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
</UserControl>
