<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/Cards/AiSecurityCard.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v3 — one card of the AiSection page, split out
     (2026-09-17) for the module line budget. DataContext inherits
     SettingsViewModel from the section; styles from the two merged
     module dictionaries.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.Cards.AiSecurityCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="../../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource SettingsPageCardStyle}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                    <TextBlock Text="&#xE72E;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Settings.Security}"
                               Style="{StaticResource SettingsCardTitleStyle}"/>
                    <TextBlock Text="{DynamicResource Settings.ControlKeyPersistenceWipeStoredConversation}"
                               Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                </StackPanel>
            </Grid>

            <!-- ── SHORT CARDS / SMART BENTO ROW: BALANCED 2-COLUMN LAYOUT ── -->
            <UniformGrid Columns="2" Margin="{StaticResource SettingsTileGridBleedKeepTop}">

                <!-- Left Column: Keep API keys saved -->
                <Grid Margin="{StaticResource SettingsTileGridMargin}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="{StaticResource SettingsStackBottom8}">
                        <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE72E;" Margin="{StaticResource SettingsInlineGap8R}" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource Settings.KeepKeysSaved}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1"
                               Style="{StaticResource SettingsRowMetaStyle}"
                               Text="{DynamicResource Settings.KeysHeldSessionKeysAlwaysEncryptedWindows}"/>
                    <ToggleButton Grid.Row="3"
                                  AutomationProperties.Name="{DynamicResource Settings.KeepKeysSaved}"
                                  HorizontalAlignment="Left"
                                  Margin="{StaticResource SettingsStackGap8}"
                                  IsChecked="{Binding KeepApiKeysSaved, Mode=TwoWay}"
                                  Style="{StaticResource ModernToggleSwitch}"/>
                </Grid>

                <!-- Right Column: Vault Actions (Remove keys & Clear memory) -->
                <StackPanel Margin="{StaticResource SettingsTileGridMargin}">
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource SettingsStackBottom4}">
                        <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE74D;" Margin="{StaticResource SettingsInlineGap8R}" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="Vault Management" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                               Text="{DynamicResource Settings.DeleteProviderKeyDiskAssistantAskReEnterNext}"/>
                    <UniformGrid Columns="2" Margin="{StaticResource SettingsStackGap8}">
                        <Button Style="{StaticResource DangerButton}"
                                Tag="&#xE74D;" Content="{DynamicResource Settings.RemoveKEYS}"
                                Command="{Binding RemoveSavedKeysCommand}"
                                Margin="{StaticResource SettingsInlineGap6R}"
                                HorizontalAlignment="Stretch"/>
                        <Button Style="{StaticResource DangerButton}"
                                Tag="&#xE81C;" Content="{DynamicResource Settings.ClearMemory}"
                                Command="{Binding ClearAiMemoryCommand}"
                                HorizontalAlignment="Stretch"/>
                    </UniformGrid>
                </StackPanel>

            </UniformGrid>
        </StackPanel>
    </Border>
</UserControl>
