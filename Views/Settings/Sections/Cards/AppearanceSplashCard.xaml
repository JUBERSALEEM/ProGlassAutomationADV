<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/Cards/AppearanceSplashCard.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings → Appearance → Splash Screen Stage & Styles
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.Cards.AppearanceSplashCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="../../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource SettingsPageCardStyle}">
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE7F4;" Margin="0,0,8,0" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="SPLASH SCREEN STAGE &amp; THEMES" Style="{StaticResource SettingsCardTitleStyle}"/>
                    </StackPanel>
                    <TextBlock Text="Select between 10 corporate glass architectures or automatically cycle on every system boot."
                               Style="{StaticResource SettingsCardHeaderNoteStyle}" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource TintBlueBrush}" CornerRadius="12" Padding="10,4" VerticalAlignment="Top">
                    <TextBlock Text="10 Corporate Presets" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                </Border>
            </Grid>

            <Border Style="{StaticResource SettingsInnerTileStyle}" Padding="16,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="ACTIVE STYLE" Style="{StaticResource SettingsRowTitleStyle}"/>
                            <ComboBox ItemsSource="{Binding SplashStyleOptions}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      SelectedValue="{Binding SelectedSplashStyle, Mode=TwoWay}"
                                      Width="280" Height="36" Margin="0,6,0,0"
                                      Style="{StaticResource ComboBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedSplashStyleName}" FontSize="{DynamicResource FontSize.Body}"
                                       FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding SelectedSplashStyleDescription}" FontSize="{DynamicResource FontSize.Caption}"
                                       Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
