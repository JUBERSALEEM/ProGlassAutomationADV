<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/Cards/DemoRecordCard.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v3 — one card of the DemoSection page, split out
     (2026-09-17) for the module line budget. DataContext inherits
     SettingsViewModel from the section; styles from the two merged
     module dictionaries.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.Cards.DemoRecordCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="../../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource SettingsPageCardStyle}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                    <TextBlock Text="&#xE714;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Settings.RecordSession2}"
                               Style="{StaticResource SettingsCardTitleStyle}"/>
                    <TextBlock Text="{DynamicResource Settings.RecordRunningAppWindowWithoutModuleWorkflow}"
                               Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                </StackPanel>
            </Grid>

            <!-- ── SESSION RECORDING CONTROLS DIRECTLY ON CARD ── -->
            <StackPanel Margin="{StaticResource SettingsStackGap12}">
                <TextBlock Text="{Binding SessionRecordHint}"
                           Style="{StaticResource SettingsRowMetaStyle}"/>
                <TextBlock Text="{Binding SessionRecordStatus}"
                           FontWeight="{DynamicResource Weight.SemiBold}"
                           Foreground="{DynamicResource AccentBrush}"
                           Margin="{StaticResource SettingsStackGap4}"
                           Style="{StaticResource SettingsRowMetaStyle}"/>

                <!-- Primary action row: clean button layout -->
                <Grid Margin="{StaticResource SettingsStackGap10}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Style="{StaticResource SettingsActionButtonStyle}"
                            Content="{DynamicResource Settings.StartRecording}"
                            Command="{Binding StartSessionRecordCommand}"
                            AutomationProperties.AutomationId="DemoCenter.StartSessionRecord"
                            Visibility="{Binding IsSessionIdle,
                                Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="1"
                            Style="{StaticResource SettingsActionButtonStyle}"
                            Content="{DynamicResource Settings.STOPSAVE}"
                            Command="{Binding StopSessionRecordCommand}"
                            AutomationProperties.AutomationId="DemoCenter.StopSessionRecord"
                            Visibility="{Binding IsSessionRecording,
                                Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="{StaticResource SettingsIconTextMargin}"
                            HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="2"
                            Style="{StaticResource SettingsActionButtonStyle}"
                            Content="{DynamicResource Settings.OPENRecordings}"
                            Command="{Binding OpenRecordingsCommand}"
                            Margin="{StaticResource SettingsIconTextMargin}"
                            HorizontalAlignment="Stretch"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
