<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/Cards/DemoOutputCard.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v3 — one card of the DemoSection page, split out
     (2026-09-17) for the module line budget. DataContext inherits
     SettingsViewModel from the section; styles from the two merged
     module dictionaries.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.Cards.DemoOutputCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="../../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

                <Border Style="{StaticResource SettingsPageCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                                <TextBlock Text="&#xE7C8;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource DeliveryNote.History}"
                                           Style="{StaticResource SettingsCardTitleStyle}"/>
                                <TextBlock Text="{DynamicResource Settings.LedgerRecordingJobRunMachine}"
                                           Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="{StaticResource SettingsRowMargin}">
                            <Border Style="{StaticResource SettingsInnerTileStyle}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings.NoJobsYetGenerateSelectedGenerateStart}"
                                               Style="{StaticResource SettingsRowMetaStyle}"
                                               Visibility="{Binding HasHistory,
                                                   Converter={StaticResource InverseBoolToVisibilityConverter},
                                                   FallbackValue=Visible}"/>
                                    <ItemsControl ItemsSource="{Binding History}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="{StaticResource SettingsStackBottom10}">
                                                    <TextBlock FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}">
                                                        <Run Text="{Binding Module, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding State, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Status}"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               FontSize="{DynamicResource FontSize.Body}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
</UserControl>
