<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/Cards/DataRootCard.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v4 — Company LAN / Wi-Fi shared database card
             (senior audit 2026-09-24: one direct share-the-folder flow)
     ───────────────────────────────────────────────────────────────────
     The old card asked the operator to flip a "use shared folder"
     access-mode checkbox BEFORE touching the path, and that toggle used
     to auto-save a half-configured shared mode. The flow is now the one
     a senior expects:

         1. type the shared folder   →  2. Test Connection
         3. Prepare Folder           →  4. Save + Restart

     The mode decision is made by the explicit Save/Revert commands,
     which validate the path first. A red split-brain banner appears
     (SharedRootWarning) whenever this workstation is on LOCAL data
     while a shared root is configured — the state used to be silent.
     DataContext inherits SettingsViewModel from the section; styles
     from the two merged module dictionaries.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.Cards.DataRootCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource SettingsCompactCardStyle}">
        <StackPanel>

            <!-- ── HEADER ── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                    <TextBlock Text="&#xE968;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center">
                    <TextBlock Text="Company LAN / Wi-Fi Database"
                               Style="{StaticResource SettingsCardTitleStyle}"/>
                    <TextBlock Text="Share one ProGlass data folder across all office workstations on the same WiFi/LAN. Use a stable Windows shared folder (not cloud-sync); restart each workstation after saving."
                               Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                </StackPanel>
                <Border Grid.Column="2" Background="{DynamicResource TintIndigoBrush}"
                        CornerRadius="{DynamicResource Radius.Small}"
                        Padding="10,5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DataRootModeDisplay}"
                               FontSize="{DynamicResource FontSize.Caption}"
                               FontWeight="{DynamicResource Weight.SemiBold}"
                               Foreground="{DynamicResource AccentBrush}"/>
                </Border>
            </Grid>

            <!-- ── SPLIT-BRAIN BANNER — visible only when the live root
                 is local while shared mode is configured ── -->
            <Border Style="{StaticResource SettingsWashTileStyle}"
                    Background="{DynamicResource TintRedBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    Padding="10,8"
                    Margin="{StaticResource SettingsStackGap10}"
                    Visibility="{Binding SharedRootWarning, Converter={StaticResource StringToVisibilityConverter}}">
                <TextBlock Text="{Binding SharedRootWarning}"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSize.BodySmall}"
                           FontWeight="{DynamicResource Weight.SemiBold}"
                           Foreground="{DynamicResource DangerBrush}"/>
            </Border>

            <!-- ── BODY ── -->
            <StackPanel Margin="{StaticResource SettingsStackGap12}">

                <!-- Shared folder path — the one input that matters -->
                <TextBlock Text="Shared folder path (UNC recommended: \\SERVER\ProGlassData — a mapped LAN drive works too)"
                           Style="{StaticResource SettingsRowMetaStyle}"/>
                <TextBox Text="{Binding SharedDataRootPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10,7"
                         FontSize="{DynamicResource FontSize.Body}"
                         ToolTip="Example: \\Office-PC\ProGlassData or Z:\ProGlassData"
                         Style="{StaticResource TextBoxStyle}"/>

                <!-- Workstation label + live root, side by side -->
                <Grid Margin="{StaticResource SettingsStackGap10}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.35*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Workstation name for support/audit"
                                   Style="{StaticResource SettingsRowMetaStyle}"/>
                        <TextBox Text="{Binding WorkstationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,7"
                                 FontSize="{DynamicResource FontSize.Body}"
                                 Style="{StaticResource TextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Current live root"
                                   Style="{StaticResource SettingsRowMetaStyle}"/>
                        <TextBlock Text="{Binding CurrentDataRootDisplay}"
                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                   FontWeight="{DynamicResource Weight.SemiBold}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <!-- One-time copy — single compact line -->
                <CheckBox Content="Copy current local data into the shared folder if it is empty"
                          AutomationProperties.Name="Copy current local data into the shared folder if it is empty"
                          IsChecked="{Binding CopyLocalDataOnEnable, Mode=TwoWay}"
                          Foreground="{DynamicResource SecondaryForegroundBrush}"
                          Margin="{StaticResource SettingsStackGap8}"/>

                <!-- Actions — standardized 36px row -->
                <Grid Margin="{StaticResource SettingsStackGap10}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource SettingsActionButtonStyle}"
                            Height="36" Margin="0"
                            Content="Test Connection"
                            Command="{Binding TestSharedDataRootCommand}"
                            HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="2" Style="{StaticResource SettingsActionButtonStyle}"
                            Height="36" Margin="0"
                            Content="Prepare Folder"
                            Command="{Binding PrepareSharedDataRootCommand}"
                            HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="4" Style="{StaticResource PrimaryPillButton}"
                            Height="36" Margin="0"
                            Content="Save + Restart"
                            Command="{Binding ApplySharedDataRootCommand}"
                            HorizontalAlignment="Stretch"/>
                </Grid>

                <!-- Way back — quiet, never a big card -->
                <Button Style="{StaticResource OutlinedPillButton}"
                        Height="36"
                        Content="Revert to local workstation database"
                        Command="{Binding RevertToLocalDataRootCommand}"
                        HorizontalAlignment="Right"
                        Padding="14,0"/>

                <!-- Status — always present, operator-readable -->
                <Border Style="{StaticResource SettingsWashTileStyle}"
                        Background="{DynamicResource TintAmberBrush}"
                        Padding="10,8"
                        Margin="{StaticResource SettingsStackGap12}">
                    <TextBlock Text="{Binding NetworkDataRootStatus}"
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource FontSize.Body}"
                               FontWeight="{DynamicResource Weight.SemiBold}"
                               Foreground="{DynamicResource WarningBrush}"/>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
