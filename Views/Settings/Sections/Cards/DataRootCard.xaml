<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/Cards/DataRootCard.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings — Company LAN / Wi-Fi database card.
     Create Folder is the first action: it creates the folder (and the
     Windows share, when Windows allows it) without a backup gate.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.Cards.DataRootCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource SettingsCompactCardStyle}"
            Background="{DynamicResource Ios26AccentSoftBrush}"
            BorderBrush="{DynamicResource Ios26AccentBrush}"
            BorderThickness="1.5"
            VerticalAlignment="Top">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="36" Height="36"
                        CornerRadius="{DynamicResource Radius.Large}"
                        Background="{DynamicResource Ios26AccentBrush}">
                    <TextBlock Text="&#xE839;" FontFamily="{DynamicResource FontFamily.Icon}"
                               FontSize="{DynamicResource FontSize.Body}"
                               Foreground="{DynamicResource Ios26OnAccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center">
                    <TextBlock Text="Company LAN / Wi-Fi database" Style="{StaticResource SettingsCardTitleStyle}"/>
                    <TextBlock Text="Create the shared folder on this PC, then point every workstation at it."
                               Style="{StaticResource SettingsCardHeaderNoteStyle}"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="2" VerticalAlignment="Center"
                        Background="{DynamicResource Ios26AccentBrush}"
                        CornerRadius="{DynamicResource Radius.Large}"
                        Padding="10,4">
                    <TextBlock Text="LAN"
                               FontSize="{DynamicResource FontSize.Caption}"
                               FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource Ios26OnAccentBrush}"/>
                </Border>
            </Grid>

            <Border Margin="{StaticResource SettingsStackGap12}"
                    Padding="12,10"
                    CornerRadius="{DynamicResource Radius.Large}"
                    Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource Ios26AccentBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Shared folder path" Style="{StaticResource SettingsFieldLabelStyle}"/>
                    <TextBox Text="{Binding SharedDataRootPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBoxStyle}"
                             Height="34"
                             Padding="10,7"
                             Margin="0,6,0,0"
                             ToolTip="Leave empty and press Create Folder to use C:\ProGlassData. Or type an existing share such as \\SERVER\ProGlassData."/>
                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource SettingsRowMetaStyle}"
                               TextWrapping="Wrap"
                               Text="Empty path creates C:\ProGlassData on this PC and publishes the Windows share ProGlassData when Windows allows it."/>
                </StackPanel>
            </Border>

            <CheckBox Content="Use shared company database folder"
                      AutomationProperties.Name="Use shared company database folder"
                      IsChecked="{Binding UseSharedDataRoot, Mode=TwoWay}"
                      FontWeight="{DynamicResource Weight.SemiBold}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      Margin="{StaticResource SettingsStackGap8}"/>
            <CheckBox Content="Copy this PC's data into the shared folder only when that folder is empty"
                      AutomationProperties.Name="Copy current local data if shared folder is empty"
                      IsChecked="{Binding CopyLocalDataOnEnable, Mode=TwoWay}"
                      Foreground="{DynamicResource SecondaryForegroundBrush}"
                      Margin="{StaticResource SettingsStackGap8}"/>

            <UniformGrid Columns="2" Margin="{StaticResource SettingsStackGap8}">
                <Button Content="Create Folder"
                        Command="{Binding CreateSharedFolderCommand}"
                        Style="{StaticResource SettingsPrimaryButtonStyle}"
                        Height="34"
                        Margin="0,0,6,6"
                        ToolTip="Creates the folder now. Does not copy databases and does not need a backup."/>
                <Button Content="Test Connection"
                        Command="{Binding TestSharedDataRootCommand}"
                        Style="{StaticResource SettingsActionButtonStyle}"
                        Height="34"
                        Margin="6,0,0,6"/>
                <Button Content="Prepare Folder"
                        Command="{Binding PrepareSharedDataRootCommand}"
                        Style="{StaticResource SettingsActionButtonStyle}"
                        Height="34"
                        Margin="0,0,6,0"
                        ToolTip="Verifies the folder and, if copy is on, copies local data only when the folder is empty."/>
                <Button Content="Save + Restart"
                        Command="{Binding ApplySharedDataRootCommand}"
                        Style="{StaticResource SettingsActionButtonStyle}"
                        Height="34"
                        Margin="6,0,0,0"/>
            </UniformGrid>

            <TextBlock Text="{Binding NetworkDataRootStatus}"
                       Margin="{StaticResource SettingsStackGap8}"
                       Style="{StaticResource SettingsRowMetaStyle}"
                       TextWrapping="Wrap"/>

            <Button Content="Use local database instead"
                    Command="{Binding RevertToLocalDataRootCommand}"
                    Style="{StaticResource SettingsActionButtonStyle}"
                    Height="32"
                    HorizontalAlignment="Left"
                    Margin="{StaticResource SettingsStackGap8}"/>

            <UniformGrid Columns="2" Margin="{StaticResource SettingsStackGap8}">
                <Border Margin="0,0,6,0" Padding="10,8"
                        CornerRadius="{DynamicResource Radius.Large}"
                        Background="{DynamicResource SurfacePrimaryBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="This workstation" Style="{StaticResource SettingsRowMetaStyle}"/>
                        <TextBlock Text="{Binding WorkstationName}"
                                   Margin="0,4,0,0"
                                   FontWeight="{DynamicResource Weight.SemiBold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Margin="6,0,0,0" Padding="10,8"
                        CornerRadius="{DynamicResource Radius.Large}"
                        Background="{DynamicResource SurfacePrimaryBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Live database root" Style="{StaticResource SettingsRowMetaStyle}"/>
                        <TextBlock Text="{Binding CurrentDataRootDisplay}"
                                   Margin="0,4,0,0"
                                   FontWeight="{DynamicResource Weight.SemiBold}"
                                   Foreground="{DynamicResource Ios26AccentBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Background="{DynamicResource StatusWarningSoftBrush}"
                    BorderBrush="{DynamicResource StatusWarningBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Large}"
                    Padding="10,8"
                    Margin="{StaticResource SettingsStackGap8}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SharedRootWarning}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding SharedRootWarning}"
                           Foreground="{DynamicResource StatusWarningBrush}"
                           FontSize="{DynamicResource FontSize.BodySmall}"
                           TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
