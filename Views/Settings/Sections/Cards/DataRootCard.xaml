<!-- Company shared-data folder settings. Windows sharing is configured in
     File Explorer; ProGlass only tests and uses the selected UNC/mapped path. -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.Cards.DataRootCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource SettingsCompactCardStyle}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                    <TextBlock Text="&#xE968;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center">
                    <TextBlock Text="Shared Company Data Folder"
                               Style="{StaticResource SettingsCardTitleStyle}"/>
                    <TextBlock Text="Use the same Windows shared-folder path on every workstation. Test it before applying; changes take effect after restart."
                               Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                </StackPanel>
                <Border Grid.Column="2" Background="{DynamicResource TintIndigoBrush}"
                        CornerRadius="{DynamicResource Radius.Small}"
                        Padding="10,5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DataRootModeDisplay}"
                               FontSize="{DynamicResource FontSize.Caption}"
                               FontWeight="{DynamicResource Weight.SemiBold}"
                               Foreground="{DynamicResource AccentBrush}"/>
                </Border>
            </Grid>

            <Border Style="{StaticResource SettingsWashTileStyle}"
                    Background="{DynamicResource TintAmberBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    Padding="10,8"
                    Margin="{StaticResource SettingsStackGap10}"
                    Visibility="{Binding SharedRootWarning, Converter={StaticResource StringToVisibilityConverter}}">
                <TextBlock Text="{Binding SharedRootWarning}"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSize.BodySmall}"
                           FontWeight="{DynamicResource Weight.SemiBold}"
                           Foreground="{DynamicResource WarningBrush}"/>
            </Border>

            <StackPanel Margin="{StaticResource SettingsStackGap12}">
                <TextBlock Text="Shared folder path (UNC or mapped network drive)"
                           Style="{StaticResource SettingsRowMetaStyle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding SharedDataRootPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,7"
                             FontSize="{DynamicResource FontSize.Body}"
                             ToolTip="Enter the same network path on each workstation, for example \\OFFICE-PC\ProGlassData or Z:\ProGlassData."
                             Style="{StaticResource TextBoxStyle}"/>
                    <Button Grid.Column="2"
                            Style="{StaticResource SettingsActionButtonStyle}"
                            Height="36" Margin="0"
                            Content="Browse…"
                            Command="{Binding BrowseSharedDataRootCommand}"
                            ToolTip="Browse to the existing shared folder. You can also type a UNC path or mapped network drive."/>
                </Grid>

                <TextBlock Text="Examples: \\OFFICE-PC\ProGlassData   •   \\192.168.1.25\ProGlassData   •   Z:\ProGlassData"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSize.BodySmall}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Margin="{StaticResource SettingsStackGap6}"/>

                <TextBlock Text="Set up sharing in Windows File Explorer on the host PC (folder Properties → Sharing). Use a UNC path or mapped drive reachable by every workstation over the office network or your remote/VPN connection. ProGlass does not create Windows shares or change permissions and firewall settings."
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSize.BodySmall}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Margin="{StaticResource SettingsStackGap8}"/>

                <Border Style="{StaticResource SettingsWashTileStyle}"
                        Padding="10,8"
                        Margin="{StaticResource SettingsStackGap10}">
                    <StackPanel>
                        <TextBlock Text="Currently active data root"
                                   Style="{StaticResource SettingsRowMetaStyle}"/>
                        <TextBlock Text="{Binding CurrentDataRootDisplay}"
                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                   FontWeight="{DynamicResource Weight.SemiBold}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Changing folders does not copy, merge, or overwrite records. Confirm that every workstation is connecting to the intended company dataset."
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSize.BodySmall}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Margin="{StaticResource SettingsStackGap8}"/>

                <Grid Margin="{StaticResource SettingsStackGap10}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Style="{StaticResource SettingsActionButtonStyle}"
                            Height="36" Margin="0"
                            Content="Test Connection"
                            Command="{Binding TestSharedDataRootCommand}"
                            HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="2"
                            Style="{StaticResource PrimaryPillButton}"
                            Height="36" Margin="0"
                            Content="Apply and Restart"
                            Command="{Binding ApplySharedDataRootCommand}"
                            HorizontalAlignment="Stretch"
                            ToolTip="Enabled after the current network path passes Test Connection."/>
                </Grid>

                <Button Style="{StaticResource OutlinedPillButton}"
                        Height="36"
                        Content="Return to local workstation database"
                        Command="{Binding RevertToLocalDataRootCommand}"
                        HorizontalAlignment="Right"
                        Padding="14,0"/>

                <Border Style="{StaticResource SettingsWashTileStyle}"
                        Background="{DynamicResource TintAmberBrush}"
                        Padding="10,8"
                        Margin="{StaticResource SettingsStackGap12}">
                    <TextBlock Text="{Binding NetworkDataRootStatus}"
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource FontSize.Body}"
                               FontWeight="{DynamicResource Weight.SemiBold}"
                               Foreground="{DynamicResource WarningBrush}"/>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
