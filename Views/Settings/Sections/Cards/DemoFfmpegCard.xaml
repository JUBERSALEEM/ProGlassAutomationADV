<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/Cards/DemoFfmpegCard.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v3 — one card of the DemoSection page, split out
     (2026-09-17) for the module line budget. DataContext inherits
     SettingsViewModel from the section; styles from the two merged
     module dictionaries.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.Cards.DemoFfmpegCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="../../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

                <Border Style="{StaticResource SettingsPageCardStyle}"
                        Visibility="{Binding IsFfmpegMissing,
                            Converter={StaticResource BoolToVisibilityConverter},
                            FallbackValue=Collapsed}">
                    <StackPanel>
                        <Border 
        Style="{StaticResource SettingsInnerTileStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE7B8;"/>
                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center" Text="{DynamicResource Settings.Ffmpeg}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding FfmpegStatus}"
                                   Style="{StaticResource SettingsRowMetaStyle}"
                                   FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Style="{StaticResource SettingsRowMetaStyle}">
                            <Run Text="{DynamicResource Settings.GenerateStartUntilFfmpegInstalledClick}"/>
                            <Run Text="{DynamicResource Settings.AppFetchesWindowsEssentialsZipChecksExtracts}"/>
                            <Run Text="{DynamicResource Settings.FfmpegExe}"/><Run Text="{DynamicResource Settings.And}"/><Run Text="{DynamicResource Settings.FfprobeExe}"/><Run Text="{DynamicResource Settings.ToolsFolderAutomaticallyThenRecheck}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding FfmpegDownloadUrl}"
                                   FontSize="{DynamicResource FontSize.Body}"
                                   FontFamily="{DynamicResource FontFamily.Code}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap"
                                   Margin="{StaticResource SettingsStackBottom8}"/>
                        <!-- Live download progress while the one-click
                             installer runs; hidden otherwise. -->
                        <Grid Margin="{StaticResource SettingsStackBottom8}"
                              Visibility="{Binding IsInstallingFfmpeg,
                                  Converter={StaticResource BoolToVisibilityConverter},
                                  FallbackValue=Collapsed}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar Grid.Column="0"
                                         Height="8"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding FfmpegDownloadPercent, Mode=OneWay}"
                                         Foreground="{DynamicResource AccentBrush}"
                                         VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Margin="{StaticResource SettingsIconTextMargin}"
                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Text="{Binding FfmpegDownloadPercent, Mode=OneWay,
                                           StringFormat={}{0:0}%}"/>
                        </Grid>
                        <TextBlock Text="{Binding FfmpegInstallHint}"
                                   Style="{StaticResource SettingsRowMetaStyle}"/>
                        <!-- Full-width action row: buttons stretch evenly. -->
                        <Border Margin="{StaticResource SettingsStackGap12}"
        Style="{StaticResource SurfacePanelTileStyle}">
                            <UniformGrid Columns="5">
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                    Content="{DynamicResource Settings.DownloadInstallAutomatic}"
                                    Command="{Binding InstallFfmpegCommand}"
                                    AutomationProperties.AutomationId="DemoCenter.DownloadFfmpeg"
                                    HorizontalAlignment="Stretch"/>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                    Content="{DynamicResource Settings.OfficialFfmpegPAGE}"
                                    Command="{Binding OpenFfmpegPageCommand}"
                                    AutomationProperties.AutomationId="DemoCenter.FfmpegOfficial"
                                    HorizontalAlignment="Stretch"/>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                    Content="{DynamicResource Settings.COPYLINK}"
                                    Command="{Binding CopyFfmpegLinkCommand}"
                                    HorizontalAlignment="Stretch"/>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                    Content="{DynamicResource Settings.OPENToolsFolder}"
                                    Command="{Binding OpenToolsFolderCommand}"
                                    HorizontalAlignment="Stretch"/>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                    Content="{DynamicResource Settings.Recheck}"
                                    Command="{Binding RecheckFfmpegCommand}"
                                    AutomationProperties.AutomationId="DemoCenter.RecheckFfmpeg"
                                    HorizontalAlignment="Stretch"
                                    Margin="0"/>
                            </UniformGrid>
                        </Border>
                        <TextBlock Text="{DynamicResource Settings.FfmpegReadyGenerateSelectedRecordModuleWrite}"
                                   Style="{StaticResource SettingsRowMetaStyle}"
                                   Visibility="{Binding IsFfmpegReady,
                                       Converter={StaticResource BoolToVisibilityConverter},
                                       FallbackValue=Collapsed}"/>
                    </StackPanel>
                </Border>
</UserControl>
