<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/Cards/AgentDataCard.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v3 — one card of the AgentSection page, split out
     (2026-09-17) for the module line budget. DataContext inherits
     SettingsViewModel from the section; styles from the two merged
     module dictionaries.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.Cards.AgentDataCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

                <Border Style="{StaticResource SettingsPageCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                                <TextBlock Text="&#xE8F7;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings.MemoryKnowledge}"
                                           Style="{StaticResource SettingsCardTitleStyle}"/>
                                <TextBlock Text="{DynamicResource Settings.SavedMemoryKnowledgeBaseLiveAgentSDatabase}"
                                           Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource SettingsChipStyle}"
                                    Background="{DynamicResource TintBlueBrush}" VerticalAlignment="Center">
                                <TextBlock Text="Vector Index" Style="{StaticResource SettingsChipTextStyle}"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </Grid>
                        <StackPanel Margin="{StaticResource SettingsRowMargin}">
                            <Grid Margin="{StaticResource SettingsStackGap10}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Grid.Column="0"
                                    Style="{StaticResource SettingsActionButtonStyle}"
                                    Height="36" Margin="0"
                                    Tag="&#xE78C;"
                                    Content="{DynamicResource Settings.ExportKnowledge}"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding ExportKnowledgeCommand}"/>
                                <Button Grid.Row="0" Grid.Column="2"
                                    Style="{StaticResource SettingsActionButtonStyle}"
                                    Height="36" Margin="0"
                                    Tag="&#xE896;"
                                    Content="{DynamicResource Settings.ImportKnowledge}"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding ImportKnowledgeCommand}"/>
                                <Button Grid.Row="2" Grid.Column="0"
                                    Style="{StaticResource DangerButton}"
                                    Height="36" Margin="0"
                                    Tag="&#xE74D;"
                                    Content="{DynamicResource Settings.ClearMemory}"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding ClearMemoryCommand}"/>
                                <Button Grid.Row="2" Grid.Column="2"
                                    Style="{StaticResource DangerButton}"
                                    Height="36" Margin="0"
                                    Tag="&#xE74D;"
                                    Content="{DynamicResource Settings.ClearKnowledge}"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding ClearKnowledgeCommand}"/>
                            </Grid>

                            <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                       Margin="{StaticResource SettingsStackGap12}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding AgentDatabasePath, Mode=OneWay}">
                                <Run Text="{DynamicResource Settings.AgentDatabase}"/>
                                <Run Text="{Binding AgentDatabasePath, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                       Margin="{StaticResource SettingsNoteTightMargin}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SettingsFilePath, Mode=OneWay}">
                                <Run Text="{DynamicResource Settings.AgentSettings}"/>
                                <Run Text="{Binding SettingsFilePath, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Status line -->
                        <TextBlock Text="{Binding Status}"
                                   Style="{StaticResource SettingsRowMetaStyle}"
                                   FontWeight="{DynamicResource Weight.SemiBold}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="{StaticResource SettingsDiscTitleMargin}"/>
                    </StackPanel>
                </Border>
</UserControl>
