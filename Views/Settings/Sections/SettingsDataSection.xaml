<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsDataSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — DATA & BACKUP page (tile-grid redesign Aug 2026)

     REDESIGN
       Was: three giant full-width cards stacked vertically (Backup &
       Restore, Sample Data, Database Health). Each card held its own
       full-width list/grid, so on a wide monitor 60% of horizontal
       space was empty and the page needed endless scrolling on a
       laptop.

       Now: the page is grouped into three labelled tile groups. Small,
       independent actions (backup actions / restore) sit side-by-side
       in 320-wide tiles; the backup set list lives in a wide tile; the
       database health grid keeps a full-row tile because inspecting a
       table needs the width. All 23 ViewModel bindings preserved.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsDataSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,26,32,14">
            <TextBlock Text="Data &amp; Backup" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Protect your production data and explore with sample data."
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}">
            <StackPanel Margin="32,0,32,32">

                <!-- ═══════ GROUP: BACKUP & RESTORE ═══════ -->
                <TextBlock Text="BACKUP &amp; RESTORE"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="A backup set copies every database + settings into one timestamped folder. Automatic sets are created when the app closes; restore always takes a safety snapshot first."
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <UniformGrid Columns="3" Margin="0,0,0,6">

                    <!-- Backup actions tile -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE74E;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Backup Actions"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="Create a backup set now, refresh the list, or open the folder where backups are kept."/>
                            <StackPanel>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="CREATE BACKUP NOW"
                                        Command="{Binding CreateBackupNowCommand}"
                                        HorizontalAlignment="Stretch"/>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="REFRESH"
                                        Command="{Binding RefreshBackupsCommand}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,8,0,0"/>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="OPEN FOLDER"
                                        Command="{Binding OpenBackupsFolderCommand}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Restore tile -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE895;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Restore"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="Restore always snapshots current data first, so a bad restore is never fatal."/>
                            <Button Style="{StaticResource SuccessPillButton}"
                                    Tag="&#xE895;" Content="RESTORE SELECTED BACKUP"
                                    Command="{Binding RestoreSelectedBackupCommand}"
                                    HorizontalAlignment="Stretch"/>
                            <TextBlock Text="{Binding BackupStatus}"
                                       Style="{StaticResource SettingsTileFooterHintStyle}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Backup sets list (wide tile) -->
                    <Border Style="{StaticResource SettingsWideTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8F7;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Backup Sets"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="Pick a set to restore. Selecting is enough — the restore button lights up."/>
                            <ListBox ItemsSource="{Binding BackupSets}"
                                     SelectedItem="{Binding SelectedBackup}"
                                     MaxHeight="170"
                                     BorderThickness="1"
                                     BorderBrush="{DynamicResource OutlineBrush}"
                                     Background="{DynamicResource MenuHoverBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <TextBlock Text="&#xE968;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       IsHitTestVisible="False"/>
                                            <TextBlock VerticalAlignment="Center" FontSize="12"
                                                       IsHitTestVisible="False">
                                                <Run Text="{Binding CreatedAt, Mode=OneWay,
                                                             StringFormat='dd MMM yyyy  HH:mm'}"/>
                                                <Run Text="  •  "/>
                                                <Run Text="{Binding FileCount, Mode=OneWay}"/>
                                                <Run Text=" files  •  "/>
                                                <Run Text="{Binding SizeDisplay, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <Border Style="{StaticResource SettingsGroupSeparatorStyle}"/>

                <!-- ═══════ GROUP: SAMPLE DATA ═══════ -->
                <TextBlock Text="SAMPLE DATA"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="New here? Load a small linked demo dataset to explore every module — only on an empty database."
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <UniformGrid Columns="1" Margin="0,0,0,6">
                    <Border Style="{StaticResource SettingsWideTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8A5;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Explore with Sample Data"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="6 sheets, 3 proformas, 2 job orders, 2 delivery notes, 3 tax invoices — all linked. Your real data is never touched."/>
                            <!-- Full-width action row: buttons stretch evenly
                                 across the whole card. -->
                            <UniformGrid Columns="2" Style="{StaticResource SettingsActionRowStyle}" Margin="0,10,0,0">
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="LOAD SAMPLE DATA"
                                        Command="{Binding LoadSampleDataCommand}"
                                        HorizontalAlignment="Stretch"
                                        ToolTip="Seed the demo dataset on an empty database"/>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="CLEAR ALL DATA"
                                        Command="{Binding ClearAllDataCommand}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0"
                                        ToolTip="Permanently delete every record in all modules (e.g. after testing with sample data)"/>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}"
                                       Text="Done testing? Use CLEAR ALL DATA to wipe the demo dataset in one step and start entering real data."/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource SettingsGroupSeparatorStyle}"/>

                <!-- ═══════ GROUP: DATABASE HEALTH ═══════
                     Diagnostics + emergency rebuild. Probes every
                     database file (row counts, schema version, missing /
                     extra columns). The rebuild button is the nuclear
                     option gated behind Manager+ and typed confirmation. -->
                <TextBlock Text="DATABASE HEALTH"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="Probes every ProGlass Automation database file. The auto-migration on next app start handles most drift; rebuild is the nuclear option for a file too broken to open."
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <UniformGrid Columns="1" Margin="0,0,0,6">
                    <Border Style="{StaticResource SettingsFullRowTileStyle}">
                        <StackPanel>

                            <!-- License status strip (compact — full card lives on the About page) -->
                            <Border Padding="10,8"
                                    CornerRadius="{DynamicResource CardCornerRadius}"
                                    Background="{DynamicResource MenuHoverBrush}"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontSize="12" FontWeight="SemiBold">
                                            <Run Text="License: "/>
                                            <Run Text="{Binding LicenseStatus.StatusBadge, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding LicenseStatus.StatusDescription}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Full-width action row: buttons stretch evenly
                                 across the whole card. -->
                            <UniformGrid Columns="2" Style="{StaticResource SettingsActionRowStyle}">
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="REFRESH"
                                        Command="{Binding RefreshDatabaseHealthCommand}"
                                        HorizontalAlignment="Stretch"
                                        ToolTip="Probe every database and refresh the row-count table"/>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="REBUILD ALL DATABASES (EMERGENCY)"
                                        Command="{Binding RebuildAllDatabasesCommand}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0"
                                        ToolTip="Move every .db file to MigrationBackups and recreate at the current schema. Manager+ only."/>
                            </UniformGrid>

                            <ListBox ItemsSource="{Binding DatabaseHealthRows}"
                                     Margin="0,10,0,0"
                                     MaxHeight="240"
                                     BorderThickness="1"
                                     BorderBrush="{DynamicResource OutlineBrush}"
                                     Background="{DynamicResource MenuHoverBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       Text="{Binding Status}"/>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11"
                                                       Text="{Binding TotalRowsDisplay}"
                                                       TextAlignment="Right"/>
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       Text="{Binding FileSizeDisplay}"
                                                       TextAlignment="Right"/>
                                            <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="10"
                                                       TextWrapping="Wrap"
                                                       Margin="8,0,0,0"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       Text="{Binding DriftDisplay}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="{Binding DatabaseHealthStatus}"
                                       Style="{StaticResource SettingsTileFooterHintStyle}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
