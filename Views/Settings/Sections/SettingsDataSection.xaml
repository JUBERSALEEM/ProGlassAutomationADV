<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsDataSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — DATA & BACKUP page (tile-grid redesign Aug 2026)

     REDESIGN
       Was: three giant full-width cards stacked vertically (Backup &
       Restore, Sample Data, Database Health). Each card held its own
       full-width list/grid, so on a wide monitor 60% of horizontal
       space was empty and the page needed endless scrolling on a
       laptop.

       Now: the page is grouped into three labelled tile groups. Small,
       independent actions (backup actions / restore) sit side-by-side
       in 320-wide tiles; the backup set list lives in a wide tile; the
       database health grid keeps a full-row tile because inspecting a
       table needs the width. All 23 ViewModel bindings preserved.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsDataSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,26,32,14">
            <TextBlock Text="{DynamicResource Settings.SecData}" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="{DynamicResource Settings.ProtectProductionDataExploreSampleData}"
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}">
            <StackPanel Margin="32,0,32,32">

                <!-- ═══════ GROUP: COMPANY LAN / WI-FI DATABASE ═══════ -->
                <TextBlock Text="Company LAN / Wi-Fi Database"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="Connect all office workstations to one shared ProGlass data folder on the same network. Use a stable Windows/SMB shared folder, not a cloud-sync folder. Restart is required after changing this."
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <Border Style="{StaticResource SettingsFullRowTileStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                    <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE968;"/>
                                    <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{Binding DataRootModeDisplay}"/>
                                </StackPanel>
                                <CheckBox Content="Use shared company database folder"
                                          IsChecked="{Binding UseSharedDataRoot, Mode=TwoWay}"
                                          FontWeight="SemiBold"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,8,0,0"/>
                                <CheckBox Content="Copy current local data if shared folder is empty"
                                          IsChecked="{Binding CopyLocalDataOnEnable, Mode=TwoWay}"
                                          Foreground="{DynamicResource SecondaryForegroundBrush}"
                                          Margin="0,8,0,0"/>
                                <TextBlock Text="Current live root:"
                                           Style="{StaticResource SettingsTileFooterHintStyle}"
                                           Margin="0,10,0,0"/>
                                <TextBlock Text="{Binding CurrentDataRootDisplay}"
                                           FontSize="{StaticResource TextCaption}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Shared folder path (UNC recommended: \\SERVER\ProGlassData)"
                                           Style="{StaticResource SettingsTileCaptionStyle}"/>
                                <TextBox Text="{Binding SharedDataRootPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,7"
                                         FontSize="{StaticResource TextBody}"
                                         ToolTip="Example: \\Office-PC\ProGlassData or Z:\ProGlassData"/>
                                <TextBlock Text="Workstation name for support/audit"
                                           Style="{StaticResource SettingsTileCaptionStyle}"
                                           Margin="0,8,0,0"/>
                                <TextBox Text="{Binding WorkstationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,7"
                                         FontSize="{StaticResource TextBody}"/>

                                <UniformGrid Columns="3" Style="{StaticResource SettingsActionRowStyle}" Margin="0,10,0,0">
                                    <Button Style="{StaticResource SettingsActionButtonStyle}"
                                            Content="Test Connection"
                                            Command="{Binding TestSharedDataRootCommand}"
                                            HorizontalAlignment="Stretch"/>
                                    <Button Style="{StaticResource SettingsActionButtonStyle}"
                                            Content="Prepare Folder"
                                            Command="{Binding PrepareSharedDataRootCommand}"
                                            HorizontalAlignment="Stretch"/>
                                    <Button Style="{StaticResource SettingsActionButtonStyle}"
                                            Content="Save + Restart Required"
                                            Command="{Binding ApplySharedDataRootCommand}"
                                            HorizontalAlignment="Stretch"/>
                                </UniformGrid>
                            </StackPanel>
                        </Grid>

                        <Border CornerRadius="{DynamicResource CardCornerRadius}"
                                Background="{DynamicResource TintAmberBrush}"
                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                BorderThickness="{DynamicResource CardBorderThickness}"
                                Padding="10,8"
                                Margin="0,12,0,0">
                            <TextBlock Text="{Binding NetworkDataRootStatus}"
                                       TextWrapping="Wrap"
                                       FontSize="{StaticResource TextBody}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource WarningBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsGroupSeparatorStyle}"/>

                <!-- ═══════ GROUP: BACKUP & RESTORE ═══════ -->
                <TextBlock Text="{DynamicResource Settings.BackupRestore}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.BackupSetCopiesDatabaseSettingsOne}"
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <UniformGrid Columns="3" Margin="0,0,0,6">

                    <!-- Backup actions tile -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE74E;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.BackupActions}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.CreateBackupSetNowRefreshListOpenFolderWhere}"/>
                            <StackPanel>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="{DynamicResource Settings.CreateBackupNOW}"
                                        Command="{Binding CreateBackupNowCommand}"
                                        HorizontalAlignment="Stretch"/>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="{DynamicResource Action.Refresh}"
                                        Command="{Binding RefreshBackupsCommand}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,8,0,0"/>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="{DynamicResource About.OPENFolder}"
                                        Command="{Binding OpenBackupsFolderCommand}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Restore tile -->
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE895;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource ProformaInvoice.Restore}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.RestoreAlwaysSnapshotsCurrentDataFirstBad}"/>
                            <Button Style="{StaticResource SuccessPillButton}"
                                    Tag="&#xE895;" Content="{DynamicResource Settings.RestoreSelectedBackup}"
                                    Command="{Binding RestoreSelectedBackupCommand}"
                                    HorizontalAlignment="Stretch"/>
                            <TextBlock Text="{Binding BackupStatus}"
                                       Style="{StaticResource SettingsTileFooterHintStyle}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Backup sets list (wide tile) -->
                    <Border Style="{StaticResource SettingsWideTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8F7;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.BackupSets}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.PickSetRestoreSelectingEnoughRestoreButton}"/>
                            <ListBox ItemsSource="{Binding BackupSets}"
                                     SelectedItem="{Binding SelectedBackup}"
                                     MaxHeight="170"
                                     BorderThickness="{DynamicResource Border.HairlineThickness}"
                                     BorderBrush="{DynamicResource BorderDefaultBrush}"
                                     Background="{DynamicResource SurfaceTertiaryBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <TextBlock Text="&#xE968;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="{StaticResource TextBody}"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       IsHitTestVisible="False"/>
                                            <TextBlock VerticalAlignment="Center" FontSize="{StaticResource TextBody}"
                                                       IsHitTestVisible="False">
                                                <Run Text="{Binding CreatedAt, Mode=OneWay,
                                                             StringFormat='dd MMM yyyy  HH:mm'}"/>
                                                <Run Text="  •  "/>
                                                <Run Text="{Binding FileCount, Mode=OneWay}"/>
                                                <Run Text="{DynamicResource Settings.Files}"/>
                                                <Run Text="{Binding SizeDisplay, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <Border Style="{StaticResource SettingsGroupSeparatorStyle}"/>

                <!-- ═══════ GROUP: SAMPLE DATA ═══════ -->
                <TextBlock Text="{DynamicResource Settings.SampleDATA}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.NewHereLoadSmallLinkedDemoDatasetExplore}"
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <StackPanel Margin="0,0,0,6">
                    <Border Style="{StaticResource SettingsWideTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8A5;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.ExploreSampleData}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.6Sheets3Proformas2JobOrders2DeliveryNotes3}"/>
                            <!-- Full-width action row: buttons stretch evenly
                                 across the whole card. -->
                            <UniformGrid Columns="2" Style="{StaticResource SettingsActionRowStyle}" Margin="0,10,0,0">
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="{DynamicResource Settings.LOADSampleDATA}"
                                        Command="{Binding LoadSampleDataCommand}"
                                        HorizontalAlignment="Stretch"
                                        ToolTip="{DynamicResource Settings.SeedDemoDatasetEmptyDatabase}"/>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="{DynamicResource Settings.ClearDATA}"
                                        Command="{Binding ClearAllDataCommand}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0"
                                        ToolTip="{DynamicResource Settings.PermanentlyDeleteRecordModulesEGAfterTesting}"/>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}"
                                       Text="{DynamicResource Settings.DoneTestingUseClearDATAWipeDemoDatasetOne}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource SettingsGroupSeparatorStyle}"/>

                <!-- ═══════ GROUP: DATABASE HEALTH ═══════
                     Diagnostics + emergency rebuild. Probes every
                     database file (row counts, schema version, missing /
                     extra columns). The rebuild button is the nuclear
                     option gated behind Manager+ and typed confirmation. -->
                <TextBlock Text="{DynamicResource Settings.DatabaseHealth}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.ProbesProglassAutomationDatabaseFileAuto}"
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <StackPanel Margin="0,0,0,6">
                    <Border Style="{StaticResource SettingsFullRowTileStyle}">
                        <StackPanel>

                            <!-- License status strip (compact — full card lives on the About page) -->
                            <Border Padding="10,8"
                                    CornerRadius="{DynamicResource CardCornerRadius}"
                                    Background="{DynamicResource SurfaceTertiaryBrush}"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="{StaticResource TextBodyLarge}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontSize="{StaticResource TextBody}" FontWeight="SemiBold">
                                            <Run Text="{DynamicResource About.License}"/>
                                            <Run Text="{Binding LicenseStatus.StatusBadge, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding LicenseStatus.StatusDescription}"
                                                   FontSize="{StaticResource TextCaption}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Full-width action row: buttons stretch evenly
                                 across the whole card. -->
                            <UniformGrid Columns="2" Style="{StaticResource SettingsActionRowStyle}">
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="{DynamicResource Action.Refresh}"
                                        Command="{Binding RefreshDatabaseHealthCommand}"
                                        HorizontalAlignment="Stretch"
                                        ToolTip="{DynamicResource Settings.ProbeDatabaseRefreshRowCountTable}"/>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="{DynamicResource Settings.RebuildDatabasesEmergency}"
                                        Command="{Binding RebuildAllDatabasesCommand}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0"
                                        ToolTip="{DynamicResource Settings.MoveDbFileMigrationbackupsRecreateCurrent}"/>
                            </UniformGrid>

                            <ListBox ItemsSource="{Binding DatabaseHealthRows}"
                                     Margin="0,10,0,0"
                                     MaxHeight="240"
                                     BorderThickness="{DynamicResource Border.HairlineThickness}"
                                     BorderBrush="{DynamicResource BorderDefaultBrush}"
                                     Background="{DynamicResource SurfaceTertiaryBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="{StaticResource TextBody}"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{StaticResource TextBody}"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       Text="{Binding Status}"/>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="{StaticResource TextBody}"
                                                       Text="{Binding TotalRowsDisplay}"
                                                       TextAlignment="Right"/>
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="{StaticResource TextBody}"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       Text="{Binding FileSizeDisplay}"
                                                       TextAlignment="Right"/>
                                            <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="{StaticResource TextCaption}"
                                                       TextWrapping="Wrap"
                                                       Margin="8,0,0,0"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       Text="{Binding DriftDisplay}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="{Binding DatabaseHealthStatus}"
                                       Style="{StaticResource SettingsTileFooterHintStyle}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
