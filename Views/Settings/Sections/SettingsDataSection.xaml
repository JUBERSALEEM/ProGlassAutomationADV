<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsDataSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — DATA & BACKUP page (tile-grid redesign Aug 2026)
     REDESIGN
       Was: three giant full-width cards stacked vertically (Backup &
       Restore, Sample Data, Database Health). Each card held its own
       full-width list/grid, so on a wide monitor 60% of horizontal
       space was empty and the page needed endless scrolling on a
       laptop.
       Now: the page is grouped into three labelled tile groups. Small,
       independent actions (backup actions / restore) sit side-by-side
       in 320-wide tiles; the backup set list lives in a wide tile; the
       database health grid keeps a full-row tile because inspecting a
       table needs the width. All 23 ViewModel bindings preserved.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsDataSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cards="clr-namespace:ProGlassAutomation.Views.Settings.Sections.Cards"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}">
            <StackPanel Margin="{StaticResource SettingsPagePadding}">

                <!-- ═══ BENTO HERO BANNER — DATA & BACKUP ═══ -->
                <Border Style="{StaticResource SettingsPageCardStyle}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center">
                            <TextBlock Text="Data Management &amp; Automated Backups" Style="{StaticResource SettingsCardTitleStyle}"/>
                            <TextBlock Text="SQLite transaction logging, automated backup rotation, and schema integrity validation" Style="{StaticResource SettingsCardNoteStyle}"/>
                        </StackPanel>

                        <Border Grid.Column="2" Style="{StaticResource SettingsChipGreenStyle}" VerticalAlignment="Center">
                            <TextBlock Text="Verified Storage" Style="{StaticResource SettingsChipGreenTextStyle}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- ═══ CARD — COMPANY LAN / WI-FI DATABASE ═══ -->
                <cards:DataRootCard/>

                <!-- ═══ CARD — BACKUP & RESTORE ═══ -->
                <cards:DataBackupCard/>

                <!-- ═══ CARD — SAMPLE DATA ═══ -->
                <cards:DataSampleCard/>

                <!-- ═══ CARD — DATABASE HEALTH ═══ -->
                <cards:DataHealthCard/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
