<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsDataSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — DATA & BACKUP page

     Cards: backup & restore (full dataset sets) · sample data.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsDataSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,26,32,14">
            <TextBlock Text="Data &amp; Backup" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Protect your production data and explore with sample data."
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}">
            <StackPanel Margin="32,0,32,32">

                <!-- ── BACKUP & RESTORE ───────────────────────────── -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="BACKUP &amp; RESTORE"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Text="A backup set copies every database + settings into one timestamped folder. Automatic sets are created when the app closes; restore always takes a safety snapshot first."/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource PrimaryPillButton}"
                                    Tag="&#xE74E;" Content="CREATE BACKUP NOW"
                                    Command="{Binding CreateBackupNowCommand}"/>
                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Tag="&#xE72C;" Content="REFRESH"
                                    Command="{Binding RefreshBackupsCommand}"
                                    Margin="10,0,0,0"/>
                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Tag="&#xE8B7;" Content="OPEN FOLDER"
                                    Command="{Binding OpenBackupsFolderCommand}"
                                    Margin="10,0,0,0"/>
                        </StackPanel>

                        <ListBox ItemsSource="{Binding BackupSets}"
                                 SelectedItem="{Binding SelectedBackup}"
                                 Margin="0,12,0,0"
                                 MaxHeight="190"
                                 BorderThickness="1"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 Background="{DynamicResource MenuHoverBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <TextBlock Text="&#xE968;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        <TextBlock VerticalAlignment="Center" FontSize="12">
                                            <Run Text="{Binding CreatedAt, Mode=OneWay,
                                                         StringFormat='dd MMM yyyy  HH:mm'}"/>
                                            <Run Text="  •  "/>
                                            <Run Text="{Binding FileCount, Mode=OneWay}"/>
                                            <Run Text=" files  •  "/>
                                            <Run Text="{Binding SizeDisplay, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Style="{StaticResource SuccessPillButton}"
                                Tag="&#xE895;" Content="RESTORE SELECTED BACKUP"
                                Command="{Binding RestoreSelectedBackupCommand}"
                                Margin="0,10,0,0"/>

                        <TextBlock Text="{Binding BackupStatus}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Border>

                <!-- ── SAMPLE DATA — first-run learning aid ───────── -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="SAMPLE DATA"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock FontSize="11" TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Text="New here? Load a small demo dataset (6 sheets, 3 proformas, 2 job orders, 2 delivery notes, 3 tax invoices — all linked) to explore every module. Only available on an empty database; your real data is never touched."/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource PrimaryPillButton}"
                                    Tag="&#xE8A5;" Content="LOAD SAMPLE DATA"
                                    Command="{Binding LoadSampleDataCommand}"
                                    ToolTip="Seed the demo dataset on an empty database"/>
                            <Button Style="{StaticResource DangerButton}"
                                    Tag="&#xE74D;" Content="CLEAR ALL DATA"
                                    Command="{Binding ClearAllDataCommand}"
                                    Margin="10,0,0,0"
                                    ToolTip="Permanently delete every record in all modules (e.g. after testing with sample data)"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,8,0,0"
                                   Text="Done testing? Use CLEAR ALL DATA to wipe the demo dataset in one step and start entering real data."/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
