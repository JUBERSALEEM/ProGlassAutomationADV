<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsDemoSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — DEMO CENTER page (tile-grid redesign Aug 2026)
     REDESIGN
       Was: seven full-width cards stacked vertically. The RECORDING
       card alone held Quality + Frame rate + Audio + Microphone as
       four full-width rows, so two thirds of horizontal space was
       wasted on a wide monitor.
       Now: grouped into labelled tile groups. The four recording
       settings each become their own 320-wide tile so they reflow
       side-by-side; the FFMPEG troubleshooting card keeps a full row
       (a dozen buttons need the width); STATUS becomes a compact
       metric tile. All 46 ViewModel bindings preserved, including the
       conditional FFMPEG visibility (card only shows while missing,
       flips the inner ready/missing branches) and every
       AutomationProperties.AutomationId test anchor.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsDemoSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cards="clr-namespace:ProGlassAutomation.Views.Settings.Sections.Cards"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="{StaticResource SettingsPagePadding}">

                <!-- ═══════ GROUP: FFMPEG (conditional) ═══════ -->
                <cards:DemoFfmpegCard/>

                <Border Style="{StaticResource SettingsRowSeparatorStyle}"/>

                <!-- ═══ CARD — RECORD THIS SESSION ═══ -->
                <cards:DemoRecordCard/>

                <!-- ═══ CARD — RECORDING SETTINGS ═══ -->
                <cards:DemoQualityCard/>

                <!-- ═══ CARD — WORKFLOW ═══ -->
                <cards:DemoWorkflowCard/>

                <!-- ═══ CARD — ISOLATION ═══ -->
                <cards:DemoIsolationCard/>

                <!-- ═══ CARD — RESET DEMO DATA ═══
                     The destructive action is its own red card instead of the
                     third of three equal buttons (sheet 08): a destructive tap
                     should not sit one slip away from "Enter demo mode". -->
                <Border Style="{StaticResource SettingsDangerCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.ResetDEMOFolder}"
                                   Style="{StaticResource SettingsDangerCardTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Settings.ResetDeletesAppdataProglassautomationDemo}"
                                   Style="{StaticResource SettingsDangerCardNoteStyle}"/>
                        <Button Style="{StaticResource SettingsActionButtonStyle}"
                                Margin="{StaticResource SettingsStackGap4}"
                                HorizontalAlignment="Left"
                                Content="{DynamicResource Action.Reset}"
                                Command="{Binding ResetDemoCommand}"
                                AutomationProperties.AutomationId="Demo.ResetFolder"/>
                    </StackPanel>
                </Border>

                <!-- ═══ CARD — STATUS ═══ -->
                <cards:DemoHistoryCard/>

                <!-- ═══ CARD — HISTORY ═══ -->
                <cards:DemoOutputCard/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
