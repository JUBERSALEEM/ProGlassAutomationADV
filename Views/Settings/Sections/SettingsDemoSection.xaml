<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsDemoSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,26,32,14">
            <TextBlock Text="Demo Center" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Walks the live Proforma Invoice wizard — list, new invoice, company, client, project, grid, preview, save — then records a verified MP4. A screen change alone is not a demo."
                       Style="{StaticResource PageSubtitleStyle}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,0,32,32">
                <Border Style="{StaticResource SectionCardStyle}" CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="WORKFLOW" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Text="Module"
                                   Style="{StaticResource RowTitleStyle}"
                                   Margin="0,12,0,6"/>
                        <ComboBox ItemsSource="{Binding ModuleOptions}"
                                  SelectedItem="{Binding SelectedModule}"
                                  MinWidth="220"
                                  Padding="10,7"
                                  FontSize="13"/>
                        <TextBlock Text="Only Proforma Invoice has a recorded wizard. Other modules fail honestly instead of writing a storyboard."
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="0,8,0,0"/>
                        <WrapPanel Margin="0,16,0,0">
                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Content="GENERATE SELECTED"
                                    Command="{Binding GenerateSelectedCommand}"
                                    Margin="0,0,10,8"/>
                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Content="GENERATE ALL (PI ONLY)"
                                    Command="{Binding GenerateAllCommand}"
                                    Margin="0,0,10,8"/>
                            <Button Style="{StaticResource RowOutlinedButton}"
                                    Content="RETRY LAST"
                                    Command="{Binding RetryCommand}"
                                    Margin="0,0,10,8"/>
                            <Button Style="{StaticResource RowOutlinedButton}"
                                    Content="CANCEL"
                                    Command="{Binding CancelCommand}"
                                    Margin="0,0,10,8"/>
                            <Button Style="{StaticResource RowOutlinedButton}"
                                    Content="OPEN OUTPUT"
                                    Command="{Binding OpenOutputCommand}"
                                    Margin="0,0,10,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}" CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="ISOLATION" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Text="{Binding IsolationText}"
                                   Style="{StaticResource HintTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                        <WrapPanel Margin="0,14,0,0">
                            <Button Style="{StaticResource RowOutlinedButton}"
                                    Content="ENTER DEMO MODE"
                                    Command="{Binding EnterDemoCommand}"
                                    Margin="0,0,10,8"/>
                            <Button Style="{StaticResource RowOutlinedButton}"
                                    Content="EXIT DEMO MODE"
                                    Command="{Binding ExitDemoCommand}"
                                    Margin="0,0,10,8"/>
                            <Button Style="{StaticResource RowOutlinedButton}"
                                    Content="RESET DEMO FOLDER"
                                    Command="{Binding ResetDemoCommand}"
                                    Margin="0,0,10,8"/>
                        </WrapPanel>
                        <TextBlock Text="Reset deletes only %AppData%/ProGlassAutomation.Demo. Production files are never opened or cleared."
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}" CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="STATUS" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Text="{Binding StateText}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource HintTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding VerifiedText}"
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding LastMp4Text}"
                                   Style="{StaticResource HintTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding FfmpegStatus}"
                                   Style="{StaticResource HintTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}" CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="HISTORY" Style="{StaticResource SectionLabelStyle}"/>
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}">
                                            <Run Text="{Binding Module, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding State, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Status}"
                                                   Style="{StaticResource HintTextStyle}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
