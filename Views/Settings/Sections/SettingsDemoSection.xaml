<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsDemoSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — DEMO CENTER page (tile-grid redesign Aug 2026)

     REDESIGN
       Was: seven full-width cards stacked vertically. The RECORDING
       card alone held Quality + Frame rate + Audio + Microphone as
       four full-width rows, so two thirds of horizontal space was
       wasted on a wide monitor.

       Now: grouped into labelled tile groups. The four recording
       settings each become their own 320-wide tile so they reflow
       side-by-side; the FFMPEG troubleshooting card keeps a full row
       (a dozen buttons need the width); STATUS becomes a compact
       metric tile. All 46 ViewModel bindings preserved, including the
       conditional FFMPEG visibility (card only shows while missing,
       flips the inner ready/missing branches) and every
       AutomationProperties.AutomationId test anchor.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsDemoSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,26,32,14">
            <TextBlock Text="{DynamicResource Settings.SecDemo}" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="{DynamicResource Settings.ModuleRecordsLiveWalkProductionStagesReports}"
                       Style="{StaticResource PageSubtitleStyle}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,0,32,32">

                <!-- ═══════ GROUP: FFMPEG (conditional) ═══════ -->
                <Border Style="{StaticResource SettingsFullRowTileStyle}"
                        Visibility="{Binding IsFfmpegMissing,
                            Converter={StaticResource BoolToVisibilityConverter},
                            FallbackValue=Collapsed}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                            <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE7B8;"/>
                            <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.Ffmpeg}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding FfmpegStatus}"
                                   Style="{StaticResource SettingsTileCaptionStyle}"
                                   FontSize="{StaticResource TextBodyLarge}" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Style="{StaticResource SettingsTileCaptionStyle}">
                            <Run Text="{DynamicResource Settings.GenerateStartUntilFfmpegInstalledClick}"/>
                            <Run Text="{DynamicResource Settings.AppFetchesWindowsEssentialsZipChecksExtracts}"/>
                            <Run Text="{DynamicResource Settings.FfmpegExe}"/><Run Text="{DynamicResource Settings.And}"/><Run Text="{DynamicResource Settings.FfprobeExe}"/><Run Text="{DynamicResource Settings.ToolsFolderAutomaticallyThenRecheck}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding FfmpegDownloadUrl}"
                                   FontSize="{StaticResource TextBody}"
                                   FontFamily="Consolas"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>
                        <!-- Live download progress while the one-click
                             installer runs; hidden otherwise. -->
                        <Grid Margin="0,0,0,8"
                              Visibility="{Binding IsInstallingFfmpeg,
                                  Converter={StaticResource BoolToVisibilityConverter},
                                  FallbackValue=Collapsed}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar Grid.Column="0"
                                         Height="8"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding FfmpegDownloadPercent, Mode=OneWay}"
                                         Foreground="{DynamicResource AccentBrush}"
                                         VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Margin="10,0,0,0"
                                       FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Text="{Binding FfmpegDownloadPercent, Mode=OneWay,
                                           StringFormat={}{0:0}%}"/>
                        </Grid>
                        <TextBlock Text="{Binding FfmpegInstallHint}"
                                   Style="{StaticResource SettingsTileFooterHintStyle}"/>
                        <!-- Full-width action row: buttons stretch evenly. -->
                        <UniformGrid Columns="5" Style="{StaticResource SettingsActionRowStyle}" Margin="0,12,0,0">
                            <Button Style="{StaticResource SettingsActionButtonStyle}"
                                    Content="{DynamicResource Settings.DownloadInstallAutomatic}"
                                    Command="{Binding InstallFfmpegCommand}"
                                    AutomationProperties.AutomationId="DemoCenter.DownloadFfmpeg"
                                    HorizontalAlignment="Stretch"/>
                            <Button Style="{StaticResource SettingsActionButtonStyle}"
                                    Content="{DynamicResource Settings.OfficialFfmpegPAGE}"
                                    Command="{Binding OpenFfmpegPageCommand}"
                                    AutomationProperties.AutomationId="DemoCenter.FfmpegOfficial"
                                    HorizontalAlignment="Stretch"/>
                            <Button Style="{StaticResource SettingsActionButtonStyle}"
                                    Content="{DynamicResource Settings.COPYLINK}"
                                    Command="{Binding CopyFfmpegLinkCommand}"
                                    HorizontalAlignment="Stretch"/>
                            <Button Style="{StaticResource SettingsActionButtonStyle}"
                                    Content="{DynamicResource Settings.OPENToolsFolder}"
                                    Command="{Binding OpenToolsFolderCommand}"
                                    HorizontalAlignment="Stretch"/>
                            <Button Style="{StaticResource SettingsActionButtonStyle}"
                                    Content="{DynamicResource Settings.Recheck}"
                                    Command="{Binding RecheckFfmpegCommand}"
                                    AutomationProperties.AutomationId="DemoCenter.RecheckFfmpeg"
                                    HorizontalAlignment="Stretch"
                                    Margin="0"/>
                        </UniformGrid>
                        <TextBlock Text="{DynamicResource Settings.FfmpegReadyGenerateSelectedRecordModuleWrite}"
                                   Style="{StaticResource SettingsTileFooterHintStyle}"
                                   Visibility="{Binding IsFfmpegReady,
                                       Converter={StaticResource BoolToVisibilityConverter},
                                       FallbackValue=Collapsed}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsGroupSeparatorStyle}"/>

                <!-- ═══════ GROUP: RECORD THIS SESSION ═══════ -->
                <TextBlock Text="{DynamicResource Settings.RecordSession2}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.RecordRunningAppWindowWithoutModuleWorkflow}"
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <StackPanel Margin="0,0,0,6">
                    <Border Style="{StaticResource SettingsWideTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE714;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.RecordSession}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SessionRecordHint}"
                                       Style="{StaticResource SettingsTileCaptionStyle}"/>
                            <TextBlock Text="{Binding SessionRecordStatus}"
                                       Style="{StaticResource SettingsTileFooterHintStyle}"/>
                            <!-- Full-width primary action row. The two conditional
                                 buttons are auto columns that collapse to 0 when
                                 hidden, so the visible button(s) fill the row. -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="{DynamicResource Settings.StartRecording}"
                                        Command="{Binding StartSessionRecordCommand}"
                                        AutomationProperties.AutomationId="DemoCenter.StartSessionRecord"
                                        Visibility="{Binding IsSessionIdle,
                                            Converter={StaticResource BoolToVisibilityConverter}}"
                                        HorizontalAlignment="Stretch"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="{DynamicResource Settings.STOPSAVE}"
                                        Command="{Binding StopSessionRecordCommand}"
                                        AutomationProperties.AutomationId="DemoCenter.StopSessionRecord"
                                        Visibility="{Binding IsSessionRecording,
                                            Converter={StaticResource BoolToVisibilityConverter}}"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Stretch"/>
                                <Button Grid.Column="2"
                                        Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="{DynamicResource Settings.OPENRecordings}"
                                        Command="{Binding OpenRecordingsCommand}"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Stretch"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource SettingsGroupSeparatorStyle}"/>

                <!-- ═══════ GROUP: RECORDING SETTINGS ═══════ -->
                <TextBlock Text="{DynamicResource Settings.RecordingSettings}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.CapturesRunningAppWindowDesktopOtherPrograms}"
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <UniformGrid Columns="3" Margin="0,0,0,6">
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE7F8;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.Quality}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.OutputResolutionRecordedVideo}"/>
                            <ComboBox ItemsSource="{Binding Qualities}"
                                      SelectedItem="{Binding SelectedQuality, Mode=TwoWay}"
                                      DisplayMemberPath="Title"
                                      IsSynchronizedWithCurrentItem="False"
                                      MinWidth="200"
                                      Padding="10,7"
                                      FontSize="{StaticResource TextBodyLarge}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE823;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.FrameRate}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.HowManyFramesSecondCaptured}"/>
                            <ComboBox ItemsSource="{Binding FpsChoices}"
                                      SelectedItem="{Binding SelectedFps, Mode=TwoWay}"
                                      DisplayMemberPath="Title"
                                      IsSynchronizedWithCurrentItem="False"
                                      MinWidth="160"
                                      Padding="10,7"
                                      FontSize="{StaticResource TextBodyLarge}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE767;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.InternalAudio}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.CaptureAppNarrationSoundRunningApp}"/>
                            <ToggleButton Grid.Row="3"
                                          HorizontalAlignment="Left"
                                          IsChecked="{Binding CaptureLiveAudio, Mode=TwoWay}"
                                          Style="{StaticResource ModernToggleSwitch}"
                                          AutomationProperties.AutomationId="DemoCenter.CaptureAudio"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE77B;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.Microphone}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="{DynamicResource Settings.CaptureLiveSpokenNarrationMicrophone}"/>
                            <ToggleButton Grid.Row="3"
                                          HorizontalAlignment="Left"
                                          IsChecked="{Binding CaptureMicrophone, Mode=TwoWay}"
                                          Style="{StaticResource ModernToggleSwitch}"
                                          AutomationProperties.AutomationId="DemoCenter.CaptureMic"/>
                        </Grid>
                    </Border>
                </UniformGrid>

                <TextBlock Text="{Binding RecordHint}"
                           Style="{StaticResource SettingsGroupCaptionStyle}"
                           Margin="0,0,0,6"/>

                <Border Style="{StaticResource SettingsGroupSeparatorStyle}"/>

                <!-- ═══════ GROUP: WORKFLOW ═══════ -->
                <TextBlock Text="{DynamicResource Inquiry.Workflow}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.PickModuleGenerateLandsWorkspaceFirstVoice}"
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <StackPanel Margin="0,0,0,6">
                    <Border Style="{StaticResource SettingsWideTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE896;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.Module}"/>
                            </StackPanel>
                            <!-- 2026-08-25 senior fix: the dropdown showed
                                 "ProGlassAutomation.Agent.Demo.DemoWorkflow"
                                 type names. DisplayMemberPath alone proved
                                 fragile, so an explicit ItemTemplate renders
                                 the Title. NOTE: DisplayMemberPath and
                                 ItemTemplate must NOT both be set — WPF
                                 throws InvalidOperationException at item
                                 generation when they are, which killed the
                                 whole Settings page (blank screen). -->
                            <ComboBox ItemsSource="{Binding Modules}"
                                      SelectedItem="{Binding SelectedWorkflow, Mode=TwoWay}"
                                      IsSynchronizedWithCurrentItem="False"
                                      MinWidth="260"
                                      Padding="10,7"
                                      FontSize="{StaticResource TextBodyLarge}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding SelectedPurpose}"
                                       Style="{StaticResource SettingsTileFooterHintStyle}"/>
                            <TextBlock Text="{Binding WorkflowHint}"
                                       Style="{StaticResource SettingsTileFooterHintStyle}"/>
                            <!-- Full-width action row: buttons stretch evenly. -->
                            <UniformGrid Columns="5" Style="{StaticResource SettingsActionRowStyle}" Margin="0,12,0,0">
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="{DynamicResource Settings.GenerateSelected}"
                                        Command="{Binding GenerateSelectedCommand}"
                                        AutomationProperties.AutomationId="DemoCenter.GenerateSelected"
                                        HorizontalAlignment="Stretch"/>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="{DynamicResource Settings.GenerateModules}"
                                        Command="{Binding GenerateAllCommand}"
                                        AutomationProperties.AutomationId="DemoCenter.GenerateAll"
                                        HorizontalAlignment="Stretch"/>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="{DynamicResource Settings.RetryLAST}"
                                        Command="{Binding RetryCommand}"
                                        HorizontalAlignment="Stretch"/>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="{DynamicResource Action.Cancel}"
                                        Command="{Binding CancelCommand}"
                                        HorizontalAlignment="Stretch"/>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="{DynamicResource Settings.OPENOutput}"
                                        Command="{Binding OpenOutputCommand}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource SettingsGroupSeparatorStyle}"/>

                <!-- ═══════ GROUP: ISOLATION ═══════ -->
                <TextBlock Text="{DynamicResource Settings.Isolation}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.DemoModeKeepsProductionDataUntouchedWhile}"
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <StackPanel Margin="0,0,0,6">
                    <Border Style="{StaticResource SettingsWideTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE7EB;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.DemoMode}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding IsolationText}"
                                       Style="{StaticResource SettingsTileCaptionStyle}"/>
                            <!-- Full-width action row: buttons stretch evenly. -->
                            <UniformGrid Columns="3" Style="{StaticResource SettingsActionRowStyle}" Margin="0,10,0,0">
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="{DynamicResource Settings.EnterDEMOMODE}"
                                        Command="{Binding EnterDemoCommand}"
                                        HorizontalAlignment="Stretch"/>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="{DynamicResource Settings.EXITDEMOMODE}"
                                        Command="{Binding ExitDemoCommand}"
                                        HorizontalAlignment="Stretch"/>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                        Content="{DynamicResource Settings.ResetDEMOFolder}"
                                        Command="{Binding ResetDemoCommand}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0"/>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource SettingsTileFooterHintStyle}"
                                       Text="{DynamicResource Settings.ResetDeletesAppdataProglassautomationDemo}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource SettingsGroupSeparatorStyle}"/>

                <!-- ═══════ GROUP: STATUS ═══════ -->
                <TextBlock Text="{DynamicResource Common.Status}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.WhatLastRunDidWhereOutput}"
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <UniformGrid Columns="2" Margin="0,0,0,6">
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE9D2;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.State}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding StateText}"
                                       Style="{StaticResource SettingsTileHeroStyle}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding StatusText}"
                                       Style="{StaticResource SettingsTileCaptionStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding VerifiedText}"
                                       Style="{StaticResource SettingsTileFooterHintStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE7C1;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="{DynamicResource Settings.LastOutput}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LastMp4Text}"
                                       Style="{StaticResource SettingsTileCaptionStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding FfmpegStatus}"
                                       Style="{StaticResource SettingsTileFooterHintStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource SettingsGroupSeparatorStyle}"/>

                <!-- ═══════ GROUP: HISTORY ═══════ -->
                <TextBlock Text="{DynamicResource DeliveryNote.History}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="{DynamicResource Settings.LedgerRecordingJobRunMachine}"
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <StackPanel Margin="0,0,0,6">
                    <Border Style="{StaticResource SettingsFullRowTileStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings.NoJobsYetGenerateSelectedGenerateStart}"
                                       Style="{StaticResource SettingsTileCaptionStyle}"
                                       Visibility="{Binding HasHistory,
                                           Converter={StaticResource InverseBoolToVisibilityConverter},
                                           FallbackValue=Visible}"/>
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                                <Run Text="{Binding Module, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding State, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       FontSize="{StaticResource TextBody}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
