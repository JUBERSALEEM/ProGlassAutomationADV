<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsDemoSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — DEMO CENTER page (tile-grid redesign Aug 2026)
     REDESIGN
       Was: seven full-width cards stacked vertically. The RECORDING
       card alone held Quality + Frame rate + Audio + Microphone as
       four full-width rows, so two thirds of horizontal space was
       wasted on a wide monitor.
       Now: grouped into labelled tile groups. The four recording
       settings each become their own 320-wide tile so they reflow
       side-by-side; the FFMPEG troubleshooting card keeps a full row
       (a dozen buttons need the width); STATUS becomes a compact
       metric tile. All 46 ViewModel bindings preserved, including the
       conditional FFMPEG visibility (card only shows while missing,
       flips the inner ready/missing branches) and every
       AutomationProperties.AutomationId test anchor.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsDemoSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="{StaticResource SettingsPagePadding}">

                <!-- ═══════ GROUP: FFMPEG (conditional) ═══════ -->
                <Border Style="{StaticResource SettingsPageCardStyle}"
                        Visibility="{Binding IsFfmpegMissing,
                            Converter={StaticResource BoolToVisibilityConverter},
                            FallbackValue=Collapsed}">
                    <StackPanel>
                        <Border 
        Style="{StaticResource SettingsInnerTileStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE7B8;"/>
                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center" Text="{DynamicResource Settings.Ffmpeg}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding FfmpegStatus}"
                                   Style="{StaticResource SettingsRowMetaStyle}"
                                   FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Style="{StaticResource SettingsRowMetaStyle}">
                            <Run Text="{DynamicResource Settings.GenerateStartUntilFfmpegInstalledClick}"/>
                            <Run Text="{DynamicResource Settings.AppFetchesWindowsEssentialsZipChecksExtracts}"/>
                            <Run Text="{DynamicResource Settings.FfmpegExe}"/><Run Text="{DynamicResource Settings.And}"/><Run Text="{DynamicResource Settings.FfprobeExe}"/><Run Text="{DynamicResource Settings.ToolsFolderAutomaticallyThenRecheck}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding FfmpegDownloadUrl}"
                                   FontSize="{DynamicResource FontSize.Body}"
                                   FontFamily="{DynamicResource FontFamily.Code}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap"
                                   Margin="{StaticResource SettingsStackBottom8}"/>
                        <!-- Live download progress while the one-click
                             installer runs; hidden otherwise. -->
                        <Grid Margin="{StaticResource SettingsStackBottom8}"
                              Visibility="{Binding IsInstallingFfmpeg,
                                  Converter={StaticResource BoolToVisibilityConverter},
                                  FallbackValue=Collapsed}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar Grid.Column="0"
                                         Height="8"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding FfmpegDownloadPercent, Mode=OneWay}"
                                         Foreground="{DynamicResource AccentBrush}"
                                         VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Margin="{StaticResource SettingsIconTextMargin}"
                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Text="{Binding FfmpegDownloadPercent, Mode=OneWay,
                                           StringFormat={}{0:0}%}"/>
                        </Grid>
                        <TextBlock Text="{Binding FfmpegInstallHint}"
                                   Style="{StaticResource SettingsRowMetaStyle}"/>
                        <!-- Full-width action row: buttons stretch evenly. -->
                        <Border Margin="{StaticResource SettingsStackGap12}"
        Style="{StaticResource SurfacePanelTileStyle}">
                            <UniformGrid Columns="5">
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                    Content="{DynamicResource Settings.DownloadInstallAutomatic}"
                                    Command="{Binding InstallFfmpegCommand}"
                                    AutomationProperties.AutomationId="DemoCenter.DownloadFfmpeg"
                                    HorizontalAlignment="Stretch"/>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                    Content="{DynamicResource Settings.OfficialFfmpegPAGE}"
                                    Command="{Binding OpenFfmpegPageCommand}"
                                    AutomationProperties.AutomationId="DemoCenter.FfmpegOfficial"
                                    HorizontalAlignment="Stretch"/>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                    Content="{DynamicResource Settings.COPYLINK}"
                                    Command="{Binding CopyFfmpegLinkCommand}"
                                    HorizontalAlignment="Stretch"/>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                    Content="{DynamicResource Settings.OPENToolsFolder}"
                                    Command="{Binding OpenToolsFolderCommand}"
                                    HorizontalAlignment="Stretch"/>
                                <Button Style="{StaticResource SettingsActionButtonStyle}"
                                    Content="{DynamicResource Settings.Recheck}"
                                    Command="{Binding RecheckFfmpegCommand}"
                                    AutomationProperties.AutomationId="DemoCenter.RecheckFfmpeg"
                                    HorizontalAlignment="Stretch"
                                    Margin="0"/>
                            </UniformGrid>
                        </Border>
                        <TextBlock Text="{DynamicResource Settings.FfmpegReadyGenerateSelectedRecordModuleWrite}"
                                   Style="{StaticResource SettingsRowMetaStyle}"
                                   Visibility="{Binding IsFfmpegReady,
                                       Converter={StaticResource BoolToVisibilityConverter},
                                       FallbackValue=Collapsed}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsRowSeparatorStyle}"/>

                <!-- ═══ CARD — RECORD THIS SESSION ═══ -->
                <Border Style="{StaticResource SettingsPageCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.RecordSession2}"
                                   Style="{StaticResource SettingsCardTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Settings.RecordRunningAppWindowWithoutModuleWorkflow}"
                                   Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                        <StackPanel Margin="{StaticResource SettingsRowMargin}">
                            <Border Style="{StaticResource SettingsInnerTileStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE714;"/>
                                        <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center" Text="{DynamicResource Settings.RecordSession}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SessionRecordHint}"
                                               Style="{StaticResource SettingsRowMetaStyle}"/>
                                    <TextBlock Text="{Binding SessionRecordStatus}"
                                               Style="{StaticResource SettingsRowMetaStyle}"/>
                                    <!-- Full-width primary action row. The two conditional
                                         buttons are auto columns that collapse to 0 when
                                         hidden, so the visible button(s) fill the row. -->
                                    <Grid Margin="{StaticResource SettingsStackGap10}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Style="{StaticResource SettingsActionButtonStyle}"
                                                Content="{DynamicResource Settings.StartRecording}"
                                                Command="{Binding StartSessionRecordCommand}"
                                                AutomationProperties.AutomationId="DemoCenter.StartSessionRecord"
                                                Visibility="{Binding IsSessionIdle,
                                                    Converter={StaticResource BoolToVisibilityConverter}}"
                                                HorizontalAlignment="Stretch"/>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource SettingsActionButtonStyle}"
                                                Content="{DynamicResource Settings.STOPSAVE}"
                                                Command="{Binding StopSessionRecordCommand}"
                                                AutomationProperties.AutomationId="DemoCenter.StopSessionRecord"
                                                Visibility="{Binding IsSessionRecording,
                                                    Converter={StaticResource BoolToVisibilityConverter}}"
                                                Margin="{StaticResource SettingsIconTextMargin}"
                                                HorizontalAlignment="Stretch"/>
                                        <Button Grid.Column="2"
                                                Style="{StaticResource SettingsActionButtonStyle}"
                                                Content="{DynamicResource Settings.OPENRecordings}"
                                                Command="{Binding OpenRecordingsCommand}"
                                                Margin="{StaticResource SettingsIconTextMargin}"
                                                HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- ═══ CARD — RECORDING SETTINGS ═══ -->
                <Border Style="{StaticResource SettingsPageCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.RecordingSettings}"
                                   Style="{StaticResource SettingsCardTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Settings.CapturesRunningAppWindowDesktopOtherPrograms}"
                                   Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                        <UniformGrid Columns="3" Margin="{StaticResource SettingsRowMargin}">
                            <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE7F8;"/>
                                        <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center" Text="{DynamicResource Settings.Quality}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                               Text="{DynamicResource Settings.OutputResolutionRecordedVideo}"/>
                                    <ComboBox ItemsSource="{Binding Qualities}"
                                              SelectedItem="{Binding SelectedQuality, Mode=TwoWay}"
                                              DisplayMemberPath="Title"
                                              IsSynchronizedWithCurrentItem="False"
                                              MinWidth="200"
                                              Padding="10,7"
                                              FontSize="{DynamicResource FontSize.Title}" Style="{StaticResource ComboBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE823;"/>
                                        <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center" Text="{DynamicResource Settings.FrameRate}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                               Text="{DynamicResource Settings.HowManyFramesSecondCaptured}"/>
                                    <ComboBox ItemsSource="{Binding FpsChoices}"
                                              SelectedItem="{Binding SelectedFps, Mode=TwoWay}"
                                              DisplayMemberPath="Title"
                                              IsSynchronizedWithCurrentItem="False"
                                              MinWidth="160"
                                              Padding="10,7"
                                              FontSize="{DynamicResource FontSize.Title}" Style="{StaticResource ComboBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE767;"/>
                                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource Settings.InternalAudio}"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Grid.Row="1"
                                               Style="{StaticResource SettingsRowMetaStyle}"
                                               Text="{DynamicResource Settings.CaptureAppNarrationSoundRunningApp}"/>
                                    <ToggleButton Grid.Row="3"
                                                  HorizontalAlignment="Left"
                                                  IsChecked="{Binding CaptureLiveAudio, Mode=TwoWay}"
                                                  Style="{StaticResource ModernToggleSwitch}"
                                                  AutomationProperties.AutomationId="DemoCenter.CaptureAudio"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsInnerTileStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE77B;"/>
                                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource Settings.Microphone}"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Grid.Row="1"
                                               Style="{StaticResource SettingsRowMetaStyle}"
                                               Text="{DynamicResource Settings.CaptureLiveSpokenNarrationMicrophone}"/>
                                    <ToggleButton Grid.Row="3"
                                                  HorizontalAlignment="Left"
                                                  IsChecked="{Binding CaptureMicrophone, Mode=TwoWay}"
                                                  Style="{StaticResource ModernToggleSwitch}"
                                                  AutomationProperties.AutomationId="DemoCenter.CaptureMic"/>
                                </Grid>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="{Binding RecordHint}"
                                   Style="{StaticResource SettingsRowMetaStyle}"
                                   Margin="{StaticResource SettingsRowMargin}"/>

                        <Border Style="{StaticResource SettingsRowSeparatorStyle}"/>
                    </StackPanel>
                </Border>

                <!-- ═══ CARD — WORKFLOW ═══ -->
                <Border Style="{StaticResource SettingsPageCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Inquiry.Workflow}"
                                   Style="{StaticResource SettingsCardTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Settings.PickModuleGenerateLandsWorkspaceFirstVoice}"
                                   Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                        <StackPanel Margin="{StaticResource SettingsRowMargin}">
                            <Border Style="{StaticResource SettingsInnerTileStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE896;"/>
                                        <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center" Text="{DynamicResource Settings.Module}"/>
                                    </StackPanel>
                                    <!-- 2026-08-25 senior fix: the dropdown showed
                                         "ProGlassAutomation.Agent.Demo.DemoWorkflow"
                                         type names. DisplayMemberPath alone proved
                                         fragile, so an explicit ItemTemplate renders
                                         the Title. NOTE: DisplayMemberPath and
                                         ItemTemplate must NOT both be set — WPF
                                         throws InvalidOperationException at item
                                         generation when they are, which killed the
                                         whole Settings page (blank screen). -->
                                    <ComboBox ItemsSource="{Binding Modules}"
                                              SelectedItem="{Binding SelectedWorkflow, Mode=TwoWay}"
                                              IsSynchronizedWithCurrentItem="False"
                                              MinWidth="260"
                                              Padding="10,7"
                                              FontSize="{DynamicResource FontSize.Title}" Style="{StaticResource ComboBoxStyle}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="{Binding SelectedPurpose}"
                                               Style="{StaticResource SettingsRowMetaStyle}"/>
                                    <TextBlock Text="{Binding WorkflowHint}"
                                               Style="{StaticResource SettingsRowMetaStyle}"/>
                                    <!-- Full-width action row: buttons stretch evenly. -->
                                    <Border Margin="{StaticResource SettingsStackGap12}"
                Style="{StaticResource SurfacePanelTileStyle}">
                                        <UniformGrid Columns="5">
                                            <Button Style="{StaticResource SettingsActionButtonStyle}"
                                                Content="{DynamicResource Settings.GenerateSelected}"
                                                Command="{Binding GenerateSelectedCommand}"
                                                AutomationProperties.AutomationId="DemoCenter.GenerateSelected"
                                                HorizontalAlignment="Stretch"/>
                                            <Button Style="{StaticResource SettingsActionButtonStyle}"
                                                Content="{DynamicResource Settings.GenerateModules}"
                                                Command="{Binding GenerateAllCommand}"
                                                AutomationProperties.AutomationId="DemoCenter.GenerateAll"
                                                HorizontalAlignment="Stretch"/>
                                            <Button Style="{StaticResource SettingsActionButtonStyle}"
                                                Content="{DynamicResource Settings.RetryLAST}"
                                                Command="{Binding RetryCommand}"
                                                HorizontalAlignment="Stretch"/>
                                            <Button Style="{StaticResource SettingsActionButtonStyle}"
                                                Content="{DynamicResource Action.Cancel}"
                                                Command="{Binding CancelCommand}"
                                                HorizontalAlignment="Stretch"/>
                                            <Button Style="{StaticResource SettingsActionButtonStyle}"
                                                Content="{DynamicResource Settings.OPENOutput}"
                                                Command="{Binding OpenOutputCommand}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0"/>
                                        </UniformGrid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Style="{StaticResource SettingsRowSeparatorStyle}"/>
                    </StackPanel>
                </Border>

                <!-- ═══ CARD — ISOLATION ═══ -->
                <Border Style="{StaticResource SettingsPageCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.Isolation}"
                                   Style="{StaticResource SettingsCardTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Settings.DemoModeKeepsProductionDataUntouchedWhile}"
                                   Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                        <StackPanel Margin="{StaticResource SettingsRowMargin}">
                            <Border Style="{StaticResource SettingsInnerTileStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE7EB;"/>
                                        <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center" Text="{DynamicResource Settings.DemoMode}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding IsolationText}"
                                               Style="{StaticResource SettingsRowMetaStyle}"/>
                                    <!-- Full-width action row: buttons stretch evenly. -->
                                    <Border Margin="{StaticResource SettingsStackGap10}"
                Style="{StaticResource SurfacePanelTileStyle}">
                                        <UniformGrid Columns="2">
                                            <Button Style="{StaticResource SettingsActionButtonStyle}"
                                                Content="{DynamicResource Settings.EnterDEMOMODE}"
                                                Command="{Binding EnterDemoCommand}"
                                                HorizontalAlignment="Stretch"/>
                                            <Button Style="{StaticResource SettingsActionButtonStyle}"
                                                Content="{DynamicResource Settings.EXITDEMOMODE}"
                                                Command="{Binding ExitDemoCommand}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0"/>
                                        </UniformGrid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Style="{StaticResource SettingsRowSeparatorStyle}"/>
                    </StackPanel>
                </Border>

                <!-- ═══ CARD — RESET DEMO DATA ═══
                     The destructive action is its own red card instead of the
                     third of three equal buttons (sheet 08): a destructive tap
                     should not sit one slip away from "Enter demo mode". -->
                <Border Style="{StaticResource SettingsDangerCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.ResetDEMOFolder}"
                                   Style="{StaticResource SettingsDangerCardTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Settings.ResetDeletesAppdataProglassautomationDemo}"
                                   Style="{StaticResource SettingsDangerCardNoteStyle}"/>
                        <Button Style="{StaticResource SettingsActionButtonStyle}"
                                Margin="{StaticResource SettingsStackGap4}"
                                HorizontalAlignment="Left"
                                Content="{DynamicResource Action.Reset}"
                                Command="{Binding ResetDemoCommand}"
                                AutomationProperties.AutomationId="Demo.ResetFolder"/>
                    </StackPanel>
                </Border>

                <!-- ═══ CARD — STATUS ═══ -->
                <Border Style="{StaticResource SettingsPageCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Common.Status}"
                                   Style="{StaticResource SettingsCardTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Settings.WhatLastRunDidWhereOutput}"
                                   Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                        <UniformGrid Columns="2" Margin="{StaticResource SettingsRowMargin}">
                            <Border Style="{StaticResource SettingsInnerTileStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE9D2;"/>
                                        <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center" Text="{DynamicResource Settings.State}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding StateText}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding StatusText}"
                                               Style="{StaticResource SettingsRowMetaStyle}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding VerifiedText}"
                                               Style="{StaticResource SettingsRowMetaStyle}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsInnerTileStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE7C1;"/>
                                        <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center" Text="{DynamicResource Settings.LastOutput}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding LastMp4Text}"
                                               Style="{StaticResource SettingsRowMetaStyle}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding FfmpegStatus}"
                                               Style="{StaticResource SettingsRowMetaStyle}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource SettingsRowSeparatorStyle}"/>
                    </StackPanel>
                </Border>

                <!-- ═══ CARD — HISTORY ═══ -->
                <Border Style="{StaticResource SettingsPageCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource DeliveryNote.History}"
                                   Style="{StaticResource SettingsCardTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Settings.LedgerRecordingJobRunMachine}"
                                   Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                        <StackPanel Margin="{StaticResource SettingsRowMargin}">
                            <Border Style="{StaticResource SettingsInnerTileStyle}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings.NoJobsYetGenerateSelectedGenerateStart}"
                                               Style="{StaticResource SettingsRowMetaStyle}"
                                               Visibility="{Binding HasHistory,
                                                   Converter={StaticResource InverseBoolToVisibilityConverter},
                                                   FallbackValue=Visible}"/>
                                    <ItemsControl ItemsSource="{Binding History}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="{StaticResource SettingsStackBottom10}">
                                                    <TextBlock FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}">
                                                        <Run Text="{Binding Module, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding State, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Status}"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               FontSize="{DynamicResource FontSize.Body}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
