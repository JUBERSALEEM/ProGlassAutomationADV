<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsDemoSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — DEMO CENTER page (Full Light Studio Bento redesign)
     Visual source of truth: mockups/v4-08-demo.png
     Preserves all bindings to SettingsViewModel while elevating the
     layout hierarchy, card grammar, spacing, and typography ladder.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsDemoSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cards="clr-namespace:ProGlassAutomation.Views.Settings.Sections.Cards"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             RenderOptions.ClearTypeHint="Enabled"
             RenderOptions.EdgeMode="Aliased">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      behaviors:SmoothScrollBehavior.IsEnabled="True">
            <StackPanel Margin="{StaticResource SettingsPagePadding}">

                <!-- ═══ BENTO HERO BANNER — DEMO & RECORDER ═══ -->
                <Border Style="{StaticResource SettingsHeroCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SettingsHeroIconTileStyle}">
                            <TextBlock Text="&#xE714;" Style="{StaticResource SettingsHeroIconGlyphStyle}"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center">
                            <TextBlock Text="Demo Studio &amp; Screen Recorder" Style="{StaticResource SettingsHeroTitleStyle}"/>
                            <TextBlock Text="FFmpeg hardware encoding, session isolation sandbox, and video capture" Style="{StaticResource SettingsHeroNoteStyle}"/>
                        </StackPanel>

                        <Border Grid.Column="2" Style="{StaticResource SettingsHeroBadgeStyle}">
                            <TextBlock Text="1080p 60fps" Style="{StaticResource SettingsHeroBadgeTextStyle}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- ═══════ GROUP: FFMPEG (conditional) ═══════ -->
                <cards:DemoFfmpegCard/>

                <Border Style="{StaticResource SettingsRowSeparatorStyle}"/>

                <!-- ═══ BENTO ROW — RECORDING CONTROLS & SETTINGS ═══ -->
                <Grid Margin="{StaticResource SettingsBentoRowMargin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <cards:DemoRecordCard Grid.Column="0" Margin="{StaticResource SettingsBentoColLeft}" VerticalAlignment="Top"/>
                    <cards:DemoQualityCard Grid.Column="1" Margin="{StaticResource SettingsBentoColRight}" VerticalAlignment="Top"/>
                </Grid>

                <!-- ═══ BENTO ROW — WORKFLOW & ISOLATION ═══ -->
                <Grid Margin="{StaticResource SettingsBentoRowMargin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <cards:DemoWorkflowCard Grid.Column="0" Margin="{StaticResource SettingsBentoColLeft}" VerticalAlignment="Top"/>
                    <cards:DemoIsolationCard Grid.Column="1" Margin="{StaticResource SettingsBentoColRight}" VerticalAlignment="Top"/>
                </Grid>

                <!-- ═══ CARD — RESET DEMO DATA ═══ -->
                <Border Style="{StaticResource SettingsDangerCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.ResetDEMOFolder}"
                                   Style="{StaticResource SettingsDangerCardTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Settings.ResetDeletesAppdataProglassautomationDemo}"
                                   Style="{StaticResource SettingsDangerCardNoteStyle}"/>
                        <Button Style="{StaticResource SettingsActionButtonStyle}"
                                Margin="{StaticResource SettingsStackGap4}"
                                HorizontalAlignment="Left"
                                Content="{DynamicResource Action.Reset}"
                                Command="{Binding ResetDemoCommand}"
                                AutomationProperties.AutomationId="Demo.ResetFolder"/>
                    </StackPanel>
                </Border>

                <!-- ═══ BENTO ROW — STATUS & OUTPUT HISTORY ═══ -->
                <Grid Margin="{StaticResource SettingsBentoRowMargin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <cards:DemoHistoryCard Grid.Column="0" Margin="{StaticResource SettingsBentoColLeft}" VerticalAlignment="Top"/>
                    <cards:DemoOutputCard Grid.Column="1" Margin="{StaticResource SettingsBentoColRight}" VerticalAlignment="Top"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>