<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsDemoSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,26,32,14">
            <TextBlock Text="Demo Center" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Each module records a live walk — Sheet Store, Proforma 1–9, Job Order, Delivery Note, Tax Invoice, Statements, Users, Company, Dashboard, Profitability — then a verified MP4. Activity is the real audit tab on JO / DN / TI."
                       Style="{StaticResource PageSubtitleStyle}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,0,32,32">

                <Border Style="{StaticResource SectionCardStyle}"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Visibility="{Binding IsFfmpegMissing,
                            Converter={StaticResource BoolToVisibilityConverter},
                            FallbackValue=Collapsed}">
                    <StackPanel>
                        <TextBlock Text="FFMPEG" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Text="{Binding FfmpegStatus}"
                                   Style="{StaticResource RowTitleStyle}"
                                   Margin="0,4,0,6"
                                   TextWrapping="Wrap"/>

                        <StackPanel Visibility="{Binding IsFfmpegMissing,
                                        Converter={StaticResource BoolToVisibilityConverter},
                                        FallbackValue=Visible}">
                            <TextBlock Text="Generate will not start until ffmpeg is installed. AVI is not accepted as an MP4. Download the Windows essentials zip, copy ffmpeg.exe and ffprobe.exe into the tools folder, then Recheck."
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding FfmpegDownloadUrl}"
                                       FontSize="12"
                                       FontFamily="Consolas"
                                       Foreground="{DynamicResource AccentBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"/>
                            <TextBlock Text="{Binding FfmpegInstallHint}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>
                            <WrapPanel Margin="0,16,0,0">
                                <Button Style="{StaticResource OutlinedPillButton}"
                                        Content="DOWNLOAD FFMPEG (WINDOWS ZIP)"
                                        Command="{Binding OpenFfmpegDownloadCommand}"
                                        AutomationProperties.AutomationId="DemoCenter.DownloadFfmpeg"
                                        Margin="0,0,10,8"/>
                                <Button Style="{StaticResource RowOutlinedButton}"
                                        Content="OFFICIAL FFMPEG PAGE"
                                        Command="{Binding OpenFfmpegPageCommand}"
                                        AutomationProperties.AutomationId="DemoCenter.FfmpegOfficial"
                                        Margin="0,0,10,8"/>
                                <Button Style="{StaticResource RowOutlinedButton}"
                                        Content="COPY LINK"
                                        Command="{Binding CopyFfmpegLinkCommand}"
                                        Margin="0,0,10,8"/>
                                <Button Style="{StaticResource RowOutlinedButton}"
                                        Content="OPEN TOOLS FOLDER"
                                        Command="{Binding OpenToolsFolderCommand}"
                                        Margin="0,0,10,8"/>
                                <Button Style="{StaticResource RowOutlinedButton}"
                                        Content="RECHECK"
                                        Command="{Binding RecheckFfmpegCommand}"
                                        AutomationProperties.AutomationId="DemoCenter.RecheckFfmpeg"
                                        Margin="0,0,10,8"/>
                            </WrapPanel>
                        </StackPanel>

                        <TextBlock Text="ffmpeg is ready. Generate Selected will record the module and write a verified MP4."
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding IsFfmpegReady,
                                       Converter={StaticResource BoolToVisibilityConverter},
                                       FallbackValue=Collapsed}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}" CornerRadius="{DynamicResource CardCornerRadius}">
                    <StackPanel>
                        <TextBlock Text="RECORD THIS SESSION" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Text="{Binding SessionRecordHint}"
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding SessionRecordStatus}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                        <WrapPanel Margin="0,14,0,0">
                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Content="START RECORDING"
                                    Command="{Binding StartSessionRecordCommand}"
                                    AutomationProperties.AutomationId="DemoCenter.StartSessionRecord"
                                    Visibility="{Binding IsSessionIdle,
                                        Converter={StaticResource BoolToVisibilityConverter}}"
                                    Margin="0,0,10,8"/>
                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Content="STOP AND SAVE"
                                    Command="{Binding StopSessionRecordCommand}"
                                    AutomationProperties.AutomationId="DemoCenter.StopSessionRecord"
                                    Visibility="{Binding IsSessionRecording,
                                        Converter={StaticResource BoolToVisibilityConverter}}"
                                    Margin="0,0,10,8"/>
                            <Button Style="{StaticResource RowOutlinedButton}"
                                    Content="OPEN RECORDINGS"
                                    Command="{Binding OpenRecordingsCommand}"
                                    Margin="0,0,10,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}" CornerRadius="{DynamicResource CardCornerRadius}">
                    <StackPanel>
                        <TextBlock Text="RECORDING" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Text="Captures only this running app window. Not the desktop, not other programs."
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Quality"
                                   Style="{StaticResource RowTitleStyle}"
                                   Margin="0,8,0,6"/>
                        <ComboBox ItemsSource="{Binding Qualities}"
                                  SelectedItem="{Binding SelectedQuality, Mode=TwoWay}"
                                  DisplayMemberPath="Title"
                                  IsSynchronizedWithCurrentItem="False"
                                  MinWidth="260"
                                  Padding="10,7"
                                  FontSize="13"/>
                        <TextBlock Text="Frame rate"
                                   Style="{StaticResource RowTitleStyle}"
                                   Margin="0,14,0,6"/>
                        <ComboBox ItemsSource="{Binding FpsChoices}"
                                  SelectedItem="{Binding SelectedFps, Mode=TwoWay}"
                                  DisplayMemberPath="Title"
                                  IsSynchronizedWithCurrentItem="False"
                                  MinWidth="180"
                                  Padding="10,7"
                                  FontSize="13"/>
                        <DockPanel Margin="0,18,0,0">
                            <TextBlock Text="Internal audio (app / narration)"
                                       Style="{StaticResource RowTitleStyle}"
                                       VerticalAlignment="Center"/>
                            <ToggleButton HorizontalAlignment="Right"
                                          IsChecked="{Binding CaptureLiveAudio, Mode=TwoWay}"
                                          Style="{StaticResource ModernToggleSwitch}"
                                          AutomationProperties.AutomationId="DemoCenter.CaptureAudio"/>
                        </DockPanel>
                        <DockPanel Margin="0,14,0,0">
                            <TextBlock Text="Microphone"
                                       Style="{StaticResource RowTitleStyle}"
                                       VerticalAlignment="Center"/>
                            <ToggleButton HorizontalAlignment="Right"
                                          IsChecked="{Binding CaptureMicrophone, Mode=TwoWay}"
                                          Style="{StaticResource ModernToggleSwitch}"
                                          AutomationProperties.AutomationId="DemoCenter.CaptureMic"/>
                        </DockPanel>
                        <TextBlock Text="{Binding RecordHint}"
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}" CornerRadius="{DynamicResource CardCornerRadius}">
                    <StackPanel>
                        <TextBlock Text="WORKFLOW" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Text="Module"
                                   Style="{StaticResource RowTitleStyle}"
                                   Margin="0,12,0,6"/>
                        <ComboBox ItemsSource="{Binding Modules}"
                                  SelectedItem="{Binding SelectedWorkflow, Mode=TwoWay}"
                                  DisplayMemberPath="Title"
                                  IsSynchronizedWithCurrentItem="False"
                                  MinWidth="260"
                                  Padding="10,7"
                                  FontSize="13"/>
                        <TextBlock Text="{Binding SelectedPurpose}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding WorkflowHint}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                        <WrapPanel Margin="0,16,0,0">
                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Content="GENERATE SELECTED"
                                    Command="{Binding GenerateSelectedCommand}"
                                    AutomationProperties.AutomationId="DemoCenter.GenerateSelected"
                                    Margin="0,0,10,8"/>
                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Content="GENERATE ALL MODULES"
                                    Command="{Binding GenerateAllCommand}"
                                    AutomationProperties.AutomationId="DemoCenter.GenerateAll"
                                    Margin="0,0,10,8"/>
                            <Button Style="{StaticResource RowOutlinedButton}"
                                    Content="RETRY LAST"
                                    Command="{Binding RetryCommand}"
                                    Margin="0,0,10,8"/>
                            <Button Style="{StaticResource RowOutlinedButton}"
                                    Content="CANCEL"
                                    Command="{Binding CancelCommand}"
                                    Margin="0,0,10,8"/>
                            <Button Style="{StaticResource RowOutlinedButton}"
                                    Content="OPEN OUTPUT"
                                    Command="{Binding OpenOutputCommand}"
                                    Margin="0,0,10,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}" CornerRadius="{DynamicResource CardCornerRadius}">
                    <StackPanel>
                        <TextBlock Text="ISOLATION" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Text="{Binding IsolationText}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                        <WrapPanel Margin="0,14,0,0">
                            <Button Style="{StaticResource RowOutlinedButton}"
                                    Content="ENTER DEMO MODE"
                                    Command="{Binding EnterDemoCommand}"
                                    Margin="0,0,10,8"/>
                            <Button Style="{StaticResource RowOutlinedButton}"
                                    Content="EXIT DEMO MODE"
                                    Command="{Binding ExitDemoCommand}"
                                    Margin="0,0,10,8"/>
                            <Button Style="{StaticResource RowOutlinedButton}"
                                    Content="RESET DEMO FOLDER"
                                    Command="{Binding ResetDemoCommand}"
                                    Margin="0,0,10,8"/>
                        </WrapPanel>
                        <TextBlock Text="Reset deletes only %AppData%/ProGlassAutomation.Demo. Production files are never opened or cleared."
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}" CornerRadius="{DynamicResource CardCornerRadius}">
                    <StackPanel>
                        <TextBlock Text="STATUS" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Text="{Binding StateText}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding VerifiedText}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   FontSize="11"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding LastMp4Text}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding FfmpegStatus}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}" CornerRadius="{DynamicResource CardCornerRadius}">
                    <StackPanel>
                        <TextBlock Text="HISTORY" Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Text="No jobs yet. Generate Selected or Generate All to start a recording."
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding HasHistory,
                                       Converter={StaticResource InverseBoolToVisibilityConverter},
                                       FallbackValue=Visible}"/>
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}">
                                            <Run Text="{Binding Module, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding State, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
