<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsLicenseSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — LICENSE page (tile-grid redesign Aug 2026)

     A thin wrapper that hosts the shared LicenseActivationView so
     licence management lives INSIDE the settings shell rather than
     as a full-screen startup overlay. Also renders a compact
     summary strip (status badge + edition + days remaining) above
     the activation view so the user can see their state before
     scrolling into the details.

     REDESIGN
       Was a single full-width card above the activation view. Now the
       status strip gets a labelled group header and the activation
       step its own header, so the page reads as two clear steps.

     The activation view is the single source of truth for the
     License-key / PC-ID / trial-status UI — this section deliberately
     does not duplicate that surface. The trial is automatic (see
     Services/Licensing/AutoTrialManager).
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsLicenseSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmLicensing="clr-namespace:ProGlassAutomation.ViewModels.Licensing"
             xmlns:viewsLicensing="clr-namespace:ProGlassAutomation.Views.Licensing"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,26,32,14">
            <TextBlock Text="License" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Paste your vendor-signed license key to activate, or review the automatic trial state."
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}">
            <StackPanel Margin="32,0,32,32"
                        DataContext="{x:Static vmLicensing:LicenseStatusViewModel.Instance}">

                <!-- ═══════ GROUP: LICENSE STATUS ═══════ -->
                <TextBlock Text="LICENSE STATUS"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="Auto-updates on LicenseService.StatusChanged."
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <StackPanel Margin="0,0,0,6">
                    <Border Style="{StaticResource SettingsFullRowTileStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Status badge chip -->
                            <Border Grid.Column="0"
                                    Padding="12,6"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Background="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusBadge}"
                                           FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding EditionDisplay}"
                                           FontSize="{StaticResource TextTitle}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                <TextBlock Text="{Binding StatusDescription}"
                                           FontSize="{StaticResource TextBody}"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding DaysRemainingDisplay}"
                                           FontSize="{StaticResource TextTitleLarge}" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Text="remaining"
                                           FontSize="{StaticResource TextBody}"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource SettingsGroupSeparatorStyle}"/>

                <!-- ═══════ GROUP: ACTIVATION ═══════ -->
                <TextBlock Text="ACTIVATION"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="Paste a license key to activate. The trial starts automatically; the PC ID below is only needed for machine-bound keys."
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <!-- Reuses the same UserControl the main window used to show
                     as a full-screen overlay. Because it lives inside a
                     ScrollViewer here, IsClosable stays false (there is
                     nothing to close — you navigate away from the settings
                     page instead). -->
                <viewsLicensing:LicenseActivationView IsClosable="False"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
