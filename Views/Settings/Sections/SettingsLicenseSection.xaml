<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsLicenseSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings — LICENSE page (2026-09-16 grammar rewrite)

     WHAT CHANGED AND WHY
     ────────────────────
     Restyled to the approved Settings grammar
     (Views/Settings/SettingsCardStyles.xaml). The page's job is unchanged
     and so is every binding: this is a structural rewrite of the chrome.

       • The old file opened with its own H1 + subtitle block. The shell
         already renders a header strip with the page name, so every page
         printed its title twice. Local titles are gone; the shell strip is
         the single page header.
       • `<Border Style="SurfaceDetailStyle"/>` was used as a vertical
         GAP between two groups. SurfaceDetailStyle is a card — a card used
         as a spacer is why the page read as a stack of unrelated slabs.
         Real spacing + SettingsRowSeparatorStyle now do that.
       • Cards were `SurfacePrimaryStyle` with nested `SurfacePrimaryStyle`
         inside them (a card inside a card of the same style). Now: one
         SettingsPageCardStyle per card, content in SettingsInnerTileStyle.
       • Values are pills (SettingsValuePillStyle), status is a chip, and
         spacing comes from the grammar's tokens — no local margins.

     The activation view stays the single source of truth for key entry and
     PC-ID display; this page deliberately does not duplicate it.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsLicenseSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmLicensing="clr-namespace:ProGlassAutomation.ViewModels.Licensing"
             xmlns:viewsLicensing="clr-namespace:ProGlassAutomation.Views.Licensing"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly"
                  behaviors:SmoothScrollBehavior.IsEnabled="True"
                  Focusable="False"
                  FocusVisualStyle="{x:Null}"
                  Padding="{StaticResource SettingsPagePadding}">
        <StackPanel DataContext="{x:Static vmLicensing:LicenseStatusViewModel.Instance}">

            <!-- ═══ CARD 1 — STATUS AT A GLANCE ═══ -->
            <Border Style="{StaticResource SettingsPageCardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                            <TextBlock Text="&#xE762;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="{StaticResource SettingsIconTextMargin}"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Settings.LicenseStatus}"
                                       Style="{StaticResource SettingsCardTitleStyle}"/>
                            <TextBlock Text="{Binding EditionDisplay}"
                                       Style="{StaticResource SettingsRowTitleStyle}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Style="{StaticResource SettingsChipGreenStyle}">
                                <TextBlock Text="{Binding StatusBadge}"
                                           Style="{StaticResource SettingsChipGreenTextStyle}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding StatusDescription}"
                               Style="{StaticResource SettingsCardNoteStyle}"/>

                    <Border Style="{StaticResource SettingsInnerTileStyle}"
                            Margin="{StaticResource SettingsCardContentMargin}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Settings.Remaining}"
                                           Style="{StaticResource SettingsFieldLabelStyle}"/>
                                <TextBlock Text="{DynamicResource Settings.AutoUpdatesLicenseserviceStatuschanged}"
                                           Style="{StaticResource SettingsRowMetaStyle}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Style="{StaticResource SettingsValuePillStyle}"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding DaysRemainingDisplay}"
                                           Style="{StaticResource SettingsValuePillTextStyle}"
                                           FontSize="{DynamicResource Ios26FontSizeSubtitle}"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══ CARD 2 — ACTIVATION ═══ -->
            <Border Style="{StaticResource SettingsPageCardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SettingsIconTileStyle}">
                            <TextBlock Text="&#xE72E;" Style="{StaticResource SettingsIconGlyphStyle}"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="{StaticResource SettingsIconTextMargin}"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Settings.Activation}"
                                       Style="{StaticResource SettingsCardTitleStyle}"/>
                            <TextBlock Text="{DynamicResource Settings.PickPlanPressGETLicenseKEYPasteVendorKey}"
                                       Style="{StaticResource SettingsRowMetaStyle}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SettingsRowSeparatorStyle}"/>

                    <!-- Reuses the same UserControl the main window used to show
                         as a full-screen overlay; inside a ScrollViewer
                         IsClosable stays false (there is nothing to close —
                         you navigate away from the page instead). -->
                    <viewsLicensing:LicenseActivationView IsClosable="False"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
