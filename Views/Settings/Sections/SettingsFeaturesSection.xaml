                                Converter={StaticResource BoolToVisibilityConverter}}">

                <!-- ═══ CARD — DELIVERY NOTE ═══ -->
                    <Border Style="{StaticResource SettingsPageCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Module.DeliveryNote}"
                                   Style="{StaticResource SettingsCardTitleStyle}"/>
                            <TextBlock Text="{DynamicResource Settings.TurnOptionalDispatchFieldsStatusCannotHidden}"
                                   Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                            <StackPanel Margin="{StaticResource SettingsRowMargin}">
                                <Border Style="{StaticResource SettingsInnerTileStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE718;"/>
                                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center" Text="{DynamicResource Settings.BulkActions}"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                               Text="{DynamicResource Settings.FlipDeliveryNoteFieldOnce}"/>
                                        <Border 
                Style="{StaticResource SurfacePanelTileStyle}">
                                            <UniformGrid Columns="3">
                                                <Button Content="{DynamicResource Settings.Enable}"
                                                Command="{Binding EnableAllCommand}"
                                                Style="{StaticResource SettingsActionButtonStyle}"/>
                                                <Button Content="{DynamicResource Settings.HideOptional}"
                                                Command="{Binding DisableAllOptionalCommand}"
                                                Style="{StaticResource SettingsActionButtonStyle}"/>
                                                <Button Content="{DynamicResource ProformaInvoice.ResetDefaults}"
                                                Command="{Binding ResetToDefaultsCommand}"
                                                Style="{StaticResource SettingsActionButtonStyle}"
                                                Margin="0"/>
                                            </UniformGrid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{DynamicResource Settings.DeliveryDetails}"
                                   Style="{StaticResource SettingsGroupCaptionStyle}"
                                   Margin="{StaticResource SettingsStackGap18}"/>

                            <UniformGrid Columns="3" Margin="{StaticResource SettingsRowMargin}">
                                <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;"/>
                                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource DeliveryNote.DriverNAME}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.WhoDeliveredLoad}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowDriverName}"
                                        AutomationProperties.Name="{DynamicResource DeliveryNote.DriverNAME}"
                                        />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;"/>
                                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource DeliveryNote.VehicleNumber}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.TruckVanPlate}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowVehicleNumber}"
                                        AutomationProperties.Name="{DynamicResource DeliveryNote.VehicleNumber}"
                                        />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;"/>
                                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource Settings.FOCFreeCost}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.MarkDeliveryFreeComplimentary}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowIsFoc}"
                                        AutomationProperties.Name="{DynamicResource Settings.FOCFreeCost}"
                                        />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;"/>
                                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource DeliveryNote.ReceiverNAME}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.WhoSignedGoods}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowReceiverName}"
                                        AutomationProperties.Name="{DynamicResource DeliveryNote.ReceiverNAME}"
                                        />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsInnerTileStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;"/>
                                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource Common.Notes}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.FreeformDispatchNotes}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowNotes}"
                                        AutomationProperties.Name="{DynamicResource Common.Notes}"
                                        />
                                    </Grid>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                </StackPanel>   <!-- close DataContext=DeliveryNoteFeatures scope -->

                <!-- ═══════════ TAX INVOICE FIELD VISIBILITY ═══════════
                     Re-scopes DataContext to TaxInvoiceFeatures. Only the
                     optional accounting fields toggle; Issue Date stays. -->
                <StackPanel DataContext="{Binding DataContext.TaxInvoiceFeatures,
                                ElementName=SettingsFeaturesRoot}"
                            Visibility="{Binding DataContext.IsTaxInvoiceFeaturesModule,
                                ElementName=SettingsFeaturesRoot,
                                Converter={StaticResource BoolToVisibilityConverter}}">

                <!-- ═══ CARD — TAX INVOICE ═══ -->
                    <Border Style="{StaticResource SettingsPageCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Module.TaxInvoice}"
                                   Style="{StaticResource SettingsCardTitleStyle}"/>
                            <TextBlock Text="{DynamicResource Settings.TurnOptionalAccountingFieldsIssueDateCannot}"
                                   Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                            <StackPanel Margin="{StaticResource SettingsRowMargin}">
                                <Border Style="{StaticResource SettingsInnerTileStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE7B8;"/>
                                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center" Text="{DynamicResource Settings.BulkActions}"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource SettingsRowMetaStyle}"
                                               Text="{DynamicResource Settings.FlipTaxInvoiceFieldOnce}"/>
                                        <Border 
                Style="{StaticResource SurfacePanelTileStyle}">
                                            <UniformGrid Columns="3">
                                                <Button Content="{DynamicResource Settings.Enable}"
                                                Command="{Binding EnableAllCommand}"
                                                Style="{StaticResource SettingsActionButtonStyle}"/>
                                                <Button Content="{DynamicResource Settings.HideOptional}"
                                                Command="{Binding DisableAllOptionalCommand}"
                                                Style="{StaticResource SettingsActionButtonStyle}"/>
                                                <Button Content="{DynamicResource ProformaInvoice.ResetDefaults}"
                                                Command="{Binding ResetToDefaultsCommand}"
                                                Style="{StaticResource SettingsActionButtonStyle}"
                                                Margin="0"/>
                                            </UniformGrid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{DynamicResource Settings.InvoiceDetails}"
                                   Style="{StaticResource SettingsGroupCaptionStyle}"
                                   Margin="{StaticResource SettingsStackGap18}"/>

                            <UniformGrid Columns="3" Margin="{StaticResource SettingsRowMargin}">
                                <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;"/>
                                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource Reports.TaxInvoiceReport.DUEDATE}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.PaymentDueDatePrintedInvoice}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowDueDate}"
                                        AutomationProperties.Name="{DynamicResource Reports.TaxInvoiceReport.DUEDATE}"
                                        />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;"/>
                                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource Settings.PaymentTerms}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.NetCreditTermsClientAgreed}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowPaymentTerms}"
                                        AutomationProperties.Name="{DynamicResource Settings.PaymentTerms}"
                                        />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;"/>
                                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource Settings.Discount}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.PercentageDiscountInvoice}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowDiscountPercent}"
                                        AutomationProperties.Name="{DynamicResource Settings.Discount}"
                                        />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;"/>
                                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource Settings.IBAN}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.BankAccountNumberSettlement}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowIban}"
                                        AutomationProperties.Name="{DynamicResource Settings.IBAN}"
                                        />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsInnerTileStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;"/>
                                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource Settings.Swift}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.BankRoutingCodeInternationalTransfers}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowSwiftCode}"
                                        AutomationProperties.Name="{DynamicResource Settings.Swift}"
                                        />
                                    </Grid>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                </StackPanel>   <!-- close DataContext=TaxInvoiceFeatures scope -->
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
