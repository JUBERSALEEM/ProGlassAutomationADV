                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;"/>
                                <TextBlock Style="{StaticResource Typography.Title}" Text="{DynamicResource CompanyCenter.BANKNAME}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource Typography.BodySmall}" Text="{DynamicResource Settings.PayeeBankNameInvoiceFooter}"/>
