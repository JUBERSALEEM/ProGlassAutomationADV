<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsFeaturesSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — FEATURES page (tile-grid redesign Aug 2026)

     REDESIGN
       Was: every optional field was a full-width Grid row (label +
       toggle) stacked inside a giant full-width card per step. On a
       wide pane each toggle row stretched the whole width, so 65% of
       horizontal space was empty and the page was a long vertical
       list of identical rows.

       Now: each optional field is its own 320-wide tile (title +
       hint + toggle) dropped into a WrapPanel, so they reflow into
       3–4 columns and the page becomes a tidy grid of switches. The
       two bulk-action headers (Proforma Invoice / Inquiry) and the
       Session card stay as full-row tiles. Every PiToggleSwitch
       IsChecked binding, both DataContext re-scopes, and the
       SettingsFeaturesRoot ElementName handoff are preserved.

     UX contract (unchanged):
       • DB-required fields never appear here — Company Name, Customer
         Name and Proforma ID are always visible in the wizard.
       • Every toggle is an iPhone-style PiToggleSwitch, off = field
         hidden, on = field visible. Defaults are ALL ON.
       • Changes persist immediately (no Apply / Save button).
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsFeaturesSection"
             x:Name="SettingsFeaturesRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,26,32,14">
            <TextBlock Text="Features" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Turn individual fields on or off without touching code. Hiding a field only affects the UI — the value stays on disk and reappears when you re-enable it."
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <!-- ═══════════ MODULE TAB SWITCH ═══════════
             Only the selected module's field-toggles are shown, so the
             page is not a long stack of five modules. Anchored to the
             shell DataContext via ElementName (feature sections re-scope
             their own DataContext, so a plain {Binding} here would break).
             This mirrors the Settings shell navigation pattern. -->
        <WrapPanel Grid.Row="0" Margin="32,4,32,0">
            <Button Content="Proforma Invoice" Margin="0,0,8,8" MinWidth="130"
                    Command="{Binding DataContext.SwitchFeaturesModuleCommand,
                                ElementName=SettingsFeaturesRoot}"
                    CommandParameter="Proforma">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RowOutlinedButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsProformaFeaturesModule,
                                ElementName=SettingsFeaturesRoot}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="Inquiry" Margin="0,0,8,8" MinWidth="110"
                    Command="{Binding DataContext.SwitchFeaturesModuleCommand,
                                ElementName=SettingsFeaturesRoot}"
                    CommandParameter="Inquiry">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RowOutlinedButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsInquiryFeaturesModule,
                                ElementName=SettingsFeaturesRoot}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="Job Order" Margin="0,0,8,8" MinWidth="120"
                    Command="{Binding DataContext.SwitchFeaturesModuleCommand,
                                ElementName=SettingsFeaturesRoot}"
                    CommandParameter="JobOrder">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RowOutlinedButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsJobOrderFeaturesModule,
                                ElementName=SettingsFeaturesRoot}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="Delivery Note" Margin="0,0,8,8" MinWidth="130"
                    Command="{Binding DataContext.SwitchFeaturesModuleCommand,
                                ElementName=SettingsFeaturesRoot}"
                    CommandParameter="DeliveryNote">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RowOutlinedButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsDeliveryNoteFeaturesModule,
                                ElementName=SettingsFeaturesRoot}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="Tax Invoice" Margin="0,0,8,8" MinWidth="120"
                    Command="{Binding DataContext.SwitchFeaturesModuleCommand,
                                ElementName=SettingsFeaturesRoot}"
                    CommandParameter="TaxInvoice">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RowOutlinedButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsTaxInvoiceFeaturesModule,
                                ElementName=SettingsFeaturesRoot}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </WrapPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}">
            <StackPanel Margin="32,0,32,32">

                <!-- ═══════════ SESSION ═══════════
                     Bound to the parent SettingsViewModel via
                     ElementName since the descendant toggles below
                     re-scope their DataContext. Sits above everything
                     so a shift-change operator sees it first. -->
                <TextBlock Text="SESSION"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="Sign out for a shift handover, or forget the auto-sign-in credentials on this device without ending your session."
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <UniformGrid Columns="1" Margin="0,0,0,6">
                    <Border Style="{StaticResource SettingsFullRowTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE77B;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Session Security"/>
                            </StackPanel>
                            <!-- Full-width action row: buttons stretch evenly
                                 across the whole card (no left-cramped gap). -->
                            <UniformGrid Columns="2" Style="{StaticResource SettingsActionRowStyle}">
                                <Button Content="Forget this device"
                                        Command="{Binding DataContext.ForgetThisDeviceCommand,
                                            ElementName=SettingsFeaturesRoot}"
                                        Style="{StaticResource SettingsActionButtonStyle}"
                                        ToolTip="Clear the Skip-login vault entry on this machine without signing out. Next launch will show the login form."/>
                                <Button Content="Sign out"
                                        Command="{Binding DataContext.SignOutCommand,
                                            ElementName=SettingsFeaturesRoot}"
                                        Style="{StaticResource SettingsActionButtonStyle}"
                                        Margin="0"
                                        ToolTip="End your session, clear the Skip-login vault entry, and return to the login screen."/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- ═══════════ PROFORMA INVOICE FIELD VISIBILITY ═══════════
                     The rest of the proforma toggles re-scope DataContext.
                     Company Name, Customer Name and Proforma ID cannot be
                     hidden — the database needs them. -->
                <StackPanel DataContext="{Binding ProformaFeatures}"
                            Visibility="{Binding DataContext.IsProformaFeaturesModule,
                                ElementName=SettingsFeaturesRoot,
                                Converter={StaticResource BoolToVisibilityConverter}}">

                <Border Style="{StaticResource SettingsGroupSeparatorStyle}" Margin="0,0,0,10"/>
                <TextBlock Text="PROFORMA INVOICE"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"/>
                <TextBlock Text="Show or hide optional fields in Steps 1 – 3 of the invoice wizard. Company Name, Customer Name and Proforma ID cannot be hidden — the database needs them."
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <UniformGrid Columns="1" Margin="0,0,0,6">
                    <Border Style="{StaticResource SettingsFullRowTileStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8A5;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Bulk Actions"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingsTileCaptionStyle}"
                                       Text="Flip every optional field at once, or restore the out-of-the-box layout."/>
                            <!-- Full-width action row: buttons stretch evenly
                                 across the whole card (no left-cramped gap). -->
                            <UniformGrid Columns="3" Style="{StaticResource SettingsActionRowStyle}">
                                <Button Content="Enable all"
                                        Command="{Binding EnableAllCommand}"
                                        Style="{StaticResource SettingsActionButtonStyle}"
                                        ToolTip="Show every optional field in the wizard."/>
                                <Button Content="Hide all optional"
                                        Command="{Binding DisableAllOptionalCommand}"
                                        Style="{StaticResource SettingsActionButtonStyle}"
                                        ToolTip="Collapse every optional field. The three DB-required fields stay visible."/>
                                <Button Content="Reset defaults"
                                        Command="{Binding ResetToDefaultsCommand}"
                                        Style="{StaticResource SettingsActionButtonStyle}"
                                        Margin="0"
                                        ToolTip="Restore the out-of-the-box layout (every field visible)."/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- ── STEP 1 · COMPANY ─────────────────────── -->
                <TextBlock Text="STEP 1 · COMPANY"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"
                           Margin="0,18,0,0"/>
                <TextBlock Text="Company Name and Proforma ID stay visible (required by the database)."
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <UniformGrid Columns="4" Margin="0,0,0,6">
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8D4;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Federal TRN"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource SettingsTileCaptionStyle}" Text="15-digit UAE Tax Registration Number."/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowCompanyTrn}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8D4;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Headquarters"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource SettingsTileCaptionStyle}" Text="Short city / emirate line printed on the letterhead."/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowCompanyLocation}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8D4;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Representative"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource SettingsTileCaptionStyle}" Text="Name of the person signing on behalf of the company."/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowRepresentative}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8D4;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Representative Mobile"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource SettingsTileCaptionStyle}" Text="Direct number of the signing representative."/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowRepresentativeMobile}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8D4;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Company E-mail"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource SettingsTileCaptionStyle}" Text="Contact e-mail printed under the header."/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowCompanyEmail}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8D4;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Bank Name"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource SettingsTileCaptionStyle}" Text="Payee bank name on the invoice footer."/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowBankName}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8D4;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Account / IBAN"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource SettingsTileCaptionStyle}" Text="Account number or IBAN paired with the bank name."/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowAccountNumber}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8D4;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Issue Date"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource SettingsTileCaptionStyle}" Text="Date the proforma is issued. Defaults to today when hidden."/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowIssueDate}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8D4;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Valid Until"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource SettingsTileCaptionStyle}" Text="Quotation expiry date."/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowValidUntil}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8D4;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Status"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource SettingsTileCaptionStyle}" Text="Draft / Sent / Approved workflow picker."/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowProformaStatus}"/>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- ── STEP 2 · CLIENT ─────────────────────── -->
                <TextBlock Text="STEP 2 · CLIENT"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"
                           Margin="0,18,0,0"/>
                <TextBlock Text="Customer Name stays visible (required by the database)."
                           Style="{StaticResource SettingsGroupCaptionStyle}"/>

                <UniformGrid Columns="4" Margin="0,0,0,6">
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE716;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Customer TRN"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource SettingsTileCaptionStyle}" Text="Client's Tax Registration Number."/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowCustomerTrn}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE716;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Reference Code"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource SettingsTileCaptionStyle}" Text="Internal customer code (CRM key, ledger code, etc.)."/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowCustomerReferenceCode}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE716;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Sales Representative"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource SettingsTileCaptionStyle}" Text="Salesperson who owns the deal."/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowSalesRepresentative}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE716;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Prepared By"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource SettingsTileCaptionStyle}" Text="Operator who typed up the quotation."/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowDocumentPreparedBy}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE716;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Attention (Kind Attn.)"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource SettingsTileCaptionStyle}" Text="Person the invoice should be addressed to."/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowAttentionExecutive}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE716;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Client Phone"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource SettingsTileCaptionStyle}" Text="Bill-to contact phone number."/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowClientContactPhone}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE716;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Billing Address"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource SettingsTileCaptionStyle}" Text="Multi-line postal address for the invoice header."/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowBillingAddress}"/>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- ── STEP 3 · PROJECT ─────────────────────── -->
                <TextBlock Text="STEP 3 · PROJECT"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"
                           Margin="0,18,0,0"/>

                <UniformGrid Columns="3" Margin="0,0,0,6">
                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8B7;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Project Name"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource SettingsTileCaptionStyle}" Text="Short project handle used across lists and invoices."/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowProjectName}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8B7;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Project Reference"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource SettingsTileCaptionStyle}" Text="Full descriptive reference (e.g. 'HOUSE FOR IMAD HABIB')."/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowProjectReference}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8B7;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="Contract Number"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource SettingsTileCaptionStyle}" Text="Internal contract identifier (e.g. '428 IMAD HABIB')."/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowContractNo}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsTileStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8B7;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="LPO / PO Number"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource SettingsTileCaptionStyle}" Text="Client-supplied purchase order number."/>
