                    <Border Style="{StaticResource SurfacePrimaryStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SurfaceDetailStyle}">
                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;"/>
                                <TextBlock Style="{StaticResource Typography.Title}" Text="{DynamicResource ProformaInvoice.AccountIBAN}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource Typography.BodySmall}" Text="{DynamicResource Settings.AccountNumberIBANPairedBankName}"/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowAccountNumber}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SurfacePrimaryStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SurfaceDetailStyle}">
                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;"/>
                                <TextBlock Style="{StaticResource Typography.Title}" Text="{DynamicResource ProformaInvoice.IssueDATE}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource Typography.BodySmall}" Text="{DynamicResource Settings.DateProformaIssuedDefaultsTodayWhenHidden}"/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowIssueDate}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SurfacePrimaryStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SurfaceDetailStyle}">
                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;"/>
                                <TextBlock Style="{StaticResource Typography.Title}" Text="{DynamicResource ProformaInvoice.ValidUntil}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource Typography.BodySmall}" Text="{DynamicResource Settings.QuotationExpiryDate}"/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowValidUntil}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SurfacePrimaryStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SurfaceDetailStyle}">
                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;"/>
                                <TextBlock Style="{StaticResource Typography.Title}" Text="{DynamicResource Common.Status}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource Typography.BodySmall}" Text="{DynamicResource Settings.DraftSentApprovedWorkflowPicker}"/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowProformaStatus}"/>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- ── STEP 2 · CLIENT ─────────────────────── -->
                <TextBlock Text="{DynamicResource Settings.STEP2Client}"
                           Style="{StaticResource SettingsGroupHeaderTextStyle}"
                           Margin="0,18,0,0"/>
                <TextBlock Text="{DynamicResource Settings.CustomerNameStaysVisibleRequiredDatabase}"
                           Style="{StaticResource Typography.BodySmall}"/>

                <UniformGrid Columns="4" Margin="0,0,0,6">
                    <Border Style="{StaticResource SurfacePrimaryStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SurfaceDetailStyle}">
                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE716;"/>
                                <TextBlock Style="{StaticResource Typography.Title}" Text="{DynamicResource ProformaInvoice.CustomerTRN}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource Typography.BodySmall}" Text="{DynamicResource Settings.ClientSTaxRegistrationNumber}"/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowCustomerTrn}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SurfacePrimaryStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SurfaceDetailStyle}">
                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE716;"/>
                                <TextBlock Style="{StaticResource Typography.Title}" Text="{DynamicResource ProformaInvoice.ReferenceCODE}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource Typography.BodySmall}" Text="{DynamicResource Settings.InternalCustomerCodeCRMKeyLedgerCodeEtc}"/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowCustomerReferenceCode}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SurfacePrimaryStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SurfaceDetailStyle}">
                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE716;"/>
                                <TextBlock Style="{StaticResource Typography.Title}" Text="{DynamicResource ProformaInvoice.SalesRepresentative}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource Typography.BodySmall}" Text="{DynamicResource Settings.SalespersonWhoOwnsDeal}"/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowSalesRepresentative}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SurfacePrimaryStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SurfaceDetailStyle}">
                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE716;"/>
                                <TextBlock Style="{StaticResource Typography.Title}" Text="{DynamicResource Inquiry.Prepared2}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource Typography.BodySmall}" Text="{DynamicResource Settings.OperatorWhoTypedQuotation}"/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowDocumentPreparedBy}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SurfacePrimaryStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SurfaceDetailStyle}">
                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE716;"/>
                                <TextBlock Style="{StaticResource Typography.Title}" Text="{DynamicResource Settings.AttentionKindAttn}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource Typography.BodySmall}" Text="{DynamicResource Settings.PersonInvoiceShouldAddressed}"/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowAttentionExecutive}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SurfacePrimaryStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SurfaceDetailStyle}">
                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE716;"/>
                                <TextBlock Style="{StaticResource Typography.Title}" Text="{DynamicResource Settings.ClientPhone}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource Typography.BodySmall}" Text="{DynamicResource Settings.BillContactPhoneNumber}"/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowClientContactPhone}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SurfacePrimaryStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource SurfaceDetailStyle}">
                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE716;"/>
                                <TextBlock Style="{StaticResource Typography.Title}" Text="{DynamicResource ProformaInvoice.BillingAddress}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource Typography.BodySmall}" Text="{DynamicResource Settings.MultiLinePostalAddressInvoiceHeader}"/>
