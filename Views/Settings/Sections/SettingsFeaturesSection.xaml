<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsFeaturesSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — FEATURES page (tile-grid redesign Aug 2026)
     REDESIGN
       Was: every optional field was a full-width Grid row (label +
       toggle) stacked inside a giant full-width card per step. On a
       wide pane each toggle row stretched the whole width, so 65% of
       horizontal space was empty and the page was a long vertical
       list of identical rows.
       Now: each optional field is its own 320-wide tile (title +
       hint + toggle) dropped into a WrapPanel, so they reflow into
       3–4 columns and the page becomes a tidy grid of switches. The
       two bulk-action headers (Proforma Invoice / Inquiry) and the
       Session card stay as full-row tiles. Every PiToggleSwitch
       IsChecked binding, both DataContext re-scopes, and the
       SettingsFeaturesRoot ElementName handoff are preserved.
     UX contract (unchanged):
       • DB-required fields never appear here — Company Name, Customer
         Name and Proforma ID are always visible in the wizard.
       • Every toggle is an iPhone-style PiToggleSwitch, off = field
         hidden, on = field visible. Defaults are ALL ON.
       • Changes persist immediately (no Apply / Save button).
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsFeaturesSection"
             x:Name="SettingsFeaturesRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsCardStyles.xaml"/>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ═══════════ MODULE TAB SWITCH ═══════════
             Only the selected module's field-toggles are shown, so the
             page is not a long stack of five modules. Anchored to the
             shell DataContext via ElementName (feature sections re-scope
             their own DataContext, so a plain {Binding} here would break).
             This mirrors the Settings shell navigation pattern. -->
        <WrapPanel Grid.Row="0" Margin="32,4,32,0">
            <Button Content="{DynamicResource Module.ProformaInvoice}" Margin="{StaticResource SettingsTileWrapMargin}" MinWidth="130"
                    Command="{Binding DataContext.SwitchFeaturesModuleCommand,
                                ElementName=SettingsFeaturesRoot}"
                    CommandParameter="Proforma">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RowOutlinedButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsProformaFeaturesModule,
                                ElementName=SettingsFeaturesRoot}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="{DynamicResource Module.Inquiry}" Margin="{StaticResource SettingsTileWrapMargin}" MinWidth="110"
                    Command="{Binding DataContext.SwitchFeaturesModuleCommand,
                                ElementName=SettingsFeaturesRoot}"
                    CommandParameter="Inquiry">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RowOutlinedButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsInquiryFeaturesModule,
                                ElementName=SettingsFeaturesRoot}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="{DynamicResource Common.JobOrder}" Margin="{StaticResource SettingsTileWrapMargin}" MinWidth="120"
                    Command="{Binding DataContext.SwitchFeaturesModuleCommand,
                                ElementName=SettingsFeaturesRoot}"
                    CommandParameter="JobOrder">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RowOutlinedButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsJobOrderFeaturesModule,
                                ElementName=SettingsFeaturesRoot}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="{DynamicResource Module.DeliveryNote}" Margin="{StaticResource SettingsTileWrapMargin}" MinWidth="130"
                    Command="{Binding DataContext.SwitchFeaturesModuleCommand,
                                ElementName=SettingsFeaturesRoot}"
                    CommandParameter="DeliveryNote">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RowOutlinedButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsDeliveryNoteFeaturesModule,
                                ElementName=SettingsFeaturesRoot}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="{DynamicResource Module.TaxInvoice}" Margin="{StaticResource SettingsTileWrapMargin}" MinWidth="120"
                    Command="{Binding DataContext.SwitchFeaturesModuleCommand,
                                ElementName=SettingsFeaturesRoot}"
                    CommandParameter="TaxInvoice">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RowOutlinedButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsTaxInvoiceFeaturesModule,
                                ElementName=SettingsFeaturesRoot}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </WrapPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}">
            <StackPanel Margin="{StaticResource SettingsPagePadding}">

                <!-- ═══════════ SESSION ═══════════
                     Bound to the parent SettingsViewModel via
                     ElementName since the descendant toggles below
                     re-scope their DataContext. Sits above everything
                     so a shift-change operator sees it first. -->
                <!-- ═══ CARD — SESSION ═══ -->
                <Border Style="{StaticResource SettingsPageCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings.Session}"
                                   Style="{StaticResource SettingsCardTitleStyle}"/>
                        <TextBlock Text="{DynamicResource Settings.SignShiftHandoverForgetAutoSignCredentials}"
                                   Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                        <StackPanel Margin="{StaticResource SettingsRowMargin}">
                            <Border Style="{StaticResource SettingsInnerTileStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE77B;"/>
                                        <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Margin="{StaticResource SettingsIconTextMargin}" VerticalAlignment="Center" Text="{DynamicResource Settings.SessionSecurity}"/>
                                    </StackPanel>
                                    <!-- Full-width action row: buttons stretch evenly
                                         across the whole card (no left-cramped gap). -->
                                    <Border 
                Style="{StaticResource SurfacePanelTileStyle}">
                                        <UniformGrid Columns="2">
                                            <Button Content="{DynamicResource Settings.ForgetDevice}"
                                                Command="{Binding DataContext.ForgetThisDeviceCommand,
                                                    ElementName=SettingsFeaturesRoot}"
                                                Style="{StaticResource SettingsActionButtonStyle}"
                                                ToolTip="{DynamicResource Settings.ClearSkipLoginVaultEntryMachineWithout}"/>
                                            <Button Content="{DynamicResource Login.SignOut}"
                                                Command="{Binding DataContext.SignOutCommand,
                                                    ElementName=SettingsFeaturesRoot}"
                                                Style="{StaticResource SettingsActionButtonStyle}"
                                                Margin="0"
                                                ToolTip="{DynamicResource Settings.EndSessionClearSkipLoginVaultEntryReturn}"/>
                                        </UniformGrid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ═══════════ PROFORMA INVOICE FIELD VISIBILITY ═══════════
                             The rest of the proforma toggles re-scope DataContext.
                             Company Name, Customer Name and Proforma ID cannot be
                             hidden — the database needs them. -->
                    </StackPanel>
                </Border>

                <StackPanel DataContext="{Binding ProformaFeatures}"
                            Visibility="{Binding DataContext.IsProformaFeaturesModule,
                                ElementName=SettingsFeaturesRoot,
                                Converter={StaticResource BoolToVisibilityConverter}}">

                <!-- ═══ CARD — PROFORMA INVOICE ═══ -->
                    <Border Style="{StaticResource SettingsPageCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Module.ProformaInvoice}"
                                   Style="{StaticResource SettingsCardTitleStyle}"/>
                            <TextBlock Text="{DynamicResource Settings.ShowHideOptionalFieldsSteps13InvoiceWizard}"
                                   Style="{StaticResource SettingsCardHeaderNoteStyle}"/>
                        <!-- ── STEP 1 · COMPANY ─────────────────────── -->
                            <TextBlock Text="{DynamicResource Settings.STEP1Company}"
                                   Style="{StaticResource SettingsGroupCaptionStyle}"
                                   Margin="{StaticResource SettingsStackGap18}"/>
                            <TextBlock Text="{DynamicResource Settings.CompanyNameProformaIDStayVisibleRequired}"
                                   Style="{StaticResource SettingsRowMetaStyle}"/>

                            <UniformGrid Columns="4" Margin="{StaticResource SettingsRowMargin}">
                                <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;"/>
                                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource ProformaInvoice.FederalTRN}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.15DigitUAETaxRegistrationNumber}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowCompanyTrn}"
                                        AutomationProperties.Name="{DynamicResource ProformaInvoice.FederalTRN}"
                                        />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;"/>
                                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource ProformaInvoice.Headquarters}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.ShortCityEmirateLinePrintedLetterhead}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowCompanyLocation}"
                                        AutomationProperties.Name="{DynamicResource ProformaInvoice.Headquarters}"
                                        />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;"/>
                                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource CompanyCenter.Representative}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.NamePersonSigningBehalfCompany}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowRepresentative}"
                                        AutomationProperties.Name="{DynamicResource CompanyCenter.Representative}"
                                        />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;"/>
                                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource Settings.RepresentativeMobile}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.DirectNumberSigningRepresentative}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowRepresentativeMobile}"
                                        AutomationProperties.Name="{DynamicResource Settings.RepresentativeMobile}"
                                        />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;"/>
                                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource CompanyCenter.CompanyEMAIL}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.ContactEMailPrintedHeader}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowCompanyEmail}"
                                        AutomationProperties.Name="{DynamicResource CompanyCenter.CompanyEMAIL}"
                                        />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;"/>
                                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource CompanyCenter.BANKNAME}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.PayeeBankNameInvoiceFooter}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowBankName}"
                                        AutomationProperties.Name="{DynamicResource CompanyCenter.BANKNAME}"
                                        />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;"/>
                                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource ProformaInvoice.AccountIBAN}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.AccountNumberIBANPairedBankName}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowAccountNumber}"
                                        AutomationProperties.Name="{DynamicResource ProformaInvoice.AccountIBAN}"
                                        />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;"/>
                                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource ProformaInvoice.IssueDATE}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.DateProformaIssuedDefaultsTodayWhenHidden}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowIssueDate}"
                                        AutomationProperties.Name="{DynamicResource ProformaInvoice.IssueDATE}"
                                        />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;"/>
                                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource ProformaInvoice.ValidUntil}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.QuotationExpiryDate}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowValidUntil}"
                                        AutomationProperties.Name="{DynamicResource ProformaInvoice.ValidUntil}"
                                        />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsInnerTileStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE8D4;"/>
                                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource Common.Status}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.DraftSentApprovedWorkflowPicker}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowProformaStatus}"
                                        AutomationProperties.Name="{DynamicResource Common.Status}"
                                        />
                                    </Grid>
                                </Border>
                            </UniformGrid>

                        <!-- ── STEP 2 · CLIENT ─────────────────────── -->
                            <TextBlock Text="{DynamicResource Settings.STEP2Client}"
                                   Style="{StaticResource SettingsGroupCaptionStyle}"
                                   Margin="{StaticResource SettingsStackGap18}"/>
                            <TextBlock Text="{DynamicResource Settings.CustomerNameStaysVisibleRequiredDatabase}"
                                   Style="{StaticResource SettingsRowMetaStyle}"/>

                            <UniformGrid Columns="4" Margin="{StaticResource SettingsRowMargin}">
                                <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE716;"/>
                                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource ProformaInvoice.CustomerTRN}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.ClientSTaxRegistrationNumber}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowCustomerTrn}"
                                        AutomationProperties.Name="{DynamicResource ProformaInvoice.CustomerTRN}"
                                        />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE716;"/>
                                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource ProformaInvoice.ReferenceCODE}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.InternalCustomerCodeCRMKeyLedgerCodeEtc}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowCustomerReferenceCode}"
                                        AutomationProperties.Name="{DynamicResource ProformaInvoice.ReferenceCODE}"
                                        />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE716;"/>
                                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource ProformaInvoice.SalesRepresentative}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.SalespersonWhoOwnsDeal}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowSalesRepresentative}"
                                        AutomationProperties.Name="{DynamicResource ProformaInvoice.SalesRepresentative}"
                                        />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE716;"/>
                                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource Inquiry.Prepared2}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.OperatorWhoTypedQuotation}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowDocumentPreparedBy}"
                                        AutomationProperties.Name="{DynamicResource Inquiry.Prepared2}"
                                        />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE716;"/>
                                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource Settings.AttentionKindAttn}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.PersonInvoiceShouldAddressed}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowAttentionExecutive}"
                                        AutomationProperties.Name="{DynamicResource Settings.AttentionKindAttn}"
                                        />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE716;"/>
                                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource Settings.ClientPhone}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.BillContactPhoneNumber}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowClientContactPhone}"
                                        AutomationProperties.Name="{DynamicResource Settings.ClientPhone}"
                                        />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SettingsInnerTileStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Typography.Icon}" Text="&#xE716;"/>
                                                <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="{DynamicResource ProformaInvoice.BillingAddress}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="1" Style="{StaticResource SettingsRowMetaStyle}" Text="{DynamicResource Settings.MultiLinePostalAddressInvoiceHeader}"/>
                                        <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowBillingAddress}"
                                        AutomationProperties.Name="{DynamicResource ProformaInvoice.BillingAddress}"
                                        />
                                    </Grid>
                                </Border>
                            </UniformGrid>

                        <!-- ── STEP 3 · PROJECT ─────────────────────── -->
                            <TextBlock Text="{DynamicResource Settings.STEP3Project}"
                                   Style="{StaticResource SettingsGroupCaptionStyle}"
                                   Margin="{StaticResource SettingsStackGap18}"/>

                            <UniformGrid Columns="3" Margin="{StaticResource SettingsRowMargin}">
                                <Border Style="{StaticResource SettingsInnerTileStyle}" Margin="{StaticResource SettingsTrailingGap}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                Style="{StaticResource SettingsInnerTileStyle}">
                                            <StackPanel>
