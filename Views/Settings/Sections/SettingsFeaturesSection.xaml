                            <StackPanel Grid.Row="0" Style="{StaticResource SettingsTileHeaderPanelStyle}">
                                <TextBlock Style="{StaticResource SettingsTileIconStyle}" Text="&#xE8D4;"/>
                                <TextBlock Style="{StaticResource SettingsTileTitleStyle}" Text="SWIFT"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Style="{StaticResource SettingsTileCaptionStyle}" Text="Bank routing code for international transfers."/>
                            <ToggleButton Grid.Row="3" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowSwiftCode}"/>
                        </Grid>
                    </Border>
                </UniformGrid>

                </StackPanel>   <!-- close DataContext=TaxInvoiceFeatures scope -->
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
