<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Settings/Sections/SettingsFeaturesSection.xaml
     PROJECT: ProGlassAutomation
     MODULE: Settings v2 — FEATURES page

     Per-module UI toggles. Right now it hosts the Proforma Invoice
     field-visibility pills (Steps 1-3); future modules can plug in
     below without a schema migration.

     UX contract:
       • DB-required fields never appear here — Company Name, Customer
         Name and Proforma ID are always visible in the wizard.
       • Every toggle is an iPhone-style PiToggleSwitch, off = field
         hidden in the wizard, on = field visible. Defaults are ALL
         ON so an install upgrade is byte-identical.
       • Changes persist immediately (no Apply / Save button) and the
         wizard reacts live thanks to ProformaFieldVisibility.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Settings.Sections.SettingsFeaturesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../SettingsSectionStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Two-column layout for a labelled toggle row. -->
            <Style x:Key="ToggleRowGridStyle" TargetType="Grid">
                <Setter Property="Margin" Value="0,6,0,6"/>
            </Style>

            <Style x:Key="ToggleRowLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="ToggleRowHintStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="StepHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,26,32,14">
            <TextBlock Text="Features" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Turn individual fields on or off without touching code. Hiding a field only affects the UI — the value stays on disk and reappears when you re-enable it."
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      behaviors:SmoothScrollBehavior.IsEnabled="True"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}">
            <StackPanel Margin="32,0,32,32" DataContext="{Binding ProformaFeatures}">

                <!-- ── HEADER + BULK ACTIONS ─────────────────────── -->
                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Proforma Invoice"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="Show or hide optional fields in Steps 1 – 3 of the invoice wizard. Company Name, Customer Name and Proforma ID cannot be hidden — the database needs them."
                                       Style="{StaticResource ToggleRowHintStyle}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Enable all"
                                    Command="{Binding EnableAllCommand}"
                                    Style="{StaticResource OutlinedPillButton}"
                                    Margin="0,0,8,0"
                                    ToolTip="Show every optional field in the wizard."/>
                            <Button Content="Hide all optional"
                                    Command="{Binding DisableAllOptionalCommand}"
                                    Style="{StaticResource OutlinedPillButton}"
                                    Margin="0,0,8,0"
                                    ToolTip="Collapse every optional field. The three DB-required fields stay visible."/>
                            <Button Content="Reset defaults"
                                    Command="{Binding ResetToDefaultsCommand}"
                                    Style="{StaticResource OutlinedPillButton}"
                                    ToolTip="Restore the out-of-the-box layout (every field visible)."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══════════════ STEP 1 — COMPANY ══════════════ -->
                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Step 1 · Company" Style="{StaticResource StepHeaderStyle}"/>
                        <TextBlock Text="Company Name and Proforma ID stay visible (required by the database)."
                                   Style="{StaticResource ToggleRowHintStyle}" Margin="0,-4,0,8"/>

                        <Grid Style="{StaticResource ToggleRowGridStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Federal TRN" Style="{StaticResource ToggleRowLabelStyle}"/>
                                <TextBlock Text="15-digit UAE Tax Registration Number." Style="{StaticResource ToggleRowHintStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowCompanyTrn}"/>
                        </Grid>

                        <Grid Style="{StaticResource ToggleRowGridStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Headquarters" Style="{StaticResource ToggleRowLabelStyle}"/>
                                <TextBlock Text="Short city / emirate line printed on the letterhead." Style="{StaticResource ToggleRowHintStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowCompanyLocation}"/>
                        </Grid>

                        <Grid Style="{StaticResource ToggleRowGridStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Representative" Style="{StaticResource ToggleRowLabelStyle}"/>
                                <TextBlock Text="Name of the person signing on behalf of the company." Style="{StaticResource ToggleRowHintStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowRepresentative}"/>
                        </Grid>

                        <Grid Style="{StaticResource ToggleRowGridStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Representative mobile" Style="{StaticResource ToggleRowLabelStyle}"/>
                                <TextBlock Text="Direct number of the signing representative." Style="{StaticResource ToggleRowHintStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowRepresentativeMobile}"/>
                        </Grid>

                        <Grid Style="{StaticResource ToggleRowGridStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Company e-mail" Style="{StaticResource ToggleRowLabelStyle}"/>
                                <TextBlock Text="Contact e-mail printed under the header." Style="{StaticResource ToggleRowHintStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowCompanyEmail}"/>
                        </Grid>

                        <Grid Style="{StaticResource ToggleRowGridStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Bank name" Style="{StaticResource ToggleRowLabelStyle}"/>
                                <TextBlock Text="Payee bank name on the invoice footer." Style="{StaticResource ToggleRowHintStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowBankName}"/>
                        </Grid>

                        <Grid Style="{StaticResource ToggleRowGridStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Account / IBAN" Style="{StaticResource ToggleRowLabelStyle}"/>
                                <TextBlock Text="Account number or IBAN paired with the bank name." Style="{StaticResource ToggleRowHintStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowAccountNumber}"/>
                        </Grid>

                        <Grid Style="{StaticResource ToggleRowGridStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Issue date" Style="{StaticResource ToggleRowLabelStyle}"/>
                                <TextBlock Text="Date the proforma is issued. Defaults to today when hidden." Style="{StaticResource ToggleRowHintStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowIssueDate}"/>
                        </Grid>

                        <Grid Style="{StaticResource ToggleRowGridStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Valid until" Style="{StaticResource ToggleRowLabelStyle}"/>
                                <TextBlock Text="Quotation expiry date." Style="{StaticResource ToggleRowHintStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowValidUntil}"/>
                        </Grid>

                        <Grid Style="{StaticResource ToggleRowGridStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Status" Style="{StaticResource ToggleRowLabelStyle}"/>
                                <TextBlock Text="Draft / Sent / Approved workflow picker." Style="{StaticResource ToggleRowHintStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowProformaStatus}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ══════════════ STEP 2 — CLIENT ═══════════════ -->
                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Step 2 · Client" Style="{StaticResource StepHeaderStyle}"/>
                        <TextBlock Text="Customer Name stays visible (required by the database)."
                                   Style="{StaticResource ToggleRowHintStyle}" Margin="0,-4,0,8"/>

                        <Grid Style="{StaticResource ToggleRowGridStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Customer TRN" Style="{StaticResource ToggleRowLabelStyle}"/>
                                <TextBlock Text="Client's Tax Registration Number." Style="{StaticResource ToggleRowHintStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowCustomerTrn}"/>
                        </Grid>

                        <Grid Style="{StaticResource ToggleRowGridStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Reference code" Style="{StaticResource ToggleRowLabelStyle}"/>
                                <TextBlock Text="Internal customer code (CRM key, ledger code, etc.)." Style="{StaticResource ToggleRowHintStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowCustomerReferenceCode}"/>
                        </Grid>

                        <Grid Style="{StaticResource ToggleRowGridStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Sales representative" Style="{StaticResource ToggleRowLabelStyle}"/>
                                <TextBlock Text="Salesperson who owns the deal." Style="{StaticResource ToggleRowHintStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowSalesRepresentative}"/>
                        </Grid>

                        <Grid Style="{StaticResource ToggleRowGridStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Prepared by" Style="{StaticResource ToggleRowLabelStyle}"/>
                                <TextBlock Text="Operator who typed up the quotation." Style="{StaticResource ToggleRowHintStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowDocumentPreparedBy}"/>
                        </Grid>

                        <Grid Style="{StaticResource ToggleRowGridStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Attention (Kind Attn.)" Style="{StaticResource ToggleRowLabelStyle}"/>
                                <TextBlock Text="Person the invoice should be addressed to." Style="{StaticResource ToggleRowHintStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowAttentionExecutive}"/>
                        </Grid>

                        <Grid Style="{StaticResource ToggleRowGridStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Client phone" Style="{StaticResource ToggleRowLabelStyle}"/>
                                <TextBlock Text="Bill-to contact phone number." Style="{StaticResource ToggleRowHintStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowClientContactPhone}"/>
                        </Grid>

                        <Grid Style="{StaticResource ToggleRowGridStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Billing address" Style="{StaticResource ToggleRowLabelStyle}"/>
                                <TextBlock Text="Multi-line postal address for the invoice header." Style="{StaticResource ToggleRowHintStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowBillingAddress}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ══════════════ STEP 3 — PROJECT ══════════════ -->
                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Step 3 · Project" Style="{StaticResource StepHeaderStyle}"/>

                        <Grid Style="{StaticResource ToggleRowGridStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Project name" Style="{StaticResource ToggleRowLabelStyle}"/>
                                <TextBlock Text="Short project handle used across lists and invoices." Style="{StaticResource ToggleRowHintStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowProjectName}"/>
                        </Grid>

                        <Grid Style="{StaticResource ToggleRowGridStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Project reference" Style="{StaticResource ToggleRowLabelStyle}"/>
                                <TextBlock Text="Full descriptive reference (e.g. 'HOUSE FOR IMAD HABIB')." Style="{StaticResource ToggleRowHintStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowProjectReference}"/>
                        </Grid>

                        <Grid Style="{StaticResource ToggleRowGridStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Contract number" Style="{StaticResource ToggleRowLabelStyle}"/>
                                <TextBlock Text="Internal contract identifier (e.g. '428 IMAD HABIB')." Style="{StaticResource ToggleRowHintStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowContractNo}"/>
                        </Grid>

                        <Grid Style="{StaticResource ToggleRowGridStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="LPO / PO number" Style="{StaticResource ToggleRowLabelStyle}"/>
                                <TextBlock Text="Client-supplied purchase order number." Style="{StaticResource ToggleRowHintStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowLpoNumber}"/>
                        </Grid>

                        <Grid Style="{StaticResource ToggleRowGridStyle}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Site / delivery location" Style="{StaticResource ToggleRowLabelStyle}"/>
                                <TextBlock Text="Emirate or specific site where glass will be delivered." Style="{StaticResource ToggleRowHintStyle}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource PiToggleSwitch}" IsChecked="{Binding ShowSiteDeliveryLocation}"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
