<!-- ═══════════════════════════════════════════════════════════════
     FILE: Views/Optimization/Tabs/JobsTabView.xaml
     MODULE: Optimization — Jobs tab (hosted by OptimizationView).
     DataContext = OptimizationViewModel (inherited from the shell).
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Optimization.Tabs.JobsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

                <!-- ── TAB 0 · JOBS ─────────────────────────────────── -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ═ LEFT · CONFIRMED JOB ORDERS ═ -->
                    <Border Grid.Column="0" Style="{StaticResource OptPanelCard}" Margin="0,0,16,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="CONFIRMED JOB ORDERS · SOURCE LOCK"
                                       Style="{StaticResource OptPanelTitle}" Margin="0,0,0,12"/>

                            <TextBox Grid.Row="1" Text="{Binding JobSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModuleListFilterInputStyle}" Margin="0,0,0,12"
                                     ToolTip="Filter by job id, customer or summary"/>

                            <ListBox Grid.Row="2" ItemsSource="{Binding FilteredJobs}"
                                     Style="{StaticResource OptListBox}"
                                     ItemContainerStyle="{StaticResource OptListBoxItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource OptInnerCard}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                          VerticalAlignment="Top" Margin="0,2,12,0"
                                                          Style="{StaticResource LiquidGlassCheckBox}"
                                                          ToolTip="Tick to include this job's panes — tick many jobs to combine (e.g. shared low-e outers merge into one cutting group)"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding JobOrderId}" FontSize="{DynamicResource FontSize.Body}"
                                                               FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding SourceLabel, Mode=OneWay}"
                                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                                               Foreground="{DynamicResource AccentBrush}" Margin="0,1,0,0"/>
                                                    <TextBlock Text="{Binding CustomerName}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,8"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="{DynamicResource TintBlueBrush}" CornerRadius="{DynamicResource Radius.Small}" Padding="8,3" Style="{StaticResource SurfacePrimaryStyle}">
                                                            <TextBlock Text="{Binding PiecesLabel}" FontSize="{DynamicResource FontSize.Caption}"
                                                                       FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource AccentBrush}"/>
                                                        </Border>
                                                        <Border Background="{DynamicResource TintAmberBrush}" CornerRadius="{DynamicResource Radius.Small}" Padding="8,3" Margin="6,0,0,0" Style="{StaticResource SurfacePrimaryStyle}">
                                                            <TextBlock Text="{Binding AreaLabel}" FontSize="{DynamicResource FontSize.Caption}"
                                                                       FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource WarningBrush}"/>
                                                        </Border>
                                                        <Border Background="{DynamicResource TintGreenBrush}" CornerRadius="{DynamicResource Radius.Small}" Padding="8,3" Margin="6,0,0,0" Style="{StaticResource SurfacePrimaryStyle}">
                                                            <TextBlock Text="{Binding SpecCountLabel}" FontSize="{DynamicResource FontSize.Caption}"
                                                                       FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource SuccessBrush}"/>
                                                        </Border>
                                                        <!-- Import warnings: skipped rows, defaulted quantities,
                                                             unparsed specs — the cutting list for this job is NOT
                                                             exactly what Step 5 says until these are read. -->
                                                        <Border Visibility="{Binding WarningVisibility}"
                                                                Background="{DynamicResource TintAmberBrush}" CornerRadius="{DynamicResource Radius.Small}" Padding="8,3" Margin="6,0,0,0"
                                                                Style="{StaticResource SurfacePrimaryStyle}"
                                                                ToolTip="{Binding WarningSummary, Mode=OneWay}">
                                                            <TextBlock Text="{Binding WarningLabel}" FontSize="{DynamicResource FontSize.Caption}"
                                                                       FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource WarningBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="3">
                                <TextBlock Text="{Binding JobsStatusText}" FontSize="{DynamicResource FontSize.BodySmall}"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="0,4,0,10"/>
                                <Button Content="Refresh jobs" Style="{StaticResource OutlinedPillButton}"
                                        Command="{Binding RefreshJobsCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ═ RIGHT · PANE BREAKDOWN + CUTTING LIST ═ -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- STEP 4/5 pane breakdown checklist -->
                        <Border Grid.Row="0" Style="{StaticResource OptPanelCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="STEP 4/5 PANE BREAKDOWN — SELECT THE PANES TO CUT"
                                           Style="{StaticResource OptPanelTitle}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedPaneSummary}" FontSize="{DynamicResource FontSize.BodySmall}"
                                           FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>

                                <!-- empty hint — SENIOR 2026-09-20: auto-import -->
                                <TextBlock Text="Tick job orders on the left — their Step 4/5 panes (outer → inner) auto-import into breakdown and cutting list, merged by matching spec+glass+size."
                                           FontSize="{DynamicResource FontSize.Body}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,12"
                                           Visibility="{Binding HasPaneChecklist, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                                            Visibility="{Binding HasPaneChecklist, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button Content="Select all" Style="{StaticResource OutlinedPillButton}"
                                            Command="{Binding SelectAllPanesCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Clear" Style="{StaticResource OutlinedPillButton}"
                                            Command="{Binding ClearPaneSelectionCommand}"/>
                                </StackPanel>

                                <!-- checklist header -->
                                <Grid Margin="0,0,0,6" Visibility="{Binding HasPaneChecklist, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="86"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="PANE" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Grid.Column="2" Text="SPEC" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Grid.Column="3" Text="GLASS COMPOSITION" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Grid.Column="4" Text="PCS" Style="{StaticResource OptHeader}" TextAlignment="Right" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="5" Text="AREA" Style="{StaticResource OptHeader}" TextAlignment="Right"/>
                                </Grid>

                                <!-- checklist rows -->
                                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding HasPaneChecklist, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl ItemsSource="{Binding PaneChecklist}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="4,7" BorderThickness="0,0,0,1"
                                                        BorderBrush="{DynamicResource DividerBrush}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="34"/>
                                                            <ColumnDefinition Width="96"/>
                                                            <ColumnDefinition Width="64"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="72"/>
                                                            <ColumnDefinition Width="86"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                                  VerticalAlignment="Center"
                                                                  Style="{StaticResource LiquidGlassCheckBox}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Sub}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                                   FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource AccentBrush}"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding SpecLabel}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Title}" FontSize="{DynamicResource FontSize.Body}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding CountLabel}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding AreaLabel}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   VerticalAlignment="Center" TextAlignment="Right"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Button Content="{Binding AddPanesButtonLabel}" Style="{StaticResource PrimaryPillButton}"
                                        Command="{Binding AddSelectedPanesCommand}"
                                        HorizontalAlignment="Stretch" Margin="0,12,0,0"
                                        Visibility="{Binding HasPaneChecklist, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>

                        <!-- CUTTING LIST -->
                        <Border Grid.Row="1" Style="{StaticResource OptPanelCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- title + tools -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="CUTTING LIST" Style="{StaticResource OptPanelTitle}"/>
                                        <TextBlock Text="{Binding PieceSummary}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Clear list" Style="{StaticResource OptGhostButton}"
                                                Command="{Binding ClearPiecesCommand}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- ad-hoc add row -->
                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="LABEL" Style="{StaticResource OptHeader}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Width="150" Text="{Binding NewPiece.PieceLabel, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OptIntInput}" Margin="0,0,14,0"
                                             behaviors:TextBoxBehaviors.AcceptIntegersOnly="False" ToolTip="Piece ref / label"/>
                                    <TextBlock Grid.Column="2" Text="W (MM)" Style="{StaticResource OptHeader}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="3" Width="86" Text="{Binding NewPiece.WidthText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OptIntInput}" Margin="0,0,14,0"/>
                                    <TextBlock Grid.Column="4" Text="H (MM)" Style="{StaticResource OptHeader}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="5" Width="86" Text="{Binding NewPiece.HeightText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OptIntInput}" Margin="0,0,14,0"/>
                                    <TextBlock Grid.Column="6" Text="QTY" Style="{StaticResource OptHeader}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="7" Width="60" Text="{Binding NewPiece.QtyText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OptIntInput}" Margin="0,0,14,0"/>
                                    <Button Grid.Column="8" Content="+ Add" Style="{StaticResource PrimaryPillButton}"
                                            Command="{Binding AddPieceCommand}"/>
                                </Grid>

                                <!-- empty hint -->
                                <TextBlock Grid.Row="3" Text="{Binding PiecesEmptyHint}" FontSize="{DynamicResource FontSize.Body}"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Top" Margin="4,8,4,0"
                                           Visibility="{Binding HasPieces, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                                <!-- header -->
                                <Grid Grid.Row="2" Margin="0,0,0,6"
                                      Visibility="{Binding HasPieces, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="76"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="LABEL / PANE" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Grid.Column="1" Text="GLASS COMPOSITION" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Grid.Column="2" Text="W × H (MM)" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Grid.Column="3" Text="QTY" Style="{StaticResource OptHeader}"/>
                                    <!-- PHASE 8 / finding 8e: per-pane rotation lock -->
                                    <TextBlock Grid.Column="4" Text="ROT LOCK" Style="{StaticResource OptHeader}" HorizontalAlignment="Center"
                                               ToolTip="Untick a pane to let the engine also try it turned 90 degrees. Ticking it locks the orientation you entered. SETTINGS Rotation still governs every unlocked pane."/>
                                    <TextBlock Grid.Column="4" Text="ACTION" Style="{StaticResource OptHeader}" TextAlignment="Right"/>
                                </Grid>

                                <!-- rows -->
                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding HasPieces, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl ItemsSource="{Binding Pieces}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="4,7" BorderThickness="0,0,0,1"
                                                        BorderBrush="{DynamicResource DividerBrush}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="76"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding PieceLabel}" FontSize="{DynamicResource FontSize.Body}"
                                                                       FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Position}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                                       Foreground="{DynamicResource AccentBrush}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding GlassRef}" FontSize="{DynamicResource FontSize.Body}"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="2" FontSize="{DynamicResource FontSize.Body}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center">
                                                            <Run Text="{Binding WidthText, Mode=OneWay}"/><Run Text="×"/><Run Text="{Binding HeightText, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBox Grid.Column="3" Text="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource OptIntInput}" Width="48" HorizontalAlignment="Left" Margin="0,0,4,0"
                                                                 ToolTip="Edit the quantity — the cut plan and run update automatically"/>
                                                        <CheckBox Grid.Column="4" IsChecked="{Binding RotationLocked, UpdateSourceTrigger=PropertyChanged}"
                                                                  VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,6,0"
                                                                  ToolTip="Ticked means this pane must NOT be turned 90 degrees. Unticked means the engine may rotate it if SETTINGS Rotation allows. Saved with the session."/>
                                                        <Button Grid.Column="5" Content="Remove" Style="{StaticResource OptGhostButton}"
                                                                HorizontalAlignment="Right"
                                                                Command="{Binding DataContext.RemovePieceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
</UserControl>
