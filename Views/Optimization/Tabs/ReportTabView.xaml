<!-- ═══════════════════════════════════════════════════════════════
     FILE: Views/Optimization/Tabs/ReportTabView.xaml
     MODULE: Optimization — Reports tab (hosted by OptimizationView).
     DataContext = OptimizationViewModel (inherited from the shell).

     The owner's industrial cut report leads this tab: grouped by glass
     composition, one utilization line per spec × sheet size, then a
     GLASS REF / W1 / H1 / W2 / H2 / QTY / TOTAL SQM piece table per
     spec. The legacy layout / parts / stocks session summaries follow.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Optimization.Tabs.ReportTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

                <!-- ── TAB 6 · REPORT ──────────────────────────────── -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="6">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <!-- ── Report header ── -->
                            <Border Style="{StaticResource OptPanelCard}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="OPTIMIZATION REPORT" Style="{StaticResource OptPanelTitle}"/>
                                            <TextBlock Text="{Binding ResultStage}" FontSize="{StaticResource TextCaption}"
                                                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource TintBlueBrush}" Padding="12,7"
                                                    VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding ResultOracle}" FontSize="{StaticResource TextCaption}"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="EXPORT ALL SUMMARIES" Style="{StaticResource OptHeader}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <Button Content="CSV" Style="{StaticResource OutlinedPillButton}" Margin="0,0,6,0"
                                                            Command="{Binding ExportAllCommand}" CommandParameter="CSV"
                                                            ToolTip="Layout + Parts + Stocks summaries as one CSV"/>
                                                    <Button Content="Excel" Style="{StaticResource OutlinedPillButton}" Margin="0,0,6,0"
                                                            Command="{Binding ExportAllCommand}" CommandParameter="Excel"
                                                            ToolTip="Layout + Parts + Stocks summaries as one Excel workbook"/>
                                                    <Button Content="PDF" Style="{StaticResource PrimaryPillButton}"
                                                            Command="{Binding ExportAllCommand}" CommandParameter="PDF"
                                                            ToolTip="Layout + Parts + Stocks summaries as one PDF"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="SHEETS" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Text="{Binding ResultSheets}" FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="UTILIZATION" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Text="{Binding ResultUtilization}" FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                                       Foreground="{DynamicResource SuccessBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="OFFCUT" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Text="{Binding ResultWaste}" FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                                       Foreground="{DynamicResource WarningBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="UNPLACED" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Text="{Binding ResultUnplaced}" FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="GLASS AREA" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Text="{Binding KpiGlass}" FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- ══ 1 · INDUSTRIAL CUT REPORT ══ -->
                            <Border Style="{StaticResource OptPanelCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="1 · INDUSTRIAL CUT REPORT" Style="{StaticResource OptPanelTitle}"/>
                                            <TextBlock Text="Grouped by glass composition — thickness, spec, sheet size, utilized quantity and utilization %, then the glass-ref size table per spec."
                                                       FontSize="{StaticResource TextCaption}" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="CSV" Style="{StaticResource OutlinedPillButton}" Margin="0,0,6,0"
                                                    Command="{Binding ExportIndustrialReportCommand}" CommandParameter="CSV"
                                                    ToolTip="Export the owner-format report (utilization lines + GLASS REF / W1 / H1 / W2 / H2 / QTY / TOTAL SQM tables) as CSV"/>
                                            <Button Content="Excel" Style="{StaticResource OutlinedPillButton}" Margin="0,0,6,0"
                                                    Command="{Binding ExportIndustrialReportCommand}" CommandParameter="Excel"
                                                    ToolTip="Export the industrial cut report as a sectioned Excel workbook"/>
                                            <Button Content="PDF" Style="{StaticResource PrimaryPillButton}"
                                                    Command="{Binding ExportIndustrialReportCommand}" CommandParameter="PDF"
                                                    ToolTip="Export the industrial cut report as a paginated PDF"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- empty hint -->
                                    <TextBlock Text="No report yet — add pieces on the JOBS tab, then run a cut."
                                               FontSize="{StaticResource TextBody}" Foreground="{DynamicResource MutedForegroundBrush}"
                                               TextWrapping="Wrap" Margin="0,0,0,8"
                                               Visibility="{Binding HasIndustrialReport, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                                    <ItemsControl ItemsSource="{Binding IndustrialReport}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource OptInnerCard}" Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <!-- spec heading -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding ThicknessLabel}" FontSize="{StaticResource TextBody}"
                                                                       FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                            <TextBlock Text="{Binding SpecName}" FontSize="{StaticResource TextBody}"
                                                                       FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                       Margin="8,0,0,0"/>
                                                            <TextBlock Text="{Binding Composition}" FontSize="{StaticResource TextCaption}"
                                                                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="10,1,0,0"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>

                                                        <!-- utilization line(s) -->
                                                        <ItemsControl ItemsSource="{Binding Utilization}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Line}" FontSize="{StaticResource TextBody}"
                                                                               FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,1,0,4">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Tone}" Value="Mid">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Tone}" Value="Low">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <TextBlock Text="— not yet optimized —" FontSize="{StaticResource TextCaption}"
                                                                   Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,6"
                                                                   Visibility="{Binding HasUtilization, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                                                        <!-- piece table -->
                                                        <Grid Margin="0,6,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="72"/>
                                                                <ColumnDefinition Width="72"/>
                                                                <ColumnDefinition Width="72"/>
                                                                <ColumnDefinition Width="72"/>
                                                                <ColumnDefinition Width="64"/>
                                                                <ColumnDefinition Width="104"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="GLASS REF" Style="{StaticResource OptHeader}"/>
                                                            <TextBlock Grid.Column="1" Text="W1" Style="{StaticResource OptHeader}" TextAlignment="Right"/>
                                                            <TextBlock Grid.Column="2" Text="H1" Style="{StaticResource OptHeader}" TextAlignment="Right"/>
                                                            <TextBlock Grid.Column="3" Text="W2" Style="{StaticResource OptHeader}" TextAlignment="Right"/>
                                                            <TextBlock Grid.Column="4" Text="H2" Style="{StaticResource OptHeader}" TextAlignment="Right"/>
                                                            <TextBlock Grid.Column="5" Text="QTY" Style="{StaticResource OptHeader}" TextAlignment="Right"/>
                                                            <TextBlock Grid.Column="6" Text="TOTAL SQM" Style="{StaticResource OptHeader}" TextAlignment="Right"/>
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{Binding Pieces}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Padding="0,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="72"/>
                                                                                <ColumnDefinition Width="72"/>
                                                                                <ColumnDefinition Width="72"/>
                                                                                <ColumnDefinition Width="72"/>
                                                                                <ColumnDefinition Width="64"/>
                                                                                <ColumnDefinition Width="104"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="{Binding GlassRef}" FontSize="{StaticResource TextBody}"
                                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding W1}" FontSize="{StaticResource TextBody}"
                                                                                       Foreground="{DynamicResource SecondaryForegroundBrush}" TextAlignment="Right"/>
                                                                            <TextBlock Grid.Column="2" Text="{Binding H1}" FontSize="{StaticResource TextBody}"
                                                                                       Foreground="{DynamicResource SecondaryForegroundBrush}" TextAlignment="Right"/>
                                                                            <TextBlock Grid.Column="3" Text="{Binding W2}" FontSize="{StaticResource TextBody}"
                                                                                       Foreground="{DynamicResource SecondaryForegroundBrush}" TextAlignment="Right"/>
                                                                            <TextBlock Grid.Column="4" Text="{Binding H2}" FontSize="{StaticResource TextBody}"
                                                                                       Foreground="{DynamicResource SecondaryForegroundBrush}" TextAlignment="Right"/>
                                                                            <TextBlock Grid.Column="5" Text="{Binding Qty}" FontSize="{StaticResource TextBody}"
                                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}" TextAlignment="Right"/>
                                                                            <TextBlock Grid.Column="6" Text="{Binding TotalSqm}" FontSize="{StaticResource TextBody}"
                                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}" TextAlignment="Right"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- ══ 2 · LAYOUT SUMMARY ══ -->
                            <Border Style="{StaticResource OptPanelCard}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="2 · LAYOUT SUMMARY" Style="{StaticResource OptPanelTitle}"/>
                                            <TextBlock Text="Every sheet the engine produced — stock, pieces, utilization and offcut."
                                                       FontSize="{StaticResource TextCaption}" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="CSV" Style="{StaticResource OutlinedPillButton}" Margin="0,0,6,0"
                                                    Command="{Binding ExportLayoutReportCommand}" CommandParameter="CSV"/>
                                            <Button Content="Excel" Style="{StaticResource OutlinedPillButton}" Margin="0,0,6,0"
                                                    Command="{Binding ExportLayoutReportCommand}" CommandParameter="Excel"/>
                                            <Button Content="PDF" Style="{StaticResource OutlinedPillButton}"
                                                    Command="{Binding ExportLayoutReportCommand}" CommandParameter="PDF"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="1">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="SHEET" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="1" Text="GLASS" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="2" Text="STOCK (MM)" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="3" Text="PIECES" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="4" Text="UTILIZATION" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="5" Text="OFFCUT" Style="{StaticResource OptHeader}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding SheetRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="4,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="70"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="130"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="110"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding SheetNo}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Composition}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding StockLabel}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding PieceCount}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding Utilization}" FontSize="{StaticResource TextBody}"
                                                                       FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding UtilizationTone}" Value="Mid">
                                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding UtilizationTone}" Value="Low">
                                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="5" Text="{Binding WasteLabel}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ══ 3 · PARTS SUMMARY ══ -->
                            <Border Style="{StaticResource OptPanelCard}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="3 · PARTS SUMMARY" Style="{StaticResource OptPanelTitle}"/>
                                            <TextBlock Text="Merged glass groups — the cutting list summarized by composition."
                                                       FontSize="{StaticResource TextCaption}" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="CSV" Style="{StaticResource OutlinedPillButton}" Margin="0,0,6,0"
                                                    Command="{Binding ExportPartsReportCommand}" CommandParameter="CSV"/>
                                            <Button Content="Excel" Style="{StaticResource OutlinedPillButton}" Margin="0,0,6,0"
                                                    Command="{Binding ExportPartsReportCommand}" CommandParameter="Excel"/>
                                            <Button Content="PDF" Style="{StaticResource OutlinedPillButton}"
                                                    Command="{Binding ExportPartsReportCommand}" CommandParameter="PDF"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="1">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="GLASS COMPOSITION" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="1" Text="THICKNESS" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="2" Text="PIECES" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="3" Text="AREA (M²)" Style="{StaticResource OptHeader}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding SizeGroups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="4,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="110"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Composition}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Thickness}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource AccentBrush}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding PieceCount}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding AreaM2}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ══ 4 · STOCKS SUMMARY ══ -->
                            <Border Style="{StaticResource OptPanelCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="4 · STOCKS SUMMARY" Style="{StaticResource OptPanelTitle}"/>
                                            <TextBlock Text="{Binding StocksStatusText}" FontSize="{StaticResource TextCaption}"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="CSV" Style="{StaticResource OutlinedPillButton}" Margin="0,0,6,0"
                                                    Command="{Binding ExportStocksReportCommand}" CommandParameter="CSV"/>
                                            <Button Content="Excel" Style="{StaticResource OutlinedPillButton}" Margin="0,0,6,0"
                                                    Command="{Binding ExportStocksReportCommand}" CommandParameter="Excel"/>
                                            <Button Content="PDF" Style="{StaticResource OutlinedPillButton}"
                                                    Command="{Binding ExportStocksReportCommand}" CommandParameter="PDF"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="1">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="190"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="SHEET (MM)" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="1" Text="GLASS / GROUP" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="2" Text="AVAILABLE" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="3" Text="USED" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="4" Text="SOURCE" Style="{StaticResource OptHeader}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Stocks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="4,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="160"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="190"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}">
                                                                <Run Text="{Binding WidthText, Mode=OneWay}"/><Run Text="×"/><Run Text="{Binding HeightText, Mode=OneWay}"/>
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="1" Text="{Binding CompositionLabel}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding AvailableText}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding UsedLabel}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource AccentBrush}"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding SourceLabel}" FontSize="{StaticResource TextCaption}"
                                                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ══ 5 · SAVED SESSIONS ══ -->
                            <Border Style="{StaticResource OptPanelCard}" Margin="0,16,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="5 · SAVED SESSIONS" Style="{StaticResource OptPanelTitle}"/>
                                            <TextBlock Text="{Binding SessionStatus}" FontSize="{StaticResource TextCaption}"
                                                       Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Save session" Style="{StaticResource PrimaryPillButton}" Margin="0,0,8,0"
                                                    Command="{Binding SaveSessionCommand}"
                                                    ToolTip="Snapshot the cutting list, Step 4 stock pool and margins so the layout can be reopened later"/>
                                            <Button Content="Refresh" Style="{StaticResource OutlinedPillButton}"
                                                    Command="{Binding RefreshSessionsCommand}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="No saved sessions yet — save the current cutting list to reopen it later."
                                               FontSize="{StaticResource TextBody}" Foreground="{DynamicResource MutedForegroundBrush}"
                                               TextWrapping="Wrap" Margin="0,0,0,8"
                                               Visibility="{Binding HasSessions, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                                    <ItemsControl ItemsSource="{Binding SavedSessions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource OptInnerCard}" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="{StaticResource TextBody}"
                                                                       FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Detail}" FontSize="{StaticResource TextCaption}"
                                                                       Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,2,0,0"/>
                                                            <TextBlock Text="{Binding CreatedLabel}" FontSize="{StaticResource TextCaption}"
                                                                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,1,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="Open" Style="{StaticResource OutlinedPillButton}" Margin="0,0,8,0"
                                                                    Command="{Binding DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Content="Delete" Style="{StaticResource OptGhostButton}"
                                                                    Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
</UserControl>
