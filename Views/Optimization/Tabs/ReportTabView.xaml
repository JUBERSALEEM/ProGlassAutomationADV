<!-- ═══════════════════════════════════════════════════════════════
     FILE: Views/Optimization/Tabs/ReportTabView.xaml
     MODULE: Optimization — Reports tab (hosted by OptimizationView).
     DataContext = OptimizationViewModel (inherited from the shell).

     Consolidated industry report over the current session:
       1 · LAYOUT SUMMARY  (per-sheet cut plan)
       2 · PARTS SUMMARY   (merged glass groups / cutting list)
       3 · STOCKS SUMMARY  (Step 4 rack pool + usage)
     Each section exports CSV through the shared report engine.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Optimization.Tabs.ReportTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

                <!-- ── TAB 6 · REPORT ──────────────────────────────── -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="6">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <!-- ── Report header ── -->
                            <Border Style="{StaticResource OptPanelCard}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="OPTIMIZATION REPORT" Style="{StaticResource OptPanelTitle}"/>
                                            <TextBlock Text="{Binding ResultStage}" FontSize="{StaticResource TextCaption}"
                                                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource TintBlueBrush}" Padding="12,7"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ResultOracle}" FontSize="{StaticResource TextCaption}"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="SHEETS" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Text="{Binding ResultSheets}" FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="UTILIZATION" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Text="{Binding ResultUtilization}" FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                                       Foreground="{DynamicResource SuccessBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="OFFCUT" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Text="{Binding ResultWaste}" FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                                       Foreground="{DynamicResource WarningBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="UNPLACED" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Text="{Binding ResultUnplaced}" FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="GLASS AREA" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Text="{Binding KpiGlass}" FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- ── 1 · LAYOUT SUMMARY ── -->
                            <Border Style="{StaticResource OptPanelCard}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="1 · LAYOUT SUMMARY" Style="{StaticResource OptPanelTitle}"/>
                                            <TextBlock Text="Every sheet the engine produced — stock, pieces, utilization and offcut."
                                                       FontSize="{StaticResource TextCaption}" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Export CSV" Style="{StaticResource OutlinedPillButton}"
                                                Command="{Binding ExportLayoutReportCommand}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Grid.Row="1">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="SHEET" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="1" Text="GLASS" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="2" Text="STOCK (MM)" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="3" Text="PIECES" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="4" Text="UTILIZATION" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="5" Text="OFFCUT" Style="{StaticResource OptHeader}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding SheetRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Cursor="Hand" HorizontalContentAlignment="Stretch"
                                                            Command="{Binding DataContext.SelectSheetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding Index}" ToolTip="Open in 2D view">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Row" Padding="4,8" BorderThickness="0,0,0,1"
                                                                        BorderBrush="{DynamicResource DividerBrush}">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="70"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="130"/>
                                                                            <ColumnDefinition Width="80"/>
                                                                            <ColumnDefinition Width="110"/>
                                                                            <ColumnDefinition Width="110"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding SheetNo}" FontSize="{StaticResource TextBody}"
                                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding Composition}" FontSize="{StaticResource TextBody}"
                                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding StockLabel}" FontSize="{StaticResource TextBody}"
                                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                                        <TextBlock Grid.Column="3" Text="{Binding PieceCount}" FontSize="{StaticResource TextBody}"
                                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                                        <TextBlock Grid.Column="4" Text="{Binding Utilization}" FontSize="{StaticResource TextBody}"
                                                                                   Foreground="{DynamicResource SuccessBrush}"/>
                                                                        <TextBlock Grid.Column="5" Text="{Binding WasteLabel}" FontSize="{StaticResource TextBody}"
                                                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                                    </Grid>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ── 2 · PARTS SUMMARY ── -->
                            <Border Style="{StaticResource OptPanelCard}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="2 · PARTS SUMMARY" Style="{StaticResource OptPanelTitle}"/>
                                            <TextBlock Text="{Binding PieceSummary}" FontSize="{StaticResource TextCaption}"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Export CSV" Style="{StaticResource OutlinedPillButton}"
                                                Command="{Binding ExportPartsReportCommand}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Grid.Row="1">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="GLASS COMPOSITION" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="1" Text="THICKNESS" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="2" Text="PIECES" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="3" Text="AREA (M²)" Style="{StaticResource OptHeader}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding SizeGroups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="4,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="110"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Composition}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Thickness}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource AccentBrush}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding PieceCount}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding AreaM2}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ── 3 · STOCKS SUMMARY ── -->
                            <Border Style="{StaticResource OptPanelCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="3 · STOCKS SUMMARY" Style="{StaticResource OptPanelTitle}"/>
                                            <TextBlock Text="{Binding StocksStatusText}" FontSize="{StaticResource TextCaption}"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Export CSV" Style="{StaticResource OutlinedPillButton}"
                                                Command="{Binding ExportStocksReportCommand}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Grid.Row="1">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="190"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="SHEET (MM)" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="1" Text="GLASS / GROUP" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="2" Text="AVAILABLE" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="3" Text="USED" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="4" Text="SOURCE" Style="{StaticResource OptHeader}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Stocks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="4,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="160"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="190"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}">
                                                                <Run Text="{Binding WidthText, Mode=OneWay}"/><Run Text="×"/><Run Text="{Binding HeightText, Mode=OneWay}"/>
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="1" Text="{Binding CompositionLabel}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding AvailableText}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding UsedLabel}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource AccentBrush}"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding SourceLabel}" FontSize="{StaticResource TextCaption}"
                                                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
</UserControl>
