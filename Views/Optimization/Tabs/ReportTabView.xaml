<!-- ═══════════════════════════════════════════════════════════════
     FILE: Views/Optimization/Tabs/ReportTabView.xaml
     MODULE: Optimization — Reports Tab (Studio Bento Redesign)
     DataContext = OptimizationViewModel (inherited from the shell).

     Studio Bento layout:
     Top: Production Cutting Plan Tickets, Barcode Header, CNC Protocol Pills
          (Bottero, Lisec, Intermac, DXF), Export Actions (CSV, Excel, PDF).
     Body: 1. Industrial Cut Schedule, 2. Nested Sheets Summary,
           3. Merged Specifications Summary, 4. Stock Plates Allocation.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Optimization.Tabs.ReportTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Visibility="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=6}"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Dashboard/Overview/IndigoStudioResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <DataTemplate x:Key="IndustrialSpecColumnTemplate">
                                    <Border Style="{StaticResource OptInnerCard}" Margin="0,0,0,12" Padding="14,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SpecName}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Grid.ColumnSpan="3"
                                                        Background="{DynamicResource TintIndigoBrush}"
                                                        BorderBrush="{DynamicResource AccentBrush}"
                                                        BorderThickness="1" CornerRadius="4" Padding="8,3"
                                                        Visibility="{Binding HasColorPair, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                    <TextBlock FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding ThicknessLabel, Mode=OneWay}"/>
                                                        <Run Text="  "/>
                                                        <Run Text="{Binding ColorLabel, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Border>
                                                <Border Grid.Column="0"
                                                        Background="{DynamicResource TintIndigoBrush}"
                                                        BorderBrush="{DynamicResource AccentBrush}"
                                                        BorderThickness="1" CornerRadius="4" Padding="8,3"
                                                        Visibility="{Binding HasColorPair, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding OuterColor}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                                <Border Grid.Column="2"
                                                        Background="{DynamicResource TintIndigoBrush}"
                                                        BorderBrush="{DynamicResource AccentBrush}"
                                                        BorderThickness="1" CornerRadius="4" Padding="8,3"
                                                        Visibility="{Binding HasColorPair, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding InnerColor}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                            </Grid>

                                            <!-- Utilization Line(s) -->
                                            <ItemsControl ItemsSource="{Binding Utilization}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Line}" FontSize="12" FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" Margin="0,1,0,4">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource OptSuccessInk}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Tone}" Value="Mid">
                                                                            <Setter Property="Foreground" Value="{StaticResource OptWarningInk}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Tone}" Value="Low">
                                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="— not yet optimized —" FontSize="11"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,6"
                                                       Visibility="{Binding HasUtilization, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                                            <!-- Piece Table Header -->
                                            <Border Background="{DynamicResource SurfaceSecondaryBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="6" Padding="8,4" Margin="0,6,0,2"
                                                    HorizontalAlignment="Stretch">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3.2*" MinWidth="104"/>
                                                        <ColumnDefinition Width="0.85*" MinWidth="40" MaxWidth="120"/>
                                                        <ColumnDefinition Width="0.85*" MinWidth="40" MaxWidth="120"/>
                                                        <ColumnDefinition Width="0.85*" MinWidth="40" MaxWidth="120"/>
                                                        <ColumnDefinition Width="0.85*" MinWidth="40" MaxWidth="120"/>
                                                        <ColumnDefinition Width="0.8*" MinWidth="34" MaxWidth="100"/>
                                                        <ColumnDefinition Width="1.3*" MinWidth="54" MaxWidth="170"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="GLASS REF" Style="{StaticResource OptHeader}"/>
                                                    <TextBlock Grid.Column="1" Text="W1" Style="{StaticResource OptHeader}"/>
                                                    <TextBlock Grid.Column="2" Text="H1" Style="{StaticResource OptHeader}"/>
                                                    <TextBlock Grid.Column="3" Text="W2" Style="{StaticResource OptHeader}"/>
                                                    <TextBlock Grid.Column="4" Text="H2" Style="{StaticResource OptHeader}"/>
                                                    <TextBlock Grid.Column="5" Text="QTY" Style="{StaticResource OptHeader}"/>
                                                    <TextBlock Grid.Column="6" Text="SQM" Style="{StaticResource OptHeader}"/>
                                                </Grid>
                                            </Border>

                                            <!-- Piece Table Rows -->
                                            <ItemsControl ItemsSource="{Binding Pieces}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="8,3" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}"
                                                                HorizontalAlignment="Stretch">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="3.2*" MinWidth="104"/>
                                                                    <ColumnDefinition Width="0.85*" MinWidth="40" MaxWidth="120"/>
                                                                    <ColumnDefinition Width="0.85*" MinWidth="40" MaxWidth="120"/>
                                                                    <ColumnDefinition Width="0.85*" MinWidth="40" MaxWidth="120"/>
                                                                    <ColumnDefinition Width="0.85*" MinWidth="40" MaxWidth="120"/>
                                                                    <ColumnDefinition Width="0.8*" MinWidth="34" MaxWidth="100"/>
                                                                    <ColumnDefinition Width="1.3*" MinWidth="54" MaxWidth="170"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding GlassRef}" FontSize="12"
                                                                           Margin="0,0,16,0"
                                                                           FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding W1}" FontSize="12"
                                                                           Foreground="{DynamicResource SecondaryForegroundBrush}" TextAlignment="Right"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding H1}" FontSize="12"
                                                                           Foreground="{DynamicResource SecondaryForegroundBrush}" TextAlignment="Right"/>
                                                                <TextBlock Grid.Column="3" Text="{Binding W2}" FontSize="12"
                                                                           Foreground="{DynamicResource SecondaryForegroundBrush}" TextAlignment="Right"/>
                                                                <TextBlock Grid.Column="4" Text="{Binding H2}" FontSize="12"
                                                                           Foreground="{DynamicResource SecondaryForegroundBrush}" TextAlignment="Right"/>
                                                                <TextBlock Grid.Column="5" Text="{Binding Qty}" FontSize="12" FontWeight="Bold"
                                                                           Foreground="{DynamicResource PrimaryForegroundBrush}" TextAlignment="Right"/>
                                                                <TextBlock Grid.Column="6" Text="{Binding TotalSqm}" FontSize="12" FontWeight="Bold"
                                                                           Foreground="{DynamicResource PrimaryForegroundBrush}" TextAlignment="Right"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- ══ PRODUCTION TICKET & EXPORT HEADER BENTO CARD ══ -->
                <Border Style="{StaticResource OptPanelCard}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top Strip: Title + Export Actions -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="6"
                                            Background="{DynamicResource TintIndigoBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                            Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="PRODUCTION CUTTING REPORT" Style="{StaticResource OptPanelTitle}" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource TintIndigoBrush}" BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="SHOP FLOOR TICKET" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding ResultStage}" FontSize="12"
                                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="38,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border CornerRadius="6" Background="{StaticResource OptSuccessBg}"
                                        BorderBrush="{StaticResource OptSuccessBorder}" BorderThickness="1"
                                        Padding="10,6" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding ResultOracle}" FontSize="11"
                                               FontWeight="Bold" Foreground="{StaticResource OptSuccessInk}"/>
                                </Border>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="EXPORT REPORT" Style="{StaticResource OptHeader}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button Content="CSV" Style="{StaticResource OptOutlinedButton}" Height="32" Padding="12,0" Margin="0,0,6,0"
                                                Command="{Binding ExportAllCommand}" CommandParameter="CSV"
                                                ToolTip="Export complete batch data to CSV"/>
                                        <Button Content="Excel" Style="{StaticResource OptOutlinedButton}" Height="32" Padding="12,0" Margin="0,0,6,0"
                                                Command="{Binding ExportAllCommand}" CommandParameter="Excel"
                                                ToolTip="Export structured workbook with formulas &amp; costing"/>
                                        <Button Content="Print PDF Ticket" Style="{StaticResource OptPrimaryButton}" Height="32" Padding="16,0"
                                                Command="{Binding ExportAllCommand}" CommandParameter="PDF"
                                                ToolTip="Export shop floor printable cutting tickets"/>
                                    </StackPanel>
                                    <Button Content="Print Glass Stickers" Style="{StaticResource OptOutlinedButton}"
                                            Height="30" Padding="12,0" Margin="0,6,0,0" HorizontalAlignment="Left"
                                            Command="{Binding PrintStickersCommand}"
                                            ToolTip="Preview, customize stock dimensions and print labels from the current Optimization panes"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- CNC Machine Protocols Bar -->
                        <Border Grid.Row="1" Background="{DynamicResource SurfaceSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,10" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="CNC MACHINE PROTOCOLS:" Style="{StaticResource OptHeader}"
                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <!-- CNC protocols. Each pill exports the finished plan in that
                                     format. Formats whose specification is not public explain what
                                     would finish them instead of writing a file nobody can vouch
                                     for — see Services/Reporting/CncExport/CncExportFormats.cs. -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding ExportCncCommand}" CommandParameter="bottero"
                                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,8,0" Cursor="Hand"
                                            ToolTip="Bottero .OPT — not implemented. Click for what would finish it.">
                                        <Border Background="{DynamicResource SurfacePrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                            <TextBlock Text="Bottero .OPT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        </Border>
                                    </Button>
                                    <Button Command="{Binding ExportCncCommand}" CommandParameter="lisec"
                                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,8,0" Cursor="Hand"
                                            ToolTip="Lisec .DAT — not implemented. Click for what would finish it.">
                                        <Border Background="{DynamicResource TintIndigoBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                            <TextBlock Text="Lisec .DAT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Button>
                                    <Button Command="{Binding ExportCncCommand}" CommandParameter="intermac"
                                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,8,0" Cursor="Hand"
                                            ToolTip="Intermac .ISO — not implemented. Click for what would finish it.">
                                        <Border Background="{DynamicResource SurfacePrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                            <TextBlock Text="Intermac .ISO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        </Border>
                                    </Button>
                                    <Button Command="{Binding ExportCncCommand}" CommandParameter="dxf"
                                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,8,0" Cursor="Hand"
                                            ToolTip="Generic DXF (R12) — sheet outline, every pane, and the cut sequence in execution order.">
                                        <Border Background="{DynamicResource SurfacePrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                            <TextBlock Text="Generic DXF" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        </Border>
                                    </Button>
                                    <Button Command="{Binding ExportCncCommand}" CommandParameter="cutlist"
                                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                            ToolTip="Cut list CSV — one row per cut: sheet, sequence, axis, position, stage, trim.">
                                        <Border Background="{DynamicResource SurfacePrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                            <TextBlock Text="Cut list CSV" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        </Border>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Bento KPI Cards Strip -->
                        <UniformGrid Grid.Row="2" Columns="3" Margin="-6,8,-6,0">

                            <Border Grid.Column="0" Style="{StaticResource OptInnerCard}" Margin="6" Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="SHEETS" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Text="{Binding ResultSheets}" Style="{StaticResource OptKpiValue}" FontSize="22" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource OptInnerCard}" Margin="6" Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="UTILIZATION" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Text="{Binding ResultUtilization}" Style="{StaticResource OptKpiValue}" FontSize="22"
                                               Foreground="{StaticResource OptSuccessInk}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource OptInnerCard}" Margin="6" Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="OFFCUT" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Text="{Binding ResultWaste}" Style="{StaticResource OptKpiValue}" FontSize="22"
                                               Foreground="{StaticResource OptWarningInk}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Style="{StaticResource OptInnerCard}" Margin="6" Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="UNPLACED" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Text="{Binding ResultUnplaced}" Style="{StaticResource OptKpiValue}" FontSize="22" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource OptInnerCard}" Margin="6" Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="GLASS AREA" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Text="{Binding KpiGlass}" Style="{StaticResource OptKpiValue}" FontSize="22" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>

                <!-- ══ 1 · INDUSTRIAL CUT SCHEDULE BENTO CARD ══ -->
                <Border Style="{StaticResource OptPanelCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="1 · INDUSTRIAL CUT SCHEDULE" Style="{StaticResource OptPanelTitle}"/>
                                <TextBlock Text="Grouped by glass specification — thickness, composition, sheet sizes, and piece cutting schedule table."
                                           FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Empty Hint -->
                        <TextBlock Text="No report generated yet — select pieces on the JOBS tab, then run a cut."
                                   FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding HasIndustrialReport, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                        <ItemsControl ItemsSource="{Binding IndustrialReportBands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentControl Grid.Column="0" Grid.ColumnSpan="3"
                                                        Content="{Binding Outer}"
                                                        ContentTemplate="{StaticResource IndustrialSpecColumnTemplate}"
                                                        Visibility="{Binding IsSingle, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <ContentControl Grid.Column="0"
                                                        Content="{Binding Outer}"
                                                        ContentTemplate="{StaticResource IndustrialSpecColumnTemplate}"
                                                        Visibility="{Binding HasInner, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <ContentControl Grid.Column="2"
                                                        Content="{Binding Inner}"
                                                        ContentTemplate="{StaticResource IndustrialSpecColumnTemplate}"
                                                        Visibility="{Binding HasInner, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ══ 2 · LAYOUT SUMMARY BENTO CARD ══ -->
                <Border Style="{StaticResource OptPanelCard}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="2 · NESTED SHEETS SUMMARY" Style="{StaticResource OptPanelTitle}"/>
                        </Grid>
                        <StackPanel Grid.Row="1">
                            <Border Background="{DynamicResource SurfaceSecondaryBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="8,4" Margin="0,0,0,4"
                                    HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" MinWidth="74" MaxWidth="130"/>
                                        <ColumnDefinition Width="3.2*" MinWidth="150"/>
                                        <ColumnDefinition Width="1.6*" MinWidth="96" MaxWidth="260"/>
                                        <ColumnDefinition Width="0.85*" MinWidth="58" MaxWidth="110"/>
                                        <ColumnDefinition Width="1.15*" MinWidth="80" MaxWidth="150"/>
                                        <ColumnDefinition Width="1.15*" MinWidth="76" MaxWidth="170"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="SHEET #" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Grid.Column="1" Text="GLASS SPECIFICATION" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Grid.Column="2" Text="STOCK (MM)" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Grid.Column="3" Text="PIECES" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Grid.Column="4" Text="UTILIZATION" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Grid.Column="5" Text="OFFCUT" Style="{StaticResource OptHeader}"/>
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding SheetRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,3" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}"
                                                HorizontalAlignment="Stretch">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*" MinWidth="74" MaxWidth="130"/>
                                                    <ColumnDefinition Width="3.2*" MinWidth="150"/>
                                                    <ColumnDefinition Width="1.6*" MinWidth="96" MaxWidth="260"/>
                                                    <ColumnDefinition Width="0.85*" MinWidth="58" MaxWidth="110"/>
                                                    <ColumnDefinition Width="1.15*" MinWidth="80" MaxWidth="150"/>
                                                    <ColumnDefinition Width="1.15*" MinWidth="76" MaxWidth="170"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{DynamicResource TintIndigoBrush}"
                                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                                        CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SheetNo, StringFormat='Sheet #{0}'}"
                                                               FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Composition}" FontSize="12"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding StockLabel}" FontSize="12"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding PieceCount, StringFormat='{}{0} pcs'}" FontSize="12"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center"/>
                                                <Border Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        CornerRadius="4" Padding="6,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource OptSuccessBg}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding UtilizationTone}" Value="Mid">
                                                                    <Setter Property="Background" Value="{StaticResource OptWarningBg}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding UtilizationTone}" Value="Low">
                                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Utilization}" FontSize="11" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource OptSuccessInk}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding UtilizationTone}" Value="Mid">
                                                                        <Setter Property="Foreground" Value="{StaticResource OptWarningInk}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding UtilizationTone}" Value="Low">
                                                                        <Setter Property="Foreground" Value="#991B1B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Grid.Column="5" Text="{Binding WasteLabel}" FontSize="12"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding SheetRowsOverflowLabel}" FontSize="11" FontStyle="Italic"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,6,0,0"
                                       Visibility="{Binding HasSheetRowsOverflow, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══ 3 + 4 · SIDE-BY-SIDE SUMMARY CARDS ════════════════════════════════════
                     Two half-width bento cards (like the Industrial Cut Schedule band above):
                     3 · Merged Specifications Summary | 4 · Stock Plates Allocation.
                     Both cards stretch to their column and fill it, so no dead space remains.
                ═══════════════════════════════════════════════════════════════════════════ -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- ══ 3 · MERGED SUMMARY BENTO CARD ══ -->
                    <Border Grid.Column="0" Style="{StaticResource OptPanelCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="3 · MERGED SPECIFICATIONS SUMMARY" Style="{StaticResource OptPanelTitle}"/>
                            </Grid>
                            <StackPanel Grid.Row="1">
                                <Border Background="{DynamicResource SurfaceSecondaryBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="8,4" Margin="0,0,0,4"
                                        HorizontalAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3.2*" MinWidth="110"/>
                                            <ColumnDefinition Width="0.9*" MinWidth="46" MaxWidth="110"/>
                                            <ColumnDefinition Width="0.85*" MinWidth="52" MaxWidth="105"/>
                                            <ColumnDefinition Width="1.1*" MinWidth="62" MaxWidth="130"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="COLOUR" Style="{StaticResource OptHeader}"/>
                                        <TextBlock Grid.Column="1" Text="THICK" Style="{StaticResource OptHeader}"/>
                                        <TextBlock Grid.Column="2" Text="PCS" Style="{StaticResource OptHeader}"/>
                                        <TextBlock Grid.Column="3" Text="M²" Style="{StaticResource OptHeader}"/>
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding SizeGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,3" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}"
                                                    HorizontalAlignment="Stretch">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3.2*" MinWidth="110"/>
                                                        <ColumnDefinition Width="0.9*" MinWidth="46" MaxWidth="110"/>
                                                        <ColumnDefinition Width="0.85*" MinWidth="52" MaxWidth="105"/>
                                                        <ColumnDefinition Width="1.1*" MinWidth="62" MaxWidth="130"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Composition}" FontSize="12"
                                                               FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Thickness}" FontSize="12"
                                                               Foreground="{DynamicResource AccentBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding PieceCount, StringFormat='{}{0} pcs'}" FontSize="12"
                                                               FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding AreaM2, StringFormat='{}{0} m²'}" FontSize="12"
                                                               FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ══ 4 · STOCK PLATES BENTO CARD ══ -->
                    <Border Grid.Column="2" Style="{StaticResource OptPanelCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="4 · STOCK PLATES ALLOCATION" Style="{StaticResource OptPanelTitle}"/>
                                <TextBlock Text="One row per colour and plate size. Specs cut together are listed once."
                                           FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1">
                                <Border Background="{DynamicResource SurfaceSecondaryBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="8,4" Margin="0,0,0,4"
                                        HorizontalAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*" MinWidth="88" MaxWidth="150"/>
                                            <ColumnDefinition Width="2.4*" MinWidth="96"/>
                                            <ColumnDefinition Width="1.4*" MinWidth="94" MaxWidth="130"/>
                                            <ColumnDefinition Width="1.9*" MinWidth="88" MaxWidth="190"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="PLATE" Style="{StaticResource OptHeader}"/>
                                        <TextBlock Grid.Column="1" Text="COLOUR" Style="{StaticResource OptHeader}"/>
                                        <TextBlock Grid.Column="2" Text="USED" Style="{StaticResource OptHeader}"/>
                                        <TextBlock Grid.Column="3" Text="SOURCE" Style="{StaticResource OptHeader}"/>
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding AllocationRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,3" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}"
                                                    HorizontalAlignment="Stretch">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.5*" MinWidth="88" MaxWidth="150"/>
                                                        <ColumnDefinition Width="2.4*" MinWidth="96"/>
                                                        <ColumnDefinition Width="1.4*" MinWidth="94" MaxWidth="130"/>
                                                        <ColumnDefinition Width="1.9*" MinWidth="88" MaxWidth="190"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding SizeLabel}" FontSize="12"
                                                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ColorLabel}" FontSize="12"
                                                               FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding UsedLabel}" FontSize="12"
                                                               FontWeight="Bold" Foreground="{StaticResource OptSuccessInk}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding SourceLabel}" FontSize="11"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>