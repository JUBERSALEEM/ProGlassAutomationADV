<!-- ═══════════════════════════════════════════════════════════════
     FILE: Views/Optimization/Tabs/ReportTabView.xaml
     MODULE: Optimization — Reports tab (hosted by OptimizationView).
     DataContext = OptimizationViewModel (inherited from the shell).

     The owner's industrial cut report leads this tab: grouped by glass
     composition, one utilization line per spec × sheet size, then a
     GLASS REF / W1 / H1 / W2 / H2 / QTY / TOTAL SQM piece table per
     spec. The legacy layout / parts / stocks session summaries follow.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Optimization.Tabs.ReportTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

                <!-- ── TAB 6 · REPORT ──────────────────────────────── -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="6">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <!-- ── Report header ── -->
                            <Border Style="{StaticResource OptPanelCard}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="OPTIMIZATION REPORT" Style="{StaticResource OptPanelTitle}"/>
                                            <TextBlock Text="{Binding ResultStage}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource TintBlueBrush}" Padding="12,7"
                                                    VerticalAlignment="Center" Margin="0,0,16,0" Style="{StaticResource SurfacePrimaryStyle}">
                                                <TextBlock Text="{Binding ResultOracle}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                           FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="EXPORT FULL REPORT" Style="{StaticResource OptHeader}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <Button Content="CSV" Style="{StaticResource OutlinedPillButton}" Margin="0,0,6,0"
                                                            Command="{Binding ExportAllCommand}" CommandParameter="CSV"
                                                            ToolTip="One CSV: run summary, Step 4 priced costing, industrial cut report, layout, parts and stocks"/>
                                                    <Button Content="Excel" Style="{StaticResource OutlinedPillButton}" Margin="0,0,6,0"
                                                            Command="{Binding ExportAllCommand}" CommandParameter="Excel"
                                                            ToolTip="One Excel workbook: run summary, Step 4 priced costing, industrial cut report, layout, parts and stocks. Money stays numeric."/>
                                                    <Button Content="PDF" Style="{StaticResource PrimaryPillButton}"
                                                            Command="{Binding ExportAllCommand}" CommandParameter="PDF"
                                                            ToolTip="One paginated PDF: run summary, Step 4 priced costing, industrial cut report, layout, parts and stocks"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="SHEETS"/>
                                            <TextBlock Text="{Binding ResultSheets}" FontSize="{DynamicResource FontSize.H2}" FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="UTILIZATION"/>
                                            <TextBlock Text="{Binding ResultUtilization}" FontSize="{DynamicResource FontSize.H2}" FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource SuccessBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="OFFCUT"/>
                                            <TextBlock Text="{Binding ResultWaste}" FontSize="{DynamicResource FontSize.H2}" FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource WarningBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="UNPLACED"/>
                                            <TextBlock Text="{Binding ResultUnplaced}" FontSize="{DynamicResource FontSize.H2}" FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="GLASS AREA"/>
                                            <TextBlock Text="{Binding KpiGlass}" FontSize="{DynamicResource FontSize.H2}" FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- ══ 1 · INDUSTRIAL CUT REPORT ══ -->
                            <Border Style="{StaticResource OptPanelCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="1 · INDUSTRIAL CUT REPORT"/>
                                            <TextBlock Text="Grouped by glass composition — thickness, spec, sheet size, utilized quantity and utilization %, then the glass-ref size table per spec."
                                                       FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- empty hint -->
                                    <TextBlock Text="No report yet — add pieces on the JOBS tab, then run a cut."
                                               FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextTertiaryBrush}"
                                               TextWrapping="Wrap" Margin="0,0,0,8"
                                               Visibility="{Binding HasIndustrialReport, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                                    <ItemsControl ItemsSource="{Binding IndustrialReport}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource OptInnerCard}" Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <!-- spec heading -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding ThicknessLabel}" FontSize="{DynamicResource FontSize.Body}"
                                                                       FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource AccentBrush}"/>
                                                            <TextBlock Text="{Binding SpecName}" FontSize="{DynamicResource FontSize.Body}"
                                                                       FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       Margin="8,0,0,0"/>
                                                            <TextBlock Text="{Binding Composition}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="10,1,0,0"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>

                                                        <!-- utilization line(s) -->
                                                        <ItemsControl ItemsSource="{Binding Utilization}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Line}" FontSize="{DynamicResource FontSize.Body}"
                                                                               FontWeight="{DynamicResource Weight.SemiBold}" TextWrapping="Wrap" Margin="0,1,0,4">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Tone}" Value="Mid">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Tone}" Value="Low">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <TextBlock Text="— not yet optimized —" FontSize="{DynamicResource FontSize.BodySmall}"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,6"
                                                                   Visibility="{Binding HasUtilization, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                                                        <!-- piece table -->
                                                        <Grid Margin="0,6,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="72"/>
                                                                <ColumnDefinition Width="72"/>
                                                                <ColumnDefinition Width="72"/>
                                                                <ColumnDefinition Width="72"/>
                                                                <ColumnDefinition Width="64"/>
                                                                <ColumnDefinition Width="104"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="GLASS REF" Style="{StaticResource OptHeader}"/>
                                                            <TextBlock Grid.Column="1" Text="W1" Style="{StaticResource OptHeader}" TextAlignment="Right"/>
                                                            <TextBlock Grid.Column="2" Text="H1" Style="{StaticResource OptHeader}" TextAlignment="Right"/>
                                                            <TextBlock Grid.Column="3" Text="W2" Style="{StaticResource OptHeader}" TextAlignment="Right"/>
                                                            <TextBlock Grid.Column="4" Text="H2" Style="{StaticResource OptHeader}" TextAlignment="Right"/>
                                                            <TextBlock Grid.Column="5" Text="QTY" Style="{StaticResource OptHeader}" TextAlignment="Right"/>
                                                            <TextBlock Grid.Column="6" Text="TOTAL SQM" Style="{StaticResource OptHeader}" TextAlignment="Right"/>
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{Binding Pieces}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Padding="0,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="72"/>
                                                                                <ColumnDefinition Width="72"/>
                                                                                <ColumnDefinition Width="72"/>
                                                                                <ColumnDefinition Width="72"/>
                                                                                <ColumnDefinition Width="64"/>
                                                                                <ColumnDefinition Width="104"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="{Binding GlassRef}" FontSize="{DynamicResource FontSize.Body}"
                                                                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding W1}" FontSize="{DynamicResource FontSize.Body}"
                                                                                       Foreground="{DynamicResource SecondaryForegroundBrush}" TextAlignment="Right"/>
                                                                            <TextBlock Grid.Column="2" Text="{Binding H1}" FontSize="{DynamicResource FontSize.Body}"
                                                                                       Foreground="{DynamicResource SecondaryForegroundBrush}" TextAlignment="Right"/>
                                                                            <TextBlock Grid.Column="3" Text="{Binding W2}" FontSize="{DynamicResource FontSize.Body}"
                                                                                       Foreground="{DynamicResource SecondaryForegroundBrush}" TextAlignment="Right"/>
                                                                            <TextBlock Grid.Column="4" Text="{Binding H2}" FontSize="{DynamicResource FontSize.Body}"
                                                                                       Foreground="{DynamicResource SecondaryForegroundBrush}" TextAlignment="Right"/>
                                                                            <TextBlock Grid.Column="5" Text="{Binding Qty}" FontSize="{DynamicResource FontSize.Body}"
                                                                                       Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Right"/>
                                                                            <TextBlock Grid.Column="6" Text="{Binding TotalSqm}" FontSize="{DynamicResource FontSize.Body}"
                                                                                       Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Right"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- ══ 2 · LAYOUT SUMMARY ══ -->
                            <Border Style="{StaticResource OptPanelCard}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="2 · LAYOUT SUMMARY"/>
                                            <TextBlock Text="Every sheet the engine produced — stock, pieces, utilization and offcut."
                                                       FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="1">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="SHEET"/>
                                            <TextBlock Grid.Column="1" Text="GLASS"/>
                                            <TextBlock Grid.Column="2" Text="STOCK (MM)"/>
                                            <TextBlock Grid.Column="3" Text="PIECES"/>
                                            <TextBlock Grid.Column="4" Text="UTILIZATION"/>
                                            <TextBlock Grid.Column="5" Text="OFFCUT"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding SheetRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="4,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="70"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="130"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="110"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding SheetNo}" FontSize="{DynamicResource FontSize.Body}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Composition}" FontSize="{DynamicResource FontSize.Body}"
                                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding StockLabel}" FontSize="{DynamicResource FontSize.Body}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding PieceCount}" FontSize="{DynamicResource FontSize.Body}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding Utilization}" FontSize="{DynamicResource FontSize.Body}"
                                                                       FontWeight="{DynamicResource Weight.SemiBold}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding UtilizationTone}" Value="Mid">
                                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding UtilizationTone}" Value="Low">
                                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="5" Text="{Binding WasteLabel}" FontSize="{DynamicResource FontSize.Body}"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding SheetRowsOverflowLabel}" FontSize="{DynamicResource FontSize.Body}" FontStyle="Italic"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,6,0,0"
                                                   Visibility="{Binding HasSheetRowsOverflow, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ══ 3 · PARTS SUMMARY ══ -->
                            <Border Style="{StaticResource OptPanelCard}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="3 · PARTS SUMMARY" Style="{StaticResource OptPanelTitle}"/>
                                            <TextBlock Text="Merged glass groups — the cutting list summarized by composition."
                                                       FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="1">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="GLASS COMPOSITION" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="1" Text="THICKNESS" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="2" Text="PIECES" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="3" Text="AREA (M²)" Style="{StaticResource OptHeader}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding SizeGroups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="4,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="110"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Composition}" FontSize="{DynamicResource FontSize.Body}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Thickness}" FontSize="{DynamicResource FontSize.Body}"
                                                                       Foreground="{DynamicResource AccentBrush}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding PieceCount}" FontSize="{DynamicResource FontSize.Body}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding AreaM2}" FontSize="{DynamicResource FontSize.Body}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ══ 4 · STOCKS SUMMARY ══ -->
                            <Border Style="{StaticResource OptPanelCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="4 · STOCKS SUMMARY" Style="{StaticResource OptPanelTitle}"/>
                                            <TextBlock Text="{Binding StocksStatusText}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="1">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="190"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="SHEET (MM)" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="1" Text="GLASS / GROUP" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="2" Text="AVAILABLE" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="3" Text="USED" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="4" Text="SOURCE" Style="{StaticResource OptHeader}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Stocks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="4,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="160"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="190"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                                                <Run Text="{Binding WidthText, Mode=OneWay}"/><Run Text="×"/><Run Text="{Binding HeightText, Mode=OneWay}"/>
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="1" Text="{Binding CompositionLabel}" FontSize="{DynamicResource FontSize.Body}"
                                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding AvailableText}" FontSize="{DynamicResource FontSize.Body}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding UsedLabel}" FontSize="{DynamicResource FontSize.Body}"
                                                                       Foreground="{DynamicResource AccentBrush}"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding SourceLabel}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ══ 5 · STEP 4 PRICED COSTING ══ -->
                            <Border Style="{StaticResource OptPanelCard}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="5 · STEP 4 PRICED COSTING" Style="{StaticResource OptPanelTitle}"/>
                                            <TextBlock Text="What this plan costs — sheet size and quantity, utilization, and the rate Step 4 used for that sheet."
                                                       FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextTertiaryBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- empty hint -->
                                    <TextBlock Grid.Row="1" Text="No priced plan yet — run a cut and it will be costed against Step 4."
                                               FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextTertiaryBrush}"
                                               TextWrapping="Wrap" Margin="0,0,0,8"
                                               Visibility="{Binding HasCosting, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                                    <StackPanel Grid.Row="1">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="86"/>
                                                <ColumnDefinition Width="86"/>
                                                <ColumnDefinition Width="86"/>
                                                <ColumnDefinition Width="124"/>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="GLASS / GROUP" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="1" Text="SHEET SIZE (MM)" Style="{StaticResource OptHeader}"/>
                                            <TextBlock Grid.Column="2" Text="SHEETS" Style="{StaticResource OptHeader}" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="3" Text="PIECES" Style="{StaticResource OptHeader}" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="4" Text="UTIL" Style="{StaticResource OptHeader}" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="5" Text="GLASS M²" Style="{StaticResource OptHeader}" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="6" Text="STOCK M²" Style="{StaticResource OptHeader}" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="7" Text="WASTAGE M²" Style="{StaticResource OptHeader}" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="8" Text="STEP 4 RATE" Style="{StaticResource OptHeader}" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="9" Text="GLASS COST" Style="{StaticResource OptHeader}" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="10" Text="WASTAGE COST" Style="{StaticResource OptHeader}" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="11" Text="TOTAL" Style="{StaticResource OptHeader}" TextAlignment="Right"/>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding CostingRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="0,7" BorderThickness="0,0,0,1"
                                                            BorderBrush="{DynamicResource DividerBrush}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="140"/>
                                                                <ColumnDefinition Width="62"/>
                                                                <ColumnDefinition Width="62"/>
                                                                <ColumnDefinition Width="70"/>
                                                                <ColumnDefinition Width="86"/>
                                                                <ColumnDefinition Width="86"/>
                                                                <ColumnDefinition Width="86"/>
                                                                <ColumnDefinition Width="124"/>
                                                                <ColumnDefinition Width="112"/>
                                                                <ColumnDefinition Width="112"/>
                                                                <ColumnDefinition Width="120"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Composition}"
                                                                           FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                                           Foreground="{DynamicResource PrimaryForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                                                <!-- the Step 5 pane this rack was cut for, so the join
                                                                     to Step 6 / Step 9 is visible rather than trusted -->
                                                                <TextBlock Text="{Binding PaneLabel}"
                                                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                                                           Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding SheetSize}"
                                                                       FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                       Margin="0,0,8,0"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding SheetQty}" TextAlignment="Right"
                                                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding PieceQty}" TextAlignment="Right"
                                                                       FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding Utilization}" TextAlignment="Right"
                                                                       FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource AccentBrush}"/>
                                                            <TextBlock Grid.Column="5" Text="{Binding GlassArea}" TextAlignment="Right"
                                                                       FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                            <TextBlock Grid.Column="6" Text="{Binding StockArea}" TextAlignment="Right"
                                                                       FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                            <TextBlock Grid.Column="7" Text="{Binding WasteArea}" TextAlignment="Right"
                                                                       FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                            <TextBlock Grid.Column="8" Text="{Binding RateLabel}" TextAlignment="Right" Margin="8,0,0,0"
                                                                       FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                            <TextBlock Grid.Column="9" Text="{Binding GlassCostLabel}" TextAlignment="Right"
                                                                       FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                            <TextBlock Grid.Column="10" Text="{Binding WasteCostLabel}" TextAlignment="Right"
                                                                       FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                            <TextBlock Grid.Column="11" Text="{Binding TotalCostLabel}" TextAlignment="Right"
                                                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- grand total: totals cover the priced rows only -->
                                    <Grid Grid.Row="2" Margin="0,12,0,0" Visibility="{Binding HasCostingTotal, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="PLAN TOTAL" Style="{StaticResource OptHeader}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CostingTotalLabel}"
                                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                    </Grid>

                                    <!-- honest pricing caveat -->
                                    <TextBlock Grid.Row="3" Text="{Binding CostingPriceNote}" Margin="0,8,0,0"
                                               FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextTertiaryBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasCostingPriceNote, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                            </Border>

                            <!-- ══ 6 · SAVED SESSIONS ══ -->
                            <Border Style="{StaticResource OptPanelCard}" Margin="0,16,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="6 · SAVED SESSIONS" Style="{StaticResource OptPanelTitle}"/>
                                            <TextBlock Text="{Binding SessionStatus}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Save session" Style="{StaticResource PrimaryPillButton}" Margin="0,0,8,0"
                                                    Command="{Binding SaveSessionCommand}"
                                                    ToolTip="Snapshot the cutting list, Step 4 stock pool and margins so the layout can be reopened later"/>
                                            <Button Content="Refresh" Style="{StaticResource OutlinedPillButton}"
                                                    Command="{Binding RefreshSessionsCommand}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="No saved sessions yet — save the current cutting list to reopen it later."
                                               FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextTertiaryBrush}"
                                               TextWrapping="Wrap" Margin="0,0,0,8"
                                               Visibility="{Binding HasSessions, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                                    <ItemsControl ItemsSource="{Binding SavedSessions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource OptInnerCard}" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSize.Body}"
                                                                       FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Detail}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                                       Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,2,0,0"/>
                                                            <TextBlock Text="{Binding CreatedLabel}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,1,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="Open" Style="{StaticResource OutlinedPillButton}" Margin="0,0,8,0"
                                                                    Command="{Binding DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Content="Delete" Style="{StaticResource OptGhostButton}"
                                                                    Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
</UserControl>
