<!-- ═══════════════════════════════════════════════════════════════
     FILE: Views/Optimization/Tabs/SummaryTabView.xaml
     MODULE: Optimization — Summary tab (hosted by OptimizationView).
     DataContext = OptimizationViewModel (inherited from the shell).
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Optimization.Tabs.SummaryTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

                <!-- ── TAB 4 · SUMMARY ──────────────────────────────── -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="4">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Border Style="{StaticResource OptPanelCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- headline stats -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SHEETS" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Text="{Binding ResultSheets}" FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="UTILIZATION" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Text="{Binding ResultUtilization}" FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="OFFCUT" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Text="{Binding ResultWaste}" FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                               Foreground="{DynamicResource WarningBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="UNPLACED" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Text="{Binding ResultUnplaced}" FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="VERIFICATION" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Text="{Binding ResultOracle}" FontSize="{StaticResource TextCaption}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="PER-CUTTING-GROUP BREAKDOWN" Style="{StaticResource OptHeader}" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding GroupResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource OptInnerCard}" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="90"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding Composition}" FontSize="{StaticResource TextBody}"
                                                                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Note}" FontSize="{StaticResource TextCaption}"
                                                                       Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                                                                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="PIECES" Style="{StaticResource OptHeader}"/>
                                                            <TextBlock Text="{Binding PieceCount}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="SHEETS" Style="{StaticResource OptHeader}"/>
                                                            <TextBlock Text="{Binding Sheets}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3">
                                                            <TextBlock Text="UTILIZATION" Style="{StaticResource OptHeader}"/>
                                                            <TextBlock Text="{Binding Utilization}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource SuccessBrush}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="4">
                                                            <TextBlock Text="OFFCUT" Style="{StaticResource OptHeader}"/>
                                                            <TextBlock Text="{Binding Waste}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="5">
                                                            <TextBlock Text="UNPLACED" Style="{StaticResource OptHeader}"/>
                                                            <TextBlock Text="{Binding Unplaced}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding ResultStage}" FontSize="{StaticResource TextCaption}"
                                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,8"/>

                                    <TextBlock Text="SHEETS" Style="{StaticResource OptHeader}" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="SHEET" Style="{StaticResource OptHeader}"/>
                                        <TextBlock Grid.Column="1" Text="GLASS" Style="{StaticResource OptHeader}"/>
                                        <TextBlock Grid.Column="2" Text="STOCK (MM)" Style="{StaticResource OptHeader}"/>
                                        <TextBlock Grid.Column="3" Text="PIECES" Style="{StaticResource OptHeader}"/>
                                        <TextBlock Grid.Column="4" Text="UTILIZATION" Style="{StaticResource OptHeader}"/>
                                        <TextBlock Grid.Column="5" Text="OFFCUT" Style="{StaticResource OptHeader}"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding SheetRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Cursor="Hand" HorizontalContentAlignment="Stretch"
                                                        Command="{Binding DataContext.SelectSheetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Index}"
                                                        ToolTip="Open this sheet in the 2D view">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Row" Padding="4,8" BorderThickness="0,0,0,1"
                                                                    BorderBrush="{DynamicResource DividerBrush}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="60"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="110"/>
                                                                        <ColumnDefinition Width="80"/>
                                                                        <ColumnDefinition Width="90"/>
                                                                        <ColumnDefinition Width="90"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding SheetNo}" FontSize="{StaticResource TextBody}"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Composition}" FontSize="{StaticResource TextBody}"
                                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding StockLabel}" FontSize="{StaticResource TextBody}"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding PieceCount}" FontSize="{StaticResource TextBody}"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                    <TextBlock Grid.Column="4" Text="{Binding Utilization}" FontSize="{StaticResource TextBody}"
                                                                               FontWeight="SemiBold">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding UtilizationTone}" Value="Mid">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding UtilizationTone}" Value="Low">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Grid.Column="5" Text="{Binding WasteLabel}" FontSize="{StaticResource TextBody}"
                                                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Unplaced pieces -->
                                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasUnplaced, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Border CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource TintAmberBrush}" Padding="12,8" Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextBody}"
                                                           Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Pieces the engine could not place on any stock" FontSize="{StaticResource TextBody}"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding UnplacedRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="{StaticResource TextBody}"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,3"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
</UserControl>
