<!-- ═══════════════════════════════════════════════════════════════
     FILE: Views/Optimization/Tabs/SummaryTabView.xaml
     MODULE: Optimization — Summary tab (hosted by OptimizationView).
     DataContext = OptimizationViewModel (inherited from the shell).
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Optimization.Tabs.SummaryTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

                <!-- ── TAB 4 · SUMMARY ──────────────────────────────── -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="4">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Border Style="{StaticResource OptPanelCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- ── Executive KPI Metric Cards (Summary Tab) ── -->
                            <Grid Grid.Row="0" Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>

                                <!-- SHEETS -->
                                <Border Grid.Column="0" Background="{DynamicResource SurfaceSecondaryBrush}"
                                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                        CornerRadius="{DynamicResource CardCornerRadius}" Padding="14,12" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="SHEETS REQUIRED" Style="{StaticResource OptHeader}"/>
                                        <TextBlock Text="{Binding ResultSheets}" FontSize="24" FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- UTILIZATION -->
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceSecondaryBrush}"
                                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                        CornerRadius="{DynamicResource CardCornerRadius}" Padding="14,12" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="YIELD / UTILIZATION" Style="{StaticResource OptHeader}"/>
                                        <TextBlock Text="{Binding ResultUtilization}" FontSize="24" FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- OFFCUT / SCRAP -->
                                <Border Grid.Column="2" Background="{DynamicResource SurfaceSecondaryBrush}"
                                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                        CornerRadius="{DynamicResource CardCornerRadius}" Padding="14,12" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="OFFCUT / SCRAP" Style="{StaticResource OptHeader}"/>
                                        <TextBlock Text="{Binding ResultWaste}" FontSize="24" FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- UNPLACED -->
                                <Border Grid.Column="3" Background="{DynamicResource SurfaceSecondaryBrush}"
                                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                        CornerRadius="{DynamicResource CardCornerRadius}" Padding="14,12" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="UNPLACED PIECES" Style="{StaticResource OptHeader}"/>
                                        <TextBlock Text="{Binding ResultUnplaced}" FontSize="24" FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- VERIFICATION ORACLE -->
                                <Border Grid.Column="4" Background="{DynamicResource SurfaceSecondaryBrush}"
                                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                        CornerRadius="{DynamicResource CardCornerRadius}" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="INDEPENDENT ORACLE" Style="{StaticResource OptHeader}"/>
                                        <Border Background="{DynamicResource TintGreenBrush}" CornerRadius="4" Padding="8,4" Margin="0,4,0,0" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding ResultOracle}" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="PER-CUTTING-GROUP BREAKDOWN" Style="{StaticResource OptHeader}" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding GroupResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource OptInnerCard}" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="80"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding Composition}" FontSize="{DynamicResource FontSize.Body}"
                                                                       FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Note}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                                       Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                                                                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="STOCK USED"/>
                                                            <TextBlock Text="{Binding StockSize}" FontSize="{DynamicResource FontSize.Body}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="PIECES"/>
                                                            <TextBlock Text="{Binding PieceCount}" FontSize="{DynamicResource FontSize.Body}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3">
                                                            <TextBlock Text="SHEETS"/>
                                                            <TextBlock Text="{Binding Sheets}" FontSize="{DynamicResource FontSize.Body}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="4">
                                                            <TextBlock Text="UTILIZATION"/>
                                                            <TextBlock Text="{Binding Utilization}" FontSize="{DynamicResource FontSize.Body}"
                                                                       Foreground="{DynamicResource SuccessBrush}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="5">
                                                            <TextBlock Text="OFFCUT"/>
                                                            <TextBlock Text="{Binding Waste}" FontSize="{DynamicResource FontSize.Body}"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="6">
                                                            <TextBlock Text="UNPLACED"/>
                                                            <TextBlock Text="{Binding Unplaced}" FontSize="{DynamicResource FontSize.Body}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding ResultStage}" FontSize="{DynamicResource FontSize.BodySmall}"
                                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,8"/>

                                    <TextBlock Text="SHEETS" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="SHEET"/>
                                        <TextBlock Grid.Column="1" Text="GLASS"/>
                                        <TextBlock Grid.Column="2" Text="STOCK (MM)"/>
                                        <TextBlock Grid.Column="3" Text="PIECES"/>
                                        <TextBlock Grid.Column="4" Text="UTILIZATION"/>
                                        <TextBlock Grid.Column="5" Text="OFFCUT"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding SheetRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Cursor="Hand" HorizontalContentAlignment="Stretch"
                                                        Command="{Binding DataContext.SelectSheetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Index}"
                                                        ToolTip="Open this sheet in the 2D view" Style="{StaticResource SecondaryButtonStyle}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Row" Padding="4,8" BorderThickness="0,0,0,1"
                                                                    BorderBrush="{DynamicResource DividerBrush}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="60"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="110"/>
                                                                        <ColumnDefinition Width="80"/>
                                                                        <ColumnDefinition Width="90"/>
                                                                        <ColumnDefinition Width="90"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding SheetNo}" FontSize="{DynamicResource FontSize.Body}"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Composition}" FontSize="{DynamicResource FontSize.Body}"
                                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding StockLabel}" FontSize="{DynamicResource FontSize.Body}"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding PieceCount}" FontSize="{DynamicResource FontSize.Body}"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                    <TextBlock Grid.Column="4" Text="{Binding Utilization}" FontSize="{DynamicResource FontSize.Body}"
                                                                               FontWeight="{DynamicResource Weight.SemiBold}">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding UtilizationTone}" Value="Mid">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding UtilizationTone}" Value="Low">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Grid.Column="5" Text="{Binding WasteLabel}" FontSize="{DynamicResource FontSize.Body}"
                                                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceTertiaryBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding SheetRowsOverflowLabel}" FontSize="{DynamicResource FontSize.Body}" FontStyle="Italic"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,6,0,0"
                                               Visibility="{Binding HasSheetRowsOverflow, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <!-- Unplaced pieces -->
                                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasUnplaced, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Border CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource TintAmberBrush}" Padding="12,8" Margin="0,0,0,6" Style="{StaticResource SurfacePrimaryStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.Body}"
                                                           Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Pieces the engine could not place on any stock" FontSize="{DynamicResource FontSize.Body}"
                                                           FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding UnplacedRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="{DynamicResource FontSize.Body}"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,3"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding UnplacedOverflowLabel}" FontSize="{DynamicResource FontSize.Body}" FontStyle="Italic"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,3,0,0"
                                                   Visibility="{Binding HasUnplacedOverflow, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
</UserControl>
