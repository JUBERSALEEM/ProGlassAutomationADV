<!-- ═══════════════════════════════════════════════════════════════
     FILE: Views/Optimization/Tabs/SettingsTabView.xaml
     MODULE: Optimization — Settings Tab (Studio Bento Redesign)
     DataContext = OptimizationViewModel (inherited from the shell).

     Studio Bento layout:
     Left: Plate Geometry & Trim Margins (LM, RM, TM, BM, Thickness).
     Right: Blade Kerf, Breakout Boundaries, Rotation, and 5-Stage Effort.
     Bottom: House Defaults Controller & Engine Margin Hint Diagnostics.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Optimization.Tabs.SettingsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Visibility="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=3}"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Dashboard/Overview/IndigoStudioResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Border Style="{StaticResource OptPanelCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Header -->
                    <StackPanel Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="6"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                    Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="OPTIMIZATION ENGINE CONFIGURATION" Style="{StaticResource OptPanelTitle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Configure guillotine cut allowances, trim safety margins, kerf blade width and search intensity."
                                   FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Margin="38,3,0,0"/>
                    </StackPanel>

                    <!-- Balanced 2-Column Bento Grid -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ══ LEFT BENTO CARD: Plate Geometry & Trim Margins ══ -->
                        <Border Grid.Column="0" Style="{StaticResource OptInnerCard}" Margin="0,0,12,0" Padding="18,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="PLATE GEOMETRY &amp; TRIM MARGINS" Style="{StaticResource OptHeader}"
                                               FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <Border HorizontalAlignment="Right" Background="{DynamicResource AccentSoftBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                            CornerRadius="4" Padding="8,2">
                                        <TextBlock Text="SAFETY EDGES" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                </Grid>

                                <TextBlock Text="GLASS THICKNESS (MM)" Style="{StaticResource OptHeader}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding ThicknessText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource OptIntInput}" Margin="0,0,0,14"
                                         ToolTip="Glass thickness in millimetres. Margins, kerf and breakout defaults are stored per thickness, so changing this reloads the house numbers for that thickness."/>

                                <TextBlock Text="LEFT MARGIN LM (MM)" Style="{StaticResource OptHeader}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding LeftMarginText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource OptIntInput}" Margin="0,0,0,14"
                                         ToolTip="Unusable trim along the LEFT edge of every plate, in millimetres. No piece is ever placed inside it."/>

                                <TextBlock Text="RIGHT MARGIN RM (MM)" Style="{StaticResource OptHeader}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding RightMarginText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource OptIntInput}" Margin="0,0,0,14"
                                         ToolTip="Unusable trim along the RIGHT edge of every plate, in millimetres. No piece is ever placed inside it."/>

                                <TextBlock Text="TOP MARGIN TM (MM)" Style="{StaticResource OptHeader}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding TopMarginText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource OptIntInput}" Margin="0,0,0,14"
                                         ToolTip="Unusable trim along the TOP edge of every plate, in millimetres. No piece is ever placed inside it."/>

                                <TextBlock Text="BOTTOM MARGIN BM (MM)" Style="{StaticResource OptHeader}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding BottomMarginText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource OptIntInput}"
                                         ToolTip="Unusable trim along the BOTTOM edge of every plate, in millimetres. No piece is ever placed inside it."/>
                            </StackPanel>
                        </Border>

                        <!-- ══ RIGHT BENTO CARD: Cut Rules & Search Effort ══ -->
                        <Border Grid.Column="1" Style="{StaticResource OptInnerCard}" Padding="18,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="CUT RULES &amp; SEARCH EFFORT" Style="{StaticResource OptHeader}"
                                               FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <Border HorizontalAlignment="Right" Background="{StaticResource OptInfoBg}"
                                            BorderBrush="{StaticResource OptInfoBorder}" BorderThickness="1"
                                            CornerRadius="4" Padding="8,2">
                                        <TextBlock Text="GUILLOTINE 2D" FontSize="9" FontWeight="Bold" Foreground="{StaticResource OptInfoInk}"/>
                                    </Border>
                                </Grid>

                                <TextBlock Text="KERF / BLADE GAP (MM)" Style="{StaticResource OptHeader}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding KerfText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource OptIntInput}" Margin="0,0,0,14"
                                         ToolTip="Width of glass the blade removes, in millimetres. Every cut consumes it, so a wider kerf costs yield on every sheet of every run."/>

                                <TextBlock Text="MINIMUM BREAKOUT (MM)" Style="{StaticResource OptHeader}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding MinBreakoutText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource OptIntInput}" Margin="0,0,0,14"
                                         ToolTip="Narrowest strip the operator can break out by hand, in millimetres. A layout needing anything thinner is rejected rather than sent to the floor."/>

                                <!-- ══ CUTTING COMPLEXITY (PHASE 1, 2026-09-26) ══
                                     Production constraint, not a yield feature: every level
                                     below Free guillotine trades material for simpler cutting,
                                     so the hint says what the choice costs as well as buys. -->
                                <TextBlock Text="CUTTING COMPLEXITY" Style="{StaticResource OptHeader}" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding CutComplexities}"
                                          SelectedItem="{Binding SelectedCutComplexity}"
                                          Style="{StaticResource OptComboStyle}" HorizontalAlignment="Stretch"
                                          ToolTip="{Binding CutComplexityHint}"
                                          AutomationProperties.Name="Cutting complexity"/>
                                <TextBlock Text="{Binding CutComplexityHint}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0"/>

                                <StackPanel Visibility="{Binding ShowTrimWidth, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Margin="0,8,0,14">
                                    <TextBlock Text="MINIMUM TRIM WIDTH (MM)" Style="{StaticResource OptHeader}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding MinTrimWidthText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OptIntInput}" Width="120" HorizontalAlignment="Left"
                                             ToolTip="Narrowest strip worth cutting purely to release a remnant worth racking. Below this, the offcut is treated as waste."/>
                                    <TextBlock Text="Narrowest strip worth cutting to release a reusable remnant."
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasBreakoutChoice, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Margin="0,0,0,14">
                                    <TextBlock Text="BREAKOUT CHOICE (9MM AND ABOVE)" Style="{StaticResource OptHeader}" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding BreakoutOptions}"
                                              SelectedItem="{Binding SelectedBreakoutOption}"
                                              Style="{StaticResource OptComboStyle}" Width="180" HorizontalAlignment="Left"
                                              ToolTip="{Binding BreakoutHint}"/>
                                    <TextBlock Text="{Binding BreakoutHint}"
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Rotation Permission Card -->
                                <Border Background="{DynamicResource SurfacePrimaryBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                                    <CheckBox IsChecked="{Binding RotationEnabled}"
                                              Style="{StaticResource LiquidGlassCheckBox}"
                                              ToolTip="Let pieces be placed turned by 90 degrees. This usually raises yield. Turn it OFF when the glass has a direction - coated, patterned or rolled - because a turned piece would face the wrong way.">
                                        <TextBlock Text="Allow rotation (0° / 90° mix) — piece turns adaptively to maximize sheet yield"
                                                   TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="8,0,0,0"/>
                                    </CheckBox>
                                </Border>

                                <TextBlock Text="OPTIMIZE EFFORT / STRATEGY STAGE" Style="{StaticResource OptHeader}" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding StageStrategies}"
                                          SelectedItem="{Binding SelectedStageStrategy}"
                                          Style="{StaticResource OptComboStyle}" HorizontalAlignment="Stretch"
                                          ToolTip="{Binding SelectedStageStrategyHint}"
                                          AutomationProperties.Name="Optimize effort and strategy stage"/>
                                <TextBlock Text="Family and effort are independent: this picks which engines run, the effort level picks how hard they search. Stage 3 at effort 5 searches harder, it does not run the stage-5 portfolio. Auto hands the choice back to the engine."
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0"/>

                                <TextBlock Text="PLATE PATTERN" Style="{StaticResource OptHeader}" Margin="0,14,0,6"/>
                                <ComboBox ItemsSource="{Binding PlatePatterns}"
                                          SelectedItem="{Binding SelectedPlatePattern}"
                                          Style="{StaticResource OptComboStyle}" HorizontalAlignment="Stretch"
                                          ToolTip="{Binding SelectedPlatePatternHint}"
                                          AutomationProperties.Name="Plate pattern"/>
                                <TextBlock Text="{Binding SelectedPlatePatternHint}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0"/>

                                <TextBlock Text="OFFCUT REUSE" Style="{StaticResource OptHeader}" Margin="0,14,0,6"/>
                                <CheckBox IsChecked="{Binding UseOffcutReuse}"
                                          Content="Reuse offcuts within this run"
                                          ToolTip="{Binding OffcutReuseHint}"
                                          AutomationProperties.Name="Reuse offcuts within this run"/>
                                <TextBlock Text="{Binding OffcutReuseHint}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ══ BOTTOM BENTO STRIP: House Defaults & Diagnostics ══ -->
                    <Border Background="{DynamicResource SurfaceSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="16,14" Margin="0,18,0,0">
                        <StackPanel>
                            <Grid>
                                <Button Content="Load House Defaults" Style="{StaticResource OptOutlinedButton}"
                                        Command="{Binding LoadHouseDefaultsCommand}" HorizontalAlignment="Left"
                                        ToolTip="Replace every setting on this card with the house defaults for the current thickness. You will be asked to confirm first, because anything you have changed here is discarded."/>
                                <TextBlock Text="{Binding ThicknessSourceHint}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </Grid>
                            <TextBlock Text="{Binding MarginHint}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>