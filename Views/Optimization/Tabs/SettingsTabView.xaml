<!-- ═══════════════════════════════════════════════════════════════
     FILE: Views/Optimization/Tabs/SettingsTabView.xaml
     MODULE: Optimization — Settings tab (hosted by OptimizationView).
     DataContext = OptimizationViewModel (inherited from the shell).
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Optimization.Tabs.SettingsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Visibility="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=3}">

                <!-- ── TAB 3 · SETTINGS ─────────────────────────────── -->
                <Grid>

                    <Border Style="{StaticResource OptPanelCard}">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="CUTTING SETTINGS" Style="{StaticResource OptPanelTitle}" Margin="0,0,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="GLASS THICKNESS (MM)" Style="{StaticResource OptHeader}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding ThicknessText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OptIntInput}" Margin="0,0,0,12"/>
                                    <TextBlock Text="LEFT MARGIN LM (MM)" Style="{StaticResource OptHeader}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding LeftMarginText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OptIntInput}" Margin="0,0,0,12"/>
                                    <TextBlock Text="RIGHT MARGIN RM (MM)" Style="{StaticResource OptHeader}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding RightMarginText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OptIntInput}" Margin="0,0,0,12"/>
                                    <TextBlock Text="TOP MARGIN TM (MM)" Style="{StaticResource OptHeader}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding TopMarginText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OptIntInput}" Margin="0,0,0,12"/>
                                    <TextBlock Text="BOTTOM MARGIN BM (MM)" Style="{StaticResource OptHeader}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding BottomMarginText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OptIntInput}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="KERF / BLADE (MM)" Style="{StaticResource OptHeader}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding KerfText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OptIntInput}" Margin="0,0,0,12"/>
                                    <TextBlock Text="MINIMUM BREAKOUT (MM)" Style="{StaticResource OptHeader}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding MinBreakoutText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OptIntInput}" Margin="0,0,0,12"/>

                                    <StackPanel Visibility="{Binding HasBreakoutChoice, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Margin="0,0,0,10">
                                        <TextBlock Text="BREAKOUT CHOICE (9MM AND ABOVE)" Style="{StaticResource OptHeader}" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding BreakoutOptions}"
                                                  SelectedItem="{Binding SelectedBreakoutOption}"
                                                  Style="{StaticResource OptComboStyle}" Width="140" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding BreakoutHint}"
                                                   FontSize="{DynamicResource FontSize.BodySmall}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <CheckBox IsChecked="{Binding RotationEnabled}" Margin="0,10,0,6"
                                              Foreground="{DynamicResource TextPrimaryBrush}">
                                        <TextBlock Text="Allow rotation (0° / 90° mix) — enabled by default for all pieces"
                                                   TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Body}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </CheckBox>

                                    <TextBlock Text="OPTIMIZE EFFORT / STRATEGY STAGE" Style="{StaticResource OptHeader}" Margin="0,10,0,6"/>
                                    <ComboBox ItemsSource="{Binding StageStrategies}"
                                              SelectedItem="{Binding SelectedStageStrategy}"
                                              Style="{StaticResource OptComboStyle}" Width="420" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="Load house defaults" Style="{StaticResource OutlinedPillButton}"
                                        Command="{Binding LoadHouseDefaultsCommand}"/>
                            </StackPanel>

                            <TextBlock Text="{Binding ThicknessSourceHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,12,0,0"/>
                            <TextBlock Text="{Binding MarginHint}"
                                       FontSize="{DynamicResource FontSize.BodySmall}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
</UserControl>
