<!-- ═══════════════════════════════════════════════════════════════
     FILE: Views/Optimization/Tabs/TwoDViewTabView.xaml
     MODULE: Optimization — TwoDView Tab (Studio Bento Redesign)
     DataContext = OptimizationViewModel (inherited from the shell).

     Full Light Studio Bento CAD visualizer:
     1. Single Sheet CAD visualizer with exact cut dimensions (W×H mm)
        on each piece, outer plate ticks, usable/breakout boundaries,
        reusable offcut remnants, and piece cutting schedule table.
     2. Multi-Sheet Gallery Grid with miniature vector layout previews,
        yield badges, and 1-click sheet inspection.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Optimization.Tabs.TwoDViewTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Visibility="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=5}"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Dashboard/Overview/IndigoStudioResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Saw channel is darker than the piece fill so a kerf gap
                 reads as a cut, not as two pieces sharing one edge. -->
            <SolidColorBrush x:Key="OptCutBed" Color="#D6D3D1"/>
            <SolidColorBrush x:Key="OptCutInk" Color="#1F2937"/>
            <SolidColorBrush x:Key="OptPieceFill" Color="#F8FAFC"/>
            <SolidColorBrush x:Key="OptTrimInk" Color="#0F766E"/>
            <SolidColorBrush x:Key="OptBreakoutInk" Color="#B45309"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Border Style="{StaticResource OptPanelCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row 0: Top View Mode Switcher & Navigation Toolbar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: Main Visualizer Workspace (Single vs Gallery) -->
                    <RowDefinition Height="*"/>
                    <!-- Row 2: Bottom Status & CAD Legend -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ═════════════════════════════════════════════════════
                     ROW 0: TOP TOOLBAR & VIEW MODE CONTROLS
                     ═════════════════════════════════════════════════════ -->
                <WrapPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Horizontal">

                    <!-- Left: Single / Gallery View Mode Switcher -->
                    <Border Margin="0,4,12,8" Background="{DynamicResource SurfaceSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <!-- Single Sheet Focus Mode -->
                            <Button Command="{Binding SwitchToSingleViewCommand}"
                                    Cursor="Hand" Padding="14,6" BorderThickness="0"
                                    ToolTip="Show one sheet at a time, large, with the margin and breakout overlay drawn to scale. Use this to check a single layout before it reaches the table.">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSingleSheetMode}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Single Sheet CAD" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Multi-Sheet Gallery Mode -->
                            <Button Command="{Binding SwitchToGalleryViewCommand}"
                                    Cursor="Hand" Padding="14,6" BorderThickness="0" Margin="2,0,0,0"
                                    ToolTip="Show every sheet as a thumbnail, so you can compare layouts across the run at a glance.">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGalleryMode}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xF0E2;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Multi-Sheet Gallery" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Center: Sheet Readout & Stepper (Visible in Single Sheet Mode) -->
                    <WrapPanel Margin="0,4,12,4" VerticalAlignment="Center"
                               Visibility="{Binding IsSingleSheetMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Style="{StaticResource OptOutlinedButton}" Width="36" Height="34" Padding="0"
                                Command="{Binding SelectPreviousSheetCommand}" ToolTip="Previous sheet (Left Arrow)"
                                Content="&#xE76B;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="12"
                                VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <WrapPanel VerticalAlignment="Center"
                                   Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                            <!-- Sheet Number Pill -->
                            <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                                <TextBlock Text="{Binding PreviewSheetCounter}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>

                            <!-- Stock Dimensions Pill -->
                            <Border Background="{DynamicResource SurfaceSecondaryBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                                <TextBlock Text="{Binding PreviewStockLabel}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            </Border>

                            <!-- Utilization Yield Badge -->
                            <Border Background="{StaticResource OptSuccessBg}" BorderBrush="{StaticResource OptSuccessBorder}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Yield: " FontSize="12" Foreground="{StaticResource OptSuccessInk}"/>
                                    <TextBlock Text="{Binding PreviewUtilization}" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource OptSuccessInk}"/>
                                </StackPanel>
                            </Border>

                            <!-- Composition / Spec Label -->
                            <TextBlock Text="{Binding PreviewGroupLabel}" FontSize="12"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"
                                       MaxWidth="280"/>
                        </WrapPanel>

                        <TextBlock Text="Run optimization to generate 2D sheet layouts"
                                   FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasPreview, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                        <Button Style="{StaticResource OptOutlinedButton}" Width="36" Height="34" Padding="0"
                                Command="{Binding SelectNextSheetCommand}" ToolTip="Next sheet (Right Arrow)"
                                Content="&#xE76C;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="12"
                                VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </WrapPanel>

                    <!-- Center: Multi-Sheet Gallery Header (Visible in Gallery Mode) -->
                    <WrapPanel Margin="0,4,12,4" VerticalAlignment="Center"
                               Visibility="{Binding IsGalleryMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <!-- Per-Page Selector -->
                        <Border Background="{DynamicResource SurfaceSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="3" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Show:" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" Margin="6,0,4,0"/>
                                <Button Content="4" Command="{Binding SetGalleryPageSizeCommand}" CommandParameter="4"
                                        Style="{StaticResource OptGhostButton}" Padding="8,4" FontSize="11"
                                        ToolTip="Show 4 sheets per gallery page."/>
                                <Button Content="8" Command="{Binding SetGalleryPageSizeCommand}" CommandParameter="8"
                                        Style="{StaticResource OptGhostButton}" Padding="8,4" FontSize="11"
                                        ToolTip="Show 8 sheets per gallery page."/>
                                <Button Content="12" Command="{Binding SetGalleryPageSizeCommand}" CommandParameter="12"
                                        Style="{StaticResource OptGhostButton}" Padding="8,4" FontSize="11"
                                        ToolTip="Show 12 sheets per gallery page."/>
                            </StackPanel>
                        </Border>

                        <!-- Paging Navigator -->
                        <Button Style="{StaticResource OptOutlinedButton}" Width="32" Height="30" Padding="0"
                                Command="{Binding GalleryPrevPageCommand}" IsEnabled="{Binding CanGalleryPrev}"
                                ToolTip="Previous page" Content="&#xE76B;" FontFamily="{DynamicResource FontFamily.Icon}"
                                FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>

                        <TextBlock Text="{Binding GalleryPaginationSummary}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center"
                                   Margin="6,0"/>

                        <Button Style="{StaticResource OptOutlinedButton}" Width="32" Height="30" Padding="0"
                                Command="{Binding GalleryNextPageCommand}" IsEnabled="{Binding CanGalleryNext}"
                                ToolTip="Next page" Content="&#xE76C;" FontFamily="{DynamicResource FontFamily.Icon}"
                                FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </WrapPanel>

                    <!-- Right: Zoom Controls & Mini-map Thumbnail (Single Mode) -->
                    <StackPanel Margin="0,4,0,8" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsSingleSheetMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Button Content="−" Style="{StaticResource OptOutlinedButton}" Width="30" Height="30" Padding="0"
                                    Command="{Binding PreviewZoomOutCommand}" Margin="0,0,4,0" ToolTip="Zoom out"/>
                            <Border CornerRadius="6" Background="{DynamicResource SurfacePrimaryBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Padding="8,3" Margin="0,0,4,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PreviewScaleLabel}" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </Border>
                            <Button Content="+" Style="{StaticResource OptOutlinedButton}" Width="30" Height="30" Padding="0"
                                    Command="{Binding PreviewZoomInCommand}" Margin="0,0,4,0" ToolTip="Zoom in"/>
                            <Button Content="100%" Style="{StaticResource OptOutlinedButton}" Height="30" Padding="8,0"
                                    Command="{Binding PreviewZoomResetCommand}" ToolTip="Reset zoom to 100%" Margin="0,0,4,0"/>
                            <Button Content="Normal view" Style="{StaticResource OptPrimaryButton}" Height="30" Padding="10,0"
                                    Command="{Binding PreviewFitCommand}" ToolTip="Fit the whole sheet into the stage"/>
                        </StackPanel>

                        <!-- Mini-map thumbnail -->
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Background="{DynamicResource SurfaceSecondaryBrush}"
                                CornerRadius="4" Padding="2" VerticalAlignment="Center"
                                ToolTip="Whole sheet mini-map"
                                Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Canvas Width="{Binding MiniMapWidth}" Height="{Binding MiniMapHeight}">
                                <ItemsControl ItemsSource="{Binding MiniMapRects}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding Width}" Height="{Binding Height}"
                                                    BorderThickness="0.8" BorderBrush="{StaticResource OptCutInk}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Rotated}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource InfoBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </Border>
                    </StackPanel>
                </WrapPanel>

                <!-- ═════════════════════════════════════════════════════
                     ROW 1A: SINGLE SHEET CAD VISUALIZER WORKSPACE
                     ═════════════════════════════════════════════════════ -->
                <Grid Grid.Row="1" Visibility="{Binding IsSingleSheetMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <!-- Empty State -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasPreview, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource SurfaceSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </Border>
                        <TextBlock Text="No layout to preview yet" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Run Quick or Optimize, then inspect the 2D sheet cutting plan here."
                                   FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Normal view: the whole plate stays visible. The schedule
                         sits beside it so it cannot push the sheet off the stage. -->
                    <Grid ClipToBounds="True" Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="280"/>
                            <ColumnDefinition Width="*" MinWidth="240"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="SheetStage" Grid.Column="0" Margin="0,0,12,0" ClipToBounds="True"
                                Background="{DynamicResource SurfacePrimaryBrush}"
                                BorderBrush="{StaticResource OptIndigo}" BorderThickness="1.5"
                                CornerRadius="12" Padding="8"
                                SizeChanged="OnSheetStageSizeChanged">
                            <ScrollViewer x:Name="SheetScroller"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <Grid x:Name="SheetFitHost" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid.LayoutTransform>
                                        <ScaleTransform x:Name="SheetFitScale" ScaleX="1" ScaleY="1"/>
                                    </Grid.LayoutTransform>
                                    <StackPanel>
                            <!-- ── TOP PLATE DIMENSION CALLOUT BAR ── -->
                            <Grid HorizontalAlignment="Center" Width="{Binding RenderWidth}" Margin="0,0,0,4">
                                <Border Height="1" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource SurfacePrimaryBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="8,2" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↔ Plate Width: " FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        <TextBlock Text="{Binding SheetDimensionsTop}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ── MAIN CAD CANVAS WORKSPACE ── -->
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Dimension Callout -->
                                <Border Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center"
                                        Background="{DynamicResource SurfacePrimaryBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="3,6">
                                    <TextBlock Text="{Binding SheetDimensionsLeft}" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               HorizontalAlignment="Center">
                                        <TextBlock.LayoutTransform>
                                            <RotateTransform Angle="-90"/>
                                        </TextBlock.LayoutTransform>
                                    </TextBlock>
                                </Border>

                                <!-- Plate Canvas -->
                                <Border Grid.Column="1" BorderBrush="{StaticResource OptTrimInk}" BorderThickness="2"
                                        CornerRadius="4" Background="{StaticResource OptCutBed}" SnapsToDevicePixels="True">
                                    <Canvas Width="{Binding RenderWidth}" Height="{Binding RenderHeight}">

                                        <!-- Trim boundary — the usable rectangle inside edge trims. -->
                                        <Rectangle Canvas.Left="{Binding UsableX}" Canvas.Top="{Binding UsableY}"
                                                   Width="{Binding UsableW}" Height="{Binding UsableH}"
                                                   Stroke="{StaticResource OptTrimInk}" StrokeThickness="2.25"
                                                   StrokeDashArray="7,3" Fill="Transparent" IsHitTestVisible="False"/>

                                        <!-- Minimum-breakout band — inset from the trim, amber so it
                                             does not disappear into the saw lines. -->
                                        <Rectangle Canvas.Left="{Binding BreakoutX}" Canvas.Top="{Binding BreakoutY}"
                                                   Width="{Binding BreakoutW}" Height="{Binding BreakoutH}"
                                                   Stroke="{StaticResource OptBreakoutInk}" StrokeThickness="2"
                                                   StrokeDashArray="2,2" Fill="Transparent" IsHitTestVisible="False"/>

                                        <!-- Reusable Offcut Remnants -->
                                        <ItemsControl ItemsSource="{Binding SheetOffcuts}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding Width}" Height="{Binding Height}"
                                                            Background="{StaticResource OptOffcutBg}"
                                                            BorderBrush="{StaticResource OptOffcutBorder}"
                                                            BorderThickness="1.5"
                                                            Padding="4">
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                                                                       Margin="0,2,0,0"/>
                                                            <TextBlock Text="{Binding DimensionsText}" FontSize="10" FontWeight="Bold"
                                                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Placed Cut Pieces with Cut Size Dimensions -->
                                        <ItemsControl ItemsSource="{Binding SheetRects}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding Width}" Height="{Binding Height}"
                                                            BorderThickness="1.75" BorderBrush="{StaticResource OptCutInk}"
                                                            CornerRadius="1" SnapsToDevicePixels="True">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource OptPieceFill}"/>
                                                                <Style.Triggers>
                                                                    <!-- Rotated 90°: Light Sky Blue Tint -->
                                                                    <DataTrigger Binding="{Binding Rotated}" Value="True">
                                                                        <Setter Property="Background" Value="#F0F9FF"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>

                                                        <Grid Margin="3">
                                                            <!-- Cut Sequence Tag Badge (Top-Left) -->
                                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                    Background="{DynamicResource AccentBrush}" CornerRadius="3" Padding="4,1"
                                                                    Visibility="{Binding ShowSequence, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="{Binding CutTag}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                            </Border>

                                                            <!-- Rotation Tag (Top-Right) -->
                                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                    Background="{StaticResource OptInfoBg}" BorderBrush="{StaticResource OptInfoBorder}"
                                                                    BorderThickness="1" CornerRadius="3" Padding="4,1"
                                                                    Visibility="{Binding Rotated, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="90° ⟳" FontSize="9" FontWeight="Bold" Foreground="{StaticResource OptInfoInk}"/>
                                                            </Border>

                                                            <!-- Prominent Cut Size Dimensions (Center) -->
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                        Visibility="{Binding ShowDimensions, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="{Binding PieceRef}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource PrimaryForegroundBrush}" HorizontalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                                                <!-- Exact Cut Dimensions -->
                                                                <TextBlock Text="{Binding DimensionsText}" FontSize="12" FontWeight="Bold"
                                                                           Foreground="{DynamicResource PrimaryForegroundBrush}" HorizontalAlignment="Center"
                                                                           Margin="0,1,0,0"/>
                                                                <TextBlock Text="{Binding AreaM2Text}" FontSize="10"
                                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                                           HorizontalAlignment="Center"
                                                                           Visibility="{Binding ShowFullDetails, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            </StackPanel>

                                                            <!-- Compact label for smaller pieces -->
                                                            <TextBlock Text="{Binding ShortDimensionsText}" FontSize="10" FontWeight="Bold"
                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding ShowDimensions, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Canvas>
                                </Border>
                            </Grid>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Border>

                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <!-- ── PIECE CUTTING SCHEDULE MATRIX TABLE ── -->
                            <Border Style="{StaticResource OptInnerCard}" Margin="0" HorizontalAlignment="Stretch">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="PIECE CUTTING SCHEDULE FOR THIS SHEET"
                                                   Style="{StaticResource OptPanelTitle}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Total Sheet Pieces: " FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                            <TextBlock Text="{Binding PreviewPiecesCount}" FontSize="12" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Table Header -->
                                    <Grid Background="{DynamicResource SurfaceSecondaryBrush}"
                                          Height="32">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="SEQ #" Style="{StaticResource OptHeader}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <TextBlock Grid.Column="1" Text="CUT TAG" Style="{StaticResource OptHeader}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="PIECE REF" Style="{StaticResource OptHeader}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="DIMENSIONS (W×H)" Style="{StaticResource OptHeader}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="ROTATED" Style="{StaticResource OptHeader}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="AREA" Style="{StaticResource OptHeader}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="GLASS SPECIFICATION" Style="{StaticResource OptHeader}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Table Rows -->
                                    <ItemsControl ItemsSource="{Binding CurrentSheetPieces}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,7" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="140"/>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding SequenceNumber}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                        <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}"
                                                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                                                CornerRadius="4" Padding="6,1"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CutTag}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="2" Text="{Binding PieceRef}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding DimensionsText}" FontWeight="Bold"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding RotatedText}"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding AreaM2Text}"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                        <TextBlock Grid.Column="6" Text="{Binding GlassSpec}"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ═════════════════════════════════════════════════════
                     ROW 1B: MULTI-SHEET GALLERY GRID (8 / 12 PER PAGE)
                     ═════════════════════════════════════════════════════ -->
                <Grid Grid.Row="1" Visibility="{Binding IsGalleryMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4">
                            <ItemsControl ItemsSource="{Binding PagedGallerySheets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Miniature Sheet Bento Card -->
                                        <Border Style="{StaticResource OptGalleryCard}" Width="276" Margin="0,0,14,14">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick"
                                                              Command="{Binding DataContext.FocusGallerySheetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding Index}"/>
                                            </Border.InputBindings>
                                            <StackPanel>
                                                <!-- Card Header -->
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding SheetNoLabel}" FontWeight="Bold" FontSize="13"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                        <TextBlock Text="{Binding StockLabel}" FontSize="11"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                    </StackPanel>
                                                    <!-- Yield Badge Pill -->
                                                    <Border Grid.Column="1" Background="{StaticResource OptSuccessBg}"
                                                            BorderBrush="{StaticResource OptSuccessBorder}" BorderThickness="1"
                                                            CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding UtilizationLabel}" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{StaticResource OptSuccessInk}"/>
                                                    </Border>
                                                </Grid>

                                                <!-- Miniature Sheet Vector Canvas -->
                                                <Border BorderBrush="{StaticResource OptTrimInk}" BorderThickness="1.5"
                                                        CornerRadius="4" Background="{StaticResource OptCutBed}" Padding="2" Margin="0,0,0,8"
                                                        HorizontalAlignment="Center">
                                                    <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">
                                                        <ItemsControl ItemsSource="{Binding Pieces}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <Canvas/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemContainerStyle>
                                                                <Style TargetType="ContentPresenter">
                                                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                                </Style>
                                                            </ItemsControl.ItemContainerStyle>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Width="{Binding Width}" Height="{Binding Height}"
                                                                            BorderThickness="1" BorderBrush="{StaticResource OptCutInk}"
                                                                            Background="{StaticResource OptPieceFill}">
                                                                        <TextBlock Text="{Binding CutNumber}" FontSize="8" FontWeight="Bold"
                                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}" HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   Visibility="{Binding ShowSequence, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Canvas>
                                                </Border>

                                                <!-- Card Footer: Stats & Action -->
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PieceCountLabel}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                        <TextBlock Text="{Binding WasteLabel}" FontSize="10"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Inspect CAD →"
                                                            Style="{StaticResource OptOutlinedButton}" FontSize="10" Height="28" Padding="10,0"
                                                            Command="{Binding DataContext.FocusGallerySheetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Index}"
                                                            ToolTip="Open this sheet full size in the single-sheet view."/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ═════════════════════════════════════════════════════
                     ROW 2: FOOTER STATUS & TWO-TONE CAD LEGEND
                     ═════════════════════════════════════════════════════ -->
                <WrapPanel Grid.Row="2" Margin="0,14,0,0" Orientation="Horizontal">
                    <TextBlock Text="{Binding MarginZoneLabel}" FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"
                               Margin="0,4,16,4" TextWrapping="Wrap" MaxWidth="360"/>

                    <!-- Studio Bento CAD Legend -->
                    <WrapPanel VerticalAlignment="Center">
                        <!-- Margin Zone -->
                        <Border Width="12" Height="12" Background="Transparent" BorderBrush="{StaticResource OptTrimInk}"
                                BorderThickness="2" CornerRadius="2" Margin="0,0,5,0"/>
                        <TextBlock Text="Trim" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,14,0"/>

                        <!-- Breakout allowance -->
                        <Border Width="12" Height="12" Background="Transparent" BorderBrush="{StaticResource OptBreakoutInk}"
                                BorderThickness="2" CornerRadius="2" Margin="0,0,5,0"/>
                        <TextBlock Text="Breakout" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,14,0"/>

                        <!-- Saw cut between pieces -->
                        <Border Width="12" Height="12" Background="{StaticResource OptCutBed}" BorderBrush="{StaticResource OptCutInk}"
                                BorderThickness="1.75" CornerRadius="2" Margin="0,0,5,0"/>
                        <TextBlock Text="Saw cut" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,14,0"/>

                        <!-- Standard Cut Piece -->
                        <Border Width="12" Height="12" Background="{StaticResource OptPieceFill}" BorderBrush="{StaticResource OptCutInk}"
                                BorderThickness="1.75" CornerRadius="2" Margin="0,0,5,0"/>
                        <TextBlock Text="Piece" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,14,0"/>

                        <!-- Rotated Cut Piece -->
                        <Border Width="12" Height="12" Background="#F0F9FF" BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1" CornerRadius="2" Margin="0,0,5,0"/>
                        <TextBlock Text="Rotated 90° ⟳" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,14,0"/>

                        <!-- Reusable Offcut -->
                        <Border Width="12" Height="12" Background="{StaticResource OptOffcutBg}"
                                BorderBrush="{StaticResource OptOffcutBorder}" BorderThickness="1" CornerRadius="2" Margin="0,0,5,0"/>
                        <TextBlock Text="Reusable Offcut" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center"/>
                    </WrapPanel>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>