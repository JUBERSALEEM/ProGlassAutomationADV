<!-- ═══════════════════════════════════════════════════════════════
     FILE: Views/Optimization/Tabs/TwoDViewTabView.xaml
     MODULE: Optimization — TwoDView tab (hosted by OptimizationView).
     DataContext = OptimizationViewModel (inherited from the shell).
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Optimization.Tabs.TwoDViewTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

                <!-- ── TAB 5 · 2D VIEW ──────────────────────────────── -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="5">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Border Style="{StaticResource OptPanelCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Navigator: prev/next + caption + zoom -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="&#xE76B;  Prev" Style="{StaticResource OutlinedPillButton}"
                                            Command="{Binding SelectPreviousSheetCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Next  &#xE76C;" Style="{StaticResource OutlinedPillButton}"
                                            Command="{Binding SelectNextSheetCommand}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding PreviewCaption}" FontSize="{StaticResource TextBody}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                           VerticalAlignment="Center" Margin="12,0"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="−" Style="{StaticResource OutlinedPillButton}" Width="34"
                                            Command="{Binding PreviewZoomOutCommand}" Margin="0,0,6,0" ToolTip="Zoom out"/>
                                    <Border CornerRadius="8" Background="{DynamicResource ModuleBackgroundBrush}" Padding="10,3"
                                            Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PreviewScaleLabel}" FontSize="{StaticResource TextCaption}"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    </Border>
                                    <Button Content="+" Style="{StaticResource OutlinedPillButton}" Width="34"
                                            Command="{Binding PreviewZoomInCommand}" Margin="0,0,6,0" ToolTip="Zoom in"/>
                                    <Button Content="100%" Style="{StaticResource OutlinedPillButton}"
                                            Command="{Binding PreviewZoomResetCommand}" ToolTip="Reset zoom"/>
                                </StackPanel>
                            </Grid>

                            <!-- Filmstrip -->
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding SheetRows}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SheetChipStyle}"
                                                    Command="{Binding DataContext.SelectSheetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Index}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Canvas -->
                            <Grid Grid.Row="2">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding HasPreview, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" Opacity="0.6"/>
                                    <TextBlock Text="No layout to preview yet" FontSize="{StaticResource TextSubhead}" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,12,0,4" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Text="Run Quick or Optimize, then pick a sheet from Summary — the canvas shows every piece, the margin zone, kerf gaps and rotation."
                                               FontSize="{StaticResource TextBody}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                </StackPanel>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Border CornerRadius="10" Background="{DynamicResource WindowBackgroundBrush}"
                                                BorderBrush="{DynamicResource GlassBorderGradientSoft}" BorderThickness="1"
                                                Padding="12,8" Margin="0,0,0,8" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding PreviewStockLabel}" FontSize="{StaticResource TextBody}"
                                                           FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,0,16,0"/>
                                                <TextBlock Text="{Binding PreviewUtilization}" FontSize="{StaticResource TextBody}"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,16,0"/>
                                                <TextBlock Text="{Binding PreviewPiecesCount}" FontSize="{StaticResource TextBody}"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,16,0"/>
                                                <TextBlock Text="{Binding MarginZoneLabel}" FontSize="{StaticResource TextCaption}"
                                                           Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="2"
                                                Background="{DynamicResource WindowBackgroundBrush}"
                                                HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Canvas Width="{Binding RenderWidth}" Height="{Binding RenderHeight}">
                                                <Rectangle Canvas.Left="{Binding UsableX}" Canvas.Top="{Binding UsableY}"
                                                           Width="{Binding UsableW}" Height="{Binding UsableH}"
                                                           Stroke="{DynamicResource AccentBrush}" StrokeThickness="1"
                                                           StrokeDashArray="4,3" Fill="Transparent" IsHitTestVisible="False"/>
                                                <ItemsControl ItemsSource="{Binding SheetRects}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="{Binding Width}" Height="{Binding Height}"
                                                                    BorderThickness="1" BorderBrush="{DynamicResource ModuleBackgroundBrush}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Rotated}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource MutedForegroundBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding Label}" FontSize="9"
                                                                           Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                                           Margin="3,2" TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Canvas>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border Width="14" Height="14" Background="{DynamicResource AccentBrush}" CornerRadius="3" Margin="0,0,8,0"/>
                                            <TextBlock Text="original orientation" FontSize="{StaticResource TextCaption}"
                                                       Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                            <Border Width="14" Height="14" Background="{DynamicResource MutedForegroundBrush}" CornerRadius="3" Margin="0,0,8,0"/>
                                            <TextBlock Text="rotated 90°" FontSize="{StaticResource TextCaption}"
                                                       Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
</UserControl>
