<!-- ═══════════════════════════════════════════════════════════════
     FILE: Views/Optimization/Tabs/SizesTabView.xaml
     MODULE: Optimization — Sizes tab (hosted by OptimizationView).
     DataContext = OptimizationViewModel (inherited from the shell).
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Optimization.Tabs.SizesTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

                <!-- ── TAB 1 · SIZES ────────────────────────────────── -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Border Style="{StaticResource OptPanelCard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- selector -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CUTTING GROUP" Style="{StaticResource OptPanelTitle}"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ComboBox Grid.Column="1" MinWidth="300" ItemsSource="{Binding CuttingGroups}"
                                              SelectedItem="{Binding SelectedCuttingGroup}"
                                              Style="{StaticResource OptComboStyle}"
                                              ToolTip="Optimize one pane group at a time (outer / inner / …) against its own Step 4 sheet"/>
                                    <TextBlock Grid.Column="2" Text="{Binding PieceSummary}" FontSize="{StaticResource TextBody}"
                                               FontWeight="SemiBold" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- merged groups -->
                                <TextBlock Text="MERGED GLASS GROUPS" Style="{StaticResource OptHeader}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding SizeGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource OptInnerCard}" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="110"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Composition}" FontSize="{StaticResource TextBody}"
                                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Thickness}" FontSize="{StaticResource TextCaption}"
                                                                   Foreground="{DynamicResource AccentBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="PIECES" Style="{StaticResource OptHeader}"/>
                                                        <TextBlock Text="{Binding PieceCount}" FontSize="{StaticResource TextBody}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="SIZE ROWS" Style="{StaticResource OptHeader}"/>
                                                        <TextBlock Text="{Binding SizeRows}" FontSize="{StaticResource TextBody}"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3">
                                                        <TextBlock Text="AREA (M²)" Style="{StaticResource OptHeader}"/>
                                                        <TextBlock Text="{Binding AreaM2}" FontSize="{StaticResource TextBody}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- cut plan -->
                                <StackPanel Margin="0,14,0,0" Visibility="{Binding HasCutPlan, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="CUT PLAN — PIECES AS THE SAW CUTS THEM" Style="{StaticResource OptHeader}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding CutPlanNote}" FontSize="{StaticResource TextCaption}"
                                               Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                                               Visibility="{Binding HasCutPlanNote, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="#" Style="{StaticResource OptHeader}"/>
                                        <TextBlock Grid.Column="1" Text="REF" Style="{StaticResource OptHeader}"/>
                                        <TextBlock Grid.Column="2" Text="GLASS COMPOSITION" Style="{StaticResource OptHeader}"/>
                                        <TextBlock Grid.Column="3" Text="SIZE (MM)" Style="{StaticResource OptHeader}"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding CutPlanRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="4,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="64"/>
                                                            <ColumnDefinition Width="180"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="140"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Number}" FontSize="{StaticResource TextBody}"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Ref}" FontSize="{StaticResource TextBody}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Composition}" FontSize="{StaticResource TextBody}"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Size}" FontSize="{StaticResource TextBody}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
</UserControl>
