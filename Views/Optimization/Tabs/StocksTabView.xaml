<!-- ═══════════════════════════════════════════════════════════════
     FILE: Views/Optimization/Tabs/StocksTabView.xaml
     MODULE: Optimization — Stocks tab (hosted by OptimizationView).
     DataContext = OptimizationViewModel (inherited from the shell).
═══════════════════════════════════════════════════════════════════ -->
<UserControl Style="{StaticResource ErpPageRootStyle}" x:Class="ProGlassAutomation.Views.Optimization.Tabs.StocksTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

                <!-- ── TAB 2 · STOCKS ───────────────────────────────── -->
                <Grid>
<Border Style="{StaticResource OptPanelCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Stock pool for the run — only the Step 4 sheet sizes the selected specs were quoted on (outer/inner per spec). Tick the racks each spec may use; unticked racks stay listed but are never fed to the optimizer."
                                       FontSize="{DynamicResource FontSize.Body}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="1" Text="{Binding StocksStatusText}"
                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                       Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                            <!-- add-row toolbar (buttons in their own columns — no overlap) -->
                            <Grid Grid.Row="2" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="W (MM)" Style="{StaticResource OptHeader}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" Width="88" Text="{Binding NewStock.WidthText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource OptIntInput}" Margin="0,0,16,0"/>
                                <TextBlock Grid.Column="2" Text="H (MM)" Style="{StaticResource OptHeader}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="3" Width="88" Text="{Binding NewStock.HeightText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource OptIntInput}" Margin="0,0,16,0"/>
                                <TextBlock Grid.Column="4" Text="AVAILABLE" Style="{StaticResource OptHeader}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="5" Width="104" Text="{Binding NewStock.AvailableText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource OptIntInput}" Margin="0,0,16,0"/>
                                <Button Grid.Column="6" Content="Add stock" Style="{StaticResource PrimaryPillButton}"
                                        Command="{Binding AddStockCommand}" Margin="0,0,8,0"/>
                                <Button Grid.Column="7" Content="Import Step 4 sheets" Style="{StaticResource OutlinedPillButton}"
                                        Command="{Binding ImportStockFromStep4Command}"
                                        ToolTip="Replaces the pool with the Step 4 sheet sizes of the selected Job Orders (deduped by size × glass), all ticked for use"/>
                            </Grid>

                            <TextBlock Grid.Row="3" Text="{Binding StocksStatusText}"
                                       FontSize="{DynamicResource FontSize.Body}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="4,8,4,0"
                                       VerticalAlignment="Top"
                                       Visibility="{Binding HasStocks, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            <Grid Grid.Row="3" Visibility="{Binding HasStocks, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- header row -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="USE" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Grid.Column="1" Text="SHEET (MM)" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Grid.Column="2" Text="GLASS / GROUP" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Grid.Column="3" Text="AVAILABLE" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Grid.Column="4" Text="USED" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Grid.Column="5" Text="SOURCE" Style="{StaticResource OptHeader}"/>
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Stocks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource OptInnerCard}" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40"/>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="180"/>
                                                            <ColumnDefinition Width="70"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsUsedInRun}"
                                                                  VerticalAlignment="Center"
                                                                  Style="{StaticResource LiquidGlassCheckBox}"
                                                                  ToolTip="Tick to let this rack be used by the optimizer (Step 4 sheets are auto-selected)"/>
                                                        <TextBlock Grid.Column="1" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center">
                                                            <Run Text="{Binding WidthText, Mode=OneWay}"/><Run Text="×"/><Run Text="{Binding HeightText, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding CompositionLabel}" FontSize="{DynamicResource FontSize.Body}"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="3" FontSize="{DynamicResource FontSize.Body}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center">
                                                            <Run Text="{Binding AvailableText, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="4" Text="{Binding UsedLabel}" FontSize="{DynamicResource FontSize.Body}"
                                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                                                   Visibility="{Binding HasUsed, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding SourceLabel}" FontSize="{DynamicResource FontSize.BodySmall}"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                        <Button Grid.Column="6" Content="Remove" Style="{StaticResource OptGhostButton}"
                                                                Command="{Binding DataContext.RemoveStockCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
</UserControl>
