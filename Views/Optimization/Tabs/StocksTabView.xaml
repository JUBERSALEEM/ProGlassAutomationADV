<!-- ═══════════════════════════════════════════════════════════════
     FILE: Views/Optimization/Tabs/StocksTabView.xaml
     MODULE: Optimization — Stocks Tab (Studio Bento Redesign)
     DataContext = OptimizationViewModel (inherited from the shell).

     Studio Bento layout:
     Top: Raw Jumbo Plates & Stock Pool Controller + Add Stock / Import Step 4 Toolbar.
     Main: Master Stock Rack Matrix with usage toggles, dimension badges, and pool status.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Optimization.Tabs.StocksTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Visibility="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=2}"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Dashboard/Overview/IndigoStudioResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Border Style="{StaticResource OptPanelCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ══ 1. HEADER BLOCK ══ -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="6"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="RAW JUMBO PLATES &amp; STOCK INVENTORY" Style="{StaticResource OptPanelTitle}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Stock pool for the run — tick the racks each specification may draw from; unticked racks stay listed but are excluded from the optimizer."
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="38,3,0,0"/>
                </StackPanel>

                <!-- Status Line -->
                <TextBlock Grid.Row="1" Text="{Binding StocksStatusText}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="38,0,0,14"/>

                <!-- ══ 2. ADD STOCK TOOLBAR BENTO CARD ══ -->
                <Border Grid.Row="2" Background="{DynamicResource SurfaceSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="W (MM)" Style="{StaticResource OptHeader}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding NewStock.WidthText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource OptIntInput}" Margin="0,0,16,0"
                                 ToolTip="Plate width in millimetres, as it sits on the table."/>

                        <TextBlock Grid.Column="2" Text="H (MM)" Style="{StaticResource OptHeader}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="3" Text="{Binding NewStock.HeightText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource OptIntInput}" Margin="0,0,16,0"
                                 ToolTip="Plate height in millimetres, as it sits on the table."/>

                        <TextBlock Grid.Column="4" Text="AVAILABLE" Style="{StaticResource OptHeader}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="5" Text="{Binding NewStock.AvailableText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource OptIntInput}" Margin="0,0,16,0"
                                 ToolTip="How many sheets of this size the run may use. Leave 0 for no limit. When the cap is reached the engine stops opening this size and moves to the next."/>

                        <Button Grid.Column="6" Content="+ Add Stock" Style="{StaticResource OptPrimaryButton}"
                                Command="{Binding AddStockCommand}" Margin="0,0,8,0"
                                ToolTip="Add this size to the pool the run may cut from. Adding a size can only widen the search, never narrow it."/>

                        <Button Grid.Column="7" Content="Import Step 4 Sheets" Style="{StaticResource OptOutlinedButton}"
                                Command="{Binding ImportStockFromStep4Command}"
                                ToolTip="Populate the pool from the selected Job Orders' quoted sheet sizes"/>
                    </Grid>
                </Border>

                <!-- ══ 3. STOCK INVENTORY MATRIX ══ -->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Table Header -->
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="USE" Style="{StaticResource OptHeader}"/>
                            <TextBlock Grid.Column="1" Text="SHEET SIZE (MM)" Style="{StaticResource OptHeader}"/>
                            <TextBlock Grid.Column="2" Text="GLASS / SPECIFICATION" Style="{StaticResource OptHeader}"/>
                            <TextBlock Grid.Column="3" Text="AVAILABLE" Style="{StaticResource OptHeader}"/>
                            <TextBlock Grid.Column="4" Text="USED" Style="{StaticResource OptHeader}"/>
                            <TextBlock Grid.Column="5" Text="ORIGIN SOURCE" Style="{StaticResource OptHeader}"/>
                            <TextBlock Grid.Column="6" Text="ACTION" Style="{StaticResource OptHeader}" TextAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Table Rows -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Stocks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource OptInnerCard}" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsUsedInRun}"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource LiquidGlassCheckBox}"
                                                      ToolTip="Tick to allow the optimizer to cut from this plate"/>
                                            <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}"
                                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                                    CornerRadius="4" Padding="8,2"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}">
                                                    <Run Text="{Binding WidthText, Mode=OneWay}"/><Run Text=" × "/><Run Text="{Binding HeightText, Mode=OneWay}"/><Run Text=" mm"/>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding CompositionLabel}" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="3" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center">
                                                <Run Text="{Binding AvailableText, Mode=OneWay}"/>
                                            </TextBlock>
                                            <Border Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Background="{StaticResource OptSuccessBg}" BorderBrush="{StaticResource OptSuccessBorder}"
                                                    BorderThickness="1" CornerRadius="4" Padding="6,2"
                                                    Visibility="{Binding HasUsed, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding UsedLabel}" FontSize="11" FontWeight="Bold"
                                                           Foreground="{StaticResource OptSuccessInk}"/>
                                            </Border>
                                            <TextBlock Grid.Column="5" Text="{Binding SourceLabel}" FontSize="11"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                            <Button Grid.Column="6" Content="Remove" Style="{StaticResource OptGhostButton}"
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding DataContext.RemoveStockCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Drop this size from the run. You will be asked to confirm. The rack itself stays in the sheet store - only this run stops using it."/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>