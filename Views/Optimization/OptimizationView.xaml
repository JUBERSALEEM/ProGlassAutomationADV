<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Optimization/OptimizationView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Optimization — glass cutting optimization (dusk-navy ERP)

     Shell only: slim left navigation rail, header/run controls, KPI
     strip and the tab host. Each tab lives in Views/Optimization/Tabs
     (JOBS / SIZES / STOCKS / SETTINGS / SUMMARY / 2D VIEW); shared
     styles live in Themes/Styles/OptimizationStyles.xaml.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Optimization.OptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tabs="clr-namespace:ProGlassAutomation.Views.Optimization.Tabs"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- Full-width module: hamburger owns the app menu; tabs sit in the header. -->
    <Grid Background="Transparent">
        <Grid Margin="12,8,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Header: title + engine controls ── -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="OPTIMIZATION" Style="{StaticResource ModulePageTitleStyle}"/>
                    <TextBlock Text="Cutting plans that minimize waste — pieces in, sheets out, verified layouts."
                               FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Text="{Binding RunMessage}" FontSize="{DynamicResource FontSize.Body}"
                               FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource WarningBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding HasRunMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <!-- Which SETTINGS level produced the plan currently on screen. -->
                    <TextBlock Text="{Binding ResultEffortLabel}" FontSize="{DynamicResource FontSize.BodySmall}"
                               Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding HasResultEffort, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <!-- What the deeper search bought, after Upgrade to Optimize. -->
                    <TextBlock Text="{Binding UpgradeSummaryLabel}" FontSize="{DynamicResource FontSize.BodySmall}"
                               FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource SuccessBrush}"
                               TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding HasUpgradeSummary, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding RunStageLabel}" FontSize="{DynamicResource FontSize.BodySmall}"
                                   FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,2"/>
                        <ProgressBar Height="3" IsIndeterminate="True" Width="200" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Button Content="Run Quick" Style="{StaticResource OutlinedPillButton}"
                            Command="{Binding RunQuickCommand}" IsEnabled="{Binding CanRun}" Margin="0,0,8,0"
                            ToolTip="One fast deterministic pass (guillotine shelves) — seconds"/>
                    <Button Content="Run Optimize" Style="{StaticResource PrimaryPillButton}"
                            Command="{Binding RunOptimizeCommand}" IsEnabled="{Binding CanRun}"
                            ToolTip="Multi-start search, effort level 1–5 — best utilization wins"/>
                    <Button Content="Cancel" Style="{StaticResource OutlinedPillButton}"
                            Command="{Binding CancelRunCommand}" IsEnabled="{Binding CanCancel}"
                            Margin="8,0,0,0"
                            ToolTip="Stop the current run — the engine checks for cancellation once per part"/>
                    <Button Content="Upgrade to Optimize" Style="{StaticResource PrimaryPillButton}"
                            Command="{Binding UpgradeToOptimizeCommand}" Margin="8,0,0,0"
                            Visibility="{Binding CanUpgradeToOptimize, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="Re-run this cutting list through OPTIMIZE at the SETTINGS level and compare the sheet count"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton GroupName="OptTabs" Tag="&#xE821;" Content="JOBS"
                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=0}"
                             Style="{StaticResource OptRailTab}" Margin="0,0,8,0"/>
                <RadioButton GroupName="OptTabs" Tag="&#xE8A7;" Content="SIZES"
                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=1}"
                             Style="{StaticResource OptRailTab}" Margin="0,0,8,0"/>
                <!-- CUT LIST — manual entry, so the engine can be driven with no
                     proforma invoice behind it at all. Shown second on the rail,
                     but its SelectedTabIndex is 7, the last value: inserting it
                     at 2 would have renumbered five tabs across seven XAML
                     triggers and three C# jump sites. Visual order comes from
                     element order here, not from the index. See TabIndexCutList
                     in OptimizationViewModel.CutList.cs. -->
                <RadioButton GroupName="OptTabs" Tag="&#xE70F;" Content="CUT LIST"
                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=7}"
                             Style="{StaticResource OptRailTab}" Margin="0,0,8,0"/>
                <RadioButton GroupName="OptTabs" Tag="&#xE7B8;" Content="STOCKS"
                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=2}"
                             Style="{StaticResource OptRailTab}" Margin="0,0,8,0"/>
                <RadioButton GroupName="OptTabs" Tag="&#xE713;" Content="SETTINGS"
                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=3}"
                             Style="{StaticResource OptRailTab}" Margin="0,0,8,0"/>
                <RadioButton GroupName="OptTabs" Tag="&#xE9D9;" Content="SUMMARY"
                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=4}"
                             Style="{StaticResource OptRailTab}" Margin="0,0,8,0"/>
                <RadioButton GroupName="OptTabs" Tag="&#xE80A;" Content="2D VIEW"
                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=5}"
                             Style="{StaticResource OptRailTab}" Margin="0,0,8,0"/>
                <RadioButton GroupName="OptTabs" Tag="&#xE9F9;" Content="REPORT"
                             IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=6}"
                             Style="{StaticResource OptRailTab}"/>
            </StackPanel>

            <!-- ── KPI card strip ── -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CONFIRMED JOBS -->
                <Border Grid.Column="0" Style="{StaticResource OptKpiCard}" Margin="0,0,12,0">
                    <StackPanel>
                        <Border Height="2" Background="{DynamicResource AccentBrush}"
                                CornerRadius="{DynamicResource CardCornerRadius}" Margin="0,0,0,10" Style="{StaticResource SurfacePrimaryStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource OptKpiBadge}" Background="{DynamicResource TintBlueBrush}">
                                <TextBlock Text="&#xE821;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.H2}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="CONFIRMED JOBS" Style="{StaticResource OptHeader}"/>
                                <TextBlock Text="{Binding KpiJobs}" Style="{StaticResource OptKpiValue}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- PIECES -->
                <Border Grid.Column="1" Style="{StaticResource OptKpiCard}" Margin="0,0,12,0">
                    <StackPanel>
                        <Border Height="2" Background="{DynamicResource AccentBrush}"
                                CornerRadius="{DynamicResource CardCornerRadius}" Margin="0,0,0,10" Style="{StaticResource SurfacePrimaryStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource OptKpiBadge}" Background="{DynamicResource TintGreenBrush}">
                                <TextBlock Text="&#xE80A;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.H2}"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="PIECES" Style="{StaticResource OptHeader}"/>
                                <TextBlock Text="{Binding KpiPieces}" Style="{StaticResource OptKpiValue}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- TOTAL GLASS -->
                <Border Grid.Column="2" Style="{StaticResource OptKpiCard}" Margin="0,0,12,0">
                    <StackPanel>
                        <Border Height="2" Background="{DynamicResource AccentBrush}"
                                CornerRadius="{DynamicResource CardCornerRadius}" Margin="0,0,0,10" Style="{StaticResource SurfacePrimaryStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource OptKpiBadge}" Background="{DynamicResource TintAmberBrush}">
                                <TextBlock Text="&#xE9D9;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.H2}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="TOTAL GLASS" Style="{StaticResource OptHeader}"/>
                                <TextBlock Text="{Binding KpiGlass}" Style="{StaticResource OptKpiValue}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CUTTING GROUPS -->
                <Border Grid.Column="3" Style="{StaticResource OptKpiCard}">
                    <StackPanel>
                        <Border Height="2" Background="{DynamicResource AccentBrush}"
                                CornerRadius="{DynamicResource CardCornerRadius}" Margin="0,0,0,10" Style="{StaticResource SurfacePrimaryStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource OptKpiBadge}" Background="{DynamicResource TintTealBrush}">
                                <TextBlock Text="&#xE8A7;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.H2}"
                                           Foreground="{DynamicResource InfoBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="CUTTING GROUPS" Style="{StaticResource OptHeader}"/>
                                <TextBlock Text="{Binding KpiGroups}" Style="{StaticResource OptKpiValue}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══ TAB CONTENT ══════════════════════════════════════════ -->
            <Grid Grid.Row="3">
                <tabs:JobsTabView/>
                <tabs:SizesTabView/>
                <tabs:CutListTabView/>
                <tabs:StocksTabView/>
                <tabs:SettingsTabView/>
                <tabs:SummaryTabView/>
                <tabs:TwoDViewTabView/>
                <tabs:ReportTabView/>
            </Grid>
        </Grid>

        <!-- ══ OPTIMIZATION PROGRESS SCREEN ══════════════════════════════
             Covers the module while a run is in flight. A large job (many
             cutting groups, thousands of parts) can legitimately take
             minutes, and the old 3px indeterminate header bar made that
             indistinguishable from a hung UI. The bar is determinate for
             both stages: OPTIMIZE reports per candidate pass, QUICK per
             cutting group. Rendered last so it sits above the tab host. -->
        <Grid Visibility="{Binding IsRunProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{DynamicResource Surface.Secondary.BackgroundBrush}" Opacity="0.96"/>

            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="520"
                    Padding="28,24" CornerRadius="{DynamicResource CardCornerRadius}"
                    Background="{DynamicResource Surface.Secondary.BackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="OPTIMIZATION IN PROGRESS" Style="{StaticResource OptPanelTitle}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding RunStageLabel}" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,6,0,0"
                               FontSize="{DynamicResource FontSize.Body}"
                               FontWeight="{DynamicResource Weight.SemiBold}"
                               Foreground="{DynamicResource AccentBrush}"/>

                    <ProgressBar Height="8" Minimum="0" Maximum="100" Margin="0,18,0,0"
                                 Value="{Binding RunProgressPercent, Mode=OneWay}"/>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding RunProgressDetail}" TextWrapping="Wrap"
                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Top" Margin="12,0,0,0"
                                   Text="{Binding RunProgressPercent, StringFormat={}{0}%}"
                                   FontSize="{DynamicResource FontSize.Body}"
                                   FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,16,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding RunScaleLabel}" TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSize.Caption}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Visibility="{Binding HasRunScale, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Text="{Binding RunElapsedLabel, StringFormat=Elapsed {0}}"
                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                   FontWeight="{DynamicResource Weight.SemiBold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Grid>

                    <Button Content="Cancel Run" Style="{StaticResource OutlinedPillButton}"
                            Command="{Binding CancelRunCommand}" IsEnabled="{Binding CanCancel}"
                            HorizontalAlignment="Center" Margin="0,20,0,0" Padding="26,8"
                            ToolTip="Stops the run — the engine checks for cancellation once per part"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
