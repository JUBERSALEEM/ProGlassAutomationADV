<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Optimization/OptimizationView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Optimization Engine — Full Light Studio Bento Redesign

     Shell: one indigo hero (identity + status, four stat pills, compact
     strategy/plate selects and the run actions), capsule navigation, tab
     workspace, and in-flight progress. The old KPI strip is gone so the 2D
     sheet can use that height.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Optimization.OptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tabs="clr-namespace:ProGlassAutomation.Views.Optimization.Tabs"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Dashboard/Overview/IndigoStudioResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid Margin="16,12,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══ 1. INDIGO HERO — approved top card (2026-09-26) ══════
                 Three tidy rows, always in this order:
                   ROW 1 · identity — heading + chip, with ONE status line
                          right-aligned ("Ready — 3 cutting groups staged"),
                   ROW 2 · four translucent stat pills,
                   ROW 3 · STRATEGY / PLATE sit immediately before the run
                          actions as ONE right-aligned cluster, with the
                          module sub-heading filling the freed left side.

                 What changed and why:
                   • The four stats leave the heading row and become pills on
                     their own row, so the title is never crowded.
                   • STRATEGY / PLATE drop from a 420px combo + a helper
                     paragraph each to a 9px caption over a 36px combo, and
                     they move off to the left edge to sit right in front of
                     the actions. STRATEGY is 350px because its option texts
                     run to 56 characters ("Stage 1: QUICK — area shelf,
                     strips, and bounded patterns") and 210px clipped them;
                     PLATE stays 190px because its values are "Yield" and
                     "Fill first plate". The hints are ToolTips now.
                   • The four stacked message blocks collapse into the single
                     HeroStatusLabel line (see OptimizationViewModel.HeroStatus.cs);
                     the indeterminate bar is gone because the in-flight
                     progress modal already carries determinate state. -->
            <Border Grid.Row="0" Style="{StaticResource OptHeroCard}" Padding="16,14" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ROW 1 · identity + live status -->
                    <Grid Grid.Row="0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Optimization" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{StaticResource OptOnIndigo}" VerticalAlignment="Center"
                                       ToolTip="Industrial cutting plans that minimize waste — pieces in, sheets out, verified layouts."/>
                            <Border Style="{StaticResource OptHeroChip}" Margin="10,0,0,0">
                                <TextBlock Text="GUILLOTINE 2D" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource OptOnIndigo}"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="{Binding HeroStatusLabel}" FontSize="11"
                                   Foreground="{StaticResource OptOnIndigoMuted}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="16,0,0,0"
                                   ToolTip="{Binding HeroStatusLabel}"/>
                    </Grid>

                    <!-- ROW 2 · four stat pills -->
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource OptHeroStatPill}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE821;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{StaticResource OptOnIndigo}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="CONFIRMED JOBS" Style="{StaticResource OptHeroStatLabel}"/>
                                    <TextBlock Text="{Binding KpiJobs}" Style="{StaticResource OptHeroStatValue}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource OptHeroStatPill}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{StaticResource OptOnIndigo}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="PIECES" Style="{StaticResource OptHeroStatLabel}"/>
                                    <TextBlock Text="{Binding KpiPieces}" Style="{StaticResource OptHeroStatValue}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource OptHeroStatPill}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{StaticResource OptOnIndigo}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="TOTAL GLASS" Style="{StaticResource OptHeroStatLabel}"/>
                                    <TextBlock Text="{Binding KpiGlass}" Style="{StaticResource OptHeroStatValue}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Style="{StaticResource OptHeroStatPill}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{StaticResource OptOnIndigo}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="CUTTING GROUPS" Style="{StaticResource OptHeroStatLabel}"/>
                                    <TextBlock Text="{Binding KpiGroups}" Style="{StaticResource OptHeroStatValue}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ROW 3 · one right-aligned control cluster, with the
                         module sub-heading filling the space the selects used
                         to occupy on the left.

                         Order is deliberate: STRATEGY and PLATE sit
                         immediately BEFORE the actions, so the operator reads
                         "pick the settings, then run" as one gesture. The
                         strategy field is the widest control because its
                         labels are the longest strings in the card — e.g.
                         "Stage 1: QUICK — area shelf, strips, and bounded
                         patterns" — and a 210px field clipped them. PLATE
                         stays narrow: its values are "Yield" and
                         "Fill first plate". -->
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Industrial cutting plans that minimize waste — pieces in, sheets out, verified layouts."
                                   FontSize="11" Foreground="{StaticResource OptOnIndigoMuted}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   VerticalAlignment="Bottom" Margin="0,0,16,10"
                                   ToolTip="Industrial cutting plans that minimize waste — pieces in, sheets out, verified layouts."/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <StackPanel Width="350" Margin="0,0,12,0">
                                <TextBlock Text="STRATEGY" Style="{StaticResource OptHeroFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding StageStrategies}"
                                          SelectedItem="{Binding SelectedStageStrategy}"
                                          Style="{StaticResource OptHeroComboStyle}"
                                          IsEnabled="{Binding CanRun}"
                                          ToolTip="{Binding SelectedStageStrategyHint}"
                                          AutomationProperties.Name="Optimize effort and strategy stage"/>
                            </StackPanel>

                            <StackPanel Width="190" Margin="0,0,16,0">
                                <TextBlock Text="PLATE" Style="{StaticResource OptHeroFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding PlatePatterns}"
                                          SelectedItem="{Binding SelectedPlatePattern}"
                                          Style="{StaticResource OptHeroComboStyle}"
                                          IsEnabled="{Binding CanRun}"
                                          ToolTip="{Binding SelectedPlatePatternHint}"
                                          AutomationProperties.Name="Plate pattern"/>
                            </StackPanel>

                            <Button Content="Run Quick" Style="{StaticResource OptHeroGhostButton}"
                                    Command="{Binding RunQuickCommand}" IsEnabled="{Binding CanRun}" Margin="0,0,8,0"
                                    VerticalAlignment="Bottom"
                                    ToolTip="Always runs the quick portfolio. The stage above applies to Run Optimize. Fill first plate, if selected, uses that stage only to widen its own search."/>
                            <Button Content="Cancel" Style="{StaticResource OptHeroGhostButton}"
                                    Command="{Binding CancelRunCommand}" IsEnabled="{Binding CanCancel}" Margin="0,0,8,0"
                                    VerticalAlignment="Bottom"
                                    ToolTip="Stop the current run — engine checks for cancellation once per part"/>
                            <Button Content="Upgrade to Optimize" Style="{StaticResource OptHeroGhostButton}"
                                    Command="{Binding UpgradeToOptimizeCommand}" Margin="0,0,8,0"
                                    VerticalAlignment="Bottom"
                                    Visibility="{Binding CanUpgradeToOptimize, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTip="Re-run this cutting list through OPTIMIZE at the selected stage. Auto chooses an existing stage. The plate pattern stays as selected."/>
                            <Button Content="Run Optimize" Style="{StaticResource OptHeroPillButton}"
                                    Command="{Binding RunOptimizeCommand}" IsEnabled="{Binding CanRun}"
                                    VerticalAlignment="Bottom"
                                    ToolTip="Runs the stage selected above. Auto chooses an existing stage for each cutting group. Yield stays the winner unless Fill first plate is selected."/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ══ 2. STUDIO BENTO MODULE TAB RAIL ══ -->
            <Border Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8">
                <WrapPanel Orientation="Horizontal">
                    <RadioButton GroupName="OptTabs" Tag="&#xE821;" Content="JOBS"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=0}"
                                 Style="{StaticResource OptRailTab}"
                                 ToolTip="JOBS — Choose which confirmed Job Orders this run cuts from, then tick the panes to include. The source list is locked to approved JOs, so nothing can be pulled in from an unapproved order."/>
                    <RadioButton GroupName="OptTabs" Tag="&#xE8A7;" Content="SIZES"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=1}"
                                 Style="{StaticResource OptRailTab}"
                                 ToolTip="SIZES — Thickness and colour summary of the piece list. Read-only: it is derived from the panes you ticked on JOBS."/>
                    <RadioButton GroupName="OptTabs" Tag="&#xE70F;" Content="CUT LIST"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=7}"
                                 Style="{StaticResource OptRailTab}"
                                 ToolTip="CUT LIST — Enter sizes by hand when a run is not driven by a Job Order. Rows you add here feed the engine exactly like imported panes."/>
                    <RadioButton GroupName="OptTabs" Tag="&#xE7B8;" Content="STOCKS"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=2}"
                                 Style="{StaticResource OptRailTab}"
                                 ToolTip="STOCKS — The sheet sizes this run may cut from, taken from the ticked Job Orders' Step 4 racks. Untick a size to hold it back from the run."/>
                    <RadioButton GroupName="OptTabs" Tag="&#xE713;" Content="SETTINGS"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=3}"
                                 Style="{StaticResource OptRailTab}"
                                 ToolTip="SETTINGS — Margins, kerf, minimum breakout, rotation, cutting complexity, search effort and plate pattern, for the thickness currently in use."/>
                    <RadioButton GroupName="OptTabs" Tag="&#xE9D9;" Content="SUMMARY"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=4}"
                                 Style="{StaticResource OptRailTab}"
                                 ToolTip="SUMMARY — Sheets used, utilisation and unplaced pieces for every cutting group, ordered highest to lowest utilisation."/>
                    <RadioButton GroupName="OptTabs" Tag="&#xE80A;" Content="2D VIEW"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=5}"
                                 Style="{StaticResource OptRailTab}"
                                 ToolTip="2D VIEW — Sheet-by-sheet layout with the margin and breakout overlay drawn to scale. Use it to check a plan before it reaches the table."/>
                    <RadioButton GroupName="OptTabs" Tag="&#xE9F9;" Content="REPORT"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=6}"
                                 Style="{StaticResource OptRailTab}"
                                 ToolTip="REPORT — Layout, parts and stocks summaries with CSV export." Margin="0"/>
                </WrapPanel>
            </Border>

            <!-- Workspace takes the height the KPI strip used to occupy. -->
            <Grid Grid.Row="2" IsEnabled="{Binding CanRun}">
                <tabs:JobsTabView/>
                <tabs:SizesTabView/>
                <tabs:CutListTabView/>
                <tabs:StocksTabView/>
                <tabs:SettingsTabView/>
                <tabs:SummaryTabView/>
                <tabs:TwoDViewTabView/>
                <tabs:ReportTabView/>
            </Grid>
        </Grid>

        <!-- ══ 5. IN-FLIGHT PROGRESS MODAL OVERLAY ══ -->
        <Grid Visibility="{Binding IsRunProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{DynamicResource LiquidOverlayBrush}"/>

            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="520"
                    Padding="28,26" CornerRadius="16"
                    Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.14"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Modal Header Icon Badge -->
                    <Border Width="50" Height="50" CornerRadius="12"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                            HorizontalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="OPTIMIZATION IN PROGRESS" Style="{StaticResource OptPanelTitle}"
                               HorizontalAlignment="Center" FontSize="17"/>

                    <TextBlock Text="{Binding RunArchitectureLabel}" TextWrapping="Wrap" MaxWidth="440"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,6,0,8" FontSize="12"/>

                    <TextBlock Text="{Binding RunStageLabel}" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,4,0,0"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"/>

                    <!-- Progress Bar -->
                    <ProgressBar Height="8" Minimum="0" Maximum="100" Margin="0,18,0,0"
                                 Value="{Binding RunProgressPercent, Mode=OneWay}"
                                 Foreground="{DynamicResource AccentBrush}"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding RunProgressDetail}" TextWrapping="Wrap"
                                   FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Top" Margin="12,0,0,0"
                                   Text="{Binding RunProgressPercent, StringFormat={}{0}%}"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding RunScaleLabel}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Visibility="{Binding HasRunScale, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Text="{Binding RunElapsedLabel, StringFormat=Elapsed {0}}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Grid>

                    <Button Content="Cancel Run" Style="{StaticResource OptOutlinedButton}"
                            Command="{Binding CancelRunCommand}" IsEnabled="{Binding CanCancel}"
                            HorizontalAlignment="Center" Margin="0,20,0,0" Padding="28,0"
                            ToolTip="Stops the run — engine checks for cancellation once per part"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
