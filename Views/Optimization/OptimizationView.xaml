<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Optimization/OptimizationView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Optimization — module shell (design 2026-09-12)

     Tabs: JOBS → SIZES → STOCKS → MARGINS → RESULT → 2D VIEW.
     Runs the calibrated guillotine engine (Services/Optimization):
     QUICK single pass or OPTIMIZE multi-start levels 1–5. Rotation is
     enabled by default for all pieces (adaptive 0/90 mix).
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Optimization.OptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="TabCardInactiveStyle" TargetType="RadioButton"
               BasedOn="{StaticResource ModuleListTabInactiveStyle}"/>

        <Style x:Key="OptPanel" TargetType="Border"
               BasedOn="{StaticResource SurfaceSecondaryStyle}">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="4,8,4,4"/>
        </Style>

        <Style x:Key="OptFieldLabel" TargetType="TextBlock"
               BasedOn="{StaticResource FieldLabelStyle}"/>

        <!-- Self-contained input styles (IntInputStyle/ComboStyle are
             view-local in other modules — referencing them here threw
             'Cannot find resource' at runtime, ERR-413D37). -->
        <Style x:Key="OptIntInput" TargetType="TextBox"
               BasedOn="{StaticResource ModernTextBoxStyle}">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="behaviors:TextBoxBehaviors.AcceptIntegersOnly" Value="True"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Margin" Value="0,0,12,8"/>
        </Style>

        <Style x:Key="OptComboStyle" TargetType="ComboBox"
               BasedOn="{StaticResource ModernEditableComboBoxStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Header ═════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                CornerRadius="{DynamicResource CardCornerRadius}"
                Background="{DynamicResource DashAmbientBrush}"
                Padding="14,10"
                Margin="4,0,4,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="OPTIMIZATION"
                               Style="{StaticResource ModulePageTitleStyle}"/>
                    <TextBlock Style="{StaticResource ModulePageSubtitleStyle}">
                        <Run Text="Cutting plans that minimize waste — pieces in, sheets out, verified layouts."/>
                        <Run Text="  ·  UI REV 2026-09-12·B" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PieceSummary}"
                               FontSize="{StaticResource TextBody}"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <Button Content="Run Quick"
                            Style="{StaticResource OutlinedPillButton}"
                            Command="{Binding RunQuickCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="Run Optimize"
                            Style="{StaticResource PrimaryPillButton}"
                            Command="{Binding RunOptimizeCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Tab strip ══════════════════════════════════════════════ -->
        <UniformGrid Grid.Row="1" Columns="6" Margin="4,0">
            <RadioButton GroupName="OptTabs" Tag="&#xE8A5;" Content="Jobs"
                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=0}"
                         Style="{StaticResource TabCardInactiveStyle}"/>
            <RadioButton GroupName="OptTabs" Tag="&#xE8A7;" Content="Sizes"
                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=1}"
                         Style="{StaticResource TabCardInactiveStyle}"/>
            <RadioButton GroupName="OptTabs" Tag="&#xE7B8;" Content="Stocks"
                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=2}"
                         Style="{StaticResource TabCardInactiveStyle}"/>
            <RadioButton GroupName="OptTabs" Tag="&#xE713;" Content="Margins"
                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=3}"
                         Style="{StaticResource TabCardInactiveStyle}"/>
            <RadioButton GroupName="OptTabs" Tag="&#xE9D9;" Content="Result"
                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=4}"
                         Style="{StaticResource TabCardInactiveStyle}"/>
            <RadioButton GroupName="OptTabs" Tag="&#xE80A;" Content="2D View"
                         IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=5}"
                         Style="{StaticResource TabCardInactiveStyle}"/>
        </UniformGrid>

        <!-- ══ Content ════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">

            <!-- ── TAB 0 · JOBS ─────────────────────────────────────── -->
            <Grid Visibility="Collapsed">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource OptPanel}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="CONFIRMED JOB ORDERS · SOURCE LOCK"
                                   FontSize="{StaticResource TextCaption}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Margin="0,0,0,10"/>

                        <ListBox ItemsSource="{Binding AvailableJobs}"
                                 SelectedItem="{Binding SelectedJob}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="240"
                                 Margin="-4,0,0,8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,4">
                                        <TextBlock Text="{Binding JobOrderId}"
                                                   FontSize="{StaticResource TextBody}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        <TextBlock Text="{Binding Summary}"
                                                   FontSize="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Content="Load cutting list from selected job"
                                Style="{StaticResource PrimaryPillButton}"
                                Command="{Binding LoadSelectedJobCommand}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="Refresh jobs"
                                    Style="{StaticResource OutlinedPillButton}"
                                    Command="{Binding RefreshJobsCommand}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding JobsStatusText}"
                                   FontSize="{StaticResource TextCaption}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Margin="0,0,0,12"/>

                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,12"/>

                        <TextBlock Text="MANUAL PIECES (AD-HOC)"
                                   FontSize="{StaticResource TextCaption}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Glass composition" Style="{StaticResource OptFieldLabel}"/>
                        <TextBox Text="{Binding NewPiece.GlassRef, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Margin="0,0,0,8"/>

                        <TextBlock Text="Piece label" Style="{StaticResource OptFieldLabel}"/>
                        <TextBox Text="{Binding NewPiece.PieceLabel, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Margin="0,0,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Width mm" Style="{StaticResource OptFieldLabel}"/>
                                <TextBox Text="{Binding NewPiece.WidthText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource OptIntInput}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Height mm" Style="{StaticResource OptFieldLabel}"/>
                                <TextBox Text="{Binding NewPiece.HeightText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource OptIntInput}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Qty" Style="{StaticResource OptFieldLabel}"/>
                                <TextBox Text="{Binding NewPiece.QtyText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource OptIntInput}"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="Add piece"
                                Style="{StaticResource PrimaryPillButton}"
                                Command="{Binding AddPieceCommand}"
                                HorizontalAlignment="Stretch"
                                Margin="0,4,0,16"/>

                        <Button Content="Load reference job (calibration)"
                                Style="{StaticResource OutlinedPillButton}"
                                Command="{Binding LoadReferenceJobCommand}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8"/>
                        <Button Content="Clear list"
                                Style="{StaticResource OutlinedPillButton}"
                                Command="{Binding ClearPiecesCommand}"
                                HorizontalAlignment="Stretch"/>

                        <TextBlock Text="Source lock: cutting runs ONLY from confirmed Job Orders — select one above. Manual entry below is for ad-hoc pieces only."
                                   FontSize="{StaticResource TextCaption}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Margin="0,14,0,0"/>
                    </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource OptPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="1"
                                   Text="{Binding PiecesEmptyHint}"
                                   FontSize="{StaticResource TextBody}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   VerticalAlignment="Top"
                                   Margin="4,8,4,0"/>

                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Label" Style="{StaticResource OptFieldLabel}"/>
                            <TextBlock Grid.Column="1" Text="Glass composition" Style="{StaticResource OptFieldLabel}"/>
                            <TextBlock Grid.Column="2" Text="W × H (mm)" Style="{StaticResource OptFieldLabel}"/>
                            <TextBlock Grid.Column="3" Text="Qty" Style="{StaticResource OptFieldLabel}"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Pieces}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="4,6"
                                                BorderThickness="0,0,0,1"
                                                BorderBrush="{DynamicResource DividerBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding PieceLabel}"
                                                           FontSize="{StaticResource TextBody}"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding GlassRef}"
                                                           FontSize="{StaticResource TextBody}"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2"
                                                           FontSize="{StaticResource TextBody}"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}">
                                                    <Run Text="{Binding WidthText, Mode=OneWay}"/>
                                                    <Run Text="×"/>
                                                    <Run Text="{Binding HeightText, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Grid.Column="3" Text="{Binding QtyText}"
                                                           FontSize="{StaticResource TextBody}"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                <Button Grid.Column="4" Content="Remove"
                                                        Style="{StaticResource RowOutlinedButton}"
                                                        Command="{Binding DataContext.RemovePieceCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── TAB 1 · SIZES ────────────────────────────────────── -->
            <Grid Visibility="Collapsed">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Style="{StaticResource OptPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Pieces merge into cutting groups by glass composition (thickness + colour). Each group runs as its own optimization."
                                   FontSize="{StaticResource TextBody}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Margin="0,0,0,12"/>

                        <TextBlock Grid.Row="1"
                                   Text="{Binding PiecesEmptyHint}"
                                   FontSize="{StaticResource TextBody}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   VerticalAlignment="Top"
                                   Margin="4,8,4,0"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Composition" Style="{StaticResource OptFieldLabel}"/>
                                    <TextBlock Grid.Column="1" Text="Pieces" Style="{StaticResource OptFieldLabel}"/>
                                    <TextBlock Grid.Column="2" Text="Area (m²)" Style="{StaticResource OptFieldLabel}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding SizeGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="4,8"
                                                    BorderThickness="0,0,0,1"
                                                    BorderBrush="{DynamicResource DividerBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="120"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Composition}"
                                                               FontSize="{StaticResource TextBody}"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding PieceCount}"
                                                               FontSize="{StaticResource TextBody}"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding AreaM2}"
                                                               FontSize="{StaticResource TextBody}"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── TAB 2 · STOCKS ───────────────────────────────────── -->
            <Grid Visibility="Collapsed">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Style="{StaticResource OptPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Stock pool for the run. The engine always consumes the smallest stock that fits each piece — big racks stay available for the glass that needs them. Available = 0 means unlimited."
                                   FontSize="{StaticResource TextBody}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Margin="0,0,0,12"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Width mm" Style="{StaticResource OptFieldLabel}"/>
                                <TextBox Text="{Binding NewStock.WidthText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource OptIntInput}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Height mm" Style="{StaticResource OptFieldLabel}"/>
                                <TextBox Text="{Binding NewStock.HeightText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource OptIntInput}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Available" Style="{StaticResource OptFieldLabel}"/>
                                <TextBox Text="{Binding NewStock.AvailableText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource OptIntInput}"/>
                            </StackPanel>
                            <Button Content="Add stock"
                                    Style="{StaticResource PrimaryPillButton}"
                                    Command="{Binding AddStockCommand}"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,8"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Stocks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="4,8"
                                                BorderThickness="0,0,0,1"
                                                BorderBrush="{DynamicResource DividerBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           FontSize="{StaticResource TextBody}"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}">
                                                    <Run Text="{Binding WidthText, Mode=OneWay}"/>
                                                    <Run Text="×"/>
                                                    <Run Text="{Binding HeightText, Mode=OneWay}"/>
                                                    <Run Text="mm"/>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1"
                                                           FontSize="{StaticResource TextBody}"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}">
                                                    <Run Text="available:"/>
                                                    <Run Text="{Binding AvailableText, Mode=OneWay}"/>
                                                </TextBlock>
                                                <Button Grid.Column="2" Content="Remove"
                                                        Style="{StaticResource RowOutlinedButton}"
                                                        Command="{Binding DataContext.RemoveStockCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── TAB 3 · MARGINS ──────────────────────────────────── -->
            <Grid Visibility="Collapsed">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Style="{StaticResource OptPanel}">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="CUTTING SETTINGS"
                                   FontSize="{StaticResource TextCaption}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Glass thickness (mm)" Style="{StaticResource OptFieldLabel}"/>
                                <TextBox Text="{Binding ThicknessText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource OptIntInput}"/>

                                <TextBlock Text="Left margin LM (mm)" Style="{StaticResource OptFieldLabel}"/>
                                <TextBox Text="{Binding LeftMarginText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource OptIntInput}"/>

                                <TextBlock Text="Right margin RM (mm)" Style="{StaticResource OptFieldLabel}"/>
                                <TextBox Text="{Binding RightMarginText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource OptIntInput}"/>

                                <TextBlock Text="Top margin TM (mm)" Style="{StaticResource OptFieldLabel}"/>
                                <TextBox Text="{Binding TopMarginText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource OptIntInput}"/>

                                <TextBlock Text="Bottom margin BM (mm)" Style="{StaticResource OptFieldLabel}"/>
                                <TextBox Text="{Binding BottomMarginText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource OptIntInput}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Kerf / blade (mm)" Style="{StaticResource OptFieldLabel}"/>
                                <TextBox Text="{Binding KerfText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource OptIntInput}"/>

                                <TextBlock Text="Minimum breakout (mm)" Style="{StaticResource OptFieldLabel}"/>
                                <TextBox Text="{Binding MinBreakoutText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource OptIntInput}"/>

                                <CheckBox IsChecked="{Binding RotationEnabled}"
                                          Margin="0,10,0,4"
                                          Foreground="{DynamicResource PrimaryForegroundBrush}">
                                    <TextBlock Text="Allow rotation (0° / 90° mix) — enabled by default for all pieces"
                                               TextWrapping="Wrap"
                                               FontSize="{StaticResource TextBody}"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                </CheckBox>

                                <TextBlock Text="Optimize effort level" Style="{StaticResource OptFieldLabel}"
                                           Margin="0,10,0,0"/>
                                <ComboBox ItemsSource="{Binding EffortLevels}"
                                          SelectedItem="{Binding SelectedEffortLevel}"
                                          Style="{StaticResource OptComboStyle}"
                                          Width="90"
                                          HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Load house defaults"
                                    Style="{StaticResource OutlinedPillButton}"
                                    Command="{Binding LoadHouseDefaultsCommand}"/>
                        </StackPanel>

                        <TextBlock Text="House defaults (floor-confirmed): 6mm glass → LM/RM/TM/BM 15mm, minimum breakout 15mm, kerf 3mm (4mm from 10mm). Every value is editable per run."
                                   FontSize="{StaticResource TextCaption}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── TAB 4 · RESULT ───────────────────────────────────── -->
            <Grid Visibility="Collapsed">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="4">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Style="{StaticResource OptPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource SurfaceSecondaryStyle}" Padding="12,8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="SHEETS" FontSize="{StaticResource TextCaption}"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock Text="{Binding ResultSheets}" FontSize="{StaticResource TextSubhead}"
                                               FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource SurfaceSecondaryStyle}" Padding="12,8" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="UTILIZATION" FontSize="{StaticResource TextCaption}"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock Text="{Binding ResultUtilization}" FontSize="{StaticResource TextSubhead}"
                                               FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource SurfaceSecondaryStyle}" Padding="12,8" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="UNPLACED" FontSize="{StaticResource TextCaption}"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock Text="{Binding ResultUnplaced}" FontSize="{StaticResource TextSubhead}"
                                               FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource SurfaceSecondaryStyle}" Padding="12,8" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="ORACLE" FontSize="{StaticResource TextCaption}"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                    <TextBlock Text="{Binding ResultOracle}" FontSize="{StaticResource TextBody}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{Binding RunMessage}"
                                   FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Margin="2,10,0,6"/>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding ResultStage}"
                                           FontSize="{StaticResource TextCaption}"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Sheet" Style="{StaticResource OptFieldLabel}"/>
                                    <TextBlock Grid.Column="1" Text="Stock (mm)" Style="{StaticResource OptFieldLabel}"/>
                                    <TextBlock Grid.Column="2" Text="Pieces" Style="{StaticResource OptFieldLabel}"/>
                                    <TextBlock Grid.Column="3" Text="Utilization" Style="{StaticResource OptFieldLabel}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding SheetRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="4,8"
                                                    BorderThickness="0,0,0,1"
                                                    BorderBrush="{DynamicResource DividerBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="120"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding SheetNo}"
                                                               FontSize="{StaticResource TextBody}"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding StockLabel}"
                                                               FontSize="{StaticResource TextBody}"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding PieceCount}"
                                                               FontSize="{StaticResource TextBody}"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Utilization}"
                                                               FontSize="{StaticResource TextBody}"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── TAB 5 · 2D VIEW ──────────────────────────────────── -->
            <Grid Visibility="Collapsed">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="5">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Style="{StaticResource OptPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="◀ Prev"
                                        Style="{StaticResource OutlinedPillButton}"
                                        Command="{Binding SelectPreviousSheetCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Content="Next ▶"
                                        Style="{StaticResource OutlinedPillButton}"
                                        Command="{Binding SelectNextSheetCommand}"
                                        Margin="0,0,16,0"/>
                                <TextBlock Text="{Binding PreviewCaption}"
                                           FontSize="{StaticResource TextBody}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="2"
                                    Background="{DynamicResource DashAmbientBrush}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                <Canvas Width="{Binding RenderWidth}"
                                        Height="{Binding RenderHeight}">
                                    <ItemsControl ItemsSource="{Binding SheetRects}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="{Binding Width}"
                                                        Height="{Binding Height}"
                                                        BorderThickness="1"
                                                        BorderBrush="{DynamicResource WindowBackgroundBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Rotated}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource MutedForegroundBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Label}"
                                                               FontSize="9"
                                                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                               Margin="3,2"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
