<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Optimization/OptimizationView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Optimization — glass cutting optimization (dusk-navy ERP)

     High-fidelity industrial layout (approved mockup):
       • slim LEFT VERTICAL navigation rail — JOBS · SIZES · STOCKS ·
         SETTINGS · SUMMARY · 2D VIEW (active tab = sky-blue accent bar)
       • top KPI card strip — CONFIRMED JOBS · PIECES · TOTAL GLASS ·
         CUTTING GROUPS, each with a tinted square icon badge
       • JOBS screen split in two columns:
           LEFT  — CONFIRMED JOB ORDERS · SOURCE LOCK (search + job cards:
                   job id, customer, pieces, m², spec count)
           RIGHT — STEP 4/5 PANE BREAKDOWN checklist (checkbox · pane ·
                   spec · glass composition · pcs · m²) with Select all /
                   Clear and a sky-blue "Add … panes → cutting list" CTA,
                   and the CUTTING LIST table below
       • pale uppercase column headers, thin 1px glass borders, 12px
         rounded panels, Segoe UI with generous spacing.

     All colours flow from the app theme (Dark = dusk-navy #0B1220 /
     #102244, sky #38BDF8, emerald #34D399, amber #F59E0B) so the screen
     stays consistent with the rest of the application in both themes.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Optimization.OptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ══ Panel card — 12px rounded, thin glass border ══════════ -->
        <Style x:Key="OptPanelCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderGradientSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Inner card (job cards, nested surfaces) -->
        <Style x:Key="OptInnerCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderGradientSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <!-- KPI stat card -->
        <Style x:Key="OptKpiCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderGradientSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <!-- Tinted square icon badge on each KPI card -->
        <Style x:Key="OptKpiBadge" TargetType="Border">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Typography -->
        <Style x:Key="OptHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
        </Style>
        <Style x:Key="OptPanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        </Style>
        <Style x:Key="OptKpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        </Style>

        <!-- ══ Left rail tab ══════════════════════════════════════════ -->
        <Style x:Key="OptRailTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" CornerRadius="10" Background="Transparent">
                            <Grid>
                                <Border x:Name="Bar" HorizontalAlignment="Left" Width="3" Margin="0,8"
                                        CornerRadius="0,3,3,0" Background="Transparent"/>
                                <StackPanel Orientation="Horizontal" Margin="14,11,12,11">
                                    <TextBlock x:Name="Icon" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Text="{TemplateBinding Tag}" Foreground="{TemplateBinding Foreground}"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ContentPresenter x:Name="Label" VerticalAlignment="Center"
                                                      Content="{TemplateBinding Content}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
                                <Setter TargetName="Label" Property="TextElement.FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Inputs ═════════════════════════════════════════════════ -->
        <Style x:Key="OptIntInput" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="behaviors:TextBoxBehaviors.AcceptIntegersOnly" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OptComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ComboBoxItemHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource OptComboItem}"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,0,32,0" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                              TextElement.Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource PopupSurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Margin="0,4,0,0">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="95"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost action button (remove / clear) -->
        <Style x:Key="OptGhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Transparent list host (job picker) -->
        <Style x:Key="OptListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style x:Key="OptListBoxItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filmstrip thumb: a sheet chip in the 2D view navigator. -->
        <Style x:Key="SheetChipStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" CornerRadius="10" Padding="10,7"
                                Background="{DynamicResource WindowBackgroundBrush}"
                                BorderBrush="{DynamicResource GlassBorderGradientSoft}"
                                BorderThickness="1" SnapsToDevicePixels="True">
                            <StackPanel>
                                <TextBlock x:Name="No" Text="{Binding SheetNo, StringFormat='Sheet {0}'}"
                                           FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                <TextBlock x:Name="Util" Text="{Binding Utilization}"
                                           FontSize="{StaticResource TextXSmall}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessBrush}" Margin="0,1,0,0"/>
                                <TextBlock Text="{Binding StockLabel}" FontSize="{StaticResource TextXSmall}"
                                           Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Chip" Property="BorderThickness" Value="1.5"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ═══ Root: left rail + content ═══════════════════════════════ -->
    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ LEFT VERTICAL NAVIGATION RAIL ══════════════════════════ -->
        <Border Grid.Column="0" Background="{DynamicResource SideMenuBackgroundBrush}"
                BorderBrush="{DynamicResource GlassBorderGradientSoft}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,22,18,24">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PROGLASS" FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="OPTIMIZATION" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tabs -->
                <StackPanel DockPanel.Dock="Top" Margin="12,0,12,12">
                    <TextBlock Text="CUTTING" Style="{StaticResource OptHeader}" Margin="8,0,0,10"/>
                    <RadioButton GroupName="OptTabs" Tag="&#xE821;" Content="JOBS"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=0}"
                                 Style="{StaticResource OptRailTab}"/>
                    <RadioButton GroupName="OptTabs" Tag="&#xE8A7;" Content="SIZES"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=1}"
                                 Style="{StaticResource OptRailTab}"/>
                    <RadioButton GroupName="OptTabs" Tag="&#xE7B8;" Content="STOCKS"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=2}"
                                 Style="{StaticResource OptRailTab}"/>
                    <RadioButton GroupName="OptTabs" Tag="&#xE713;" Content="SETTINGS"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=3}"
                                 Style="{StaticResource OptRailTab}"/>
                    <RadioButton GroupName="OptTabs" Tag="&#xE9D9;" Content="SUMMARY"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=4}"
                                 Style="{StaticResource OptRailTab}"/>
                    <RadioButton GroupName="OptTabs" Tag="&#xE80A;" Content="2D VIEW"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=5}"
                                 Style="{StaticResource OptRailTab}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══ CONTENT ════════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Margin="22,20,22,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Header: title + engine controls ── -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="OPTIMIZATION" Style="{StaticResource ModulePageTitleStyle}"/>
                    <TextBlock Text="Cutting plans that minimize waste — pieces in, sheets out, verified layouts."
                               FontSize="{StaticResource TextBody}" Foreground="{DynamicResource MutedForegroundBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding RunStageLabel}" FontSize="{StaticResource TextCaption}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,2"/>
                        <ProgressBar Height="3" IsIndeterminate="True" Width="200" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Button Content="Run Quick" Style="{StaticResource OutlinedPillButton}"
                            Command="{Binding RunQuickCommand}" IsEnabled="{Binding CanRun}" Margin="0,0,8,0"
                            ToolTip="One fast deterministic pass (guillotine shelves) — seconds"/>
                    <Button Content="Run Optimize" Style="{StaticResource PrimaryPillButton}"
                            Command="{Binding RunOptimizeCommand}" IsEnabled="{Binding CanRun}"
                            ToolTip="Multi-start search, effort level 1–5 — best utilization wins"/>
                </StackPanel>
            </Grid>

            <!-- ── KPI card strip ── -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CONFIRMED JOBS -->
                <Border Grid.Column="0" Style="{StaticResource OptKpiCard}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource OptKpiBadge}" Background="{DynamicResource TintBlueBrush}">
                            <TextBlock Text="&#xE821;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CONFIRMED JOBS" Style="{StaticResource OptHeader}"/>
                            <TextBlock Text="{Binding KpiJobs}" Style="{StaticResource OptKpiValue}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- PIECES -->
                <Border Grid.Column="1" Style="{StaticResource OptKpiCard}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource OptKpiBadge}" Background="{DynamicResource TintGreenBrush}">
                            <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PIECES" Style="{StaticResource OptHeader}"/>
                            <TextBlock Text="{Binding KpiPieces}" Style="{StaticResource OptKpiValue}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- TOTAL GLASS -->
                <Border Grid.Column="2" Style="{StaticResource OptKpiCard}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource OptKpiBadge}" Background="{DynamicResource TintAmberBrush}">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{DynamicResource WarningBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="TOTAL GLASS" Style="{StaticResource OptHeader}"/>
                            <TextBlock Text="{Binding KpiGlass}" Style="{StaticResource OptKpiValue}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CUTTING GROUPS -->
                <Border Grid.Column="3" Style="{StaticResource OptKpiCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource OptKpiBadge}" Background="{DynamicResource TintTealBrush}">
                            <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{DynamicResource InfoBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CUTTING GROUPS" Style="{StaticResource OptHeader}"/>
                            <TextBlock Text="{Binding KpiGroups}" Style="{StaticResource OptKpiValue}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══ TAB CONTENT ══════════════════════════════════════════ -->
            <Grid Grid.Row="2">

                <!-- ── TAB 0 · JOBS ─────────────────────────────────── -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ═ LEFT · CONFIRMED JOB ORDERS ═ -->
                    <Border Grid.Column="0" Style="{StaticResource OptPanelCard}" Margin="0,0,16,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="CONFIRMED JOB ORDERS · SOURCE LOCK"
                                       Style="{StaticResource OptPanelTitle}" Margin="0,0,0,12"/>

                            <TextBox Grid.Row="1" Text="{Binding JobSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModuleListFilterInputStyle}" Margin="0,0,0,12"
                                     ToolTip="Filter by job id, customer or summary"/>

                            <ListBox Grid.Row="2" ItemsSource="{Binding FilteredJobs}"
                                     Style="{StaticResource OptListBox}"
                                     ItemContainerStyle="{StaticResource OptListBoxItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource OptInnerCard}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                          VerticalAlignment="Top" Margin="0,2,12,0"
                                                          Style="{StaticResource LiquidGlassCheckBox}"
                                                          ToolTip="Tick to include this job's panes — tick many jobs to combine (e.g. shared low-e outers merge into one cutting group)"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding JobOrderId}" FontSize="{StaticResource TextBody}"
                                                               FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                    <TextBlock Text="{Binding CustomerName}" FontSize="{StaticResource TextCaption}"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,8"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="{DynamicResource TintBlueBrush}" CornerRadius="6" Padding="8,3">
                                                            <TextBlock Text="{Binding PiecesLabel}" FontSize="{StaticResource TextXSmall}"
                                                                       FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                                        </Border>
                                                        <Border Background="{DynamicResource TintAmberBrush}" CornerRadius="6" Padding="8,3" Margin="6,0,0,0">
                                                            <TextBlock Text="{Binding AreaLabel}" FontSize="{StaticResource TextXSmall}"
                                                                       FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                                                        </Border>
                                                        <Border Background="{DynamicResource TintGreenBrush}" CornerRadius="6" Padding="8,3" Margin="6,0,0,0">
                                                            <TextBlock Text="{Binding SpecCountLabel}" FontSize="{StaticResource TextXSmall}"
                                                                       FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="3">
                                <TextBlock Text="{Binding JobsStatusText}" FontSize="{StaticResource TextCaption}"
                                           TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}"
                                           Margin="0,4,0,10"/>
                                <Button Content="Refresh jobs" Style="{StaticResource OutlinedPillButton}"
                                        Command="{Binding RefreshJobsCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ═ RIGHT · PANE BREAKDOWN + CUTTING LIST ═ -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- STEP 4/5 pane breakdown checklist -->
                        <Border Grid.Row="0" Style="{StaticResource OptPanelCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="STEP 4/5 PANE BREAKDOWN — SELECT THE PANES TO CUT"
                                           Style="{StaticResource OptPanelTitle}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedPaneSummary}" FontSize="{StaticResource TextCaption}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>

                                <!-- empty hint -->
                                <TextBlock Text="Tick a job order on the left — its Step 4/5 panes (outer → inner) appear here for selection."
                                           FontSize="{StaticResource TextBody}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,12"
                                           Visibility="{Binding HasPaneChecklist, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                                            Visibility="{Binding HasPaneChecklist, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button Content="Select all" Style="{StaticResource OutlinedPillButton}"
                                            Command="{Binding SelectAllPanesCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Clear" Style="{StaticResource OutlinedPillButton}"
                                            Command="{Binding ClearPaneSelectionCommand}"/>
                                </StackPanel>

                                <!-- checklist header -->
                                <Grid Margin="0,0,0,6" Visibility="{Binding HasPaneChecklist, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="86"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="PANE" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Grid.Column="2" Text="SPEC" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Grid.Column="3" Text="GLASS COMPOSITION" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Grid.Column="4" Text="PCS" Style="{StaticResource OptHeader}" TextAlignment="Right" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="5" Text="AREA" Style="{StaticResource OptHeader}" TextAlignment="Right"/>
                                </Grid>

                                <!-- checklist rows -->
                                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding HasPaneChecklist, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl ItemsSource="{Binding PaneChecklist}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="4,7" BorderThickness="0,0,0,1"
                                                        BorderBrush="{DynamicResource DividerBrush}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="34"/>
                                                            <ColumnDefinition Width="96"/>
                                                            <ColumnDefinition Width="64"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="72"/>
                                                            <ColumnDefinition Width="86"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                                  VerticalAlignment="Center"
                                                                  Style="{StaticResource LiquidGlassCheckBox}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Sub}" FontSize="{StaticResource TextCaption}"
                                                                   FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding SpecLabel}" FontSize="{StaticResource TextCaption}"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Title}" FontSize="{StaticResource TextBody}"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding CountLabel}" FontSize="{StaticResource TextCaption}"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                   VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding AreaLabel}" FontSize="{StaticResource TextCaption}"
                                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                                   VerticalAlignment="Center" TextAlignment="Right"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Button Content="{Binding AddPanesButtonLabel}" Style="{StaticResource PrimaryPillButton}"
                                        Command="{Binding AddSelectedPanesCommand}"
                                        HorizontalAlignment="Stretch" Margin="0,12,0,0"
                                        Visibility="{Binding HasPaneChecklist, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>

                        <!-- CUTTING LIST -->
                        <Border Grid.Row="1" Style="{StaticResource OptPanelCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- title + tools -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="CUTTING LIST" Style="{StaticResource OptPanelTitle}"/>
                                        <TextBlock Text="{Binding PieceSummary}" FontSize="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Load reference job" Style="{StaticResource OptGhostButton}"
                                                Command="{Binding LoadReferenceJobCommand}" Margin="0,0,4,0"/>
                                        <Button Content="Clear list" Style="{StaticResource OptGhostButton}"
                                                Command="{Binding ClearPiecesCommand}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- ad-hoc add row -->
                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="LABEL" Style="{StaticResource OptHeader}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Width="150" Text="{Binding NewPiece.PieceLabel, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OptIntInput}" Margin="0,0,14,0"
                                             behaviors:TextBoxBehaviors.AcceptIntegersOnly="False" ToolTip="Piece ref / label"/>
                                    <TextBlock Grid.Column="2" Text="W (MM)" Style="{StaticResource OptHeader}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="3" Width="86" Text="{Binding NewPiece.WidthText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OptIntInput}" Margin="0,0,14,0"/>
                                    <TextBlock Grid.Column="4" Text="H (MM)" Style="{StaticResource OptHeader}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="5" Width="86" Text="{Binding NewPiece.HeightText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OptIntInput}" Margin="0,0,14,0"/>
                                    <TextBlock Grid.Column="6" Text="QTY" Style="{StaticResource OptHeader}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="7" Width="60" Text="{Binding NewPiece.QtyText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OptIntInput}" Margin="0,0,14,0"/>
                                    <Button Grid.Column="8" Content="+ Add" Style="{StaticResource PrimaryPillButton}"
                                            Command="{Binding AddPieceCommand}"/>
                                </Grid>

                                <!-- empty hint -->
                                <TextBlock Grid.Row="3" Text="{Binding PiecesEmptyHint}" FontSize="{StaticResource TextBody}"
                                           TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}"
                                           VerticalAlignment="Top" Margin="4,8,4,0"
                                           Visibility="{Binding HasPieces, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                                <!-- header -->
                                <Grid Grid.Row="2" Margin="0,0,0,6"
                                      Visibility="{Binding HasPieces, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="76"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="LABEL / PANE" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Grid.Column="1" Text="GLASS COMPOSITION" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Grid.Column="2" Text="W × H (MM)" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Grid.Column="3" Text="QTY" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Grid.Column="4" Text="ACTION" Style="{StaticResource OptHeader}" TextAlignment="Right"/>
                                </Grid>

                                <!-- rows -->
                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding HasPieces, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl ItemsSource="{Binding Pieces}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="4,7" BorderThickness="0,0,0,1"
                                                        BorderBrush="{DynamicResource DividerBrush}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="76"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding PieceLabel}" FontSize="{StaticResource TextBody}"
                                                                       FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Position}" FontSize="{StaticResource TextCaption}"
                                                                       Foreground="{DynamicResource AccentBrush}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding GlassRef}" FontSize="{StaticResource TextBody}"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="2" FontSize="{StaticResource TextBody}"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center">
                                                            <Run Text="{Binding WidthText, Mode=OneWay}"/><Run Text="×"/><Run Text="{Binding HeightText, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBox Grid.Column="3" Text="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource OptIntInput}" Width="48" HorizontalAlignment="Left" Margin="0,0,4,0"
                                                                 ToolTip="Edit the quantity — the cut plan and run update automatically"/>
                                                        <Button Grid.Column="4" Content="Remove" Style="{StaticResource OptGhostButton}"
                                                                HorizontalAlignment="Right"
                                                                Command="{Binding DataContext.RemovePieceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ── TAB 1 · SIZES ────────────────────────────────── -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Border Style="{StaticResource OptPanelCard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- selector -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CUTTING GROUP" Style="{StaticResource OptPanelTitle}"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ComboBox Grid.Column="1" MinWidth="300" ItemsSource="{Binding CuttingGroups}"
                                              SelectedItem="{Binding SelectedCuttingGroup}"
                                              Style="{StaticResource OptComboStyle}"
                                              ToolTip="Optimize one pane group at a time (outer / inner / …) against its own Step 4 sheet"/>
                                    <TextBlock Grid.Column="2" Text="{Binding PieceSummary}" FontSize="{StaticResource TextBody}"
                                               FontWeight="SemiBold" Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- merged groups -->
                                <TextBlock Text="MERGED GLASS GROUPS" Style="{StaticResource OptHeader}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding SizeGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource OptInnerCard}" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="110"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Composition}" FontSize="{StaticResource TextBody}"
                                                                   FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Thickness}" FontSize="{StaticResource TextCaption}"
                                                                   Foreground="{DynamicResource AccentBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="PIECES" Style="{StaticResource OptHeader}"/>
                                                        <TextBlock Text="{Binding PieceCount}" FontSize="{StaticResource TextBody}"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="SIZE ROWS" Style="{StaticResource OptHeader}"/>
                                                        <TextBlock Text="{Binding PieceCount}" FontSize="{StaticResource TextBody}"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3">
                                                        <TextBlock Text="AREA (M²)" Style="{StaticResource OptHeader}"/>
                                                        <TextBlock Text="{Binding AreaM2}" FontSize="{StaticResource TextBody}"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- cut plan -->
                                <StackPanel Margin="0,14,0,0" Visibility="{Binding HasCutPlan, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="CUT PLAN — PIECES AS THE SAW CUTS THEM" Style="{StaticResource OptHeader}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding CutPlanNote}" FontSize="{StaticResource TextCaption}"
                                               Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                                               Visibility="{Binding HasCutPlanNote, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="#" Style="{StaticResource OptHeader}"/>
                                        <TextBlock Grid.Column="1" Text="REF" Style="{StaticResource OptHeader}"/>
                                        <TextBlock Grid.Column="2" Text="GLASS COMPOSITION" Style="{StaticResource OptHeader}"/>
                                        <TextBlock Grid.Column="3" Text="SIZE (MM)" Style="{StaticResource OptHeader}"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding CutPlanRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="4,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="64"/>
                                                            <ColumnDefinition Width="180"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="140"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Number}" FontSize="{StaticResource TextBody}"
                                                                   Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Ref}" FontSize="{StaticResource TextBody}"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Composition}" FontSize="{StaticResource TextBody}"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Size}" FontSize="{StaticResource TextBody}"
                                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ── TAB 2 · STOCKS ───────────────────────────────── -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Border Style="{StaticResource OptPanelCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Stock pool for the run — import the Step 4 sheet sizes of the selected job, or add racks manually. Availability defaults to unlimited (99999999) so the run is usage-tracked, not capped."
                                       FontSize="{StaticResource TextBody}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,14"/>

                            <Grid Grid.Row="1" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="W (MM)" Style="{StaticResource OptHeader}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" Width="90" Text="{Binding NewStock.WidthText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource OptIntInput}" Margin="0,0,14,0"/>
                                <TextBlock Grid.Column="2" Text="H (MM)" Style="{StaticResource OptHeader}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="3" Width="90" Text="{Binding NewStock.HeightText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource OptIntInput}" Margin="0,0,14,0"/>
                                <TextBlock Grid.Column="4" Text="AVAILABLE" Style="{StaticResource OptHeader}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="5" Width="110" Text="{Binding NewStock.AvailableText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource OptIntInput}" HorizontalAlignment="Left" Margin="0,0,14,0"/>
                                <Button Grid.Column="5" Content="Add stock" Style="{StaticResource PrimaryPillButton}"
                                        Command="{Binding AddStockCommand}" HorizontalAlignment="Left" Margin="130,0,12,0"/>
                                <Button Grid.Column="5" Content="Import Step 4 sheets" Style="{StaticResource OutlinedPillButton}"
                                        Command="{Binding ImportStockFromStep4Command}" HorizontalAlignment="Left" Margin="236,0,0,0"
                                        ToolTip="Loads the Step 4 chosen stock sheets of the selected Job Order into the pool (deduped by size)"/>
                            </Grid>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Stocks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource OptInnerCard}" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="160"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="80"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center">
                                                        <Run Text="{Binding WidthText, Mode=OneWay}"/><Run Text="×"/><Run Text="{Binding HeightText, Mode=OneWay}"/><Run Text=" mm"/>
                                                    </TextBlock>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="AVAILABLE" Style="{StaticResource OptHeader}"/>
                                                        <TextBlock FontSize="{StaticResource TextBody}" Foreground="{DynamicResource SecondaryForegroundBrush}">
                                                            <Run Text="{Binding AvailableText, Mode=OneWay}"/><Run Text=" sheets"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="USED THIS RUN" Style="{StaticResource OptHeader}"/>
                                                        <TextBlock Text="{Binding UsedLabel}" FontSize="{StaticResource TextBody}"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   Visibility="{Binding HasUsed, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" Text="{Binding SourceLabel}" FontSize="{StaticResource TextCaption}"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                    <Button Grid.Column="4" Content="Remove" Style="{StaticResource OptGhostButton}"
                                                            Command="{Binding DataContext.RemoveStockCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ── TAB 3 · SETTINGS ─────────────────────────────── -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Border Style="{StaticResource OptPanelCard}">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="CUTTING SETTINGS" Style="{StaticResource OptPanelTitle}" Margin="0,0,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="GLASS THICKNESS (MM)" Style="{StaticResource OptHeader}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding ThicknessText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OptIntInput}" Margin="0,0,0,12"/>
                                    <TextBlock Text="LEFT MARGIN LM (MM)" Style="{StaticResource OptHeader}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding LeftMarginText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OptIntInput}" Margin="0,0,0,12"/>
                                    <TextBlock Text="RIGHT MARGIN RM (MM)" Style="{StaticResource OptHeader}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding RightMarginText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OptIntInput}" Margin="0,0,0,12"/>
                                    <TextBlock Text="TOP MARGIN TM (MM)" Style="{StaticResource OptHeader}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding TopMarginText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OptIntInput}" Margin="0,0,0,12"/>
                                    <TextBlock Text="BOTTOM MARGIN BM (MM)" Style="{StaticResource OptHeader}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding BottomMarginText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OptIntInput}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="KERF / BLADE (MM)" Style="{StaticResource OptHeader}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding KerfText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OptIntInput}" Margin="0,0,0,12"/>
                                    <TextBlock Text="MINIMUM BREAKOUT (MM)" Style="{StaticResource OptHeader}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding MinBreakoutText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OptIntInput}" Margin="0,0,0,12"/>

                                    <CheckBox IsChecked="{Binding RotationEnabled}" Margin="0,10,0,6"
                                              Foreground="{DynamicResource PrimaryForegroundBrush}">
                                        <TextBlock Text="Allow rotation (0° / 90° mix) — enabled by default for all pieces"
                                                   TextWrapping="Wrap" FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    </CheckBox>

                                    <TextBlock Text="OPTIMIZE EFFORT LEVEL" Style="{StaticResource OptHeader}" Margin="0,10,0,6"/>
                                    <ComboBox ItemsSource="{Binding EffortLevels}"
                                              SelectedItem="{Binding SelectedEffortLevel}"
                                              Style="{StaticResource OptComboStyle}" Width="96" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="Load house defaults" Style="{StaticResource OutlinedPillButton}"
                                        Command="{Binding LoadHouseDefaultsCommand}"/>
                            </StackPanel>

                            <TextBlock Text="House defaults (floor-confirmed): 6mm glass → LM/RM/TM/BM 15mm, minimum breakout 15mm, kerf 3mm (4mm from 10mm). Every value is editable per run."
                                       FontSize="{StaticResource TextCaption}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── TAB 4 · SUMMARY ──────────────────────────────── -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="4">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Border Style="{StaticResource OptPanelCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- headline stats -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SHEETS" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Text="{Binding ResultSheets}" FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="UTILIZATION" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Text="{Binding ResultUtilization}" FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="OFFCUT" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Text="{Binding ResultWaste}" FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                               Foreground="{DynamicResource WarningBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="UNPLACED" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Text="{Binding ResultUnplaced}" FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="VERIFICATION" Style="{StaticResource OptHeader}"/>
                                    <TextBlock Text="{Binding ResultOracle}" FontSize="{StaticResource TextCaption}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="PER-CUTTING-GROUP BREAKDOWN" Style="{StaticResource OptHeader}" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding GroupResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource OptInnerCard}" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="90"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding Composition}" FontSize="{StaticResource TextBody}"
                                                                       FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Note}" FontSize="{StaticResource TextCaption}"
                                                                       Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                                                                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="PIECES" Style="{StaticResource OptHeader}"/>
                                                            <TextBlock Text="{Binding PieceCount}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="SHEETS" Style="{StaticResource OptHeader}"/>
                                                            <TextBlock Text="{Binding Sheets}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3">
                                                            <TextBlock Text="UTILIZATION" Style="{StaticResource OptHeader}"/>
                                                            <TextBlock Text="{Binding Utilization}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource SuccessBrush}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="4">
                                                            <TextBlock Text="OFFCUT" Style="{StaticResource OptHeader}"/>
                                                            <TextBlock Text="{Binding Waste}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="5">
                                                            <TextBlock Text="UNPLACED" Style="{StaticResource OptHeader}"/>
                                                            <TextBlock Text="{Binding Unplaced}" FontSize="{StaticResource TextBody}"
                                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding ResultStage}" FontSize="{StaticResource TextCaption}"
                                               Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,8"/>

                                    <TextBlock Text="SHEETS" Style="{StaticResource OptHeader}" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="SHEET" Style="{StaticResource OptHeader}"/>
                                        <TextBlock Grid.Column="1" Text="GLASS" Style="{StaticResource OptHeader}"/>
                                        <TextBlock Grid.Column="2" Text="STOCK (MM)" Style="{StaticResource OptHeader}"/>
                                        <TextBlock Grid.Column="3" Text="PIECES" Style="{StaticResource OptHeader}"/>
                                        <TextBlock Grid.Column="4" Text="UTILIZATION" Style="{StaticResource OptHeader}"/>
                                        <TextBlock Grid.Column="5" Text="OFFCUT" Style="{StaticResource OptHeader}"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding SheetRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Cursor="Hand" HorizontalContentAlignment="Stretch"
                                                        Command="{Binding DataContext.SelectSheetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Index}"
                                                        ToolTip="Open this sheet in the 2D view">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Row" Padding="4,8" BorderThickness="0,0,0,1"
                                                                    BorderBrush="{DynamicResource DividerBrush}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="60"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="110"/>
                                                                        <ColumnDefinition Width="80"/>
                                                                        <ColumnDefinition Width="90"/>
                                                                        <ColumnDefinition Width="90"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding SheetNo}" FontSize="{StaticResource TextBody}"
                                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Composition}" FontSize="{StaticResource TextBody}"
                                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding StockLabel}" FontSize="{StaticResource TextBody}"
                                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding PieceCount}" FontSize="{StaticResource TextBody}"
                                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                                                    <TextBlock Grid.Column="4" Text="{Binding Utilization}" FontSize="{StaticResource TextBody}"
                                                                               Foreground="{DynamicResource SuccessBrush}"/>
                                                                    <TextBlock Grid.Column="5" Text="{Binding WasteLabel}" FontSize="{StaticResource TextBody}"
                                                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Unplaced pieces -->
                                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasUnplaced, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Border CornerRadius="10" Background="{DynamicResource TintAmberBrush}" Padding="12,8" Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextBody}"
                                                           Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Pieces the engine could not place on any stock" FontSize="{StaticResource TextBody}"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding UnplacedRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="{StaticResource TextBody}"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,3"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ── TAB 5 · 2D VIEW ──────────────────────────────── -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="5">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Border Style="{StaticResource OptPanelCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Navigator: prev/next + caption + zoom -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="&#xE76B;  Prev" Style="{StaticResource OutlinedPillButton}"
                                            Command="{Binding SelectPreviousSheetCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Next  &#xE76C;" Style="{StaticResource OutlinedPillButton}"
                                            Command="{Binding SelectNextSheetCommand}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding PreviewCaption}" FontSize="{StaticResource TextBody}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundBrush}"
                                           VerticalAlignment="Center" Margin="12,0"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="−" Style="{StaticResource OutlinedPillButton}" Width="34"
                                            Command="{Binding PreviewZoomOutCommand}" Margin="0,0,6,0" ToolTip="Zoom out"/>
                                    <Border CornerRadius="8" Background="{DynamicResource ModuleBackgroundBrush}" Padding="10,3"
                                            Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PreviewScaleLabel}" FontSize="{StaticResource TextCaption}"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    </Border>
                                    <Button Content="+" Style="{StaticResource OutlinedPillButton}" Width="34"
                                            Command="{Binding PreviewZoomInCommand}" Margin="0,0,6,0" ToolTip="Zoom in"/>
                                    <Button Content="100%" Style="{StaticResource OutlinedPillButton}"
                                            Command="{Binding PreviewZoomResetCommand}" ToolTip="Reset zoom"/>
                                </StackPanel>
                            </Grid>

                            <!-- Filmstrip -->
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding SheetRows}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SheetChipStyle}"
                                                    Command="{Binding DataContext.SelectSheetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Index}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Canvas -->
                            <Grid Grid.Row="2">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding HasPreview, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" Opacity="0.6"/>
                                    <TextBlock Text="No layout to preview yet" FontSize="{StaticResource TextSubhead}" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,12,0,4" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Text="Run Quick or Optimize, then pick a sheet from Summary — the canvas shows every piece, the margin zone, kerf gaps and rotation."
                                               FontSize="{StaticResource TextBody}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                </StackPanel>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Border CornerRadius="10" Background="{DynamicResource WindowBackgroundBrush}"
                                                BorderBrush="{DynamicResource GlassBorderGradientSoft}" BorderThickness="1"
                                                Padding="12,8" Margin="0,0,0,8" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding PreviewStockLabel}" FontSize="{StaticResource TextBody}"
                                                           FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,0,16,0"/>
                                                <TextBlock Text="{Binding PreviewUtilization}" FontSize="{StaticResource TextBody}"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,16,0"/>
                                                <TextBlock Text="{Binding PreviewPiecesCount}" FontSize="{StaticResource TextBody}"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,16,0"/>
                                                <TextBlock Text="{Binding MarginZoneLabel}" FontSize="{StaticResource TextCaption}"
                                                           Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="2"
                                                Background="{DynamicResource WindowBackgroundBrush}"
                                                HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Canvas Width="{Binding RenderWidth}" Height="{Binding RenderHeight}">
                                                <Rectangle Canvas.Left="{Binding UsableX}" Canvas.Top="{Binding UsableY}"
                                                           Width="{Binding UsableW}" Height="{Binding UsableH}"
                                                           Stroke="{DynamicResource AccentBrush}" StrokeThickness="1"
                                                           StrokeDashArray="4,3" Fill="Transparent" IsHitTestVisible="False"/>
                                                <ItemsControl ItemsSource="{Binding SheetRects}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="{Binding Width}" Height="{Binding Height}"
                                                                    BorderThickness="1" BorderBrush="{DynamicResource ModuleBackgroundBrush}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Rotated}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource MutedForegroundBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding Label}" FontSize="9"
                                                                           Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                                           Margin="3,2" TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Canvas>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border Width="14" Height="14" Background="{DynamicResource AccentBrush}" CornerRadius="3" Margin="0,0,8,0"/>
                                            <TextBlock Text="original orientation" FontSize="{StaticResource TextCaption}"
                                                       Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                            <Border Width="14" Height="14" Background="{DynamicResource MutedForegroundBrush}" CornerRadius="3" Margin="0,0,8,0"/>
                                            <TextBlock Text="rotated 90°" FontSize="{StaticResource TextCaption}"
                                                       Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
