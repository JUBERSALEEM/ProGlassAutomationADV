<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Optimization/OptimizationView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Optimization Engine — Full Light Studio Bento Redesign

     Shell: one indigo banner (four stats in the center, strategy before
     Run), capsule navigation, tab workspace, and in-flight progress.
     The old KPI strip is gone so the 2D sheet can use that height.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Optimization.OptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tabs="clr-namespace:ProGlassAutomation.Views.Optimization.Tabs"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Dashboard/Overview/IndigoStudioResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid Margin="16,12,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- One compact indigo band. Stats sit in the empty center.
                 Strategy is on the action row, before Run, so the 2D sheet
                 keeps the height the old KPI strip used. -->
            <Border Grid.Row="0" Style="{StaticResource OptHeroCard}" Padding="16,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Optimization" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource OptOnIndigo}" VerticalAlignment="Center"
                                       ToolTip="Industrial cutting plans that minimize waste — pieces in, sheets out, verified layouts."/>
                            <Border Background="{StaticResource OptOnIndigoChip}" CornerRadius="8" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Guillotine 2D" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource OptOnIndigo}"/>
                            </Border>
                        </StackPanel>

                        <UniformGrid Grid.Column="1" Columns="4" Margin="16,0,8,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                <TextBlock Text="&#xE821;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource OptOnIndigo}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <StackPanel>
                                    <TextBlock Text="CONFIRMED JOBS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource OptOnIndigoMuted}"/>
                                    <TextBlock Text="{Binding KpiJobs}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource OptOnIndigo}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource OptOnIndigo}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <StackPanel>
                                    <TextBlock Text="PIECES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource OptOnIndigoMuted}"/>
                                    <TextBlock Text="{Binding KpiPieces}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource OptOnIndigo}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource OptOnIndigo}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <StackPanel>
                                    <TextBlock Text="TOTAL GLASS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource OptOnIndigoMuted}"/>
                                    <TextBlock Text="{Binding KpiGlass}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource OptOnIndigo}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource OptOnIndigo}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <StackPanel>
                                    <TextBlock Text="CUTTING GROUPS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource OptOnIndigoMuted}"/>
                                    <TextBlock Text="{Binding KpiGroups}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource OptOnIndigo}"/>
                                </StackPanel>
                            </StackPanel>
                        </UniformGrid>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="220"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="STRATEGY" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource OptOnIndigoMuted}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding StageStrategies}"
                                  SelectedItem="{Binding SelectedStageStrategy}"
                                  Style="{StaticResource OptComboStyle}"
                                  HorizontalAlignment="Stretch"
                                  IsEnabled="{Binding CanRun}"
                                  ToolTip="{Binding SelectedStageStrategy}"
                                  AutomationProperties.Name="Optimize effort and strategy stage"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Button Content="Run Quick" Style="{StaticResource OptOutlinedButton}"
                                    Command="{Binding RunQuickCommand}" IsEnabled="{Binding CanRun}" Margin="0,0,8,0"
                                    ToolTip="One fast deterministic pass (guillotine shelves) — completes in seconds"/>
                            <Button Content="Run Optimize" Style="{StaticResource OptPrimaryButton}"
                                    Background="{StaticResource OptOnIndigo}" Foreground="{StaticResource OptIndigo}"
                                    BorderBrush="{StaticResource OptOnIndigo}"
                                    Command="{Binding RunOptimizeCommand}" IsEnabled="{Binding CanRun}" Margin="0,0,8,0"
                                    ToolTip="Runs the strategy selected to the left"/>
                            <Button Content="Cancel" Style="{StaticResource OptOutlinedButton}"
                                    Command="{Binding CancelRunCommand}" IsEnabled="{Binding CanCancel}"
                                    ToolTip="Stop the current run — engine checks for cancellation once per part"/>
                            <Button Content="Upgrade to Optimize" Style="{StaticResource OptPrimaryButton}"
                                    Background="{StaticResource OptOnIndigo}" Foreground="{StaticResource OptIndigo}"
                                    BorderBrush="{StaticResource OptOnIndigo}"
                                    Command="{Binding UpgradeToOptimizeCommand}" Margin="8,0,0,0"
                                    Visibility="{Binding CanUpgradeToOptimize, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTip="Re-run this cutting list through OPTIMIZE at the selected strategy"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{Binding RunStageLabel}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource OptOnIndigo}" Margin="0,6,0,0"
                                   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <ProgressBar Height="4" IsIndeterminate="True" Margin="0,4,0,0"
                                     Foreground="{StaticResource OptOnIndigo}"
                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding RunMessage}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource OptOnIndigo}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding HasRunMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding ResultEffortLabel}" FontSize="11"
                                   Foreground="{StaticResource OptOnIndigoMuted}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Visibility="{Binding HasResultEffort, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding UpgradeSummaryLabel}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource OptOnIndigo}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Visibility="{Binding HasUpgradeSummary, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ 2. STUDIO BENTO MODULE TAB RAIL ══ -->
            <Border Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8">
                <WrapPanel Orientation="Horizontal">
                    <RadioButton GroupName="OptTabs" Tag="&#xE821;" Content="JOBS"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=0}"
                                 Style="{StaticResource OptRailTab}"/>
                    <RadioButton GroupName="OptTabs" Tag="&#xE8A7;" Content="SIZES"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=1}"
                                 Style="{StaticResource OptRailTab}"/>
                    <RadioButton GroupName="OptTabs" Tag="&#xE70F;" Content="CUT LIST"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=7}"
                                 Style="{StaticResource OptRailTab}"/>
                    <RadioButton GroupName="OptTabs" Tag="&#xE7B8;" Content="STOCKS"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=2}"
                                 Style="{StaticResource OptRailTab}"/>
                    <RadioButton GroupName="OptTabs" Tag="&#xE713;" Content="SETTINGS"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=3}"
                                 Style="{StaticResource OptRailTab}"/>
                    <RadioButton GroupName="OptTabs" Tag="&#xE9D9;" Content="SUMMARY"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=4}"
                                 Style="{StaticResource OptRailTab}"/>
                    <RadioButton GroupName="OptTabs" Tag="&#xE80A;" Content="2D VIEW"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=5}"
                                 Style="{StaticResource OptRailTab}"/>
                    <RadioButton GroupName="OptTabs" Tag="&#xE9F9;" Content="REPORT"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=6}"
                                 Style="{StaticResource OptRailTab}" Margin="0"/>
                </WrapPanel>
            </Border>

            <!-- Workspace takes the height the KPI strip used to occupy. -->
            <Grid Grid.Row="2" IsEnabled="{Binding CanRun}">
                <tabs:JobsTabView/>
                <tabs:SizesTabView/>
                <tabs:CutListTabView/>
                <tabs:StocksTabView/>
                <tabs:SettingsTabView/>
                <tabs:SummaryTabView/>
                <tabs:TwoDViewTabView/>
                <tabs:ReportTabView/>
            </Grid>
        </Grid>

        <!-- ══ 5. IN-FLIGHT PROGRESS MODAL OVERLAY ══ -->
        <Grid Visibility="{Binding IsRunProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{DynamicResource LiquidOverlayBrush}"/>

            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="520"
                    Padding="28,26" CornerRadius="16"
                    Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.14"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Modal Header Icon Badge -->
                    <Border Width="50" Height="50" CornerRadius="12"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                            HorizontalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="OPTIMIZATION IN PROGRESS" Style="{StaticResource OptPanelTitle}"
                               HorizontalAlignment="Center" FontSize="17"/>

                    <TextBlock Text="{Binding RunArchitectureLabel}" TextWrapping="Wrap" MaxWidth="440"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,6,0,8" FontSize="12"/>

                    <TextBlock Text="{Binding RunStageLabel}" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,4,0,0"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"/>

                    <!-- Progress Bar -->
                    <ProgressBar Height="8" Minimum="0" Maximum="100" Margin="0,18,0,0"
                                 Value="{Binding RunProgressPercent, Mode=OneWay}"
                                 Foreground="{DynamicResource AccentBrush}"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding RunProgressDetail}" TextWrapping="Wrap"
                                   FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Top" Margin="12,0,0,0"
                                   Text="{Binding RunProgressPercent, StringFormat={}{0}%}"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding RunScaleLabel}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Visibility="{Binding HasRunScale, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Text="{Binding RunElapsedLabel, StringFormat=Elapsed {0}}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Grid>

                    <Button Content="Cancel Run" Style="{StaticResource OptOutlinedButton}"
                            Command="{Binding CancelRunCommand}" IsEnabled="{Binding CanCancel}"
                            HorizontalAlignment="Center" Margin="0,20,0,0" Padding="28,0"
                            ToolTip="Stops the run — engine checks for cancellation once per part"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
