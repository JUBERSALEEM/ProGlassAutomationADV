<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/Optimization/OptimizationView.xaml
     PROJECT: ProGlassAutomation
     MODULE: Optimization Engine — Full Light Studio Bento Redesign

     Shell: Bento Hero banner with run controls, Studio capsule navigation
     rail, 4-card KPI metric strip, tab host workspace, and in-flight
     progress modal. 100% Light Theme isolation, pure vector geometry.
═══════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.Optimization.OptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tabs="clr-namespace:ProGlassAutomation.Views.Optimization.Tabs"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Background="Transparent">
        <Grid Margin="16,12,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══ 1. BENTO HERO BANNER: Title, Diagnostics & Engine Controls ══ -->
            <Border Grid.Row="0" Style="{StaticResource OptPanelCard}" Margin="0,0,0,14" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Identity, Subtitle, and In-Flight Messages -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="8"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                    Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="OPTIMIZATION ENGINE" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}" VerticalAlignment="Center"/>

                            <Border Background="{DynamicResource AccentSoftBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="GUILLOTINE 2D" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Industrial cutting plans that minimize waste — pieces in, sheets out, verified layouts."
                                   FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="48,3,0,0"/>

                        <!-- Diagnostic and Upgrade Messages -->
                        <TextBlock Text="{Binding RunMessage}" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"
                                   TextWrapping="Wrap" Margin="48,4,0,0"
                                   Visibility="{Binding HasRunMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <TextBlock Text="{Binding ResultEffortLabel}" FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="48,3,0,0"
                                   Visibility="{Binding HasResultEffort, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <TextBlock Text="{Binding UpgradeSummaryLabel}" FontSize="11"
                                   FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"
                                   TextWrapping="Wrap" Margin="48,2,0,0"
                                   Visibility="{Binding HasUpgradeSummary, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- Right: In-Flight Stage Progress & Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding RunStageLabel}" FontSize="11"
                                       FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Right" Margin="0,0,0,4"/>
                            <ProgressBar Height="4" IsIndeterminate="True" Width="160"
                                         Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                        </StackPanel>

                        <Button Content="Run Quick" Style="{StaticResource OptOutlinedButton}"
                                Command="{Binding RunQuickCommand}" IsEnabled="{Binding CanRun}" Margin="0,0,8,0"
                                ToolTip="One fast deterministic pass (guillotine shelves) — completes in seconds"/>

                        <Button Content="Run Optimize" Style="{StaticResource OptPrimaryButton}"
                                Command="{Binding RunOptimizeCommand}" IsEnabled="{Binding CanRun}"
                                ToolTip="Multi-start search across effort levels 1–5 — maximizes plate yield"/>

                        <Button Content="Cancel" Style="{StaticResource OptOutlinedButton}"
                                Command="{Binding CancelRunCommand}" IsEnabled="{Binding CanCancel}"
                                Margin="8,0,0,0"
                                ToolTip="Stop the current run — engine checks for cancellation once per part"/>

                        <Button Content="Upgrade to Optimize" Style="{StaticResource OptPrimaryButton}"
                                Command="{Binding UpgradeToOptimizeCommand}" Margin="8,0,0,0"
                                Visibility="{Binding CanUpgradeToOptimize, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTip="Re-run this cutting list through OPTIMIZE at the configured effort level"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ 2. STUDIO BENTO MODULE TAB RAIL ══ -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="6" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="OptTabs" Tag="&#xE821;" Content="JOBS"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=0}"
                                 Style="{StaticResource OptRailTab}"/>
                    <RadioButton GroupName="OptTabs" Tag="&#xE8A7;" Content="SIZES"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=1}"
                                 Style="{StaticResource OptRailTab}"/>
                    <RadioButton GroupName="OptTabs" Tag="&#xE70F;" Content="CUT LIST"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=7}"
                                 Style="{StaticResource OptRailTab}"/>
                    <RadioButton GroupName="OptTabs" Tag="&#xE7B8;" Content="STOCKS"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=2}"
                                 Style="{StaticResource OptRailTab}"/>
                    <RadioButton GroupName="OptTabs" Tag="&#xE713;" Content="SETTINGS"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=3}"
                                 Style="{StaticResource OptRailTab}"/>
                    <RadioButton GroupName="OptTabs" Tag="&#xE9D9;" Content="SUMMARY"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=4}"
                                 Style="{StaticResource OptRailTab}"/>
                    <RadioButton GroupName="OptTabs" Tag="&#xE80A;" Content="2D VIEW"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=5}"
                                 Style="{StaticResource OptRailTab}"/>
                    <RadioButton GroupName="OptTabs" Tag="&#xE9F9;" Content="REPORT"
                                 IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=6}"
                                 Style="{StaticResource OptRailTab}" Margin="0"/>
                </StackPanel>
            </Border>

            <!-- ══ 3. STUDIO BENTO KPI METRIC QUAD ══ -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CARD 1: CONFIRMED JOBS -->
                <Border Grid.Column="0" Style="{StaticResource OptKpiCard}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource OptKpiBadge}" Background="{StaticResource OptInfoBg}">
                            <TextBlock Text="&#xE821;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{StaticResource OptInfoInk}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CONFIRMED JOBS" Style="{StaticResource OptHeader}"/>
                            <Viewbox MaxHeight="28" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding KpiJobs}" Style="{StaticResource OptKpiValue}" Margin="0,2,0,0"/>
                            </Viewbox>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD 2: PIECES -->
                <Border Grid.Column="1" Style="{StaticResource OptKpiCard}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource OptKpiBadge}" Background="{StaticResource OptSuccessBg}">
                            <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{StaticResource OptSuccessInk}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PIECES" Style="{StaticResource OptHeader}"/>
                            <Viewbox MaxHeight="28" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding KpiPieces}" Style="{StaticResource OptKpiValue}" Margin="0,2,0,0"/>
                            </Viewbox>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD 3: TOTAL GLASS -->
                <Border Grid.Column="2" Style="{StaticResource OptKpiCard}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource OptKpiBadge}" Background="{StaticResource OptWarningBg}">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{StaticResource OptWarningInk}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="TOTAL GLASS" Style="{StaticResource OptHeader}"/>
                            <Viewbox MaxHeight="28" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding KpiGlass}" Style="{StaticResource OptKpiValue}" Margin="0,2,0,0"/>
                            </Viewbox>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD 4: CUTTING GROUPS -->
                <Border Grid.Column="3" Style="{StaticResource OptKpiCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource OptKpiBadge}" Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CUTTING GROUPS" Style="{StaticResource OptHeader}"/>
                            <Viewbox MaxHeight="28" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding KpiGroups}" Style="{StaticResource OptKpiValue}" Margin="0,2,0,0"/>
                            </Viewbox>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══ 4. TAB HOST WORKSPACE ══ -->
            <Grid Grid.Row="3" IsEnabled="{Binding CanRun}">
                <tabs:JobsTabView/>
                <tabs:SizesTabView/>
                <tabs:CutListTabView/>
                <tabs:StocksTabView/>
                <tabs:SettingsTabView/>
                <tabs:SummaryTabView/>
                <tabs:TwoDViewTabView/>
                <tabs:ReportTabView/>
            </Grid>
        </Grid>

        <!-- ══ 5. IN-FLIGHT PROGRESS MODAL OVERLAY ══ -->
        <Grid Visibility="{Binding IsRunProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{DynamicResource LiquidOverlayBrush}"/>

            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="520"
                    Padding="28,26" CornerRadius="16"
                    Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.14"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Modal Header Icon Badge -->
                    <Border Width="50" Height="50" CornerRadius="12"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                            HorizontalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="OPTIMIZATION IN PROGRESS" Style="{StaticResource OptPanelTitle}"
                               HorizontalAlignment="Center" FontSize="17"/>

                    <TextBlock Text="{Binding RunArchitectureLabel}" TextWrapping="Wrap" MaxWidth="440"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,6,0,8" FontSize="12"/>

                    <TextBlock Text="{Binding RunStageLabel}" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,4,0,0"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"/>

                    <!-- Progress Bar -->
                    <ProgressBar Height="8" Minimum="0" Maximum="100" Margin="0,18,0,0"
                                 Value="{Binding RunProgressPercent, Mode=OneWay}"
                                 Foreground="{DynamicResource AccentBrush}"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding RunProgressDetail}" TextWrapping="Wrap"
                                   FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Top" Margin="12,0,0,0"
                                   Text="{Binding RunProgressPercent, StringFormat={}{0}%}"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding RunScaleLabel}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Visibility="{Binding HasRunScale, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Text="{Binding RunElapsedLabel, StringFormat=Elapsed {0}}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </Grid>

                    <Button Content="Cancel Run" Style="{StaticResource OptOutlinedButton}"
                            Command="{Binding CancelRunCommand}" IsEnabled="{Binding CanCancel}"
                            HorizontalAlignment="Center" Margin="0,20,0,0" Padding="28,0"
                            ToolTip="Stops the run — engine checks for cancellation once per part"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>