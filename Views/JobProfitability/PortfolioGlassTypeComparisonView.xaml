<!-- ═══════════════════════════════════════════════════════════════════════
     FILE: Views/JobProfitability/PortfolioGlassTypeComparisonView.xaml
     MODULE: Portfolio Glass Type Comparison (Job Profitability → Tab 4)
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.JobProfitability.PortfolioGlassTypeComparisonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1100"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="HeaderCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TableCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="GlassTypeCardStyle" TargetType="Border" BasedOn="{StaticResource SurfacePrimaryStyle}">
            <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════ HEADER ═══════ -->
        <Border Grid.Row="0" Margin="16,16,16,0" Padding="16"
                Background="{DynamicResource SurfacePrimaryBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="{DynamicResource Border.HairlineThickness}" CornerRadius="{DynamicResource Radius.Small}">
            <StackPanel>
                <TextBlock Text="Glass Type Comparison — All Confirmed Jobs"
                           FontSize="{StaticResource TextTitle}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Which glass types (DGU, SGU, LAM, DGU+LAM) are most profitable? Compare revenue, cost, profit and margin across all confirmed PIs."
                           FontSize="{StaticResource TextBody}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ═══════ SUMMARY KPIs ═══════ -->
        <Grid Grid.Row="1" Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}"
                    CornerRadius="{DynamicResource Radius.Small}" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="JOBS ANALYZED" FontSize="{StaticResource TextCaption}"
                               FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Text="{Binding TotalJobsAnalyzed}"
                               FontSize="{StaticResource TextTitleLarge}" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}"
                    CornerRadius="{DynamicResource Radius.Small}" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="TOTAL REVENUE" FontSize="{StaticResource TextCaption}"
                               FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Text="{Binding TotalRevenueDisplay}"
                               FontSize="{StaticResource TextTitleLarge}" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}"
                    CornerRadius="{DynamicResource Radius.Small}" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="TOTAL PROFIT" FontSize="{StaticResource TextCaption}"
                               FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Text="{Binding TotalProfitDisplay}"
                               FontSize="{StaticResource TextTitleLarge}" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}"
                    CornerRadius="{DynamicResource Radius.Small}" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="OVERALL MARGIN" FontSize="{StaticResource TextCaption}"
                               FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Text="{Binding OverallMarginDisplay}"
                               FontSize="{StaticResource TextTitleLarge}" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="8" Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}"
                    CornerRadius="{DynamicResource Radius.Small}" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="BEST PERFORMER" FontSize="{StaticResource TextCaption}"
                               FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Text="{Binding BestPerformingGlassType}"
                               FontSize="{StaticResource TextBodyLarge}" FontWeight="Bold"
                               Foreground="{DynamicResource SuccessBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════ DETAILED COMPARISON TABLE ═══════ -->
        <Border Grid.Row="2" Margin="16,12,16,0"
                Background="{DynamicResource SurfacePrimaryBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="{DynamicResource Border.HairlineThickness}" CornerRadius="{DynamicResource Radius.Small}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Table Header -->
                <Border Grid.Row="0" Background="{DynamicResource AccentBrush}"
                        CornerRadius="{DynamicResource Radius.Top.Medium}" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="GLASS TYPE" Style="{StaticResource HeaderCellStyle}"/>
                        <TextBlock Grid.Column="1" Text="JOBS" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="REVENUE" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="COST" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="PROFIT" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="5" Text="MARGIN %" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- Table Rows -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              behaviors:SmoothScrollBehavior.IsEnabled="True">
                    <ItemsControl ItemsSource="{Binding GlassTypeRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
                                        BorderThickness="{DynamicResource Border.BottomHairlineThickness}" Padding="16,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding GlassType}"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TableCellStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBestPerformer}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Column="1" Text="{Binding JobCount}"
                                                   Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right"/>

                                        <TextBlock Grid.Column="2" Text="{Binding TotalRevenueDisplay}"
                                                   Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right"/>

                                        <TextBlock Grid.Column="3" Text="{Binding TotalCostDisplay}"
                                                   Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                                        <TextBlock Grid.Column="4" Text="{Binding TotalProfitDisplay}"
                                                   HorizontalAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TableCellStyle}">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProfitable}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Column="5" Text="{Binding MarginDisplay}"
                                                   HorizontalAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TableCellStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProfitable}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsBestPerformer}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state: shown whenever there are no rows. The VM
                     explains the difference between "no confirmed jobs yet"
                     and "jobs exist but none could be classified from saved
                     Step 9 data" — it never pretends the table is empty when
                     Job Profitability Tab 1 has real rows. -->
                <Border Grid.Row="1" Padding="24,48"
                        Visibility="{Binding GlassTypeRows.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextDisplay}"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding EmptyStateTitle}"
                                   FontSize="{StaticResource TextSection}" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding EmptyStateMessage}"
                                   FontSize="{StaticResource TextBody}" HorizontalAlignment="Center"
                                   Margin="0,4,0,0" Foreground="{DynamicResource TextTertiaryBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════ STATUS LINE ═══════ -->
        <Border Grid.Row="3" Margin="16,12,16,16" Padding="4,0">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="{StaticResource TextBody}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextTertiaryBrush}"/>
        </Border>

        <!-- ═══════ LOADING OVERLAY ═══════ -->
        <Border Grid.RowSpan="4"
                Background="{DynamicResource SurfaceOverlayBrush}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="{DynamicResource SurfacePrimaryBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="{DynamicResource Border.HairlineThickness}" CornerRadius="{DynamicResource Radius.Large}"
                        Padding="28,16">
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar IsIndeterminate="True" Width="20" Height="20"
                                     VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="Analyzing..."
                                   FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
