<!-- ═══════════════════════════════════════════════════════════════════════
     FILE: Views/JobProfitability/JobDetailPanel.xaml
     MODULE: Job Profitability — Detail Sidebar (drill-down per PI)
     
     Pattern: Same visual quality as StorageDetailsPanel.
     Shows when user clicks a row in the P&L Summary table.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.JobProfitability.JobDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="400"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="DetailSectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
        <Style x:Key="DetailKpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
        </Style>
        <Style x:Key="DetailKpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="DetailDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="Margin" Value="0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,8,8,16">
        <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="3"
                                  Opacity="0.18" Color="#000000" Direction="270"/>
            </Border.Effect>
            <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                    Background="{DynamicResource ShellLiquidBrush}"
                    BorderBrush="{DynamicResource ShellLiquidBorderBrush}"
                    BorderThickness="1"
                    ClipToBounds="True">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ═══ HEADER ═══ -->
                    <Border Grid.Row="0" Background="{DynamicResource AccentBrush}"
                            CornerRadius="16,16,0,0"
                            Padding="18,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="&#xE9D9;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource TextTitle}"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ProformaId}"
                                           FontSize="{StaticResource TextSection}" FontWeight="Bold"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                <TextBlock Text="{Binding CustomerName}"
                                           FontSize="{StaticResource TextCaption}"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}"
                                           Opacity="0.85" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Command="{Binding CloseCommand}"
                                    ToolTip="Close detail panel"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="8,4"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#xE711;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="{StaticResource TextSubhead}"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ═══ SCROLLABLE CONTENT ═══ -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  behaviors:SmoothScrollBehavior.IsEnabled="True"
                                  Padding="16,6,16,16">
                        <StackPanel>

                            <!-- ── JOB INFORMATION ── -->
                            <TextBlock Text="JOB INFORMATION" Style="{StaticResource DetailSectionLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Company" Style="{StaticResource DetailKpiLabel}" Margin="0,3"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CompanyName}" FontSize="{StaticResource TextBody}" Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="16,3" FontWeight="SemiBold"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Customer" Style="{StaticResource DetailKpiLabel}" Margin="0,3"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CustomerName}" FontSize="{StaticResource TextBody}" Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="16,3"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Project" Style="{StaticResource DetailKpiLabel}" Margin="0,3"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProjectName}" FontSize="{StaticResource TextBody}" Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="16,3"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Salesman" Style="{StaticResource DetailKpiLabel}" Margin="0,3"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Salesman}" FontSize="{StaticResource TextBody}" Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="16,3"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Issued" Style="{StaticResource DetailKpiLabel}" Margin="0,3"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding IssueDateDisplay}" FontSize="{StaticResource TextBody}" Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="16,3"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Glass Type" Style="{StaticResource DetailKpiLabel}" Margin="0,3"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding GlassTypeSummary}" FontSize="{StaticResource TextBody}" Foreground="{DynamicResource AccentBrush}" Margin="16,3" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <Border Style="{StaticResource DetailDivider}"/>

                            <!-- ── REVENUE BREAKDOWN ── -->
                            <TextBlock Text="REVENUE BREAKDOWN" Style="{StaticResource DetailSectionLabel}"/>
                            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                                    BorderBrush="{DynamicResource OutlineBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Gross (incl. VAT)" Style="{StaticResource DetailKpiLabel}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GrossRevenueDisplay}" Style="{StaticResource DetailKpiValue}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Less: VAT (5%)" Style="{StaticResource DetailKpiLabel}" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VatAmountDisplay}" Style="{StaticResource DetailKpiValue}" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,4,0,0"/>

                                    <Border Grid.Row="2" Grid.ColumnSpan="2" Height="1" Background="{DynamicResource OutlineBrush}" Margin="0,8"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="NET REVENUE (ex-VAT)" FontWeight="Bold" FontSize="{StaticResource TextCaption}" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding NetRevenueDisplay}" FontSize="{StaticResource TextBody}" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                </Grid>
                            </Border>

                            <!-- ── COST BREAKDOWN ── -->
                            <TextBlock Text="COST BREAKDOWN" Style="{StaticResource DetailSectionLabel}"/>
                            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                                    BorderBrush="{DynamicResource OutlineBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Glass Cost (sheets)" Style="{StaticResource DetailKpiLabel}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalGlassCostDisplay}" Style="{StaticResource DetailKpiValue}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Production Cost (ASP, cutting, tempering)" Style="{StaticResource DetailKpiLabel}" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalProductionCostDisplay}" Style="{StaticResource DetailKpiValue}" Margin="0,4,0,0"/>

                                    <Border Grid.Row="2" Grid.ColumnSpan="2" Height="1" Background="{DynamicResource OutlineBrush}" Margin="0,8"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="TOTAL COST" FontWeight="Bold" FontSize="{StaticResource TextCaption}" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalCostDisplay}" FontSize="{StaticResource TextBody}" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                </Grid>
                            </Border>

                            <!-- ── PROFIT / LOSS ── -->
                            <Border Margin="0,14,0,0" Padding="14,12" CornerRadius="12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoss}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ProfitLabel}"
                                               FontSize="{StaticResource TextSection}" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ProfitDisplay}"
                                               FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoss}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{Binding MarginDisplay}"
                                               FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoss}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource DetailDivider}"/>

                            <!-- ── P&L LINE ITEMS ── -->
                            <TextBlock Style="{StaticResource DetailSectionLabel}">
                                <Run Text="P&amp;L LINE ITEMS ("/><Run Text="{Binding LineItemCount, Mode=OneWay}"/><Run Text=")"/>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding LineItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource OutlineBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,8">
                                            <StackPanel>
                                                <!-- Row 1: Icon + Description + Amount -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Icon -->
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding KindIcon}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"/>

                                                    <!-- Description -->
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Description}"
                                                               FontSize="{StaticResource TextBody}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               Margin="6,0,0,0"/>

                                                    <!-- Amount -->
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding AmountDisplay}"
                                                               FontSize="{StaticResource TextBody}"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- Row 2: Calculation formula -->
                                                <TextBlock Text="{Binding CalculationNote}"
                                                           FontSize="{StaticResource TextCaption}"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                           Margin="30,2,0,0"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- Row 3: Quantity + Area + Unit Price details -->
                                                <StackPanel Orientation="Horizontal" Margin="30,3,0,0">
                                                    <TextBlock Text="{Binding QuantityDisplay}"
                                                               FontSize="{StaticResource TextCaption}"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                    <TextBlock Text=" · "
                                                               FontSize="{StaticResource TextCaption}"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                                               Margin="2,0"/>
                                                    <TextBlock Text="{Binding TotalAreaDisplay}"
                                                               FontSize="{StaticResource TextCaption}"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                    <TextBlock Text=" · "
                                                               FontSize="{StaticResource TextCaption}"
                                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                                               Margin="2,0"/>
                                                    <TextBlock Text="{Binding UnitPriceDisplay}"
                                                               FontSize="{StaticResource TextCaption}"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ── STATUS ── -->
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="{StaticResource TextCaption}"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="0,12,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
