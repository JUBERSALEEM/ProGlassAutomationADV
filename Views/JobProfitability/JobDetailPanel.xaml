<!-- ═══════════════════════════════════════════════════════════════════════
     FILE: Views/JobProfitability/JobDetailPanel.xaml
     MODULE: Job Profitability — Detail Sidebar (drill-down per PI)
     
     Pattern: Same visual quality as StorageDetailsPanel.
     Shows when user clicks a row in the P&L Summary table.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl Style="{StaticResource ErpPageRootStyle}" x:Class="ProGlassAutomation.Views.JobProfitability.JobDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="400"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

        <UserControl.Resources>
        <!-- Migrated DetailSectionLabel to global Typography.Label -->
    </UserControl.Resources>


    <Grid Margin="0,8,8,16">
        <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="3"
                                  Opacity="0.18" Color="{DynamicResource LiquidShadowColor}" Direction="270"/>
            </Border.Effect>
            <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                    Background="{DynamicResource ShellLiquidBrush}"
                    BorderBrush="{DynamicResource ShellLiquidBorderBrush}"
                    BorderThickness="{DynamicResource Border.HairlineThickness}"
                    ClipToBounds="True">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ═══ HEADER ═══ -->
                    <Border Grid.Row="0" Background="{DynamicResource AccentBrush}"
                            CornerRadius="{DynamicResource Radius.Top.Medium}"
                            Padding="18,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="&#xE9D9;"
                                       FontFamily="{DynamicResource FontFamily.Icon}"
                                       FontSize="{DynamicResource FontSize.H2}"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ProformaId}"
                                           FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                <TextBlock Text="{Binding CustomerName}"
                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}"
                                           Opacity="0.85" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Command="{Binding CloseCommand}"
                                    ToolTip="Close detail panel"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    BorderThickness="{DynamicResource Border.NoneThickness}"
                                    Padding="8,4"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#xE711;"
                                           FontFamily="{DynamicResource FontFamily.Icon}"
                                           FontSize="{DynamicResource FontSize.H3}"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ═══ SCROLLABLE CONTENT ═══ -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  behaviors:SmoothScrollBehavior.IsEnabled="True"
                                  Padding="16,6,16,16">
                        <StackPanel>

                            <!-- ── JOB INFORMATION ── -->
                            <TextBlock Text="JOB INFORMATION"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Company" Margin="0,3"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CompanyName}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="16,3" FontWeight="{DynamicResource Weight.SemiBold}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Customer" Margin="0,3"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CustomerName}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="16,3"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Project" Margin="0,3"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProjectName}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="16,3"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Salesman" Margin="0,3"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Salesman}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="16,3"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Issued" Margin="0,3"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding IssueDateDisplay}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="16,3"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Glass Type" Margin="0,3"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding GlassTypeSummary}" FontSize="{DynamicResource FontSize.Body}" Foreground="{DynamicResource AccentBrush}" Margin="16,3" FontWeight="{DynamicResource Weight.SemiBold}" TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <Border/>

                            <!-- ── TARGET PRICE MODEL (approved KPI) ── -->
                            <TextBlock Text="TARGET PRICE MODEL"/>

                            <!-- Status pill -->
                            <Border HorizontalAlignment="Left" CornerRadius="{DynamicResource Radius.Medium}" Padding="10,4" Margin="0,0,0,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAboveTarget}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsBelowTarget}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsTargetStale}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsTargetIncomplete}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding TargetStatusLabel}"
                                           FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAboveTarget}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsBelowTarget}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsTargetStale}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <!-- Target KPI summary (only when target data exists) -->
                            <Border Visibility="{Binding TargetPanelVisibility}"
                                    Background="{DynamicResource SurfacePrimaryBrush}"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    BorderThickness="{DynamicResource Border.HairlineThickness}" CornerRadius="{DynamicResource Radius.Medium}" Padding="14,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Given price (Step 5)"/>
                                        <TextBlock Grid.Column="1" Text="{Binding GivenPricePerSqmDisplay}"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Specification target ×1.15"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SpecificationTargetPerSqmDisplay}"
                                                   FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="U-insert applied to target"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AppliedUInsertPerSqmDisplay}"
                                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Required target (final)"/>
                                        <TextBlock Grid.Column="1" Text="{Binding RequiredTargetPerSqmDisplay}"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="U-insert treatment"/>
                                        <TextBlock Grid.Column="1" Text="{Binding UInsertTreatmentSummary}"
                                                   FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Right"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="180"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Difference"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DifferencePerSqmDisplay}"
                                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource BorderDefaultBrush}" Margin="0,6,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="MARGIN AGAINST TARGET"
                                                   FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TargetMarginDisplay}"
                                                   FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBelowTarget}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsTargetIncomplete}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsTargetStale}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Explanatory note when target data is missing -->
                            <TextBlock Text="{Binding TargetStatusMessage}"
                                       Visibility="{Binding HasTargetData, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,6"/>

                            <!-- Per-spec rows -->
                            <ItemsControl ItemsSource="{Binding TargetSpecs}" Visibility="{Binding TargetPanelVisibility}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                BorderThickness="{DynamicResource Border.BottomHairlineThickness}"
                                                Padding="0,8"
                                                Margin="0,4,0,0">
                                            <StackPanel>
                                                <!-- Spec identity + status pill -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="{DynamicResource Radius.Medium}"
                                                            Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SpecNumber}"
                                                                   FontSize="{DynamicResource FontSize.Caption}" FontWeight="{DynamicResource Weight.Bold}"
                                                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding SpecName}"
                                                               FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="8,0,8,0" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="2" CornerRadius="{DynamicResource Radius.Small}" Padding="8,2"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAboveTarget}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsBelowTarget}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsIncomplete}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding StatusLabel}"
                                                                   FontSize="{DynamicResource FontSize.Caption}" FontWeight="{DynamicResource Weight.Bold}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAboveTarget}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsBelowTarget}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>

                                                <!-- Numeric rows -->
                                                <Grid Margin="8,0,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Given price (Step 5 Base Price)" Style="{StaticResource Field.Label}"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GivenPricePerSqmDisplay}"
                                                               Style="{StaticResource Typography.Body}" Margin="8,0,0,0"/>

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Specification target ×1.15" Style="{StaticResource Field.Label}" Margin="0,2,0,0"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SpecificationTargetPerSqmDisplay}"
                                                               FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Right" Margin="8,2,0,0"/>

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="U-insert rate" Style="{StaticResource Field.Label}" Margin="0,2,0,0"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AppliedUInsertPerSqmDisplay}"
                                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Right" Margin="8,2,0,0"/>

                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="FINAL REQUIRED TARGET"
                                                               FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FinalRequiredTargetPerSqmDisplay}"
                                                               FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               HorizontalAlignment="Right" Margin="8,4,0,0"/>
                                                </Grid>

                                                <StackPanel Orientation="Horizontal" Margin="8,4,0,0">
                                                    <TextBlock Text="{Binding DifferencePerSqmDisplay}"
                                                               FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text=" · " FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="2,0"/>
                                                    <TextBlock Text="{Binding MarginDisplay}"
                                                               FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text=" · " FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="2,0"/>
                                                    <TextBlock Text="{Binding UInsertNote}"
                                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border/>

                            <!-- ── REVENUE BREAKDOWN ── -->
                            <TextBlock Text="REVENUE BREAKDOWN"/>
                            <Border Background="{DynamicResource SurfacePrimaryBrush}"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    BorderThickness="{DynamicResource Border.HairlineThickness}" CornerRadius="{DynamicResource Radius.Medium}" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Gross (incl. VAT)"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GrossRevenueDisplay}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Less: VAT (5%)" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VatAmountDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>

                                    <Border Grid.Row="2" Grid.ColumnSpan="2" Height="1" Background="{DynamicResource BorderDefaultBrush}" Margin="0,8"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="NET REVENUE (ex-VAT)" FontWeight="{DynamicResource Weight.Bold}" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding NetRevenueDisplay}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                            </Border>

                            <!-- ── COST BREAKDOWN ── -->
                            <TextBlock Text="COST BREAKDOWN"/>
                            <Border Background="{DynamicResource SurfacePrimaryBrush}"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    BorderThickness="{DynamicResource Border.HairlineThickness}" CornerRadius="{DynamicResource Radius.Medium}" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Glass Cost (sheets)"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalGlassCostDisplay}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Production Cost (ASP, cutting, tempering)" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalProductionCostDisplay}" Margin="0,4,0,0"/>

                                    <Border Grid.Row="2" Grid.ColumnSpan="2" Height="1" Background="{DynamicResource BorderDefaultBrush}" Margin="0,8"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="TOTAL COST" FontWeight="{DynamicResource Weight.Bold}" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalCostDisplay}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                            </Border>

                            <!-- ── PROFIT / LOSS ── -->
                            <Border Margin="0,14,0,0" Padding="14,12" CornerRadius="{DynamicResource Radius.Large}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoss}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ProfitLabel}"
                                               FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ProfitDisplay}"
                                               FontSize="{DynamicResource FontSize.H2}" FontWeight="{DynamicResource Weight.Bold}"
                                               VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoss}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{Binding MarginDisplay}"
                                               FontSize="{DynamicResource FontSize.H2}" FontWeight="{DynamicResource Weight.Bold}"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoss}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- ── 3 MARGINS ── -->
                            <TextBlock Text="MARGIN ANALYSIS"/>
                            <Border Background="{DynamicResource SurfacePrimaryBrush}"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    BorderThickness="{DynamicResource Border.HairlineThickness}" CornerRadius="{DynamicResource Radius.Medium}" Padding="14,10">
                                <StackPanel>
                                    <!-- Cost-Based (without U-insert) -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Cost-Based (no U-insert)" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="(Revenue − Base Cost) ÷ Base Cost" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding MarginDisplay}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource BorderDefaultBrush}" Margin="0,2,0,6"/>

                                    <!-- Overall (with U-insert) — MOST IMPORTANT -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource AccentBrush}">
                                                <Run Text="&#x2B50; Overall (with U-insert)"/>
                                            </TextBlock>
                                            <TextBlock Text="(Revenue − Total Cost) ÷ Total Cost" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding OverallMarginDisplay}" FontSize="{DynamicResource FontSize.H2}" FontWeight="{DynamicResource Weight.Bold}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLoss}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource BorderDefaultBrush}" Margin="0,2,0,6"/>

                                    <!-- Net (accounting) -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Net (accounting)" FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.SemiBold}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="(Revenue − Total Cost) ÷ Revenue" FontSize="{DynamicResource FontSize.BodySmall}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding NetMarginDisplay}" FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource DetailDivider}"/>

                            <!-- ── P&L LINE ITEMS ── -->
                            <TextBlock Style="{StaticResource Field.Label}">
                                <Run Text="P&amp;L LINE ITEMS ("/><Run Text="{Binding LineItemCount, Mode=OneWay}"/><Run Text=")"/>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding LineItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                BorderThickness="{DynamicResource Border.BottomHairlineThickness}"
                                                Padding="0,8">
                                            <StackPanel>
                                                <!-- Row 1: Icon + Description + Amount -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Icon -->
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding KindIcon}"
                                                               FontFamily="{DynamicResource FontFamily.Icon}"
                                                               FontSize="{DynamicResource FontSize.Title}"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"/>

                                                    <!-- Description -->
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Description}"
                                                               FontSize="{DynamicResource FontSize.Body}"
                                                               FontWeight="{DynamicResource Weight.SemiBold}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               Margin="6,0,0,0"/>

                                                    <!-- Amount -->
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding AmountDisplay}"
                                                               FontSize="{DynamicResource FontSize.Body}"
                                                               FontWeight="{DynamicResource Weight.Bold}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- Row 2: Calculation formula -->
                                                <TextBlock Text="{Binding CalculationNote}"
                                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           Margin="30,2,0,0"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- Row 3: Quantity + Area + Unit Price details -->
                                                <StackPanel Orientation="Horizontal" Margin="30,3,0,0">
                                                    <TextBlock Text="{Binding QuantityDisplay}"
                                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text=" · "
                                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                               Margin="2,0"/>
                                                    <TextBlock Text="{Binding TotalAreaDisplay}"
                                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text=" · "
                                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                               Margin="2,0"/>
                                                    <TextBlock Text="{Binding UnitPriceDisplay}"
                                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ── STATUS ── -->
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="0,12,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
