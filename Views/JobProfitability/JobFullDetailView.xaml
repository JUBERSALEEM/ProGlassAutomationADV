<!-- ═══════════════════════════════════════════════════════════════════════
     FILE: Views/JobProfitability/JobFullDetailView.xaml
     MODULE: Job Profitability — FULL-SCREEN detail page (double-click)

     Opens when the operator DOUBLE-CLICKS a row in the CONFIRMED PIs table
     (a single click still opens the 420px sidebar). It renders the same
     JobDetailViewModel as the sidebar, laid out as a full module page —
     the same pattern the Step 9 Profit & Loss module uses for its
     full-screen spec report:

         • accent header (PI identity + status)
         • KPI strip (net revenue / total cost / profit / overall margin)
         • two-column sections (job info, target model, revenue, cost,
           margin analysis)
         • full-width P&L line-item table

     The BACK button lives on the parent view (JobProfitabilityView) so it
     can bind the host's CloseFullDetailCommand directly.
═══════════════════════════════════════════════════════════════════════ -->
<UserControl Style="{StaticResource ErpPageRootStyle}" x:Class="ProGlassAutomation.Views.JobProfitability.JobFullDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1280"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

        <UserControl.Resources>
        <!-- Migrated FullCardStyle to global SurfacePrimaryStyle -->
    </UserControl.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly"
                  behaviors:SmoothScrollBehavior.IsEnabled="True">
        <StackPanel Margin="20,0,20,24">

            <!-- ═══ ACCENT HEADER — PI identity + target status ═══ -->
            <Border Background="{DynamicResource AccentBrush}"
                    CornerRadius="{DynamicResource Radius.Top.Medium}" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding ProformaId}"
                                   FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                        <TextBlock FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0">
                            <Run Text="{Binding CustomerName, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding ProjectName, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock FontSize="{DynamicResource FontSize.BodySmall}"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   Opacity="0.85" TextWrapping="Wrap" Margin="0,2,0,0">
                            <Run Text="{Binding CompanyName, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding Salesman, Mode=OneWay}"/>
                            <Run Text=" · issued "/>
                            <Run Text="{Binding IssueDateDisplay, Mode=OneWay}"/>
                            <Run Text=" · glass "/>
                            <Run Text="{Binding GlassTypeSummary, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Target status pill -->
                    <Border Grid.Column="1" VerticalAlignment="Top"
                            HorizontalAlignment="Right" CornerRadius="{DynamicResource Radius.Medium}" Padding="12,5" Margin="12,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAboveTarget}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBelowTarget}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsTargetStale}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding TargetStatusLabel}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource FullBadgeText}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTargetIncomplete}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAboveTarget}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBelowTarget}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTargetStale}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ KPI STRIP — 4 cards ═══ -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0">
                    <StackPanel>
                        <TextBlock Text="NET REVENUE"/>
                        <Viewbox MaxHeight="30" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding NetRevenueDisplay}"/>
                        </Viewbox>
                        <TextBlock Text="ex-VAT · Step 9 snapshot"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2">
                    <StackPanel>
                        <TextBlock Text="TOTAL COST"/>
                        <Viewbox MaxHeight="30" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding TotalCostDisplay}"/>
                        </Viewbox>
                        <TextBlock Text="glass + production"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource FullCardStyle}">
                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoss}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding ProfitLabel}"/>
                        <Viewbox MaxHeight="30" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding ProfitDisplay}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FullKpiValue}">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoss}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Viewbox>
                        <TextBlock Text="revenue − total cost"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="6" Style="{StaticResource SurfacePrimaryStyle}">
                    <StackPanel>
                        <TextBlock Text="OVERALL MARGIN"/>
                        <Viewbox MaxHeight="30" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding OverallMarginDisplay}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FullKpiValue}">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoss}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Viewbox>
                        <TextBlock Text="with U-insert · (Revenue − Total Cost) ÷ Total Cost"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ TWO-COLUMN SECTIONS ═══ -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ═══ LEFT COLUMN ═══ -->
                <StackPanel Grid.Column="0">

                    <!-- 1 · JOB INFORMATION -->
                    <TextBlock Text="1 · JOB INFORMATION"/>
                    <Border Style="{StaticResource SurfacePrimaryStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Company"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CompanyName}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Customer"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CustomerName}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Project"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProjectName}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Salesman"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Salesman}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Issued"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding IssueDateDisplay}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Glass type"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding GlassTypeSummary}"
                                       Foreground="{DynamicResource AccentBrush}"
                                      />
                        </Grid>
                    </Border>

                    <!-- 2 · TARGET PRICE MODEL -->
                    <TextBlock Text="2 · TARGET PRICE MODEL" Margin="0,14,0,8"/>
                    <Border Style="{StaticResource SurfacePrimaryStyle}"
                            Visibility="{Binding TargetPanelVisibility}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Given price (Step 5)"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GivenPricePerSqmDisplay}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Spec target ×1.15"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SpecificationTargetPerSqmDisplay}"
                                           FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.SemiBold}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Right" Margin="10,3,0,3"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="U-insert (target)"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AppliedUInsertPerSqmDisplay}"
                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Right" Margin="10,3,0,3"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Required target"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RequiredTargetPerSqmDisplay}"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Given value"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding GivenValueDisplay}"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Required value"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding RequiredTargetValueDisplay}"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Difference"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding DifferenceValueDisplay}"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource BorderDefaultBrush}" Margin="0,10,0,8"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="MARGIN AGAINST TARGET"
                                           FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding TargetMarginDisplay}"
                                           FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBelowTarget}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsTargetIncomplete}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsTargetStale}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <TextBlock Text="{Binding UInsertTreatmentSummary}"
                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>

                            <!-- Per-spec rows -->
                            <ItemsControl ItemsSource="{Binding TargetSpecs}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                BorderThickness="{DynamicResource Border.BottomHairlineThickness}" Padding="0,8">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="{DynamicResource Radius.Medium}"
                                                            Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SpecNumber}" FontSize="{DynamicResource FontSize.Caption}" FontWeight="{DynamicResource Weight.Bold}"
                                                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding SpecName}"
                                                               FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" Margin="8,0,8,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding StatusLabel}"
                                                               FontSize="{DynamicResource FontSize.Caption}" FontWeight="{DynamicResource Weight.Bold}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAboveTarget}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsBelowTarget}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>

                                                <Grid Margin="30,0,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Given" Style="{StaticResource FullKvLabel}"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GivenPricePerSqmDisplay}"
                                                              />

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Final required target"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FinalRequiredTargetPerSqmDisplay}"
                                                              />

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Difference · margin"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="1">
                                                        <Run Text="{Binding DifferencePerSqmDisplay, Mode=OneWay}"/><Run Text=" · "/>
                                                        <Run Text="{Binding MarginDisplay, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Grid>

                                                <TextBlock Text="{Binding UInsertNote}"
                                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           TextWrapping="Wrap" Margin="30,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Target note when data missing -->
                    <TextBlock Text="{Binding TargetStatusMessage}"
                               Visibility="{Binding HasTargetData, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                               FontSize="{DynamicResource FontSize.BodySmall}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- ═══ RIGHT COLUMN ═══ -->
                <StackPanel Grid.Column="2">

                    <!-- 3 · REVENUE BREAKDOWN -->
                    <TextBlock Text="3 · REVENUE BREAKDOWN"/>
                    <Border Style="{StaticResource SurfacePrimaryStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Gross (incl. VAT)"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GrossRevenueDisplay}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Less: VAT (5%)"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VatAmountDisplay}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                      />

                            <Border Grid.Row="2" Grid.ColumnSpan="2" Height="1"
                                    Background="{DynamicResource BorderDefaultBrush}" Margin="0,8"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="NET REVENUE (ex-VAT)"
                                       FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding NetRevenueDisplay}"
                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Right" Margin="10,3,0,3"/>
                        </Grid>
                    </Border>

                    <!-- 4 · COST BREAKDOWN -->
                    <TextBlock Text="4 · COST BREAKDOWN" Margin="0,14,0,8"/>
                    <Border Style="{StaticResource SurfacePrimaryStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Glass cost (sheets)"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalGlassCostDisplay}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Production cost"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalProductionCostDisplay}"/>

                            <Border Grid.Row="2" Grid.ColumnSpan="2" Height="1"
                                    Background="{DynamicResource BorderDefaultBrush}" Margin="0,8"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="TOTAL COST"
                                       FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalCostDisplay}"
                                       FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Right" Margin="10,3,0,3"/>
                        </Grid>
                    </Border>

                    <!-- 5 · MARGIN ANALYSIS -->
                    <TextBlock Text="5 · MARGIN ANALYSIS" Margin="0,14,0,8"/>
                    <Border Style="{StaticResource SurfacePrimaryStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Cost-Based (no U-insert)"
                                               FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.SemiBold}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="(Revenue − Base Cost) ÷ Base Cost"
                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding MarginDisplay}"
                                           FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource BorderDefaultBrush}" Margin="0,8"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource AccentBrush}">
                                        <Run Text="&#x2B50; Overall (with U-insert)"/>
                                    </TextBlock>
                                    <TextBlock Text="(Revenue − Total Cost) ÷ Total Cost"
                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding OverallMarginDisplay}"
                                           FontSize="{DynamicResource FontSize.H2}" FontWeight="{DynamicResource Weight.Bold}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoss}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource BorderDefaultBrush}" Margin="0,8"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Net (accounting)"
                                               FontSize="{DynamicResource FontSize.BodySmall}" FontWeight="{DynamicResource Weight.SemiBold}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="(Revenue − Total Cost) ÷ Revenue"
                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding NetMarginDisplay}"
                                           FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.Bold}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ═══ 6 · P&L LINE ITEMS (full width) ═══ -->
            <TextBlock Style="{StaticResource FullSectionLabel}" Margin="0,14,0,8">
                <Run Text="6 · P&amp;L LINE ITEMS ("/><Run Text="{Binding LineItemCount, Mode=OneWay}"/><Run Text=")"/>
            </TextBlock>
            <Border Style="{StaticResource SurfacePrimaryStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="{DynamicResource AccentBrush}"
                            CornerRadius="{DynamicResource Radius.Top.Medium}" Padding="14,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.6*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="1.0*"/>
                                <ColumnDefinition Width="1.0*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="DESCRIPTION" Style="{StaticResource FullHeaderCell}"/>
                            <TextBlock Grid.Column="1" Text="QTY" Style="{StaticResource FullHeaderCell}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="AREA" Style="{StaticResource FullHeaderCell}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="UNIT PRICE" Style="{StaticResource FullHeaderCell}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="AMOUNT" Style="{StaticResource FullHeaderCell}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Rows -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding LineItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
                                        BorderThickness="{DynamicResource Border.BottomHairlineThickness}" Padding="14,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.6*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="1.0*"/>
                                            <ColumnDefinition Width="1.0*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding KindIcon}"
                                                       FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.Title}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Margin="6,0,0,0">
                                                <TextBlock Text="{Binding Description}"
                                                           Style="{StaticResource FullCell}" FontWeight="{DynamicResource Weight.SemiBold}"/>
                                                <TextBlock Text="{Binding CalculationNote}"
                                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding QuantityDisplay}"
                                                   Style="{StaticResource FullCell}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TotalAreaDisplay}"
                                                   Style="{StaticResource FullCell}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="3" Text="{Binding UnitPriceDisplay}"
                                                   Style="{StaticResource FullCell}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="4" Text="{Binding AmountDisplay}"
                                                   Style="{StaticResource FullCell}" FontWeight="{DynamicResource Weight.Bold}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Status -->
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="{DynamicResource FontSize.BodySmall}"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
