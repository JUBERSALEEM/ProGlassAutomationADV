<UserControl x:Class="ProGlassAutomation.Views.JobProfitability.JobProfitabilityView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:local="clr-namespace:ProGlassAutomation.Views.JobProfitability"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1280"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <Style x:Key="JpLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <Style x:Key="JpInputStyle" TargetType="TextBox">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="Background"               Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground"               Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
            <Setter Property="Padding"                  Value="8,0"/>
            <Setter Property="Height"                   Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush"               Value="{DynamicResource PrimaryForegroundBrush}"/>
        </Style>

        <Style x:Key="JpComboStyle" TargetType="ComboBox">
            <Setter Property="Background"               Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground"               Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="Padding"                  Value="8,0"/>
            <Setter Property="Height"                   Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Small compact button used in the filter bar -->
        <Style x:Key="JpCompactButton" TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>

        <Style x:Key="JpTileStyle" TargetType="Border" BasedOn="{StaticResource KpiTileHoverStyle}">
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <Style x:Key="JpTileCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <Style x:Key="JpTileValueStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        </Style>

        <Style x:Key="JpFootnoteStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <Style x:Key="JpSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextTitle}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Margin" Value="2,0,0,2"/>
        </Style>

        <Style x:Key="JpSectionHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>

        <!-- Table header cell -->
        <Style x:Key="JpHeaderCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Table data cell -->
        <Style x:Key="JpCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Small value/count chip in the strip under the KPI cards -->
        <Style x:Key="JpChipStyle" TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <!-- Target status pill -->
        <Style x:Key="JpStatusPill" TargetType="Border" BasedOn="{StaticResource SurfaceDetailStyle}">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
        </Style>

    </UserControl.Resources>

    <!-- Root surface: switches between the two-column layout (list +
         sidebar) and the full-screen detail page opened on double-click.
         The full page mirrors the Step 9 Profit & Loss module's
         full-screen spec report. -->
    <Grid Background="{DynamicResource ModuleBackgroundBrush}">

        <!-- ═══ LAYER 1 — two-column layout: main content + detail sidebar
             (hidden while the full-screen detail page is open) ═══ -->
        <Grid Visibility="{Binding HasFullDetail, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

        <!-- ═══ LEFT: Main Content ═══ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══════════ HEADER + FILTERS — SINGLE ROW ══════════
                 Search (flexible, small), Company, Customer, Salesman,
                 Date range and Refresh all on ONE row with compact widths
                 so they fit without wrapping. -->
            <Border Grid.Row="0"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Margin="20,14,20,0"
                    Padding="18,12,18,12">
                <StackPanel>

                    <!-- Title row -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource TintIndigoBrush}"
                                Width="24" Height="24"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                            <TextBlock Text="&#xE9D9;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource TextBodyLarge}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Title}"
                                   FontSize="{StaticResource TextTitle}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Subtitle}"
                                   FontSize="{StaticResource TextCaption}"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="12,0,10,0"/>
                    </Grid>

                    <!-- ONE filter row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="120"/>
<ColumnDefinition Width="8"/>
<ColumnDefinition Width="130"/>
<ColumnDefinition Width="8"/>
<ColumnDefinition Width="150"/>
<ColumnDefinition Width="8"/>
<ColumnDefinition Width="120"/>
<ColumnDefinition Width="8"/>
<ColumnDefinition Width="130"/>
<ColumnDefinition Width="8"/>
<ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource JobProfitability.SearchProformaCustomerProject}"
                                       Style="{StaticResource JpLabelStyle}"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                     Style="{StaticResource JpInputStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Common.Company}" Style="{StaticResource JpLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding CompanyFilterOptions}"
                                      SelectedItem="{Binding CompanyFilter}"
                                      Style="{StaticResource JpComboStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="{DynamicResource Common.Customer}" Style="{StaticResource JpLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding CustomerFilterOptions}"
                                      SelectedItem="{Binding CustomerFilter}"
                                      Style="{StaticResource JpComboStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="{DynamicResource Common.Salesman}" Style="{StaticResource JpLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding SalesmanFilterOptions}"
                                      SelectedItem="{Binding SalesmanFilter}"
                                      Style="{StaticResource JpComboStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="8">
                            <TextBlock Text="{DynamicResource JobProfitability.DATERange}" Style="{StaticResource JpLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding DateRangeOptions}"
                                      SelectedItem="{Binding DateRangeFilter}"
                                      Style="{StaticResource JpComboStyle}"/>
                        </StackPanel>

                        <Button Grid.Column="10"
                                Content="{DynamicResource Action.Refresh}"
                                Style="{StaticResource JpCompactButton}"
                                Command="{Binding RefreshCommand}"
                                VerticalAlignment="Bottom"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══════════ TAB CONTROL ══════════ -->
            <TabControl Grid.Row="1" Margin="20,12,20,0"
                        Style="{StaticResource PillTabControlStyle}">

                <!-- ═══ TAB 1: JOB PROFITABILITY (summary + jobs) ═══ -->
                <TabItem Style="{StaticResource PillTabItemStyle}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextBody}"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="JOB PROFITABILITY" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  PanningMode="VerticalOnly">
                        <StackPanel Margin="0,12,0,20">

                            <!-- ═══ FOUR KPI CARDS — DYNAMIC per selection ══════════
                                 Step 9 inspects ONE PI. Click any row in the
                                 jobs table and these cards switch from the
                                 portfolio aggregate to that PI's own figures:
                                 REQUIRED TARGET, EXPECTED PROFIT MARGIN,
                                 MARGIN AGAINST TARGET (Step 9's approved KPI)
                                 and OVERALL margin as the 4th card. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- CARD 1 — REQUIRED TARGET VALUE -->
                                <Border Grid.Column="0" Style="{StaticResource JpTileStyle}"
                                        ToolTip="Base-price required target (DGU formula × uplift). A U-insert covered by the given price or billed separately in Step 6 is shown as information and is never added to the target. Click a row to see that PI's own required target.">
                                    <StackPanel>
                                        <TextBlock Text="REQUIRED TARGET VALUE" Style="{StaticResource JpTileCaptionStyle}"/>
                                        <TextBlock Text="{Binding TopRequiredTargetValueDisplay}" FontSize="{StaticResource TextHeadline}"
                                                   Style="{StaticResource JpTileValueStyle}"/>
                                        <TextBlock Text="{Binding TopRequiredTargetScope}" Style="{StaticResource JpFootnoteStyle}"/>
                                    </StackPanel>
                                </Border>

                                <!-- CARD 2 — EXPECTED PROFIT MARGIN (company default, same as Step 9) -->
                                <Border Grid.Column="2" Style="{StaticResource JpTileStyle}"
                                        ToolTip="The company base expected profit margin every PI's achieved margin is judged against (Settings > Features > Proforma Invoice > Step 9).">
                                    <StackPanel>
                                        <TextBlock Text="EXPECTED PROFIT MARGIN" Style="{StaticResource JpTileCaptionStyle}"/>
                                        <TextBlock Text="{Binding BaseExpectedMarginDisplay}" FontSize="{StaticResource TextHeadline}"
                                                   Style="{StaticResource JpTileValueStyle}"/>
                                        <TextBlock Style="{StaticResource JpFootnoteStyle}">
                                            <Run Text="Uplift "/><Run Text="{Binding BaseExpectedMarginFactorLabel, Mode=OneWay}"/>
                                            <Run Text=" — company default (Step 9)"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- CARD 3 — MARGIN AGAINST TARGET (Step 9 approved KPI) -->
                                <Border Grid.Column="4">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource JpTileStyle}">
                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTopTargetBelow}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasTopTargetMargin}" Value="False">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="MARGIN AGAINST TARGET"
                                                       Style="{StaticResource JpTileCaptionStyle}"
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="1">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource JpStatusPill}">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTopTargetBelow}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsTopTargetIncomplete}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsTopTargetStale}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding TopTargetStatusLabel}"
                                                           FontSize="{StaticResource TextCaption}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding TopTargetMarginDisplay}" FontSize="{StaticResource TextHeadline}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource JpTileValueStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTopTargetBelow}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasTopTargetMargin}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource JpFootnoteStyle}">
                                            <Run Text="Given judged vs base price · Step 9 KPI"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- CARD 4 — OVERALL MARGIN (actual P&L, 4th card) -->
                                <Border Grid.Column="6">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource JpTileStyle}">
                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTopOverallLoss}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="OVERALL MARGIN" Style="{StaticResource JpTileCaptionStyle}"/>
                                        <TextBlock Text="{Binding TopOverallMarginDisplay}" FontSize="{StaticResource TextHeadline}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource JpTileValueStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTopOverallLoss}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding TopOverallVerdict}"
                                                   FontSize="{StaticResource TextCaption}"
                                                   FontWeight="Bold"
                                                   Margin="0,5,0,0"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTopOverallAboveBase}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsTopOverallBelowBase}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Scope line: which PI (or all) the cards show -->
                            <Grid Margin="2,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TopScopeSummary}"
                                           FontSize="{StaticResource TextCaption}"
                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Content="Show all PIs"
                                        Command="{Binding ClearRowSelectionCommand}"
                                        Padding="10,0"
                                        VerticalAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource JpCompactButton}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasRowSelection}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <!-- ═══ VALUE + COUNT STRIP (5 compact chips) ═══
                                 Portfolio-wide totals across the filtered PIs;
                                 sized to stay visible in a normal window. -->
                            <UniformGrid Columns="5" Margin="0,10,0,0">
                                <Border Style="{StaticResource JpChipStyle}" Margin="0,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="CONFIRMED JOBS" Style="{StaticResource JpLabelStyle}"/>
                                        <TextBlock Text="{Binding ConfirmedJobCountDisplay}" FontSize="{StaticResource TextSubhead}" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource JpChipStyle}" Margin="4,0">
                                    <StackPanel>
                                        <TextBlock Text="REQUIRED TARGET" Style="{StaticResource JpLabelStyle}"/>
                                        <TextBlock Text="{Binding TargetTotalRequiredValueDisplay}" FontSize="{StaticResource TextSubhead}" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource JpChipStyle}" Margin="4,0">
                                    <StackPanel>
                                        <TextBlock Text="STEP 5 GIVEN VALUE" Style="{StaticResource JpLabelStyle}"/>
                                        <TextBlock Text="{Binding TargetTotalGivenValueDisplay}" FontSize="{StaticResource TextSubhead}" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource JpChipStyle}" Margin="4,0">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL DIFFERENCE" Style="{StaticResource JpLabelStyle}"/>
                                        <TextBlock Text="{Binding TargetTotalDifferenceValueDisplay}" FontSize="{StaticResource TextSubhead}" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasTargetShortfall}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasAnyTargetData}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource JpChipStyle}" Margin="4,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="VALID · INCOMPLETE · STALE" Style="{StaticResource JpLabelStyle}" TextWrapping="Wrap"/>
                                        <TextBlock FontSize="{StaticResource TextSubhead}" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}">
                                            <Run Text="{Binding ValidTargetJobCountDisplay, Mode=OneWay}"/><Run Text=" · "/>
                                            <Run Text="{Binding IncompleteTargetJobCountDisplay, Mode=OneWay}"/><Run Text=" · "/>
                                            <Run Text="{Binding StaleTargetJobCountDisplay, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <TextBlock Text="{Binding TargetDataBasisNote}"
                                       FontSize="{StaticResource TextCaption}"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextWrapping="Wrap" Margin="2,8,0,0"/>

<!-- ═══ TABLE TOOLBAR ═══ -->
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CONFIRMED PIs" Style="{StaticResource JpSectionLabelStyle}"/>
                                    <TextBlock Style="{StaticResource JpSectionHintStyle}">
                                        <Run Text="One row per PI-confirmed invoice — click a row for the full Step 9 detail in the sidebar, double-click for the full page. "/>
                                        <Run Text="{Binding PortfolioStatusLine, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Width="150" VerticalAlignment="Bottom">
                                    <TextBlock Style="{StaticResource JpLabelStyle}">
                                        <Run Text="Margin vs "/><Run Text="{Binding BaseExpectedMarginDisplay, Mode=OneWay}"/><Run Text=" base"/>
                                    </TextBlock>
                                    <ComboBox ItemsSource="{Binding MarginBandFilterOptions}"
                                              SelectedItem="{Binding MarginBandFilter}"
                                              Style="{StaticResource JpComboStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Width="160" VerticalAlignment="Bottom">
                                    <TextBlock Text="Sort by" Style="{StaticResource JpLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding SortByOptions}"
                                              SelectedItem="{Binding SortBy}"
                                              Style="{StaticResource JpComboStyle}"/>
                                </StackPanel>
                            </Grid>

                            <!-- ═══ JOBS TABLE — stretches to fill the width ═══ -->
                            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                                    BorderBrush="{DynamicResource OutlineBrush}"
                                    BorderThickness="{DynamicResource CardBorderThickness}"
                                    CornerRadius="{DynamicResource CardCornerRadius}"
                                    Margin="0,10,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <ScrollViewer Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  MaxHeight="520"
                                                  behaviors:SmoothScrollBehavior.IsEnabled="True"
                                                  Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibilityConverter}}">

                                        <!-- Content stretches to the viewport width:
                                             header and every row share identical
                                             column definitions, so the table fills
                                             edge-to-edge. On narrow windows the
                                             row keeps a comfortable minimum and a
                                             horizontal scrollbar appears only when
                                             really needed. -->
                                        <Grid MinWidth="1040">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
<ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*" MinWidth="150"/>
                                                <ColumnDefinition Width="92"/>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="176"/>
                                                <ColumnDefinition Width="156"/>
                                                    </Grid.ColumnDefinitions>

                                            <!-- header -->
                                            <Border Grid.Row="0" Grid.ColumnSpan="8"
                                                    Background="{DynamicResource AccentBrush}"
                                                    CornerRadius="{DynamicResource Radius.Top.Medium}"
                                                    Padding="12,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
<ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*" MinWidth="150"/>
                                                <ColumnDefinition Width="92"/>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="176"/>
                                                <ColumnDefinition Width="156"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="PROFORMA" Style="{StaticResource JpHeaderCellStyle}"/>
                                                    <TextBlock Grid.Column="1" Text="CUSTOMER / PROJECT" Style="{StaticResource JpHeaderCellStyle}"/>
                                                    <TextBlock Grid.Column="2" Text="CONFIRMED" Style="{StaticResource JpHeaderCellStyle}"/>
                                                    <TextBlock Grid.Column="3" Text="NET" Style="{StaticResource JpHeaderCellStyle}" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="4" Text="COST" Style="{StaticResource JpHeaderCellStyle}" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="5" Text="PROFIT" Style="{StaticResource JpHeaderCellStyle}" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="6" Text="MARGIN VS TARGET" Style="{StaticResource JpHeaderCellStyle}" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="7" Text="STATUS" Style="{StaticResource JpHeaderCellStyle}"/>
                                                </Grid>
                                            </Border>

                                            <ItemsControl Grid.Row="1" Grid.ColumnSpan="8"
                                                          ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ContentControl Cursor="Hand">
                                                            <ContentControl.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick"
                                                                              Command="{Binding DataContext.SelectRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                              CommandParameter="{Binding}"/>
                                                                <MouseBinding MouseAction="LeftDoubleClick"
                                                                              Command="{Binding DataContext.OpenFullDetailCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                              CommandParameter="{Binding}"/>
                                                            </ContentControl.InputBindings>
                                                            <Border BorderBrush="{DynamicResource OutlineBrush}"
                                                                    BorderThickness="{DynamicResource Border.BottomHairlineThickness}"
                                                                    Padding="12,5">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelectedRow}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid>
                                                                <Grid.ColumnDefinitions>
<ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*" MinWidth="150"/>
                                                <ColumnDefinition Width="92"/>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="176"/>
                                                <ColumnDefinition Width="156"/>
                                                    </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding ProformaId}"
                                                                           Style="{StaticResource JpCellStyle}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource AccentBrush}"/>

                                                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                                    <TextBlock Text="{Binding CustomerName}"
                                                                               Style="{StaticResource JpCellStyle}"
                                                                               FontWeight="SemiBold"
                                                                               MaxWidth="340"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding ProjectName}"
                                                                               FontSize="{StaticResource TextCaption}"
                                                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                                                               MaxWidth="340"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Margin="0,1,0,0"/>
                                                                </StackPanel>

                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding IssueDateDisplay}"
                                                                           Style="{StaticResource JpCellStyle}"
                                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                                                                <TextBlock Grid.Column="3"
                                                                           Text="{Binding NetDisplay}"
                                                                           Style="{StaticResource JpCellStyle}"
                                                                           HorizontalAlignment="Right"/>

                                                                <TextBlock Grid.Column="4"
                                                                           Text="{Binding CostDisplay}"
                                                                           Style="{StaticResource JpCellStyle}"
                                                                           HorizontalAlignment="Right"/>

                                                                <TextBlock Grid.Column="5"
                                                                           Text="{Binding ProfitDisplay}"
                                                                           HorizontalAlignment="Right"
                                                                           ToolTip="{Binding RecalculationWarning}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource JpCellStyle}">
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsLoss}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsCosted}" Value="False">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>

                                                                <StackPanel Grid.Column="6" HorizontalAlignment="Right" Margin="0,0,30,0">
                                                                    <TextBlock Text="{Binding TargetExtraMarginDisplay}"
                                                                               HorizontalAlignment="Right"
                                                                               ToolTip="Margin over the base price — judged on the given price (net of any U-insert inside it).">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource JpCellStyle}">
                                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasValidExtraMargin}" Value="False">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding IsBelowTarget}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>

                                                                <Border Grid.Column="7" HorizontalAlignment="Left" Margin="10,0,0,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border" BasedOn="{StaticResource JpStatusPill}">
                                                                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsBelowTarget}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsTargetIncomplete}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsTargetStale}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding TargetStatusLabel}"
                                                                               FontSize="{StaticResource TextCaption}"
                                                                               FontWeight="Bold"
                                                                               Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        </ContentControl>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </ScrollViewer>

                                    <!-- Empty state -->
                                    <Border Grid.Row="1"
                                            Padding="24,40"
                                            Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                                            <TextBlock Text="&#xE9D9;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="{StaticResource TextDisplay}"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                                       Margin="0,0,0,12"/>
                                            <TextBlock Text="{DynamicResource JobProfitability.NoJobsShow}"
                                                       FontSize="{StaticResource TextSection}"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            <TextBlock Text="{DynamicResource JobProfitability.NoSavedProformaMarkedPIConfirmedYetConfirm}"
                                                       FontSize="{StaticResource TextBody}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,4,0,0"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ═══ TAB 2: Service Profitability ═══ -->
                <TabItem Style="{StaticResource PillTabItemStyle}"
                         DataContext="{Binding PortfolioServiceProfitability}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextBody}"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="SERVICE DETAIL" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <local:PortfolioServiceProfitabilityView/>
                </TabItem>

                <!-- ═══ TAB 3: Wastage Analysis ═══ -->
                <TabItem Style="{StaticResource PillTabItemStyle}"
                         DataContext="{Binding PortfolioWastageAnalysis}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextBody}"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="SHEET / WASTAGE DETAIL" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <local:PortfolioWastageAnalysisView/>
                </TabItem>

                <!-- ═══ TAB 4: Glass Type Comparison ═══ -->
                <TabItem Style="{StaticResource PillTabItemStyle}"
                         DataContext="{Binding PortfolioGlassTypeComparison}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextBody}"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="GLASS / SPEC COMPARISON" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <local:PortfolioGlassTypeComparisonView/>
                </TabItem>

            </TabControl>

            <!-- Status line -->
            <Border Grid.Row="2"
                    Margin="20,8,20,14"
                    Padding="4,0">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="{StaticResource TextBody}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedForegroundBrush}"/>
            </Border>

        </Grid>

        <!-- ═══ RIGHT: Detail Sidebar ═══ -->
        <Border Grid.Column="1" Width="420"
                Visibility="{Binding JobDetail.IsPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <local:JobDetailPanel DataContext="{Binding JobDetail}"/>
        </Border>

        </Grid>

        <!-- ═══ LAYER 2 — full-screen detail page (double-click on a row).
             Opens as the whole module surface, exactly like the Step 9
             Profit & Loss full-screen spec report: an accent toolbar with
             a BACK button, then the full-width detail (same JobDetail VM
             as the sidebar, so the figures always agree). ═══ -->
        <Grid Visibility="{Binding HasFullDetail, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar: back to jobs · hint -->
            <Border Grid.Row="0"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="{DynamicResource Border.BottomHairlineThickness}"
                    Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="← BACK TO JOBS"
                            Command="{Binding CloseFullDetailCommand}"
                            Style="{StaticResource OutlinedPillButton}"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            ToolTip="Return to the confirmed-jobs list."/>
                    <TextBlock Grid.Column="1"
                               FontSize="{StaticResource TextCaption}"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0">
                        <Run Text="Full detail for "/><Run Text="{Binding JobDetail.ProformaId, Mode=OneWay}"/>
                        <Run Text=" — double-click any row in the jobs list to open it here; a single click opens the sidebar."/>
                    </TextBlock>
                </Grid>
            </Border>

            <local:JobFullDetailView Grid.Row="1" DataContext="{Binding JobDetail}"/>
        </Grid>

    </Grid>
</UserControl>
