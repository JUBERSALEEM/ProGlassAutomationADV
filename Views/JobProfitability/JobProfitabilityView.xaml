<UserControl x:Class="ProGlassAutomation.Views.JobProfitability.JobProfitabilityView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:local="clr-namespace:ProGlassAutomation.Views.JobProfitability"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1280"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <Style x:Key="JpLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <Style x:Key="JpInputStyle" TargetType="TextBox">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="Background"               Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground"               Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
            <Setter Property="Padding"                  Value="8,0"/>
            <Setter Property="Height"                   Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush"               Value="{DynamicResource PrimaryForegroundBrush}"/>
        </Style>

        <Style x:Key="JpComboStyle" TargetType="ComboBox">
            <Setter Property="Background"               Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground"               Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="Padding"                  Value="8,0"/>
            <Setter Property="Height"                   Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Small compact button used in the filter bar -->
        <Style x:Key="JpCompactButton" TargetType="Button" BasedOn="{StaticResource PrimaryPillButton}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>

        <Style x:Key="JpTileStyle" TargetType="Border" BasedOn="{StaticResource KpiTileHoverStyle}">
            <Setter Property="Padding" Value="16,14"/>
        </Style>

        <Style x:Key="JpTileCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <Style x:Key="JpTileValueStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        </Style>

        <Style x:Key="JpFootnoteStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <Style x:Key="JpSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextTitle}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Margin" Value="2,0,0,2"/>
        </Style>

        <Style x:Key="JpSectionHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>

        <!-- Small value/count chip in the strip under the KPI cards -->
        <Style x:Key="JpChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <!-- Target status pill -->
        <Style x:Key="JpStatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
        </Style>

    </UserControl.Resources>

    <!-- Two-column layout: main content + detail sidebar -->
    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT: Main Content ═══ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══════════ HEADER + FILTERS — SINGLE ROW ══════════
                 Search (flexible, small), Company, Customer, Salesman,
                 Date range and Refresh all on ONE row with compact widths
                 so they fit without wrapping. -->
            <Border Grid.Row="0"
                    Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Margin="20,14,20,0"
                    Padding="18,12,18,12">
                <StackPanel>

                    <!-- Title row -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource TintIndigoBrush}"
                                Width="24" Height="24"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                            <TextBlock Text="&#xE9D9;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{StaticResource TextBodyLarge}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Title}"
                                   FontSize="{StaticResource TextTitle}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Subtitle}"
                                   FontSize="{StaticResource TextCaption}"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="12,0,10,0"/>
                    </Grid>

                    <!-- ONE filter row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="120"/>
<ColumnDefinition Width="8"/>
<ColumnDefinition Width="130"/>
<ColumnDefinition Width="8"/>
<ColumnDefinition Width="150"/>
<ColumnDefinition Width="8"/>
<ColumnDefinition Width="120"/>
<ColumnDefinition Width="8"/>
<ColumnDefinition Width="130"/>
<ColumnDefinition Width="8"/>
<ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource JobProfitability.SearchProformaCustomerProject}"
                                       Style="{StaticResource JpLabelStyle}"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                     Style="{StaticResource JpInputStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Common.Company}" Style="{StaticResource JpLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding CompanyFilterOptions}"
                                      SelectedItem="{Binding CompanyFilter}"
                                      Style="{StaticResource JpComboStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="{DynamicResource Common.Customer}" Style="{StaticResource JpLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding CustomerFilterOptions}"
                                      SelectedItem="{Binding CustomerFilter}"
                                      Style="{StaticResource JpComboStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="{DynamicResource Common.Salesman}" Style="{StaticResource JpLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding SalesmanFilterOptions}"
                                      SelectedItem="{Binding SalesmanFilter}"
                                      Style="{StaticResource JpComboStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="8">
                            <TextBlock Text="{DynamicResource JobProfitability.DATERange}" Style="{StaticResource JpLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding DateRangeOptions}"
                                      SelectedItem="{Binding DateRangeFilter}"
                                      Style="{StaticResource JpComboStyle}"/>
                        </StackPanel>

                        <Button Grid.Column="10"
                                Content="{DynamicResource Action.Refresh}"
                                Style="{StaticResource JpCompactButton}"
                                Command="{Binding RefreshCommand}"
                                VerticalAlignment="Bottom"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══════════ TAB CONTROL ══════════ -->
            <TabControl Grid.Row="1" Margin="20,12,20,0"
                        Style="{StaticResource PillTabControlStyle}">

                <!-- ═══ TAB 1: JOB PROFITABILITY (summary + jobs) ═══ -->
                <TabItem Style="{StaticResource PillTabItemStyle}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="JOB PROFITABILITY" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  PanningMode="VerticalOnly">
                        <StackPanel Margin="0,12,0,20">

                            <!-- ═══ FOUR KPI CARDS — mirrors Step 9 + Overall ═══
                                 Step 9 (a single PI) shows: REQUIRED TARGET,
                                 EXPECTED PROFIT MARGIN, MARGIN AGAINST TARGET.
                                 Here those three are rolled up across every
                                 confirmed PI, and the 4th card is the actual
                                 OVERALL margin (Σ profit ÷ Σ cost). -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- CARD 1 — REQUIRED TARGET VALUE (Step 9 required target, rolled up) -->
                                <Border Grid.Column="0" Style="{StaticResource JpTileStyle}"
                                        ToolTip="Sum of every valid PI's final required target (Step 9 target model).">
                                    <StackPanel>
                                        <TextBlock Text="REQUIRED TARGET VALUE" Style="{StaticResource JpTileCaptionStyle}"/>
                                        <TextBlock Text="{Binding TargetTotalRequiredValueDisplay}" FontSize="26"
                                                   Style="{StaticResource JpTileValueStyle}"/>
                                        <TextBlock Style="{StaticResource JpFootnoteStyle}">
                                            <Run Text="Σ final required target · specification formula "/>
                                            <Run Text="{Binding BaseExpectedMarginFactorLabel, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- CARD 2 — EXPECTED PROFIT MARGIN (company default, same as Step 9) -->
                                <Border Grid.Column="2" Style="{StaticResource JpTileStyle}"
                                        ToolTip="The company base expected profit margin every PI's achieved margin is judged against (Settings > Features > Proforma Invoice > Step 9).">
                                    <StackPanel>
                                        <TextBlock Text="EXPECTED PROFIT MARGIN" Style="{StaticResource JpTileCaptionStyle}"/>
                                        <TextBlock Text="{Binding BaseExpectedMarginDisplay}" FontSize="26"
                                                   Style="{StaticResource JpTileValueStyle}"/>
                                        <TextBlock Style="{StaticResource JpFootnoteStyle}"
                                                   Text="Company default · Settings → Features → Proforma Invoice → Step 9"/>
                                    </StackPanel>
                                </Border>

                                <!-- CARD 3 — MARGIN AGAINST TARGET (Step 9 KPI, rolled up) -->
                                <Border Grid.Column="4">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource JpTileStyle}">
                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPortfolioTargetBelow}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasPortfolioTargetMargin}" Value="False">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="MARGIN AGAINST TARGET" Style="{StaticResource JpTileCaptionStyle}"
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="1">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource JpStatusPill}">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPortfolioTargetBelow}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasPortfolioTargetMargin}" Value="False">
                                                                <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding PortfolioTargetStatusLabel}" FontSize="{StaticResource TextCaption}"
                                                           FontWeight="Bold" Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding PortfolioTargetMarginDisplay}" FontSize="26">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource JpTileValueStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPortfolioTargetBelow}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasPortfolioTargetMargin}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource JpFootnoteStyle}">
                                            <Run Text="Σ difference ÷ Σ required target · over "/>
                                            <Run Text="{Binding ValidTargetJobCountDisplay, Mode=OneWay}"/>
                                            <Run Text=" valid job(s)"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- CARD 4 — OVERALL MARGIN (actual P&L) -->
                                <Border Grid.Column="6">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource JpTileStyle}">
                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPortfolioLoss}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="OVERALL MARGIN" Style="{StaticResource JpTileCaptionStyle}"/>
                                        <TextBlock Text="{Binding OverallMarginPercentDisplay}" FontSize="26">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource JpTileValueStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPortfolioLoss}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding OverallVsBaseVerdict}"
                                                   FontSize="{StaticResource TextCaption}"
                                                   FontWeight="Bold"
                                                   Margin="0,5,0,0"
                                                   TextWrapping="Wrap"
                                                   ToolTip="Σ profit ÷ Σ cost × 100 on NET revenue (ex-VAT) — mirrors the Step 9 overall margin.">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OverallVsBaseBand}" Value="AboveBase">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding OverallVsBaseBand}" Value="BelowBase">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ═══ VALUE + COUNT STRIP ═══
                                 Compact chips (not tall cards): confirmed
                                 jobs, Step 5 given value, total difference
                                 (= required − given; e.g. 5,839.44 − 5,472.55
                                 → AED 366.89 shortfall), and valid /
                                 incomplete / stale counts. -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource JpChipStyle}">
                                    <StackPanel>
                                        <TextBlock Text="CONFIRMED JOBS" Style="{StaticResource JpLabelStyle}"/>
                                        <TextBlock Text="{Binding ConfirmedJobCountDisplay}" FontSize="20" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource JpChipStyle}">
                                    <StackPanel>
                                        <TextBlock Text="STEP 5 GIVEN VALUE" Style="{StaticResource JpLabelStyle}"/>
                                        <TextBlock Text="{Binding TargetTotalGivenValueDisplay}" FontSize="20" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" Style="{StaticResource JpChipStyle}"
                                        ToolTip="Required target − Step 5 given value. Positive = below target (shortfall), negative = above target.">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL DIFFERENCE" Style="{StaticResource JpLabelStyle}"/>
                                        <TextBlock Text="{Binding TargetTotalDifferenceValueDisplay}" FontSize="20" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasTargetShortfall}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasAnyTargetData}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="6" Style="{StaticResource JpChipStyle}">
                                    <StackPanel>
                                        <TextBlock Text="NET / PROFIT" Style="{StaticResource JpLabelStyle}"/>
                                        <TextBlock FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}">
                                            <Run Text="{Binding TotalNetDisplay, Mode=OneWay}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding TotalProfitLabel, Mode=OneWay}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding TotalProfitDisplay, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="8" Style="{StaticResource JpChipStyle}">
                                    <StackPanel>
                                        <TextBlock Text="VALID / INCOMPLETE / STALE" Style="{StaticResource JpLabelStyle}"/>
                                        <TextBlock FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryForegroundBrush}">
                                            <Run Text="{Binding ValidTargetJobCountDisplay, Mode=OneWay}"/><Run Text=" · "/>
                                            <Run Text="{Binding IncompleteTargetJobCountDisplay, Mode=OneWay}"/><Run Text=" · "/>
                                            <Run Text="{Binding StaleTargetJobCountDisplay, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding TargetDataBasisNote}"
                                       FontSize="{StaticResource TextCaption}"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       TextWrapping="Wrap" Margin="2,8,0,0"/>

                            <!-- ═══ TABLE TOOLBAR ═══ -->
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CONFIRMED PIs" Style="{StaticResource JpSectionLabelStyle}"/>
                                    <TextBlock Style="{StaticResource JpSectionHintStyle}">
                                        <Run Text="One row per PI-confirmed invoice — click a row for the full Step 9 detail in the sidebar. "/>
                                        <Run Text="{Binding PortfolioStatusLine, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Width="150" VerticalAlignment="Bottom">
                                    <TextBlock Style="{StaticResource JpLabelStyle}">
                                        <Run Text="Margin vs "/><Run Text="{Binding BaseExpectedMarginDisplay, Mode=OneWay}"/><Run Text=" base"/>
                                    </TextBlock>
                                    <ComboBox ItemsSource="{Binding MarginBandFilterOptions}"
                                              SelectedItem="{Binding MarginBandFilter}"
                                              Style="{StaticResource JpComboStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Width="160" VerticalAlignment="Bottom">
                                    <TextBlock Text="Sort by" Style="{StaticResource JpLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding SortByOptions}"
                                              SelectedItem="{Binding SortBy}"
                                              Style="{StaticResource JpComboStyle}"/>
                                </StackPanel>
                            </Grid>

                            <!-- ═══ JOBS TABLE — stretches to fill the width ═══ -->
                            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                                    BorderBrush="{DynamicResource OutlineBrush}"
                                    BorderThickness="{DynamicResource CardBorderThickness}"
                                    CornerRadius="{DynamicResource CardCornerRadius}"
                                    Margin="0,10,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <ScrollViewer Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  MaxHeight="520"
                                                  behaviors:SmoothScrollBehavior.IsEnabled="True"
                                                  Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibilityConverter}}">

                                        <!-- Content stretches to the viewport width:
                                             header and every row share identical
                                             column definitions, so the table fills
                                             edge-to-edge with no empty sides. -->
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="82"/>
<ColumnDefinition Width="*" MinWidth="130"/>
<ColumnDefinition Width="72"/>
<ColumnDefinition Width="78"/>
<ColumnDefinition Width="78"/>
<ColumnDefinition Width="78"/>
<ColumnDefinition Width="90"/>
<ColumnDefinition Width="84"/>
<ColumnDefinition Width="96"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- header -->
                                            <Border Grid.Row="0" Grid.ColumnSpan="9"
                                                    Background="{DynamicResource AccentBrush}"
                                                    CornerRadius="12,12,0,0"
                                                    Padding="12,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="82"/>
<ColumnDefinition Width="*" MinWidth="130"/>
<ColumnDefinition Width="72"/>
<ColumnDefinition Width="78"/>
<ColumnDefinition Width="78"/>
<ColumnDefinition Width="78"/>
<ColumnDefinition Width="90"/>
<ColumnDefinition Width="84"/>
<ColumnDefinition Width="96"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="PROFORMA" Style="{StaticResource JpHeaderCellStyle}"/>
                                                    <TextBlock Grid.Column="1" Text="CUSTOMER / PROJECT" Style="{StaticResource JpHeaderCellStyle}"/>
                                                    <TextBlock Grid.Column="2" Text="CONFIRMED" Style="{StaticResource JpHeaderCellStyle}"/>
                                                    <TextBlock Grid.Column="3" Text="NET" Style="{StaticResource JpHeaderCellStyle}" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="4" Text="COST" Style="{StaticResource JpHeaderCellStyle}" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="5" Text="PROFIT" Style="{StaticResource JpHeaderCellStyle}" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="6" Text="MARGIN" Style="{StaticResource JpHeaderCellStyle}" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="7" Text="VS TARGET" Style="{StaticResource JpHeaderCellStyle}" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="8" Text="STATUS" Style="{StaticResource JpHeaderCellStyle}"/>
                                                </Grid>
                                            </Border>

                                            <ItemsControl Grid.Row="1" Grid.ColumnSpan="9"
                                                          ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource OutlineBrush}"
                                                                BorderThickness="0,0,0,1"
                                                                Padding="12,6"
                                                                Cursor="Hand">
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick"
                                                                              Command="{Binding DataContext.SelectRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                              CommandParameter="{Binding}"/>
                                                            </Border.InputBindings>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="82"/>
<ColumnDefinition Width="*" MinWidth="130"/>
<ColumnDefinition Width="72"/>
<ColumnDefinition Width="78"/>
<ColumnDefinition Width="78"/>
<ColumnDefinition Width="78"/>
<ColumnDefinition Width="90"/>
<ColumnDefinition Width="84"/>
<ColumnDefinition Width="96"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding ProformaId}"
                                                                           Style="{StaticResource JpCellStyle}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource AccentBrush}"/>

                                                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                                    <TextBlock Text="{Binding CustomerName}"
                                                                               Style="{StaticResource JpCellStyle}"
                                                                               FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{Binding ProjectName}"
                                                                               FontSize="{StaticResource TextCaption}"
                                                                               Foreground="{DynamicResource MutedForegroundBrush}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Margin="0,1,0,0"/>
                                                                </StackPanel>

                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding IssueDateDisplay}"
                                                                           Style="{StaticResource JpCellStyle}"
                                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                                                                <TextBlock Grid.Column="3"
                                                                           Text="{Binding NetDisplay}"
                                                                           Style="{StaticResource JpCellStyle}"
                                                                           HorizontalAlignment="Right"/>

                                                                <TextBlock Grid.Column="4"
                                                                           Text="{Binding CostDisplay}"
                                                                           Style="{StaticResource JpCellStyle}"
                                                                           HorizontalAlignment="Right"/>

                                                                <TextBlock Grid.Column="5"
                                                                           Text="{Binding ProfitDisplay}"
                                                                           HorizontalAlignment="Right"
                                                                           ToolTip="{Binding RecalculationWarning}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource JpCellStyle}">
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsLoss}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsCosted}" Value="False">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>

                                                                <StackPanel Grid.Column="6" HorizontalAlignment="Right">
                                                                    <TextBlock Text="{Binding MarginDisplay}"
                                                                               HorizontalAlignment="Right"
                                                                               ToolTip="{Binding RecalculationWarning}">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource JpCellStyle}">
                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsLoss}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding IsCosted}" Value="False">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <!-- Chip: achieved margin vs base expected margin -->
                                                                    <TextBlock Text="{Binding MarginVsBaseChip}"
                                                                               FontSize="{StaticResource TextCaption}"
                                                                               FontWeight="Bold"
                                                                               HorizontalAlignment="Right"
                                                                               Margin="0,1,0,0"
                                                                               ToolTip="Achieved margin vs the base expected margin (Settings > Features > Proforma Invoice > Step 9).">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsMarginAboveBase}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding IsMarginBelowBase}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding HasBaseMarginComparison}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>

                                                                <TextBlock Grid.Column="7"
                                                                           Text="{Binding TargetMarginDisplay}"
                                                                           HorizontalAlignment="Right">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource JpCellStyle}">
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasValidTargetMargin}" Value="False">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsBelowTarget}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>

                                                                <Border Grid.Column="8" HorizontalAlignment="Left">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border" BasedOn="{StaticResource JpStatusPill}">
                                                                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsBelowTarget}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsTargetIncomplete}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsTargetStale}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding TargetStatusLabel}"
                                                                               FontSize="{StaticResource TextCaption}"
                                                                               FontWeight="Bold"
                                                                               Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </ScrollViewer>

                                    <!-- Empty state -->
                                    <Border Grid.Row="1"
                                            Padding="24,40"
                                            Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                                            <TextBlock Text="&#xE9D9;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="30"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                                       Margin="0,0,0,12"/>
                                            <TextBlock Text="{DynamicResource JobProfitability.NoJobsShow}"
                                                       FontSize="{StaticResource TextSection}"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            <TextBlock Text="{DynamicResource JobProfitability.NoSavedProformaMarkedPIConfirmedYetConfirm}"
                                                       FontSize="{StaticResource TextBody}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,4,0,0"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ═══ TAB 2: Service Profitability ═══ -->
                <TabItem Style="{StaticResource PillTabItemStyle}"
                         DataContext="{Binding PortfolioServiceProfitability}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="SERVICE DETAIL" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <local:PortfolioServiceProfitabilityView/>
                </TabItem>

                <!-- ═══ TAB 3: Wastage Analysis ═══ -->
                <TabItem Style="{StaticResource PillTabItemStyle}"
                         DataContext="{Binding PortfolioWastageAnalysis}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="SHEET / WASTAGE DETAIL" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <local:PortfolioWastageAnalysisView/>
                </TabItem>

                <!-- ═══ TAB 4: Glass Type Comparison ═══ -->
                <TabItem Style="{StaticResource PillTabItemStyle}"
                         DataContext="{Binding PortfolioGlassTypeComparison}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="GLASS / SPEC COMPARISON" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <local:PortfolioGlassTypeComparisonView/>
                </TabItem>

            </TabControl>

            <!-- Status line -->
            <Border Grid.Row="2"
                    Margin="20,8,20,14"
                    Padding="4,0">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="{StaticResource TextBody}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedForegroundBrush}"/>
            </Border>

        </Grid>

        <!-- ═══ RIGHT: Detail Sidebar ═══ -->
        <Border Grid.Column="1" Width="420"
                Visibility="{Binding JobDetail.IsPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <local:JobDetailPanel DataContext="{Binding JobDetail}"/>
        </Border>

    </Grid>
</UserControl>
