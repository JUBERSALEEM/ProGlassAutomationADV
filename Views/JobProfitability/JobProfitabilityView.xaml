<UserControl x:Class="ProGlassAutomation.Views.JobProfitability.JobProfitabilityView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:local="clr-namespace:ProGlassAutomation.Views.JobProfitability"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1280"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- Migrated JpLabelStyle to global Typography.Label -->
    <!-- Migrated JpLabelStyle to global Typography.Label -->
    
                                                </Border.Style>
                                                <TextBlock Text="{Binding TopTargetStatusLabel}"
                                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                                           FontWeight="{DynamicResource Weight.Bold}"
                                                           Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding TopTargetMarginDisplay}" FontSize="{DynamicResource FontSize.H1}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource JpTileValueStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTopTargetBelow}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasTopTargetMargin}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource JpFootnoteStyle}">
                                            <Run Text="Given judged vs base price · Step 9 KPI"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- CARD 4 — OVERALL MARGIN (actual P&L, 4th card) -->
                                <Border Grid.Column="6">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource JpTileStyle}">
                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTopOverallLoss}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="OVERALL MARGIN" Style="{StaticResource JpTileCaptionStyle}"/>
                                        <TextBlock Text="{Binding TopOverallMarginDisplay}" FontSize="{DynamicResource FontSize.H1}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource JpTileValueStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTopOverallLoss}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding TopOverallVerdict}"
                                                   FontSize="{DynamicResource FontSize.BodySmall}"
                                                   FontWeight="{DynamicResource Weight.Bold}"
                                                   Margin="0,5,0,0"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTopOverallAboveBase}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsTopOverallBelowBase}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Scope line: which PI (or all) the cards show -->
                            <Grid Margin="2,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TopScopeSummary}"
                                           FontSize="{DynamicResource FontSize.BodySmall}"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Content="Show all PIs"
                                        Command="{Binding ClearRowSelectionCommand}"
                                        Padding="10,0"
                                        VerticalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}">
                                    <Button.Style Style="{StaticResource SecondaryButtonStyle}">
                                        <Style TargetType="Button" BasedOn="{StaticResource JpCompactButton}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasRowSelection}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <!-- ═══ VALUE + COUNT STRIP (5 compact chips) ═══
                                 Portfolio-wide totals across the filtered PIs;
                                 sized to stay visible in a normal window. -->
                            <UniformGrid Columns="5" Margin="0,10,0,0">
                                <Border Style="{StaticResource JpChipStyle}" Margin="0,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="CONFIRMED JOBS" Style="{StaticResource Typography.Label}"/>
                                        <TextBlock Text="{Binding ConfirmedJobCountDisplay}" FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource JpChipStyle}" Margin="4,0">
                                    <StackPanel>
                                        <TextBlock Text="REQUIRED TARGET" Style="{StaticResource Typography.Label}"/>
                                        <TextBlock Text="{Binding TargetTotalRequiredValueDisplay}" FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource JpChipStyle}" Margin="4,0">
                                    <StackPanel>
                                        <TextBlock Text="STEP 5 GIVEN VALUE" Style="{StaticResource Typography.Label}"/>
                                        <TextBlock Text="{Binding TargetTotalGivenValueDisplay}" FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource JpChipStyle}" Margin="4,0">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL DIFFERENCE" Style="{StaticResource Typography.Label}"/>
                                        <TextBlock Text="{Binding TargetTotalDifferenceValueDisplay}" FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasTargetShortfall}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasAnyTargetData}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource JpChipStyle}" Margin="4,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="VALID · INCOMPLETE · STALE" Style="{StaticResource Typography.Label}" TextWrapping="Wrap"/>
                                        <TextBlock FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextPrimaryBrush}">
                                            <Run Text="{Binding ValidTargetJobCountDisplay, Mode=OneWay}"/><Run Text=" · "/>
                                            <Run Text="{Binding IncompleteTargetJobCountDisplay, Mode=OneWay}"/><Run Text=" · "/>
                                            <Run Text="{Binding StaleTargetJobCountDisplay, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <TextBlock Text="{Binding TargetDataBasisNote}"
                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       TextWrapping="Wrap" Margin="2,8,0,0"/>

<!-- ═══ TABLE TOOLBAR ═══ -->
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CONFIRMED PIs" Style="{StaticResource JpSectionLabelStyle}"/>
                                    <TextBlock Style="{StaticResource JpSectionHintStyle}">
                                        <Run Text="One row per PI-confirmed invoice — click a row for the full Step 9 detail in the sidebar, double-click for the full page. "/>
                                        <Run Text="{Binding PortfolioStatusLine, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Width="150" VerticalAlignment="Bottom">
                                    <TextBlock Style="{StaticResource Typography.Label}">
                                        <Run Text="Margin vs "/><Run Text="{Binding BaseExpectedMarginDisplay, Mode=OneWay}"/><Run Text=" base"/>
                                    </TextBlock>
                                    <ComboBox ItemsSource="{Binding MarginBandFilterOptions}"
                                              SelectedItem="{Binding MarginBandFilter}"
                                              Style="{StaticResource JpComboStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Width="160" VerticalAlignment="Bottom">
                                    <TextBlock Text="Sort by" Style="{StaticResource Typography.Label}"/>
                                    <ComboBox ItemsSource="{Binding SortByOptions}"
                                              SelectedItem="{Binding SortBy}"
                                              Style="{StaticResource JpComboStyle}"/>
                                </StackPanel>
                            </Grid>

                            <!-- ═══ JOBS TABLE — stretches to fill the width ═══ -->
                            <Border Background="{DynamicResource SurfacePrimaryBrush}"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    BorderThickness="{DynamicResource CardBorderThickness}"
                                    CornerRadius="{DynamicResource CardCornerRadius}"
                                    Margin="0,10,0,0" Style="{StaticResource SurfacePrimaryStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <ScrollViewer Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  MaxHeight="520"
                                                  behaviors:SmoothScrollBehavior.IsEnabled="True"
                                                  Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibilityConverter}}">

                                        <!-- Content stretches to the viewport width:
                                             header and every row share identical
                                             column definitions, so the table fills
                                             edge-to-edge. On narrow windows the
                                             row keeps a comfortable minimum and a
                                             horizontal scrollbar appears only when
                                             really needed. -->
                                        <Grid MinWidth="1040">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
<ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*" MinWidth="150"/>
                                                <ColumnDefinition Width="92"/>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="176"/>
                                                <ColumnDefinition Width="156"/>
                                                    </Grid.ColumnDefinitions>

                                            <!-- header -->
                                            <Border Grid.Row="0" Grid.ColumnSpan="8"
                                                    Background="{DynamicResource AccentBrush}"
                                                    CornerRadius="{DynamicResource Radius.Top.Medium}"
                                                    Padding="12,7" Style="{StaticResource SurfacePrimaryStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
<ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*" MinWidth="150"/>
                                                <ColumnDefinition Width="92"/>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="176"/>
                                                <ColumnDefinition Width="156"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="PROFORMA" Style="{StaticResource JpHeaderCellStyle}"/>
                                                    <TextBlock Grid.Column="1" Text="CUSTOMER / PROJECT" Style="{StaticResource JpHeaderCellStyle}"/>
                                                    <TextBlock Grid.Column="2" Text="CONFIRMED" Style="{StaticResource JpHeaderCellStyle}"/>
                                                    <TextBlock Grid.Column="3" Text="NET" Style="{StaticResource JpHeaderCellStyle}" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="4" Text="COST" Style="{StaticResource JpHeaderCellStyle}" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="5" Text="PROFIT" Style="{StaticResource JpHeaderCellStyle}" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="6" Text="MARGIN VS TARGET" Style="{StaticResource JpHeaderCellStyle}" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="7" Text="STATUS" Style="{StaticResource JpHeaderCellStyle}"/>
                                                </Grid>
                                            </Border>

                                            <ItemsControl Grid.Row="1" Grid.ColumnSpan="8"
                                                          ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ContentControl Cursor="Hand">
                                                            <ContentControl.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick"
                                                                              Command="{Binding DataContext.SelectRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                              CommandParameter="{Binding}"/>
                                                                <MouseBinding MouseAction="LeftDoubleClick"
                                                                              Command="{Binding DataContext.OpenFullDetailCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                              CommandParameter="{Binding}"/>
                                                            </ContentControl.InputBindings>
                                                            <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                                    BorderThickness="{DynamicResource Border.BottomHairlineThickness}"
                                                                    Padding="12,5">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelectedRow}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid>
                                                                <Grid.ColumnDefinitions>
<ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*" MinWidth="150"/>
                                                <ColumnDefinition Width="92"/>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="176"/>
                                                <ColumnDefinition Width="156"/>
                                                    </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding ProformaId}"
                                                                           Style="{StaticResource JpCellStyle}"
                                                                           FontWeight="{DynamicResource Weight.SemiBold}"
                                                                           Foreground="{DynamicResource AccentBrush}"/>

                                                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                                    <TextBlock Text="{Binding CustomerName}"
                                                                               Style="{StaticResource JpCellStyle}"
                                                                               FontWeight="{DynamicResource Weight.SemiBold}"
                                                                               MaxWidth="340"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding ProjectName}"
                                                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                                               MaxWidth="340"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Margin="0,1,0,0"/>
                                                                </StackPanel>

                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding IssueDateDisplay}"
                                                                           Style="{StaticResource JpCellStyle}"
                                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                                                                <TextBlock Grid.Column="3"
                                                                           Text="{Binding NetDisplay}"
                                                                           Style="{StaticResource JpCellStyle}"
                                                                           HorizontalAlignment="Right"/>

                                                                <TextBlock Grid.Column="4"
                                                                           Text="{Binding CostDisplay}"
                                                                           Style="{StaticResource JpCellStyle}"
                                                                           HorizontalAlignment="Right"/>

                                                                <TextBlock Grid.Column="5"
                                                                           Text="{Binding ProfitDisplay}"
                                                                           HorizontalAlignment="Right"
                                                                           ToolTip="{Binding RecalculationWarning}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource JpCellStyle}">
                                                                            <Setter Property="FontWeight" Value="{DynamicResource Weight.SemiBold}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsLoss}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsCosted}" Value="False">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                                                                    <Setter Property="FontWeight" Value="{DynamicResource Weight.Regular}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>

                                                                <StackPanel Grid.Column="6" HorizontalAlignment="Right" Margin="0,0,30,0">
                                                                    <TextBlock Text="{Binding TargetExtraMarginDisplay}"
                                                                               HorizontalAlignment="Right"
                                                                               ToolTip="Margin over the base price — judged on the given price (net of any U-insert inside it).">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource JpCellStyle}">
                                                                                <Setter Property="FontWeight" Value="{DynamicResource Weight.Bold}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasValidExtraMargin}" Value="False">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                                                                        <Setter Property="FontWeight" Value="{DynamicResource Weight.Regular}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding IsBelowTarget}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>

                                                                <Border Grid.Column="7" HorizontalAlignment="Left" Margin="10,0,0,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border" BasedOn="{StaticResource JpStatusPill}">
                                                                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsBelowTarget}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsTargetIncomplete}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsTargetStale}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding TargetStatusLabel}"
                                                                               FontSize="{DynamicResource FontSize.BodySmall}"
                                                                               FontWeight="{DynamicResource Weight.Bold}"
                                                                               Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        </ContentControl>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </ScrollViewer>

                                    <!-- Empty state -->
                                    <Border Grid.Row="1"
                                            Padding="24,40"
                                            Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                                            <TextBlock Text="&#xE9D9;"
                                                       FontFamily="{DynamicResource FontFamily.Icon}"
                                                       FontSize="{DynamicResource FontSize.Kpi}"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       Margin="0,0,0,12"/>
                                            <TextBlock Text="{DynamicResource JobProfitability.NoJobsShow}"
                                                       FontSize="{DynamicResource FontSize.H3}"
                                                       FontWeight="{DynamicResource Weight.SemiBold}"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            <TextBlock Text="{DynamicResource JobProfitability.NoSavedProformaMarkedPIConfirmedYetConfirm}"
                                                       FontSize="{DynamicResource FontSize.Body}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ═══ TAB 2: Service Profitability ═══ -->
                <TabItem Style="{StaticResource PillTabItemStyle}"
                         DataContext="{Binding PortfolioServiceProfitability}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71D;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.Body}"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="SERVICE DETAIL" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <local:PortfolioServiceProfitabilityView/>
                </TabItem>

                <!-- ═══ TAB 3: Wastage Analysis ═══ -->
                <TabItem Style="{StaticResource PillTabItemStyle}"
                         DataContext="{Binding PortfolioWastageAnalysis}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.Body}"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="SHEET / WASTAGE DETAIL" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <local:PortfolioWastageAnalysisView/>
                </TabItem>

                <!-- ═══ TAB 4: Glass Type Comparison ═══ -->
                <TabItem Style="{StaticResource PillTabItemStyle}"
                         DataContext="{Binding PortfolioGlassTypeComparison}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.Body}"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="GLASS / SPEC COMPARISON" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <local:PortfolioGlassTypeComparisonView/>
                </TabItem>

            </TabControl>

            <!-- Status line -->
            <Border Grid.Row="2"
                    Margin="20,8,20,14"
                    Padding="4,0">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="{DynamicResource FontSize.Body}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
            </Border>

        </Grid>

        <!-- ═══ RIGHT: Detail Sidebar ═══ -->
        <Border Grid.Column="1" Width="420"
                Visibility="{Binding JobDetail.IsPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <local:JobDetailPanel DataContext="{Binding JobDetail}"/>
        </Border>

        </Grid>

        <!-- ═══ LAYER 2 — full-screen detail page (double-click on a row).
             Opens as the whole module surface, exactly like the Step 9
             Profit & Loss full-screen spec report: an accent toolbar with
             a BACK button, then the full-width detail (same JobDetail VM
             as the sidebar, so the figures always agree). ═══ -->
        <Grid Visibility="{Binding HasFullDetail, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar: back to jobs · hint -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="{DynamicResource Border.BottomHairlineThickness}"
                    Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="← BACK TO JOBS"
                            Command="{Binding CloseFullDetailCommand}"
                            Style="{StaticResource OutlinedPillButton}"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            ToolTip="Return to the confirmed-jobs list."/>
                    <TextBlock Grid.Column="1"
                               FontSize="{DynamicResource FontSize.BodySmall}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0">
                        <Run Text="Full detail for "/><Run Text="{Binding JobDetail.ProformaId, Mode=OneWay}"/>
                        <Run Text=" — double-click any row in the jobs list to open it here; a single click opens the sidebar."/>
                    </TextBlock>
                </Grid>
            </Border>

            <local:JobFullDetailView Grid.Row="1" DataContext="{Binding JobDetail}"/>
        </Grid>

    </Grid>
</UserControl>
