<!-- ═══════════════════════════════════════════════════════════════════════
     FILE: Views/JobProfitability/PortfolioServiceProfitabilityView.xaml
     MODULE: Portfolio Service Profitability (Job Profitability → Tab 2)
     
     WHAT IT IS:
       Aggregated service profitability across ALL confirmed PIs.
       Shows which services (cutting, tempering, U-insert, ASP, etc.)
       are profitable vs loss-making across the entire portfolio.
       
       Business rules applied:
       - DGU: cutting/tempering bundled in spacer charge (not shown separately)
       - SGU: cutting, tempering, polish, holes, cutouts shown separately
       - LAM: cutting, tempering, PVB, polish shown separately
       - DGU+LAM: bundled DGU services + separate LAM services
═══════════════════════════════════════════════════════════════════════ -->
<UserControl Style="{StaticResource ErpPageRootStyle}" x:Class="ProGlassAutomation.Views.JobProfitability.PortfolioServiceProfitabilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1100"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        

        
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════ HEADER ═══════ -->
        <Border Grid.Row="0" Margin="16,16,16,0" Padding="16"
                Background="{DynamicResource SurfacePrimaryBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="{DynamicResource Border.HairlineThickness}" CornerRadius="{DynamicResource Radius.Small}">
            <StackPanel>
                <TextBlock Text="Service Profitability — All Confirmed Jobs"
                           FontSize="{DynamicResource FontSize.H2}"
                           FontWeight="{DynamicResource Weight.Bold}"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Which services are making money? Breaks down revenue by service type across all confirmed PIs."
                           FontSize="{DynamicResource FontSize.Body}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ═══════ SUMMARY KPIs ═══════ -->
        <Grid Grid.Row="1" Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}"
                    CornerRadius="{DynamicResource Radius.Small}" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="JOBS ANALYZED" FontSize="{DynamicResource FontSize.BodySmall}"
                               FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Text="{Binding TotalJobsAnalyzed}"
                               FontSize="{DynamicResource FontSize.H1}" FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}"
                    CornerRadius="{DynamicResource Radius.Small}" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="TOTAL SERVICE CHARGE" FontSize="{DynamicResource FontSize.BodySmall}"
                               FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Text="{Binding TotalServiceChargeDisplay}"
                               FontSize="{DynamicResource FontSize.H1}" FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}"
                    CornerRadius="{DynamicResource Radius.Small}" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="TOTAL SERVICE PROFIT" FontSize="{DynamicResource FontSize.BodySmall}"
                               FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Text="{Binding TotalServiceProfitDisplay}"
                               FontSize="{DynamicResource FontSize.H1}" FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}"
                    CornerRadius="{DynamicResource Radius.Small}" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="OVERALL MARGIN" FontSize="{DynamicResource FontSize.BodySmall}"
                               FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Text="{Binding OverallServiceMarginDisplay}"
                               FontSize="{DynamicResource FontSize.H1}" FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="8" Background="{DynamicResource SurfacePrimaryBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}"
                    CornerRadius="{DynamicResource Radius.Small}" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="BEST PERFORMER" FontSize="{DynamicResource FontSize.BodySmall}"
                               FontWeight="{DynamicResource Weight.Bold}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Text="{Binding BestPerformingService}"
                               FontSize="{DynamicResource FontSize.Title}" FontWeight="{DynamicResource Weight.Bold}"
                               Foreground="{DynamicResource SuccessBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════ SERVICE BREAKDOWN TABLE ═══════ -->
        <Border Grid.Row="2" Margin="16,12,16,0"
                Background="{DynamicResource SurfacePrimaryBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="{DynamicResource Border.HairlineThickness}" CornerRadius="{DynamicResource Radius.Small}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Table Header -->
                <Border Grid.Row="0" Background="{DynamicResource AccentBrush}"
                        CornerRadius="{DynamicResource Radius.Top.Medium}" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="SERVICE"/>
                        <TextBlock Grid.Column="1" Text="JOBS" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="CHARGE" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="COST" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="PROFIT" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="5" Text="MARGIN %" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- Table Rows -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              behaviors:SmoothScrollBehavior.IsEnabled="True">
                    <ItemsControl ItemsSource="{Binding ServiceBreakdown}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
                                        BorderThickness="{DynamicResource Border.BottomHairlineThickness}" Padding="16,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding ServiceName}"
                                                   FontWeight="{DynamicResource Weight.SemiBold}"/>

                                        <TextBlock Grid.Column="1" Text="{Binding JobCount}"
                                                   HorizontalAlignment="Right"/>

                                        <TextBlock Grid.Column="2" Text="{Binding TotalChargeDisplay}"
                                                   HorizontalAlignment="Right"/>

                                        <TextBlock Grid.Column="3" Text="{Binding TotalCostDisplay}"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                                        <TextBlock Grid.Column="4" Text="{Binding TotalProfitDisplay}"
                                                   HorizontalAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Typography.DataGrid}">
                                                    <Setter Property="FontWeight" Value="{DynamicResource Weight.Bold}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProfitable}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Column="5" Text="{Binding MarginDisplay}"
                                                   HorizontalAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Typography.DataGrid}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProfitable}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state -->
                <Border Grid.Row="1" Padding="24,48">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TotalJobsAnalyzed}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE71D;" FontFamily="{DynamicResource FontFamily.Icon}" FontSize="{DynamicResource FontSize.Kpi}"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,12"/>
                        <TextBlock Text="No service data available"
                                   FontSize="{DynamicResource FontSize.H3}" FontWeight="{DynamicResource Weight.SemiBold}"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="Service profitability appears after confirming PIs with service charges."
                                   FontSize="{DynamicResource FontSize.Body}" HorizontalAlignment="Center"
                                   Margin="0,4,0,0" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════ STATUS LINE ═══════ -->
        <Border Grid.Row="3" Margin="16,12,16,16" Padding="4,0">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="{DynamicResource FontSize.Body}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextTertiaryBrush}"/>
        </Border>

        <!-- ═══════ LOADING OVERLAY ═══════ -->
        <Border Grid.RowSpan="4"
                Background="{DynamicResource SurfaceOverlayBrush}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Resources>
                <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0.5" To="1" Duration="0:0:0.8"
                                     AutoReverse="True"/>
                </Storyboard>
            </Border.Resources>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="{DynamicResource SurfacePrimaryBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="{DynamicResource Border.HairlineThickness}" CornerRadius="{DynamicResource Radius.Large}"
                        Padding="28,16">
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar IsIndeterminate="True" Width="20" Height="20"
                                     VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="Analyzing..."
                                   FontSize="{DynamicResource FontSize.Body}" FontWeight="{DynamicResource Weight.SemiBold}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
