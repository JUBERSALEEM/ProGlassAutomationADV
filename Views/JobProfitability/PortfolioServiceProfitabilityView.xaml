<!-- ═══════════════════════════════════════════════════════════════════════
     FILE: Views/JobProfitability/PortfolioServiceProfitabilityView.xaml
     MODULE: Portfolio Service Profitability (Job Profitability → Tab 2)
     
     WHAT IT IS:
       Aggregated service profitability across ALL confirmed PIs.
       Shows which services (cutting, tempering, U-insert, ASP, etc.)
       are profitable vs loss-making across the entire portfolio.
       
       Business rules applied:
       - DGU: cutting/tempering bundled in spacer charge (not shown separately)
       - SGU: cutting, tempering, polish, holes, cutouts shown separately
       - LAM: cutting, tempering, PVB, polish shown separately
       - DGU+LAM: bundled DGU services + separate LAM services
═══════════════════════════════════════════════════════════════════════ -->
<UserControl x:Class="ProGlassAutomation.Views.JobProfitability.PortfolioServiceProfitabilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1100"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="HeaderCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TableCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ModuleBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════ HEADER ═══════ -->
        <Border Grid.Row="0" Margin="16,16,16,0" Padding="16"
                Background="{DynamicResource ModuleBackgroundBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <TextBlock Text="Service Profitability — All Confirmed Jobs"
                           FontSize="{StaticResource TextTitle}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                <TextBlock Text="Which services are making money? Breaks down revenue by service type across all confirmed PIs."
                           FontSize="{StaticResource TextBody}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ═══════ SUMMARY KPIs ═══════ -->
        <Grid Grid.Row="1" Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="JOBS ANALYZED" FontSize="{StaticResource TextCaption}"
                               FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock Text="{Binding TotalJobsAnalyzed}"
                               FontSize="{StaticResource TextTitleLarge}" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="TOTAL SERVICE CHARGE" FontSize="{StaticResource TextCaption}"
                               FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock Text="{Binding TotalServiceChargeDisplay}"
                               FontSize="{StaticResource TextTitleLarge}" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="TOTAL SERVICE PROFIT" FontSize="{StaticResource TextCaption}"
                               FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock Text="{Binding TotalServiceProfitDisplay}"
                               FontSize="{StaticResource TextTitleLarge}" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="OVERALL MARGIN" FontSize="{StaticResource TextCaption}"
                               FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock Text="{Binding OverallServiceMarginDisplay}"
                               FontSize="{StaticResource TextTitleLarge}" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="8" Background="{DynamicResource ModuleBackgroundBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="BEST PERFORMER" FontSize="{StaticResource TextCaption}"
                               FontWeight="Bold" Foreground="{DynamicResource MutedForegroundBrush}"/>
                    <TextBlock Text="{Binding BestPerformingService}"
                               FontSize="{StaticResource TextBodyLarge}" FontWeight="Bold"
                               Foreground="{DynamicResource SuccessBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════ SERVICE BREAKDOWN TABLE ═══════ -->
        <Border Grid.Row="2" Margin="16,12,16,0"
                Background="{DynamicResource ModuleBackgroundBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Table Header -->
                <Border Grid.Row="0" Background="{DynamicResource AccentBrush}"
                        CornerRadius="8,8,0,0" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="SERVICE" Style="{StaticResource HeaderCellStyle}"/>
                        <TextBlock Grid.Column="1" Text="JOBS" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="CHARGE" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="COST" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="PROFIT" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="5" Text="MARGIN %" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- Table Rows -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              behaviors:SmoothScrollBehavior.IsEnabled="True">
                    <ItemsControl ItemsSource="{Binding ServiceBreakdown}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource OutlineBrush}"
                                        BorderThickness="0,0,0,1" Padding="16,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding ServiceName}"
                                                   Style="{StaticResource TableCellStyle}" FontWeight="SemiBold"/>

                                        <TextBlock Grid.Column="1" Text="{Binding JobCount}"
                                                   Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right"/>

                                        <TextBlock Grid.Column="2" Text="{Binding TotalChargeDisplay}"
                                                   Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right"/>

                                        <TextBlock Grid.Column="3" Text="{Binding TotalCostDisplay}"
                                                   Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                                        <TextBlock Grid.Column="4" Text="{Binding TotalProfitDisplay}"
                                                   HorizontalAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TableCellStyle}">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProfitable}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Column="5" Text="{Binding MarginDisplay}"
                                                   HorizontalAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TableCellStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProfitable}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state -->
                <Border Grid.Row="1" Padding="24,48">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TotalJobsAnalyzed}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,12"/>
                        <TextBlock Text="No service data available"
                                   FontSize="{StaticResource TextSection}" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="Service profitability appears after confirming PIs with service charges."
                                   FontSize="{StaticResource TextBody}" HorizontalAlignment="Center"
                                   Margin="0,4,0,0" Foreground="{DynamicResource MutedForegroundBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════ STATUS LINE ═══════ -->
        <Border Grid.Row="3" Margin="16,12,16,16" Padding="4,0">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="{StaticResource TextBody}" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedForegroundBrush}"/>
        </Border>

        <!-- ═══════ LOADING OVERLAY ═══════ -->
        <Border Grid.RowSpan="4"
                Background="#40000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Resources>
                <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0.5" To="1" Duration="0:0:0.8"
                                     AutoReverse="True"/>
                </Storyboard>
            </Border.Resources>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="{DynamicResource ModuleBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="1" CornerRadius="12"
                        Padding="28,16">
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar IsIndeterminate="True" Width="20" Height="20"
                                     VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="Analyzing..."
                                   FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
