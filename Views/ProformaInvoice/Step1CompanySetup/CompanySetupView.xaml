<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step1CompanySetup.CompanySetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="900"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ══════════════════════════════════════════════════════════════
             FIELD LABEL — 11px SemiBold UPPERCASE muted
        ══════════════════════════════════════════════════════════════ -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,8"/>
        </Style>

        <!-- ══════════════════════════════════════════════════════════════
             NOTE: TextBox uses the GLOBAL App.xaml style
             (Height=38, CornerRadius=8, focus glow, hover indigo tint).
             This gives every wizard step identical input rendering.
             Custom DarkInputStyle removed for consistency.
        ══════════════════════════════════════════════════════════════ -->

        <!-- ══════════════════════════════════════════════════════════════
             DATEPICKER STYLE — matches global TextBox height/rendering
        ══════════════════════════════════════════════════════════════ -->
        <Style x:Key="StepDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Background"               Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground"               Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Padding"                  Value="10,0"/>
            <Setter Property="Height"                   Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#6366F1"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush"     Value="#4338CA"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ══════════════════════════════════════════════════════════════
             COMBOBOX STYLE — matches global input rendering
        ══════════════════════════════════════════════════════════════ -->
        <Style x:Key="StepComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background"               Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground"               Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Padding"                  Value="12,0"/>
            <Setter Property="Height"                   Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#6366F1"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush"     Value="#4338CA"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ══════════════════════════════════════════════════════════════
             PROFILE CARD — hover feedback (border indigo + subtle tint)
        ══════════════════════════════════════════════════════════════ -->
        <Style x:Key="ProfileCardStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource WindowBackgroundBrush}"/>
            <Setter Property="CornerRadius"    Value="14"/>
            <Setter Property="Padding"         Value="18,16"/>
            <Setter Property="Margin"          Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#4338CA"/>
                    <Setter Property="Background"  Value="{DynamicResource ModuleBackgroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24,20,32,20">
        <StackPanel>

            <!-- ══════════════════════════════════════════════════════════
                 STEP HEADER — icon badge + title + subtitle
            ══════════════════════════════════════════════════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <!-- Icon badge — 44×44 indigo with subtle glow -->
                <Border Background="#4338CA"
                        Width="44" Height="44"
                        CornerRadius="12"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12"
                                          ShadowDepth="2"
                                          Direction="270"
                                          Color="#4338CA"
                                          Opacity="0.30"/>
                    </Border.Effect>
                    <!-- Segoe MDL2 corporate icon -->
                    <TextBlock Text="&#xE821;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Company &amp; Identification Setup"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="Configure your company identity, tax registration and record numbers."
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <!-- Divider -->
            <Border Background="{DynamicResource BorderBrush}"
                    Height="1"
                    Margin="0,20,0,24"/>

            <!-- ══════════════════════════════════════════════════════════
                 FAST SETUP CARD — profile presets grid + go-to-grid CTA
            ══════════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    CornerRadius="16"
                    Padding="24"
                    Margin="0,0,0,24"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}">
                <StackPanel>

                    <!-- Section title -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <!-- Segoe MDL2 lightning bolt icon -->
                        <Border Background="#EEF2FF"
                                Width="28" Height="28"
                                CornerRadius="8"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                            <TextBlock Text="&#xE945;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="#4338CA"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Fast Setup"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                            <TextBlock Text="Use pre-saved company &amp; project profiles"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Profile cards grid -->
                    <ItemsControl ItemsSource="{Binding SavedProfiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" Rows="0"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ProfileCardStyle}">
                                    <StackPanel>

                                        <!-- Company name -->
                                        <TextBlock Text="{Binding CompanyName}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6"/>

                                        <!-- Project info -->
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,14">
                                            <Run Text="Project: "/>
                                            <Run Text="{Binding ProjectName}"/>
                                        </TextBlock>

                                        <!-- Load profile button — amber accent -->
                                        <Button Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Cursor="Hand"
                                                HorizontalAlignment="Left"
                                                Command="{Binding DataContext.LoadProfileCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="LoadBg"
                                                            Background="#FEF3C7"
                                                            CornerRadius="8"
                                                            Padding="12,7"
                                                            SnapsToDevicePixels="True">
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock x:Name="LoadIcon"
                                                                       Text="&#xE945;"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="11"
                                                                       Foreground="#B45309"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,6,0"/>
                                                            <TextBlock x:Name="LoadText"
                                                                       Text="LOAD PROFILE"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="#B45309"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="LoadBg"   Property="Background" Value="#B45309"/>
                                                            <Setter TargetName="LoadIcon" Property="Foreground" Value="White"/>
                                                            <Setter TargetName="LoadText" Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="LoadBg" Property="Background" Value="#92400E"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Go directly to grid CTA — hero pill -->
                    <Button HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand"
                            Margin="0,20,0,0"
                            Command="{Binding GoToGridCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="GoBorder"
                                        Background="#4338CA"
                                        CornerRadius="22"
                                        Padding="24,0"
                                        Height="44"
                                        SnapsToDevicePixels="True">
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="GO DIRECTLY TO GRID (STEP 5)"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="&#xE76C;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="GoBorder" Property="Background" Value="#6366F1"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="GoBorder" Property="Background" Value="#3730A3"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 COMPANY FIELDS
            ══════════════════════════════════════════════════════════ -->

            <!-- Row 1: Company Name + TRN -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="COMPANY REGISTERED NAME"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="COMPANY FEDERAL TRN"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding CompanyTrn, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>

            <!-- Row 2: HQ Location -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="COMPANY HEADQUARTERS LOCATION"
                           Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Text="{Binding CompanyLocation, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <!-- ══════════════════════════════════════════════════════════
                 LOADED PROFILE SUCCESS INDICATOR — deep forest green
            ══════════════════════════════════════════════════════════ -->
            <Border CornerRadius="10"
                    Padding="14,10"
                    Margin="0,0,0,20"
                    HorizontalAlignment="Left">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Background" Value="#D1FAE5"/>
                        <Setter Property="BorderBrush" Value="#047857"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasLoadedProfile}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <!-- Segoe MDL2 checkmark -->
                    <Border Background="#047857"
                            Width="20" Height="20"
                            CornerRadius="10"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                        <TextBlock Text="&#xE73E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock FontSize="12"
                               Foreground="#047857"
                               VerticalAlignment="Center">
                        <Run Text="Profile loaded: "/>
                        <Run Text="{Binding LoadedProfileName}" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 PROFORMA FIELDS — 4 columns
            ══════════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="PROFORMA ID"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding ProformaId, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="ISSUE DATE"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <DatePicker SelectedDate="{Binding IssueDate}"
                                Style="{StaticResource StepDatePickerStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="VALID UNTIL"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <DatePicker SelectedDate="{Binding ValidUntil}"
                                Style="{StaticResource StepDatePickerStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <TextBlock Text="PROFORMA STATUS"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding ProformaStatus}"
                              Style="{StaticResource StepComboBoxStyle}"/>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>