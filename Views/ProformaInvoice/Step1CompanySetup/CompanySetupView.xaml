<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step1CompanySetup.CompanySetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,10,0">
        <StackPanel>

            <!-- ============ HEADER ============ -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,8">

                <!-- Icon -->
                <Border Background="{DynamicResource AccentBrush}"
                        Width="36" Height="36"
                        CornerRadius="8"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#127970;"
                               FontSize="18"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Title -->
                <TextBlock Text="COMPANY &amp; IDENTIFICATION SETUP"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"/>
            </StackPanel>

            <!-- Subtitle -->
            <TextBlock Text="Configure your company identity, tax registration, and record numbers."
                       FontSize="13"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       Margin="0,0,0,20"
                       TextWrapping="Wrap"/>

            <!-- Divider -->
            <Border Background="{DynamicResource MenuHoverBrush}"
                    Height="1"
                    Margin="0,0,0,24"/>

            <!-- ============ BODY (placeholder for now) ============ -->
            <Border Background="{DynamicResource MenuHoverBrush}"
                    CornerRadius="8"
                    Padding="20,14"
                    HorizontalAlignment="Left">
                <TextBlock Text="✓ Header complete — Fast Setup profile cards coming next"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>