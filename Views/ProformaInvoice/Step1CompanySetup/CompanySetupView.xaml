<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step1CompanySetup.CompanySetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             FontFamily="Segoe UI">

    <!-- ============ SHARED STYLES ============ -->
    <UserControl.Resources>

        <!-- Field Label Style -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Dark Input TextBox Style -->
        <Style x:Key="DarkInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SideMenuBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="Transparent">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush"
                                        Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,10,0">
        <StackPanel>

            <!-- ============ HEADER ============ -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,8">

                <!-- Icon -->
                <Border Background="{DynamicResource AccentBrush}"
                        Width="36" Height="36"
                        CornerRadius="8"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#127970;"
                               FontSize="18"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Title -->
                <TextBlock Text="COMPANY &amp; IDENTIFICATION SETUP"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"/>
            </StackPanel>

            <!-- Subtitle -->
            <TextBlock Text="Configure your company identity, tax registration, and record numbers."
                       FontSize="13"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       Margin="0,0,0,20"
                       TextWrapping="Wrap"/>

            <!-- Divider -->
            <Border Background="{DynamicResource MenuHoverBrush}"
                    Height="1"
                    Margin="0,0,0,24"/>

            <!-- ============ COMPANY FIELDS ============ -->

            <!-- Row 1: Company Name + TRN (side by side) -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Company Registered Name -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="COMPANY REGISTERED NAME"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkInputStyle}"/>
                </StackPanel>

                <!-- Company Federal TRN -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="COMPANY FEDERAL TRN"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding CompanyTrn, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkInputStyle}"/>
                </StackPanel>
            </Grid>

            <!-- Row 2: Company Headquarters Location (full width) -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="COMPANY HEADQUARTERS LOCATION"
                           Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Text="{Binding CompanyLocation, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DarkInputStyle}"/>
            </StackPanel>

            <!-- ============ BODY PLACEHOLDER ============ -->
            <Border Background="{DynamicResource MenuHoverBrush}"
                    CornerRadius="8"
                    Padding="20,14"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left">
                <TextBlock Text="✓ Company fields complete — Proforma fields (ID, dates, status) coming next"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>