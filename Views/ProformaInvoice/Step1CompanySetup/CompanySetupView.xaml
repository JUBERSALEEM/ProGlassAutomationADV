<!--
═══════════════════════════════════════════════════════════════════════
FILE: Views/ProformaInvoice/Step1CompanySetup/CompanySetupView.xaml
═══════════════════════════════════════════════════════════════════════
CHAT 15 — DEFINITIVE FIX
  Style-set-twice on TextBlock inline warnings:
    REMOVED: Style="{StaticResource InlineWarningStyle}" attribute
    KEPT:    <TextBlock.Style><Style BasedOn="..."> only
    Each TextBlock now has Style set exactly ONCE.
  All other content identical to previous delivery.

CHAT 17 — UI POLISH
  UI-01: Fast Setup section card has indigo top stripe added.
  UI-02: Section header icon block changed to solid #4338CA / white.
  UI-03: Empty state icon circle changed to solid #4338CA / white.
  All bindings, styles, triggers, comments preserved exactly.
═══════════════════════════════════════════════════════════════════════
-->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step1CompanySetup.CompanySetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="900"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock"
               BasedOn="{StaticResource ModuleFieldLabelStyle}"/>

        <!--
            InlineWarningStyle — used via BasedOn ONLY.
            Never applied as Style= attribute directly on any element.
            Setting Style= attribute AND <Element.Style> simultaneously
            causes MC3024 "property already set" compile error.
        -->
        <Style x:Key="InlineWarningStyle" TargetType="TextBlock"
               BasedOn="{StaticResource ModuleInlineWarningStyle}"/>

        <Style x:Key="StepDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Background"               Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground"               Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Padding"                  Value="10,0"/>
            <Setter Property="Height"                   Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush"     Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StepComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background"               Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground"               Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Padding"                  Value="12,0"/>
            <Setter Property="Height"                   Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush"     Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProfileCardStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource WindowBackgroundBrush}"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="18,16"/>
            <Setter Property="Margin"          Value="0,0,8,8"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Background"  Value="{DynamicResource TintIndigoBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UsageBadgeStyle" TargetType="Border">
            <Setter Property="Background"   Value="{DynamicResource TintIndigoBrush}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Padding"      Value="6,3"/>
        </Style>

        <!--
            ViewAllLinkStyle — used via BasedOn inside Button.Style only.
            Never assigned as Style= attribute.
        -->
        <Style x:Key="ViewAllLinkStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="LinkText"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextDecorations="Underline">
                            <ContentPresenter/>
                        </TextBlock>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkText"
                                        Property="Foreground"
                                        Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="16,12,16,16">
        <StackPanel>

            <!-- ══ STEP HEADER ══ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Style="{StaticResource ModuleWizardStepIconStyle}">
                    <TextBlock Text="&#xE821;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Company &amp; Identification Setup"
                               Style="{StaticResource ModulePageTitleStyle}"/>
                    <TextBlock Text="Configure your company identity, tax registration and record numbers."
                               Style="{StaticResource ModulePageSubtitleStyle}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <Border Background="{DynamicResource BorderBrush}"
                    Height="1"
                    Margin="0,10,0,14"/>

            <!-- ══ FAST SETUP SECTION ══ -->
            <!--
                UI-01: Added indigo top stripe to Fast Setup card.
                Consistent with Sales Report filter cards.
            -->
            <Border Margin="0,0,0,24"
                    BorderThickness="{DynamicResource CardBorderThickness}"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Indigo top stripe -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="12,12,0,0"/>

                    <!-- Card body -->
                    <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="{DynamicResource CardBorderThickness}" CornerRadius="{DynamicResource CardCornerRadius}" Grid.Row="1"
                            Background="{DynamicResource ModuleBackgroundBrush}"
                            Padding="16,14,16,16">
                        <StackPanel>

                            <!-- Section header -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal">
                                    <!--
                                        UI-02: Icon block changed to solid #4338CA
                                        with white icon for richer visual impact.
                                    -->
                                    <Border Background="{DynamicResource AccentBrush}"
                                            Width="28"
                                            Height="28"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="&#xE945;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Saved Companies"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                        <TextBlock Text="Click a card to auto-fill company details"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Command="{Binding RefreshCardsCommand}"
                                        ToolTip="Refresh saved companies from database"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        VerticalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="RefreshBg"
                                                    Background="Transparent"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                                    Padding="8,6">
                                                <TextBlock Text="&#xE72C;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RefreshBg"
                                                            Property="Background"
                                                            Value="{DynamicResource TintIndigoBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- LOADING STATE -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,8,0,16"
                                        HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoadingCards}"
                                                         Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Width="18"
                                        Height="18"
                                        CornerRadius="{DynamicResource CardCornerRadius}"
                                        BorderThickness="2"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <Border.RenderTransform>
                                        <RotateTransform x:Name="SpinTransform"
                                                         CenterX="9"
                                                         CenterY="9"/>
                                    </Border.RenderTransform>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetName="SpinTransform"
                                                        Storyboard.TargetProperty="Angle"
                                                        From="0"
                                                        To="360"
                                                        Duration="0:0:1"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                                <TextBlock Text="Loading saved companies…"
                                           FontSize="13"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- ERROR STATE -->
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border"
                                           BasedOn="{StaticResource ModuleErrorBannerStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Padding" Value="14,10"/>
                                        <Setter Property="Margin" Value="0,0,0,12"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCardsError}"
                                                         Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE783;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="{DynamicResource DangerBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding CardsErrorMessage}"
                                               FontSize="12"
                                               Foreground="{DynamicResource DangerBrush}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- EMPTY STATE -->
                            <Border CornerRadius="{DynamicResource CardCornerRadius}"
                                    Padding="24,20"
                                    Margin="0,0,0,8"
                                    Background="{DynamicResource WindowBackgroundBrush}"
                                    BorderBrush="{DynamicResource OutlineBrush}"
                                    BorderThickness="{DynamicResource CardBorderThickness}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNoSavedCompanies}"
                                                         Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <!--
                                        UI-03: Empty state icon circle
                                        changed to solid #4338CA with white icon.
                                    -->
                                    <Border Width="40"
                                            Height="40"
                                            CornerRadius="{DynamicResource CardCornerRadius}"
                                            Background="{DynamicResource AccentBrush}"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,8">
                                        <TextBlock Text="&#xE821;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="26"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="No saved companies yet"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Save your first invoice to build your company profile library."
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- COMPANY CARDS GRID -->
                            <ItemsControl ItemsSource="{Binding SavedProfiles}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoadingCards}"
                                                         Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasNoSavedCompanies}"
                                                         Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ProfileCardStyle}"
                                                ToolTip="Click to auto-fill company details">
                                            <Border.InputBindings>
                                                <MouseBinding
                                                    MouseAction="LeftClick"
                                                    Command="{Binding DataContext.LoadProfileCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding CompanyName}"
                                                               FontSize="14"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Top"/>
                                                    <Border Grid.Column="1"
                                                            Style="{StaticResource UsageBadgeStyle}"
                                                            VerticalAlignment="Top"
                                                            Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding UsageBadgeText}"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource AccentBrush}"/>
                                                    </Border>
                                                </Grid>

                                                <StackPanel Grid.Row="1">
                                                    <StackPanel Orientation="Horizontal"
                                                                Margin="0,0,0,4">
                                                        <TextBlock Text="&#xE8EC;"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding TrnMasked}"
                                                                   FontSize="11"
                                                                   FontFamily="Consolas"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal"
                                                                Margin="0,0,0,12">
                                                        <TextBlock Text="&#xE707;"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding Location}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Row="2"
                                                            Orientation="Horizontal">
                                                    <TextBlock Text="&#xE72D;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,5,0"/>
                                                    <TextBlock Text="Click to load"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- VIEW ALL — Style set via Button.Style BasedOn only. No Style= attribute. -->
                            <Button HorizontalAlignment="Left"
                                    Margin="4,8,0,0"
                                    Command="{Binding ShowAllCompaniesCommand}"
                                    ToolTip="Show all saved company profiles">
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource ViewAllLinkStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMoreCompanies}"
                                                         Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           TextDecorations="Underline">
                                    <Run Text="View all ("/>
                                    <Run Text="{Binding TotalCompanyCount, Mode=OneWay}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                            </Button>

                            <!-- Go directly to grid -->
                            <Button HorizontalAlignment="Right"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="0,20,0,0"
                                    ToolTip="Skip to the glass data grid — Step 5"
                                    Command="{Binding GoToGridCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="GoBorder"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="{DynamicResource CardCornerRadius}"
                                                Padding="16,0"
                                                Height="34">
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="SKIP TO GRID"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="&#xE76C;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="11"
                                                           Foreground="White"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="GoBorder"
                                                        Property="Background"
                                                        Value="{DynamicResource AccentHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="GoBorder"
                                                        Property="Background"
                                                        Value="{DynamicResource AccentDarkBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ══ LOADED PROFILE INDICATOR ══ -->
            <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                    Padding="14,10"
                    Margin="0,0,0,20"
                    HorizontalAlignment="Left">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility"      Value="Collapsed"/>
                        <Setter Property="Background"      Value="{DynamicResource TintGreenBrush}"/>
                        <Setter Property="BorderBrush"     Value="{DynamicResource SuccessBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasLoadedProfile}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Border Background="{DynamicResource SuccessBrush}"
                            Width="20"
                            Height="20"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                        <TextBlock Text="&#xE73E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource SuccessBrush}"
                               VerticalAlignment="Center">
                        <Run Text="Profile loaded: "/>
                        <Run Text="{Binding LoadedProfileName}" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ══ COMPANY FIELDS ══ -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Company Name -->
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               ToolTip="Your company's official registered trade name">
                        <Run Text="COMPANY REGISTERED NAME"/>
                        <Run Text=" *" Foreground="{DynamicResource DangerBrush}"/>
                    </TextBlock>
                    <TextBox Text="{Binding CompanyName,
                                 UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Enter your company's full legal registered name"
                             AutomationProperties.AutomationId="ProformaInvoice.CompanyName"
                             AutomationProperties.Name="Company registered name"/>
                    <!--
                        FIXED: Style set via TextBlock.Style BasedOn only.
                        No Style= attribute on the TextBlock element.
                    -->
                    <TextBlock Text="{Binding CompanyNameValidationMessage}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource InlineWarningStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCompanyNameError}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Company TRN -->
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               ToolTip="15-digit UAE Federal Tax Authority registration number">
                        <Run Text="COMPANY FEDERAL TRN"/>
                    </TextBlock>
                    <TextBox Text="{Binding CompanyTrn,
                                 UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Enter your 15-digit UAE TRN (digits only)"
                             MaxLength="15"/>
                    <!--
                        FIXED: Style set via TextBlock.Style BasedOn only.
                    -->
                    <TextBlock Text="{Binding TrnValidationMessage}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource InlineWarningStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTrnValid}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <Border Height="12"/>

            <!-- HQ Location -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Style="{StaticResource FieldLabelStyle}"
                           ToolTip="Headquarters city and country, e.g. Dubai, UAE">
                    <Run Text="COMPANY HEADQUARTERS LOCATION"/>
                </TextBlock>
                <TextBox Text="{Binding CompanyLocation,
                             UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="e.g. Dubai, UAE"/>
            </StackPanel>

            <!-- ══ PROFORMA FIELDS ══ -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Proforma ID -->
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               ToolTip="Auto-generated unique reference. You can edit if needed">
                        <Run Text="PROFORMA ID"/>
                        <Run Text=" *" Foreground="{DynamicResource DangerBrush}"/>
                    </TextBlock>
                    <TextBox Text="{Binding ProformaId,
                                 UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas"
                             ToolTip="Unique proforma invoice reference number"/>
                    <!--
                        FIXED: Style set via TextBlock.Style BasedOn only.
                    -->
                    <TextBlock Text="{Binding ProformaIdValidationMessage}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource InlineWarningStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasProformaIdError}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Issue Date -->
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               ToolTip="Date this quotation was prepared">
                        <Run Text="ISSUE DATE"/>
                    </TextBlock>
                    <DatePicker SelectedDate="{Binding IssueDate}"
                                Style="{StaticResource StepDatePickerStyle}"
                                ToolTip="Select the date this proforma was prepared"/>
                </StackPanel>

                <!-- Valid Until -->
                <StackPanel Grid.Column="4">
                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               ToolTip="Last date this quotation is valid for acceptance">
                        <Run Text="VALID UNTIL"/>
                    </TextBlock>
                    <DatePicker SelectedDate="{Binding ValidUntil}"
                                Style="{StaticResource StepDatePickerStyle}"
                                ToolTip="Select the proforma expiry date"/>
                </StackPanel>

                <!-- Proforma Status -->
                <StackPanel Grid.Column="6">
                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                               ToolTip="Current status — changes what appears on printed PDF">
                        <Run Text="PROFORMA STATUS"/>
                    </TextBlock>
                    <ComboBox ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding ProformaStatus}"
                              Style="{StaticResource StepComboBoxStyle}"
                              ToolTip="Select the current proforma status"/>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>