<!-- Step 1 — flat industrial form. No cards. -->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step1CompanySetup.CompanySetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="34"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource PiStationIdentityStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="01" Style="{StaticResource PiStationCodeStyle}"/>
                        <TextBlock Grid.Column="1" Text="COMPANY" Style="{StaticResource PiStationTitleStyle}"/>
                        <TextBlock Grid.Column="2" Text="Letterhead, TRN and bank details for this quotation"
                                   Style="{StaticResource PiStationHintStyle}"/>
                        <Button Grid.Column="3" Command="{Binding GoToGridCommand}"
                                Style="{StaticResource PiViewAllLinkStyle}" ToolTip="Skip to the glass data grid — Step 5">
                            <TextBlock Text="Skip to grid" TextDecorations="Underline"/>
                        </Button>
                    </Grid>
                </Border>
                <TextBlock Text="IDENTITY" Style="{StaticResource PiSectionLabelStyle}"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/><ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PiFieldLabelStyle}">
                            <Run Text="REGISTERED NAME"/><Run Text=" *" Foreground="{DynamicResource DangerBrush}"/>
                        </TextBlock>
                        <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="ProformaInvoice.CompanyName"
                                 AutomationProperties.Name="Company registered name"/>
                        <TextBlock Text="{Binding CompanyNameValidationMessage}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ModuleInlineWarningStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCompanyNameError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="FEDERAL TRN" Style="{StaticResource PiFieldLabelStyle}"/>
                        <TextBox Text="{Binding CompanyTrn, UpdateSourceTrigger=PropertyChanged}" MaxLength="15"/>
                        <TextBlock Text="{Binding TrnValidationMessage}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ModuleInlineWarningStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTrnValid}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="HEADQUARTERS" Style="{StaticResource PiFieldLabelStyle}"/>
                        <TextBox Text="{Binding CompanyLocation, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="REPRESENTATIVE" Style="{StaticResource PiFieldLabelStyle}"/>
                        <TextBox Text="{Binding Representative, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="MOBILE" Style="{StaticResource PiFieldLabelStyle}"/>
                        <TextBox Text="{Binding RepresentativeMobile, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="EMAIL" Style="{StaticResource PiFieldLabelStyle}"/>
                        <TextBox Text="{Binding CompanyEmail, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="BANK" Style="{StaticResource PiFieldLabelStyle}"/>
                        <TextBox Text="{Binding BankName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ACCOUNT / IBAN" Style="{StaticResource PiFieldLabelStyle}"/>
                        <TextBox Text="{Binding AccountNumber, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,14"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/><ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PiFieldLabelStyle}">
                            <Run Text="PROFORMA ID"/><Run Text=" *" Foreground="{DynamicResource DangerBrush}"/>
                        </TextBlock>
                        <TextBox Text="{Binding ProformaId, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
                        <TextBlock Text="{Binding ProformaIdValidationMessage}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ModuleInlineWarningStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasProformaIdError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ISSUE DATE" Style="{StaticResource PiFieldLabelStyle}"/>
                        <DatePicker SelectedDate="{Binding IssueDate}" Style="{StaticResource PiDatePickerStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="VALID UNTIL" Style="{StaticResource PiFieldLabelStyle}"/>
                        <DatePicker SelectedDate="{Binding ValidUntil}" Style="{StaticResource PiDatePickerStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="STATUS" Style="{StaticResource PiFieldLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding ProformaStatus}" Style="{StaticResource PiComboBoxStyle}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Margin="0,12,0,0" FontSize="12" Foreground="{DynamicResource SuccessBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLoadedProfile}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="Loaded: "/><Run Text="{Binding LoadedProfileName}" FontWeight="Bold"/>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerBrush}" HorizontalAlignment="Center"/>

        <DockPanel Grid.Column="2">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="SAVED" Style="{StaticResource PiSectionLabelStyle}" Margin="0" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" Command="{Binding RefreshCardsCommand}"
                        Style="{StaticResource PiIconButtonStyle}" ToolTip="Refresh saved companies from database">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </Button>
            </Grid>
            <TextBlock DockPanel.Dock="Top" Text="Loading…" FontSize="12"
                       Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoadingCards}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock DockPanel.Dock="Top" Text="{Binding CardsErrorMessage}" FontSize="12"
                       Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasCardsError}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock DockPanel.Dock="Top" Text="No saved companies yet."
                       FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNoSavedCompanies}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Command="{Binding ShowAllCompaniesCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PiViewAllLinkStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasMoreCompanies}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" TextDecorations="Underline">
                    <Run Text="View all ("/><Run Text="{Binding TotalCompanyCount, Mode=OneWay}"/><Run Text=")"/>
                </TextBlock>
            </Button>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SavedProfiles}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoadingCards}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasNoSavedCompanies}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PiListRowStyle}" ToolTip="Click to auto-fill company details">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.LoadProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding CompanyName}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding TrnMasked}" FontSize="11"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding UsageBadgeText}" FontSize="10"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
