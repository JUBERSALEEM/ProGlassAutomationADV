<!--
    Step 9 — P&amp;L. Approved mockup:
    one workbench, KPI strip, always-visible build-order layers, rate-check row.
    Bindings and calculations unchanged.
-->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step9ProfitLoss.ProfitLossStepView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:local="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step9ProfitLoss"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1100"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

        <UserControl.Resources>
        <!-- Migrated PlInputStyle to global SurfacePrimaryStyle -->
    </UserControl.Resources>


    <TabControl Margin="0" Style="{StaticResource PillTabControlStyle}">
        <!-- TAB 1: TARGET PROFITABILITY (approved KPI) -->
        <TabItem Style="{StaticResource PillTabItemStyle}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextBody}"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="1 · OVERVIEW" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          PanningMode="VerticalOnly"
                          behaviors:SmoothScrollBehavior.IsEnabled="True">
                <Border Padding="0">
                    <StackPanel>

                <Border Style="{StaticResource PiStationIdentityStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="09"/>
                            <TextBlock Text="{DynamicResource ProformaInvoice.ProfitLOSS}"/>
                            <TextBlock Text="Read top to bottom: decision first, totals second, details last"
                                      />
                        </StackPanel>
                        <!-- Export toolbar for the cost breakdown (P&L lines) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button Content="CSV" Command="{Binding ExportOverviewCsvCommand}"
                                    Style="{StaticResource TgtExportButton}"
                                    ToolTip="Export the full Step 9 overview, target summary and cost audit as CSV."/>
                            <Button Content="EXCEL" Command="{Binding ExportOverviewExcelCommand}"
                                    Style="{StaticResource TgtExportButton}"
                                    ToolTip="Export the full Step 9 overview, target summary and cost audit as Excel."/>
                            <Button Content="PDF" Command="{Binding ExportOverviewPdfCommand}"
                                    Style="{StaticResource TgtExportButton}"
                                    ToolTip="Export the full Step 9 overview, target summary and cost audit as PDF."/>
                            <Button Content="{DynamicResource Sharing.Share}" Command="{Binding ShareOverviewCommand}"
                                    Style="{StaticResource TgtExportButton}"
                                    ToolTip="Share the full Step 9 overview via the Sharing Center."/>
                        </StackPanel>
                    </Grid>
                </Border>



                <!-- Simple reading map: keep the business answer first and the audit trail after it. -->
                <Border Style="{StaticResource TgtCardStyle}" Margin="0,0,0,10" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="1 · DECISION"/>
                            <TextBlock Text="Is given price above target?" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="2 · MONEY"/>
                            <TextBlock Text="Revenue, glass cost and margin." TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="14,0,0,0">
                            <TextBlock Text="3 · SPEC CHECK"/>
                            <TextBlock Text="Each Step 5 spec stays separate." TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="14,0,0,0">
                            <TextBlock Text="4 · EXTRA DETAIL"/>
                            <TextBlock Text="Formulas, rows and exports after the answer." TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Controls: one compact settings row — WASTAGE %,
                     costing basis and the live calculation state. Each option
                     is a labelled, same-height control so nothing drifts onto
                     a second row. No manual Recalculate button: every edit in
                     Steps 4/5/6/7 auto-queues a recalculation. -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Wastage % -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource ProformaInvoice.Wastage2}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding WastagePercent,
                                                    Converter={StaticResource DecimalTypingConverter},
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                     Style="{StaticResource SurfacePrimaryStyle}"
                                     Width="84"
                                     ToolTip="{DynamicResource ProformaInvoice.CuttingAllowanceAddedRequiredAreaBefore}"/>
                            <TextBlock Text="%"
                                       FontSize="{StaticResource TextBodyLarge}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Costing basis -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Cost basis"
                                  />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                            <ToggleButton Style="{StaticResource PiToggleSwitch}"
                                          IsChecked="{Binding CostAtSellingPrice}"
                                          ToolTip="{DynamicResource ProformaInvoice.SheetStorePurchasePriceSellingPriceMatching}"
                                          AutomationProperties.Name="Cost glass at selling price"/>
                            <TextBlock Text="{DynamicResource ProformaInvoice.CostGlassSellingPrice}"
                                       FontSize="{StaticResource TextBodyLarge}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Live calculation state -->
                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Margin="16,0,0,2">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding CalculationStateLabel}"
                                       FontSize="{StaticResource TextCaption}" FontWeight="{DynamicResource Weight.Bold}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecalculationPending}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasCalculationWarnings}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding LastCalculatedAtDisplay}"
                                       FontSize="{StaticResource TextCaption}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Step9MaintenanceRating}"
                                   FontSize="{StaticResource TextCaption}"
                                   FontWeight="{DynamicResource Weight.Bold}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,2,0,0"
                                   ToolTip="{Binding Step9ImprovementSummary}"/>
                        <TextBlock Text="{Binding Step9ImprovementSummary}"
                                   FontSize="{StaticResource TextCaption}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Right"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>
                        <TextBlock Text="WASTAGE % also sets the formula yield (15% → ÷0.85) for the target below"
                                   FontSize="{StaticResource TextCaption}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Right"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="MAIN DECISION — TARGET, EXPECTED MARGIN, RESULT" Margin="0,4,0,8"/>
                <!-- Main answer first: target price, expected margin, and red/green decision. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="25*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="25*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CARD 1 — REQUIRED TARGET PRICE -->
                    <Border Grid.Column="0">
                        <StackPanel>
                            <TextBlock Text="REQUIRED TARGET PRICE"/>
                            <TextBlock Text="{Binding RequiredTargetPriceDisplay}"
                                       FontSize="{StaticResource TextDisplay}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,2,0,10"/>
                            <Border Height="1" Background="{DynamicResource BorderDefaultBrush}" Margin="0,0,0,10"/>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ExpectedProfitMarginFactorLabel, StringFormat='Specification target {0}'}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SpecificationTargetAverageDisplay}"
                                              />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Base price (no uplift)"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BasePriceAverageDisplay}"
                                              />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="U-insert treatment"/>
                                    <TextBlock Grid.Column="1" Text="{Binding UInsertSummaryDisplay}"
                                               ToolTip="{Binding UInsertSummaryDetail}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TgtKvValueStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasUInsertSummaryWarning}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Basis"/>
                                    <TextBlock Grid.Column="1" Text="Area-weighted across specifications"
                                              
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2 — EXPECTED PROFIT MARGIN (middle card).
                         Shows the default profit margin (15% → ×1.15) that the
                         required-target formula adds on top of the cost basis.
                         Settings → Features → Proforma Invoice → Step 9 owns
                         the company default; an invoice can pin its own value
                         (captured at creation) via the view-model. -->
                    <Border Grid.Column="2">
                        <StackPanel>
                            <TextBlock Text="EXPECTED PROFIT MARGIN"/>
                            <TextBlock Text="{Binding ExpectedProfitMarginDisplay}"
                                       FontSize="{StaticResource TextDisplay}" FontWeight="{DynamicResource Weight.Bold}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,2,0,10"/>
                            <Border Height="1" Background="{DynamicResource BorderDefaultBrush}" Margin="0,0,0,10"/>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Uplift applied to cost basis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ExpectedProfitMarginFactorLabel}"
                                              />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Source"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ExpectedProfitMarginSourceLabel}"
                                              
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CARD 3 — MARGIN AGAINST TARGET -->
                    <Border Grid.Column="4">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource TgtCardStyle}">
                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTargetBelow}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsTargetIncomplete}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="PRICE BALANCE — BASE / TARGET" VerticalAlignment="Center"/>
                                <!-- Status pill -->
                                <Border Grid.Column="1">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource TgtPillBase}">
                                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTargetBelow}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsTargetIncomplete}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding TargetJobStatusLabel}"
                                               FontSize="{StaticResource TextCaption}" FontWeight="{DynamicResource Weight.Bold}"
                                               Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,6,0,10"
                                  ToolTip="Base margin = (given judged − base) ÷ base. Target margin = (given judged − required target) ÷ required target.">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="BASE"/>
                                    <TextBlock Text="{Binding BaseMarginPercentDisplay}"
                                               FontSize="{StaticResource TextDisplay}" FontWeight="{DynamicResource Weight.Bold}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBaseMarginBelow}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsTargetIncomplete}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TARGET"/>
                                    <TextBlock Text="{Binding TargetMarginPercentDisplay}"
                                               FontSize="{StaticResource TextDisplay}" FontWeight="{DynamicResource Weight.Bold}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTargetMarginBelow}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsTargetIncomplete}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource BorderDefaultBrush}" Margin="0,0,0,10"/>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Given price (Step 5 Base Price)" Style="{StaticResource TgtKvLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding GivenPricePerSqmDisplay}" Style="{StaticResource TgtKvValueStyle}"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource ProformaInvoice.COSTBasedProfitMargin}" Style="{StaticResource TgtKvLabelStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CostBasedProfitMarginDisplay}"
                                               Style="{StaticResource TgtKvValueStyle}"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="U-insert inside given (toggle off)" Style="{StaticResource TgtKvLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding IncludedUInsertAverageDisplay}"
                                               Style="{StaticResource TgtKvValueStyle}"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Given judged for the margin" Style="{StaticResource TgtKvLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding GivenJudgedAverageDisplay}"
                                               Style="{StaticResource TgtKvValueStyle}"
                                               FontWeight="{DynamicResource Weight.SemiBold}"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource BorderDefaultBrush}" Margin="0,10,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Margin against BASE price" Style="{StaticResource TgtKvLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BaseMarginPercentDisplay}"
                                               Style="{StaticResource TgtKvValueStyle}" FontWeight="{DynamicResource Weight.SemiBold}"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Base balance" Style="{StaticResource TgtKvLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BaseBalancePerSqmDisplay}"
                                               Style="{StaticResource TgtKvValueStyle}"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Base balance value" Style="{StaticResource TgtKvLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BaseBalanceValueDisplay}"
                                               Style="{StaticResource TgtKvValueStyle}"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Required target price (base + margin %)" Style="{StaticResource TgtKvLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RequiredTargetPriceDisplay}"
                                               Style="{StaticResource TgtKvValueStyle}"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Margin against TARGET"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TargetMarginPercentDisplay}"
                                               FontWeight="{DynamicResource Weight.SemiBold}"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Target balance"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TargetBalancePerSqmDisplay}"
                                              
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Target balance value"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TargetBalanceValueDisplay}"
                                              
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Extra audit trail: expanded by default per production review; spacing is improved so formulas remain readable. -->
                <Expander Header="EXTRA DETAIL · calculation summary and formula audit" Margin="0,14,0,0" IsExpanded="True">
                <Border Style="{StaticResource TgtCardStyle}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="CALCULATION SUMMARY"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="GIVEN PRICE SOURCE"/>
                                <TextBlock Text="{Binding GivenPriceSourceLabel}"
                                          
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SCOPE"/>
                                <TextBlock Text="{Binding TargetScopeNote}"
                                          
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="TOTAL GIVEN VALUE"/>
                                <TextBlock Text="{Binding TotalGivenValueDisplay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="TOTAL REQUIRED TARGET VALUE"/>
                                <TextBlock Text="{Binding TotalRequiredTargetValueDisplay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="8">
                                <TextBlock Text="TOTAL DIFFERENCE"/>
                                <TextBlock Text="{Binding TotalDifferenceValueDisplay}"/>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource BorderDefaultBrush}" Margin="0,12,0,10"/>
                        <TextBlock Text="SPECIFICATION FORMULAS — STEP 5 SPECS" Margin="0,2,0,8"/>
                        <Border Style="{StaticResource TgtInsetStyle}" Padding="14,12" Margin="0,0,0,8">
                            <TextBlock Text="{Binding TargetFormulaAllSpecsText}"
                                       FontFamily="Consolas" FontSize="{StaticResource TextBody}"
                                       FontWeight="{DynamicResource Weight.SemiBold}"
                                       LineHeight="22"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>
                        <TextBlock Text="{Binding CalculationWarningSummary}"
                                   FontSize="{StaticResource TextCaption}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource DangerBrush}"
                                   Visibility="{Binding HasCalculationWarnings, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding CalculationVersionLabel}"
                                   FontSize="{StaticResource TextCaption}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                </Expander>

                <TextBlock Text="Per-specification comparison rows and full spec inspector live on tab 4 · SPECS."
                           FontSize="{StaticResource TextCaption}"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           TextWrapping="Wrap" Margin="0,12,0,0"/>

                <Expander Header="EXTRA DETAIL · actual glass cost rows and rate check" Margin="0,10,0,0" IsExpanded="True">
                <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ACTUAL GLASS COST &amp; RATE CHECK — STEP 4 / STEP 6 SHEET BASIS"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Content="CSV" Command="{Binding ExportPnlCsvCommand}" Style="{StaticResource TgtExportButton}" ToolTip="Export only the actual P&amp;L cost rows as CSV."/>
