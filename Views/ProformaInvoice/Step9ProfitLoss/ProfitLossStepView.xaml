                                    Padding="0,12,0,4"
                                    Margin="0,8,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding HeaderDisplay}"
                                               FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SpecName}"
                                               FontFamily="Consolas"
                                               FontSize="{StaticResource TextBody}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding TotalCostDisplay}"
                                               FontSize="{StaticResource TextBodyLarge}" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>
                                </Grid>

                                <Border Style="{StaticResource PiTableHeaderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*" MinWidth="180"/>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource ProformaInvoice.KIND}" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="{DynamicResource Common.Description}" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="2" Text="{DynamicResource ProformaInvoice.SheetSIZE}" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="3" Text="QTY" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="4" Text="{DynamicResource Common.Price}" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="5" Text="{DynamicResource Common.Amount}" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource OutlineBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*" MinWidth="180"/>
                                                        <ColumnDefinition Width="190"/>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="110"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Kind}"
                                                               Style="{StaticResource PlCellStyle}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Description}"
                                                               Style="{StaticResource PlCellStyle}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,12,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}"
                                                               Style="{StaticResource PlCellStyle}"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding QuantityDisplay}"
                                                               Style="{StaticResource PlCellStyle}"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding PriceDisplay}"
                                                               Style="{StaticResource PlCellStyle}"
                                                               HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding AmountDisplay}"
                                                               Style="{StaticResource PlCellStyle}"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,8,0,0"
                                      Visibility="{Binding CanRateCheck, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource ProformaInvoice.CheckRATESQM}"
                                               Style="{StaticResource PiFieldLabelStyle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding QuotedRatePerSqm,
                                                    Converter={StaticResource DecimalTypingConverter},
                                                    UpdateSourceTrigger=PropertyChanged}"
                                             behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                             Style="{StaticResource PlInputStyle}"
                                             ToolTip="{DynamicResource ProformaInvoice.TypeRateIntendQuoteMarkShownBeside}"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding RateCheckDisplay}"
                                               FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="12,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsQuotedRateBelowCost}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasQuotedRate}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{DynamicResource ProformaInvoice.NoCostedLinesYetPressRecalculateOnceStep5}"
                           FontSize="{StaticResource TextBody}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Margin="0,12,0,0"
                           Visibility="{Binding HasSpecGroups, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
        </TabItem>
        <!-- TAB 2: SERVICE PROFITABILITY (Phase 1) -->
        <TabItem Style="{StaticResource PillTabItemStyle}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="SERVICE DETAIL" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          PanningMode="VerticalOnly"
                          behaviors:SmoothScrollBehavior.IsEnabled="True">
                <ContentControl Content="{Binding ServiceProfitability}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <local:ServiceProfitabilityView DataContext="{Binding}"/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </ScrollViewer>
        </TabItem>
        
        <!-- TAB 3: SHEET PROFITABILITY (Phase 2) -->
        <TabItem Style="{StaticResource PillTabItemStyle}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="SHEET DETAIL" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          PanningMode="VerticalOnly"
                          behaviors:SmoothScrollBehavior.IsEnabled="True">
                <ContentControl Content="{Binding SheetProfitability}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <local:SheetProfitabilityView DataContext="{Binding}"/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </ScrollViewer>
        </TabItem>
        
        <!-- TAB 4: GLASS / SPEC COMPARISON (per-group rows + six-section spec sidebar) -->
        <TabItem Style="{StaticResource PillTabItemStyle}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="GLASS / SPEC COMPARISON" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          PanningMode="VerticalOnly"
                          behaviors:SmoothScrollBehavior.IsEnabled="True">
                <Grid>

                    <!-- ═══ STATE 1 — COMPARISON LIST (full width; visible when no
                         specification is selected) ═══ -->
                    <StackPanel Visibility="{Binding HasSelectedTargetSpec, Converter={StaticResource InverseBoolToVisibilityConverter}}">

                        <!-- Per-group target comparison -->
                        <Grid Margin="0,18,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="PER-GROUP COMPARISON — TARGET MODEL"
                                       Style="{StaticResource TgtSectionLabel}"
                                       Margin="0"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button Content="CSV"
                                        Command="{Binding ExportTargetCsvCommand}"
                                        Style="{StaticResource TgtExportButton}"
                                        ToolTip="Export the per-spec target comparison as CSV."/>
                                <Button Content="EXCEL"
                                        Command="{Binding ExportTargetExcelCommand}"
                                        Style="{StaticResource TgtExportButton}"
                                        ToolTip="Export the per-spec target comparison as Excel."/>
                                <Button Content="PDF"
                                        Command="{Binding ExportTargetPdfCommand}"
                                        Style="{StaticResource TgtExportButton}"
                                        ToolTip="Export the per-spec target comparison as PDF."/>
                                <Button Content="GO TO STEP 6 · OTHER CHARGES"
                                        Command="{Binding GoToStep6Command}"
                                        Style="{StaticResource PrimaryPillButton}"
                                        Margin="8,0,0,0"
                                        Padding="16,0"
                                        Cursor="Hand"
                                        ToolTip="Open Step 6 (Other charges) to review U-inserts, wastage and supplementary charges."/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Each Step 5 specification is priced independently (never mixed Base Rates). Click a row to open its full calculation inspector."
                                   FontSize="{StaticResource TextCaption}"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Border Style="{StaticResource TgtCardStyle}" Padding="0"
                                Visibility="{Binding HasTargetSpecs, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Style="{StaticResource PiTableHeaderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="*" MinWidth="170"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="94"/>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="112"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="SPEC" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="GLASS / SPECIFICATION" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="2" Text="AREA" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="3" Text="GIVEN /M²" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="4" Text="SPEC TGT /M²" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="5" Text="U-INSERT" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="6" Text="FINAL TGT /M²" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="7" Text="DIFF /M²" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="8" Text="MARGIN" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="9" Text="STATUS" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left"/>
                                    </Grid>
                                </Border>

                                <ItemsControl Grid.Row="1" ItemsSource="{Binding TargetSpecsView}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource OutlineBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="0,8"
                                                    Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.SelectTargetSpecCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="54"/>
                                                        <ColumnDefinition Width="*" MinWidth="170"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="96"/>
                                                        <ColumnDefinition Width="96"/>
                                                        <ColumnDefinition Width="84"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="94"/>
                                                        <ColumnDefinition Width="86"/>
                                                        <ColumnDefinition Width="112"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10"
                                                            Background="{DynamicResource AccentBrush}"
                                                            VerticalAlignment="Center" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding SpecNumber}"
                                                                   FontSize="10" FontWeight="Bold"
                                                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="6,0,8,0">
                                                        <TextBlock Text="{Binding SpecDisplayName}"
                                                                   Style="{StaticResource PlCellStyle}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock FontSize="{StaticResource TextCaption}"
                                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding BuildTypeLabel, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" Text="{Binding AreaSqmDisplay}"
                                                               Style="{StaticResource PlCellStyle}" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding GivenPricePerSqmDisplay}"
                                                               Style="{StaticResource PlCellStyle}" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding SpecificationTargetDisplay}"
                                                               Style="{StaticResource PlCellStyle}" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding UInsertTreatmentLabel}"
                                                               Style="{StaticResource PlCellStyle}" HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                    <TextBlock Grid.Column="6" Text="{Binding FinalRequiredTargetDisplay}"
                                                               Style="{StaticResource PlCellStyle}" HorizontalAlignment="Right"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="7" Text="{Binding DifferencePerSqmDisplay}"
                                                               Style="{StaticResource PlCellStyle}" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="8" Text="{Binding MarginAgainstTargetDisplay}"
                                                               HorizontalAlignment="Right">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PlCellStyle}">
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsBelowTarget}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding HasValidMargin}" Value="False">
                                                                        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <Border Grid.Column="9" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource TgtPillBase}">
                                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsBelowTarget}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsIncomplete}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsAtTarget}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding StatusLabel}"
                                                                   FontSize="10" FontWeight="Bold"
                                                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <TextBlock Text="No specifications with measured area yet — add glass rows in Step 5 and the target figures below update automatically."
                                   FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding HasTargetSpecs, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                        <!-- Retained glass-type profitability analysis -->
                        <TextBlock Text="GLASS TYPE PROFITABILITY ANALYSIS" Style="{StaticResource TgtSectionLabel}"/>
                        <ContentControl Content="{Binding GlassTypeComparison}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <local:GlassTypeComparisonView DataContext="{Binding}"/>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </StackPanel>

                    <!-- ═══ STATE 2 — FULL-SCREEN SPEC DETAIL (visible when a
                         specification is selected; opens as the whole module
                         screen instead of a right sidebar — 2026-09-06) ═══ -->
                    <StackPanel Visibility="{Binding HasSelectedTargetSpec, Converter={StaticResource BoolToVisibilityConverter}}">

                        <!-- Toolbar: back to comparison · spec title · go to step 6 -->
                        <Grid Margin="0,18,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="← BACK TO COMPARISON"
                                    Command="{Binding BackToComparisonCommand}"
                                    Style="{StaticResource OutlinedPillButton}"
                                    VerticalAlignment="Center"
                                    Cursor="Hand"
                                    ToolTip="Return to the per-group comparison list."/>
                            <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center"
                                        DataContext="{Binding SelectedTargetSpec}">
                                <TextBlock Text="{Binding SpecNumberDisplay}"
                                           FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{Binding SpecDisplayName}"
                                           FontSize="{StaticResource TextBodyLarge}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Content="GO TO STEP 6 · OTHER CHARGES"
                                    Command="{Binding GoToStep6Command}"
                                    Style="{StaticResource PrimaryPillButton}"
                                    VerticalAlignment="Center"
                                    Padding="16,0"
                                    Cursor="Hand"
                                    ToolTip="Open Step 6 (Other charges) to review U-inserts, wastage and supplementary charges."/>
                        </Grid>

                        <!-- Full-width detail card: accent header + six sections in two columns -->
                        <Border Style="{StaticResource TgtCardStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{DynamicResource AccentBrush}"
                                        CornerRadius="14,14,0,0" Padding="18,14">
                                    <StackPanel DataContext="{Binding SelectedTargetSpec}">
                                        <TextBlock FontSize="{StaticResource TextSection}" FontWeight="Bold"
                                                   Foreground="{DynamicResource OnAccentForegroundBrush}">
                                            <Run Text="{Binding SpecNumberDisplay, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding SpecDisplayName}"
                                                   FontSize="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                   Opacity="0.9" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="1" Margin="18,8,18,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" DataContext="{Binding SelectedTargetSpec}">
                                        <!-- 1 · IDENTITY -->
                                        <TextBlock Text="1 · IDENTITY" Style="{StaticResource TgtSideHeadingStyle}" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding SpecDisplayName}"
                                                   FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   TextWrapping="Wrap"/>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Build" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding BuildTypeLabel}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding DimensionsSummary}"
                                                   FontSize="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>

                                        <!-- 2 · STEP 5 INPUT -->
                                        <TextBlock Text="2 · STEP 5 INPUT" Style="{StaticResource TgtSideHeadingStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Given price (Base Price)" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding GivenPricePerSqmDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Measured area" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding AreaSqmDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Given value" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding GivenValueDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <TextBlock Text="The Step 5 Base Price is the given selling price. It never comes from Step 4, the Step 9 calculation, the Sheet Store or a manual field here."
                                                   FontSize="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"/>

                                        <!-- 3 · TARGET FORMULA -->
                                        <TextBlock Text="3 · TARGET FORMULA" Style="{StaticResource TgtSideHeadingStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Outer glass rate" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding OuterGlassRateDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <Grid Visibility="{Binding HasSecondGlass, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Inner glass rate" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding InnerGlassRateDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <Grid Visibility="{Binding HasThirdGlass, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Third glass rate" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ThirdGlassRateDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <Grid Visibility="{Binding HasAspRate, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="ASP / spacer rate" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding AspRateDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <Grid Visibility="{Binding HasProcessingRate, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Processing add-ons" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ProcessingRateDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Yield factor" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding YieldFactorDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Target uplift" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TargetUpliftDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <Border Background="{DynamicResource ModuleBackgroundBrush}"
                                                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="10,8" Margin="0,8,0,0">
                                            <TextBlock FontFamily="Consolas" FontSize="{StaticResource TextCaption}"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       TextWrapping="Wrap" Text="{Binding FormulaText}"/>
                                        </Border>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Specification target (before U-insert)"
                                                       Style="{StaticResource TgtSideLabelStyle}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SpecificationTargetDisplay}"
                                                       Style="{StaticResource TgtSideValueStyle}" FontWeight="Bold"/>
                                        </Grid>


                                    </StackPanel>

                                    <StackPanel Grid.Column="2" DataContext="{Binding SelectedTargetSpec}">
                                        <!-- 4 · U-INSERT -->
                                        <TextBlock Text="4 · U-INSERT" Style="{StaticResource TgtSideHeadingStyle}" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Treatment" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding UInsertTreatmentLabel}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding UInsertAppliedCaption}" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding UInsertAppliedValueDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Source" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding UInsertSourceDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding UInsertTreatmentDetail}"
                                                   FontSize="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"/>

                                        <!-- 5 · RESULT -->
                                        <TextBlock Text="5 · RESULT" Style="{StaticResource TgtSideHeadingStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Final required target"
                                                       FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FinalRequiredTargetDisplay}"
                                                       FontSize="{StaticResource TextSection}" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Grid>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Difference" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DifferencePerSqmDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Margin against target" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding MarginAgainstTargetDisplay}"
                                                       Style="{StaticResource TgtSideValueStyle}" FontWeight="Bold"/>
                                        </Grid>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Required value" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding RequiredTargetValueDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Difference value" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DifferenceValueDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <TextBlock Text="The WASTAGE % box sets the formula yield used by the target above (15% → ÷0.85); Step 6 wastage charges are never part of this KPI."
                                                   FontSize="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"/>

                                        <!-- 6 · VALIDATION -->
                                        <TextBlock Text="6 · VALIDATION" Style="{StaticResource TgtSideHeadingStyle}"/>
                                        <Border HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource TgtPillBase}">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBelowTarget}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsIncomplete}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsAtTarget}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusLabel}"
                                                       FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding WarningSummary}"
                                                   FontSize="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBlock Text="Incomplete or missing inputs are reported as MISSING / INCOMPLETE — the margin is never shown as a misleading 0%."
                                                   FontSize="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"/>

                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
