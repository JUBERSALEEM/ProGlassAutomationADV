<!--
    Step 9 — P&amp;L. Approved mockup:
    one workbench, KPI strip, always-visible build-order layers, rate-check row.
    Bindings and calculations unchanged.
-->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step9ProfitLoss.ProfitLossStepView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:local="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step9ProfitLoss"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1100"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="PlInputStyle" TargetType="TextBox">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryForegroundBrush}"/>
        </Style>
        <Style x:Key="PlCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Target-profitability layout styles (approved KPI redesign) -->
        <Style x:Key="TgtCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,14"/>
        </Style>

        <Style x:Key="TgtCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
        </Style>

        <Style x:Key="TgtKvLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TgtKvValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxWidth" Value="190"/>
        </Style>

        <Style x:Key="TgtPillBase" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="TgtMicroLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="TgtMicroValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="TgtSectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>

        <Style x:Key="TgtSideHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>

        <Style x:Key="TgtSideLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <Style x:Key="TgtSideValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxWidth" Value="180"/>
            <Setter Property="Margin" Value="10,2,0,2"/>
        </Style>

        <!-- Compact export toolbar button (CSV / Excel / PDF) -->
        <Style x:Key="TgtExportButton" TargetType="Button" BasedOn="{StaticResource OutlinedPillButton}">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <TabControl Margin="0" Style="{StaticResource PillTabControlStyle}">
        <!-- TAB 1: TARGET PROFITABILITY (approved KPI) -->
        <TabItem Style="{StaticResource PillTabItemStyle}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="TARGET PROFITABILITY" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          PanningMode="VerticalOnly"
                          behaviors:SmoothScrollBehavior.IsEnabled="True">
                <Border Padding="0">
                    <StackPanel>

                <Border Style="{StaticResource PiStationIdentityStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="09" Style="{StaticResource PiStationCodeStyle}"/>
                            <TextBlock Text="{DynamicResource ProformaInvoice.ProfitLOSS}" Style="{StaticResource PiStationTitleStyle}"/>
                            <TextBlock Text="Given price vs base price · approved KPI · Step 5 Base Price is the given price"
                                       Style="{StaticResource PiStationHintStyle}"/>
                        </StackPanel>
                        <!-- Export toolbar for the cost breakdown (P&L lines) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button Content="CSV" Command="{Binding ExportPnlCsvCommand}"
                                    Style="{StaticResource TgtExportButton}"
                                    ToolTip="Export the cost breakdown as CSV."/>
                            <Button Content="EXCEL" Command="{Binding ExportPnlExcelCommand}"
                                    Style="{StaticResource TgtExportButton}"
                                    ToolTip="Export the cost breakdown as Excel."/>
                            <Button Content="PDF" Command="{Binding ExportPnlPdfCommand}"
                                    Style="{StaticResource TgtExportButton}"
                                    ToolTip="Export the cost breakdown as PDF."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Controls: one compact settings row — WASTAGE %,
                     costing basis and the live calculation state. Each option
                     is a labelled, same-height control so nothing drifts onto
                     a second row. No manual Recalculate button: every edit in
                     Steps 4/5/6/7 auto-queues a recalculation. -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Wastage % -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource ProformaInvoice.Wastage2}" Style="{StaticResource PiFieldLabelStyle}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding WastagePercent, StringFormat={}{0:0.##}, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource PlInputStyle}"
                                     Width="84"
                                     ToolTip="{DynamicResource ProformaInvoice.CuttingAllowanceAddedRequiredAreaBefore}"/>
                            <TextBlock Text="%"
                                       FontSize="{StaticResource TextBodyLarge}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Costing basis -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Cost basis"
                                   Style="{StaticResource PiFieldLabelStyle}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                            <ToggleButton Style="{StaticResource PiToggleSwitch}"
                                          IsChecked="{Binding CostAtSellingPrice}"
                                          ToolTip="{DynamicResource ProformaInvoice.SheetStorePurchasePriceSellingPriceMatching}"
                                          AutomationProperties.Name="Cost glass at selling price"/>
                            <TextBlock Text="{DynamicResource ProformaInvoice.CostGlassSellingPrice}"
                                       FontSize="{StaticResource TextBodyLarge}"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Live calculation state -->
                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Margin="16,0,0,2">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding CalculationStateLabel}"
                                       FontSize="{StaticResource TextCaption}" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecalculationPending}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasCalculationWarnings}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding LastCalculatedAtDisplay}"
                                       FontSize="{StaticResource TextCaption}"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="WASTAGE % also sets the formula yield (15% → ÷0.85) for the target below"
                                   FontSize="{StaticResource TextCaption}"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   HorizontalAlignment="Right"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ═══ THREE KPI CARDS (approved layout) ═══
                     Card 1: required target price (formula result)
                     Card 2: expected profit margin (uplift, Settings-owned)
                     Card 3: margin against target (red/green status pill) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CARD 1 — REQUIRED TARGET PRICE -->
                    <Border Grid.Column="0" Style="{StaticResource TgtCardStyle}">
                        <StackPanel>
                            <TextBlock Text="REQUIRED TARGET PRICE" Style="{StaticResource TgtCaptionStyle}"/>
                            <TextBlock Text="{Binding RequiredTargetPriceDisplay}"
                                       FontSize="30" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       Margin="0,2,0,10"/>
                            <Border Height="1" Background="{DynamicResource OutlineBrush}" Margin="0,0,0,10"/>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ExpectedProfitMarginFactorLabel, StringFormat='Specification target {0}'}" Style="{StaticResource TgtKvLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SpecificationTargetAverageDisplay}"
                                               Style="{StaticResource TgtKvValueStyle}"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Base price (no uplift)" Style="{StaticResource TgtKvLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BasePriceAverageDisplay}"
                                               Style="{StaticResource TgtKvValueStyle}"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="U-insert treatment" Style="{StaticResource TgtKvLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding UInsertSummaryDisplay}"
                                               ToolTip="{Binding UInsertSummaryDetail}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TgtKvValueStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasUInsertSummaryWarning}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Basis" Style="{StaticResource TgtKvLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="Area-weighted across specifications"
                                               Style="{StaticResource TgtKvValueStyle}"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2 — EXPECTED PROFIT MARGIN (middle card).
                         Shows the default profit margin (15% → ×1.15) that the
                         required-target formula adds on top of the cost basis.
                         Settings → Features → Proforma Invoice → Step 9 owns
                         the company default; an invoice can pin its own value
                         (captured at creation) via the view-model. -->
                    <Border Grid.Column="2" Style="{StaticResource TgtCardStyle}">
                        <StackPanel>
                            <TextBlock Text="EXPECTED PROFIT MARGIN" Style="{StaticResource TgtCaptionStyle}"/>
                            <TextBlock Text="{Binding ExpectedProfitMarginDisplay}"
                                       FontSize="30" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       Margin="0,2,0,10"/>
                            <Border Height="1" Background="{DynamicResource OutlineBrush}" Margin="0,0,0,10"/>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Uplift applied to cost basis" Style="{StaticResource TgtKvLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ExpectedProfitMarginFactorLabel}"
                                               Style="{StaticResource TgtKvValueStyle}"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Source" Style="{StaticResource TgtKvLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ExpectedProfitMarginSourceLabel}"
                                               Style="{StaticResource TgtKvValueStyle}"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- CARD 3 — MARGIN AGAINST TARGET -->
                    <Border Grid.Column="4">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource TgtCardStyle}">
                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTargetBelow}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsTargetIncomplete}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="MARGIN AGAINST TARGET" Style="{StaticResource TgtCaptionStyle}" VerticalAlignment="Center"/>
                                <!-- Status pill -->
                                <Border Grid.Column="1">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource TgtPillBase}">
                                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTargetBelow}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsTargetIncomplete}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding TargetJobStatusLabel}"
                                               FontSize="{StaticResource TextCaption}" FontWeight="Bold"
                                               Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding ExtraProfitPerSqmDisplay}"
                                       FontSize="30" FontWeight="Bold" Margin="0,2,2,0"
                                       TextWrapping="Wrap"
                                       ToolTip="Extra profit over the base price — judged on the given price against the base price, never against the final required target.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExtraProfitLoss}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsTargetIncomplete}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ExtraProfitMarginPercentDisplay}"
                                       FontSize="{StaticResource TextBody}"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,0,0,10"/>
                            <Border Height="1" Background="{DynamicResource OutlineBrush}" Margin="0,0,0,10"/>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Given price (Step 5 Base Price)" Style="{StaticResource TgtKvLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding GivenPricePerSqmDisplay}" Style="{StaticResource TgtKvValueStyle}"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource ProformaInvoice.COSTBasedProfitMargin}" Style="{StaticResource TgtKvLabelStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CostBasedProfitMarginDisplay}"
                                               Style="{StaticResource TgtKvValueStyle}"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="U-insert inside given (toggle off)" Style="{StaticResource TgtKvLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding IncludedUInsertAverageDisplay}"
                                               Style="{StaticResource TgtKvValueStyle}"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Given judged for the margin" Style="{StaticResource TgtKvLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding GivenJudgedAverageDisplay}"
                                               Style="{StaticResource TgtKvValueStyle}"
                                               FontWeight="SemiBold"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource OutlineBrush}" Margin="0,10,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Required target price (base + margin %)" Style="{StaticResource TgtKvLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RequiredTargetPriceDisplay}"
                                               Style="{StaticResource TgtKvValueStyle}"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Given judged vs required target" Style="{StaticResource TgtKvLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DifferencePerSqmDisplay}"
                                               Style="{StaticResource TgtKvValueStyle}"
                                               Foreground="{DynamicResource MutedForegroundBrush}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══ COMPACT CALCULATION SUMMARY ═══ -->
                <Border Style="{StaticResource TgtCardStyle}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="CALCULATION SUMMARY" Style="{StaticResource TgtCaptionStyle}"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="GIVEN PRICE SOURCE" Style="{StaticResource TgtMicroLabelStyle}"/>
                                <TextBlock Text="{Binding GivenPriceSourceLabel}"
                                           Style="{StaticResource TgtMicroValueStyle}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SCOPE" Style="{StaticResource TgtMicroLabelStyle}"/>
                                <TextBlock Text="{Binding TargetScopeNote}"
                                           Style="{StaticResource TgtMicroValueStyle}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="TOTAL GIVEN VALUE" Style="{StaticResource TgtMicroLabelStyle}"/>
                                <TextBlock Text="{Binding TotalGivenValueDisplay}" Style="{StaticResource TgtMicroValueStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="TOTAL REQUIRED TARGET VALUE" Style="{StaticResource TgtMicroLabelStyle}"/>
                                <TextBlock Text="{Binding TotalRequiredTargetValueDisplay}" Style="{StaticResource TgtMicroValueStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="8">
                                <TextBlock Text="TOTAL DIFFERENCE" Style="{StaticResource TgtMicroLabelStyle}"/>
                                <TextBlock Text="{Binding TotalDifferenceValueDisplay}" Style="{StaticResource TgtMicroValueStyle}"/>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource OutlineBrush}" Margin="0,12,0,10"/>
                        <TextBlock Text="SPECIFICATION FORMULA" Style="{StaticResource TgtMicroLabelStyle}"/>
                        <TextBlock FontFamily="Consolas" FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0">
                            <Run Text="{Binding TargetFormulaSpecLabel, Mode=OneWay}"/><Run Text="  "/>
                            <Run Text="{Binding TargetFormulaPreview, Mode=OneWay}"/>
                            <Run Text="  →  " Foreground="{DynamicResource AccentBrush}"/>
                            <Run Text="{Binding TargetFormulaStepsText, Mode=OneWay}"
                                 Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding CalculationWarningSummary}"
                                   FontSize="{StaticResource TextCaption}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource DangerBrush}"
                                   Visibility="{Binding HasCalculationWarnings, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding CalculationVersionLabel}"
                                   FontSize="{StaticResource TextCaption}"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Per-specification comparison rows, formula detail and the six-section spec inspector live on the GLASS / SPEC COMPARISON tab."
                           FontSize="{StaticResource TextCaption}"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           TextWrapping="Wrap" Margin="0,12,0,0"/>

                <!-- ═══ ACTUAL COST DETAIL (reference, formula-separated) ═══ -->
                <TextBlock Text="ACTUAL GLASS COST &amp; RATE CHECK — STEP 4 / STEP 6 SHEET BASIS" Style="{StaticResource TgtSectionLabel}"/>
                <TextBlock Text="This Target Profitability summary keeps the commercial glass-cost lens clean: active Step 6 extras such as U-insert, argon, fanhole, holes, cutout, polish and custom charges are billed separately and are not imported here. If an extra toggle is OFF, it is treated as included inside the Step 5 given AED/m² price/target judgement, not as a separate production-cost line in this card."
                           FontSize="{StaticResource TextCaption}"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                <Border Style="{StaticResource TgtCardStyle}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
