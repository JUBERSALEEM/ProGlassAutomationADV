                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <Border Background="{DynamicResource SurfacePrimaryBrush}"
                                                BorderBrush="{DynamicResource BorderDefaultBrush}"
                                                BorderThickness="{DynamicResource Border.HairlineThickness}"
                                                CornerRadius="{DynamicResource Radius.Small}"
                                                Padding="10,8" Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock Text="STEP 4 PANE / SHEET SOURCE"
                                                           FontSize="{StaticResource TextXSmall}"
                                                           FontWeight="{DynamicResource Weight.Bold}"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                <TextBlock Text="{Binding OuterPaneSheetDisplay}"
                                                           FontSize="{StaticResource TextCaption}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding InnerPaneSheetDisplay}"
                                                           FontSize="{StaticResource TextCaption}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding HasSecondGlass, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- 2 · STEP 5 INPUT -->
                                        <TextBlock Text="2 · STEP 5 INPUT" Style="{StaticResource TgtSideHeadingStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Given price (Base Price)" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding GivenPricePerSqmDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Measured area" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding AreaSqmDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Given value" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding GivenValueDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <TextBlock Text="The Step 5 Base Price is the given selling price. It never comes from Step 4, the Step 9 calculation, the Sheet Store or a manual field here."
                                                   FontSize="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"/>

                                        <!-- 3 · TARGET FORMULA -->
                                        <TextBlock Text="3 · TARGET FORMULA" Style="{StaticResource TgtSideHeadingStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Outer glass rate" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding OuterGlassRateDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <Grid Visibility="{Binding HasSecondGlass, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Inner glass rate" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding InnerGlassRateDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <Grid Visibility="{Binding HasThirdGlass, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Third glass rate" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ThirdGlassRateDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <Grid Visibility="{Binding HasAspRate, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="ASP / spacer rate" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding AspRateDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <Grid Visibility="{Binding HasProcessingRate, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Processing add-ons" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ProcessingRateDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Yield factor" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding YieldFactorDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Target uplift" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TargetUpliftDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <Border Background="{DynamicResource SurfacePrimaryBrush}"
                                                BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource Border.HairlineThickness}"
                                                CornerRadius="{DynamicResource Radius.Small}" Padding="10,8" Margin="0,8,0,0">
                                            <TextBlock FontFamily="Consolas" FontSize="{StaticResource TextCaption}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap" Text="{Binding FormulaText}"/>
                                        </Border>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Specification target (before U-insert)"
                                                       Style="{StaticResource TgtSideLabelStyle}" FontWeight="{DynamicResource Weight.SemiBold}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SpecificationTargetDisplay}"
                                                       Style="{StaticResource TgtSideValueStyle}" FontWeight="{DynamicResource Weight.Bold}"/>
                                        </Grid>


                                    </StackPanel>

                                    <StackPanel Grid.Column="2" DataContext="{Binding SelectedTargetSpec}">
                                        <!-- 4 · U-INSERT -->
                                        <TextBlock Text="4 · U-INSERT" Style="{StaticResource TgtSideHeadingStyle}" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Treatment" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding UInsertTreatmentLabel}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding UInsertAppliedCaption}" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding UInsertAppliedValueDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Source" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding UInsertSourceDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding UInsertTreatmentDetail}"
                                                   FontSize="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"/>

                                        <!-- 5 · RESULT -->
                                        <TextBlock Text="5 · RESULT — BASE AND TARGET BALANCE" Style="{StaticResource TgtSideHeadingStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Base price" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding BasePriceDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Margin against base" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding BaseMarginDisplay}"
                                                       Style="{StaticResource TgtSideValueStyle}" FontWeight="{DynamicResource Weight.Bold}"/>
                                        </Grid>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Base balance" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding BaseDifferencePerSqmDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Final required target"
                                                       FontSize="{StaticResource TextCaption}" FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FinalRequiredTargetDisplay}"
                                                       FontSize="{StaticResource TextSection}" FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Grid>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Target balance" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DifferencePerSqmDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Margin against target" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding MarginAgainstTargetDisplay}"
                                                       Style="{StaticResource TgtSideValueStyle}" FontWeight="{DynamicResource Weight.Bold}"/>
                                        </Grid>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Required value" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding RequiredTargetValueDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Difference value" Style="{StaticResource TgtSideLabelStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DifferenceValueDisplay}" Style="{StaticResource TgtSideValueStyle}"/>
                                        </Grid>
                                        <TextBlock Text="The WASTAGE % box sets the formula yield used by the target above (15% → ÷0.85); Step 6 wastage charges are never part of this KPI."
                                                   FontSize="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"/>

                                        <!-- 6 · VALIDATION -->
                                        <TextBlock Text="6 · VALIDATION" Style="{StaticResource TgtSideHeadingStyle}"/>
                                        <Border HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource TgtPillBase}">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBelowTarget}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsIncomplete}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsAtTarget}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusLabel}"
                                                       FontSize="{StaticResource TextXSmall}" FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding WarningSummary}"
                                                   FontSize="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBlock Text="Incomplete or missing inputs are reported as MISSING / INCOMPLETE — the margin is never shown as a misleading 0%."
                                                   FontSize="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"/>

                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
