<!--
    Step 9 — P&amp;L. Approved mockup:
    one workbench, KPI strip, always-visible build-order layers, rate-check row.
    Bindings and calculations unchanged.
-->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step9ProfitLoss.ProfitLossStepView"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:local="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step9ProfitLoss"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1100"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="PlInputStyle" TargetType="TextBox">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryForegroundBrush}"/>
        </Style>
        <Style x:Key="PlCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <TabControl Margin="0" Style="{StaticResource PillTabControlStyle}">
        <!-- TAB 1: PROFIT & LOSS (Main View) -->
        <TabItem Style="{StaticResource PillTabItemStyle}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="PROFIT &amp; LOSS" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          PanningMode="VerticalOnly"
                          behaviors:SmoothScrollBehavior.IsEnabled="True">
                <Border Padding="0">
                    <StackPanel>
                <Border Style="{StaticResource PiStationIdentityStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="09" Style="{StaticResource PiStationCodeStyle}"/>
                        <TextBlock Text="{DynamicResource ProformaInvoice.ProfitLOSS}" Style="{StaticResource PiStationTitleStyle}"/>
                        <TextBlock Text="{DynamicResource ProformaInvoice.WastageSheetCostQuotedRateCheck}"
                                   Style="{StaticResource PiStationHintStyle}"/>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ProformaInvoice.Wastage2}" Style="{StaticResource PiFieldLabelStyle}"/>
                        <TextBox Text="{Binding WastagePercent, StringFormat={}{0:0.##}, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource PlInputStyle}"
                                 ToolTip="{DynamicResource ProformaInvoice.CuttingAllowanceAddedRequiredAreaBefore}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <ToggleButton Style="{StaticResource PiToggleSwitch}"
                                      IsChecked="{Binding CostAtSellingPrice}"
                                      ToolTip="{DynamicResource ProformaInvoice.SheetStorePurchasePriceSellingPriceMatching}"
                                      AutomationProperties.Name="Cost glass at selling price"/>
                        <TextBlock Text="{DynamicResource ProformaInvoice.CostGlassSellingPrice}"
                                   FontSize="{StaticResource TextBody}"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="4"
                            Content="{DynamicResource ProformaInvoice.Recalculate}"
                            Command="{Binding RecalculateCommand}"
                            Style="{StaticResource PiFooterPrimaryButton}"
                            VerticalAlignment="Bottom"/>
                    <TextBlock Grid.Column="5"
                               Text="{Binding StatusMessage}"
                               FontSize="{StaticResource TextBody}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Bottom"
                               Margin="16,0,0,8"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </Grid>

                <Border Style="{StaticResource PiMetricStripStyle}" Padding="0,4,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.3*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PiKpiCellStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ProformaInvoice.GrossVATINCL}" Style="{StaticResource PiKpiCaptionStyle}"/>
                                <TextBlock Text="{Binding GrossDisplay}" Style="{StaticResource PiKpiValueStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PiKpiCellStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ProformaInvoice.NET105}" Style="{StaticResource PiKpiCaptionStyle}"/>
                                <TextBlock Text="{Binding NetDisplay}" Style="{StaticResource PiKpiValueStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource PiKpiCellStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ProformaInvoice.GlassCOST}" Style="{StaticResource PiKpiCaptionStyle}"/>
                                <TextBlock Text="{Binding GlassCostDisplay}" Style="{StaticResource PiKpiValueStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource PiKpiCellStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ProformaInvoice.ProductionASPExtras}" Style="{StaticResource PiKpiCaptionStyle}"/>
                                <TextBlock Text="{Binding ProductionCostDisplay}" Style="{StaticResource PiKpiValueStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource PiKpiCellStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ProformaInvoice.COSTBasedProfitMargin}" Style="{StaticResource PiKpiCaptionStyle}"/>
                                <TextBlock Text="{Binding CostBasedMarginDisplay}" Style="{StaticResource PiKpiValueStyle}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="5" ToolTip="MOST IMPORTANT: Real job profitability including U-insert cost. (Revenue − Total Cost) ÷ Total Cost × 100.">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource PiKpiCellStyle}">
                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoss}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="⭐ OVERALL MARGIN" Style="{StaticResource PiKpiCaptionStyle}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding OverallMarginDisplay}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource PiKpiValueStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoss}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="6" Style="{StaticResource PiKpiCellStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ProformaInvoice.PriceBasedProfitMargin}" Style="{StaticResource PiKpiCaptionStyle}"/>
                                <TextBlock Text="{Binding PriceBasedMarginDisplay}" Style="{StaticResource PiKpiValueStyle}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <!-- PROFIT — the margin now lives in its own cards
                             (COST-BASED / PRICE-BASED); the mark-up-over-cost
                             line remains as the supplemental existing read. -->
                        <Border Grid.Column="7" Style="{StaticResource PiKpiCellStyle}" BorderThickness="0">
                            <StackPanel>
                                <TextBlock Text="{Binding ProfitLabel}" Style="{StaticResource PiKpiCaptionStyle}"/>
                                <TextBlock Text="{Binding ProfitDisplay}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource PiKpiValueStyle}">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoss}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding MarkupDisplay}"
                                           FontSize="{StaticResource TextCaption}"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding SpecGroupsView}"
                              Visibility="{Binding HasSpecGroups, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="0,12,0,4"
                                    Margin="0,8,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding HeaderDisplay}"
                                               FontSize="{StaticResource TextBody}" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SpecName}"
                                               FontFamily="Consolas"
                                               FontSize="{StaticResource TextBody}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding TotalCostDisplay}"
                                               FontSize="{StaticResource TextBodyLarge}" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>
                                </Grid>

                                <Border Style="{StaticResource PiTableHeaderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*" MinWidth="180"/>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource ProformaInvoice.KIND}" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="{DynamicResource Common.Description}" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="2" Text="{DynamicResource ProformaInvoice.SheetSIZE}" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="3" Text="QTY" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="4" Text="{DynamicResource Common.Price}" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="5" Text="{DynamicResource Common.Amount}" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource OutlineBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*" MinWidth="180"/>
                                                        <ColumnDefinition Width="190"/>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="110"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Kind}"
                                                               Style="{StaticResource PlCellStyle}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Description}"
                                                               Style="{StaticResource PlCellStyle}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,12,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}"
                                                               Style="{StaticResource PlCellStyle}"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding QuantityDisplay}"
                                                               Style="{StaticResource PlCellStyle}"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding PriceDisplay}"
                                                               Style="{StaticResource PlCellStyle}"
                                                               HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding AmountDisplay}"
                                                               Style="{StaticResource PlCellStyle}"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,8,0,0"
                                      Visibility="{Binding CanRateCheck, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource ProformaInvoice.CheckRATESQM}"
                                               Style="{StaticResource PiFieldLabelStyle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding QuotedRatePerSqm,
                                                    Converter={StaticResource DecimalTypingConverter},
                                                    UpdateSourceTrigger=PropertyChanged}"
                                             behaviors:TextBoxBehaviors.AcceptDecimals="True"
                                             Style="{StaticResource PlInputStyle}"
                                             ToolTip="{DynamicResource ProformaInvoice.TypeRateIntendQuoteMarkShownBeside}"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding RateCheckDisplay}"
                                               FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="12,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsQuotedRateBelowCost}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasQuotedRate}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{DynamicResource ProformaInvoice.NoCostedLinesYetPressRecalculateOnceStep5}"
                           FontSize="{StaticResource TextBody}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Margin="0,12,0,0"
                           Visibility="{Binding HasSpecGroups, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
        </TabItem>
        
        <!-- TAB 2: SERVICE PROFITABILITY (Phase 1) -->
        <TabItem Style="{StaticResource PillTabItemStyle}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="SERVICE" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          PanningMode="VerticalOnly"
                          behaviors:SmoothScrollBehavior.IsEnabled="True">
                <ContentControl Content="{Binding ServiceProfitability}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <local:ServiceProfitabilityView DataContext="{Binding}"/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </ScrollViewer>
        </TabItem>
        
        <!-- TAB 3: SHEET PROFITABILITY (Phase 2) -->
        <TabItem Style="{StaticResource PillTabItemStyle}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="SHEET" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          PanningMode="VerticalOnly"
                          behaviors:SmoothScrollBehavior.IsEnabled="True">
                <ContentControl Content="{Binding SheetProfitability}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <local:SheetProfitabilityView DataContext="{Binding}"/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </ScrollViewer>
        </TabItem>
        
        <!-- TAB 4: GLASS TYPE COMPARISON (Phase 3) -->
        <TabItem Style="{StaticResource PillTabItemStyle}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="GLASS TYPE" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          PanningMode="VerticalOnly"
                          behaviors:SmoothScrollBehavior.IsEnabled="True">
                <ContentControl Content="{Binding GlassTypeComparison}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <local:GlassTypeComparisonView DataContext="{Binding}"/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
