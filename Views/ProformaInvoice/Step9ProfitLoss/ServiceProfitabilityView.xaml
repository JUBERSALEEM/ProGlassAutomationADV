<!--
    Service Profitability View - Separate Tab for Detailed Service Analysis
    
    Shows breakdown of profit by service type:
    - Glass margin (buying vs selling)
    - Spacer/ASP service (DGU only)
    - Cutting service (SGU only)
    - Tempering service (SGU only)
    - PVB interlayer service (LAM only)
    - U-insert service
    
    Each service shows:
    - Charge (what customer pays)
    - Cost (actual cost)
    - Profit (charge - cost)
    - Margin % (profit / charge × 100)
-->
<UserControl xmlns:crystal="clr-namespace:ProGlassAutomation.Controls.CrystalFluid" x:Class="ProGlassAutomation.Views.ProformaInvoice.Step9ProfitLoss.ServiceProfitabilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    
    <UserControl.Resources>
        <!-- Header style -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        
        <!-- Subheader style -->
        <Style x:Key="SubheaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        
        <!-- KPI card style -->
        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="crystal:CrystalWaterAttach.Attach" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        
        <!-- KPI label style -->
        <Style x:Key="KpiLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        
        <!-- KPI value style -->
        <Style x:Key="KpiValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        </Style>
        
        <!-- Table header style -->
        <Style x:Key="TableHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        
        <!-- Table cell style -->
        <Style x:Key="TableCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <!-- Profitable row style -->
        <Style x:Key="ProfitableRowStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProfitable}" Value="False">
                    <Setter Property="Background" Value="#10FF0000"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="SERVICE PROFITABILITY ANALYSIS" Style="{StaticResource HeaderStyle}"/>
            <TextBlock Text="Detailed breakdown of profit by service type. Shows which services are profitable and which are losing money." 
                       Style="{StaticResource SubheaderStyle}"/>
        </StackPanel>
        
        <!-- KPI Cards -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <!-- Total Service Charge -->
            <Border Style="{StaticResource KpiCardStyle}" Width="200">
                <StackPanel>
                    <TextBlock Text="TOTAL SERVICE CHARGE" Style="{StaticResource KpiLabelStyle}"/>
                    <TextBlock Text="{Binding TotalServiceChargeDisplay}" Style="{StaticResource KpiValueStyle}"/>
                </StackPanel>
            </Border>
            
            <!-- Total Service Profit -->
            <Border Style="{StaticResource KpiCardStyle}" Width="200">
                <StackPanel>
                    <TextBlock Text="TOTAL SERVICE PROFIT" Style="{StaticResource KpiLabelStyle}"/>
                    <TextBlock Text="{Binding TotalServiceProfitDisplay}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource KpiValueStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TotalServiceProfit, Converter={StaticResource DecimalComparisonConverter}, ConverterParameter=0}" Value="LessThan">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            
            <!-- Overall Service Margin -->
            <Border Style="{StaticResource KpiCardStyle}" Width="200">
                <StackPanel>
                    <TextBlock Text="OVERALL SERVICE MARGIN" Style="{StaticResource KpiLabelStyle}"/>
                    <TextBlock Text="{Binding OverallServiceMarginDisplay}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource KpiValueStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OverallServiceMarginPercent, Converter={StaticResource DecimalComparisonConverter}, ConverterParameter=0}" Value="LessThan">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            
            <!-- Refresh Button -->
            <Button Content="REFRESH" 
                    Command="{Binding RefreshCommand}"
                    Width="120"
                    Height="40"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource PrimaryPillButton}"/>
        </StackPanel>
        
        <!-- Service Breakdown Table -->
        <Border Grid.Row="2" 
                Background="{DynamicResource ModuleBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Table Header -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="8,8,0,0"
                        Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="SPEC" Style="{StaticResource TableHeaderStyle}"/>
                        <TextBlock Grid.Column="1" Text="SERVICE" Style="{StaticResource TableHeaderStyle}"/>
                        <TextBlock Grid.Column="2" Text="DESCRIPTION" Style="{StaticResource TableHeaderStyle}"/>
                        <TextBlock Grid.Column="3" Text="AREA" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="CHARGE" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="5" Text="COST" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="6" Text="PROFIT" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="7" Text="MARGIN %" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>
                
                <!-- Table Rows -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ServiceBreakdown}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ProfitableRowStyle}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Spec Name -->
                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding SpecName}" 
                                                   Style="{StaticResource TableCellStyle}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                        
                                        <!-- Service Name -->
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding ServiceName}" 
                                                   Style="{StaticResource TableCellStyle}"
                                                   FontWeight="SemiBold"/>
                                        
                                        <!-- Description -->
                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding Description}" 
                                                   Style="{StaticResource TableCellStyle}"
                                                   TextWrapping="Wrap"/>
                                        
                                        <!-- Area -->
                                        <TextBlock Grid.Column="3" 
                                                   Text="{Binding AreaDisplay}" 
                                                   Style="{StaticResource TableCellStyle}"
                                                   HorizontalAlignment="Right"/>
                                        
                                        <!-- Charge -->
                                        <TextBlock Grid.Column="4" 
                                                   Text="{Binding ChargeDisplay}" 
                                                   Style="{StaticResource TableCellStyle}"
                                                   HorizontalAlignment="Right"/>
                                        
                                        <!-- Cost -->
                                        <TextBlock Grid.Column="5" 
                                                   Text="{Binding CostDisplay}" 
                                                   Style="{StaticResource TableCellStyle}"
                                                   HorizontalAlignment="Right"/>
                                        
                                        <!-- Profit -->
                                        <TextBlock Grid.Column="6" 
                                                   Text="{Binding ProfitDisplay}" 
                                                   HorizontalAlignment="Right"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TableCellStyle}">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProfitable}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        
                                        <!-- Margin % -->
                                        <TextBlock Grid.Column="7" 
                                                   Text="{Binding MarginDisplay}" 
                                                   HorizontalAlignment="Right"
                                                   FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TableCellStyle}">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProfitable}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <!-- Empty State -->
                <Border Grid.Row="1" 
                        Visibility="{Binding ServiceBreakdown.Count, Converter={StaticResource CountToVisibilityConverter}}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="32">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="No services found" 
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Add specifications in Step 5 and press REFRESH to analyze service profitability."
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        
        <!-- Status Bar -->
        <Border Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}" 
                       FontSize="11"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
        </Border>
        
        <!-- Loading Overlay -->
        <Border Grid.RowSpan="4" 
                Background="#80000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Analyzing..." 
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
