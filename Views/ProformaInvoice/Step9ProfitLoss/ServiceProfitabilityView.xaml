<!--
    Service Profitability View - Separate Tab for Detailed Service Analysis

    Shows breakdown of profit by service type:
    - Glass margin (buying vs selling)
    - Spacer/ASP service (DGU only)
    - Cutting service (SGU only)
    - Tempering service (SGU only)
    - PVB interlayer service (LAM only)
    - U-insert service

    Each service shows:
    - Charge (what customer pays)
    - Cost (actual cost)
    - Profit (charge - cost)
    - Margin % (profit / charge × 100)
-->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step9ProfitLoss.ServiceProfitabilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             FontFamily="{DynamicResource AppFontFamily}">

        <UserControl.Resources>
        <!-- Migrated HeaderStyle to global Typography.Title -->
    </UserControl.Resources>


    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="SERVICE PROFITABILITY ANALYSIS" Style="{StaticResource Typography.Title}"/>
                <TextBlock Text="Simple order: service totals first, then detailed service rows, then recommendation/status. Use this after the Overview decision."
                           Style="{StaticResource Typography.BodySmall}"/>
            </StackPanel>
            <!-- Export toolbar (multi-generation report output) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                <Button Content="CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource ServiceExportButton}" ToolTip="Export this analysis as CSV."/>
                <Button Content="EXCEL" Command="{Binding ExportExcelCommand}" Style="{StaticResource ServiceExportButton}" ToolTip="Export this analysis as Excel."/>
                <Button Content="PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource ServiceExportButton}" ToolTip="Export this analysis as PDF."/>
                <Button Content="{DynamicResource Sharing.Share}" Command="{Binding ShareCommand}" Style="{StaticResource ServiceExportButton}" ToolTip="Share this analysis via the Sharing Center."/>
            </StackPanel>
        </Grid>

        <!-- Main result first -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="MAIN RESULT — SERVICE TOTALS" Style="{StaticResource Typography.Label}" FontWeight="{DynamicResource Weight.Bold}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
            <!-- Total Service Charge -->
            <Border Style="{StaticResource SurfacePrimaryStyle}" Width="200">
                <StackPanel>
                    <TextBlock Text="TOTAL SERVICE CHARGE" Style="{StaticResource Typography.Label}"/>
                    <TextBlock Text="{Binding TotalServiceChargeDisplay}" Style="{StaticResource Typography.Body}"/>
                </StackPanel>
            </Border>

            <!-- Total Service Profit -->
            <Border Style="{StaticResource SurfacePrimaryStyle}" Width="200">
                <StackPanel>
                    <TextBlock Text="TOTAL SERVICE PROFIT" Style="{StaticResource Typography.Label}"/>
                    <TextBlock Text="{Binding TotalServiceProfitDisplay}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource KpiValueStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TotalServiceProfit, Converter={StaticResource DecimalComparisonConverter}, ConverterParameter=0}" Value="LessThan">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Overall Service Margin -->
            <Border Style="{StaticResource SurfacePrimaryStyle}" Width="200">
                <StackPanel>
                    <TextBlock Text="OVERALL SERVICE MARGIN" Style="{StaticResource Typography.Label}"/>
                    <TextBlock Text="{Binding OverallServiceMarginDisplay}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource KpiValueStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OverallServiceMarginPercent, Converter={StaticResource DecimalComparisonConverter}, ConverterParameter=0}" Value="LessThan">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Refresh Button -->
            <Button Content="REFRESH"
                    Command="{Binding RefreshCommand}"
                    Width="120"
                    Height="40"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource PrimaryPillButton}"/>
            </StackPanel>
        </StackPanel>

        <!-- Extra details after the main result -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfacePrimaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{DynamicResource Border.HairlineThickness}"
                CornerRadius="{DynamicResource Radius.Small}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Table Header -->
                <Border Grid.Row="0"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="{DynamicResource Radius.Top.Medium}"
                        Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="SPEC" Style="{StaticResource Typography.Label}"/>
                        <TextBlock Grid.Column="1" Text="SERVICE" Style="{StaticResource Typography.Label}"/>
                        <TextBlock Grid.Column="2" Text="DESCRIPTION" Style="{StaticResource Typography.Label}"/>
                        <TextBlock Grid.Column="3" Text="AREA" Style="{StaticResource Typography.Label}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="CHARGE" Style="{StaticResource Typography.Label}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="5" Text="COST" Style="{StaticResource Typography.Label}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="6" Text="PROFIT" Style="{StaticResource Typography.Label}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="7" Text="MARGIN %" Style="{StaticResource Typography.Label}" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- Table Rows -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ServiceBreakdown}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ProfitableRowStyle}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{DynamicResource Border.BottomHairlineThickness}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Spec Name -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding SpecName}"
                                                   Style="{StaticResource Typography.Body}"
                                                   FontWeight="{DynamicResource Weight.SemiBold}"
                                                   Foreground="{DynamicResource AccentBrush}"/>

                                        <!-- Service Name -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ServiceName}"
                                                   Style="{StaticResource Typography.Body}"
                                                   FontWeight="{DynamicResource Weight.SemiBold}"/>

                                        <!-- Description -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Description}"
                                                   Style="{StaticResource Typography.Body}"
                                                   TextWrapping="Wrap"/>

                                        <!-- Area -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding AreaDisplay}"
                                                   Style="{StaticResource Typography.Body}"
                                                   HorizontalAlignment="Right"/>

                                        <!-- Charge -->
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding ChargeDisplay}"
                                                   Style="{StaticResource Typography.Body}"
                                                   HorizontalAlignment="Right"/>

                                        <!-- Cost -->
                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding CostDisplay}"
                                                   Style="{StaticResource Typography.Body}"
                                                   HorizontalAlignment="Right"/>

                                        <!-- Profit -->
                                        <TextBlock Grid.Column="6"
                                                   Text="{Binding ProfitDisplay}"
                                                   HorizontalAlignment="Right"
                                                   FontWeight="{DynamicResource Weight.SemiBold}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TableCellStyle}">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProfitable}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Margin % -->
                                        <TextBlock Grid.Column="7"
                                                   Text="{Binding MarginDisplay}"
                                                   HorizontalAlignment="Right"
                                                   FontWeight="{DynamicResource Weight.Bold}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TableCellStyle}">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProfitable}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty State -->
                <Border Grid.Row="1"
                        Visibility="{Binding ServiceBreakdown.Count, Converter={StaticResource CountToVisibilityConverter}}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="32">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="No services found"
                                   FontSize="{StaticResource TextSection}"
                                   FontWeight="{DynamicResource Weight.SemiBold}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Add specifications in Step 5 and press REFRESH to analyze service profitability."
                                   FontSize="{StaticResource TextCaption}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Totals footer — the same column definitions as the table,
                     so the sums land exactly under their columns. -->
                <Border Grid.Row="2"
                        Background="{DynamicResource SurfacePrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{DynamicResource Border.TopHairlineThickness}"
                        Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text=""
                                   Style="{StaticResource Typography.Body}"/>
                        <TextBlock Grid.Column="1" Text="TOTAL"
                                   Style="{StaticResource Typography.Body}" FontWeight="{DynamicResource Weight.Bold}"/>
                        <TextBlock Grid.Column="2" Text="{Binding TotalServiceCountDisplay}"
                                   Style="{StaticResource Typography.Body}"/>
                        <TextBlock Grid.Column="3" Text="{Binding TotalServiceAreaDisplay}"
                                   Style="{StaticResource Typography.Body}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="{Binding TotalServiceChargeDisplay}"
                                   Style="{StaticResource Typography.Body}" HorizontalAlignment="Right" FontWeight="{DynamicResource Weight.SemiBold}"/>
                        <TextBlock Grid.Column="5" Text="{Binding TotalServiceCostDisplay}"
                                   Style="{StaticResource Typography.Body}" HorizontalAlignment="Right" FontWeight="{DynamicResource Weight.SemiBold}"/>
                        <TextBlock Grid.Column="6" Text="{Binding TotalServiceProfitDisplay}"
                                   HorizontalAlignment="Right" FontWeight="{DynamicResource Weight.SemiBold}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TableCellStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TotalServiceProfit, Converter={StaticResource DecimalComparisonConverter}, ConverterParameter=0}" Value="LessThan">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="7" Text="{Binding OverallServiceMarginDisplay}"
                                   Style="{StaticResource Typography.Body}" HorizontalAlignment="Right" FontWeight="{DynamicResource Weight.Bold}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="{StaticResource TextXSmall}"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="4"
                Background="{DynamicResource SurfaceOverlayBrush}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Analyzing..."
                           FontSize="{StaticResource TextSection}"
                           FontWeight="{DynamicResource Weight.SemiBold}"
                           Foreground="{DynamicResource OnAccentForegroundBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
