<!--
    Sheet Profitability View — Separate Tab for Sheet Usage Analysis

    Modernised 2026-09-06 to match the GLASS / SPEC COMPARISON detail
    treatment:
      • The report stays CLOSED by default (list + KPI strip only).
      • Clicking a sheet row opens a FULL-SCREEN detail (whole tab content),
        not a side panel.
      • The GLASS TYPE column shows only the build family (SGU / DGU / LAM /
        DGU+LAM) — never the outer/inner pane identity.
      • A proper price reconciliation is shown per row and as an overall
        report: TOTAL sheet price, USED sheet price, WASTAGE sheet price,
        offcut value and their comparison.

    Label/value rows keep labels and values adjacent (fixed label column +
    fixed right-aligned value column) so text never stretches to the far
    edges of a wide card.
-->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step9ProfitLoss.SheetProfitabilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1100">

    <UserControl.Resources>
        <!-- Card: matches the TgtCardStyle used across Step 9. -->
        <Style x:Key="SheetCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,14"/>
        </Style>

        <!-- Caption over a card (label of the metric). -->
        <Style x:Key="SheetCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
        </Style>

        <!-- Big KPI value. -->
        <Style x:Key="SheetKpiValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Margin" Value="0,2,0,4"/>
        </Style>

        <!-- Muted sub-caption under a KPI value. -->
        <Style x:Key="SheetSubCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Section label between blocks. -->
        <Style x:Key="SheetSectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>

        <!-- Numbered heading inside the detail screen. -->
        <Style x:Key="SheetHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Label in a label/value row (fixed 150px column). -->
        <Style x:Key="SheetKvLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>

        <!-- Value in a label/value row (fixed 200px column, right aligned so
             every value shares one right edge, right next to its label). -->
        <Style x:Key="SheetKvValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="10,3,0,3"/>
        </Style>

        <!-- Table body cell. -->
        <Style x:Key="SheetTableCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <!-- ═══ STATE 1 — SHEET LIST (visible when no row is selected) ═══ -->
        <StackPanel Visibility="{Binding HasSelectedRow, Converter={StaticResource InverseBoolToVisibilityConverter}}">

            <!-- Header + refresh -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="SHEET PROFITABILITY ANALYSIS"
                               FontSize="{StaticResource TextSection}" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="Track sheet usage, the total / used / wastage sheet prices and the real cost of every sheet bought."
                               FontSize="{StaticResource TextCaption}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="REFRESH"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource PrimaryPillButton}"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0"
                        Cursor="Hand"
                        ToolTip="Re-analyze sheet usage and wastage charges from Steps 5 and 6."/>
            </Grid>

            <!-- ═══ KPI STRIP (4 × 2, uniform cards) ═══ -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ROW 1 -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SheetCardStyle}" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="SHEETS PURCHASED" Style="{StaticResource SheetCaptionStyle}"/>
                        <TextBlock Text="{Binding TotalSheetsPurchasedDisplay}" Style="{StaticResource SheetKpiValueStyle}"/>
                        <TextBlock Text="sheets bought" Style="{StaticResource SheetSubCaptionStyle}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource SheetCardStyle}" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="TOTAL SHEET AREA" Style="{StaticResource SheetCaptionStyle}"/>
                        <TextBlock Text="{Binding TotalSheetAreaDisplay}" Style="{StaticResource SheetKpiValueStyle}"/>
                        <TextBlock Text="purchased SQM" Style="{StaticResource SheetSubCaptionStyle}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource SheetCardStyle}" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="USED AREA" Style="{StaticResource SheetCaptionStyle}"/>
                        <TextBlock Text="{Binding TotalUsedAreaDisplay}" Style="{StaticResource SheetKpiValueStyle}"/>
                        <TextBlock Text="cut SQM" Style="{StaticResource SheetSubCaptionStyle}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource SheetCardStyle}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="OFFCUT AREA" Style="{StaticResource SheetCaptionStyle}"/>
                        <TextBlock Text="{Binding TotalOffcutAreaDisplay}" Style="{StaticResource SheetKpiValueStyle}"/>
                        <TextBlock Text="leftover SQM" Style="{StaticResource SheetSubCaptionStyle}"/>
                    </StackPanel>
                </Border>

                <!-- ROW 2 -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SheetCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="WASTAGE AREA" Style="{StaticResource SheetCaptionStyle}"/>
                        <TextBlock Text="{Binding WastageAreaDisplay}" Style="{StaticResource SheetKpiValueStyle}"
                                   Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock Text="Step 6 SQM" Style="{StaticResource SheetSubCaptionStyle}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SheetCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="EFFICIENCY" Style="{StaticResource SheetCaptionStyle}"/>
                        <TextBlock Text="{Binding UsageEfficiencyDisplay}" Style="{StaticResource SheetKpiValueStyle}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SheetKpiValueStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UsageEfficiencyPercent, Converter={StaticResource DecimalComparisonConverter}, ConverterParameter=70}" Value="LessThan">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="used ÷ total" Style="{StaticResource SheetSubCaptionStyle}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource SheetCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="WASTAGE CHARGED" Style="{StaticResource SheetCaptionStyle}"/>
                        <TextBlock Text="{Binding WastageChargedToCustomerDisplay}" Style="{StaticResource SheetKpiValueStyle}"
                                   Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock Text="billed to customer" Style="{StaticResource SheetSubCaptionStyle}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource SheetCardStyle}" Margin="0,0,0,0">
                    <StackPanel>
                        <TextBlock Text="REAL COST" Style="{StaticResource SheetCaptionStyle}"/>
                        <TextBlock Text="{Binding RealCostDisplay}" Style="{StaticResource SheetKpiValueStyle}"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="net sheet cost" Style="{StaticResource SheetSubCaptionStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ OVERALL PRICE RECONCILIATION (report, closed until expanded
                 — shown as a summary strip) ═══ -->
            <Border Style="{StaticResource SheetCardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="SHEET PRICE RECONCILIATION — OVERALL REPORT" Style="{StaticResource SheetCaptionStyle}"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="TOTAL SHEET PRICE" Style="{StaticResource SheetCaptionStyle}"/>
                            <TextBlock Text="{Binding TotalPurchaseCostDisplay}" Style="{StaticResource SheetKpiValueStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="USED SHEET PRICE" Style="{StaticResource SheetCaptionStyle}"/>
                            <TextBlock Text="{Binding TotalUsedPriceDisplay}" Style="{StaticResource SheetKpiValueStyle}"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="16,0,0,0">
                            <TextBlock Text="OFFCUT VALUE" Style="{StaticResource SheetCaptionStyle}"/>
                            <TextBlock Text="{Binding TotalOffcutPriceDisplay}" Style="{StaticResource SheetKpiValueStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="16,0,0,0">
                            <TextBlock Text="WASTAGE SHEET PRICE" Style="{StaticResource SheetCaptionStyle}"/>
                            <TextBlock Text="{Binding WastageChargeDisplay}" Style="{StaticResource SheetKpiValueStyle}"
                                       Foreground="{DynamicResource DangerBrush}"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource OutlineBrush}" Margin="0,12,0,10"/>
                    <TextBlock FontSize="{StaticResource TextCaption}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               TextWrapping="Wrap">
                        <Run Text="Used "/><Run Text="{Binding UsedPriceShareDisplay, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                        <Run Text=" · offcut "/><Run Text="{Binding OffcutPriceShareDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text=" of the total sheet price. Wastage charged "/><Run Text="{Binding NetWastageVsOffcutDisplay, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/>
                        <Run Text=" — "/><Run Text="{Binding NetWastageVsOffcutLabel, Mode=OneWay}"/><Run Text="."/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ═══ SHEET BREAKDOWN TABLE ═══ -->
            <TextBlock Text="SHEET BREAKDOWN — CLICK A ROW FOR ITS PRICE DETAIL" Style="{StaticResource SheetSectionLabel}"/>
            <Border Style="{StaticResource SheetCardStyle}" Padding="0"
                    Visibility="{Binding SheetBreakdown.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Inverted}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Style="{StaticResource PiTableHeaderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="2.4*"/>
                                <ColumnDefinition Width="0.6*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="1.0*"/>
                                <ColumnDefinition Width="1.0*"/>
                                <ColumnDefinition Width="1.0*"/>
                                <ColumnDefinition Width="0.8*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="GLASS TYPE" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="1" Text="SPECIFICATION" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="2" Text="SHEETS" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="TOTAL SQM" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="USED SQM" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="5" Text="OFFCUT" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="6" Text="WASTAGE" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="7" Text="TOTAL PRICE" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="8" Text="USED PRICE" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="9" Text="WASTAGE PRICE" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="10" Text="EFFICIENCY" Style="{StaticResource LineItemsHeaderTextStyle}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Rows -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding SheetBreakdown}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource OutlineBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,7"
                                        Cursor="Hand"
                                        ToolTip="{Binding SheetSize}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.SelectRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEfficient}" Value="False">
                                                    <Setter Property="Background" Value="#10FF8800"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource TintIndigoBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="2.4*"/>
                                            <ColumnDefinition Width="0.6*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="1.0*"/>
                                            <ColumnDefinition Width="1.0*"/>
                                            <ColumnDefinition Width="1.0*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Glass type: build family only -->
                                        <TextBlock Grid.Column="0" Text="{Binding GlassTypeLabel}"
                                                   Style="{StaticResource SheetTableCellStyle}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"/>

                                        <!-- Specification + sheet size -->
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SpecName}"
                                                       Style="{StaticResource SheetTableCellStyle}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding SheetSize}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="6,-3,6,2"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding SheetsPurchasedDisplay}"
                                                   Style="{StaticResource SheetTableCellStyle}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="3" Text="{Binding TotalSheetAreaDisplay}"
                                                   Style="{StaticResource SheetTableCellStyle}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="4" Text="{Binding UsedAreaDisplay}"
                                                   Style="{StaticResource SheetTableCellStyle}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="5" Text="{Binding OffcutAreaDisplay}"
                                                   Style="{StaticResource SheetTableCellStyle}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="6" Text="{Binding WastageAreaDisplay}"
                                                   Style="{StaticResource SheetTableCellStyle}" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource WarningBrush}"/>
                                        <TextBlock Grid.Column="7" Text="{Binding PurchaseCostDisplay}"
                                                   Style="{StaticResource SheetTableCellStyle}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="8" Text="{Binding UsedPriceDisplay}"
                                                   Style="{StaticResource SheetTableCellStyle}" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource SuccessBrush}"/>
                                        <TextBlock Grid.Column="9" Text="{Binding WastageChargeDisplay}"
                                                   Style="{StaticResource SheetTableCellStyle}" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource DangerBrush}"/>
                                        <TextBlock Grid.Column="10" Text="{Binding UsageEfficiencyDisplay}"
                                                   HorizontalAlignment="Right" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SheetTableCellStyle}">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEfficient}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" Margin="0,24,0,0"
                        Visibility="{Binding SheetBreakdown.Count, Converter={StaticResource CountToVisibilityConverter}}">
                <TextBlock Text="No sheet data found"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Add specifications in Step 5 and press REFRESH to analyze sheet profitability."
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Status -->
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="{StaticResource TextCaption}"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- ═══ STATE 2 — FULL-SCREEN SHEET DETAIL (visible when a row is
             selected) ═══ -->
        <StackPanel Visibility="{Binding HasSelectedRow, Converter={StaticResource BoolToVisibilityConverter}}">

            <!-- Toolbar: back · title -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="← BACK TO SHEET LIST"
                        Command="{Binding BackCommand}"
                        Style="{StaticResource OutlinedPillButton}"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        ToolTip="Return to the sheet breakdown list."/>
                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center"
                            DataContext="{Binding SelectedRow}">
                    <TextBlock Text="{Binding GlassTypeLabel}"
                               FontSize="{StaticResource TextBody}" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{Binding SpecName}"
                               FontSize="{StaticResource TextBodyLarge}" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- Detail card: accent header + two columns -->
            <Border Style="{StaticResource SheetCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource AccentBrush}"
                            CornerRadius="14,14,0,0" Padding="18,14">
                        <StackPanel DataContext="{Binding SelectedRow}">
                            <TextBlock Text="{Binding GlassTypeLabel}"
                                       FontSize="{StaticResource TextSection}" FontWeight="Bold"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                            <TextBlock Text="{Binding SpecName}"
                                       FontSize="{StaticResource TextCaption}"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                       Opacity="0.9" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding SheetSize}"
                                       FontSize="{StaticResource TextCaption}"
                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                       Opacity="0.9" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="18,8,18,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Column A: sheet usage -->
                        <StackPanel Grid.Column="0" DataContext="{Binding SelectedRow}">
                            <TextBlock Text="1 · SHEET USAGE" Style="{StaticResource SheetHeadingStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Sheet size" Style="{StaticResource SheetKvLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SheetSize}" Style="{StaticResource SheetKvValueStyle}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Sheets purchased" Style="{StaticResource SheetKvLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SheetsPurchasedDisplay}" Style="{StaticResource SheetKvValueStyle}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Price per SQM" Style="{StaticResource SheetKvLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding PricePerSqmDisplay}" Style="{StaticResource SheetKvValueStyle}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Total area (bought)" Style="{StaticResource SheetKvLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding TotalSheetAreaDisplay}" Style="{StaticResource SheetKvValueStyle}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Used area (cut)" Style="{StaticResource SheetKvLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding UsedAreaDisplay}" Style="{StaticResource SheetKvValueStyle}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Offcut area" Style="{StaticResource SheetKvLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding OffcutAreaDisplay}" Style="{StaticResource SheetKvValueStyle}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Wastage area (Step 6)" Style="{StaticResource SheetKvLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding WastageAreaDisplay}" Style="{StaticResource SheetKvValueStyle}"
                                           Foreground="{DynamicResource WarningBrush}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Usage efficiency" Style="{StaticResource SheetKvLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding UsageEfficiencyDisplay}" Style="{StaticResource SheetKvValueStyle}"/>
                            </Grid>
                        </StackPanel>

                        <!-- Column B: sheet price reconciliation -->
                        <StackPanel Grid.Column="2" DataContext="{Binding SelectedRow}">
                            <TextBlock Text="2 · SHEET PRICE RECONCILIATION" Style="{StaticResource SheetHeadingStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Total sheet price" Style="{StaticResource SheetKvLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding PurchaseCostDisplay}" Style="{StaticResource SheetKvValueStyle}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Used sheet price" Style="{StaticResource SheetKvLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding UsedPriceDisplay}" Style="{StaticResource SheetKvValueStyle}"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Offcut value" Style="{StaticResource SheetKvLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding OffcutPriceDisplay}" Style="{StaticResource SheetKvValueStyle}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Wastage sheet price" Style="{StaticResource SheetKvLabelStyle}"/>
                                <TextBlock Grid.Column="1" Text="{Binding WastageChargeDisplay}" Style="{StaticResource SheetKvValueStyle}"
                                           Foreground="{DynamicResource DangerBrush}"/>
                            </Grid>

                            <!-- Comparison box -->
                            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,10" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="COMPARISON" Style="{StaticResource SheetCaptionStyle}" Margin="0,0,0,6"/>
                                    <TextBlock FontSize="{StaticResource TextCaption}"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                               TextWrapping="Wrap">
                                        <Run Text="Used "/><Run Text="{Binding UsedPriceShareDisplay, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                                        <Run Text=" · offcut "/><Run Text="{Binding OffcutPriceShareDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text=" of the total sheet price."/>
                                    </TextBlock>
                                    <TextBlock FontSize="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,6,0,0">
                                        <Run Text="Wastage charged "/><Run Text="{Binding NetWastageVsOffcutDisplay, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/>
                                        <Run Text=" — "/><Run Text="{Binding NetWastageVsOffcutLabel, Mode=OneWay}" Foreground="{DynamicResource SecondaryForegroundBrush}"/><Run Text="."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ═══ OVERALL REPORT — JOB-LEVEL TOTALS ═══ -->
            <Border Style="{StaticResource SheetCardStyle}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="3 · OVERALL REPORT — ALL SHEETS" Style="{StaticResource SheetHeadingStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="TOTAL SHEET PRICE" Style="{StaticResource SheetCaptionStyle}"/>
                            <TextBlock Text="{Binding TotalPurchaseCostDisplay}" Style="{StaticResource SheetKpiValueStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="USED SHEET PRICE" Style="{StaticResource SheetCaptionStyle}"/>
                            <TextBlock Text="{Binding TotalUsedPriceDisplay}" Style="{StaticResource SheetKpiValueStyle}"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="16,0,0,0">
                            <TextBlock Text="OFFCUT VALUE" Style="{StaticResource SheetCaptionStyle}"/>
                            <TextBlock Text="{Binding TotalOffcutPriceDisplay}" Style="{StaticResource SheetKpiValueStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="16,0,0,0">
                            <TextBlock Text="WASTAGE SHEET PRICE" Style="{StaticResource SheetCaptionStyle}"/>
                            <TextBlock Text="{Binding WastageChargeDisplay}" Style="{StaticResource SheetKpiValueStyle}"
                                       Foreground="{DynamicResource DangerBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource OutlineBrush}" Margin="0,12,0,10"/>
                    <TextBlock FontSize="{StaticResource TextCaption}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               TextWrapping="Wrap">
                        <Run Text="Used "/><Run Text="{Binding UsedPriceShareDisplay, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                        <Run Text=" · offcut "/><Run Text="{Binding OffcutPriceShareDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text=" of the total sheet price. Wastage charged "/><Run Text="{Binding NetWastageVsOffcutDisplay, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/>
                        <Run Text=" — "/><Run Text="{Binding NetWastageVsOffcutLabel, Mode=OneWay}"/><Run Text="."/>
                    </TextBlock>

                    <Border Height="1" Background="{DynamicResource OutlineBrush}" Margin="0,10,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SHEETS" Style="{StaticResource SheetCaptionStyle}"/>
                            <TextBlock Text="{Binding TotalSheetsPurchasedDisplay}" Style="{StaticResource SheetKpiValueStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="TOTAL AREA" Style="{StaticResource SheetCaptionStyle}"/>
                            <TextBlock Text="{Binding TotalSheetAreaDisplay}" Style="{StaticResource SheetKpiValueStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="16,0,0,0">
                            <TextBlock Text="USED AREA" Style="{StaticResource SheetCaptionStyle}"/>
                            <TextBlock Text="{Binding TotalUsedAreaDisplay}" Style="{StaticResource SheetKpiValueStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="16,0,0,0">
                            <TextBlock Text="WASTAGE AREA" Style="{StaticResource SheetCaptionStyle}"/>
                            <TextBlock Text="{Binding WastageAreaDisplay}" Style="{StaticResource SheetKpiValueStyle}"
                                       Foreground="{DynamicResource WarningBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Margin="16,0,0,0">
                            <TextBlock Text="EFFICIENCY" Style="{StaticResource SheetCaptionStyle}"/>
                            <TextBlock Text="{Binding UsageEfficiencyDisplay}" Style="{StaticResource SheetKpiValueStyle}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Loading overlay -->
        <Border Background="#80000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Analyzing..."
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
