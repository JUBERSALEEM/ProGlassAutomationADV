<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step2ProjectSpecs.ProjectSpecsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ══════════════════════════════════════════════════════════════
             FIELD LABEL — matches Step 1 (11px SemiBold UPPERCASE muted)
        ══════════════════════════════════════════════════════════════ -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,8"/>
        </Style>

        <!-- ══════════════════════════════════════════════════════════════
             NOTE: TextBoxes inherit the GLOBAL App.xaml style
             (Height=38, CornerRadius=8, focus glow, hover indigo tint).
             Custom DarkInputStyle removed for consistency across all steps.
        ══════════════════════════════════════════════════════════════ -->

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24,20,32,20">
        <StackPanel>

            <!-- ══════════════════════════════════════════════════════════
                 STEP HEADER
            ══════════════════════════════════════════════════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <!-- Icon badge — 44×44 indigo with subtle glow -->
                <Border Background="#4338CA"
                        Width="44" Height="44"
                        CornerRadius="12"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12"
                                          ShadowDepth="2"
                                          Direction="270"
                                          Color="#4338CA"
                                          Opacity="0.30"/>
                    </Border.Effect>
                    <!-- Segoe MDL2 construction / project icon -->
                    <TextBlock Text="&#xE8A5;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Project Specifications"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="Specify details about the building project, glazing site and local procurement numbers."
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <!-- Divider -->
            <Border Background="{DynamicResource BorderBrush}"
                    Height="1"
                    Margin="0,20,0,24"/>

            <!-- ══════════════════════════════════════════════════════════
                 PROJECT FIELDS — 2×2 grid
            ══════════════════════════════════════════════════════════ -->

            <!-- Row 1: Project Identifier Name + Project / Contract No -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="PROJECT IDENTIFIER NAME"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding ProjectIdentifierName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="PROJECT / CONTRACT NO"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding ProjectContractNo, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>

            <!-- Row 2: Site / Delivery Location + LPO / Purchase Order No -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="SITE / DELIVERY LOCATION"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding SiteDeliveryLocation, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="LPO / PURCHASE ORDER NO"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding LpoNumber, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>