<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step3ClientProfile.ClientProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- Field label — matches Step 1/2 -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,8"/>
        </Style>

        <!-- Subsection label — smaller, colored, groups related fields -->
        <Style x:Key="SubsectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#4338CA"/>
            <Setter Property="Margin"     Value="0,0,0,12"/>
        </Style>

        <!-- Global App.xaml TextBox style takes over for all inputs -->

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24,20,32,20">
        <StackPanel>

            <!-- ══════════════════════════════════════════════════════════
                 STEP HEADER
            ══════════════════════════════════════════════════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <!-- Icon badge — 44×44 indigo with glow -->
                <Border Background="#4338CA"
                        Width="44" Height="44"
                        CornerRadius="12"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12"
                                          ShadowDepth="2"
                                          Direction="270"
                                          Color="#4338CA"
                                          Opacity="0.30"/>
                    </Border.Effect>
                    <!-- Segoe MDL2 contact / person icon -->
                    <TextBlock Text="&#xE77B;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Client Profile &amp; References"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text="Input client credentials, billing addresses and responsible account executives."
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <!-- Divider -->
            <Border Background="{DynamicResource BorderBrush}"
                    Height="1"
                    Margin="0,20,0,24"/>

            <!-- ══════════════════════════════════════════════════════════
                 SECTION 1 — CUSTOMER IDENTITY
            ══════════════════════════════════════════════════════════ -->
            <TextBlock Text="CUSTOMER IDENTITY"
                       Style="{StaticResource SubsectionLabelStyle}"/>

            <!-- Row 1: Customer Name + Customer TRN -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="CUSTOMER / BILL TO NAME"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="CUSTOMER TRN"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding CustomerTrn, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>

            <!-- Row 2: Reference Code + Sales Representative -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="CUSTOMER REFERENCE CODE"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding CustomerReferenceCode, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="RESPONSIBLE SALES REPRESENTATIVE"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding SalesRepresentative, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>

            <!-- Row 3: Document Prepared By (single field) -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="DOCUMENT PREPARED BY"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding DocumentPreparedBy, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <!-- Right column intentionally blank -->
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 SECTION 2 — BILLING & CONTACT
            ══════════════════════════════════════════════════════════ -->
            <TextBlock Text="BILLING &amp; CONTACT"
                       Style="{StaticResource SubsectionLabelStyle}"/>

            <!-- Row 4: Billing Address (full width) -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="BILLING / REGISTERED ADDRESS"
                           Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Text="{Binding BillingAddress, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <!-- Row 5: Attention + Contact Phone -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="ATTENTION EXECUTIVE NAME"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding AttentionExecutiveName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="CLIENT CONTACT MOBILE / TEL"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding ClientContactPhone, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>