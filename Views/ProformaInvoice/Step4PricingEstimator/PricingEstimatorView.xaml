<!--
═══════════════════════════════════════════════════════════════════════
FILE: Views/ProformaInvoice/Step4PricingEstimator/PricingEstimatorView.xaml
═══════════════════════════════════════════════════════════════════════
CHAT 17 — PERFORMANCE + UI POLISH
  PERF-01: Removed DropShadowEffect from Step Header Icon.
  PERF-02: Removed DropShadowEffect from Estimated Rate card.
           BorderThickness increased to 2 to maintain emphasis.
  UI-01:   Target Groups header icon updated to solid #4338CA / White.
  REMOVED: Configure Processing Treatments section removed entirely.
           PolishedEdges, DrillCutouts, CountersunkHoles, EdgeDeletionLayer
           checkboxes no longer appear on this step or any sub-view.
═══════════════════════════════════════════════════════════════════════
-->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.PricingEstimatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sgu="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.SguParameters"
             xmlns:dgu="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.DguParameters"
             xmlns:lam="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.LamParameters"
             xmlns:dgulam="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.DguLamParameters"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="900"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- Section title inside sub-cards -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#4338CA"/>
            <Setter Property="Margin"     Value="0,0,0,12"/>
        </Style>

        <!--
            ThemedCheckBoxStyle kept in resources — used by sub-views
            (SguParametersView, DguParametersView, etc.) via StaticResource.
            Do NOT remove this style even though the Processing Treatments
            section has been removed from this parent view.
        -->
        <Style x:Key="ThemedCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground"               Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="FontSize"                  Value="12"/>
            <Setter Property="FontWeight"                Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment"  Value="Center"/>
            <Setter Property="Cursor"                    Value="Hand"/>
            <Setter Property="Padding"                   Value="8,0,0,0"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24,20,32,20">
        <StackPanel>

            <!-- ══════════════════════════════════════════════════════════
                 STEP HEADER
            ══════════════════════════════════════════════════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <!-- PERF-01: DropShadowEffect removed -->
                <Border Background="#4338CA"
                        Width="44"
                        Height="44"
                        CornerRadius="12"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE8EF;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Smart Pricing Estimator"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock
                        Text="Pick glass structure, configure factors and apply computed rates to specifications."
                        FontSize="12"
                        Foreground="{DynamicResource SecondaryForegroundBrush}"
                        Margin="0,4,0,0"
                        TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <!-- Divider -->
            <Border Background="{DynamicResource BorderBrush}"
                    Height="1"
                    Margin="0,20,0,20"/>

            <!-- ══════════════════════════════════════════════════════════
                 GLASS TYPE CARDS — 4 columns × 1 row
                 Each type has its own saturated accent color for identity
            ══════════════════════════════════════════════════════════ -->
            <ItemsControl ItemsSource="{Binding GlassTypes}" Margin="0,0,0,14">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectGlassTypeCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Margin="5"
                                HorizontalContentAlignment="Stretch"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CardBorder"
                                            Background="{DynamicResource ModuleBackgroundBrush}"
                                            CornerRadius="14"
                                            Padding="14"
                                            BorderThickness="2"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            SnapsToDevicePixels="True">
                                        <StackPanel>

                                            <!-- Icon badge + code -->
                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,0,0,10">
                                                <Border x:Name="IconBorder"
                                                        Width="32"
                                                        Height="32"
                                                        CornerRadius="8"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#4338CA"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Code}" Value="DGU">
                                                                    <Setter Property="Background" Value="#7C3AED"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Code}" Value="LAM">
                                                                    <Setter Property="Background" Value="#047857"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Code}" Value="DGU+LAM">
                                                                    <Setter Property="Background" Value="#B45309"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Icon}"
                                                               FontSize="15"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding Code}"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0,0,0"/>
                                            </StackPanel>

                                            <!-- Description -->
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,10"
                                                       MaxHeight="48"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <!-- Status badge -->
                                            <Border x:Name="StatusBadge"
                                                    CornerRadius="6"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource MenuHoverBrush}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="StatusIcon"
                                                               Text="&#xE73E;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="9"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,5,0"
                                                               Visibility="Collapsed"/>
                                                    <TextBlock x:Name="StatusText"
                                                               Text="SELECT"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                                </StackPanel>
                                            </Border>

                                        </StackPanel>
                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <!-- Hover (unselected only) -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver,
                                                    RelativeSource={RelativeSource Self}}"
                                                           Value="True"/>
                                                <Condition Binding="{Binding IsSelected}"
                                                           Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="CardBorder"
                                                    Property="Background"
                                                    Value="{DynamicResource MenuHoverBrush}"/>
                                            <Setter TargetName="CardBorder"
                                                    Property="BorderBrush"
                                                    Value="#6366F1"/>
                                        </MultiDataTrigger>

                                        <!-- SGU selected — deep indigo -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                <Condition Binding="{Binding Code}" Value="SGU"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#4338CA"/>
                                            <Setter TargetName="StatusBadge" Property="Background" Value="#4338CA"/>
                                            <Setter TargetName="StatusText" Property="Text" Value="ACTIVE"/>
                                            <Setter TargetName="StatusText" Property="Foreground" Value="White"/>
                                            <Setter TargetName="StatusIcon" Property="Foreground" Value="White"/>
                                            <Setter TargetName="StatusIcon" Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>

                                        <!-- DGU selected — deep purple -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                <Condition Binding="{Binding Code}" Value="DGU"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#7C3AED"/>
                                            <Setter TargetName="StatusBadge" Property="Background" Value="#7C3AED"/>
                                            <Setter TargetName="StatusText" Property="Text" Value="ACTIVE"/>
                                            <Setter TargetName="StatusText" Property="Foreground" Value="White"/>
                                            <Setter TargetName="StatusIcon" Property="Foreground" Value="White"/>
                                            <Setter TargetName="StatusIcon" Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>

                                        <!-- LAM selected — deep forest green -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                <Condition Binding="{Binding Code}" Value="LAM"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#047857"/>
                                            <Setter TargetName="StatusBadge" Property="Background" Value="#047857"/>
                                            <Setter TargetName="StatusText" Property="Text" Value="ACTIVE"/>
                                            <Setter TargetName="StatusText" Property="Foreground" Value="White"/>
                                            <Setter TargetName="StatusIcon" Property="Foreground" Value="White"/>
                                            <Setter TargetName="StatusIcon" Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>

                                        <!-- DGU+LAM selected — dark amber -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                <Condition Binding="{Binding Code}" Value="DGU+LAM"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#B45309"/>
                                            <Setter TargetName="StatusBadge" Property="Background" Value="#B45309"/>
                                            <Setter TargetName="StatusText" Property="Text" Value="ACTIVE"/>
                                            <Setter TargetName="StatusText" Property="Foreground" Value="White"/>
                                            <Setter TargetName="StatusIcon" Property="Foreground" Value="White"/>
                                            <Setter TargetName="StatusIcon" Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>

                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ══════════════════════════════════════════════════════════
                 SGU / DGU / LAM / DGU+LAM PARAMETER PANELS
            ══════════════════════════════════════════════════════════ -->
            <ContentControl Content="{Binding SguVM}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGlassType.Code}"
                                         Value="SGU">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <sgu:SguParametersView/>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <ContentControl Content="{Binding DguVM}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGlassType.Code}"
                                         Value="DGU">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <dgu:DguParametersView/>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <ContentControl Content="{Binding LamVM}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGlassType.Code}"
                                         Value="LAM">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <lam:LamParametersView/>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <ContentControl Content="{Binding DguLamVM}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGlassType.Code}"
                                         Value="DGU+LAM">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <dgulam:DguLamParametersView/>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <!-- ══════════════════════════════════════════════════════════
                 SELECT SPECIFICATION TARGET GROUPS
            ══════════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    CornerRadius="16"
                    Padding="20"
                    Margin="0,14,0,0"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}">
                <StackPanel>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <!-- UI-01: Solid #4338CA / White -->
                            <Border Background="#4338CA"
                                    Width="26"
                                    Height="26"
                                    CornerRadius="8"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0">
                                <TextBlock Text="&#xE762;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Select Specification Target Groups"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Active: "
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       VerticalAlignment="Center"/>
                            <Border Background="#4338CA"
                                    CornerRadius="10"
                                    Padding="10,3"
                                    MinWidth="36"
                                    Margin="6,0,0,0">
                                <TextBlock Text="{Binding TotalSpecsActive}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Spec group pills -->
                    <ItemsControl ItemsSource="{Binding SpecGroups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ToggleSpecGroupCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Margin="0,0,8,8"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="PillBorder"
                                                    CornerRadius="18"
                                                    Padding="14,7"
                                                    BorderThickness="1.5"
                                                    SnapsToDevicePixels="True">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="CheckIcon"
                                                               Text="&#xE73E;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,6,0"/>
                                                    <TextBlock x:Name="NameText"
                                                               Text="{Binding Name}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>

                                                <!-- Selected: indigo fill, white text -->
                                                <DataTrigger Binding="{Binding IsSelected}"
                                                             Value="True">
                                                    <Setter TargetName="PillBorder"
                                                            Property="Background"
                                                            Value="#4338CA"/>
                                                    <Setter TargetName="PillBorder"
                                                            Property="BorderBrush"
                                                            Value="#4338CA"/>
                                                    <Setter TargetName="CheckIcon"
                                                            Property="Foreground"
                                                            Value="White"/>
                                                    <Setter TargetName="NameText"
                                                            Property="Foreground"
                                                            Value="White"/>
                                                    <Setter TargetName="CheckIcon"
                                                            Property="Visibility"
                                                            Value="Visible"/>
                                                </DataTrigger>

                                                <!-- Unselected: outlined -->
                                                <DataTrigger Binding="{Binding IsSelected}"
                                                             Value="False">
                                                    <Setter TargetName="PillBorder"
                                                            Property="Background"
                                                            Value="Transparent"/>
                                                    <Setter TargetName="PillBorder"
                                                            Property="BorderBrush"
                                                            Value="{DynamicResource BorderBrush}"/>
                                                    <Setter TargetName="CheckIcon"
                                                            Property="Foreground"
                                                            Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                    <Setter TargetName="NameText"
                                                            Property="Foreground"
                                                            Value="{DynamicResource PrimaryForegroundBrush}"/>
                                                    <Setter TargetName="CheckIcon"
                                                            Property="Visibility"
                                                            Value="Collapsed"/>
                                                </DataTrigger>

                                                <!-- Hover unselected -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver,
                                                            RelativeSource={RelativeSource Self}}"
                                                                   Value="True"/>
                                                        <Condition Binding="{Binding IsSelected}"
                                                                   Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="PillBorder"
                                                            Property="Background"
                                                            Value="#EEF2FF"/>
                                                    <Setter TargetName="PillBorder"
                                                            Property="BorderBrush"
                                                            Value="#4338CA"/>
                                                </MultiDataTrigger>

                                                <!-- Hover selected -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver,
                                                            RelativeSource={RelativeSource Self}}"
                                                                   Value="True"/>
                                                        <Condition Binding="{Binding IsSelected}"
                                                                   Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="PillBorder"
                                                            Property="Background"
                                                            Value="#6366F1"/>
                                                    <Setter TargetName="PillBorder"
                                                            Property="BorderBrush"
                                                            Value="#6366F1"/>
                                                </MultiDataTrigger>

                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 ESTIMATED RATE + APPLY BUTTON
            ══════════════════════════════════════════════════════════ -->
            <!-- PERF-02: DropShadowEffect removed. BorderThickness=2. -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    CornerRadius="16"
                    Padding="20"
                    Margin="0,14,0,0"
                    BorderThickness="2"
                    BorderBrush="#4338CA">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: estimated rate display -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="ESTIMATED RATE"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="AED"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#047857"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,6,4"/>
                            <TextBlock Text="{Binding EstimatedRatePerSqm,
                                           StringFormat={}{0:N2}}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#047857"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text=" / sqm"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       VerticalAlignment="Bottom"
                                       Margin="6,0,0,6"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: apply button -->
                    <Button Grid.Column="1"
                            Command="{Binding ApplyRateCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ApplyBorder"
                                        Background="#4338CA"
                                        CornerRadius="22"
                                        Padding="24,0"
                                        Height="44"
                                        SnapsToDevicePixels="True">
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="&#xE73E;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <TextBlock Text="APPLY RATE TO SELECTED SPECS"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ApplyBorder"
                                                Property="Background"
                                                Value="#6366F1"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ApplyBorder"
                                                Property="Background"
                                                Value="#3730A3"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="ApplyBorder"
                                                Property="Opacity"
                                                Value="0.4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>