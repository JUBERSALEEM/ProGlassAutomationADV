<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.PricingEstimatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sgu="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.SguParameters"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="900"
             FontFamily="Segoe UI">

    <!-- ============ SHARED STYLES ============ -->
    <UserControl.Resources>

        <!-- Section Title -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Themed Checkbox -->
        <Style x:Key="ThemedCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,10,0">
        <StackPanel>

            <!-- ============ HEADER ============ -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,8">
                <Border Background="{DynamicResource AccentBrush}"
                        Width="36" Height="36"
                        CornerRadius="8"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#9881;"
                               FontSize="18"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="SMART PRICING ESTIMATOR CONSOLE"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"/>
            </StackPanel>

            <TextBlock Text="Pick the glass layer structure (SGU / DGU / LAM / DGU+LAM), configure factors, and apply live computed rates to specifications."
                       FontSize="13"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       Margin="0,0,0,20"
                       TextWrapping="Wrap"/>

            <Border Background="{DynamicResource MenuHoverBrush}"
                    Height="1"
                    Margin="0,0,0,24"/>

            <!-- ============ GLASS TYPE CARDS (2x2 grid) ============ -->
            <ItemsControl ItemsSource="{Binding GlassTypes}"
                          Margin="0,0,0,20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" Rows="0"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectGlassTypeCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Margin="6"
                                HorizontalContentAlignment="Stretch"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CardBorder"
                                            Background="{DynamicResource ModuleBackgroundBrush}"
                                            CornerRadius="12"
                                            Padding="18"
                                            BorderThickness="2"
                                            BorderBrush="{DynamicResource MenuHoverBrush}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,0,0,10">
                                                <Border x:Name="IconBorder"
                                                        Width="34" Height="34"
                                                        CornerRadius="8"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#6366F1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Code}" Value="DGU">
                                                                    <Setter Property="Background" Value="#A855F7"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Code}" Value="LAM">
                                                                    <Setter Property="Background" Value="#22C55E"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Code}" Value="DGU+LAM">
                                                                    <Setter Property="Background" Value="#F97316"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Icon}"
                                                               FontSize="16"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,12"/>
                                            <Border x:Name="StatusBadge"
                                                    CornerRadius="6"
                                                    Padding="10,5"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource MenuHoverBrush}">
                                                <TextBlock x:Name="StatusText"
                                                           Text="Select"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                <Condition Binding="{Binding IsSelected}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="CardBorder" Property="BorderBrush"
                                                    Value="{DynamicResource SecondaryForegroundBrush}"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                <Condition Binding="{Binding Code}" Value="SGU"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#6366F1"/>
                                            <Setter TargetName="StatusBadge" Property="Background" Value="#6366F1"/>
                                            <Setter TargetName="StatusText" Property="Text" Value="✓ Active Estimator"/>
                                            <Setter TargetName="StatusText" Property="Foreground" Value="White"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                <Condition Binding="{Binding Code}" Value="DGU"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#A855F7"/>
                                            <Setter TargetName="StatusBadge" Property="Background" Value="#A855F7"/>
                                            <Setter TargetName="StatusText" Property="Text" Value="✓ Active Estimator"/>
                                            <Setter TargetName="StatusText" Property="Foreground" Value="White"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                <Condition Binding="{Binding Code}" Value="LAM"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#22C55E"/>
                                            <Setter TargetName="StatusBadge" Property="Background" Value="#22C55E"/>
                                            <Setter TargetName="StatusText" Property="Text" Value="✓ Active Estimator"/>
                                            <Setter TargetName="StatusText" Property="Foreground" Value="White"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                <Condition Binding="{Binding Code}" Value="DGU+LAM"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#F97316"/>
                                            <Setter TargetName="StatusBadge" Property="Background" Value="#F97316"/>
                                            <Setter TargetName="StatusText" Property="Text" Value="✓ Active Estimator"/>
                                            <Setter TargetName="StatusText" Property="Foreground" Value="White"/>
                                        </MultiDataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ============ SGU PARAMETERS PANEL ============ -->
            <ContentControl Content="{Binding SguVM}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGlassType.Code}" Value="SGU">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <sgu:SguParametersView/>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <!-- ============ DGU / LAM / DGU+LAM PLACEHOLDERS ============ -->
            <Border Margin="0,10,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGlassType.Code}" Value="DGU">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border Background="{DynamicResource MenuHoverBrush}"
                        CornerRadius="8" Padding="20,14" HorizontalAlignment="Left">
                    <TextBlock Text="DGU parameters panel — coming in Phase 6.6"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </Border>
            </Border>

            <Border Margin="0,10,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGlassType.Code}" Value="LAM">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border Background="{DynamicResource MenuHoverBrush}"
                        CornerRadius="8" Padding="20,14" HorizontalAlignment="Left">
                    <TextBlock Text="LAM parameters panel — coming in Phase 6.7"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </Border>
            </Border>

            <Border Margin="0,10,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGlassType.Code}" Value="DGU+LAM">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border Background="{DynamicResource MenuHoverBrush}"
                        CornerRadius="8" Padding="20,14" HorizontalAlignment="Left">
                    <TextBlock Text="DGU+LAM hybrid parameters — will be added in a future update"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </Border>
            </Border>

            <!-- ============ CONFIGURE PROCESSING TREATMENTS ============ -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,16,0,0"
                    BorderThickness="1.5"
                    BorderBrush="{DynamicResource MenuHoverBrush}">
                <StackPanel>
                    <TextBlock Text="CONFIGURE PROCESSING TREATMENTS"
                               Style="{StaticResource SectionTitleStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Polished Edges"
                                  IsChecked="{Binding PolishedEdges}"
                                  Style="{StaticResource ThemedCheckBoxStyle}"/>
                        <CheckBox Grid.Column="1" Content="Drill Cutouts"
                                  IsChecked="{Binding DrillCutouts}"
                                  Style="{StaticResource ThemedCheckBoxStyle}"/>
                        <CheckBox Grid.Column="2" Content="Countersunk Holes"
                                  IsChecked="{Binding CountersunkHoles}"
                                  Style="{StaticResource ThemedCheckBoxStyle}"/>
                        <CheckBox Grid.Column="3" Content="Edge Deletion Layer"
                                  IsChecked="{Binding EdgeDeletionLayer}"
                                  Style="{StaticResource ThemedCheckBoxStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ SELECT SPECIFICATION TARGET GROUPS ============ -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,16,0,0"
                    BorderThickness="1.5"
                    BorderBrush="{DynamicResource MenuHoverBrush}">
                <StackPanel>

                    <!-- Title + Counter Row -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="SELECT SPECIFICATION TARGET GROUPS"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Total Specs Active: "
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalSpecsActive}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Pill Buttons — one per Spec Group -->
                    <ItemsControl ItemsSource="{Binding SpecGroups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ToggleSpecGroupCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Margin="0,0,8,8"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="PillBorder"
                                                    CornerRadius="20"
                                                    Padding="16,8"
                                                    BorderThickness="1.5">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="CheckIcon"
                                                               Text="✓"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,6,0"/>
                                                    <TextBlock x:Name="NameText"
                                                               Text="{Binding Name}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- Selected State (filled) -->
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="PillBorder" Property="Background"
                                                            Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="PillBorder" Property="BorderBrush"
                                                            Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="CheckIcon" Property="Foreground" Value="White"/>
                                                    <Setter TargetName="NameText" Property="Foreground" Value="White"/>
                                                    <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <!-- Unselected State (outlined) -->
                                                <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                                    <Setter TargetName="PillBorder" Property="Background"
                                                            Value="Transparent"/>
                                                    <Setter TargetName="PillBorder" Property="BorderBrush"
                                                            Value="{DynamicResource MenuHoverBrush}"/>
                                                    <Setter TargetName="CheckIcon" Property="Foreground"
                                                            Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                    <Setter TargetName="NameText" Property="Foreground"
                                                            Value="{DynamicResource PrimaryForegroundBrush}"/>
                                                    <Setter TargetName="CheckIcon" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <!-- Hover -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="PillBorder" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

            <!-- Placeholder for final section -->
            <Border Background="{DynamicResource MenuHoverBrush}"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left">
                <TextBlock Text="✓ Spec Target Groups complete — Estimated Rate bar + APPLY button coming next (final SGU sub-phase)"
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>