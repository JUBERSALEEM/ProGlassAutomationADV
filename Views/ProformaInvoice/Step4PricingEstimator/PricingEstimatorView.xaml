<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.PricingEstimatorView"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sgu="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.SguParameters"
             xmlns:dgu="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.DguParameters"
             xmlns:lam="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.LamParameters"
             xmlns:dgulam="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.DguLamParameters"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <DockPanel>

        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource ModuleBackgroundBrush}"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding SguVM.GeneratedSpecName}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedGlassType.Code}" Value="DGU">
                                        <Setter Property="Text" Value="{Binding DguVM.GeneratedSpecName}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedGlassType.Code}" Value="LAM">
                                        <Setter Property="Text" Value="{Binding LamVM.GeneratedSpecName}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedGlassType.Code}" Value="DGU+LAM">
                                        <Setter Property="Text" Value="{Binding DguLamVM.GeneratedSpecName}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding SpecGroups}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ToggleSpecGroupCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0" Padding="0"
                                        Margin="0,0,8,4" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ChipBorder"
                                                    CornerRadius="{DynamicResource CardCornerRadius}"
                                                    Padding="12,6" BorderThickness="1">
                                                <TextBlock x:Name="NameText" Text="{Binding Name}"
                                                           FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                                    <Setter TargetName="ChipBorder" Property="Background" Value="Transparent"/>
                                                    <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
                                                    <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource WarningBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Text" Value=""/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding SelectedGlassType.Code}" Value="SGU"/>
                                            <Condition Binding="{Binding SguVM.HasSheetStoreHint}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Text" Value="{Binding SguVM.SheetStoreHint}"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding SelectedGlassType.Code}" Value="DGU"/>
                                            <Condition Binding="{Binding DguVM.HasSheetStoreHint}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Text" Value="{Binding DguVM.SheetStoreHint}"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding SelectedGlassType.Code}" Value="LAM"/>
                                            <Condition Binding="{Binding LamVM.HasSheetStoreHint}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Text" Value="{Binding LamVM.SheetStoreHint}"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ApplyStatusMessage}" FontSize="12"
                               Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasApplyStatus}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding YieldFactorWarning}" FontSize="12"
                               Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasYieldFactorWarning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0">
                    <TextBlock Text="ESTIMATED RATE"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               VerticalAlignment="Bottom" Margin="0,0,10,6"/>
                    <TextBlock Text="AED"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               VerticalAlignment="Bottom" Margin="0,0,6,4"/>
                    <TextBlock Text="{Binding EstimatedRatePerSqm, StringFormat={}{0:N2}}"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text=" /sqm"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               VerticalAlignment="Bottom" Margin="4,0,0,6"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Command="{Binding ApplyRateCommand}"
                        Style="{StaticResource PrimaryPillButton}"
                        Height="42" MinWidth="160" VerticalAlignment="Center"
                        Content="APPLY RATE"/>
            </Grid>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <ItemsControl ItemsSource="{Binding GlassTypes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectGlassTypeCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                Margin="0,0,8,0" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                ToolTip="{Binding Description}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Card"
                                            Background="{DynamicResource ModuleBackgroundBrush}"
                                            BorderBrush="{DynamicResource OutlineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource CardCornerRadius}"
                                            Padding="12,8"
                                            Height="40">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="CodeText" Text="{Binding Code}"
                                                       FontSize="13" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                                            <TextBlock x:Name="TitleText" Text="{Binding Title}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       Margin="8,0,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource TintBlueBrush}"/>
                                            <Setter TargetName="CodeText" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid>
            <ContentControl Content="{Binding SguVM}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGlassType.Code}" Value="SGU">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ContentControl.ContentTemplate>
                    <DataTemplate><sgu:SguParametersView/></DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
            <ContentControl Content="{Binding DguVM}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGlassType.Code}" Value="DGU">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ContentControl.ContentTemplate>
                    <DataTemplate><dgu:DguParametersView/></DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
            <ContentControl Content="{Binding LamVM}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGlassType.Code}" Value="LAM">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ContentControl.ContentTemplate>
                    <DataTemplate><lam:LamParametersView/></DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
            <ContentControl Content="{Binding DguLamVM}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGlassType.Code}" Value="DGU+LAM">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ContentControl.ContentTemplate>
                    <DataTemplate><dgulam:DguLamParametersView/></DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Grid>
    </DockPanel>
</UserControl>
