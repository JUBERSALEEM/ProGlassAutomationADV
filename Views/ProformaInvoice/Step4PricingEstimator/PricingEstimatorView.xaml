<!--
═══════════════════════════════════════════════════════════════════════
FILE: Views/ProformaInvoice/Step4PricingEstimator/PricingEstimatorView.xaml
═══════════════════════════════════════════════════════════════════════
Industrial glass workbench.
  Type chips · parameter panel · sticky apply bar.
  Bindings and commands unchanged.
═══════════════════════════════════════════════════════════════════════
-->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.PricingEstimatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sgu="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.SguParameters"
             xmlns:dgu="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.DguParameters"
             xmlns:lam="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.LamParameters"
             xmlns:dgulam="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.DguLamParameters"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1100"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="ThemedCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground"               Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="FontSize"                  Value="12"/>
            <Setter Property="FontWeight"                Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment"  Value="Center"/>
            <Setter Property="Cursor"                    Value="Hand"/>
            <Setter Property="Padding"                   Value="8,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource PiStickyApplyBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="TARGET GROUPS"
                               Style="{StaticResource PiSectionLabelStyle}"
                               Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding SpecGroups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ToggleSpecGroupCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Margin="0,0,8,4"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="PillBorder"
                                                    CornerRadius="{DynamicResource CardCornerRadius}"
                                                    Padding="10,4"
                                                    BorderThickness="1"
                                                    SnapsToDevicePixels="True">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="CheckIcon"
                                                               Text="&#xE73E;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="10"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,6,0"/>
                                                    <TextBlock x:Name="NameText"
                                                               Text="{Binding Name}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="CheckIcon" Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                    <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                    <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                                    <Setter TargetName="PillBorder" Property="Background" Value="Transparent"/>
                                                    <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
                                                    <Setter TargetName="CheckIcon" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ApplyStatusMessage}"
                               FontSize="11"
                               Foreground="{DynamicResource AccentBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasApplyStatus}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding YieldFactorWarning}"
                               FontSize="11"
                               Foreground="{DynamicResource WarningBrush}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasYieldFactorWarning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="16,0">
                    <TextBlock Text="ESTIMATED RATE"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="AED"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,6,2"/>
                        <TextBlock Text="{Binding EstimatedRatePerSqm, StringFormat={}{0:N2}}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}"/>
                        <TextBlock Text=" /sqm"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="4,0,0,4"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2"
                        Command="{Binding ApplyRateCommand}"
                        Style="{StaticResource PiFooterPrimaryButton}"
                        Height="36"
                        MinWidth="140"
                        VerticalAlignment="Center"
                        ToolTip="Save this specification and apply the rate to the selected groups">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="APPLY RATE"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource PiWorkSurfaceStyle}" Padding="10,8" Margin="0,0,0,8">
            <ItemsControl ItemsSource="{Binding GlassTypes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectGlassTypeCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Margin="3,0"
                                HorizontalContentAlignment="Stretch"
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}"
                                ToolTip="{Binding Description}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Chip"
                                            Background="Transparent"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Height="32"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource OutlineBrush}"
                                            SnapsToDevicePixels="True">
                                        <TextBlock x:Name="CodeText"
                                                   Text="{Binding Code}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="CodeText" Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <ContentControl Content="{Binding SguVM}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedGlassType.Code}" Value="SGU">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <sgu:SguParametersView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <ContentControl Content="{Binding DguVM}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedGlassType.Code}" Value="DGU">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <dgu:DguParametersView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <ContentControl Content="{Binding LamVM}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedGlassType.Code}" Value="LAM">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <lam:LamParametersView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <ContentControl Content="{Binding DguLamVM}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedGlassType.Code}" Value="DGU+LAM">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <dgulam:DguLamParametersView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
