<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.PricingEstimatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sgu="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.SguParameters"
             xmlns:dgu="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.DguParameters"
             xmlns:lam="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.LamParameters"
             xmlns:dgulam="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.DguLamParameters"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="ThemedCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground"               Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="FontSize"                  Value="12"/>
            <Setter Property="FontWeight"                Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment"  Value="Center"/>
            <Setter Property="Cursor"                    Value="Hand"/>
            <Setter Property="Padding"                   Value="8,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>

        <!-- Mockup apply bar: spec left · rate · APPLY RATE -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource PiStickyApplyBarStyle}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding SguVM.GeneratedSpecName}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedGlassType.Code}" Value="DGU">
                                        <Setter Property="Text" Value="{Binding DguVM.GeneratedSpecName}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedGlassType.Code}" Value="LAM">
                                        <Setter Property="Text" Value="{Binding LamVM.GeneratedSpecName}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedGlassType.Code}" Value="DGU+LAM">
                                        <Setter Property="Text" Value="{Binding DguLamVM.GeneratedSpecName}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding SpecGroups}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ToggleSpecGroupCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0" Padding="0"
                                        Margin="0,0,6,0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="PillBorder" CornerRadius="10" Padding="8,3" BorderThickness="1">
                                                <TextBlock x:Name="NameText" Text="{Binding Name}"
                                                           FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                                    <Setter TargetName="PillBorder" Property="Background" Value="Transparent"/>
                                                    <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
                                                    <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ApplyStatusMessage}" FontSize="11"
                               Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasApplyStatus}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding YieldFactorWarning}" FontSize="11"
                               Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasYieldFactorWarning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="ESTIMATED RATE"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               VerticalAlignment="Bottom" Margin="0,0,10,4"/>
                    <TextBlock Text="AED"
                               FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               VerticalAlignment="Bottom" Margin="0,0,6,3"/>
                    <TextBlock Text="{Binding EstimatedRatePerSqm, StringFormat={}{0:N2}}"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    <TextBlock Text=" /sqm"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               VerticalAlignment="Bottom" Margin="4,0,0,5"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Command="{Binding ApplyRateCommand}"
                        Style="{StaticResource PiFooterPrimaryButton}"
                        Height="40" MinWidth="150" VerticalAlignment="Center">
                    <TextBlock Text="APPLY RATE"
                               FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource OnAccentForegroundBrush}"/>
                </Button>
            </Grid>
        </Border>

        <!-- Type chips — mockup pills, not a card -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <ItemsControl ItemsSource="{Binding GlassTypes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectGlassTypeCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                Margin="0,0,8,0" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                ToolTip="{Binding Description}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Chip"
                                            Background="Transparent"
                                            CornerRadius="14"
                                            Height="28"
                                            Padding="16,0"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource OutlineBrush}">
                                        <TextBlock x:Name="CodeText" Text="{Binding Code}"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="CodeText" Property="Foreground" Value="{DynamicResource OnAccentForegroundBrush}"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid>
            <ContentControl Content="{Binding SguVM}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGlassType.Code}" Value="SGU">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <sgu:SguParametersView/>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
            <ContentControl Content="{Binding DguVM}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGlassType.Code}" Value="DGU">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <dgu:DguParametersView/>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
            <ContentControl Content="{Binding LamVM}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGlassType.Code}" Value="LAM">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <lam:LamParametersView/>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
            <ContentControl Content="{Binding DguLamVM}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGlassType.Code}" Value="DGU+LAM">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <dgulam:DguLamParametersView/>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Grid>
    </DockPanel>
</UserControl>
