<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.PricingEstimatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sgu="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.SguParameters"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="900"
             FontFamily="Segoe UI">

    <!-- ============ SHARED STYLES ============ -->
    <UserControl.Resources>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ThemedCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,0,0,0"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel>

            <!-- ============ COMPACT HEADER ============ -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,6">
                <Border Background="{DynamicResource AccentBrush}"
                        Width="28" Height="28"
                        CornerRadius="6"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#9881;"
                               FontSize="14"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="SMART PRICING ESTIMATOR"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </StackPanel>

            <TextBlock Text="Pick glass structure, configure factors, apply computed rates to specifications."
                       FontSize="11"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       Margin="0,0,0,12"
                       TextWrapping="Wrap"/>

            <Border Background="{DynamicResource MenuHoverBrush}"
                    Height="1"
                    Margin="0,0,0,14"/>

            <!-- ============ COMPACT GLASS TYPE CARDS (4 columns, 1 row) ============ -->
            <ItemsControl ItemsSource="{Binding GlassTypes}"
                          Margin="0,0,0,12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectGlassTypeCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Margin="4"
                                HorizontalContentAlignment="Stretch"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CardBorder"
                                            Background="{DynamicResource ModuleBackgroundBrush}"
                                            CornerRadius="10"
                                            Padding="10"
                                            BorderThickness="2"
                                            BorderBrush="{DynamicResource MenuHoverBrush}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,0,0,6">
                                                <Border x:Name="IconBorder"
                                                        Width="26" Height="26"
                                                        CornerRadius="6"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#6366F1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Code}" Value="DGU">
                                                                    <Setter Property="Background" Value="#A855F7"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Code}" Value="LAM">
                                                                    <Setter Property="Background" Value="#22C55E"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Code}" Value="DGU+LAM">
                                                                    <Setter Property="Background" Value="#F97316"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Icon}"
                                                               FontSize="13"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding Code}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,8"
                                                       MaxHeight="45"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border x:Name="StatusBadge"
                                                    CornerRadius="4"
                                                    Padding="6,3"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource MenuHoverBrush}">
                                                <TextBlock x:Name="StatusText"
                                                           Text="Select"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                <Condition Binding="{Binding IsSelected}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="CardBorder" Property="BorderBrush"
                                                    Value="{DynamicResource SecondaryForegroundBrush}"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                <Condition Binding="{Binding Code}" Value="SGU"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#6366F1"/>
                                            <Setter TargetName="StatusBadge" Property="Background" Value="#6366F1"/>
                                            <Setter TargetName="StatusText" Property="Text" Value="✓ Active"/>
                                            <Setter TargetName="StatusText" Property="Foreground" Value="White"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                <Condition Binding="{Binding Code}" Value="DGU"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#A855F7"/>
                                            <Setter TargetName="StatusBadge" Property="Background" Value="#A855F7"/>
                                            <Setter TargetName="StatusText" Property="Text" Value="✓ Active"/>
                                            <Setter TargetName="StatusText" Property="Foreground" Value="White"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                <Condition Binding="{Binding Code}" Value="LAM"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#22C55E"/>
                                            <Setter TargetName="StatusBadge" Property="Background" Value="#22C55E"/>
                                            <Setter TargetName="StatusText" Property="Text" Value="✓ Active"/>
                                            <Setter TargetName="StatusText" Property="Foreground" Value="White"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                <Condition Binding="{Binding Code}" Value="DGU+LAM"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#F97316"/>
                                            <Setter TargetName="StatusBadge" Property="Background" Value="#F97316"/>
                                            <Setter TargetName="StatusText" Property="Text" Value="✓ Active"/>
                                            <Setter TargetName="StatusText" Property="Foreground" Value="White"/>
                                        </MultiDataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ============ SGU PARAMETERS PANEL ============ -->
            <ContentControl Content="{Binding SguVM}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGlassType.Code}" Value="SGU">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <sgu:SguParametersView/>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <!-- ============ DGU / LAM / DGU+LAM PLACEHOLDERS ============ -->
            <Border Margin="0,8,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGlassType.Code}" Value="DGU">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border Background="{DynamicResource MenuHoverBrush}"
                        CornerRadius="6" Padding="14,10" HorizontalAlignment="Left">
                    <TextBlock Text="DGU parameters — coming in Phase 6.6"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </Border>
            </Border>

            <Border Margin="0,8,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGlassType.Code}" Value="LAM">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border Background="{DynamicResource MenuHoverBrush}"
                        CornerRadius="6" Padding="14,10" HorizontalAlignment="Left">
                    <TextBlock Text="LAM parameters — coming in Phase 6.7"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </Border>
            </Border>

            <Border Margin="0,8,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedGlassType.Code}" Value="DGU+LAM">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border Background="{DynamicResource MenuHoverBrush}"
                        CornerRadius="6" Padding="14,10" HorizontalAlignment="Left">
                    <TextBlock Text="DGU+LAM hybrid — coming soon"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </Border>
            </Border>

            <!-- ============ COMPACT PROCESSING TREATMENTS ============ -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,12,0,0"
                    BorderThickness="1.5"
                    BorderBrush="{DynamicResource MenuHoverBrush}">
                <StackPanel>
                    <TextBlock Text="CONFIGURE PROCESSING TREATMENTS"
                               Style="{StaticResource SectionTitleStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Polished Edges"
                                  IsChecked="{Binding PolishedEdges}"
                                  Style="{StaticResource ThemedCheckBoxStyle}"/>
                        <CheckBox Grid.Column="1" Content="Drill Cutouts"
                                  IsChecked="{Binding DrillCutouts}"
                                  Style="{StaticResource ThemedCheckBoxStyle}"/>
                        <CheckBox Grid.Column="2" Content="Countersunk Holes"
                                  IsChecked="{Binding CountersunkHoles}"
                                  Style="{StaticResource ThemedCheckBoxStyle}"/>
                        <CheckBox Grid.Column="3" Content="Edge Deletion"
                                  IsChecked="{Binding EdgeDeletionLayer}"
                                  Style="{StaticResource ThemedCheckBoxStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ COMPACT SPEC TARGET GROUPS ============ -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,12,0,0"
                    BorderThickness="1.5"
                    BorderBrush="{DynamicResource MenuHoverBrush}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="SELECT SPECIFICATION TARGET GROUPS"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Active: "
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalSpecsActive}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding SpecGroups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ToggleSpecGroupCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Margin="0,0,6,6"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="PillBorder"
                                                    CornerRadius="16"
                                                    Padding="12,6"
                                                    BorderThickness="1.5">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="CheckIcon"
                                                               Text="✓"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,4,0"/>
                                                    <TextBlock x:Name="NameText"
                                                               Text="{Binding Name}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="PillBorder" Property="Background"
                                                            Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="PillBorder" Property="BorderBrush"
                                                            Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="CheckIcon" Property="Foreground" Value="White"/>
                                                    <Setter TargetName="NameText" Property="Foreground" Value="White"/>
                                                    <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                                    <Setter TargetName="PillBorder" Property="Background"
                                                            Value="Transparent"/>
                                                    <Setter TargetName="PillBorder" Property="BorderBrush"
                                                            Value="{DynamicResource MenuHoverBrush}"/>
                                                    <Setter TargetName="CheckIcon" Property="Foreground"
                                                            Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                    <Setter TargetName="NameText" Property="Foreground"
                                                            Value="{DynamicResource PrimaryForegroundBrush}"/>
                                                    <Setter TargetName="CheckIcon" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="PillBorder" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ============ COMPACT RATE BAR + APPLY BUTTON ============ -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,12,0,0"
                    BorderThickness="1.5"
                    BorderBrush="{DynamicResource MenuHoverBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Estimated Rate Display -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="Estimated Rate:"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <TextBlock Text="AED"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#22C55E"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>

                        <TextBlock Text="{Binding EstimatedRatePerSqm, StringFormat={}{0:N2}}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#22C55E"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text=" / sqm"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"/>
                    </StackPanel>

                    <!-- Right: APPLY Button -->
                    <Button Grid.Column="1"
                            Command="{Binding ApplyRateCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ApplyBorder"
                                        Background="{DynamicResource AccentBrush}"
                                        CornerRadius="8"
                                        Padding="18,10">
                                    <TextBlock Text="APPLY RATE TO SELECTED SPECS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="ApplyBorder" Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ApplyBorder" Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>