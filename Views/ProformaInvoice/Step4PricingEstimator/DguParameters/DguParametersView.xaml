<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.DguParameters.DguParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="900"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ══════════════════════════════════════════════════════════════
             DGU LABEL — purple accent (glass type identity)
        ══════════════════════════════════════════════════════════════ -->
        <Style x:Key="DguLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#7C3AED"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <!-- ══════════════════════════════════════════════════════════════
             DGU TEXTBOX — minimal override just for purple focus
             (matches global height/radius, changes only focus color)
        ══════════════════════════════════════════════════════════════ -->
        <Style x:Key="DguInputStyle" TargetType="TextBox">
            <Setter Property="behaviors:TextBoxBehaviors.SelectAllOnFocus" Value="True"/>
            <Setter Property="Background"               Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground"               Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Padding"                  Value="12,0"/>
            <Setter Property="Height"                   Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush"               Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="SelectionBrush"           Value="#7C3AED"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Background="Transparent"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#A855F7"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush"     Value="#7C3AED"/>
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════════
             DGU COMBOBOX — matches input rendering, purple focus
        ══════════════════════════════════════════════════════════════ -->
        <Style x:Key="DguComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background"               Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground"               Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Padding"                  Value="10,0"/>
            <Setter Property="Height"                   Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#A855F7"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush"     Value="#7C3AED"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Editable variant -->
        <Style x:Key="DguEditableComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource DguComboBoxStyle}">
            <Setter Property="IsEditable"          Value="True"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
        </Style>

    </UserControl.Resources>

    <!-- ══════════════════════════════════════════════════════════════════
         DGU CARD
    ══════════════════════════════════════════════════════════════════ -->
    <Border Background="{DynamicResource ModuleBackgroundBrush}"
            CornerRadius="16"
            Padding="20"
            Margin="0,10,0,0"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}">
        <StackPanel>

            <!-- ── Section header — purple icon + title ── -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Background="#FAF5FF"
                        Width="26" Height="26"
                        CornerRadius="8"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0">
                    <!-- Segoe MDL2 stacked layers icon -->
                    <TextBlock Text="&#xE81E;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="#7C3AED"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Double Insulated (DGU) Parameters"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- ── Live spec name preview — purple tint chip ── -->
            <Border Background="#FAF5FF"
                    BorderBrush="#E9D5FF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7C1;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="#7C3AED"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="Generated Spec:"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding GeneratedSpecName}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#7C3AED"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 ROW 1 — OUTER GLASS
            ══════════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="OUTER GLASS THK" Style="{StaticResource DguLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding ThicknessOptions}"
                              SelectedItem="{Binding OuterThickness}"
                              Style="{StaticResource DguComboBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="OUTER GLASS COLOR" Style="{StaticResource DguLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding ColorOptions}"
                              Text="{Binding OuterGlassColor, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource DguEditableComboBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="OUTER GLASS TREATMENT" Style="{StaticResource DguLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding TreatmentOptions}"
                              SelectedItem="{Binding OuterTreatment}"
                              Style="{StaticResource DguComboBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <TextBlock Text="OUTER BASE PRICE" Style="{StaticResource DguLabelStyle}"/>
                    <TextBox Text="{Binding OuterBasePrice, StringFormat={}{0:0.##}}"
                             Style="{StaticResource DguInputStyle}"/>
                </StackPanel>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 ROW 1b — OUTER SHEET STORE (PHASE A)
                 Sheet size is editable (type a custom size); the two price
                 boxes are read-only mirrors of the Sheet Store record.
            ══════════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="OUTER SHEET WIDTH (MM)" Style="{StaticResource DguLabelStyle}"/>
                    <TextBox Text="{Binding OuterSheetWidthMm, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DguInputStyle}"
                             ToolTip="Auto-filled from Sheet Store for the selected colour and thickness. Editable."/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="OUTER SHEET HEIGHT (MM)" Style="{StaticResource DguLabelStyle}"/>
                    <TextBox Text="{Binding OuterSheetHeightMm, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DguInputStyle}"
                             ToolTip="Auto-filled from Sheet Store for the selected colour and thickness. Editable."/>
                </StackPanel>
            </Grid>


            <!-- ══════════════════════════════════════════════════════════
                 ROW 3 — SPACER EXTRA + PANEL EXTRA   (HOTFIX-3)
                 Replaces old U-Insert / Overlap / InnerAsPerDwg controls.
                 SpacerExtra  → appended after spacer (middle of spec name)
                 PanelExtra   → appended after inner glass (end of spec name)
            ══════════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="SPACER EXTRA" Style="{StaticResource DguLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding SpacerExtraOptions}"
                              SelectedItem="{Binding SpacerExtra}"
                              Style="{StaticResource DguComboBoxStyle}"
                              ToolTip="Extras attached to the spacer (appears after spacer in spec name)"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="PANEL EXTRA" Style="{StaticResource DguLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding PanelExtraOptions}"
                              SelectedItem="{Binding PanelExtra}"
                              Style="{StaticResource DguComboBoxStyle}"
                              ToolTip="Additional processing on the DGU panel (appears at end of spec name)"/>
                </StackPanel>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 ROW 4 — INNER GLASS
            ══════════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="INNER GLASS THK" Style="{StaticResource DguLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding ThicknessOptions}"
                              SelectedItem="{Binding InnerThickness}"
                              Style="{StaticResource DguComboBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="INNER GLASS COLOR" Style="{StaticResource DguLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding ColorOptions}"
                              Text="{Binding InnerGlassColor, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource DguEditableComboBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="INNER GLASS TREATMENT" Style="{StaticResource DguLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding TreatmentOptions}"
                              SelectedItem="{Binding InnerTreatment}"
                              Style="{StaticResource DguComboBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <TextBlock Text="INNER BASE PRICE" Style="{StaticResource DguLabelStyle}"/>
                    <TextBox Text="{Binding InnerBasePrice, StringFormat={}{0:0.##}}"
                             Style="{StaticResource DguInputStyle}"/>
                </StackPanel>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 ROW 4b — INNER SHEET STORE (PHASE A)
            ══════════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="INNER SHEET WIDTH (MM)" Style="{StaticResource DguLabelStyle}"/>
                    <TextBox Text="{Binding InnerSheetWidthMm, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DguInputStyle}"
                             ToolTip="Auto-filled from Sheet Store for the selected colour and thickness. Editable."/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="INNER SHEET HEIGHT (MM)" Style="{StaticResource DguLabelStyle}"/>
                    <TextBox Text="{Binding InnerSheetHeightMm, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DguInputStyle}"
                             ToolTip="Auto-filled from Sheet Store for the selected colour and thickness. Editable."/>
                </StackPanel>
            </Grid>

            <!-- Skippable Sheet Store guidance — theme WarningBrush -->
            <TextBlock Text="{Binding SheetStoreHint}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       Foreground="{DynamicResource WarningBrush}"/>

            <!-- ══════════════════════════════════════════════════════════
                 ROW 5 — YIELD + MARGIN
            ══════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="YIELD FACTOR" Style="{StaticResource DguLabelStyle}"/>
                    <TextBox Text="{Binding YieldFactor, StringFormat={}{0:0.##}}"
                             Style="{StaticResource DguInputStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="MARGIN PROFIT %" Style="{StaticResource DguLabelStyle}"/>
                    <TextBox Text="{Binding MarginProfitPercent, StringFormat={}{0:0.##}}"
                             Style="{StaticResource DguInputStyle}"/>
                </StackPanel>

                <!-- Helper text spans remaining columns -->
                <StackPanel Grid.Column="4"
                            Grid.ColumnSpan="3"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,10">
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               TextWrapping="Wrap">
                        <Run Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="#7C3AED"/>
                        <Run Text="  DGU pricing sums outer + spacer + inner. Typical yield is 0.92 for double-glazed units."/>
                    </TextBlock>
                </StackPanel>
            </Grid>

        </StackPanel>
    </Border>
</UserControl>