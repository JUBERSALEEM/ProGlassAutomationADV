<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.DguParameters.DguParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:glass="clr-namespace:ProGlassAutomation.Controls.GlassShowcase"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- DGU: 3D IGU left + four full-width layer rows right. -->
    <Border Style="{StaticResource PiWorkSurfaceStyle}" Padding="12,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.85*"/>
                <ColumnDefinition Width="1.45*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <glass:GlassAssemblyShowcase Grid.Column="0" Grid.Row="0"
                                         Kind="Dgu"
                                         Margin="0,0,12,0"
                                         ShowWell="False"
                                         ShowCaption="True"
                                         OuterColor="{Binding OuterGlassColor}"
                                         OuterThickness="{Binding OuterThickness}"
                                         OuterTreatment="{Binding OuterTreatment}"
                                         InnerColor="{Binding InnerGlassColor}"
                                         InnerThickness="{Binding InnerThickness}"
                                         InnerTreatment="{Binding InnerTreatment}"
                                         SpacerWidth="{Binding SpacerWidth}"
                                         SpacerMaterial="{Binding SpacerMaterial}"
                                         Caption="{Binding GeneratedSpecName}"/>

            <ScrollViewer Grid.Column="1" Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource PiLayerStripStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="1  OUTER" Style="{StaticResource PiLayerTitleStyle}" MinWidth="0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="THK" Style="{StaticResource Step4LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding ThicknessOptions}" SelectedItem="{Binding OuterThickness}" Style="{StaticResource Step4ComboStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="COLOUR" Style="{StaticResource Step4LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding ColorOptions}" Text="{Binding OuterGlassColor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Step4EditableComboStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="5">
                                <TextBlock Text="TREAT" Style="{StaticResource Step4LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding TreatmentOptions}" SelectedItem="{Binding OuterTreatment}" Style="{StaticResource Step4ComboStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="7">
                                <TextBlock Text="PRICE" Style="{StaticResource Step4LabelStyle}"/>
                                <TextBox Text="{Binding OuterBasePrice, StringFormat={}{0:0.##}}" Style="{StaticResource Step4InputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="9">
                                <TextBlock Text="SHEET W" Style="{StaticResource Step4LabelStyle}"/>
                                <TextBox Text="{Binding OuterSheetWidthMm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Step4InputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="11">
                                <TextBlock Text="SHEET H" Style="{StaticResource Step4LabelStyle}"/>
                                <TextBox Text="{Binding OuterSheetHeightMm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Step4InputStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource PiLayerStripStyle}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="4,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="2  AIR SPACER" Style="{StaticResource PiLayerTitleStyle}" MinWidth="0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="WIDTH" Style="{StaticResource Step4LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding SpacerWidthOptions}" SelectedItem="{Binding SpacerWidth}" Style="{StaticResource Step4ComboStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="MATERIAL" Style="{StaticResource Step4LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding SpacerMaterialOptions}" SelectedItem="{Binding SpacerMaterial}" Style="{StaticResource Step4ComboStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="5">
                                <TextBlock Text="SPACER / SQM" Style="{StaticResource Step4LabelStyle}"/>
                                <TextBox Text="{Binding SpacerPrice, StringFormat={}{0:0.##}}" Style="{StaticResource Step4InputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="7">
                                <TextBlock Text="EXTRA" Style="{StaticResource Step4LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding SpacerExtraOptions}" SelectedItem="{Binding SpacerExtra}" Style="{StaticResource Step4ComboStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="9">
                                <TextBlock Text="PANEL EXTRA" Style="{StaticResource Step4LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding PanelExtraOptions}" SelectedItem="{Binding PanelExtra}" Style="{StaticResource Step4ComboStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource PiLayerStripStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="3  INNER" Style="{StaticResource PiLayerTitleStyle}" MinWidth="0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="THK" Style="{StaticResource Step4LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding ThicknessOptions}" SelectedItem="{Binding InnerThickness}" Style="{StaticResource Step4ComboStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="COLOUR" Style="{StaticResource Step4LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding ColorOptions}" Text="{Binding InnerGlassColor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Step4EditableComboStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="5">
                                <TextBlock Text="TREAT" Style="{StaticResource Step4LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding TreatmentOptions}" SelectedItem="{Binding InnerTreatment}" Style="{StaticResource Step4ComboStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="7">
                                <TextBlock Text="PRICE" Style="{StaticResource Step4LabelStyle}"/>
                                <TextBox Text="{Binding InnerBasePrice, StringFormat={}{0:0.##}}" Style="{StaticResource Step4InputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="9">
                                <TextBlock Text="SHEET W" Style="{StaticResource Step4LabelStyle}"/>
                                <TextBox Text="{Binding InnerSheetWidthMm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Step4InputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="11">
                                <TextBlock Text="SHEET H" Style="{StaticResource Step4LabelStyle}"/>
                                <TextBox Text="{Binding InnerSheetHeightMm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Step4InputStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource PiLayerStripStyle}" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="COSTING" Style="{StaticResource PiLayerTitleStyle}" MinWidth="0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="YIELD" Style="{StaticResource Step4LabelStyle}"/>
                                <TextBox Text="{Binding YieldFactor, StringFormat={}{0:0.##}}" Style="{StaticResource Step4InputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="MARGIN %" Style="{StaticResource Step4LabelStyle}"/>
                                <TextBox Text="{Binding MarginProfitPercent, StringFormat={}{0:0.##}}" Style="{StaticResource Step4InputStyle}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="5"
                                       Text="Spacer already includes cutting and tempering."
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Margin="0,8,0,0">
                <TextBlock Text="LIVE SPECIFICATION" Style="{StaticResource Step4LabelStyle}"/>
                <TextBox Text="{Binding GeneratedSpecName, Mode=OneWay}"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="12"
                         FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SheetStoreHint}"
                           FontSize="10"
                           Foreground="{DynamicResource WarningBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
