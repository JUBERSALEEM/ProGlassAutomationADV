<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.DguParameters.DguParametersView"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:glass="clr-namespace:ProGlassAutomation.Controls.GlassShowcase"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.95*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource ModuleSectionCardStyle}" Padding="10" ClipToBounds="True">
            <glass:GlassAssemblyShowcase Kind="Dgu"
                                         MinHeight="320"
                                         ShowWell="True"
                                         ShowCaption="False"
                                         OuterColor="{Binding OuterGlassColor}"
                                         OuterThickness="{Binding OuterThickness}"
                                         OuterTreatment="{Binding OuterTreatment}"
                                         InnerColor="{Binding InnerGlassColor}"
                                         InnerThickness="{Binding InnerThickness}"
                                         InnerTreatment="{Binding InnerTreatment}"
                                         SpacerWidth="{Binding SpacerWidth}"
                                         SpacerMaterial="{Binding SpacerMaterial}"/>
        </Border>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource ModuleSectionCardStyle}" Padding="16,14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="1  Outer pane" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="THK" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding ThicknessOptions}" SelectedItem="{Binding OuterThickness}" Style="{StaticResource Step4ComboStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="COLOUR" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding ColorOptions}" Text="{Binding OuterGlassColor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Step4EditableComboStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="TREATMENT" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding TreatmentOptions}" SelectedItem="{Binding OuterTreatment}" Style="{StaticResource Step4ComboStyle}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="PRICE" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <TextBox Text="{Binding OuterBasePrice, StringFormat={}{0:0.##}}" Style="{StaticResource Step4InputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SHEET W" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <TextBox Text="{Binding OuterSheetWidthMm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Step4InputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="SHEET H" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <TextBox Text="{Binding OuterSheetHeightMm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Step4InputStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModuleSectionCardStyle}" Padding="16,14" Margin="0,0,0,10"
                        BorderBrush="{DynamicResource AccentBrush}">
                    <StackPanel>
                        <TextBlock Text="2  Air spacer" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="1.2*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="WIDTH" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding SpacerWidthOptions}" SelectedItem="{Binding SpacerWidth}" Style="{StaticResource Step4ComboStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MATERIAL" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding SpacerMaterialOptions}" SelectedItem="{Binding SpacerMaterial}" Style="{StaticResource Step4ComboStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="SPACER / SQM" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <TextBox Text="{Binding SpacerPrice, StringFormat={}{0:0.##}}" Style="{StaticResource Step4InputStyle}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="EXTRA" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding SpacerExtraOptions}" SelectedItem="{Binding SpacerExtra}" Style="{StaticResource Step4ComboStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PANEL EXTRA" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding PanelExtraOptions}" SelectedItem="{Binding PanelExtra}" Style="{StaticResource Step4ComboStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModuleSectionCardStyle}" Padding="16,14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="3  Inner pane" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="THK" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding ThicknessOptions}" SelectedItem="{Binding InnerThickness}" Style="{StaticResource Step4ComboStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="COLOUR" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding ColorOptions}" Text="{Binding InnerGlassColor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Step4EditableComboStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="TREATMENT" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding TreatmentOptions}" SelectedItem="{Binding InnerTreatment}" Style="{StaticResource Step4ComboStyle}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="PRICE" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <TextBox Text="{Binding InnerBasePrice, StringFormat={}{0:0.##}}" Style="{StaticResource Step4InputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SHEET W" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <TextBox Text="{Binding InnerSheetWidthMm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Step4InputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="SHEET H" Style="{StaticResource ModuleFieldLabelStyle}"/>
                                <TextBox Text="{Binding InnerSheetHeightMm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Step4InputStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModuleSectionCardStyle}" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="YIELD" Style="{StaticResource ModuleFieldLabelStyle}"/>
                            <TextBox Text="{Binding YieldFactor, StringFormat={}{0:0.##}}" Style="{StaticResource Step4InputStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="MARGIN %" Style="{StaticResource ModuleFieldLabelStyle}"/>
                            <TextBox Text="{Binding MarginProfitPercent, StringFormat={}{0:0.##}}" Style="{StaticResource Step4InputStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
