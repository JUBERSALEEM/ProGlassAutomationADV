<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.DguLamParameters.DguLamParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="460" d:DesignWidth="900"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!--
        ══════════════════════════════════════════════════════════════════
        DGU + LAMINATED (HYBRID)

        Three panes: outer glass, air spacer, then a laminated pair.

            6mm HD Grey FT + 12mm ASP + 6mm Clear FT
            + 1.52mm Clear PVB + 6mm Clear FT

        Five collapsible sections, one per physical layer, plus shop work
        and costing. Only the section being edited is open, so the whole
        panel fits on screen without scrolling — this build has more fields
        than any other and would otherwise be the worst offender.

        Being both a DGU and a laminate, it offers the fabrication extras
        of both: U-Insert on the spacer, panel extras on the unit, and edge
        polish on the laminated edge. Those three dropdowns are the same
        lists the DGU and LAM panels use, so a given product reads the same
        way whichever screen produced it.
        ══════════════════════════════════════════════════════════════════
    -->

    <Border Background="{DynamicResource ModuleBackgroundBrush}"
            CornerRadius="12"
            Padding="10"
            Margin="0,6,0,0"
            BorderThickness="{DynamicResource CardBorderThickness}"
            BorderBrush="{DynamicResource OutlineBrush}">
        <StackPanel>

            <!-- ── Live spec preview + rate, one line ── -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource TintPurpleBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="6"
                        Padding="8,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C1;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding GeneratedSpecName}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{DynamicResource TintPurpleBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="{DynamicResource CardBorderThickness}"
                        CornerRadius="6"
                        Padding="10,5">
                    <TextBlock Text="{Binding EstimatedRateDisplay}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════
                 LAYER 1 — OUTER GLASS
            ══════════════════════════════════════════════════════ -->
            <Expander Style="{StaticResource Step4SectionStyle}"
                      Header="1 · OUTER GLASS"
                      IsExpanded="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="THK" Style="{StaticResource Step4LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding ThicknessOptions}"
                                  SelectedItem="{Binding OuterThickness}"
                                  Style="{StaticResource Step4ComboStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="COLOUR" Style="{StaticResource Step4LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding ColorOptions}"
                                  Text="{Binding OuterGlassColor, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource Step4EditableComboStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="TREATMENT" Style="{StaticResource Step4LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding TreatmentOptions}"
                                  SelectedItem="{Binding OuterTreatment}"
                                  Style="{StaticResource Step4ComboStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="PRICE / SQM" Style="{StaticResource Step4LabelStyle}"/>
                        <TextBox Text="{Binding OuterBasePrice, StringFormat={}{0:0.##}}"
                                 Style="{StaticResource Step4InputStyle}"/>
                    </StackPanel>
                </Grid>
            </Expander>

            <!-- ══════════════════════════════════════════════════════
                 LAYER 2 — AIR SPACER + FABRICATION EXTRAS
            ══════════════════════════════════════════════════════ -->
            <Expander Style="{StaticResource Step4SectionStyle}"
                      Header="2 · AIR SPACER &amp; EXTRAS"
                      Tag="{Binding SpacerThickness}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="1.6*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SPACER WIDTH" Style="{StaticResource Step4LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding SpacerOptions}"
                                  Text="{Binding SpacerThickness, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource Step4EditableComboStyle}"
                                  ToolTip="12mm and 16mm are standard. Type any other width if the job needs it."/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="SPACER / SQM" Style="{StaticResource Step4LabelStyle}"/>
                        <TextBox Text="{Binding SpacerPrice, StringFormat={}{0:0.##}}"
                                 Style="{StaticResource Step4InputStyle}"
                                 ToolTip="Zero by default — the standard hybrid price carries no spacer charge."/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="SPACER EXTRA" Style="{StaticResource Step4LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding SpacerExtraOptions}"
                                  SelectedItem="{Binding SpacerExtra}"
                                  Style="{StaticResource Step4ComboStyle}"
                                  ToolTip="U-Insert variants. Appears on the spacer segment of the spec name."/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="PANEL EXTRA" Style="{StaticResource Step4LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding PanelExtraOptions}"
                                  SelectedItem="{Binding PanelExtra}"
                                  Style="{StaticResource Step4ComboStyle}"
                                  ToolTip="Overlap, fanhole, cutout, holes, shutter bonding or argon. 'As Per DWG' means the detail follows the drawing."/>
                    </StackPanel>
                </Grid>
            </Expander>

            <!-- ══════════════════════════════════════════════════════
                 LAYER 3 — LAMINATED OUTER
            ══════════════════════════════════════════════════════ -->
            <Expander Style="{StaticResource Step4SectionStyle}"
                      Header="3 · LAMINATED OUTER">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="THK" Style="{StaticResource Step4LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding ThicknessOptions}"
                                  SelectedItem="{Binding LamOuterThickness}"
                                  Style="{StaticResource Step4ComboStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="COLOUR" Style="{StaticResource Step4LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding ColorOptions}"
                                  Text="{Binding LamOuterColor, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource Step4EditableComboStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="TREATMENT" Style="{StaticResource Step4LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding TreatmentOptions}"
                                  SelectedItem="{Binding LamOuterTreatment}"
                                  Style="{StaticResource Step4ComboStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="PRICE / SQM" Style="{StaticResource Step4LabelStyle}"/>
                        <TextBox Text="{Binding LamOuterBasePrice, StringFormat={}{0:0.##}}"
                                 Style="{StaticResource Step4InputStyle}"/>
                    </StackPanel>
                </Grid>
            </Expander>

            <!-- ══════════════════════════════════════════════════════
                 LAYER 4 — INTERLAYER (OUTSOURCED) + EDGE POLISH
            ══════════════════════════════════════════════════════ -->
            <Expander Style="{StaticResource Step4SectionStyle}"
                      Header="4 · INTERLAYER &amp; POLISH"
                      Tag="{Binding InterlayerMarginDisplay}">
                <StackPanel>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TYPE" Style="{StaticResource Step4LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding InterlayerTypeOptions}"
                                      SelectedItem="{Binding InterlayerType}"
                                      Style="{StaticResource Step4ComboStyle}"
                                      ToolTip="Changing the type loads that material's usual bought and sold prices."/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="THK" Style="{StaticResource Step4LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding InterlayerThicknessOptions}"
                                      Text="{Binding InterlayerThickness, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource Step4EditableComboStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="COLOUR" Style="{StaticResource Step4LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding ColorOptions}"
                                      Text="{Binding InterlayerColor, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource Step4EditableComboStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="BOUGHT / SQM" Style="{StaticResource Step4LabelStyle}"/>
                            <TextBox Text="{Binding InterlayerBuyPrice, StringFormat={}{0:0.##}, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Step4InputStyle}"
                                     ToolTip="What the laminator charges us. Used for costing in Profit and Loss — never shown to the customer."/>
                        </StackPanel>

                        <StackPanel Grid.Column="8">
                            <TextBlock Text="SOLD / SQM" Style="{StaticResource Step4LabelStyle}"/>
                            <TextBox Text="{Binding InterlayerSellPrice, StringFormat={}{0:0.##}, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Step4InputStyle}"
                                     ToolTip="What the customer is charged. Enters the subtotal before the profit margin."/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="EDGE POLISH" Style="{StaticResource Step4LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding EdgePolishOptions}"
                                      SelectedItem="{Binding EdgePolish}"
                                      Style="{StaticResource Step4ComboStyle}"
                                      ToolTip="Which edges are polished. 'As Per DWG' means the detail follows the drawing. Appended to the spec name as 'With …'."/>
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding InterlayerMarginDisplay}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,5"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- ══════════════════════════════════════════════════════
                 LAYER 5 — LAMINATED INNER
            ══════════════════════════════════════════════════════ -->
            <Expander Style="{StaticResource Step4SectionStyle}"
                      Header="5 · LAMINATED INNER">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="THK" Style="{StaticResource Step4LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding ThicknessOptions}"
                                  SelectedItem="{Binding LamInnerThickness}"
                                  Style="{StaticResource Step4ComboStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="COLOUR" Style="{StaticResource Step4LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding ColorOptions}"
                                  Text="{Binding LamInnerColor, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource Step4EditableComboStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="TREATMENT" Style="{StaticResource Step4LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding TreatmentOptions}"
                                  SelectedItem="{Binding LamInnerTreatment}"
                                  Style="{StaticResource Step4ComboStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="PRICE / SQM" Style="{StaticResource Step4LabelStyle}"/>
                        <TextBox Text="{Binding LamInnerBasePrice, StringFormat={}{0:0.##}}"
                                 Style="{StaticResource Step4InputStyle}"/>
                    </StackPanel>
                </Grid>
            </Expander>

            <!-- ══════════════════════════════════════════════════════
                 CUTTING & TEMPERING — all three panes

                 Each pane carries its own pair. The rates are not equal:
                 HD Grey tempers at 12 where Clear tempers at 10.
            ══════════════════════════════════════════════════════ -->
            <Expander Style="{StaticResource Step4SectionStyle}"
                      Header="CUTTING &amp; TEMPERING · 3 PANES">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="OUTER CUT" Style="{StaticResource Step4LabelStyle}"/>
                            <TextBox Text="{Binding OuterCuttingCost, StringFormat={}{0:0.##}}"
                                     Style="{StaticResource Step4InputStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="OUTER TEMPER" Style="{StaticResource Step4LabelStyle}"/>
                            <TextBox Text="{Binding OuterTemperingCost, StringFormat={}{0:0.##}}"
                                     Style="{StaticResource Step4InputStyle}"
                                     ToolTip="Tinted glass such as HD Grey tempers dearer than Clear."/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="LAM OUT CUT" Style="{StaticResource Step4LabelStyle}"/>
                            <TextBox Text="{Binding LamOuterCuttingCost, StringFormat={}{0:0.##}}"
                                     Style="{StaticResource Step4InputStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="LAM OUT TEMPER" Style="{StaticResource Step4LabelStyle}"/>
                            <TextBox Text="{Binding LamOuterTemperingCost, StringFormat={}{0:0.##}}"
                                     Style="{StaticResource Step4InputStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="8">
                            <TextBlock Text="LAM IN CUT" Style="{StaticResource Step4LabelStyle}"/>
                            <TextBox Text="{Binding LamInnerCuttingCost, StringFormat={}{0:0.##}}"
                                     Style="{StaticResource Step4InputStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="10">
                            <TextBlock Text="LAM IN TEMPER" Style="{StaticResource Step4LabelStyle}"/>
                            <TextBox Text="{Binding LamInnerTemperingCost, StringFormat={}{0:0.##}}"
                                     Style="{StaticResource Step4InputStyle}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock FontSize="10"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap">
                        <Run Text="Totals — cutting "/>
                        <Run Text="{Binding TotalCuttingCost, StringFormat={}{0:0.##}, Mode=OneWay}" FontWeight="Bold"/>
                        <Run Text="  ·  tempering "/>
                        <Run Text="{Binding TotalTemperingCost, StringFormat={}{0:0.##}, Mode=OneWay}" FontWeight="Bold"/>
                        <Run Text="  AED per SQM."/>
                    </TextBlock>
                </StackPanel>
            </Expander>

            <!-- ══════════════════════════════════════════════════════
                 COSTING
            ══════════════════════════════════════════════════════ -->
            <Expander Style="{StaticResource Step4SectionStyle}"
                      Header="COSTING">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="YIELD FACTOR" Style="{StaticResource Step4LabelStyle}"/>
                        <TextBox Text="{Binding YieldFactor, StringFormat={}{0:0.##}}"
                                 Style="{StaticResource Step4InputStyle}"
                                 ToolTip="Applies to glass only. The interlayer is bought finished per SQM, so there is no offcut to recover on it."/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="MARGIN %" Style="{StaticResource Step4LabelStyle}"/>
                        <TextBox Text="{Binding MarginProfitPercent, StringFormat={}{0:0.##}}"
                                 Style="{StaticResource Step4InputStyle}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="4"
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,5"
                               TextWrapping="Wrap"
                               Text="Rate = (three panes ÷ yield + cutting + tempering + interlayer) × (1 + margin)."/>
                </Grid>
            </Expander>

        </StackPanel>
    </Border>
</UserControl>
