<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.DguLamParameters.DguLamParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:glass="clr-namespace:ProGlassAutomation.Controls.GlassShowcase"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!-- DGU+LAM mockup: cutaway left · five-layer sandwich centre · costing right. -->
    <Border Style="{StaticResource PiWorkSurfaceStyle}" Padding="12,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="0.7*"/>
            </Grid.ColumnDefinitions>

            <glass:GlassAssemblyShowcase Grid.Column="0"
                                         Kind="DguLam"
                                         MinHeight="280"
                                         ShowWell="False"
                                         ShowCaption="False"
                                         Margin="0,0,10,0"
                                         OuterColor="{Binding OuterGlassColor}"
                                         OuterThickness="{Binding OuterThickness}"
                                         OuterTreatment="{Binding OuterTreatment}"
                                         SpacerWidth="{Binding SpacerThickness}"
                                         LamOuterColor="{Binding LamOuterColor}"
                                         LamOuterThickness="{Binding LamOuterThickness}"
                                         InterlayerColor="{Binding InterlayerColor}"
                                         InterlayerThickness="{Binding InterlayerThickness}"
                                         InterlayerType="{Binding InterlayerType}"
                                         LamInnerColor="{Binding LamInnerColor}"
                                         LamInnerThickness="{Binding LamInnerThickness}"/>

            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,10,0">
                <StackPanel>
                    <Border Style="{StaticResource PiLayerStripStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="22" Height="22" CornerRadius="11"
                                    Background="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="1" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="OUTER"
                                       Style="{StaticResource PiLayerTitleStyle}" MinWidth="0"
                                       VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding ThicknessOptions}"
                                      SelectedItem="{Binding OuterThickness}"
                                      Style="{StaticResource Step4ComboStyle}"/>
                            <ComboBox Grid.Column="4" ItemsSource="{Binding ColorOptions}"
                                      Text="{Binding OuterGlassColor, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource Step4EditableComboStyle}"/>
                            <ComboBox Grid.Column="6" ItemsSource="{Binding TreatmentOptions}"
                                      SelectedItem="{Binding OuterTreatment}"
                                      Style="{StaticResource Step4ComboStyle}"/>
                            <TextBox Grid.Column="8"
                                     Text="{Binding OuterBasePrice, StringFormat={}{0:0.##}}"
                                     Style="{StaticResource Step4InputStyle}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource PiLayerStripStyle}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="4,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="108"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="22" Height="22" CornerRadius="11"
                                    Background="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="2" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="AIR SPACER" Style="{StaticResource PiLayerTitleStyle}" MinWidth="0"/>
                                <TextBlock Text="{Binding SpacerThickness}" FontSize="10"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding SpacerOptions}"
                                      Text="{Binding SpacerThickness, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource Step4EditableComboStyle}"
                                      VerticalAlignment="Center"/>
                            <TextBox Grid.Column="4"
                                     Text="{Binding SpacerPrice, StringFormat={}{0:0.##}}"
                                     Style="{StaticResource Step4InputStyle}"
                                     ToolTip="Spacer / sqm — 0 means not in rate"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource PiLayerStripStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="108"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="22" Height="22" CornerRadius="11"
                                    Background="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="3" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="LAM OUTER" Style="{StaticResource PiLayerTitleStyle}" MinWidth="0"/>
                                <TextBlock FontSize="10" Foreground="{DynamicResource SecondaryForegroundBrush}">
                                    <Run Text="{Binding LamOuterThickness, Mode=OneWay}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding LamOuterColor, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding ThicknessOptions}"
                                      SelectedItem="{Binding LamOuterThickness}"
                                      Style="{StaticResource Step4ComboStyle}"
                                      VerticalAlignment="Center"/>
                            <TextBox Grid.Column="4"
                                     Text="{Binding LamOuterBasePrice, StringFormat={}{0:0.##}}"
                                     Style="{StaticResource Step4InputStyle}"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource PiLayerStripStyle}"
                            BorderBrush="{DynamicResource WarningBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="108"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="22" Height="22" CornerRadius="11"
                                    Background="{DynamicResource WarningBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="4" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="INTERLAYER" Style="{StaticResource PiLayerTitleStyle}" MinWidth="0"/>
                                <TextBlock FontSize="10" Foreground="{DynamicResource SecondaryForegroundBrush}">
                                    <Run Text="{Binding InterlayerThickness, Mode=OneWay}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding InterlayerType, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding InterlayerTypeOptions}"
                                      SelectedItem="{Binding InterlayerType}"
                                      Style="{StaticResource Step4ComboStyle}"
                                      VerticalAlignment="Center"/>
                            <TextBox Grid.Column="4"
                                     Text="{Binding InterlayerBuyPrice, StringFormat={}{0:0.##}, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Step4InputStyle}"
                                     ToolTip="Bought / sqm"
                                     VerticalAlignment="Center"/>
                            <TextBox Grid.Column="6"
                                     Text="{Binding InterlayerSellPrice, StringFormat={}{0:0.##}, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Step4InputStyle}"
                                     ToolTip="Sold / sqm"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource PiLayerStripStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="108"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="22" Height="22" CornerRadius="11"
                                    Background="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="5" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource OnAccentForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="LAM INNER" Style="{StaticResource PiLayerTitleStyle}" MinWidth="0"/>
                                <TextBlock FontSize="10" Foreground="{DynamicResource SecondaryForegroundBrush}">
                                    <Run Text="{Binding LamInnerThickness, Mode=OneWay}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding LamInnerColor, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding ThicknessOptions}"
                                      SelectedItem="{Binding LamInnerThickness}"
                                      Style="{StaticResource Step4ComboStyle}"
                                      VerticalAlignment="Center"/>
                            <TextBox Grid.Column="4"
                                     Text="{Binding LamInnerBasePrice, StringFormat={}{0:0.##}}"
                                     Style="{StaticResource Step4InputStyle}"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding GeneratedSpecName}"
                               Style="{StaticResource PiSpecLineStyle}"
                               Margin="4,8,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="COSTING" Style="{StaticResource PiSectionLabelStyle}"/>
                    <TextBlock Text="YIELD" Style="{StaticResource Step4LabelStyle}"/>
                    <TextBox Text="{Binding YieldFactor, StringFormat={}{0:0.##}}"
                             Style="{StaticResource Step4InputStyle}" Margin="0,0,0,8"/>
                    <TextBlock Text="MARGIN %" Style="{StaticResource Step4LabelStyle}"/>
                    <TextBox Text="{Binding MarginProfitPercent, StringFormat={}{0:0.##}}"
                             Style="{StaticResource Step4InputStyle}" Margin="0,0,0,10"/>

                    <TextBlock Text="CUTTING" Style="{StaticResource Step4LabelStyle}"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding OuterCuttingCost, StringFormat={}{0:0.##}}"
                                 Style="{StaticResource Step4InputStyle}" ToolTip="Outer cut"/>
                        <TextBox Grid.Column="2" Text="{Binding LamOuterCuttingCost, StringFormat={}{0:0.##}}"
                                 Style="{StaticResource Step4InputStyle}" ToolTip="Lam outer cut"/>
                        <TextBox Grid.Column="4" Text="{Binding LamInnerCuttingCost, StringFormat={}{0:0.##}}"
                                 Style="{StaticResource Step4InputStyle}" ToolTip="Lam inner cut"/>
                    </Grid>
                    <TextBlock Text="TEMPERING" Style="{StaticResource Step4LabelStyle}"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding OuterTemperingCost, StringFormat={}{0:0.##}}"
                                 Style="{StaticResource Step4InputStyle}" ToolTip="Outer temper"/>
                        <TextBox Grid.Column="2" Text="{Binding LamOuterTemperingCost, StringFormat={}{0:0.##}}"
                                 Style="{StaticResource Step4InputStyle}" ToolTip="Lam outer temper"/>
                        <TextBox Grid.Column="4" Text="{Binding LamInnerTemperingCost, StringFormat={}{0:0.##}}"
                                 Style="{StaticResource Step4InputStyle}" ToolTip="Lam inner temper"/>
                    </Grid>
                    <TextBlock FontSize="10" Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap">
                        <Run Text="Cut "/>
                        <Run Text="{Binding TotalCuttingCost, StringFormat={}{0:0.##}, Mode=OneWay}" FontWeight="Bold"/>
                        <Run Text="  ·  Temper "/>
                        <Run Text="{Binding TotalTemperingCost, StringFormat={}{0:0.##}, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock Text="LAM OUTER COLOUR" Style="{StaticResource Step4LabelStyle}" Margin="0,10,0,0"/>
                    <ComboBox ItemsSource="{Binding ColorOptions}"
                              Text="{Binding LamOuterColor, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource Step4EditableComboStyle}" Margin="0,0,0,6"/>
                    <TextBlock Text="LAM OUTER TREAT" Style="{StaticResource Step4LabelStyle}"/>
                    <ComboBox ItemsSource="{Binding TreatmentOptions}"
                              SelectedItem="{Binding LamOuterTreatment}"
                              Style="{StaticResource Step4ComboStyle}" Margin="0,0,0,6"/>
                    <TextBlock Text="LAM INNER COLOUR" Style="{StaticResource Step4LabelStyle}"/>
                    <ComboBox ItemsSource="{Binding ColorOptions}"
                              Text="{Binding LamInnerColor, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource Step4EditableComboStyle}" Margin="0,0,0,6"/>
                    <TextBlock Text="LAM INNER TREAT" Style="{StaticResource Step4LabelStyle}"/>
                    <ComboBox ItemsSource="{Binding TreatmentOptions}"
                              SelectedItem="{Binding LamInnerTreatment}"
                              Style="{StaticResource Step4ComboStyle}" Margin="0,0,0,6"/>
                    <TextBlock Text="INTERLAYER TYPE" Style="{StaticResource Step4LabelStyle}"/>
                    <ComboBox ItemsSource="{Binding InterlayerTypeOptions}"
                              SelectedItem="{Binding InterlayerType}"
                              Style="{StaticResource Step4ComboStyle}" Margin="0,0,0,6"/>
                    <TextBlock Text="INTERLAYER COLOUR" Style="{StaticResource Step4LabelStyle}"/>
                    <ComboBox ItemsSource="{Binding ColorOptions}"
                              Text="{Binding InterlayerColor, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource Step4EditableComboStyle}" Margin="0,0,0,6"/>
                    <TextBlock Text="SPACER EXTRA" Style="{StaticResource Step4LabelStyle}" Margin="0,10,0,0"/>
                    <ComboBox ItemsSource="{Binding SpacerExtraOptions}"
                              SelectedItem="{Binding SpacerExtra}"
                              Style="{StaticResource Step4ComboStyle}" Margin="0,0,0,6"/>
                    <TextBlock Text="PANEL EXTRA" Style="{StaticResource Step4LabelStyle}"/>
                    <ComboBox ItemsSource="{Binding PanelExtraOptions}"
                              SelectedItem="{Binding PanelExtra}"
                              Style="{StaticResource Step4ComboStyle}" Margin="0,0,0,6"/>
                    <TextBlock Text="EDGE POLISH" Style="{StaticResource Step4LabelStyle}"/>
                    <ComboBox ItemsSource="{Binding EdgePolishOptions}"
                              SelectedItem="{Binding EdgePolish}"
                              Style="{StaticResource Step4ComboStyle}"/>
                    <TextBlock Text="{Binding InterlayerMarginDisplay}"
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
