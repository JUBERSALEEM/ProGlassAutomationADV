<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.SguParameters.SguParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- ══════════════════════════════════════════════════════════════
             FIELD LABEL — 11px SemiBold indigo (this section's accent color)
        ══════════════════════════════════════════════════════════════ -->
        <Style x:Key="SguLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4338CA"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <!-- ══════════════════════════════════════════════════════════════
             NOTE: TextBoxes inherit GLOBAL App.xaml style
             (Height=38, CornerRadius=8, focus glow, indigo hover).
             behaviors:TextBoxBehaviors.SelectAllOnFocus=True already
             applied globally in App.xaml.
        ══════════════════════════════════════════════════════════════ -->

        <!-- ══════════════════════════════════════════════════════════════
             COMBOBOX — matches global input rendering (Height=38, indigo focus)
        ══════════════════════════════════════════════════════════════ -->
        <Style x:Key="StepComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background"               Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground"               Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Padding"                  Value="10,0"/>
            <Setter Property="Height"                   Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#6366F1"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush"     Value="#4338CA"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Editable ComboBox — inherits above, adds text search -->
        <Style x:Key="StepEditableComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource StepComboBoxStyle}">
            <Setter Property="IsEditable"         Value="True"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
        </Style>

    </UserControl.Resources>

    <!-- ══════════════════════════════════════════════════════════════════
         SGU PARAMETERS CARD
    ══════════════════════════════════════════════════════════════════ -->
    <Border Background="{DynamicResource ModuleBackgroundBrush}"
            CornerRadius="16"
            Padding="20"
            Margin="0,10,0,0"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}">
        <StackPanel>

            <!-- ── Section header — icon badge + title ── -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Background="{DynamicResource TintIndigoBrush}"
                        Width="26" Height="26"
                        CornerRadius="8"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0">
                    <!-- Segoe MDL2 layers icon -->
                    <TextBlock Text="&#xE81E;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Single Glass (SGU) Parameters"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- ── Live spec name preview — indigo tint chip ── -->
            <Border Background="{DynamicResource TintIndigoBrush}"
                    BorderBrush="#C7D2FE"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7C1;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="Generated Spec:"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding GeneratedSpecName}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 ROW 1: Thickness · Color · Treatment · Base Price
            ══════════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="THICKNESS" Style="{StaticResource SguLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding ThicknessOptions}"
                              SelectedItem="{Binding SelectedThickness}"
                              Style="{StaticResource StepComboBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="GLASS COLOR" Style="{StaticResource SguLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding ColorOptions}"
                              Text="{Binding GlassColor, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource StepEditableComboBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="TREATMENT TYPE" Style="{StaticResource SguLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding TreatmentOptions}"
                              SelectedItem="{Binding SelectedTreatment}"
                              Style="{StaticResource StepComboBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <TextBlock Text="BASE PRICE / SQM (AED)" Style="{StaticResource SguLabelStyle}"/>
                    <TextBox Text="{Binding BasePricePerSqm, StringFormat={}{0:0.##}}"/>
                </StackPanel>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 ROW 1b — SHEET STORE (PHASE A)
                 Editable sheet size + read-only store prices. All of it is
                 advisory: the estimator never overwrites BASE PRICE.
            ══════════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="SHEET WIDTH (MM)" Style="{StaticResource SguLabelStyle}"/>
                    <TextBox Text="{Binding SheetWidthMm, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Auto-filled from Sheet Store for the selected colour and thickness. Editable."/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="SHEET HEIGHT (MM)" Style="{StaticResource SguLabelStyle}"/>
                    <TextBox Text="{Binding SheetHeightMm, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Auto-filled from Sheet Store for the selected colour and thickness. Editable."/>
                </StackPanel>
            </Grid>

                        <!-- Skippable Sheet Store guidance — theme WarningBrush -->
            <TextBlock Text="{Binding SheetStoreHint}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14"
                       Foreground="{DynamicResource WarningBrush}"/>

            <!-- ══════════════════════════════════════════════════════════
                 ROW 2: Cutting · Tempering · Yield · Margin
            ══════════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="CUTTING COST / SQM" Style="{StaticResource SguLabelStyle}"/>
                    <TextBox Text="{Binding CuttingCostPerSqm, StringFormat={}{0:0.##}}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="TEMPERING COST / SQM" Style="{StaticResource SguLabelStyle}"/>
                    <TextBox Text="{Binding TemperingCostPerSqm, StringFormat={}{0:0.##}}"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="YIELD FACTOR (CLEARING)" Style="{StaticResource SguLabelStyle}"/>
                    <TextBox Text="{Binding YieldFactor, StringFormat={}{0:0.##}}"/>
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <TextBlock Text="TARGET MARGIN %" Style="{StaticResource SguLabelStyle}"/>
                    <TextBox Text="{Binding TargetMarginPercent, StringFormat={}{0:0.##}}"/>
                </StackPanel>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 ROW 3: Polish option (single field — half width for balance)
            ══════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="POLISH / DETAIL OPTION" Style="{StaticResource SguLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding PolishOptions}"
                              SelectedItem="{Binding SelectedPolishOption}"
                              Style="{StaticResource StepComboBoxStyle}"/>
                </StackPanel>

                <!-- Helper text spans remaining columns -->
                <StackPanel Grid.Column="2"
                            Grid.ColumnSpan="5"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,10">
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               TextWrapping="Wrap">
                        <Run Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}"/>
                        <Run Text="  Polishing adds surface finish cost — flat edge is most common for interior use."/>
                    </TextBlock>
                </StackPanel>
            </Grid>

        </StackPanel>
    </Border>
</UserControl>