<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.SguParameters.SguParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="320" d:DesignWidth="900"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!--
        ══════════════════════════════════════════════════════════════════
        SINGLE GLAZED UNIT (SGU)

        One pane. Two collapsible sections: what the glass IS, and what it
        COSTS. Glass opens by default because it is what changes per job;
        costing is usually set once and left alone.

        All chrome comes from Styles/Step4SectionStyles.xaml so this panel
        cannot drift away from the other three.
        ══════════════════════════════════════════════════════════════════
    -->

    <Border Background="{DynamicResource ModuleBackgroundBrush}"
            CornerRadius="12"
            Padding="10"
            Margin="0,6,0,0"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}">
        <StackPanel>

            <!-- ── Live spec preview ── -->
            <Border Background="{DynamicResource TintPurpleBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,5"
                    Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7C1;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="10"
                               Foreground="#4338CA"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding GeneratedSpecName}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#4338CA"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════
                 GLASS
            ══════════════════════════════════════════════════════ -->
            <Expander Style="{StaticResource Step4SectionStyle}"
                      Content="GLASS"
                      IsExpanded="True"
                      Tag="{Binding GeneratedSpecName}">
                <StackPanel>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="THICKNESS" Style="{StaticResource Step4LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding ThicknessOptions}"
                                      SelectedItem="{Binding SelectedThickness}"
                                      Style="{StaticResource Step4ComboStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="COLOUR" Style="{StaticResource Step4LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding ColorOptions}"
                                      Text="{Binding GlassColor, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource Step4EditableComboStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="TREATMENT" Style="{StaticResource Step4LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding TreatmentOptions}"
                                      SelectedItem="{Binding SelectedTreatment}"
                                      Style="{StaticResource Step4ComboStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="BASE PRICE / SQM" Style="{StaticResource Step4LabelStyle}"/>
                            <TextBox Text="{Binding BasePricePerSqm, StringFormat={}{0:0.##}}"
                                     Style="{StaticResource Step4InputStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SHEET W (MM)" Style="{StaticResource Step4LabelStyle}"/>
                            <TextBox Text="{Binding SheetWidthMm, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Step4InputStyle}"
                                     ToolTip="Auto-filled from Sheet Store for the selected colour and thickness. Editable."/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SHEET H (MM)" Style="{StaticResource Step4LabelStyle}"/>
                            <TextBox Text="{Binding SheetHeightMm, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Step4InputStyle}"
                                     ToolTip="Auto-filled from Sheet Store for the selected colour and thickness. Editable."/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="EDGE POLISH" Style="{StaticResource Step4LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding PolishOptions}"
                                      SelectedItem="{Binding SelectedPolishOption}"
                                      Style="{StaticResource Step4ComboStyle}"
                                      ToolTip="Polishing adds surface finish cost. Flat edge is most common for interior use."/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- ══════════════════════════════════════════════════════
                 COSTING
            ══════════════════════════════════════════════════════ -->
            <Expander Style="{StaticResource Step4SectionStyle}"
                      Content="COSTING">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CUTTING / SQM" Style="{StaticResource Step4LabelStyle}"/>
                        <TextBox Text="{Binding CuttingCostPerSqm, StringFormat={}{0:0.##}}"
                                 Style="{StaticResource Step4InputStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="TEMPERING / SQM" Style="{StaticResource Step4LabelStyle}"/>
                        <TextBox Text="{Binding TemperingCostPerSqm, StringFormat={}{0:0.##}}"
                                 Style="{StaticResource Step4InputStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="YIELD FACTOR" Style="{StaticResource Step4LabelStyle}"/>
                        <TextBox Text="{Binding YieldFactor, StringFormat={}{0:0.##}}"
                                 Style="{StaticResource Step4InputStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="MARGIN %" Style="{StaticResource Step4LabelStyle}"/>
                        <TextBox Text="{Binding TargetMarginPercent, StringFormat={}{0:0.##}}"
                                 Style="{StaticResource Step4InputStyle}"/>
                    </StackPanel>
                </Grid>
            </Expander>

            <!-- Sheet Store guidance — only visible when there is something to say -->
            <TextBlock Text="{Binding SheetStoreHint}"
                       FontSize="10"
                       Foreground="{DynamicResource WarningBrush}"
                       TextWrapping="Wrap"
                       Margin="2,4,0,0"/>

        </StackPanel>
    </Border>
</UserControl>
