<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.LamParameters.LamParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900"
             FontFamily="Segoe UI">

    <!-- ============ LAM PARAMETERS PANEL PLACEHOLDER ============ -->
    <Border Background="{DynamicResource ModuleBackgroundBrush}"
            CornerRadius="10"
            Padding="14"
            Margin="0,10,0,0"
            BorderThickness="1.5"
            BorderBrush="{DynamicResource MenuHoverBrush}">
        <StackPanel>

            <!-- Section Title — LAM brand color (green) -->
            <TextBlock Text="LAMINATION ASSEMBLY (LAM) PARAMETERS"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#22C55E"
                       Margin="0,0,0,10"/>

            <TextBlock Text="LAM parameter fields will be built step by step: Outer Glass → Inner Glass → PVB + Lamination Costs → Yield + Margin."
                       FontSize="12"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       TextWrapping="Wrap"/>

        </StackPanel>
    </Border>

</UserControl>