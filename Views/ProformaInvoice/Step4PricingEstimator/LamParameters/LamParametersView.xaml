<!--
    LAM mockup: exploded stack centre, layer identity left, editors right, six costing tiles.
    All original bindings kept.
-->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step4PricingEstimator.LamParameters.LamParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:glass="clr-namespace:ProGlassAutomation.Controls.GlassShowcase"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Border Style="{StaticResource PiWorkSurfaceStyle}" Padding="12,10">
        <DockPanel>
            <UniformGrid DockPanel.Dock="Bottom" Columns="6" Rows="1" Margin="0,10,0,0">
                <Border Style="{StaticResource PiCostTileStyle}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="OUTER CUT" Style="{StaticResource Step4LabelStyle}"/>
                        <TextBox Text="{Binding OuterCuttingCost, StringFormat={}{0:0.##}}"
                                 Style="{StaticResource Step4InputStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PiCostTileStyle}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="OUTER TEMP" Style="{StaticResource Step4LabelStyle}"/>
                        <TextBox Text="{Binding OuterTemperingCost, StringFormat={}{0:0.##}}"
                                 Style="{StaticResource Step4InputStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PiCostTileStyle}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="INNER CUT" Style="{StaticResource Step4LabelStyle}"/>
                        <TextBox Text="{Binding InnerCuttingCost, StringFormat={}{0:0.##}}"
                                 Style="{StaticResource Step4InputStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PiCostTileStyle}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="INNER TEMP" Style="{StaticResource Step4LabelStyle}"/>
                        <TextBox Text="{Binding InnerTemperingCost, StringFormat={}{0:0.##}}"
                                 Style="{StaticResource Step4InputStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PiCostTileStyle}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="YIELD" Style="{StaticResource Step4LabelStyle}"/>
                        <TextBox Text="{Binding YieldFactor, StringFormat={}{0:0.##}}"
                                 Style="{StaticResource Step4InputStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PiCostTileStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="MARGIN %" Style="{StaticResource Step4LabelStyle}"/>
                        <TextBox Text="{Binding MarginProfitPercent, StringFormat={}{0:0.##}}"
                                 Style="{StaticResource Step4InputStyle}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="168"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PiLayerStripStyle}"
                        Margin="0,0,8,6" VerticalAlignment="Stretch">
                    <TextBlock Text="OUTER GLASS"
                               Style="{StaticResource PiLayerTitleStyle}"
                               VerticalAlignment="Center"/>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource PiLayerStripStyle}"
                        Background="{DynamicResource TintAmberBrush}"
                        BorderBrush="{DynamicResource WarningBrush}"
                        Margin="0,0,8,6" VerticalAlignment="Stretch">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="INTERLAYER" Style="{StaticResource PiLayerTitleStyle}"/>
                        <TextBlock Text="Safety / PVB tint"
                                   FontSize="10"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource PiLayerStripStyle}"
                        Margin="0,0,8,0" VerticalAlignment="Stretch">
                    <TextBlock Text="INNER GLASS"
                               Style="{StaticResource PiLayerTitleStyle}"
                               VerticalAlignment="Center"/>
                </Border>

                <glass:GlassAssemblyShowcase Grid.Column="1" Grid.Row="0" Grid.RowSpan="3"
                                             Kind="Lam"
                                             MinHeight="260"
                                             ShowWell="False"
                                             ShowCaption="False"
                                             OuterColor="{Binding OuterGlassColor}"
                                             OuterThickness="{Binding OuterThickness}"
                                             OuterTreatment="{Binding OuterTreatment}"
                                             InnerColor="{Binding InnerGlassColor}"
                                             InnerThickness="{Binding InnerThickness}"
                                             InnerTreatment="{Binding InnerTreatment}"
                                             InterlayerColor="{Binding PvbColor}"
                                             InterlayerThickness="{Binding PvbThickness}"
                                             InterlayerType="PVB"/>

                <ScrollViewer Grid.Column="2" Grid.Row="0" Grid.RowSpan="3"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="OUTER THK" Style="{StaticResource Step4LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding ThicknessOptions}"
                                          SelectedItem="{Binding OuterThickness}"
                                          Style="{StaticResource Step4ComboStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="OUTER COLOUR" Style="{StaticResource Step4LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding ColorOptions}"
                                          Text="{Binding OuterGlassColor, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource Step4EditableComboStyle}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="TREATMENT" Style="{StaticResource Step4LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding TreatmentOptions}"
                                          SelectedItem="{Binding OuterTreatment}"
                                          Style="{StaticResource Step4ComboStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="OUTER PRICE" Style="{StaticResource Step4LabelStyle}"/>
                                <TextBox Text="{Binding OuterBasePrice, StringFormat={}{0:0.##}}"
                                         Style="{StaticResource Step4InputStyle}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SHEET W" Style="{StaticResource Step4LabelStyle}"/>
                                <TextBox Text="{Binding OuterSheetWidthMm, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource Step4InputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SHEET H" Style="{StaticResource Step4LabelStyle}"/>
                                <TextBox Text="{Binding OuterSheetHeightMm, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource Step4InputStyle}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="PVB THK" Style="{StaticResource Step4LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding PvbThicknessOptions}"
                                          SelectedItem="{Binding PvbThickness}"
                                          Style="{StaticResource Step4ComboStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PVB COLOUR" Style="{StaticResource Step4LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding PvbColorOptions}"
                                          Text="{Binding PvbColor, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource Step4EditableComboStyle}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="PVB RATE" Style="{StaticResource Step4LabelStyle}"/>
                                <TextBox Text="{Binding PvbMaterialRate, StringFormat={}{0:0.##}}"
                                         Style="{StaticResource Step4InputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="EDGE POLISH" Style="{StaticResource Step4LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding LaminationPolishOptions}"
                                          SelectedItem="{Binding LaminationPolish}"
                                          Style="{StaticResource Step4ComboStyle}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="INNER THK" Style="{StaticResource Step4LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding ThicknessOptions}"
                                          SelectedItem="{Binding InnerThickness}"
                                          Style="{StaticResource Step4ComboStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="INNER COLOUR" Style="{StaticResource Step4LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding ColorOptions}"
                                          Text="{Binding InnerGlassColor, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource Step4EditableComboStyle}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="INNER TREAT" Style="{StaticResource Step4LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding TreatmentOptions}"
                                          SelectedItem="{Binding InnerTreatment}"
                                          Style="{StaticResource Step4ComboStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="INNER PRICE" Style="{StaticResource Step4LabelStyle}"/>
                                <TextBox Text="{Binding InnerBasePrice, StringFormat={}{0:0.##}}"
                                         Style="{StaticResource Step4InputStyle}"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="INNER SHEET W" Style="{StaticResource Step4LabelStyle}"/>
                                <TextBox Text="{Binding InnerSheetWidthMm, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource Step4InputStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="INNER SHEET H" Style="{StaticResource Step4LabelStyle}"/>
                                <TextBox Text="{Binding InnerSheetHeightMm, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource Step4InputStyle}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding SheetStoreHint}"
                                   FontSize="10"
                                   Foreground="{DynamicResource WarningBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
