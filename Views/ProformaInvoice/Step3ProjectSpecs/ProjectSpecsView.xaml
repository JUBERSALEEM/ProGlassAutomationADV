<!--
═══════════════════════════════════════════════════════════════════════
FILE: Views/ProformaInvoice/Step3ProjectSpecs/ProjectSpecsView.xaml
═══════════════════════════════════════════════════════════════════════
Industrial work surface. Bindings, commands and AutomationIds unchanged.
Theme: DynamicResource only (light / dark / Monet).
═══════════════════════════════════════════════════════════════════════
-->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step3ProjectSpecs.ProjectSpecsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1100"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock"
               BasedOn="{StaticResource PiFieldLabelStyle}"/>

        <Style x:Key="InlineWarningStyle" TargetType="TextBlock"
               BasedOn="{StaticResource ModuleInlineWarningStyle}"/>

        <Style x:Key="ViewAllLinkStyle" TargetType="Button"
               BasedOn="{StaticResource PiViewAllLinkStyle}"/>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="14,10,14,12">
        <StackPanel>

            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="PROJECT SPECIFICATIONS"
                           Style="{StaticResource ModulePageTitleStyle}"/>
                <TextBlock Text="Site, contract and LPO references for this quotation."
                           Style="{StaticResource ModulePageSubtitleStyle}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                    Padding="10,8"
                    Margin="0,0,0,10"
                    Background="{DynamicResource TintIndigoBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsClientFilterActive}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="&#xE71C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding FilterBannerText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="2"
                            Command="{Binding ClearClientFilterCommand}"
                            ToolTip="Remove client filter — show all projects"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ClearBg"
                                        Background="Transparent"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Padding="8,4">
                                    <TextBlock Text="Clear filter"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               TextDecorations="Underline"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ClearBg"
                                                Property="Background"
                                                Value="{DynamicResource MenuHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PiWorkSurfaceStyle}">
                    <StackPanel>

                        <TextBlock Text="PROJECT"
                                   Style="{StaticResource PiSectionLabelStyle}"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           ToolTip="Short project designation, e.g. IMAD HABIB">
                                    <Run Text="PROJECT IDENTIFIER NAME"/>
                                </TextBlock>
                                <TextBox Text="{Binding ProjectIdentifierName, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="e.g. IMAD HABIB"
                                         AutomationProperties.AutomationId="ProformaInvoice.ProjectName"
                                         AutomationProperties.Name="Project identifier name"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           ToolTip="Project name combined with project number, e.g. 428 IMAD HABIB">
                                    <Run Text="PROJECT NAME / NO"/>
                                </TextBlock>
                                <TextBox Text="{Binding ProjectContractNo, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="e.g. 428 IMAD HABIB"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                       ToolTip="Full descriptive reference — site, building, or purpose">
                                <Run Text="PROJECT REFERENCE"/>
                            </TextBlock>
                            <TextBox Text="{Binding ProjectReference, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="e.g. HOUSE FOR IMAD HABIB — full descriptive text"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           ToolTip="Full delivery address or site location for this order">
                                    <Run Text="SITE / DELIVERY LOCATION"/>
                                </TextBlock>
                                <TextBox Text="{Binding SiteDeliveryLocation, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="e.g. AJMAN"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           ToolTip="Client's Local Purchase Order reference number">
                                    <Run Text="LPO / PURCHASE ORDER NO"/>
                                </TextBlock>
                                <TextBox Text="{Binding LpoNumber, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="e.g. 2680"/>
                            </StackPanel>
                        </Grid>

                        <Border CornerRadius="{DynamicResource ControlCornerRadius}"
                                Padding="10,8"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility"      Value="Collapsed"/>
                                    <Setter Property="Background"      Value="{DynamicResource TintGreenBrush}"/>
                                    <Setter Property="BorderBrush"     Value="{DynamicResource SuccessBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLoadedProfile}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource SuccessBrush}">
                                <Run Text="Loaded: "/>
                                <Run Text="{Binding LoadedProfileName}" FontWeight="Bold"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource PiWorkSurfaceStyle}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SAVED PROJECTS"
                                           Style="{StaticResource PiSectionLabelStyle}"
                                           Margin="0"/>
                                <TextBlock Text="Click a row to fill the form"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding RefreshCardsCommand}"
                                    ToolTip="Refresh saved projects from database"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    VerticalAlignment="Center">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="RefreshBg"
                                                Background="Transparent"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Padding="6,4">
                                            <TextBlock Text="&#xE72C;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RefreshBg"
                                                        Property="Background"
                                                        Value="{DynamicResource TintIndigoBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoadingCards}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="14" Height="14"
                                    CornerRadius="{DynamicResource CardCornerRadius}"
                                    BorderThickness="2"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <Border.RenderTransform>
                                    <RotateTransform x:Name="ProjectSpinTransform" CenterX="7" CenterY="7"/>
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation
                                                    Storyboard.TargetName="ProjectSpinTransform"
                                                    Storyboard.TargetProperty="Angle"
                                                    From="0" To="360" Duration="0:0:1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                            <TextBlock Text="Loading…"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border DockPanel.Dock="Top">
                            <Border.Style>
                                <Style TargetType="Border"
                                       BasedOn="{StaticResource ModuleErrorBannerStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCardsError}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding CardsErrorMessage}"
                                       FontSize="12"
                                       Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock DockPanel.Dock="Top"
                                   Text="No saved projects yet. Save an invoice to build the library."
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNoSavedProjects}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button DockPanel.Dock="Bottom"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0"
                                Command="{Binding ShowAllProjectsCommand}"
                                ToolTip="Show all saved project profiles">
                            <Button.Style>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource ViewAllLinkStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMoreProjects}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       TextDecorations="Underline">
                                <Run Text="View all ("/>
                                <Run Text="{Binding TotalProjectCount, Mode=OneWay}"/>
                                <Run Text=")"/>
                            </TextBlock>
                        </Button>

                        <ItemsControl ItemsSource="{Binding SavedProjectCards}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoadingCards}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasNoSavedProjects}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PiSlimRowStyle}"
                                            ToolTip="Click to auto-fill project details">
                                        <Border.InputBindings>
                                            <MouseBinding
                                                MouseAction="LeftClick"
                                                Command="{Binding DataContext.LoadProjectCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ProjectIdentifierName}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding ContractPreview, Mode=OneWay}"/>
                                                    <Run Text="  ·  "/>
                                                    <Run Text="{Binding CustomerPreview, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding ReferencePreview}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource MutedForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Style="{StaticResource PiUsageBadgeStyle}"
                                                    Margin="8,0,0,0">
                                                <TextBlock Text="{Binding UsageBadgeText}"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
