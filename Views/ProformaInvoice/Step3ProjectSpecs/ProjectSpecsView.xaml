<!-- Step 3 — PROJECT NAME then PROJECT REFERENCE. No cards. -->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step3ProjectSpecs.ProjectSpecsView"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="34"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.35*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource PiStationIdentityStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="03" Style="{StaticResource PiStationCodeStyle}"/>
                        <TextBlock Text="PROJECT" Style="{StaticResource PiStationTitleStyle}"/>
                        <TextBlock Text="Project name and project reference stay separate"
                                   Style="{StaticResource PiStationHintStyle}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="SITE" Style="{StaticResource PiSectionLabelStyle}"/>
                <TextBlock Text="PROJECT NAME" Style="{StaticResource PiFieldLabelStyle}"
                           ToolTip="Project name as it appears on lists and invoices"/>
                <TextBox Text="{Binding ProjectIdentifierName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="e.g. IMAD HABIB" Margin="0,0,0,12"
                         AutomationProperties.AutomationId="ProformaInvoice.ProjectName"
                         AutomationProperties.Name="Project name"/>

                <TextBlock Text="PROJECT REFERENCE" Style="{StaticResource PiFieldLabelStyle}"
                           ToolTip="Full descriptive project reference"/>
                <TextBox Text="{Binding ProjectReference, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="e.g. HOUSE FOR IMAD HABIB" Margin="0,0,0,12"
                         AutomationProperties.AutomationId="ProformaInvoice.ProjectReference"
                         AutomationProperties.Name="Project reference"/>

                <TextBlock Text="CONTRACT NO" Style="{StaticResource PiFieldLabelStyle}"/>
                <TextBox Text="{Binding ProjectContractNo, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="e.g. 428 IMAD HABIB" Margin="0,0,0,12"/>

                <TextBlock Text="LPO / PO NUMBER" Style="{StaticResource PiFieldLabelStyle}"/>
                <TextBox Text="{Binding LpoNumber, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="e.g. 2680" Margin="0,0,0,12"/>

                <TextBlock Text="SITE / DELIVERY LOCATION" Style="{StaticResource PiFieldLabelStyle}"/>
                <TextBox Text="{Binding SiteDeliveryLocation, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="e.g. AJMAN" Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsClientFilterActive}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding FilterBannerText}" FontSize="11"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
                    <Button Margin="12,0,0,0" Command="{Binding ClearClientFilterCommand}"
                            Style="{StaticResource PiViewAllLinkStyle}">
                        <TextBlock Text="Clear filter" TextDecorations="Underline"/>
                    </Button>
                </StackPanel>

                <TextBlock Margin="0,12,0,0" FontSize="12" Foreground="{DynamicResource SuccessBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLoadedProfile}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="Loaded: "/><Run Text="{Binding LoadedProfileName, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerBrush}" HorizontalAlignment="Center"/>

        <DockPanel Grid.Column="2">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="SAVED" Style="{StaticResource PiSectionLabelStyle}" Margin="0"/>
                    <TextBlock Text="Filtered by selected client" Style="{StaticResource PiInlineMetaStyle}"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Command="{Binding RefreshCardsCommand}"
                        Style="{StaticResource PiIconButtonStyle}" ToolTip="Refresh saved projects from database">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </Button>
            </Grid>
            <TextBlock DockPanel.Dock="Top" Text="Loading…" FontSize="12"
                       Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoadingCards}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock DockPanel.Dock="Top" Text="{Binding CardsErrorMessage}" FontSize="12"
                       Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasCardsError}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock DockPanel.Dock="Top" Text="No saved projects yet."
                       FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNoSavedProjects}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Command="{Binding ShowAllProjectsCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PiViewAllLinkStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasMoreProjects}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" TextDecorations="Underline">
                    <Run Text="View all ("/><Run Text="{Binding TotalProjectCount, Mode=OneWay}"/><Run Text=")"/>
                </TextBlock>
            </Button>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SavedProjectCards}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoadingCards}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasNoSavedProjects}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PiListRowStyle}" ToolTip="Click to auto-fill project details">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.LoadProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayProjectName}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding ReferencePreview, Mode=OneWay}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding ProjectContractNo, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding UsageBadgeText}" FontSize="10"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
