<!-- Step 3 — PROJECT NAME then PROJECT REFERENCE. No cards.
     Every field on Step 3 is optional (the DB accepts an empty project
     row), so every field here binds Visibility to
     Services.Features.ProformaFieldVisibility. -->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step3ProjectSpecs.ProjectSpecsView"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:features="clr-namespace:ProGlassAutomation.Services.Features"
             FontFamily="{DynamicResource AppFontFamily}"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="34"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.35*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource PiStationIdentityStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="03" Style="{StaticResource PiStationCodeStyle}"/>
                        <TextBlock Text="{DynamicResource Common.Project}" Style="{StaticResource PiStationTitleStyle}"/>
                        <TextBlock Text="{DynamicResource ProformaInvoice.ProjectNameProjectReferenceStaySeparate}"
                                   Style="{StaticResource PiStationHintStyle}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{DynamicResource ProformaInvoice.SITE}" Style="{StaticResource PiSectionLabelStyle}"/>

                <StackPanel Visibility="{Binding Path=ShowProjectName,
                                Source={x:Static features:ProformaFieldVisibility.Instance},
                                Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{DynamicResource ProformaInvoice.ProjectNAME}" Style="{StaticResource PiFieldLabelStyle}"
                               ToolTip="{DynamicResource ProformaInvoice.ProjectNameAppearsListsInvoices}"/>
                    <TextBox Text="{Binding ProjectIdentifierName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{DynamicResource ProformaInvoice.EGIMADHabib}" Margin="0,0,0,12"
                             AutomationProperties.AutomationId="ProformaInvoice.ProjectName"
                             AutomationProperties.Name="Project name"/>
                </StackPanel>

                <StackPanel Visibility="{Binding Path=ShowProjectReference,
                                Source={x:Static features:ProformaFieldVisibility.Instance},
                                Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{DynamicResource ProformaInvoice.ProjectReference}" Style="{StaticResource PiFieldLabelStyle}"
                               ToolTip="{DynamicResource ProformaInvoice.FullDescriptiveProjectReference}"/>
                    <TextBox Text="{Binding ProjectReference, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{DynamicResource ProformaInvoice.EGHouseIMADHabib}" Margin="0,0,0,12"
                             AutomationProperties.AutomationId="ProformaInvoice.ProjectReference"
                             AutomationProperties.Name="Project reference"/>
                </StackPanel>

                <StackPanel Visibility="{Binding Path=ShowContractNo,
                                Source={x:Static features:ProformaFieldVisibility.Instance},
                                Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{DynamicResource ProformaInvoice.ContractNO}" Style="{StaticResource PiFieldLabelStyle}"/>
                    <TextBox Text="{Binding ProjectContractNo, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{DynamicResource ProformaInvoice.EG428IMADHabib}" Margin="0,0,0,12"
                             AutomationProperties.AutomationId="ProformaInvoice.ContractNo"
                             AutomationProperties.Name="Contract number"/>
                </StackPanel>

                <StackPanel Visibility="{Binding Path=ShowLpoNumber,
                                Source={x:Static features:ProformaFieldVisibility.Instance},
                                Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{DynamicResource ProformaInvoice.LPOPONumber}" Style="{StaticResource PiFieldLabelStyle}"/>
                    <TextBox Text="{Binding LpoNumber, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{DynamicResource ProformaInvoice.EG2680}" Margin="0,0,0,12"
                             AutomationProperties.AutomationId="ProformaInvoice.LpoNumber"
                             AutomationProperties.Name="LPO / PO number"/>
                </StackPanel>

                <StackPanel Visibility="{Binding Path=ShowSiteDeliveryLocation,
                                Source={x:Static features:ProformaFieldVisibility.Instance},
                                Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{DynamicResource ProformaInvoice.SITEDeliveryLocation}" Style="{StaticResource PiFieldLabelStyle}"/>
                    <TextBox Text="{Binding SiteDeliveryLocation, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{DynamicResource ProformaInvoice.EGAjman}" Margin="0,0,0,12"
                             AutomationProperties.AutomationId="ProformaInvoice.SiteDeliveryLocation"
                             AutomationProperties.Name="Site / delivery location"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsClientFilterActive}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding FilterBannerText}" FontSize="{StaticResource TextBody}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" VerticalAlignment="Center"/>
                    <Button Margin="12,0,0,0" Command="{Binding ClearClientFilterCommand}"
                            Style="{StaticResource PiViewAllLinkStyle}">
                        <TextBlock Text="{DynamicResource ProformaInvoice.ClearFilter}" TextDecorations="Underline"/>
                    </Button>
                </StackPanel>

                <TextBlock Margin="0,12,0,0" FontSize="{StaticResource TextBody}" Foreground="{DynamicResource SuccessBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLoadedProfile}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="{DynamicResource ProformaInvoice.Loaded}"/><Run Text="{Binding LoadedProfileName, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerBrush}" HorizontalAlignment="Center"/>

        <DockPanel Grid.Column="2">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{DynamicResource ProformaInvoice.Saved}" Style="{StaticResource PiSectionLabelStyle}" Margin="0"/>
                    <TextBlock Text="{DynamicResource ProformaInvoice.FilteredSelectedClient}" Style="{StaticResource PiInlineMetaStyle}"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Command="{Binding RefreshCardsCommand}"
                        Style="{StaticResource PiIconButtonStyle}" ToolTip="{DynamicResource ProformaInvoice.RefreshSavedProjectsDatabase}">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource TextBodyLarge}"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                </Button>
            </Grid>
            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Common.Loading}" FontSize="{StaticResource TextBody}"
                       Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoadingCards}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock DockPanel.Dock="Top" Text="{Binding CardsErrorMessage}" FontSize="{StaticResource TextBody}"
                       Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasCardsError}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource ProformaInvoice.NoSavedProjectsYet}"
                       FontSize="{StaticResource TextBody}" Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNoSavedProjects}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Command="{Binding ShowAllProjectsCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PiViewAllLinkStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasMoreProjects}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock FontSize="{StaticResource TextBody}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" TextDecorations="Underline">
                    <Run Text="{DynamicResource ProformaInvoice.View}"/><Run Text="{Binding TotalProjectCount, Mode=OneWay}"/><Run Text=")"/>
                </TextBlock>
            </Button>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SavedProjectCards}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoadingCards}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasNoSavedProjects}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PiListRowStyle}" ToolTip="{DynamicResource ProformaInvoice.ClickAutoFillProjectDetails}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.LoadProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayProjectName}" FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="{StaticResource TextBody}" Foreground="{DynamicResource SecondaryForegroundBrush}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding ReferencePreview, Mode=OneWay}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding ProjectContractNo, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding UsageBadgeText}" FontSize="{StaticResource TextCaption}"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
