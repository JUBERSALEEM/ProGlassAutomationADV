<!--
    Step 3 — Project. Industrial station:
    stacked identity plate | vault of saved projects (filtered by Step 2).
    Bindings, commands and AutomationIds unchanged.
-->
<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.Step3ProjectSpecs.ProjectSpecsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1100"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="34"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource PiZonePlateStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" Style="{StaticResource PiZoneHeaderStyle}" Margin="0,0,14,0">
                    <TextBlock Text="ZONE  ·  PROJECT IDENTITY"
                               Style="{StaticResource PiSectionLabelStyle}"
                               Margin="0"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,14,14,14">
                        <TextBlock Text="PROJECT IDENTIFIER"
                                   Style="{StaticResource PiFieldLabelStyle}"
                                   ToolTip="Short project designation, e.g. IMAD HABIB"/>
                        <TextBox Text="{Binding ProjectIdentifierName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="e.g. IMAD HABIB"
                                 Margin="0,0,0,10"
                                 AutomationProperties.AutomationId="ProformaInvoice.ProjectName"
                                 AutomationProperties.Name="Project identifier name"/>

                        <TextBlock Text="CONTRACT NO"
                                   Style="{StaticResource PiFieldLabelStyle}"
                                   ToolTip="Project name combined with project number, e.g. 428 IMAD HABIB"/>
                        <TextBox Text="{Binding ProjectContractNo, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="e.g. 428 IMAD HABIB"
                                 Margin="0,0,0,10"/>

                        <TextBlock Text="PROJECT REFERENCE"
                                   Style="{StaticResource PiFieldLabelStyle}"
                                   ToolTip="Full descriptive reference — site, building, or purpose"/>
                        <TextBox Text="{Binding ProjectReference, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="e.g. HOUSE FOR IMAD HABIB — full descriptive text"
                                 Margin="0,0,0,10"/>

                        <TextBlock Text="LPO / PO NUMBER"
                                   Style="{StaticResource PiFieldLabelStyle}"
                                   ToolTip="Client's Local Purchase Order reference number"/>
                        <TextBox Text="{Binding LpoNumber, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="e.g. 2680"
                                 Margin="0,0,0,10"/>

                        <TextBlock Text="SITE / DELIVERY LOCATION"
                                   Style="{StaticResource PiFieldLabelStyle}"
                                   ToolTip="Full delivery address or site location for this order"/>
                        <TextBox Text="{Binding SiteDeliveryLocation, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="e.g. AJMAN"
                                 Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsClientFilterActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding FilterBannerText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       VerticalAlignment="Center"/>
                            <Button Margin="12,0,0,0"
                                    Command="{Binding ClearClientFilterCommand}"
                                    Style="{StaticResource PiViewAllLinkStyle}"
                                    ToolTip="Remove client filter — show all projects">
                                <TextBlock Text="Clear filter" TextDecorations="Underline"/>
                            </Button>
                        </StackPanel>

                        <TextBlock Margin="0,12,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource SuccessBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLoadedProfile}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="Loaded: "/>
                            <Run Text="{Binding LoadedProfileName}" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <Border Grid.Column="1" Style="{StaticResource PiVerticalRuleStyle}"/>

            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Style="{StaticResource PiVaultHeaderStyle}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="VAULT  ·  PROJECTS"
                                       Style="{StaticResource PiSectionLabelStyle}"
                                       Margin="0"/>
                            <TextBlock Text="Filtered by selected client"
                                       Style="{StaticResource PiInlineMetaStyle}"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                Command="{Binding RefreshCardsCommand}"
                                Style="{StaticResource PiIconButtonStyle}"
                                ToolTip="Refresh saved projects from database"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE72C;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <TextBlock DockPanel.Dock="Top"
                           Text="Loading…"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Margin="14,10,14,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoadingCards}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding CardsErrorMessage}"
                           FontSize="12"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="14,10,14,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCardsError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock DockPanel.Dock="Top"
                           Text="No saved projects yet. Save an invoice to build the library."
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           TextWrapping="Wrap"
                           Margin="14,10,14,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNoSavedProjects}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button DockPanel.Dock="Bottom"
                        HorizontalAlignment="Left"
                        Margin="14,8"
                        Command="{Binding ShowAllProjectsCommand}"
                        ToolTip="Show all saved project profiles">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PiViewAllLinkStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMoreProjects}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               TextDecorations="Underline">
                        <Run Text="View all ("/>
                        <Run Text="{Binding TotalProjectCount, Mode=OneWay}"/>
                        <Run Text=")"/>
                    </TextBlock>
                </Button>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="6,0">
                    <ItemsControl ItemsSource="{Binding SavedProjectCards}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoadingCards}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasNoSavedProjects}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PiListRowStyle}"
                                        ToolTip="Click to auto-fill project details">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.LoadProjectCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ContractPreview}"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0">
                                            <Run Text="{Binding ProjectIdentifierName, Mode=OneWay}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding SiteDeliveryLocation, Mode=OneWay}"/>
                                        </TextBlock>
                                        <Border Grid.Column="2"
                                                Style="{StaticResource PiUsageBadgeStyle}"
                                                Margin="8,0,0,0">
                                            <TextBlock Text="{Binding UsageBadgeText}"
                                                       FontSize="9" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
