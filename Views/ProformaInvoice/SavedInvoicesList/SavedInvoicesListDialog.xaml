<Window x:Class="ProGlassAutomation.Views.ProformaInvoice.SavedInvoicesList.SavedInvoicesListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:ProGlassAutomation.Views.ProformaInvoice.SavedInvoicesList"
        mc:Ignorable="d"
        Title="Load Saved Proforma Invoice"
        Height="800"
        Width="1400"
        MinHeight="600"
        MinWidth="1000"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Embedded list UserControl -->
        <local:SavedInvoicesListView x:Name="EmbeddedListView"
                                     Grid.Row="0"/>

        <!-- Footer bar — fixed: SideMenuBackgroundBrush + BorderBrush separator -->
        <Border CornerRadius="{DynamicResource CardCornerRadius}" Grid.Row="1"
                Background="{DynamicResource SideMenuBackgroundBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderBrush}"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Optional status hint -->
                <TextBlock Grid.Column="0"
                           Text="Select an invoice to load it into the wizard, or close to cancel."
                           FontSize="12"
                           Foreground="{DynamicResource MutedForegroundBrush}"
                           VerticalAlignment="Center"/>

                <!-- Close button — fixed: hover + press states, CornerRadius=10 -->
                <Button Grid.Column="1"
                        Style="{StaticResource OutlinedPillButton}"
                        Tag="&#xE711;" Content="CLOSE"
                        ToolTip="Close"
                        Click="OnCloseClick"/>
            </Grid>
        </Border>
    </Grid>
</Window>