<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.SavedInvoicesList.SavedInvoicesListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState"
             xmlns:loading="clr-namespace:ProGlassAutomation.Controls.LoadingState"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1400"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <Style x:Key="StatusPillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="Background" Value="{DynamicResource SecondaryForegroundBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Draft">
                    <Setter Property="Background" Value="{DynamicResource SecondaryForegroundBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Sent">
                    <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Approved">
                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Rejected">
                    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Expired">
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EmptyStateStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding FilteredCount}" Value="0"/>
                        <Condition Binding="{Binding IsLoading}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InvoiceListBoxItemStyle" TargetType="ListBoxItem"
               BasedOn="{StaticResource ModuleListBoxItemStyle}"/>

    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Border Style="{StaticResource ModuleListShellStyle}" Margin="0,0,0,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- KPI strip — same three numbers, compact industrial chrome -->
                <Border Grid.Row="0" Style="{StaticResource ModuleListKpiStripStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintBlueBrush}">
                                <TextBlock Text="&#xE8A5;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="{StaticResource TextSubhead}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Total" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding TotalCount}"
                                           Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="All saved PIs"
                                           Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintGreenBrush}">
                                <TextBlock Text="&#xE8A3;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="{StaticResource TextSubhead}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Showing" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding FilteredCount}"
                                           Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="After filters"
                                           Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="3" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintIndigoBrush}">
                                <TextBlock Text="&#xE9D2;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="{StaticResource TextSubhead}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Value" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding TotalValueSum, Converter={StaticResource CurrencyConverter}, ConverterParameter=prefix}"
                                           Style="{StaticResource ModuleListKpiValueStyle}"
                                           FontSize="{StaticResource TextTitleLarge}"/>
                                <TextBlock Text="Filtered sum"
                                           Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- One filter row — no fat search card, no hint banner -->
                <Border Grid.Row="1" Style="{StaticResource ModuleListFilterBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModuleListFilterInputStyle}"
                                 ToolTip="Search ref, company, customer, project"/>

                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding StatusFilterOptions}"
                                  SelectedItem="{Binding SelectedStatusFilter}"
                                  Style="{StaticResource ModuleListFilterComboStyle}"/>

                        <DatePicker Grid.Column="4"
                                    SelectedDate="{Binding FromDate}"
                                    Width="128"
                                    Style="{StaticResource ModuleListFilterDatePickerStyle}"
                                    ToolTip="From date"/>

                        <DatePicker Grid.Column="6"
                                    SelectedDate="{Binding ToDate}"
                                    Width="128"
                                    Style="{StaticResource ModuleListFilterDatePickerStyle}"
                                    ToolTip="To date"/>

                        <ComboBox Grid.Column="8"
                                  ItemsSource="{Binding SortPresetOptions}"
                                  SelectedItem="{Binding SelectedSortPreset}"
                                  Style="{StaticResource ModuleListFilterComboStyle}"/>

                        <StackPanel Grid.Column="10" Orientation="Horizontal">
                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Command="{Binding ClearFiltersCommand}"
                                    Margin="0,0,8,0"
                                    MinWidth="92"
                                    Tag="&#xE711;" Content="CLEAR"
                                    ToolTip="Clear all search filters"/>
                            <Button Style="{StaticResource PrimaryPillButton}"
                                    Command="{Binding RefreshCommand}"
                                    Margin="0,0,8,0"
                                    MinWidth="108"
                                    Tag="&#xE72C;" Content="REFRESH"
                                    ToolTip="Reload the invoice list"/>
                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Command="{Binding SetTodayFilterCommand}"
                                    Margin="0,0,8,0"
                                    MinWidth="92"
                                    Tag="&#xE787;" Content="TODAY"
                                    ToolTip="Filter invoices prepared today"/>
                            <Button Style="{StaticResource SuccessPillButton}"
                                    Command="{Binding ExportFilteredExcelCommand}"
                                    MinWidth="130"
                                    Tag="&#xE72D;" Content="SHARE EXCEL"
                                    ToolTip="Export the filtered invoices as one Excel table"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Pale table header -->
                <Border Grid.Row="2" Style="{StaticResource ModuleListTableHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.8*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="REF #" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="2" Text="COMPANY" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="3" Text="CUSTOMER" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="4" Text="PROJECT" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="5" Text="STATUS" Style="{StaticResource ModuleListHeaderTextStyle}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="GRAND TOTAL" Style="{StaticResource ModuleListHeaderTextStyle}"
                                   HorizontalAlignment="Right" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="7" Text="DATE" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                        <TextBlock Grid.Column="8" Text="" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="3">
                    <loading:LoadingStateControl
                            Panel.ZIndex="2"
                            Visibility="{Binding IsLoading,
                                         Converter={StaticResource BoolToVisibilityConverter}}"
                            Message="Loading invoices…"/>

                    <StackPanel Panel.ZIndex="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Style="{StaticResource EmptyStateStyle}">
                        <emptyState:EmptyStateControl
                            Icon="&#xE7C3;"
                            Title="No saved invoices found"
                            Message="Add your first invoice from the toolbar above."/>
                    </StackPanel>

                    <ListBox Panel.ZIndex="0"
                             ItemsSource="{Binding FilteredItems}"
                             ItemContainerStyle="{StaticResource InvoiceListBoxItemStyle}"
                             BorderThickness="0"
                             Background="Transparent"
                             Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.IsDeferredScrollingEnabled="False"
                             ScrollViewer.PanningMode="None"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             VirtualizingStackPanel.ScrollUnit="Pixel"
                             VirtualizingStackPanel.CacheLength="200,400"
                             VirtualizingStackPanel.CacheLengthUnit="Pixel"
                             behaviors:SmoothScrollBehavior.IsEnabled="True">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ModuleListRowStyle}"
                                        MouseRightButtonUp="OnRowRightClick"
                                        MinHeight="48">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.8*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Draft">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Sent">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource AccentDarkBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Expired">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ProformaId}"
                                                   FontSize="{StaticResource TextBodyLarge}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Padding="14,12"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding CompanyName}"
                                                   FontSize="{StaticResource TextBody}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   Padding="14,12"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding CompanyName}"/>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding CustomerName}"
                                                   FontSize="{StaticResource TextBody}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   Padding="14,12"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding CustomerName}"/>

                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding ProjectName}"
                                                   FontSize="{StaticResource TextBody}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   Padding="14,12"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding ProjectName}"/>

                                        <Border Grid.Column="5"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Padding="10,4"
                                                MinWidth="88"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="{Binding DisplayStatusBrushKey,
                                                                     Converter={StaticResource BrushKeyConverter}}">
                                            <TextBlock Text="{Binding DisplayStatus}"
                                                       FontSize="{StaticResource TextCaption}"
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>

                                        <TextBlock Grid.Column="6"
                                                   Text="{Binding GrandTotal, Converter={StaticResource CurrencyConverter}, ConverterParameter=prefix}"
                                                   FontSize="{StaticResource TextBodyLarge}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   Padding="14,12"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="7"
                                                   Text="{Binding CreatedAt, StringFormat=dd MMM yyyy}"
                                                   FontSize="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   Padding="14,12"
                                                   VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="8"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource RowPrimaryButton}"
                                                    Command="{Binding DataContext.LoadInvoiceCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Open &amp; Edit (right-click for more options)"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Margin="6,0"
                                                    MinWidth="72"
                                                    Tag="&#xE8E5;" Content="OPEN"/>
                                            <Button Style="{StaticResource RowOutlinedButton}"
                                                    Command="{Binding DataContext.ShowVersionsCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Version history"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Margin="4,0,8,0"
                                                    MinWidth="36"
                                                    Tag="&#xE81C;"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
