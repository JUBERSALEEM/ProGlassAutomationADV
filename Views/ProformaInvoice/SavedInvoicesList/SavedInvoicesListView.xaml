<!-- Studio Bento list: original collections, workflows and data contexts retained. -->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState" xmlns:layout="clr-namespace:ProGlassAutomation.Views.Dashboard" xmlns:loading="clr-namespace:ProGlassAutomation.Controls.LoadingState" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ProGlassAutomation.Views.ProformaInvoice.SavedInvoicesList.SavedInvoicesListView" mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1400" FontFamily="{DynamicResource AppFontFamily}" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed" UseLayoutRounding="True" SnapsToDevicePixels="True" Background="{DynamicResource Ov.Canvas}" Foreground="{DynamicResource Ov.Ink}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Shared/Lists/StudioListResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <Border Style="{StaticResource Sl.Shell}" Margin="0,0,0,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource Sl.ToolbarHeight}}" Grid.Row="0" x:Name="ToolbarViewport">
                    <StackPanel Margin="0,0,0,8">
                        <layout:IndigoDashboardPanel MaxColumns="3" MinimumColumnWidth="270" Gap="14">
                            <Border Style="{StaticResource Sl.Hero}">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0">
                                        <StackPanel Margin="0" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="Filtered quote value"
                                                Style="{StaticResource Sl.Label}"
                                                TextWrapping="Wrap"
                                                Foreground="{DynamicResource Ov.OnAccent}" />
                                            <TextBlock
                                                Text="{Binding TotalValueSum, Converter={StaticResource CurrencyConverter}, ConverterParameter=prefix}"
                                                Style="{StaticResource Sl.Value}"
                                                TextWrapping="Wrap"
                                                Foreground="{DynamicResource Ov.OnAccent}"
                                                FontSize="30"
                                                Typography.NumeralAlignment="Tabular" />
                                            <TextBlock
                                                Text="{DynamicResource ProformaInvoice.FilteredSum}"
                                                Style="{StaticResource Sl.Subtitle}"
                                                TextWrapping="Wrap"
                                                Foreground="{DynamicResource Ov.OnAccent}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock
                                        Text="VAT-inclusive filtered quotations — not collected revenue."
                                        Style="{StaticResource Sl.Subtitle}"
                                        Foreground="{DynamicResource Ov.OnAccentMuted}"
                                        Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                            <layout:IndigoDashboardPanel MaxColumns="1" MinimumColumnWidth="110" Gap="10">
                                <Border Style="{StaticResource Sl.Card}" Padding="14,10">
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0">
                                        <StackPanel Margin="0" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{DynamicResource Common.Total}"
                                                Style="{StaticResource Sl.Label}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Text="{Binding TotalCount, StringFormat=N0}"
                                                Style="{StaticResource Sl.Value}"
                                                TextWrapping="Wrap"
                                                Typography.NumeralAlignment="Tabular" />
                                            <TextBlock
                                                Text="{DynamicResource ProformaInvoice.SavedPis}"
                                                Style="{StaticResource Sl.Subtitle}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Sl.Card}" Padding="14,10">
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0">
                                        <StackPanel Margin="0" VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{DynamicResource ProformaInvoice.Showing}"
                                                Style="{StaticResource Sl.Label}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Text="{Binding FilteredCount, StringFormat=N0}"
                                                Style="{StaticResource Sl.Value}"
                                                TextWrapping="Wrap"
                                                Typography.NumeralAlignment="Tabular" />
                                            <TextBlock
                                                Text="{DynamicResource ProformaInvoice.AfterFilters}"
                                                Style="{StaticResource Sl.Subtitle}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </layout:IndigoDashboardPanel>
                            <Border Style="{StaticResource Sl.Card}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Common.Actions}" Style="{StaticResource Sl.Label}" />
                                    <Button
                                        Style="{StaticResource Sl.PrimaryButton}"
                                        Command="{Binding RefreshCommand}"
                                        Margin="0,8,0,0"
                                        Tag="&#xE72C;"
                                        Content="{DynamicResource Action.Refresh}"
                                        ToolTip="{DynamicResource ProformaInvoice.ReloadInvoiceList}"
                                        HorizontalAlignment="Stretch" />
                                    <Button
                                        Style="{StaticResource Sl.SuccessButton}"
                                        Command="{Binding ExportFilteredExcelCommand}"
                                        Tag="&#xE72D;"
                                        Content="{DynamicResource ProformaInvoice.ShareExcel}"
                                        ToolTip="{DynamicResource ProformaInvoice.ExportFilteredInvoicesOneExcelTable}"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Stretch" />
                                    <TextBlock
                                        Text="{Binding LastExportStatus}"
                                        Style="{StaticResource Sl.Subtitle}"
                                        Visibility="{Binding HasExportStatus, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Margin="0,10,0,0"
                                        Typography.NumeralAlignment="Tabular" />
                                    <Border Style="{StaticResource Sl.Error}" Margin="0,8,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Sl.Subtitle}" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </layout:IndigoDashboardPanel>
                        <Border Style="{StaticResource Sl.FilterBar}">
                            <WrapPanel>
                                <StackPanel>
                                    <TextBlock Text="Search" Style="{StaticResource Sl.Label}" Margin="0,0,0,3" />
                                    <TextBox
                                        Margin="0,0,8,4"
                                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                        Style="{StaticResource Sl.Input}"
                                        ToolTip="{DynamicResource ProformaInvoice.SearchRefCompanyCustomerProject}"
                                        Width="280" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Status" Style="{StaticResource Sl.Label}" Margin="0,0,0,3" />
                                    <ComboBox
                                        Margin="0,0,8,4"
                                        MinWidth="120"
                                        ItemsSource="{Binding StatusFilterOptions}"
                                        SelectedItem="{Binding SelectedStatusFilter}"
                                        Style="{StaticResource Sl.Combo}"
                                        Width="180" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Created from" Style="{StaticResource Sl.Label}" Margin="0,0,0,3" />
                                    <DatePicker
                                        Margin="0,0,8,4"
                                        MinWidth="120"
                                        SelectedDate="{Binding FromDate}"
                                        Style="{StaticResource Sl.Date}"
                                        ToolTip="{DynamicResource Common.FromDate}"
                                        Width="148" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Created to" Style="{StaticResource Sl.Label}" Margin="0,0,0,3" />
                                    <DatePicker
                                        Margin="0,0,8,4"
                                        MinWidth="120"
                                        SelectedDate="{Binding ToDate}"
                                        Style="{StaticResource Sl.Date}"
                                        ToolTip="{DynamicResource Common.ToDate}"
                                        Width="148" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Sort" Style="{StaticResource Sl.Label}" Margin="0,0,0,3" />
                                    <ComboBox
                                        Margin="0,0,8,4"
                                        MinWidth="120"
                                        ItemsSource="{Binding SortPresetOptions}"
                                        SelectedItem="{Binding SelectedSortPreset}"
                                        Style="{StaticResource Sl.Combo}"
                                        Width="180" />
                                </StackPanel>
                                <CheckBox
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,8,4"
                                    IsChecked="{Binding ShowVoided}"
                                    Content="{DynamicResource Void.ShowVoided}"
                                    ToolTip="{DynamicResource Void.ShowVoidedTip}" />
                                <Button
                                    Style="{StaticResource Sl.Button}"
                                    Command="{Binding ClearFiltersCommand}"
                                    Margin="0,0,8,4"
                                    MinWidth="92"
                                    Tag="&#xE711;"
                                    Content="{DynamicResource Action.Clear}"
                                    ToolTip="{DynamicResource ProformaInvoice.ClearSearchFilters}"
                                    VerticalAlignment="Bottom" />
                                <Button
                                    Style="{StaticResource Sl.Button}"
                                    Command="{Binding SetTodayFilterCommand}"
                                    Margin="0,0,8,4"
                                    MinWidth="92"
                                    Tag="&#xE787;"
                                    Content="{DynamicResource Shell.Today}"
                                    ToolTip="{DynamicResource ProformaInvoice.FilterInvoicesPreparedToday}"
                                    VerticalAlignment="Bottom" />
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Border Style="{StaticResource Sl.Card}" Padding="0" Grid.Row="1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False" x:Name="RegisterViewport">
                        <Grid MinWidth="1350" Width="{Binding ViewportWidth, ElementName=RegisterViewport, Converter={StaticResource Sl.Extent}}" Height="{Binding ViewportHeight, ElementName=RegisterViewport, Converter={StaticResource Sl.Extent}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource Sl.TableHeader}" Margin="{Binding Source={x:Static SystemParameters.VerticalScrollBarWidth}, Converter={StaticResource Sl.Gutter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="1.3*" MinWidth="120" />
                                        <ColumnDefinition Width="1.5*" MinWidth="130" />
                                        <ColumnDefinition Width="1.5*" MinWidth="130" />
                                        <ColumnDefinition Width="1.2*" MinWidth="100" />
                                        <ColumnDefinition Width="0.8*" MinWidth="85" />
                                        <ColumnDefinition Width="0.9*" MinWidth="95" />
                                        <ColumnDefinition Width="0.7*" MinWidth="85" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{DynamicResource ProformaInvoice.REF}"
                                        Style="{StaticResource Sl.ColumnLabel}"
                                        Margin="12,0" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{DynamicResource Common.Company}"
                                        Style="{StaticResource Sl.ColumnLabel}"
                                        Margin="12,0" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{DynamicResource Common.Customer}"
                                        Style="{StaticResource Sl.ColumnLabel}"
                                        Margin="12,0" />
                                    <TextBlock
                                        Grid.Column="4"
                                        Text="{DynamicResource Common.Project}"
                                        Style="{StaticResource Sl.ColumnLabel}"
                                        Margin="12,0" />
                                    <TextBlock
                                        Grid.Column="5"
                                        Text="{DynamicResource Common.Status}"
                                        Style="{StaticResource Sl.ColumnLabel}"
                                        HorizontalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="6"
                                        Text="{DynamicResource ProformaInvoice.GrandTotal}"
                                        Style="{StaticResource Sl.ColumnLabel}"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,12,0"
                                        TextWrapping="Wrap"
                                        ToolTip="{DynamicResource ProformaInvoice.GrandTotal}" />
                                    <TextBlock
                                        Grid.Column="7"
                                        Text="{DynamicResource Common.Date}"
                                        Style="{StaticResource Sl.ColumnLabel}"
                                        Margin="12,0" />
                                    <TextBlock
                                        Text="{DynamicResource Common.Actions}"
                                        Style="{StaticResource Sl.ColumnLabel}"
                                        Grid.Column="8"
                                        HorizontalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1" Style="{StaticResource Sl.DataArea}">
                                <loading:LoadingStateControl
                                    Panel.ZIndex="2"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Message="Loading invoices…" />
                                <Border Panel.ZIndex="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding FilteredItems.Count}" Value="0" />
                                                        <Condition Binding="{Binding IsLoading}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <emptyState:EmptyStateControl
                                        Icon="&#xE7C3;"
                                        Title="{DynamicResource ProformaInvoice.NoSavedInvoicesFound}"
                                        Message="Add your first invoice from the toolbar above." />
                                </Border>
                                <ListBox Panel.ZIndex="0" ItemsSource="{Binding FilteredItems}" ItemContainerStyle="{StaticResource Sl.ListItem}" BorderThickness="{DynamicResource Border.NoneThickness}" Background="Transparent" Focusable="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.CanContentScroll="True" ScrollViewer.IsDeferredScrollingEnabled="False" ScrollViewer.PanningMode="None" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" VirtualizingStackPanel.ScrollUnit="Pixel" VirtualizingStackPanel.CacheLength="200,400" VirtualizingStackPanel.CacheLengthUnit="Pixel" behaviors:SmoothScrollBehavior.IsEnabled="True" Padding="0">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border MouseRightButtonUp="OnRowRightClick" MinHeight="48" Style="{StaticResource Sl.Row}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3" />
                                                        <ColumnDefinition Width="1.3*" MinWidth="120" />
                                                        <ColumnDefinition Width="1.5*" MinWidth="130" />
                                                        <ColumnDefinition Width="1.5*" MinWidth="130" />
                                                        <ColumnDefinition Width="1.2*" MinWidth="100" />
                                                        <ColumnDefinition Width="0.8*" MinWidth="85" />
                                                        <ColumnDefinition Width="0.9*" MinWidth="95" />
                                                        <ColumnDefinition Width="0.7*" MinWidth="85" />
                                                        <ColumnDefinition Width="260" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        Grid.Column="0"
                                                        Background="{Binding DisplayStatusBrushKey, Converter={StaticResource Sl.StatusBrush}}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{Binding ProformaId}"
                                                        FontSize="{DynamicResource FontSize.Title}"
                                                        FontWeight="{DynamicResource Weight.Bold}"
                                                        Foreground="{DynamicResource Ov.Accent}"
                                                        Padding="12,12"
                                                        VerticalAlignment="Center"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip="{Binding ProformaId}"
                                                        Typography.NumeralAlignment="Tabular" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Text="{Binding CompanyName}"
                                                        FontSize="{DynamicResource FontSize.Body}"
                                                        TextTrimming="CharacterEllipsis"
                                                        Foreground="{DynamicResource Ov.Ink}"
                                                        Padding="12,12"
                                                        VerticalAlignment="Center"
                                                        ToolTip="{Binding CompanyName}"
                                                        Typography.NumeralAlignment="Tabular" />
                                                    <TextBlock
                                                        Grid.Column="3"
                                                        Text="{Binding CustomerName}"
                                                        FontSize="{DynamicResource FontSize.Body}"
                                                        TextTrimming="CharacterEllipsis"
                                                        Foreground="{DynamicResource Ov.Ink}"
                                                        Padding="12,12"
                                                        VerticalAlignment="Center"
                                                        ToolTip="{Binding CustomerName}"
                                                        Typography.NumeralAlignment="Tabular" />
                                                    <TextBlock
                                                        Grid.Column="4"
                                                        Text="{Binding ProjectName}"
                                                        FontSize="{DynamicResource FontSize.Body}"
                                                        TextTrimming="CharacterEllipsis"
                                                        Foreground="{DynamicResource Ov.Muted}"
                                                        Padding="12,12"
                                                        VerticalAlignment="Center"
                                                        ToolTip="{Binding ProjectName}"
                                                        Typography.NumeralAlignment="Tabular" />
                                                    <Border Grid.Column="5" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="8,4" MinWidth="88" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{Binding DisplayStatusBrushKey,                                                                      Converter={StaticResource Sl.StatusBrush}, ConverterParameter=soft}">
                                                        <TextBlock
                                                            Text="{Binding DisplayStatus}"
                                                            FontSize="{DynamicResource FontSize.BodySmall}"
                                                            FontWeight="{DynamicResource Weight.Bold}"
                                                            Foreground="{Binding DisplayStatusBrushKey, Converter={StaticResource Sl.StatusBrush}, ConverterParameter=ink}"
                                                            HorizontalAlignment="Center"
                                                            ToolTip="{Binding DisplayStatus}"
                                                            TextTrimming="CharacterEllipsis"
                                                            Typography.NumeralAlignment="Tabular"
                                                            TextWrapping="Wrap"
                                                            MaxWidth="155" />
                                                    </Border>
                                                    <TextBlock
                                                        Grid.Column="6"
                                                        Text="{Binding GrandTotal, Converter={StaticResource CurrencyConverter}, ConverterParameter=prefix}"
                                                        FontSize="{DynamicResource FontSize.Title}"
                                                        FontWeight="{DynamicResource Weight.Bold}"
                                                        Foreground="{DynamicResource Ov.Ink}"
                                                        Padding="12,12"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Typography.NumeralAlignment="Tabular"
                                                        TextWrapping="Wrap"
                                                        ToolTip="{Binding GrandTotal, Converter={StaticResource CurrencyConverter}, ConverterParameter=prefix}" />
                                                    <TextBlock
                                                        Grid.Column="7"
                                                        Text="{Binding CreatedAt, StringFormat={}{0:d}}"
                                                        FontSize="{DynamicResource FontSize.Body}"
                                                        Foreground="{DynamicResource Ov.Muted}"
                                                        Padding="12,12"
                                                        VerticalAlignment="Center"
                                                        ToolTip="{Binding CreatedAt, StringFormat={}{0:G}}"
                                                        Typography.NumeralAlignment="Tabular" />
                                                    <WrapPanel Grid.Column="8" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,8,0">
                                                        <Button
                                                            Style="{StaticResource Sl.PrimaryButton}"
                                                            Command="{Binding DataContext.LoadInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="{DynamicResource ProformaInvoice.OpenEditRightClickMoreOptions}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Margin="4,0,0,0"
                                                            MinWidth="72"
                                                            Tag="&#xE8E5;"
                                                            Content="{DynamicResource Action.Open}" />
                                                        <Button
                                                            Style="{StaticResource Sl.Button}"
                                                            Command="{Binding DataContext.ShowVersionsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="{DynamicResource Common.VersionHistory}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Margin="4,0,4,0"
                                                            Width="32"
                                                            Height="32"
                                                            MinWidth="32"
                                                            Tag="&#xE81C;"
                                                            Padding="2" />
                                                        <Button Style="{StaticResource Sl.Button}" Command="{Binding DataContext.ExportDossierCommand,                                                         RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="{DynamicResource ProformaInvoice.ExportDossierTip}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="32" Height="32" MinWidth="32" Content="&#xE9F9;" FontFamily="{DynamicResource FontFamily.Icon}" Margin="4,0,0,0" Padding="2">
                                                            <Button.Tag>
                                                                <Binding
                                                                    Path="DataContext"
                                                                    RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                            </Button.Tag>
                                                            <Button.ContextMenu>
                                                                <ContextMenu Style="{StaticResource Sl.ContextMenu}">
                                                                    <MenuItem
                                                                        Style="{StaticResource Sl.MenuItem}"
                                                                        Header="{DynamicResource ProformaInvoice.ExportDossier}"
                                                                        Command="{Binding PlacementTarget.Tag.ExportDossierCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                    <MenuItem
                                                                        Style="{StaticResource Sl.MenuItem}"
                                                                        Header="{DynamicResource ProformaInvoice.ExportDossierPdf}"
                                                                        Command="{Binding PlacementTarget.Tag.ExportDossierPdfCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                    <Separator />
                                                                    <MenuItem
                                                                        Style="{StaticResource Sl.MenuItem}"
                                                                        Header="{DynamicResource ProformaInvoice.ExportDossierInternal}"
                                                                        Command="{Binding PlacementTarget.Tag.ExportInternalDossierCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                    <MenuItem
                                                                        Style="{StaticResource Sl.MenuItem}"
                                                                        Header="{DynamicResource ProformaInvoice.ExportDossierInternalPdf}"
                                                                        Command="{Binding PlacementTarget.Tag.ExportInternalDossierPdfCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                </ContextMenu>
                                                            </Button.ContextMenu>
                                                        </Button>
                                                        <Button
                                                            Style="{StaticResource Sl.Button}"
                                                            Command="{Binding DataContext.ShareFromListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="{DynamicResource Sharing.Share}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Margin="4,0,8,0"
                                                            Width="32"
                                                            Height="32"
                                                            MinWidth="32"
                                                            Content="&#xE72D;"
                                                            FontFamily="{DynamicResource FontFamily.Icon}"
                                                            Padding="2" />
                                                        <Button
                                                            Style="{StaticResource Sl.Button}"
                                                            Content="⋯"
                                                            ToolTip="More actions"
                                                            Click="OnRowMoreClick"
                                                            Width="34"
                                                            Padding="2"
                                                            Margin="4,4,0,4"
                                                            AutomationProperties.Name="More row actions" />
                                                    </WrapPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
