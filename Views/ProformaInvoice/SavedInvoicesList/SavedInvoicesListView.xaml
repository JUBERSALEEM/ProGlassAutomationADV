<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.SavedInvoicesList.SavedInvoicesListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <!-- Stat cards with shadow + rounded corners -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter text input -->
        <Style x:Key="FilterInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Filter combo -->
        <Style x:Key="FilterComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Status pill with color per status -->
        <Style x:Key="StatusPillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#94A3B8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Draft">
                    <Setter Property="Background" Value="#94A3B8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Sent">
                    <Setter Property="Background" Value="#3B82F6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Approved">
                    <Setter Property="Background" Value="#22C55E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Rejected">
                    <Setter Property="Background" Value="#EF4444"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Expired">
                    <Setter Property="Background" Value="#F59E0B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Empty state -->
        <Style x:Key="EmptyStateStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding FilteredCount}" Value="0">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Card-style row with hover border -->
        <Style x:Key="RowCardStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource WindowBackgroundBrush}"
                  Padding="20">
        <StackPanel>

            <!-- ═══════════════════ STAT CARDS ═══════════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="TOTAL INVOICES" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding TotalCount}"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="SHOWING" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding FilteredCount}"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCardStyle}" MinWidth="200">
                    <StackPanel>
                        <TextBlock Text="TOTAL VALUE" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding TotalValueSum, StringFormat=AED {0:N2}}"
                                   FontSize="22" FontWeight="Bold" Foreground="#22C55E"/>
                    </StackPanel>
                </Border>

                <!-- Refresh button -->
                <Button Command="{Binding RefreshCommand}"
                        Margin="20,0,0,0" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RefreshBg"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="10"
                                    Padding="18,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⟳" FontSize="16" Foreground="White" Margin="0,-2,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="REFRESH" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RefreshBg" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- ═══════════════════ FILTERS ═══════════════════ -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    CornerRadius="12" Padding="16" BorderThickness="1.5"
                    BorderBrush="{DynamicResource MenuHoverBrush}"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🔍 SEARCH &amp; FILTER" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SEARCH" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilterInputStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="STATUS" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                                      SelectedItem="{Binding SelectedStatusFilter}"
                                      Style="{StaticResource FilterComboStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="FROM" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding FromDate}" Height="32" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="TO" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding ToDate}" Height="32" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="8">
                            <TextBlock Text="SORT BY" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding SortPresetOptions}"
                                      SelectedItem="{Binding SelectedSortPreset}"
                                      Style="{StaticResource FilterComboStyle}"/>
                        </StackPanel>

                        <!-- Clear button -->
                        <Button Grid.Column="10"
                                Command="{Binding ClearFiltersCommand}"
                                Margin="0,18,0,0" Cursor="Hand"
                                Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ClearBg"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource MenuHoverBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="8"
                                            Padding="14,6"
                                            Height="32">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="✕" FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                       Margin="0,0,6,0"/>
                                            <TextBlock Text="CLEAR" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ClearBg" Property="BorderBrush" Value="#EF4444"/>
                                            <Setter TargetName="ClearBg" Property="Background" Value="#15EF4444"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══════════════════ TABLE HEADER ═══════════════════ -->
            <Border Background="#1E293B" Padding="0" CornerRadius="10,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.8*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="REF #" FontSize="10" FontWeight="Bold" Foreground="White" Padding="12,10"/>
                    <TextBlock Grid.Column="1" Text="COMPANY" FontSize="10" FontWeight="Bold" Foreground="White" Padding="10,10"/>
                    <TextBlock Grid.Column="2" Text="CUSTOMER" FontSize="10" FontWeight="Bold" Foreground="White" Padding="10,10"/>
                    <TextBlock Grid.Column="3" Text="PROJECT" FontSize="10" FontWeight="Bold" Foreground="White" Padding="10,10"/>
                    <TextBlock Grid.Column="4" Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="White" Padding="10,10" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="GRAND TOTAL" FontSize="10" FontWeight="Bold" Foreground="White" Padding="10,10" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="DATE" FontSize="10" FontWeight="Bold" Foreground="White" Padding="10,10"/>
                    <TextBlock Grid.Column="7" Text="ACTION" FontSize="10" FontWeight="Bold" Foreground="White" Padding="10,10" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ═══════════════════ TABLE ROWS ═══════════════════ -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}" BorderThickness="1,0,1,1"
                    BorderBrush="{DynamicResource MenuHoverBrush}" CornerRadius="0,0,10,10"
                    Padding="4,4,4,8">
                <StackPanel>

                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,50" Style="{StaticResource EmptyStateStyle}">
                        <TextBlock Text="&#128203;" FontSize="48" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}" Opacity="0.4"/>
                        <TextBlock Text="No saved invoices found"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text="Click '+ NEW INVOICE' above to create your first proforma invoice."
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Rows -->
                    <ItemsControl ItemsSource="{Binding FilteredItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowCardStyle}"
                                        MouseRightButtonUp="OnRowRightClick">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.8*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- REF # -->
                                        <TextBlock Grid.Column="0" Text="{Binding ProformaId}"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Padding="12,10" VerticalAlignment="Center"/>

                                        <!-- COMPANY -->
                                        <TextBlock Grid.Column="1" Text="{Binding CompanyName}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   Padding="10,10" VerticalAlignment="Center"/>

                                        <!-- CUSTOMER -->
                                        <TextBlock Grid.Column="2" Text="{Binding CustomerName}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   Padding="10,10" VerticalAlignment="Center"/>

                                        <!-- PROJECT -->
                                        <TextBlock Grid.Column="3" Text="{Binding ProjectName}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   Padding="10,10" VerticalAlignment="Center"/>

                                        <!-- STATUS pill -->
                                        <Border Grid.Column="4"
                                                Style="{StaticResource StatusPillStyle}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- GRAND TOTAL (centered, vibrant green) -->
                                        <TextBlock Grid.Column="5" Text="{Binding GrandTotal, StringFormat=AED {0:N2}}"
                                                   FontSize="12" FontWeight="Bold" Foreground="#22C55E"
                                                   Padding="10,10" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <!-- DATE -->
                                        <TextBlock Grid.Column="6" Text="{Binding CreatedAt, StringFormat=yyyy-MM-dd}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   Padding="10,10" VerticalAlignment="Center"/>

                                        <!-- OPEN button (accent filled pill) -->
                                        <Button Grid.Column="7"
                                                Command="{Binding DataContext.LoadInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Open &amp; Edit (right-click for more options)"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Cursor="Hand"
                                                Background="Transparent"
                                                BorderThickness="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="OpenBtnBg"
                                                            Background="{DynamicResource AccentBrush}"
                                                            CornerRadius="6"
                                                            Padding="12,5">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📂" FontSize="11" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBlock Text="OPEN" FontWeight="Bold" FontSize="10" Foreground="White" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="OpenBtnBg" Property="Opacity" Value="0.85"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

            <!-- Hint card -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    CornerRadius="10" Padding="14,10" Margin="0,12,0,0"
                    BorderThickness="1" BorderBrush="{DynamicResource MenuHoverBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💡" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Right-click any row for more options: Duplicate, Export PDF/Excel, Change Status, Delete"
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>