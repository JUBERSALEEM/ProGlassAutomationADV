<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.SavedInvoicesList.SavedInvoicesListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:ProGlassAutomation.Behaviors"
             xmlns:emptyState="clr-namespace:ProGlassAutomation.Controls.EmptyState"
             xmlns:loading="clr-namespace:ProGlassAutomation.Controls.LoadingState"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1400"
             FontFamily="{DynamicResource AppFontFamily}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             TextOptions.TextHintingMode="Fixed"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        

        

        

    </UserControl.Resources>

    <Grid Background="Transparent">
        <Border Style="{StaticResource ModuleListShellStyle}" Margin="0,0,0,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- KPI strip — same three numbers, compact industrial chrome -->
                <Border Grid.Row="0" Style="{StaticResource ModuleListKpiStripStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintBlueBrush}">
                                <TextBlock Text="&#xE8A5;"
                                           FontFamily="{DynamicResource FontFamily.Icon}"
                                           FontSize="{DynamicResource FontSize.H3}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Common.Total}" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding TotalCount}"
                                           Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="{DynamicResource ProformaInvoice.SavedPis}"
                                           Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintGreenBrush}">
                                <TextBlock Text="&#xE8A3;"
                                           FontFamily="{DynamicResource FontFamily.Icon}"
                                           FontSize="{DynamicResource FontSize.H3}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource ProformaInvoice.Showing}" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding FilteredCount}"
                                           Style="{StaticResource ModuleListKpiValueStyle}"/>
                                <TextBlock Text="{DynamicResource ProformaInvoice.AfterFilters}"
                                           Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="3" Style="{StaticResource ModuleListKpiDividerStyle}"/>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ModuleListKpiIconStyle}"
                                    Background="{DynamicResource TintIndigoBrush}">
                                <TextBlock Text="&#xE9D2;"
                                           FontFamily="{DynamicResource FontFamily.Icon}"
                                           FontSize="{DynamicResource FontSize.H3}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Inquiry.Value}" Style="{StaticResource ModuleListKpiLabelStyle}"/>
                                <TextBlock Text="{Binding TotalValueSum, Converter={StaticResource CurrencyConverter}, ConverterParameter=prefix}"
                                           Style="{StaticResource ModuleListKpiValueStyle}"
                                           FontSize="{DynamicResource FontSize.H1}"/>
                                <TextBlock Text="{DynamicResource ProformaInvoice.FilteredSum}"
                                           Style="{StaticResource ModuleListKpiHintStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- One filter row — no fat search card, no hint banner -->
                <Border Grid.Row="1" Style="{StaticResource ModuleListFilterBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                 Style="{StaticResource ModuleListFilterInputStyle}"
                                 ToolTip="{DynamicResource ProformaInvoice.SearchRefCompanyCustomerProject}"/>

                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding StatusFilterOptions}"
                                  SelectedItem="{Binding SelectedStatusFilter}"
                                  Style="{StaticResource ModuleListFilterComboStyle}"/>

                        <DatePicker Grid.Column="4"
                                    SelectedDate="{Binding FromDate}"
                                    Width="128"
                                    Style="{StaticResource ModuleListFilterDatePickerStyle}"
                                    ToolTip="{DynamicResource Common.FromDate}"/>

                        <DatePicker Grid.Column="6"
                                    SelectedDate="{Binding ToDate}"
                                    Width="128"
                                    Style="{StaticResource ModuleListFilterDatePickerStyle}"
                                    ToolTip="{DynamicResource Common.ToDate}"/>

                        <ComboBox Grid.Column="8"
                                  ItemsSource="{Binding SortPresetOptions}"
                                  SelectedItem="{Binding SelectedSortPreset}"
                                  Style="{StaticResource ModuleListFilterComboStyle}"/>

                        <StackPanel Grid.Column="10" Orientation="Horizontal">
                            <CheckBox VerticalAlignment="Center"
                                      Margin="0,0,12,0"
                                      IsChecked="{Binding ShowVoided}"
                                      Content="{DynamicResource Void.ShowVoided}"
                                      ToolTip="{DynamicResource Void.ShowVoidedTip}"/>
                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Command="{Binding ClearFiltersCommand}"
                                    Margin="0,0,8,0"
                                    MinWidth="92"
                                    Tag="&#xE711;" Content="{DynamicResource Action.Clear}"
                                    ToolTip="{DynamicResource ProformaInvoice.ClearSearchFilters}"/>
                            <Button Style="{StaticResource PrimaryPillButton}"
                                    Command="{Binding RefreshCommand}"
                                    Margin="0,0,8,0"
                                    MinWidth="108"
                                    Tag="&#xE72C;" Content="{DynamicResource Action.Refresh}"
                                    ToolTip="{DynamicResource ProformaInvoice.ReloadInvoiceList}"/>
                            <Button Style="{StaticResource OutlinedPillButton}"
                                    Command="{Binding SetTodayFilterCommand}"
                                    Margin="0,0,8,0"
                                    MinWidth="92"
                                    Tag="&#xE787;" Content="{DynamicResource Shell.Today}"
                                    ToolTip="{DynamicResource ProformaInvoice.FilterInvoicesPreparedToday}"/>
                            <Button Style="{StaticResource SuccessPillButton}"
                                    Command="{Binding ExportFilteredExcelCommand}"
                                    MinWidth="130"
                                    Tag="&#xE72D;" Content="{DynamicResource ProformaInvoice.ShareExcel}"
                                    ToolTip="{DynamicResource ProformaInvoice.ExportFilteredInvoicesOneExcelTable}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Table header — full-colour panel.
                     2026-09-14: was a BARE border (no background) while the
                     Tax Invoice / Delivery Note lists use
                     ModuleListTableHeaderStyle (SurfaceTertiary full colour
                     + divider). Now the same module-list standard. -->
                <Border Grid.Row="2" Style="{StaticResource ModuleListTableHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="231"/>
                            <ColumnDefinition Width="231"/>
                            <ColumnDefinition Width="231"/>
                            <ColumnDefinition Width="231"/>
                            <ColumnDefinition Width="231"/>
                            <ColumnDefinition Width="231"/>
                            <ColumnDefinition Width="231"/>
                            <ColumnDefinition Width="231"/>
                            </Grid.ColumnDefinitions>
                        <!-- 2026-09-14: row cells carry Padding 14,12 — the
                             header labels carry the matching left margins
                             so every column label sits exactly over its
                             data (was flush-left, offset 14px). -->
                        <TextBlock Grid.Column="1" Text="{DynamicResource ProformaInvoice.REF}" Style="{StaticResource ModuleListHeaderTextStyle}"
                                   Margin="14,0"/>
                        <TextBlock Grid.Column="2" Text="{DynamicResource Common.Company}" Style="{StaticResource ModuleListHeaderTextStyle}"
                                   Margin="14,0"/>
                        <TextBlock Grid.Column="3" Text="{DynamicResource Common.Customer}" Style="{StaticResource ModuleListHeaderTextStyle}"
                                   Margin="14,0"/>
                        <TextBlock Grid.Column="4" Text="{DynamicResource Common.Project}" Style="{StaticResource ModuleListHeaderTextStyle}"
                                   Margin="14,0"/>
                        <TextBlock Grid.Column="5" Text="{DynamicResource Common.Status}" Style="{StaticResource ModuleListHeaderTextStyle}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="{DynamicResource ProformaInvoice.GrandTotal}" Style="{StaticResource ModuleListHeaderTextStyle}"
                                   HorizontalAlignment="Right" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="7" Text="{DynamicResource Common.Date}" Style="{StaticResource ModuleListHeaderTextStyle}"
                                   Margin="14,0"/>
                        <TextBlock Grid.Column="8" Text="" Style="{StaticResource ModuleListHeaderTextStyle}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="3">
                    <loading:LoadingStateControl
                            Panel.ZIndex="2"
                            Visibility="{Binding IsLoading,
                                         Converter={StaticResource BoolToVisibilityConverter}}"
                            Message="Loading invoices…"/>

                    <Border Panel.ZIndex="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
        Style="{StaticResource SurfacePrimaryStyle}">
            <StackPanel>
                        <emptyState:EmptyStateControl
                            Icon="&#xE7C3;"
                            Title="{DynamicResource ProformaInvoice.NoSavedInvoicesFound}"
                            Message="Add your first invoice from the toolbar above."/>
                    </StackPanel>
    </Border>

                    <ListBox Panel.ZIndex="0"
                             ItemsSource="{Binding FilteredItems}"
                             ItemContainerStyle="{StaticResource ModuleListBoxItemStyle}"
                             BorderThickness="{DynamicResource Border.NoneThickness}"
                             Background="Transparent"
                             Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.IsDeferredScrollingEnabled="False"
                             ScrollViewer.PanningMode="None"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             VirtualizingStackPanel.ScrollUnit="Pixel"
                             VirtualizingStackPanel.CacheLength="200,400"
                             VirtualizingStackPanel.CacheLengthUnit="Pixel"
                             behaviors:SmoothScrollBehavior.IsEnabled="True">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border
                                        MouseRightButtonUp="OnRowRightClick"
                                        MinHeight="48">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="231"/>
                                            <ColumnDefinition Width="231"/>
                                            <ColumnDefinition Width="231"/>
                                            <ColumnDefinition Width="231"/>
                                            <ColumnDefinition Width="231"/>
                                            <ColumnDefinition Width="231"/>
                                            <ColumnDefinition Width="231"/>
                                            <ColumnDefinition Width="231"/>
                                            </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Draft">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource SecondaryForegroundBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Sent">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource AccentDarkBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Expired">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ProformaId}"
                                                   FontSize="{DynamicResource FontSize.Title}"
                                                   FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Padding="14,12"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding CompanyName}"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Padding="14,12"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding CompanyName}"/>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding CustomerName}"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Padding="14,12"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding CustomerName}"/>

                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding ProjectName}"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   Padding="14,12"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding ProjectName}"/>

                                        <Border Grid.Column="5"
                                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                                Padding="10,4"
                                                MinWidth="88"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="{Binding DisplayStatusBrushKey,
                                                                     Converter={StaticResource BrushKeyConverter}}" Style="{StaticResource SurfacePrimaryStyle}">
                                            <TextBlock Text="{Binding DisplayStatus}"
                                                       FontSize="{DynamicResource FontSize.BodySmall}"
                                                       FontWeight="{DynamicResource Weight.Bold}"
                                                       Foreground="{DynamicResource OnAccentForegroundBrush}"
                                                       HorizontalAlignment="Center"
                                                       ToolTip="{Binding DisplayStatus}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>

                                        <TextBlock Grid.Column="6"
                                                   Text="{Binding GrandTotal, Converter={StaticResource CurrencyConverter}, ConverterParameter=prefix}"
                                                   FontSize="{DynamicResource FontSize.Title}"
                                                   FontWeight="{DynamicResource Weight.Bold}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Padding="14,12"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="7"
                                                   Text="{Binding CreatedAt, StringFormat=dd MMM yyyy}"
                                                   FontSize="{DynamicResource FontSize.Body}"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   Padding="14,12"
                                                   VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="8"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource RowPrimaryButton}"
                                                    Command="{Binding DataContext.LoadInvoiceCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{DynamicResource ProformaInvoice.OpenEditRightClickMoreOptions}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Margin="4,0,0,0"
                                                    MinWidth="72"
                                                    Tag="&#xE8E5;" Content="{DynamicResource Action.Open}"/>
                                            <Button Style="{StaticResource RowOutlinedButton}"
                                                    Command="{Binding DataContext.ShowVersionsCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{DynamicResource Common.VersionHistory}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Margin="4,0,4,0"
                                                    MinWidth="36"
                                                    Tag="&#xE81C;"/>

                                            <!--
                                                FULL DOSSIER — every section in
                                                one workbook. Customer-safe: it
                                                does NOT contain profit & loss.
                                                The internal variant lives in
                                                the context menu, deliberately
                                                one step further away.
                                            -->
                                            <Button Style="{StaticResource RowOutlinedButton}"
                                                    Command="{Binding DataContext.ExportDossierCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{DynamicResource ProformaInvoice.ExportDossierTip}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    MinWidth="36"
                                                    Content="&#xE9F9;"
                                                    FontFamily="{DynamicResource FontFamily.Icon}"
                                                    Margin="4,0,0,0">
                                                <!--
                                                    A ContextMenu is its own
                                                    visual tree, so it cannot
                                                    reach the UserControl via
                                                    RelativeSource. The button
                                                    carries the parent view
                                                    model in Tag, and the menu
                                                    reads commands from there
                                                    while CommandParameter
                                                    takes the row from
                                                    PlacementTarget.DataContext.
                                                -->
                                                <Button.Tag>
                                                    <Binding Path="DataContext"
                                                             RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </Button.Tag>
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{DynamicResource ProformaInvoice.ExportDossier}"
                                                                  Command="{Binding PlacementTarget.Tag.ExportDossierCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="{DynamicResource ProformaInvoice.ExportDossierPdf}"
                                                                  Command="{Binding PlacementTarget.Tag.ExportDossierPdfCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <Separator/>
                                                        <MenuItem Header="{DynamicResource ProformaInvoice.ExportDossierInternal}"
                                                                  Command="{Binding PlacementTarget.Tag.ExportInternalDossierCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="{DynamicResource ProformaInvoice.ExportDossierInternalPdf}"
                                                                  Command="{Binding PlacementTarget.Tag.ExportInternalDossierPdfCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                            <!-- Sharing Center. -->
                                            <Button Style="{StaticResource RowOutlinedButton}"
                                                    Command="{Binding DataContext.ShareFromListCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{DynamicResource Sharing.Share}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"
                                                    MinWidth="36"
                                                    Content="&#xE72D;"
                                                    FontFamily="{DynamicResource FontFamily.Icon}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
