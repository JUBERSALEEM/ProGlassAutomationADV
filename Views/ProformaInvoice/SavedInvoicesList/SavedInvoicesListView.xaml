<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.SavedInvoicesList.SavedInvoicesListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>

        <Style x:Key="FilterInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ModuleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MenuHoverBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FilterComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RowActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status pill style base (NO Background — set per-status via DataTrigger only in-line) -->
        <Style x:Key="StatusPillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="#94A3B8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Draft">
                    <Setter Property="Background" Value="#94A3B8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Sent">
                    <Setter Property="Background" Value="#3B82F6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Approved">
                    <Setter Property="Background" Value="#22C55E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Rejected">
                    <Setter Property="Background" Value="#EF4444"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Expired">
                    <Setter Property="Background" Value="#F59E0B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Empty state visibility trigger -->
        <Style x:Key="EmptyStateStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding FilteredCount}" Value="0">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Row hover highlight -->
        <Style x:Key="RowGridStyle" TargetType="Grid">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource WindowBackgroundBrush}"
                  Padding="20">
        <StackPanel>

            <!-- ═══════════════════ HEADER ═══════════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Border Background="{DynamicResource AccentBrush}"
                        Width="32" Height="32" CornerRadius="8"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#128194;"
                               FontSize="16" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Title}"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
            <TextBlock Text="{Binding Subtitle}"
                       FontSize="12"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       Margin="0,0,0,16"/>

            <!-- ═══════════════════ STAT CARDS ═══════════════════ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="TOTAL INVOICES" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding TotalCount}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="SHOWING" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding FilteredCount}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StatCardStyle}" MinWidth="200">
                    <StackPanel>
                        <TextBlock Text="TOTAL VALUE" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding TotalValueSum, StringFormat=AED {0:N2}}"
                                   FontSize="22" FontWeight="Bold" Foreground="#047857" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Button Command="{Binding RefreshCommand}"
                        Background="{DynamicResource AccentBrush}" Foreground="White"
                        FontWeight="Bold" FontSize="11" Padding="16,10" Cursor="Hand" BorderThickness="0"
                        Margin="20,0,0,0" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⟳" FontSize="14" Margin="0,-2,6,0"/>
                        <TextBlock Text="REFRESH" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ═══════════════════ FILTERS ═══════════════════ -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}"
                    CornerRadius="8" Padding="14" BorderThickness="1"
                    BorderBrush="{DynamicResource MenuHoverBrush}"
                    Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="SEARCH &amp; FILTER" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SEARCH" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilterInputStyle}"/>
                        </StackPanel>

                        <!-- Status -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="STATUS" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                                      SelectedItem="{Binding SelectedStatusFilter}"
                                      Style="{StaticResource FilterComboStyle}"/>
                        </StackPanel>

                        <!-- From Date -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="FROM" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding FromDate}" Height="32" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- To Date -->
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="TO" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding ToDate}" Height="32" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Sort -->
                        <StackPanel Grid.Column="8">
                            <TextBlock Text="SORT BY" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                                       Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding SortPresetOptions}"
                                      SelectedItem="{Binding SelectedSortPreset}"
                                      Style="{StaticResource FilterComboStyle}"/>
                        </StackPanel>

                        <!-- Clear -->
                        <Button Grid.Column="10"
                                Command="{Binding ClearFiltersCommand}"
                                Background="Transparent"
                                BorderBrush="{DynamicResource MenuHoverBrush}" BorderThickness="1"
                                Foreground="{DynamicResource PrimaryForegroundBrush}"
                                FontWeight="SemiBold" FontSize="10"
                                Padding="12,7" Cursor="Hand" Margin="0,18,0,0" Height="32">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="✕ CLEAR"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══════════════════ TABLE HEADER ═══════════════════ -->
            <Border Background="#1E293B" Padding="0" CornerRadius="4,4,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="REF #" FontSize="10" FontWeight="Bold" Foreground="White" Padding="10,10"/>
                    <TextBlock Grid.Column="1" Text="COMPANY" FontSize="10" FontWeight="Bold" Foreground="White" Padding="10,10"/>
                    <TextBlock Grid.Column="2" Text="CUSTOMER" FontSize="10" FontWeight="Bold" Foreground="White" Padding="10,10"/>
                    <TextBlock Grid.Column="3" Text="PROJECT" FontSize="10" FontWeight="Bold" Foreground="White" Padding="10,10"/>
                    <TextBlock Grid.Column="4" Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="White" Padding="10,10"/>
                    <TextBlock Grid.Column="5" Text="GRAND TOTAL" FontSize="10" FontWeight="Bold" Foreground="White" Padding="10,10" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="6" Text="DATE" FontSize="10" FontWeight="Bold" Foreground="White" Padding="10,10"/>
                    <TextBlock Grid.Column="7" Text="ACTIONS" FontSize="10" FontWeight="Bold" Foreground="White" Padding="10,10" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ═══════════════════ TABLE ROWS ═══════════════════ -->
            <Border Background="{DynamicResource ModuleBackgroundBrush}" BorderThickness="1,0,1,1"
                    BorderBrush="{DynamicResource MenuHoverBrush}" CornerRadius="0,0,4,4">
                <StackPanel>

                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,40" Style="{StaticResource EmptyStateStyle}">
                        <TextBlock Text="&#128203;" FontSize="42" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}" Opacity="0.5"/>
                        <TextBlock Text="No saved invoices found"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   HorizontalAlignment="Center" Margin="0,10,0,4"/>
                        <TextBlock Text="Try adjusting filters or create a new invoice in the Proforma Invoice module."
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Rows -->
                    <ItemsControl ItemsSource="{Binding FilteredItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MenuHoverBrush}">
                                    <Grid Style="{StaticResource RowGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="1.3*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding ProformaId}"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Padding="10,10" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1" Text="{Binding CompanyName}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   Padding="10,10" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2" Text="{Binding CustomerName}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   Padding="10,10" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="3" Text="{Binding ProjectName}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   Padding="10,10" VerticalAlignment="Center"/>

                                        <!-- Status pill (uses StatusPillStyle which handles Background via DataTrigger) -->
                                        <Border Grid.Column="4"
                                                Style="{StaticResource StatusPillStyle}"
                                                VerticalAlignment="Center" Margin="10,0">
                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </Border>

                                        <TextBlock Grid.Column="5" Text="{Binding GrandTotal, StringFormat=AED {0:N2}}"
                                                   FontSize="11" FontWeight="Bold" Foreground="#047857"
                                                   Padding="10,10" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="6" Text="{Binding CreatedAt, StringFormat=yyyy-MM-dd}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   Padding="10,10" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Button Command="{Binding DataContext.LoadInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource RowActionButtonStyle}"
                                                    Foreground="{DynamicResource AccentBrush}"
                                                    ToolTip="Load into wizard">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📂" Margin="0,0,4,0"/>
                                                    <TextBlock Text="LOAD" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Command="{Binding DataContext.DuplicateInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource RowActionButtonStyle}"
                                                    Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                    ToolTip="Create a duplicate">
                                                <TextBlock Text="📋" FontSize="13"/>
                                            </Button>

                                            <Button Command="{Binding DataContext.DeleteInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource RowActionButtonStyle}"
                                                    Foreground="#EF4444"
                                                    ToolTip="Delete permanently">
                                                <TextBlock Text="🗑" FontSize="13"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>