<Window x:Class="ProGlassAutomation.Views.ProformaInvoice.SavedInvoicesList.InvoiceApprovalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Invoice Approval"
        Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <Style x:Key="ApprovalFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <Style x:Key="ApprovalTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome"
                                CornerRadius="10"
                                Background="{DynamicResource WindowBackgroundBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="1.5"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="14,0"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Glassy card, theme-driven -->
    <Border CornerRadius="18"
            Background="{DynamicResource ModuleBackgroundBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="1.5"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4"
                              Opacity="0.28" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="24,20,24,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="12" Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Confirm Invoice Approval"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="How was this invoice confirmed by the customer?"
                                   FontSize="11"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock x:Name="AttachmentNote"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Options -->
            <StackPanel Grid.Row="1" Margin="24,18,24,0">
                <RadioButton x:Name="SignedPiRadio"
                             GroupName="ApprovalMode"
                             IsChecked="True"
                             FontSize="13"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource PrimaryForegroundBrush}"
                             Checked="OnModeChanged"
                             Content="Customer signed the Proforma Invoice"/>
                <RadioButton x:Name="LpoRadio"
                             GroupName="ApprovalMode"
                             IsChecked="False"
                             FontSize="13"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource PrimaryForegroundBrush}"
                             Margin="0,12,0,0"
                             Checked="OnModeChanged"
                             Content="Customer provided an LPO / Purchase Order"/>
            </StackPanel>

            <!-- LPO number — shown for both options (optional for a signed PI,
                 required for an LPO). The label changes to say which. -->
            <StackPanel x:Name="LpoPanel" Grid.Row="2"
                        Margin="38,16,24,0">
                <TextBlock x:Name="LpoLabel" Text="LPO / PO NUMBER"
                           Style="{StaticResource ApprovalFieldLabel}"/>
                <TextBox x:Name="LpoBox" Height="40"
                         Style="{StaticResource ApprovalTextBox}"
                         KeyDown="OnLpoKeyDown"/>
            </StackPanel>

            <!-- Validation (its own row so it never overlaps the LPO box) -->
            <Border x:Name="ValidationBorder" Grid.Row="3"
                    Margin="24,16,24,0"
                    Padding="12,9" CornerRadius="9"
                    Background="{DynamicResource TintRedBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <TextBlock x:Name="ValidationText"
                           FontSize="11" FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}"/>
            </Border>

            <!-- Buttons -->
            <Border Grid.Row="4"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="0,1,0,0"
                    Background="{DynamicResource MenuHoverBrush}"
                    CornerRadius="0,0,18,18"
                    Padding="20,14"
                    Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource OutlinedPillButton}"
                            Tag="&#xE711;" Content="CANCEL"
                            Margin="0,0,10,0"
                            ToolTip="Close without changing status"
                            Click="OnCancelClick"
                            IsCancel="True"/>
                    <Button Style="{StaticResource PrimaryPillButton}"
                            Tag="&#xE73E;" Content="APPROVE INVOICE"
                            ToolTip="Approve and convert to a Job Order"
                            Click="OnApproveClick"
                            IsDefault="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
