<Window x:Class="ProGlassAutomation.Views.ProformaInvoice.SavedInvoicesList.InvoiceApprovalDialog"
             TextOptions.TextHintingMode="Fixed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ProformaInvoice.ConfirmInvoiceApproval}"
        Width="560"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <Style x:Key="ApprovalFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource TextCaption}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="ApprovalTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{DynamicResource WindowBackgroundBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="{DynamicResource CardBorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="14,0"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Design-system radio: accent ring + dot, matches the app theme. -->
        <Style x:Key="ApprovalRadioStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="FontSize" Value="{StaticResource TextBodyLarge}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="18" Height="18"
                                  VerticalAlignment="Center">
                                <Ellipse x:Name="Ring"
                                         Stroke="{DynamicResource OutlineBrush}"
                                         StrokeThickness="1.5"
                                         Fill="{DynamicResource WindowBackgroundBrush}"/>
                                <Ellipse x:Name="Dot"
                                         Width="8" Height="8"
                                         Fill="{DynamicResource AccentBrush}"
                                         Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter Margin="9,0,0,0"
                                              VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Dot" Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Liquid glass card, theme-driven.
         FIXED window height (no SizeToContent): the dialog never
         re-measures, never jumps, never collapses. The validation
         strip is ALWAYS laid out (Visibility=Hidden when clean) at a
         fixed height, so showing an error changes nothing in the
         layout. No '*' spacer rows — the card is exactly as tall as
         its content, so there is no dead space. Margin (>= 28 + 4)
         lets the drop shadow render fully instead of being clipped. -->
    <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
            Background="{DynamicResource ModuleBackgroundBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="{DynamicResource CardBorderThickness}"
            Margin="24,20,24,28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4"
                              Opacity="0.28" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Options -->
                <RowDefinition Height="Auto"/>
                <!-- LPO number -->
                <RowDefinition Height="Auto"/>
                <!-- Validation strip (fixed height, hidden when clean) -->
                <RowDefinition Height="Auto"/>
                <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="28,24,28,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="{DynamicResource CardCornerRadius}" Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="{StaticResource TextTitleLarge}"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource ProformaInvoice.ConfirmInvoiceApproval}"
                                   FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="{DynamicResource ProformaInvoice.HowInvoiceConfirmedCustomer}"
                                   FontSize="{StaticResource TextBody}"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <!-- Bounded + wrapping so the runtime note can never
                             overflow the card's right edge. -->
                        <TextBlock x:Name="AttachmentNote"
                                   FontSize="{StaticResource TextCaption}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   MaxWidth="400"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Options -->
            <StackPanel Grid.Row="1" Margin="28,22,28,0">
                <RadioButton x:Name="SignedPiRadio"
                             GroupName="ApprovalMode"
                             IsChecked="True"
                             Style="{StaticResource ApprovalRadioStyle}"
                             Checked="OnModeChanged">
                    <TextBlock Text="{DynamicResource ProformaInvoice.CustomerSignedProformaInvoice}"
                               TextWrapping="Wrap"/>
                </RadioButton>
                <RadioButton x:Name="LpoRadio"
                             GroupName="ApprovalMode"
                             IsChecked="False"
                             Margin="0,12,0,0"
                             Style="{StaticResource ApprovalRadioStyle}"
                             Checked="OnModeChanged">
                    <TextBlock Text="{DynamicResource ProformaInvoice.CustomerProvidedLPOPurchaseOrder}"
                               TextWrapping="Wrap"/>
                </RadioButton>
            </StackPanel>

            <!-- LPO number — shown for both options. The label stays a
                 constant single line in BOTH states (state is conveyed by
                 the label text itself), so switching modes can never change
                 the layout height. -->
            <Grid x:Name="LpoPanel" Grid.Row="2"
                  Margin="28,20,28,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="LpoLabel" Grid.Row="0" Text="{DynamicResource ProformaInvoice.LPOPONumber}"
                           Style="{StaticResource ApprovalFieldLabel}"/>
                <TextBox x:Name="LpoBox" Grid.Row="1"
                         Height="40"
                         Margin="0,0,0,0"
                         Style="{StaticResource ApprovalTextBox}"
                         KeyDown="OnLpoKeyDown"/>
            </Grid>

            <!-- Validation strip — always reserved at a fixed height;
                 Visibility toggles Hidden/Visible only, so the window and
                 footer below never move when an error appears. -->
            <Border x:Name="ValidationBorder" Grid.Row="3"
                    Height="48"
                    Margin="28,14,28,0"
                    Padding="14,10" CornerRadius="{DynamicResource CardCornerRadius}"
                    Background="{DynamicResource TintRedBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Top"
                    Visibility="Hidden">
                <TextBlock x:Name="ValidationText"
                           FontSize="{StaticResource TextBody}" FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}"/>
            </Border>

            <!-- Buttons -->
            <Border Grid.Row="4"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="0,1,0,0"
                    Background="{DynamicResource MenuHoverBrush}"
                    CornerRadius="0,0,16,16"
                    Padding="24,16"
                    Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource OutlinedPillButton}"
                            Tag="&#xE711;" Content="{DynamicResource Action.Cancel}"
                            Margin="0,0,10,0"
                            ToolTip="{DynamicResource ProformaInvoice.CloseWithoutChangingStatus}"
                            Click="OnCancelClick"
                            IsCancel="True"/>
                    <Button Style="{StaticResource PrimaryPillButton}"
                            Tag="&#xE73E;" Content="{DynamicResource ProformaInvoice.ApproveInvoice}"
                            ToolTip="{DynamicResource ProformaInvoice.ApproveConvertJobOrder}"
                            Click="OnApproveClick"
                            IsDefault="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
