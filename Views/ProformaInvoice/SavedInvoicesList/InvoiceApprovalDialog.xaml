<Window x:Class="ProGlassAutomation.Views.ProformaInvoice.SavedInvoicesList.InvoiceApprovalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Invoice Approval"
        Width="470"
        Height="432"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <Style x:Key="ApprovalFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="ApprovalTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{DynamicResource WindowBackgroundBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}"
                                BorderThickness="{DynamicResource CardBorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="14,0"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Design-system radio: accent ring + dot, matches the app theme. -->
        <Style x:Key="ApprovalRadioStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="18" Height="18"
                                  VerticalAlignment="Center">
                                <Ellipse x:Name="Ring"
                                         Stroke="{DynamicResource OutlineBrush}"
                                         StrokeThickness="1.5"
                                         Fill="{DynamicResource WindowBackgroundBrush}"/>
                                <Ellipse x:Name="Dot"
                                         Width="8" Height="8"
                                         Fill="{DynamicResource AccentBrush}"
                                         Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter Margin="9,0,0,0"
                                              VerticalAlignment="Center"
                                              TextBlock.TextWrapping="Wrap"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Dot" Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Glassy card, theme-driven.
         FIXED window height (no SizeToContent) so the dialog never
         re-measures, never jumps, never collapses when the validation
         banner appears. The '*' spacer row keeps the footer pinned and
         lets the validation banner grow into reserved space. Margin
         (>= 28 + 4) is large enough for the drop shadow to render
         fully instead of being square-clipped at the window edges. -->
    <Border CornerRadius="{DynamicResource CardCornerRadius}"
            Background="{DynamicResource ModuleBackgroundBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="{DynamicResource CardBorderThickness}"
            Margin="28,24,28,32">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4"
                              Opacity="0.28" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Options -->
                <RowDefinition Height="Auto"/>
                <!-- LPO number -->
                <RowDefinition Height="*"/>
                <!-- Validation zone (reserved — footer never moves) -->
                <RowDefinition Height="Auto"/>
                <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="24,20,24,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="{DynamicResource CardCornerRadius}" Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Confirm Invoice Approval"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="How was this invoice confirmed by the customer?"
                                   FontSize="11"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <!-- Bounded + wrapping so the runtime note can never
                             overflow the card's right edge. -->
                        <TextBlock x:Name="AttachmentNote"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   MaxWidth="300"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Options -->
            <StackPanel Grid.Row="1" Margin="24,18,24,0">
                <RadioButton x:Name="SignedPiRadio"
                             GroupName="ApprovalMode"
                             IsChecked="True"
                             Style="{StaticResource ApprovalRadioStyle}"
                             Checked="OnModeChanged">
                    <TextBlock Text="Customer signed the Proforma Invoice"
                               TextWrapping="Wrap"/>
                </RadioButton>
                <RadioButton x:Name="LpoRadio"
                             GroupName="ApprovalMode"
                             IsChecked="False"
                             Margin="0,12,0,0"
                             Style="{StaticResource ApprovalRadioStyle}"
                             Checked="OnModeChanged">
                    <TextBlock Text="Customer provided an LPO / Purchase Order"
                               TextWrapping="Wrap"/>
                </RadioButton>
            </StackPanel>

            <!-- LPO number — shown for both options (optional for a signed PI,
                 required for an LPO). The label changes to say which.
                 Grid (not StackPanel) so the long label wraps at the fixed
                 window width instead of overflowing the right edge. -->
            <Grid x:Name="LpoPanel" Grid.Row="2"
                  Margin="24,16,24,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="LpoLabel" Grid.Row="0" Text="LPO / PO NUMBER"
                           Style="{StaticResource ApprovalFieldLabel}"/>
                <TextBox x:Name="LpoBox" Grid.Row="1"
                         Height="40"
                         Margin="0,0,0,0"
                         Style="{StaticResource ApprovalTextBox}"
                         KeyDown="OnLpoKeyDown"/>
            </Grid>

            <!-- Validation — grows into the reserved '*' row; the window and
                 the footer below never move when it appears. -->
            <Border x:Name="ValidationBorder" Grid.Row="3"
                    Margin="24,12,24,0"
                    Padding="12,9" CornerRadius="{DynamicResource CardCornerRadius}"
                    Background="{DynamicResource TintRedBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Top"
                    Visibility="Collapsed">
                <TextBlock x:Name="ValidationText"
                           FontSize="11" FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}"/>
            </Border>

            <!-- Buttons -->
            <Border Grid.Row="4"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="0,1,0,0"
                    Background="{DynamicResource MenuHoverBrush}"
                    CornerRadius="0,0,12,12"
                    Padding="20,14"
                    Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource OutlinedPillButton}"
                            Tag="&#xE711;" Content="CANCEL"
                            Margin="0,0,10,0"
                            ToolTip="Close without changing status"
                            Click="OnCancelClick"
                            IsCancel="True"/>
                    <Button Style="{StaticResource PrimaryPillButton}"
                            Tag="&#xE73E;" Content="APPROVE INVOICE"
                            ToolTip="Approve and convert to a Job Order"
                            Click="OnApproveClick"
                            IsDefault="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
