<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/ProformaInvoice/SavedInvoicesList/VersionsDialog.xaml
     PROJECT: ProGlassAutomation
     MODULE: Proforma Invoice — version history (§24)

     Lists every saved version of one invoice:
        Version 4  •  09 Aug 2026 10:12  •  Manager  •  Invoice updated
     Restore opens that version in the wizard (a NEW version is created
     when the user saves again — history is never erased).
═══════════════════════════════════════════════════════════════════════ -->

<Window x:Class="ProGlassAutomation.Views.ProformaInvoice.SavedInvoicesList.VersionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Version History"
        Width="560" Height="540"
        MinWidth="460" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="{DynamicResource ModuleBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets"
                           FontSize="16" Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Version history"
                           FontSize="17" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"/>
            </StackPanel>
            <TextBlock x:Name="SubtitleText"
                       FontSize="12" Margin="0,3,0,0"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CardCornerRadiusLarge}"
                ClipToBounds="True">
            <Grid>
                <!-- Collapsed by default: code-behind decides. Without this
                     the "no versions" message painted for one frame before
                     the list was bound. -->
                <TextBlock x:Name="EmptyText"
                           Visibility="Collapsed"
                           Text="No versions recorded yet."
                           FontSize="12" FontStyle="Italic"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedForegroundBrush}"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="VersionsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="{DynamicResource CardCornerRadius}" BorderBrush="{DynamicResource OutlineBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="40" Height="40"
                                                CornerRadius="20"
                                                Background="{DynamicResource TintIndigoBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding VersionNo}"
                                                       FontSize="14" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Margin="12,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}">
                                                <Run Text="Version "/>
                                                <Run Text="{Binding VersionNo, Mode=OneWay}"/>
                                                <Run Text=" — "/>
                                                <Run Text="{Binding Summary, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}">
                                                <Run Text="{Binding TimestampLocal, Mode=OneWay}"/>
                                                <Run Text="  •  by "/>
                                                <Run Text="{Binding Username, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Content="Restore"
                                                FontSize="11" FontWeight="SemiBold"
                                                Padding="14,6"
                                                Cursor="Hand"
                                                BorderThickness="0"
                                                Background="{DynamicResource AccentBrush}"
                                                Foreground="White"
                                                VerticalAlignment="Center"
                                                Click="OnRestoreClick"
                                                Tag="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Button Grid.Row="2"
                HorizontalAlignment="Right"
                Margin="0,14,0,0"
                Padding="22,9"
                Cursor="Hand"
                BorderThickness="0"
                Click="OnCloseClick">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{DynamicResource MenuHoverBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource PillCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <TextBlock Text="Close"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
        </Button>
    </Grid>
</Window>
