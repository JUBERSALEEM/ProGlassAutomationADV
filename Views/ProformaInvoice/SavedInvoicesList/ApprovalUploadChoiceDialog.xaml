<Window x:Class="ProGlassAutomation.Views.ProformaInvoice.SavedInvoicesList.ApprovalUploadChoiceDialog"
             TextOptions.TextHintingMode="Fixed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ProformaInvoice.UploadConfirmation}"
        Width="560"
        Height="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- FIXED window height (no SizeToContent): the dialog can never
         re-measure or flash at the wrong size on first show. The card is
         exactly as tall as its content (no spacer rows, no dead space).
         Margin is large enough for the drop shadow to render fully. -->
    <Border CornerRadius="{DynamicResource CardCornerRadiusLarge}"
            Background="{DynamicResource ModuleBackgroundBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="{DynamicResource CardBorderThickness}"
            Margin="24,20,24,28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4"
                              Opacity="0.28" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Note -->
                <RowDefinition Height="Auto"/>
                <!-- JPG / PDF buttons -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="28,24,28,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="{DynamicResource CardCornerRadius}" Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="{StaticResource TextTitleLarge}"
                                   Foreground="{DynamicResource OnAccentForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource ProformaInvoice.ApproveUploadConfirmation}"
                                   FontSize="{StaticResource TextTitle}" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="{DynamicResource ProformaInvoice.ChooseDocumentTypeAttachInvoice}"
                                   FontSize="{StaticResource TextBody}"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Note -->
            <TextBlock Grid.Row="1"
                       Margin="28,18,28,0"
                       FontSize="{StaticResource TextBody}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedForegroundBrush}">
                We'll take you to Step 8 (Attachments) to upload the signed
                Proforma Invoice or LPO. Choose the file type you are uploading.
            </TextBlock>

            <!-- JPG / PDF buttons -->
            <StackPanel Grid.Row="2" Margin="28,20,28,0">
                <Button x:Name="ImageButton"
                        Height="52"
                        Style="{StaticResource PrimaryPillButton}"
                        Tag="&#xE91B;"
                        Content="{DynamicResource ProformaInvoice.UploadJPGImageSignedPILPOPhoto}"
                        ToolTip="{DynamicResource ProformaInvoice.OpenStep8ImageUploader}"
                        Click="OnImageClick"/>
                <Button x:Name="PdfButton"
                        Height="52"
                        Margin="0,12,0,0"
                        Style="{StaticResource OutlinedPillButton}"
                        Tag="&#xE8A5;"
                        Content="{DynamicResource ProformaInvoice.UploadPDFSignedPILPODocument}"
                        ToolTip="{DynamicResource ProformaInvoice.OpenStep8PDFUploader}"
                        Click="OnPdfClick"/>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="3"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="0,1,0,0"
                    Background="{DynamicResource MenuHoverBrush}"
                    CornerRadius="0,0,16,16"
                    Padding="24,16"
                    Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource OutlinedPillButton}"
                            Tag="&#xE711;" Content="{DynamicResource Action.Cancel}"
                            ToolTip="{DynamicResource ProformaInvoice.CloseWithoutUploading}"
                            Click="OnCancelClick"
                            IsCancel="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
