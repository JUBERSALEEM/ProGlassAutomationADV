<!-- ═══════════════════════════════════════════════════════════════════
     FILE: Views/ProformaInvoice/SavedInvoicesList/ApprovalUploadChoiceDialog.xaml
     PROJECT: ProGlassAutomation
     MODULE: Proforma Invoice — approval upload choice (JPG vs PDF)

     2026-09 dialog audit: rebuilt on the shared ThemedDialogWindow chrome.
     Content-driven sizing (previously fixed 560×440 NoResize) so longer
     localized strings wrap and the window grows instead of clipping.
     ═══════════════════════════════════════════════════════════════════ -->

<dialogs:ThemedDialogWindow x:Class="ProGlassAutomation.Views.ProformaInvoice.SavedInvoicesList.ApprovalUploadChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:ProGlassAutomation.Views.Shared.Dialogs"
        Title="{DynamicResource ProformaInvoice.ApproveUploadConfirmation}"
        Width="560"
        DialogIcon="&#xE8B5;"
        DialogSubtitle="{DynamicResource ProformaInvoice.ChooseDocumentTypeAttachInvoice}">

    <StackPanel>
        <!-- Note -->
        <TextBlock FontSize="{StaticResource TextBody}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedForegroundBrush}"
                   Text="{DynamicResource ApprovalUpload.GoToStep8}"/>

        <!-- JPG / PDF choice -->
        <StackPanel Margin="0,20,0,0">
            <Button x:Name="ImageButton"
                    Height="52"
                    Style="{StaticResource PrimaryPillButton}"
                    Tag="&#xE91B;"
                    Content="{DynamicResource ProformaInvoice.UploadJPGImageSignedPILPOPhoto}"
                    ToolTip="{DynamicResource ProformaInvoice.OpenStep8ImageUploader}"
                    Click="OnImageClick"/>
            <Button x:Name="PdfButton"
                    Height="52"
                    Margin="0,12,0,0"
                    Style="{StaticResource OutlinedPillButton}"
                    Tag="&#xE8A5;"
                    Content="{DynamicResource ProformaInvoice.UploadPDFSignedPILPODocument}"
                    ToolTip="{DynamicResource ProformaInvoice.OpenStep8PDFUploader}"
                    Click="OnPdfClick"/>
        </StackPanel>
    </StackPanel>

    <dialogs:ThemedDialogWindow.FooterContent>
        <Button Style="{StaticResource OutlinedPillButton}"
                Tag="&#xE711;" Content="{DynamicResource Action.Cancel}"
                ToolTip="{DynamicResource ProformaInvoice.CloseWithoutUploading}"
                IsCancel="True"/>
    </dialogs:ThemedDialogWindow.FooterContent>
</dialogs:ThemedDialogWindow>
