<Window x:Class="ProGlassAutomation.Views.ProformaInvoice.SavedInvoicesList.ApprovalUploadChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upload Confirmation"
        Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border CornerRadius="18"
            Background="{DynamicResource ModuleBackgroundBrush}"
            BorderBrush="{DynamicResource OutlineBrush}"
            BorderThickness="1.5"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4"
                              Opacity="0.28" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="24,20,24,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="12" Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Approve — Upload the Confirmation"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"/>
                        <TextBlock Text="Choose the document type to attach for this invoice"
                                   FontSize="11"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Note -->
            <TextBlock Grid.Row="1"
                       Margin="24,16,24,0"
                       FontSize="11.5"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedForegroundBrush}">
                We'll take you to Step 8 (Attachments) to upload the signed
                Proforma Invoice or LPO. Choose the file type you are uploading.
            </TextBlock>

            <!-- JPG / PDF buttons -->
            <StackPanel Grid.Row="2" Margin="24,18,24,0">
                <Button x:Name="ImageButton"
                        Height="52"
                        Style="{StaticResource PrimaryPillButton}"
                        Tag="&#xE91B;"
                        Content="Upload JPG / Image  (signed PI or LPO photo)"
                        ToolTip="Open the Step 8 image uploader"
                        Click="OnImageClick"/>
                <Button x:Name="PdfButton"
                        Height="52"
                        Margin="0,12,0,0"
                        Style="{StaticResource OutlinedPillButton}"
                        Tag="&#xE8A5;"
                        Content="Upload PDF  (signed PI or LPO document)"
                        ToolTip="Open the Step 8 PDF uploader"
                        Click="OnPdfClick"/>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="3"
                    BorderBrush="{DynamicResource OutlineBrush}"
                    BorderThickness="0,1,0,0"
                    Background="{DynamicResource MenuHoverBrush}"
                    CornerRadius="0,0,18,18"
                    Padding="20,14"
                    Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource OutlinedPillButton}"
                            Tag="&#xE711;" Content="CANCEL"
                            ToolTip="Close without uploading"
                            Click="OnCancelClick"
                            IsCancel="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
