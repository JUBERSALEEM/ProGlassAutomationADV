<UserControl x:Class="ProGlassAutomation.Views.ProformaInvoice.ProformaInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400"
             FontFamily="Segoe UI">

    <Grid Background="{DynamicResource WindowBackgroundBrush}"
          Margin="0,70,0,0">

        <Grid.ColumnDefinitions>
            <!-- Left Sidebar — Wizard Steps -->
            <ColumnDefinition Width="280"/>
            <!-- Right Content Area — Step Content -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================== LEFT SIDEBAR ========================== -->
        <Border Grid.Column="0"
                Background="{DynamicResource SideMenuBackgroundBrush}"
                CornerRadius="16"
                Margin="20,10,10,20"
                Padding="16,20">
            <StackPanel>

                <!-- Sidebar Title -->
                <TextBlock Text="INVOICE BUILDER PROGRESS"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Margin="8,0,0,20"/>

                <!-- Wizard Steps List -->
                <ItemsControl ItemsSource="{Binding WizardSteps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="StepBorder"
                                    CornerRadius="12"
                                    Padding="14,12"
                                    Margin="0,2"
                                    Cursor="Hand">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Step Number Circle -->
                                    <Border x:Name="NumberCircle"
                                            Grid.Column="0"
                                            Width="28" Height="28"
                                            CornerRadius="14"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="NumberText"
                                                   Text="{Binding StepNumber}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Step Title + Subtitle -->
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="10,0,0,0">
                                        <TextBlock x:Name="TitleText"
                                                   Text="{Binding Title}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="SubtitleText"
                                                   Text="{Binding Subtitle}"
                                                   FontSize="11"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Triggers for Active / Inactive state -->
                            <DataTemplate.Triggers>

                                <!-- Active Step — Accent background -->
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="StepBorder" Property="Background"
                                            Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="NumberCircle" Property="Background"
                                            Value="#FFFFFF"/>
                                    <Setter TargetName="NumberText" Property="Foreground"
                                            Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="TitleText" Property="Foreground"
                                            Value="White"/>
                                    <Setter TargetName="SubtitleText" Property="Foreground"
                                            Value="#CCFFFFFF"/>
                                </DataTrigger>

                                <!-- Inactive Step — Transparent background -->
                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                    <Setter TargetName="StepBorder" Property="Background"
                                            Value="Transparent"/>
                                    <Setter TargetName="NumberCircle" Property="Background"
                                            Value="{DynamicResource MenuHoverBrush}"/>
                                    <Setter TargetName="NumberText" Property="Foreground"
                                            Value="{DynamicResource SecondaryForegroundBrush}"/>
                                    <Setter TargetName="TitleText" Property="Foreground"
                                            Value="{DynamicResource PrimaryForegroundBrush}"/>
                                    <Setter TargetName="SubtitleText" Property="Foreground"
                                            Value="{DynamicResource SecondaryForegroundBrush}"/>
                                </DataTrigger>

                                <!-- Completed Step — Checkmark could be added later -->
                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                    <Setter TargetName="NumberCircle" Property="Background"
                                            Value="#22C55E"/>
                                    <Setter TargetName="NumberText" Property="Foreground"
                                            Value="White"/>
                                    <Setter TargetName="NumberText" Property="Text"
                                            Value="✓"/>
                                </DataTrigger>

                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </Border>

        <!-- ========================== RIGHT CONTENT AREA ========================== -->
        <Border Grid.Column="1"
                Margin="10,10,20,20">

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Progress Bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Step Content -->
                    <RowDefinition Height="*"/>
                    <!-- Bottom Navigation -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Progress Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <!-- Track -->
                    <Border Background="{DynamicResource MenuHoverBrush}"
                            Height="6"
                            CornerRadius="3"/>
                    <!-- Fill -->
                    <Border Background="{DynamicResource AccentBrush}"
                            Height="6"
                            CornerRadius="3"
                            HorizontalAlignment="Left"
                            Width="160">
                        <!-- Width = (1/7) * total width — hardcoded for step 1, will be dynamic later -->
                    </Border>
                </Grid>

                <!-- Step Content Placeholder -->
                <Border Grid.Row="1"
                        Background="{DynamicResource ModuleBackgroundBrush}"
                        CornerRadius="16"
                        Padding="30">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="&#128220;"
                                   FontSize="56"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,0,16"/>
                        <TextBlock Text="{Binding CurrentStep.Title}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentStep.Subtitle}"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                        <Border Background="{DynamicResource MenuHoverBrush}"
                                CornerRadius="8"
                                Padding="16,10"
                                Margin="0,24,0,0"
                                HorizontalAlignment="Center">
                            <TextBlock Text="Step content will be built here"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Bottom Navigation Bar -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Back Button -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource ModuleBackgroundBrush}"
                            CornerRadius="10"
                            Padding="20,10"
                            Cursor="Hand"
                            Opacity="0.5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#10094;"
                                       FontSize="12"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="Back Step"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Step Counter -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding StepProgressText}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <!-- Continue Button -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="10"
                            Padding="20,10"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Continue"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="&#10095;"
                                       FontSize="12"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>